# Backend: auto | local | supabase
# En Render usar supabase. En desarrollo local puede omitirse o usar local.
GLA_PERSISTENCE_BACKEND=local

# Solo son necesarias con GLA_PERSISTENCE_BACKEND=supabase.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-in-render-dashboard

# Opcionales (valores por defecto mostrados).
GLA_PERSIST_DEBOUNCE_MS=500
GLA_PERSIST_TIMEOUT_MS=5000

# GOOGLE SHEETS (zócalos de GLA SUPERCOPA, ver docs/GOOGLE-SHEETS.md).
# Copiar este archivo como .env (NO se versiona) y completar SOLO el ID.
# De .env, SOFTX solo lee las claves GOOGLE_*.
GOOGLE_SHEETS_SPREADSHEET_ID=

# Credenciales del Service Account: lo recomendado es dejar el JSON
# descargado de Google Cloud en secrets/google-service-account.json (ignorado
# por git) y NO completar nada de esto. Alternativa (p. ej. Render):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
