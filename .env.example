# Backend: auto | local | supabase
# En Render usar supabase. En desarrollo local puede omitirse o usar local.
GLA_PERSISTENCE_BACKEND=local

# Solo son necesarias con GLA_PERSISTENCE_BACKEND=supabase.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-in-render-dashboard

# Opcionales (valores por defecto mostrados).
GLA_PERSIST_DEBOUNCE_MS=500
GLA_PERSIST_TIMEOUT_MS=5000

