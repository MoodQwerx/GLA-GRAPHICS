lements","223","OBJECT_BOILERPLATE_DESCRIPTION_TYPE","110","ObjectBoilerplateDescription","261","COVERAGE_INFO_TYPE","CoverageInfo","224","REG_EXP_MATCH_INFO_TYPE","111","RegExpMatchInfo","178","REG_EXP_DATA_TYPE","RegExpData","179","ATOM_REG_EXP_DATA_TYPE","AtomRegExpData","180","IR_REG_EXP_DATA_TYPE","IrRegExpData","254","SOURCE_TEXT_MODULE_TYPE","SourceTextModule","255","SYNTHETIC_MODULE_TYPE","SyntheticModule","260","CONTEXT_CELL_TYPE","ContextCell","201","WASM_IMPORT_DATA_TYPE","WasmImportData","182","WASM_CAPI_FUNCTION_DATA_TYPE","WasmCapiFunctionData","183","WASM_EXPORTED_FUNCTION_DATA_TYPE","WasmExportedFunctionData","189","WASM_INTERNAL_FUNCTION_TYPE","WasmInternalFunction","286","WASM_FUNC_REF_TYPE","WasmFuncRef","288","WASM_RESUME_DATA_TYPE","WasmResumeData","190","WASM_SUSPENDER_OBJECT_TYPE","WasmSuspenderObject","284","WASM_CONTINUATION_OBJECT_TYPE","WasmContinuationObject","289","WASM_STACK_OBJECT_TYPE","WasmStackObject","291","WASM_TYPE_INFO_TYPE","103","WasmTypeInfo","287","WASM_NULL_TYPE","WasmNull","191","WASM_TRUSTED_INSTANCE_DATA_TYPE","WasmTrustedInstanceData","188","WASM_DISPATCH_TABLE_TYPE","WasmDispatchTable","200","WASM_DISPATCH_TABLE_FOR_IMPORTS_TYPE","WasmDispatchTableForImports","293","WEAK_CELL_TYPE","WeakCell","253","DICTIONARY_TEMPLATE_INFO_TYPE","251","FUNCTION_TEMPLATE_INFO_TYPE","FunctionTemplateInfo","252","OBJECT_TEMPLATE_INFO_TYPE","187","INTERPRETER_DATA_TYPE","121","InterpreterData","186","DEBUG_INFO_TYPE","119","DebugInfo","176","UNCOMPILED_DATA_WITHOUT_PREPARSE_DATA_TYPE","123","UncompiledDataWithoutPreparseData","174","UNCOMPILED_DATA_WITH_PREPARSE_DATA_TYPE","UncompiledDataWithPreparseData","177","UNCOMPILED_DATA_WITHOUT_PREPARSE_DATA_WITH_JOB_TYPE","125","UncompiledDataWithoutPreparseDataWithJob","175","UNCOMPILED_DATA_WITH_PREPARSE_DATA_AND_JOB_TYPE","124","UncompiledDataWithPreparseDataAndJob","198","SHARED_FUNCTION_INFO_WRAPPER_TYPE","126","SharedFunctionInfoWrapper","SCRIPT_SCOPE","-2","FUNCTION_SCOPE","SHADOW_REALM_SCOPE","2138","JS_MESSAGE_OBJECT_TYPE","JSObjectFast","2134","JS_EXTERNAL_OBJECT_TYPE","JSExternalObject","263","CPP_HEAP_EXTERNAL_OBJECT_TYPE","CppHeapExternalObject","262","CPP_GCMANAGED_BASE_TYPE","CppGCManagedBase","2109","JS_SHARED_ARRAY_TYPE","SHARED_ARRAY_ELEMENTS","2108","JS_ATOMICS_MUTEX_TYPE","JSSynchronizationPrimitive","DICTIONARY_ELEMENTS","2107","JS_ATOMICS_CONDITION_TYPE","101","-1","AsyncFunctionAwaitRejectClosure","AsyncFunctionAwaitResolveClosure","883","AsyncGeneratorAwaitResolveClosure","884","AsyncGeneratorAwaitRejectClosure","885","AsyncGeneratorYieldWithAwaitResolveClosure","888","AsyncGeneratorReturnResolveClosure","886","AsyncGeneratorReturnClosedResolveClosure","887","AsyncGeneratorReturnClosedRejectClosure","893","AsyncIteratorValueUnwrap","1139","AsyncIteratorPrototypeAsyncDisposeResolveClosure","892","AsyncFromSyncIteratorCloseSyncAndRethrow","1255","PromiseCapabilityDefaultResolve","1254","PromiseCapabilityDefaultReject","1259","PromiseGetCapabilitiesExecutor","1273","PromiseThenFinally","1272","PromiseCatchFinally","1270","PromiseValueThunkFinally","1271","PromiseThrowerFinally","1263","PromiseAllResolveElementClosure","1264","PromiseAllSettledResolveElementClosure","1265","PromiseAllSettledRejectElementClosure","1266","PromiseAnyRejectElementClosure","1296","ProxyRevoke","768","ShadowRealmImportValueFulfilled","917","CallAsyncModuleFulfilled","918","CallAsyncModuleRejected","953","ArrayFromAsyncIterableOnFulfilled","954","ArrayFromAsyncIterableOnRejected","955","ArrayFromAsyncArrayLikeOnFulfilled","956","ArrayFromAsyncArrayLikeOnRejected","376","AsyncDisposableStackOnFulfilled","377","AsyncDisposableStackOnRejected","378","AsyncDisposeFromSyncDispose","system / CodeWrapper","system / SharedFunctionInfo / Object","1068","ObjectConstructor","system / SharedFunctionInfo / [Symbol.iterator]","ReturnReceiver","system / SharedFunctionInfo / next","404","GeneratorPrototypeNext","system / SharedFunctionInfo / return","405","GeneratorPrototypeRe