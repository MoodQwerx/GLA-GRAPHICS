"RENDERBUFFER_GREEN_SIZE","CSSNumericArray","set onoffline","set external","get onanimationiteration","composed","/program/preview.html","teamA1","buildPenaltyEditor","onformdata","set ariaLabel","pageXOffset","rescale","VAR","$6","normalizePosicion","ABREVIATURA LOCAL (solo GLA)","12:30","holdWarm","onscrollsnapchange","String.prototype.substr","set ondragend","GPUBindGroupLayout","get ontoggle","btnPreview","Array.prototype.find","TransitionEvent","getCalendars","Presentation","get compatMode","DOCUMENT_POSITION_DISCONNECTED","validity","get oncontentvisibilityautostatechange","PENDING","releasePointerCapture","SAMPLER_2D","out","get inputMode","scrollWidth","GLA_SEGOE_BOLD_FACE","moduleDisplayLabel","commitElementPosition","resolveTeamTokens","Boolean.prototype.toString","closest","ESTADOS","RadioNodeList","WakeLock","getOwnPropertySymbols","get fontBoundingBoxDescent","LINE_MAX_WIDTH","NavigatorManagedData","currentTarget","DeviceMotionEventAcceleration","readout","Crypto","CSSStyleSheet","AnimationPlaybackEvent","buildListEditor","kickLocal2Scale","set onpointerover","APPLY_MATCH_PROFILE","golesAwayCrest","frameElement","get ariaActiveDescendantElement","set onresize","kickLocal3OffsetX","ws","HTMLFrameSetElement","Replay","DynamicsCompressorNode","get onbeforecut","getColumnNumber","CSSMathNegate","composedPath","getTeamCatalog","NavigatorLogin","\n    </div>\n  ","VIDEO_BY_TIPO","get command","sort","./bug.js","NOMBRE VISITANTE \u2014 MODO","get defaultView","screenX","set webkitVisibilityState","innerWidth","ResizeObserver","set playbackRate","CF TEAM","set parentNode","align","scissor","set childNodes","kickLocal3OffsetY","globalCompositeOperation","HTMLFormControlsCollection","get attributionSrc","get onprerenderingchange","AnimationTrigger","get menubar","CSSPseudoElement","alpha-video","gMasA","HTMLTableCellElement","IMG_SRC","snapshots","Set.prototype.forEach","set self","String.prototype.toString","BlobEvent","set defaultValue","set files","get composed","STATUS_MAX_FONT","MISSED","blink","__lookupSetter__","HTMLOutputElement","GamepadEvent","set autocapitalize","/assets/themes/argentina-streamers/mosca/mosca-localstrike-alpha.mp4","SVGFEImageElement","GPUDevice","get onbeforecopy","STENCIL_BACK_VALUE_MASK","onpointerrawupdate","STENCIL_BACK_REF","iframe","defaultChecked","visitanteCrestScale","arrayBufferConstructor_DoNotInitialize","getModuleAssets","set classList","set onload","ariaPlaceholder","intersection","status","Segmenter String Iterator","socket","get files","PromiseReject","NAME_MAX_WIDTH_B","set ariaValueText","filasParaPagina","SVGFEDistantLightElement","PaymentResponse","Torque assert 'value != PromiseHole' failed [src/builtins/promise-all-element-closure.tq:15]","encodeURI","bottom-center","get ondragend","toPrecision","oncontextrestored","SOLO (sin goles)","set crypto","set bgColor","transparencia \u2713","getFunction","golesAwayCrestOffsetY","parsePastedList","accessKey","../../../shared/sponsors.js","Equipo","/assets/","WebSocketError","HTMLAudioElement","renderScoreboardClockPanel","get currentTime","10:00","SVGPoint","confirm","../text-fit.js","AudioContext","SpeechRecognitionPhrase","get onresourcetimingbufferfull","draftThemeId","lastVh","set sizeAdjust","set srcObject","onbeforeinput","get ariaControlsElements","dragend","Audio","getFields","set ariaActiveDescendantElement","get onpointerover","NETWORK_NO_SOURCE","get offsetX","set onanimationend",".tab[data-id=\"__marcador_group__\"]","drawingBufferFormat","tick","scheduleExitCleanup","/assets/marcador/marcador-entretiempo-alpha.mp4","/assets/placas/estrellas-alpha.mp4","SourceBuffer","getElementsByTagNameNS","Array.prototype.findLastIndex","timer","VERTEX_ATTRIB_ARRAY_BUFFER_BINDING","AnimationEvent","exitPictureInPicture","BackgroundFetchManager","startsWith","./historial.js","String.prototype.toLowerCase","invoker",".ov-zfd-crest-local","Boolean.prototype.valueOf","readOnly","PressureObserver","\u2192 PASAR A ENTRETIEMPO","entryType","estadoFullscreen","Arrastrar para reordenar","get autofocus","DurationFormat","WebGLTransformFeedback","TEAM_MAX_FONT","String.prototype.sup","SHADING_LANGUAGE_VERSION","get classList","./tarjeta.js","http://localhost:4430/master-control/js/main.js","import { MODULES, MODULE_IDS, cloneDefaults } from '../../shared/modules.js';\r\nimport { WS_MSG, MODULE_STATUS, FIELD_TYPES } from '../../shared/constants.js';\r\nimport { connect } from '../../shared/ws-client.js';\r\nimport { renderFields, mountAdjustControl } from './field-editors.js';\r\nimport { renderScoreboardClockPanel } from './scoreboard-clock-panel.js';\r\nimport { renderLiveClockDisplay } from './live-clock-display.js';\r\nimport { renderFormationListPanel } from './formation-list-panel.js';\r\nimport { renderMatchRosterPanel } from './match-roster-panel.js';\r\nimport { renderShortDoublePanel } from './short-double-panel.js';\r\nimport { renderGruposPanel } from './grupos-panel.js';\r\nimport { renderResultadosPanel } from './resultados-panel.js';\r\nimport { renderEstrellasPanel } from './estrellas-panel.js';\r\nimport { renderPosicionesPanel, renderPosicionesTorneoPanel } from './posiciones-panel.js';\r\nimport { renderPerformanceTablePanel } from './performance-table-panel.js';\r\nimport { renderFichaJugadorPanel } from './ficha-jugador-panel.js';\r\n// BRACKETS (2026-09-02, handoff de un agente concurrente -- ver\r\n// docs/PATCH_SHARED_CLAUDE.md): paneles/renderers propios, integrados tal\r\n// cual el patch entregado, sin tocar su contenido.\r\nimport { renderCronogramaHoyPanel } from './cronograma-hoy-panel.js';\r\nimport { renderResultadosParcialesPanel } from './resultados-parciales-panel.js';\r\nimport { renderHistorialPanel } from './historial-panel.js';\r\nimport { renderZocaloCompuestoPanel } from './zocalo-compuesto-panel.js';\r\nimport { renderZocaloSponsorsPanel } from './zocalo-sponsors-panel.js';\r\nimport { renderCompositionControl } from './composition-control.js';\r\nimport { renderPresetsControl, savePresetEntry } from './presets-helper.js';\r\nimport { renderEquiposPanel } from './equipos-panel.js';\r\nimport { renderAssetResources } from './asset-resources-panel.js';\r\nimport { renderJugadoresPanel } from './jugadores-panel.js';\r\nimport { renderZocaloEscudosPanel } from './zocalo-escudos-panel.js';\r\nimport { renderPenalesPanel } from './penales-panel.js';\r\nimport { renderZocaloVsPanel } from './zocalo-vs-panel.js';\r\nimport { renderActualizadorDatosPanel } from './actualizador-datos-panel.js';\r\nimport { loadGlaTorneoEdicion, setGlaTorneoEdicion } from './gla-torneo-source.js';\r\nimport { updateLocalTeamCatalog, teamName } from '../../shared/teams.js';\r\nimport { CUSTOM_COLOR_ID, colorHex, normalizeHexColor } from '../../shared/team-colors.js';\r\nimport { isThemeReady, getTheme, getModuleAssetStatus, DEFAULT_THEME_ID, ARGENTINA_STREAMERS_THEME_ID } from '../../shared/themes.js';\r\nimport { ADJUST_REGISTRY } from '../../shared/adjust-registry.js';\r\n\r\n// Draft local por modulo: lo que el operador esta editando. Se inicializa\r\n// una sola vez con el snapshot del servidor al conectar; despues queda bajo\r\n// control del operador hasta que decide Tomar/Actualizar.\r\nconst draft = {};\r\nconst serverState = {};\r\nlet activeId = MODULE_IDS[0];\r\nlet snapshotLoaded = false;\r\n// Theme con el que \"draft\" est\u00E1 sincronizado ahora mismo -- null hasta el\r\n// primer STATE_SNAPSHOT; a partir de ah\u00ED, un STATE_SNAPSHOT con un theme\r\n// DISTINTO dispara el resync completo del draft (ver onMessage abajo).\r\nlet draftThemeId = null;\r\n\r\n// THEME ACTIVO (2026-08-20, sistema multi-theme, pedido expl\u00EDcito): estado\r\n// GLOBAL que llega por WS (STATE_SNAPSHOT al conectar, THEME_UPDATE en\r\n// cada cambio -- ver server/theme.js) -- nunca se decide localmente antes\r\n// de que el servidor confirme, as\u00ED Master Control y Program siempre\r\n// terminan de acuerdo.\r\nlet activeThemeId = DEFAULT_THEME_ID;\r\nconst systemBadge = document.getElementById('system-badge');\r\nconst themeBanner = document.getElementById('theme-pending-banner');\r\n\r\n// BANCO GLOBAL DE PRESETS DE ZOCALOS (2026-09-27, pedido explicito del\r\n// usuario: un mismo banco compartido por Largo Doble/Corto Simple/\r\n// Compuesto, SOLO GLA -- ver server/lower-third-presets.js). Vive como un\r\n// objeto envoltorio (no un array suelto) para que \"renderPresetsControl\"\r\n// (master-control/js/presets-helper.js, sin cambios ahi) lo trate exactamente\r\n// igual que \"draft.<modulo>\": solo le importa \"holder[presetKey]\", nunca de\r\n// donde sale el objeto. \"textPresets\" es el mismo nombre de campo que ya usa\r\n// el resto del proyecto, por consistencia. Zocalo Corto Doble NO participa\r\n// de este objeto -- sigue con \"draft.shortDouble.textPresets\" de siempre.\r\nconst globalLowerThirdBank = { textPresets: [] };\r\nfunction saveGlobalLowerThirdBank() {\r\n  ws.send({ type: 'UPDATE_GLOBAL_LOWER_THIRD_PRESETS', presets: globalLowerThirdBank.textPresets });\r\n}\r\nconst GLOBAL_LOWER_THIRD_MODULE_IDS = new Set(['longDouble', 'shortSimple', 'zocaloCompuesto']);\r\n\r\n// BANCO GLOBAL DE ZOCALOS \u2014 ARGENTINA STREAMERS (2026-10-08, pedido\r\n// explicito del usuario): mismo concepto que el banco de GLA de arriba pero\r\n// SEPARADO (server/lower-third-presets.js, clave propia). Lo comparten\r\n// Z\u00F3calo Largo Doble, Z\u00F3calo Corto Simple y Z\u00F3calo Compuesto\r\n// (\"zocaloCompuestoEquipos\") de AS; TALENTOS (shortDouble) conserva su\r\n// banco exclusivo. \"loaded\" evita guardar sobre un banco todavia no\r\n// recibido (eso reemplazaria la lista del servidor por una parcial).\r\nconst themeLowerThirdBank = { textPresets: [], themeId: null, loaded: false };\r\nconst THEME_LOWER_THIRD_MODULE_IDS = new Set(['longDouble', 'shortSimple', 'zocaloCompuestoEquipos']);\r\nfunction saveThemeLowerThirdBank() {\r\n  if (!themeLowerThirdBank.loaded) return;\r\n  // Duplicados EXACTOS (mismo tipo + mismo MAIN + mismo SUB): queda solo el\r\n  // mas nuevo (el helper agrega al principio de la lista).\r\n  const seen = new Set();\r\n  themeLowerThirdBank.textPresets = themeLowerThirdBank.textPresets.filter((preset) => {\r\n    const key = JSON.stringify([preset.type, (preset.fields?.main ?? '').trim(), (preset.fields?.sub ?? '').trim()]);\r\n    if (seen.has(key)) return false;\r\n    seen.add(key);\r\n    return true;\r\n  });\r\n  ws.send({ type: 'UPDATE_THEME_LOWER_THIRD_PRESETS', themeId: themeLowerThirdBank.themeId, presets: themeLowerThirdBank.textPresets });\r\n}\r\nfunction loadThemeLowerThirdBank(themeId) {\r\n  if (themeId !== ARGENTINA_STREAMERS_THEME_ID || themeLowerThirdBank.themeId === themeId) return;\r\n  themeLowerThirdBank.themeId = themeId;\r\n  themeLowerThirdBank.loaded = false;\r\n  fetch(`/api/lower-third-presets/${encodeURIComponent(themeId)}`)\r\n    .then((res) => res.json())\r\n    .then((presets) => {\r\n      if (!Array.isArray(presets) || themeLowerThirdBank.themeId !== themeId) return;\r\n      themeLowerThirdBank.textPresets = presets;\r\n      themeLowerThirdBank.loaded = true;\r\n      if (THEME_LOWER_THIRD_MODULE_IDS.has(activeId) && activeThemeId === themeId) renderPanel();\r\n    })\r\n    .catch((err) => {\r\n      themeLowerThirdBank.themeId = null;\r\n      console.error('[GLA] No se pudo cargar el banco de presets de z\u00F3calos del theme:', err);\r\n    });\r\n}\r\nfunction renderThemeBankLoadingNote(container) {\r\n  const note = document.createElement('p');\r\n  note.className = 'performance-note';\r\n  note.textContent = 'Cargando presets globales de z\u00F3calos...';\r\n  container.appendChild(note);\r\n}\r\n// Sin \"await\" a proposito (2026-09-27): un top-level await aca pausaria TODO\r\n// el resto de este modulo (conexion WS, UI, etc.) hasta que resuelva el\r\n// fetch -- el resto del archivo tiene que seguir ejecutandose de inmediato,\r\n// igual que siempre. Si el operador ya esta parado en uno de los 3 paneles\r\n// cuando esto resuelve, \"renderPanel()\" lo refresca solo -- mismo patron\r\n// que \"TEAM_CATALOG_UPDATE\" mas abajo.\r\nfetch('/api/lower-third-presets')\r\n  .then((res) => res.json())\r\n  .then((initial) => {\r\n    if (!Array.isArray(initial)) return;\r\n    globalLowerThirdBank.textPresets = initial;\r\n    if (GLOBAL_LOWER_THIRD_MODULE_IDS.has(activeId) && activeThemeId === DEFAULT_THEME_ID) renderPanel();\r\n  })\r\n  .catch((err) => {\r\n    console.error('[GLA] No se pudo cargar el banco global de presets de zocalos:', err);\r\n  });\r\n\r\n// PERFILES DE PARTIDO: barra eliminada de Master Control (2026-10-09,\r\n// pedido explicito del usuario: \"no sirvi\u00F3 y est\u00E1 ah\u00ED al pedo\"). Solo\r\n// existia para Argentina Streamers (GLA nunca tuvo perfiles); los perfiles\r\n// ya guardados en disco y sus endpoints del servidor quedan intactos e\r\n// ignorados (sin migracion). PRESETS de texto no tienen relacion con esto.\r\n\r\n// SOFTX: el sistema (GLA REL\u00C1MPAGO / ARGENTINA STREAMERS) se elige al\r\n// arrancar y queda fijo -- el panel solo lo muestra, no lo puede cambiar.\r\nfunction applyThemeUI(themeId) {\r\n  activeThemeId = themeId;\r\n  document.body.dataset.theme = themeId;\r\n  loadThemeLowerThirdBank(themeId);\r\n  const systemName = getTheme(themeId).name;\r\n  if (systemBadge) systemBadge.textContent = systemName;\r\n  document.title = `SOFTX \u2014 ${systemName} \u2014 Master Control`;\r\n  if (themeBanner) {\r\n    const ready = isThemeReady(themeId);\r\n    themeBanner.hidden = ready;\r\n    if (!ready) {\r\n      themeBanner.textContent = `THEME EN PREPARACI\u00D3N / ASSETS PENDIENTES \u2014 ${getTheme(themeId).name} todav\u00EDa no tiene sus piezas gr\u00E1ficas cargadas.`;\r\n    }\r\n  }\r\n}\r\n\r\nfor (const id of MODULE_IDS) {\r\n  draft[id] = cloneDefaults(id);\r\n  serverState[id] = { status: MODULE_STATUS.OUT, data: cloneDefaults(id) };\r\n}\r\nserverState['abreviaturas'] = { status: MODULE_STATUS.OUT, data: {} };\r\n// \"jugadoresAdmin\" (BLOQUE 3, 2026-09-09): pseudo-m\u00F3dulo de administraci\u00F3n\r\n// de planteles, mismo criterio que \"abreviaturas\" -- nunca sale a Program,\r\n// no tiene TAKE/OUT/ACTUALIZAR, no vive en shared/modules.js ni en el\r\n// sistema de draft/autosave (lee/escribe directo contra /api/planteles/,\r\n// ver jugadores-panel.js).\r\nserverState['jugadoresAdmin'] = { status: MODULE_STATUS.OUT, data: {} };\r\n// \"actualizadorDatos\" (ACTUALIZADOR DE DATOS, 2026-10-21, pedido explicito\r\n// del usuario, SOLO GLA): mismo criterio -- pseudo-modulo administrativo,\r\n// nunca sale a Program. Elige la edicion del TORNEO de los syncs web (ver\r\n// actualizador-datos-panel.js / gla-torneo-source.js).\r\nserverState['actualizadorDatos'] = { status: MODULE_STATUS.OUT, data: {} };\r\nloadGlaTorneoEdicion();\r\n\r\n// Orden de categorias en el panel (broadcast: lo mas usado en vivo primero).\r\n// Orden pedido explicitamente: Mosca arriba de todo, Marcador justo\r\n// debajo, despues el resto sin cambios (2026-08-15).\r\nconst CATEGORY_ORDER = ['Mosca', 'Marcador', 'Eventos', 'VAR / Replay', 'Zocalos', 'Placas', 'Grupos', 'Tablas', 'Brackets', 'General'];\r\n\r\n// \"MARCADOR unificado\" (2026-08-15, pedido explicito del usuario): en vez\r\n// de varias tabs sueltas en la navegacion (Marcador principal, Tiempo\r\n// adicional, Entretiempo, Marcador Zocalo, VS Compacto), el operador ve\r\n// UNA sola tab \"MARCADOR\" con sub-secciones adentro del panel. Cada\r\n// sub-modulo listado aca SIGUE siendo un modulo independiente del lado\r\n// del servidor (su propio TAKE/UPDATE/OUT, su propio \"live\"/\r\n// \"autoRunClock\"/\"sequencedReveal\", ver shared/modules.js) -- esto es\r\n// 100% reorganizacion de navegacion, no toca la logica de ninguno de los\r\n// 5. \"vs\" (Zocalo VS compacto) sigue con category:'Zocalos' en el schema\r\n// (no se le cambio esa categoria, por si algo mas depende de ella) pero\r\n// se excluye de la lista de esa categoria mas abajo (mismo \"continue\" que\r\n// el resto del grupo) y se agrega aca como sexta subseccion, a pedido\r\n// explicito del usuario (\"operarlo cerca/dentro de MARCADOR\").\r\nconst MARCADOR_GROUP_TAB_ID = '__marcador_group__';\r\nconst MARCADOR_SUBSECTIONS = [\r\n  { id: 'scoreboard', label: 'MARCADOR PRINCIPAL' },\r\n  { id: 'marcadorTiempoAdicional', label: 'TIEMPO ADICIONAL' },\r\n  { id: 'marcadorEntretiempo', label: 'ENTRETIEMPO' },\r\n  { id: 'marcadorZocalo', label: 'MARCADOR Z\u00D3CALO' },\r\n  { id: 'vs', label: 'VS COMPACTO' },\r\n];\r\nconst MARCADOR_SUBSECTION_IDS = new Set(MARCADOR_SUBSECTIONS.map((s) => s.id));\r\nlet lastMarcadorSubId = 'scoreboard';\r\n\r\n// \"ALWAYS_LIVE_MODULE_IDS\" (2026-09-10, pedido explicito del usuario:\r\n// \"VAR CHEQUEO... que se actualice en vivo apenas lo cambio\" / \"REPLAY...\r\n// sacale la logica de ACTUALIZAR\") -- mismo mecanismo que ya usan MARCADOR\r\n// y FORMACI\u00D3N (ver \"sendMarcadorSubsectionLive\" mas abajo), scoped\r\n// puntualmente a estos 2 modulos -- \"no convertir globalmente todo a\r\n// live-edit\" sigue siendo la regla.\r\nconst ALWAYS_LIVE_MODULE_IDS = new Set(['varCheck', 'replay']);\r\n\r\n// PENALES LIVE (2026-10-09, pedido explicito del usuario, SOLO Argentina\r\n// Streamers: \"que todo sea en vivo, sin ACTUALIZAR\") -- mismo mecanismo que\r\n// MARCADOR/VAR/Replay (\"sendMarcadorSubsectionLive\"). GLA conserva su\r\n// Penales con ACTUALIZAR, sin cambios. \"zocaloVs\" (Z\u00D3CALO VS, mismo dia,\r\n// modulo exclusivo de Argentina Streamers): mismo criterio.\r\nconst ARGENTINA_LIVE_MODULE_IDS = new Set(['marcadorPenales', 'zocaloVs']);\r\nfunction isArgentinaLiveModule(moduleId) {\r\n  return ARGENTINA_LIVE_MODULE_IDS.has(moduleId) && activeThemeId === ARGENTINA_STREAMERS_THEME_ID;\r\n}\r\n\r\n// \"GOL ya no es un modulo operable a mano\" (2026-08-15, pedido explicito\r\n// del usuario): se saca de la navegacion (ver buildTabs) pero sigue\r\n// existiendo como modulo real del servidor -- lo dispara unicamente\r\n// scoreGoal() mas abajo, nunca un click directo del operador.\r\n// \"zocaloFinal\"/\"zocaloFinalDiv\" (2026-08-16, unificados en \"zocaloCompuesto\"\r\n// -- ver shared/modules.js): quedan registrados intactos (mismo id, mismo\r\n// renderer, mismos datos ya persistidos) para no perder presets/datos\r\n// viejos, pero sin tab propia, mismo patron que \"gol\".\r\n// \"zocaloCompuestoLogo\" (2026-09-10, unificado en \"zocaloCompuestoEquipos\"\r\n// -- pedido explicito del usuario: \"un solo m\u00F3dulo\" con selector de tipo):\r\n// mismo criterio exacto, queda registrado solo para no perder datos ya\r\n// persistidos, oculto de toda navegacion (antes solo se ocultaba para GLA,\r\n// ver GLA_HIDDEN_MODULES mas abajo -- ahora se oculta siempre, para\r\n// cualquier theme).\r\nconst HIDDEN_FROM_NAV_IDS = new Set(['gol', 'zocaloFinal', 'zocaloFinalDiv', 'zocaloCompuestoLogo']);\r\n\r\n// VAR: textos predefinidos para \"Texto Motivo\" (2026-08-15, pedido\r\n// explicito del usuario). Las claves matchean los \"id\" de las opciones de\r\n// \"motivoPreset\" en shared/modules.js -- 'personalizado' no esta aca a\r\n// proposito (no autocompleta nada, deja el texto tal cual para que el\r\n// operador lo tipee).\r\nconst MOTIVO_PRESET_TEXT = {\r\n  posible_penal: 'POSIBLE PENAL',\r\n  gol_no_valido: 'GOL NO V\u00C1LIDO',\r\n  posible_roja: 'POSIBLE ROJA',\r\n};\r\n\r\nconst tabBar = document.getElementById('tab-bar');\r\nconst mcPanel = document.getElementById('mc-panel');\r\nconst panelTitle = document.getElementById('panel-title');\r\nconst panelStatus = document.getElementById('panel-status');\r\nconst panelAssetBadge = document.getElementById('panel-asset-badge');\r\n\r\n// Indicador discreto \"ASSET [THEME]: PENDIENTE\" (2026-08-25, pedido\r\n// expl\u00EDcito, secci\u00F3n 6) -- NUNCA bloquea TAKE, solo informa. GLA siempre\r\n// da 'ready' (sus assets ya existen todos), as\u00ED que para GLA esto queda\r\n// oculto siempre; para cualquier otro theme sin el asset de este m\u00F3dulo\r\n// todav\u00EDa, aparece al lado del t\u00EDtulo mientras el operador est\u00E1 parado\r\n// en ese m\u00F3dulo. Se llama desde renderPanel() en cada render de panel,\r\n// as\u00ED que se actualiza solo al cambiar de m\u00F3dulo O de theme.\r\nfunction updateAssetBadge(moduleId) {\r\n  if (!panelAssetBadge) return;\r\n  const status = getModuleAssetStatus(activeThemeId, moduleId);\r\n  if (status === 'pending') {\r\n    panelAssetBadge.hidden = false;\r\n    panelAssetBadge.textContent = `ASSET ${getTheme(activeThemeId).shortName}: PENDIENTE`;\r\n  } else {\r\n    panelAssetBadge.hidden = true;\r\n  }\r\n}\r\nconst fieldsContainer = document.getElementById('fields-container');\r\nconst extraContainer = document.getElementById('extra-container');\r\nconst compositionContainer = document.getElementById('composition-container');\r\nconst assetResourceContainer = document.getElementById('asset-resource-container');\r\nlet assetResourcesCleanup = null;\r\nconst marcadorSubnav = document.getElementById('marcador-subnav');\r\nconst connStatus = document.getElementById('conn-status');\r\nlet panelCleanup = null;\r\nconst takeBtn = document.getElementById('btn-take');\r\nconst updateBtn = document.getElementById('btn-update');\r\nconst outBtn = document.getElementById('btn-out');\r\nconst previewBtn = document.getElementById('btn-preview');\r\nconst stopAllBtn = document.getElementById('btn-stop-all');\r\n\r\n// Auto-guardado: cada edicion de campo (onDirty, ver field-editors.js)\r\n// programa un UPDATE al servidor con un debounce corto, para que todo lo\r\n// que el operador escribe quede persistido en el estado autoritativo\r\n// (server/state.js) sin esperar a que aprete \"Actualizar\" \u2014 asi sobrevive\r\n// a un refresh o a un reinicio del servidor. Nunca cambia el status\r\n// ON/OFF (UPDATE solo toca \"data\", igual que el boton \"Actualizar\" ya\r\n// hacia), asi que no hay riesgo de que algo vuelva al aire solo. Se\r\n// indexa por moduleId (no por \"activeId\" al momento de disparar el\r\n// timer) para que un cambio de pesta\u00F1a a mitad de un debounce no termine\r\n// mandando el draft equivocado.\r\n// PREVIEW EN VIVO (2026-09-27, pedido explicito del usuario: \"si modifico\r\n// composici\u00F3n, Preview debe reflejarla... sin necesitar TAKE/UPDATE/\r\n// refrescar\"). \"previewedModuleId\" es que modulo esta mostrando ahora\r\n// mismo el monitor Preview (lo fija el click de PREVIEW, ver mas abajo) --\r\n// \"sendPreviewSnapshot\" es el UNICO lugar que arma el mensaje PREVIEW_MODULE,\r\n// y \"sendPreviewUpdateIfActive\" es el hook central: se llama desde\r\n// \"scheduleAutoSave\"/\"flushModuleNow\" (el mismo funnel por el que YA pasa\r\n// CUALQUIER ajuste de composici\u00F3n/texto de CUALQUIER m\u00F3dulo, via\r\n// \"onDirty\" en renderModuleAdjustAccordion), asi que un ajuste en vivo se\r\n// reenvia a Preview sin agregar un hook por modulo ni por control.\r\nlet previewedModuleId = null;\r\nfunction sendPreviewSnapshot(moduleId) {\r\n  ws.send({ type: 'PREVIEW_MODULE', moduleId, data: draft[moduleId], allData: draft });\r\n}\r\nfunction sendPreviewUpdateIfActive(moduleId) {\r\n  if (moduleId === previewedModuleId) sendPreviewSnapshot(moduleId);\r\n  // Z\u00D3CALO VS (2026-10-09, solo Argentina Streamers): toma equipos/goles en\r\n  // vivo del Marcador -- si es lo que muestra Preview, un cambio del\r\n  // Marcador tambien tiene que verse ahi sin tocar el modulo.\r\n  else if (moduleId === 'scoreboard' && previewedModuleId === 'zocaloVs') sendPreviewSnapshot('zocaloVs');\r\n  // GOL SIGUE AL MARCADOR (2026-10-21, SOLO GLA): si Preview muestra GOL,\r\n  // mover el Marcador tambien lo mueve ahi (sin volver a reproducirlo).\r\n  else if (moduleId === 'scoreboard' && previewedModuleId === 'gol' && activeThemeId === DEFAULT_THEME_ID) sendPreviewSnapshot('gol');\r\n}\r\n\r\nconst saveTimers = {};\r\nfunction scheduleAutoSave(moduleId) {\r\n  if (moduleId === 'abreviaturas' || moduleId === 'jugadoresAdmin' || moduleId === 'actualizadorDatos') return;\r\n  clearTimeout(saveTimers[moduleId]);\r\n  // 350ms -> 80ms (2026-08-19, auditor\u00EDa de AJUSTES VISUALES pedida por el\r\n  // usuario): con 350ms, mantener apretada una flecha de posici\u00F3n (que ya\r\n  // se auto-repite cada 80ms, ver text-adjust-control.js/\r\n  // composition-control.js) reiniciaba este timer en cada click y nunca\r\n  // llegaba a mandar nada hasta 350ms DESPU\u00C9S de soltar el bot\u00F3n -- lejos\r\n  // de \"EN VIVO INMEDIATO\". 80ms iguala el propio ritmo de auto-repetici\u00F3n\r\n  // de esos botones (no tiene sentido mandar m\u00E1s r\u00E1pido de lo que el\r\n  // control ya genera cambios) sin saturar el WebSocket. Program sigue sin\r\n  // aplicar CONTENIDO hasta Take/ACTUALIZAR (ver program/js/main.js) -- ac\u00E1\r\n  // solo se acorta cu\u00E1nto tarda en LLEGAR el dato, no qu\u00E9 hace Program con\r\n  // \u00E9l.\r\n  saveTimers[moduleId] = setTimeout(() => {\r\n    delete saveTimers[moduleId];\r\n    ws.send({ type: WS_MSG.UPDATE, moduleId, data: draft[moduleId], isAutoSave: true });\r\n    sendPreviewUpdateIfActive(moduleId);\r\n  }, 80);\r\n}\r\nfunction flushPendingSaves() {\r\n  for (const moduleId of Object.keys(saveTimers)) {\r\n    if (moduleId === 'abreviaturas' || moduleId === 'jugadoresAdmin' || moduleId === 'actualizadorDatos') continue;\r\n    clearTimeout(saveTimers[moduleId]);\r\n    delete saveTimers[moduleId];\r\n    ws.send({ type: WS_MSG.UPDATE, moduleId, data: draft[moduleId], isAutoSave: true });\r\n    sendPreviewUpdateIfActive(moduleId);\r\n  }\r\n}\r\nwindow.addEventListener('beforeunload', flushPendingSaves);\r\n\r\n// \"GUARDAR POSICI\u00D3N\" (2026-08-31, pedido explicito del usuario, version\r\n// liviana confirmada: no crear un protocolo nuevo de borrador/confirmado,\r\n// solo confirmar/adelantar el MISMO auto-guardado que ya corre siempre).\r\n// \"flushModuleNow\" es un envio inmediato (sin esperar el debounce de 80ms\r\n// de scheduleAutoSave) del draft actual de un modulo puntual -- misma\r\n// llamada que ya hace flushPendingSaves() en beforeunload, pero dirigida\r\n// a un solo modulo y disparable a demanda. \"isPendingSave\"/\"isWsConnected\"\r\n// son las se\u00F1ales REALES que usa save-position-control.js para decidir\r\n// cuando mostrar \"SIN GUARDAR\": si no hay timer pendiente y el socket\r\n// esta conectado, el ultimo cambio ya salio.\r\nfunction flushModuleNow(moduleId) {\r\n  clearTimeout(saveTimers[moduleId]);\r\n  delete saveTimers[moduleId];\r\n  ws.send({ type: WS_MSG.UPDATE, moduleId, data: draft[moduleId], isAutoSave: true });\r\n  sendPreviewUpdateIfActive(moduleId);\r\n}\r\nfunction isPendingSave(moduleId) {\r\n  return !!saveTimers[moduleId];\r\n}\r\nlet wsConnected = false;\r\nfunction isWsConnected() {\r\n  return wsConnected;\r\n}\r\n\r\n// GUARDAR POSICI\u00D3N -> LAYOUT BASE VERSIONADO (2026-09-01, pedido explicito\r\n// del usuario: \"no quiero mas persistencia que dependa de la maquina...\r\n// quiero que esa posicion aprobada viaje con el codigo\"). Antes, \"GUARDAR\r\n// POSICI\u00D3N\" solo llamaba a \"flushModuleNow\" -- un guardado inmediato del\r\n// draft en el estado runtime (data/master-control-state.json), que\r\n// \".gitignore\" excluye por completo (nunca viaja con git clone/push/pull).\r\n// Ahora: primero fuerza ese mismo flush (para que el servidor tenga el\r\n// valor absoluto mas reciente de ESTE modulo antes de leerlo), y recien\r\n// despues manda COMMIT_POSITION -- el servidor consolida el valor absoluto\r\n// actual del elemento indicado por \"elementSpec\" dentro de\r\n// shared/theme-layouts/<themeId>.json (ver server/theme-layouts.js), un\r\n// archivo DENTRO del arbol versionado por Git. El dato que ya usa Program\r\n// (\"draft[moduleId]\") no se toca en ningun momento -- ver la decision\r\n// confirmada explicitamente por el usuario (\"solo visual en Master\r\n// Control\") y composition-control.js/text-adjust-control.js (baseline).\r\nfunction commitElementPosition(moduleId, elementSpec) {\r\n  flushModuleNow(moduleId);\r\n  ws.send({ type: WS_MSG.COMMIT_POSITION, moduleId, elementSpec });\r\n}\r\n\r\n// Atajo para armar el { onSave, isPendingSave, isConnected } que ya reciben\r\n// renderCompositionControl/renderTextAdjustControl (2026-08-31, auditoria\r\n// completa): evita repetir las mismas 3 lineas en cada panel dedicado que\r\n// necesita agregar GUARDAR POSICI\u00D3N a sus controles ya existentes.\r\n// \"onSave\" ahora recibe \"elementSpec\" (2026-09-01, layout base versionado)\r\n// -- lo arma cada control (composition-control.js/text-adjust-control.js,\r\n// via field-editors.js \"mountAdjustControl\" o directo en los paneles\r\n// dedicados que llaman a renderTextAdjustControl/renderCompositionControl\r\n// a mano), esta funcion solo necesita reenviarlo con el moduleId correcto.\r\nfunction buildSaveOptions(moduleId) {\r\n  return {\r\n    onSave: (elementSpec) => commitElementPosition(moduleId, elementSpec),\r\n    isPendingSave: () => isPendingSave(moduleId),\r\n    isConnected: isWsConnected,\r\n  };\r\n}\r\n\r\n// --- Formacion: cambio de equipo LOCAL/VISITANTE con presets independientes ---\r\nconst FORMATION_OUT_WAIT_MS = 750;\r\nlet formationTransitioning = false;\r\nlet formationPendingSide = null;\r\nlet formationTransitionTimer = null;\r\n\r\nfunction ensureFormationPresetsShape(data) {\r\n  if (!data.presets || typeof data.presets !== 'object') {\r\n    data.presets = { local: { starters: [], substitutes: [] }, visitor: { starters: [], substitutes: [] } };\r\n  }\r\n  for (const side of ['local', 'visitor']) {\r\n    if (!data.presets[side] || typeof data.presets[side] !== 'object') {\r\n      data.presets[side] = { starters: [], substitutes: [] };\r\n    }\r\n  }\r\n}\r\n\r\nfunction loadFormationPreset(side) {\r\n  const data = draft.formacionEquipos;\r\n  ensureFormationPresetsShape(data);\r\n  const preset = data.presets[side];\r\n  data.teamSide = side;\r\n  data.starters = JSON.parse(JSON.stringify(preset.starters));\r\n  data.substitutes = JSON.parse(JSON.stringify(preset.substitutes));\r\n}\r\n\r\nfunction cancelFormationTransition() {\r\n  if (formationTransitionTimer) {\r\n    clearTimeout(formationTransitionTimer);\r\n    formationTransitionTimer = null;\r\n  }\r\n  formationTransitioning = false;\r\n  formationPendingSide = null;\r\n}\r\n\r\nfunction handleFormationSideChange(newSide) {\r\n  if (formationTransitioning) return;\r\n  const data = draft.formacionEquipos;\r\n  const currentSide = data.teamSide === 'visitor' ? 'visitor' : 'local';\r\n  if (newSide === currentSide) return;\r\n\r\n  const isOn = serverState.formacionEquipos.status === MODULE_STATUS.ON;\r\n\r\n  if (!isOn) {\r\n    loadFormationPreset(newSide);\r\n    scheduleAutoSave('formacionEquipos');\r\n    if (activeId === 'formacionEquipos') renderPanel();\r\n    return;\r\n  }\r\n\r\n  formationTransitioning = true;\r\n  formationPendingSide = newSide;\r\n  if (activeId === 'formacionEquipos') renderPanel();\r\n\r\n  ws.send({ type: WS_MSG.OUT, moduleId: 'formacionEquipos' });\r\n\r\n  formationTransitionTimer = setTimeout(() => {\r\n    formationTransitionTimer = null;\r\n    loadFormationPreset(newSide);\r\n    ws.send({ type: WS_MSG.TAKE, moduleId: 'formacionEquipos', data: draft.formacionEquipos });\r\n    formationTransitioning = false;\r\n    formationPendingSide = null;\r\n    if (activeId === 'formacionEquipos') renderPanel();\r\n  }, FORMATION_OUT_WAIT_MS);\r\n}\r\n\r\n// --- Marcador <-> Entretiempo: transicion sin superposicion (2026-08-15,\r\n// pedido explicito del usuario) --- Mismo criterio que Formacion arriba:\r\n// \"scoreboard\" y \"marcadorEntretiempo\" son \"sequencedReveal:true\" (ver\r\n// shared/modules.js), asi que reusa el mismo tiempo de espera que ya usa\r\n// esa otra transicion (derivado de las mismas constantes CSS compartidas\r\n// --dur-content/--dur-out, ver el comentario original de\r\n// FORMATION_OUT_WAIT_MS mas arriba en el historial de este archivo) --\r\n// se define aparte, sin renombrar esa constante, para no tocar codigo de\r\n// Formacion que no es parte de este pedido.\r\nconst MARCADOR_ENTRETIEMPO_WAIT_MS = 750;\r\nlet marcadorEntretiempoTransitioning = false;\r\n\r\nfunction switchMarcadorEntretiempo(toId) {\r\n  if (marcadorEntretiempoTransitioning) return;\r\n  const fromId = toId === 'marcadorEntretiempo' ? 'scoreboard' : 'marcadorEntretiempo';\r\n  const fromIsOn = serverState[fromId] && serverState[fromId].status === MODULE_STATUS.ON;\r\n\r\n  if (!fromIsOn) {\r\n    // El origen no esta al aire: no hace falta coreografia, se toma directo.\r\n    ws.send({ type: WS_MSG.TAKE, moduleId: toId, data: draft[toId] });\r\n    selectModule(toId);\r\n    return;\r\n  }\r\n\r\n  marcadorEntretiempoTransitioning = true;\r\n  renderPanel();\r\n\r\n  ws.send({ type: WS_MSG.OUT, moduleId: fromId });\r\n\r\n  setTimeout(() => {\r\n    ws.send({ type: WS_MSG.TAKE, moduleId: toId, data: draft[toId] });\r\n    marcadorEntretiempoTransitioning = false;\r\n    selectModule(toId);\r\n  }, MARCADOR_ENTRETIEMPO_WAIT_MS);\r\n}\r\n\r\n// Boton contextual dentro del sub-nav de MARCADOR: solo aparece viendo\r\n// \"MARCADOR PRINCIPAL\" o \"ENTRETIEMPO\" (en las otras 3 subsecciones no\r\n// aplica un toggle entre estas dos piezas puntuales).\r\nfunction renderMarcadorEntretiempoToggle(parent) {\r\n  if (activeId !== 'scoreboard' && activeId !== 'marcadorEntretiempo') return;\r\n  const toId = activeId === 'scoreboard' ? 'marcadorEntretiempo' : 'scoreboard';\r\n  const btn = document.createElement('button');\r\n  btn.type = 'button';\r\n  btn.className = 'marcador-entretiempo-toggle';\r\n  btn.textContent = activeId === 'scoreboard' ? '\u2192 PASAR A ENTRETIEMPO' : '\u2192 VOLVER A MARCADOR';\r\n  btn.disabled = marcadorEntretiempoTransitioning;\r\n  if (marcadorEntretiempoTransitioning) btn.textContent = 'CAMBIANDO\u2026';\r\n  btn.addEventListener('click', () => switchMarcadorEntretiempo(toId));\r\n  parent.appendChild(btn);\r\n}\r\n\r\n// SHOOTOUT (2026-09-27, pedido explicito del usuario: \"acceso rapido a\r\n// TAKE/OUT de Penales sin tener que entrar al modulo separado, boton\r\n// ON/OFF simple dentro del panel del Marcador\"). Visible en cualquiera de\r\n// las 5 subsecciones de Marcador -- misma logica de \"una unica fuente de\r\n// verdad para onAir\" que el resto del proyecto: este boton no guarda\r\n// ningun estado propio, solo LEE \"serverState.marcadorPenales.status\" (lo\r\n// que el modulo Penales YA usa) y manda el mismo TAKE/OUT de siempre --\r\n// si se cambia desde el modulo Penales, este boton se entera por el mismo\r\n// MODULE_UPDATE de siempre (ver el re-render forzado en el handler de WS\r\n// mas abajo), sin mecanismo nuevo de sincronizacion.\r\nfunction renderShootoutToggle(parent) {\r\n  if (activeThemeId === ARGENTINA_STREAMERS_THEME_ID) {\r\n    renderMarcadorZocaloQuickToggle(parent);\r\n    return;\r\n  }\r\n  const st = serverState.marcadorPenales;\r\n  const isOn = !!st && st.status === MODULE_STATUS.ON;\r\n  const btn = document.createElement('button');\r\n  btn.type = 'button';\r\n  btn.className = 'marcador-entretiempo-toggle shootout-toggle';\r\n  btn.classList.toggle('on-air', isOn);\r\n  btn.textContent = isOn ? 'SHOOTOUT \u2014 ON AIR (sacar)' : 'SHOOTOUT (tomar al aire)';\r\n  btn.addEventListener('click', () => {\r\n    if (isOn) {\r\n      ws.send({ type: WS_MSG.OUT, moduleId: 'marcadorPenales' });\r\n    } else {\r\n      ws.send({ type: WS_MSG.TAKE, moduleId: 'marcadorPenales', data: draft.marcadorPenales });\r\n    }\r\n  });\r\n  parent.appendChild(btn);\r\n}\r\n\r\n// MARCADOR Z\u00D3CALO \u2014 acceso rapido (2026-10-08, pedido explicito del\r\n// usuario, SOLO Argentina Streamers): el boton de acceso rapido del panel\r\n// de Marcador controla \"marcadorZocalo\" en vez de Penales (GLA conserva su\r\n// SHOOTOUT de arriba, sin cambios). Misma unica fuente de verdad: lee\r\n// \"serverState.marcadorZocalo.status\" y manda el TAKE/OUT de siempre; el\r\n// TAKE replica exactamente el del boton TOMAR AL AIRE (\"autoRunClock\":\r\n// el reloj arranca desde 0). Penales y Marcador Z\u00F3calo siguen existiendo\r\n// como modulos propios, intactos.\r\nfunction renderMarcadorZocaloQuickToggle(parent) {\r\n  const st = serverState.marcadorZocalo;\r\n  const isOn = !!st && st.status === MODULE_STATUS.ON;\r\n  const btn = document.createElement('button');\r\n  btn.type = 'button';\r\n  btn.className = 'marcador-entretiempo-toggle shootout-toggle';\r\n  btn.classList.toggle('on-air', isOn);\r\n  btn.textContent = isOn ? 'MARCADOR Z\u00D3CALO \u2014 EN AIRE (sacar)' : 'MARCADOR Z\u00D3CALO \u2014 FUERA DE AIRE (tomar)';\r\n  btn.addEventListener('click', () => {\r\n    if (isOn) {\r\n      ws.send({ type: WS_MSG.OUT, moduleId: 'marcadorZocalo' });\r\n      return;\r\n    }\r\n    const clockKey = MODULES.marcadorZocalo.autoRunClock;\r\n    if (clockKey) draft.marcadorZocalo[clockKey] = { running: true, accumulatedMs: 0, startedAt: Date.now() };\r\n    ws.send({ type: WS_MSG.TAKE, moduleId: 'marcadorZocalo', data: draft.marcadorZocalo });\r\n  });\r\n  parent.appendChild(btn);\r\n}\r\n\r\n// --- GOL: se dispara solo al sumar un gol desde el Marcador (2026-08-15,\r\n// pedido explicito del usuario) --- Ya no es una tab operable a mano (ver\r\n// HIDDEN_FROM_NAV_IDS) pero sigue siendo un modulo real del servidor\r\n// (oneShot, ver shared/modules.js): scoreGoal() hace TAKE de 'gol' el\r\n// mismo momento en que actualiza el score, y una cola evita que dos goles\r\n// muy seguidos disparen animaciones superpuestas -- el siguiente de la\r\n// cola recien se dispara cuando el servidor confirma que 'gol' volvio a\r\n// OUT (ver el manejo de WS_MSG.MODULE_UPDATE mas abajo), que es\r\n// exactamente cuando termina la animacion (handleOneShotEnded en\r\n// program/js/main.js). El gol en si (el +1 al score) nunca espera esa\r\n// cola: se manda apenas se hace click, asi nunca se \"pierde\" un gol\r\n// aunque el operador toque rapido \u2014 lo unico que se encola es la\r\n// ANIMACION.\r\nconst golQueue = [];\r\n\r\nfunction isGolAnimating() {\r\n  return serverState.gol && serverState.gol.status === MODULE_STATUS.ON;\r\n}\r\n\r\nfunction fireNextGolAnimation() {\r\n  if (golQueue.length === 0 || isGolAnimating()) return;\r\n  golQueue.shift();\r\n  ws.send({ type: WS_MSG.TAKE, moduleId: 'gol', data: {} });\r\n}\r\n\r\n// \"sendScoreboardLive\" (BLOQUE 2, 2026-09-09, pedido explicito del\r\n// usuario: \"todo el Marcador debe operarse LIVE... no depender de\r\n// ACTUALIZAR\"): unico punto de envio para CUALQUIER cambio de contenido\r\n// del Marcador (goles, equipos, colores, sponsor) -- \"isExplicitUpdate:\r\n// true\" es la misma se\u00F1al que ya usaba \"scoreGoal\" desde antes de este\r\n// bloque (ver \"applyModuleState\" en program/js/main.js: un UPDATE con\r\n// esta marca se aplica de inmediato aunque el modulo ya este al aire, en\r\n// vez de quedar congelado esperando Take/ACTUALIZAR). Manda el objeto\r\n// COMPLETO de \"draft.scoreboard\" (no un patch parcial) para que equipo +\r\n// color + escudo lleguen siempre en el MISMO mensaje -- evita la mezcla\r\n// temporal equipo viejo/nombre nuevo que pedia evitar el usuario.\r\nfunction sendScoreboardLive() {\r\n  ws.send({ type: WS_MSG.UPDATE, moduleId: 'scoreboard', data: draft.scoreboard, isExplicitUpdate: true });\r\n  sendPreviewUpdateIfActive('scoreboard');\r\n}\r\n\r\n// COLOR POR EQUIPO (2026-10-22, pedido explicito del usuario, SOLO GLA):\r\n// EQUIPOS edita el MISMO mapa que ya usaba el Marcador\r\n// (\"scoreboard.teamColorAssignments\", teamId -> colorId, fallback \"gris\").\r\n// Si ese equipo esta elegido como local o visitante, su color se actualiza\r\n// en el acto y se manda en vivo, igual que cualquier cambio del Marcador.\r\n// COLOR PERSONALIZADO (2026-10-23): colorId 'personalizado' + HEX exacto\r\n// en \"scoreboard.teamColorCustomHex[teamId]\" (mismo objeto del Marcador).\r\n// Volver a un predefinido no borra el HEX: se recupera al elegir\r\n// PERSONALIZADO de nuevo. Solo se guarda un HEX valido (normalizeHexColor).\r\nconst glaTeamColors = {\r\n  get: (teamId) => ({\r\n    colorId: draft.scoreboard.teamColorAssignments?.[teamId] || '',\r\n    hex: normalizeHexColor(draft.scoreboard.teamColorCustomHex?.[teamId]) || '',\r\n  }),\r\n  set: (teamId, colorId, hex) => {\r\n    const sb = draft.scoreboard;\r\n    if (!sb.teamColorAssignments || typeof sb.teamColorAssignments !== 'object') sb.teamColorAssignments = {};\r\n    if (colorId) sb.teamColorAssignments[teamId] = colorId;\r\n    else delete sb.teamColorAssignments[teamId];\r\n    const validHex = normalizeHexColor(hex);\r\n    if (validHex) {\r\n      if (!sb.teamColorCustomHex || typeof sb.teamColorCustomHex !== 'object') sb.teamColorCustomHex = {};\r\n      sb.teamColorCustomHex[teamId] = validHex;\r\n    }\r\n    if (sb.teamA === teamId) sb.teamAColor = colorId || 'gris';\r\n    if (sb.teamB === teamId) sb.teamBColor = colorId || 'gris';\r\n    sendScoreboardLive();\r\n  },\r\n};\r\n\r\n// \"sendMarcadorSubsectionLive\" (2026-09-10, pedido explicito del usuario:\r\n// \"todas las subsecciones de MARCADOR deben ser LIVE, no depender de\r\n// ACTUALIZAR\") -- mismo patron exacto que \"sendScoreboardLive\" (arriba,\r\n// BLOQUE 2, ya probado para MARCADOR PRINCIPAL), generalizado a\r\n// CUALQUIERA de las otras 4 subsecciones agrupadas (ver\r\n// MARCADOR_SUBSECTION_IDS): manda el draft COMPLETO del modulo con\r\n// \"isExplicitUpdate:true\" -- la misma se\u00F1al que ya usa el boton ACTUALIZAR\r\n// de siempre -- asi que Program lo aplica de inmediato aunque el modulo ya\r\n// este al aire (ver \"applyModuleState\" en program/js/main.js), sin\r\n// necesidad de que el operador confirme nada. A proposito NO se usa fuera\r\n// de MARCADOR: el resto de los modulos de LIVE GRAPHICS sigue con\r\n// \"scheduleAutoSave\" + ACTUALIZAR de siempre (pedido explicito: \"no\r\n// convertir globalmente todo a live-edit\").\r\nfunction sendMarcadorSubsectionLive(moduleId) {\r\n  ws.send({ type: WS_MSG.UPDATE, moduleId, data: draft[moduleId], isExplicitUpdate: true });\r\n  sendPreviewUpdateIfActive(moduleId);\r\n}\r\n\r\nfunction scoreGoal(side) {\r\n  const key = side === 'A' ? 'scoreA' : 'scoreB';\r\n  const current = parseInt(draft.scoreboard[key], 10) || 0;\r\n  draft.scoreboard[key] = String(current + 1);\r\n  sendScoreboardLive();\r\n  if (activeId === 'scoreboard') renderPanel();\r\n  golQueue.push(side);\r\n  fireNextGolAnimation();\r\n}\r\n\r\nfunction undoGoal(side) {\r\n  const key = side === 'A' ? 'scoreA' : 'scoreB';\r\n  const current = parseInt(draft.scoreboard[key], 10) || 0;\r\n  draft.scoreboard[key] = String(Math.max(0, current - 1));\r\n  sendScoreboardLive();\r\n  if (activeId === 'scoreboard') renderPanel();\r\n}\r\n\r\n// \"RESETEAR GOLES\" (2026-08-16, pedido explicito del usuario): vuelve\r\n// ambos goles a 0 SIN pasar por scoreGoal/undoGoal (no encola ni dispara\r\n// la animacion de GOL) y sin tocar ningun otro campo (equipos, colores,\r\n// reloj, periodo).\r\nfunction resetGoles() {\r\n  draft.scoreboard.scoreA = '0';\r\n  draft.scoreboard.scoreB = '0';\r\n  sendScoreboardLive();\r\n  if (activeId === 'scoreboard') renderPanel();\r\n}\r\n\r\n// \"RESET LOCAL\"/\"RESET VISITANTE\" (BLOQUE 2, 2026-09-09, pedido explicito\r\n// del usuario): mismo criterio que \"resetGoles\" de arriba (sin animacion\r\n// de GOL, un unico lado a la vez, sin tocar equipos/colores/reloj/periodo).\r\nfunction resetGolesLocal() {\r\n  draft.scoreboard.scoreA = '0';\r\n  sendScoreboardLive();\r\n  if (activeId === 'scoreboard') renderPanel();\r\n}\r\n\r\nfunction resetGolesVisitante() {\r\n  draft.scoreboard.scoreB = '0';\r\n  sendScoreboardLive();\r\n  if (activeId === 'scoreboard') renderPanel();\r\n}\r\n\r\n// ORDEN PERSONALIZADO DE LA NAVEGACI\u00D3N (2026-09-10, pedido explicito del\r\n// usuario: \"agregale a la lista de m\u00F3dulos la misma l\u00F3gica del cosito a la\r\n// izquierda para mover y cambiar de posici\u00F3n el orden de los m\u00F3dulos a mi\r\n// comodidad\" -- mismo patron de drag & drop con handle que Formaci\u00F3n, ver\r\n// formation-list-panel.js). Es una preferencia de ESTE operador/esta\r\n// maquina (como el orden de las pesta\u00F1as de un navegador), no contenido de\r\n// transmision -- se guarda en localStorage, nunca en el servidor/estado\r\n// compartido, para no mezclarla con nada que viaje a Program ni con los\r\n// perfiles de partido. Estructura: { [categoria]: [moduleId en el orden\r\n// elegido, ...] } -- una categoria sin entrada guardada usa el orden\r\n// natural de siempre (MODULE_IDS).\r\nconst NAV_ORDER_STORAGE_KEY = 'gla-nav-order';\r\nfunction loadNavOrder() {\r\n  try {\r\n    return JSON.parse(localStorage.getItem(NAV_ORDER_STORAGE_KEY) || '{}');\r\n  } catch {\r\n    return {};\r\n  }\r\n}\r\nfunction saveNavOrder(order) {\r\n  try {\r\n    localStorage.setItem(NAV_ORDER_STORAGE_KEY, JSON.stringify(order));\r\n  } catch {\r\n    // Sin localStorage disponible (modo privado, cuota agotada): el orden\r\n    // personalizado simplemente no persiste, la navegacion sigue operable\r\n    // con el orden de esta sesion.\r\n  }\r\n}\r\n// Aplica el orden guardado para una categoria puntual: los ids guardados\r\n// van primero (en ese orden, salteando cualquiera que ya no exista en esta\r\n// sesion/theme), el resto de \"ids\" (modulos nuevos o de otro theme) se\r\n// agrega despues en su orden natural -- nunca se pierde un modulo real por\r\n// no estar en un orden guardado viejo.\r\nfunction applyNavOrder(cat, ids) {\r\n  const saved = loadNavOrder()[cat];\r\n  if (!saved || !saved.length) return ids;\r\n  const idsSet = new Set(ids);\r\n  const ordered = saved.filter((id) => idsSet.has(id));\r\n  const orderedSet = new Set(ordered);\r\n  for (const id of ids) if (!orderedSet.has(id)) ordered.push(id);\r\n  return ordered;\r\n}\r\n\r\nfunction buildTabs() {\r\n  tabBar.innerHTML = '';\r\n\r\n  // Filtrado por theme (2026-09-02, handoff BRACKETS -- ver\r\n  // docs/PATCH_SHARED_CLAUDE.md): \"sideTable\"/\"posiciones\"/\r\n  // \"posicionesTorneo\" quedan reemplazados conceptualmente por\r\n  // \"cronogramaHoy\"/\"resultadosParciales\"/\"historial\" SOLO en Argentina\r\n  // Streamers -- GLA sigue viendo exactamente sus 3 modulos de siempre,\r\n  // los 3 nuevos nunca aparecen en su navegacion.\r\n  // BUG real encontrado y corregido (2026-09-02, auditoria de wiring de\r\n  // Historial): \"cronogramaHoy\"/\"resultadosParciales\"/\"historial\" estaban\r\n  // A LA VEZ aca (ocultos para Argentina Streamers) Y en\r\n  // GLA_HIDDEN_MODULES un poco mas abajo (ocultos para GLA) -- los 3\r\n  // quedaban sin tab en NINGUN theme, invisibles para cualquier operador.\r\n  // El comentario de arriba ya decia la intencion real: ocultos solo para\r\n  // GLA (que es exactamente lo que GLA_HIDDEN_MODULES hace por su cuenta).\r\n  const ARGENTINA_STREAMERS_HIDDEN_MODULES = new Set([\r\n    'sideTable', 'posiciones', 'posicionesTorneo',\r\n    'grupos', 'zocaloCompuesto',\r\n  ]);\r\n  // \"fichaJugador\" (2026-09-02, pedido explicito del usuario: \"GLA debe\r\n  // conservar exactamente sus modulos, navegacion y comportamiento\") --\r\n  // GLA no tiene pedido ningun uso de este modulo, asi que no le agrega\r\n  // una tab nueva a su navegacion (el modulo sigue registrado igual para\r\n  // los dos themes, solo la navegacion lo oculta para GLA).\r\n  // \"zocaloCompuestoEquipos\" (2026-09-02, regresion real encontrada y\r\n  // corregida durante esta auditoria; unificado con \"zocaloCompuestoLogo\"\r\n  // 2026-09-10, ver HIDDEN_FROM_NAV_IDS para ese): exclusivo de Argentina\r\n  // Streamers, GLA no lo ve.\r\n  // \"cronogramaHoy\"/\"resultadosParciales\"/\"historial\" (2026-09-24, pedido\r\n  // urgente del usuario: \"necesito BRACKETS disponible en GLA hoy\") --\r\n  // sacados de aca. Estaban ocultos para GLA desde que se integraron\r\n  // (2026-09-02, ver comentario de ARGENTINA_STREAMERS_HIDDEN_MODULES mas\r\n  // arriba), pero GLA los necesita: son modulos reales y funcionales\r\n  // (renderer + panel ya existian y cargan sin error), no exclusivos de\r\n  // Argentina Streamers -- no hay ninguna razon tecnica para que GLA no\r\n  // los vea. Categoria 'Brackets' (ver CATEGORY_ORDER arriba) vuelve a\r\n  // aparecer en la navegacion de GLA con estos 3 modulos.\r\n  // \"cronogramaHoy\"/\"historial\"/\"resultadosParciales\" (2026-10-22, pedido\r\n  // explicito del usuario): quitados SOLO de GLA (archivos y estado viejo\r\n  // intactos; el servidor tampoco los acepta al aire en GLA). Argentina\r\n  // Streamers los conserva.\r\n  const GLA_HIDDEN_MODULES = new Set([\r\n    'fichaJugador',\r\n    'zocaloCompuestoEquipos', 'sitioWebPromoL',\r\n    'zocaloVs',\r\n    'cronogramaHoy', 'historial', 'resultadosParciales',\r\n  ]);\r\n\r\n  const byCategory = new Map();\r\n  for (const id of MODULE_IDS) {\r\n    // Absorbidos en la tab unica \"MARCADOR\" (ver mas abajo) o sacados de\r\n    // la navegacion por completo (GOL) -- ninguno de los dos casos\r\n    // consigue tab propia en el listado normal.\r\n    if (MARCADOR_SUBSECTION_IDS.has(id) || HIDDEN_FROM_NAV_IDS.has(id)) continue;\r\n    if (activeThemeId === ARGENTINA_STREAMERS_THEME_ID && ARGENTINA_STREAMERS_HIDDEN_MODULES.has(id)) continue;\r\n    if (activeThemeId === DEFAULT_THEME_ID && GLA_HIDDEN_MODULES.has(id)) continue;\r\n    const cat = MODULES[id].category || 'Otros';\r\n    if (!byCategory.has(cat)) byCategory.set(cat, []);\r\n    byCategory.get(cat).push(id);\r\n  }\r\n\r\n  if (!byCategory.has('General')) byCategory.set('General', []);\r\n  byCategory.get('General').push('abreviaturas');\r\n  byCategory.get('General').push('jugadoresAdmin');\r\n  if (activeThemeId === DEFAULT_THEME_ID) byCategory.get('General').push('actualizadorDatos');\r\n\r\n  const orderedCategories = [\r\n    ...CATEGORY_ORDER.filter((c) => byCategory.has(c)),\r\n    ...[...byCategory.keys()].filter((c) => !CATEGORY_ORDER.includes(c)),\r\n  ];\r\n\r\n  for (const cat of orderedCategories) {\r\n    const heading = document.createElement('div');\r\n    heading.className = 'tab-category';\r\n    heading.textContent = cat;\r\n    tabBar.appendChild(heading);\r\n\r\n    // Tab unica \"MARCADOR\": se inyecta primero, antes que cualquier otra\r\n    // tab de la categoria 'Marcador' (ej. Penales), asi Penales queda\r\n    // \"inmediatamente debajo de MARCADOR en la navegacion\" sin necesidad\r\n    // de una lista de orden aparte -- ya sale asi de este mismo loop.\r\n    if (cat === 'Marcador') {\r\n      const groupTab = document.createElement('button');\r\n      groupTab.type = 'button';\r\n      groupTab.className = 'tab';\r\n      groupTab.dataset.id = MARCADOR_GROUP_TAB_ID;\r\n      groupTab.textContent = 'MARCADOR';\r\n      groupTab.addEventListener('click', () => selectModule(lastMarcadorSubId));\r\n      tabBar.appendChild(groupTab);\r\n    }\r\n\r\n    for (const id of applyNavOrder(cat, byCategory.get(cat))) {\r\n      // \"tab-row\" + \"tab-drag-handle\" (2026-09-10, pedido explicito del\r\n      // usuario, mismo patron de Formaci\u00F3n -- ver formation-list-panel.js\r\n      // \"formation-drag-handle\"): el handle es el UNICO elemento\r\n      // \"draggable\", nunca la fila entera, para no interferir con el click\r\n      // normal sobre el boton de la tab.\r\n      const row = document.createElement('div');\r\n      row.className = 'tab-row';\r\n      row.dataset.id = id;\r\n      row.dataset.category = cat;\r\n\r\n      const handle = document.createElement('span');\r\n      handle.className = 'tab-drag-handle';\r\n      handle.textContent = '\u2630';\r\n      handle.title = 'Arrastrar para reordenar';\r\n      handle.draggable = true;\r\n      row.appendChild(handle);\r\n\r\n      const tab = document.createElement('button');\r\n      tab.type = 'button';\r\n      tab.className = 'tab';\r\n      tab.dataset.id = id;\r\n      // \"Planteles\" (no \"Jugadores\") en la tab -- GLA ya tiene un modulo\r\n      // real llamado \"Jugadores\" (tabla de participaciones, categoria\r\n      // TABLAS); el panel nuevo se identifica igual por su titulo interno\r\n      // (\"JUGADORES \u2014 Administraci\u00F3n de planteles\", ver jugadores-panel.js)\r\n      // pero la tab evita la ambiguedad de dos tabs con el mismo texto.\r\n      tab.textContent = id === 'abreviaturas' ? abreviaturasTabLabel() : id === 'jugadoresAdmin' ? 'Planteles' : id === 'actualizadorDatos' ? 'Actualizador de datos' : moduleDisplayLabel(id);\r\n      tab.addEventListener('click', () => selectModule(id));\r\n      row.appendChild(tab);\r\n\r\n      handle.addEventListener('dragstart', (e) => {\r\n        e.dataTransfer.effectAllowed = 'move';\r\n        e.dataTransfer.setData('text/plain', id);\r\n        row.classList.add('is-dragging');\r\n      });\r\n      handle.addEventListener('dragend', () => row.classList.remove('is-dragging'));\r\n      row.addEventListener('dragover', (e) => {\r\n        // Solo reordena DENTRO de la misma categoria -- arrastrar entre\r\n        // categorias distintas no tiene un \"orden\" compartido que tenga\r\n        // sentido guardar.\r\n        if (e.dataTransfer.types.includes('text/plain')) e.preventDefault();\r\n      });\r\n      row.addEventListener('drop', (e) => {\r\n        e.preventDefault();\r\n        const fromId = e.dataTransfer.getData('text/plain');\r\n        if (!fromId || fromId === id) return;\r\n        const fromRow = tabBar.querySelector(`.tab-row[data-id=\"${CSS.escape(fromId)}\"]`);\r\n        if (!fromRow || fromRow.dataset.category !== cat) return;\r\n        const currentIds = [...tabBar.querySelectorAll(`.tab-row[data-category=\"${CSS.escape(cat)}\"]`)].map((r) => r.dataset.id);\r\n        const fromIndex = currentIds.indexOf(fromId);\r\n        const toIndex = currentIds.indexOf(id);\r\n        if (fromIndex === -1 || toIndex === -1) return;\r\n        currentIds.splice(toIndex, 0, currentIds.splice(fromIndex, 1)[0]);\r\n        const order = loadNavOrder();\r\n        order[cat] = currentIds;\r\n        saveNavOrder(order);\r\n        buildTabs();\r\n      });\r\n\r\n      tabBar.appendChild(row);\r\n    }\r\n  }\r\n\r\n  updateTabStates();\r\n}\r\n\r\n// \"PARTICIPACIONES\" (2026-09-02, pedido explicito del usuario): nombre de\r\n// broadcast para el modulo \"jugadores\" SOLO en Argentina Streamers -- el\r\n// id/label interno (\"Jugadores\") y el modulo de GLA no cambian en\r\n// absoluto, esto es puramente el texto mostrado en la navegacion y el\r\n// titulo del panel. Centralizado aca para no duplicar el chequeo en cada\r\n// lugar que muestra el label de un modulo.\r\n// \"TALENTOS\" (2026-10-08, pedido explicito del usuario, mismo criterio que\r\n// \"Participaciones\"): nombre visible de \"shortDouble\" (Z\u00F3calo Corto Doble)\r\n// SOLO en Argentina Streamers -- id, datos y presets exclusivos intactos.\r\nfunction moduleDisplayLabel(id) {\r\n  // RESULTADOS -> PARTIDOS (2026-10-22, SOLO GLA): solo el nombre visible;\r\n  // moduleId \"sideTable\" y renderer sin cambios.\r\n  if (id === 'sideTable' && activeThemeId === DEFAULT_THEME_ID) return 'Partidos';\r\n  if (id === 'jugadores' && activeThemeId === ARGENTINA_STREAMERS_THEME_ID) return 'Participaciones';\r\n  if (id === 'shortDouble' && activeThemeId === ARGENTINA_STREAMERS_THEME_ID) return 'Talentos';\r\n  return MODULES[id].label;\r\n}\r\n\r\n// \"EQUIPOS\" (2026-10-08, pedido explicito del usuario): la pseudo-seccion\r\n// \"abreviaturas\" (id interno sin cambios) se llama EQUIPOS en Argentina\r\n// Streamers, donde edita nombre + abreviatura + visibilidad. Desde\r\n// 2026-10-21 (pedido explicito del usuario) GLA tambien: mismo panel, con\r\n// su catalogo propio (assets/crests/) y escudo asociado por equipo.\r\nfunction abreviaturasTabLabel() {\r\n  return 'Equipos';\r\n}\r\n\r\nfunction updateTabStates() {\r\n  for (const tab of tabBar.querySelectorAll('.tab')) {\r\n    const id = tab.dataset.id;\r\n    if (id === MARCADOR_GROUP_TAB_ID) {\r\n      tab.classList.toggle('active', MARCADOR_SUBSECTION_IDS.has(activeId));\r\n      const anyOn = MARCADOR_SUBSECTIONS.some((s) => serverState[s.id] && serverState[s.id].status === MODULE_STATUS.ON);\r\n      tab.classList.toggle('on-air', anyOn);\r\n      continue;\r\n    }\r\n    tab.classList.toggle('active', id === activeId);\r\n    const st = serverState[id];\r\n    tab.classList.toggle('on-air', st && st.status === MODULE_STATUS.ON);\r\n  }\r\n}\r\n\r\nfunction selectModule(id) {\r\n  if (id !== activeId && saveTimers[activeId] && activeId !== 'abreviaturas') {\r\n    clearTimeout(saveTimers[activeId]);\r\n    delete saveTimers[activeId];\r\n    ws.send({ type: WS_MSG.UPDATE, moduleId: activeId, data: draft[activeId], isAutoSave: true });\r\n    sendPreviewUpdateIfActive(activeId);\r\n  }\r\n  // VS COMPACTO no se opera en Argentina Streamers (ver Z\u00D3CALO VS): si la\r\n  // ultima subseccion recordada era esa, el grupo abre MARCADOR PRINCIPAL.\r\n  if (id === 'vs' && activeThemeId === ARGENTINA_STREAMERS_THEME_ID) id = 'scoreboard';\r\n  activeId = id;\r\n  if (MARCADOR_SUBSECTION_IDS.has(id)) lastMarcadorSubId = id;\r\n  updateTabStates();\r\n  renderPanel();\r\n}\r\n\r\n// \"AJUSTE DE COMPOSICI\u00D3N\" generico para CUALQUIER modulo (2026-08-31,\r\n// pedido explicito del usuario: extender la filosofia de edicion\r\n// individual del Marcador a TODO LIVE GRAPHICS, via un registro\r\n// declarativo -- ver shared/adjust-registry.js). Reemplaza la funcion\r\n// hecha a medida que existia solo para \"scoreboard\" -- ese modulo ahora\r\n// es una entrada mas de ADJUST_REGISTRY, sin tratamiento especial.\r\n//\r\n// \"COMPOSICI\u00D3N COMPLETA\" es SIEMPRE la primera seccion, para los 30\r\n// modulos por igual (usa compositionOffsetX/Y/Scale, ya universal via\r\n// COMPOSITION_DEFAULTS en shared/modules.js -- ningun modulo necesita\r\n// declararla en el registro). Despues, una seccion por cada entrada de\r\n// ADJUST_REGISTRY[moduleId]?.elements (si el modulo todavia no tiene\r\n// registro, o tiene el arreglo vacio, el acordeon queda con esa unica\r\n// seccion -- sigue siendo mejor que el control unico de antes, porque ya\r\n// trae GUARDAR POSICI\u00D3N). Cada seccion usa exactamente el mismo\r\n// mecanismo generico que ya probo el Marcador (renderCompositionControl /\r\n// mountAdjustControl -> textAdjust), asi que heredan LIVE (isVisualKey en\r\n// program/js/main.js, sin cambios ahi) + persistencia por theme\r\n// (cloneDefaults/state.byTheme, sin cambios ahi) + GUARDAR POSICI\u00D3N\r\n// (save-position-control.js) sin logica nueva por elemento.\r\n// Arma un \"<details>\" de acordeon reusable -- extraido para que\r\n// renderModuleAdjustAccordion y el panel dedicado de Penales de Argentina\r\n// Streamers (renderPenalesArgentinaSections mas abajo) compartan el mismo\r\n// look/comportamiento sin duplicar el helper.\r\nfunction buildAccordionSection(container, title, build) {\r\n  const details = document.createElement('details');\r\n  details.className = 'adjust-accordion-section';\r\n  const summary = document.createElement('summary');\r\n  summary.textContent = title;\r\n  details.appendChild(summary);\r\n  const body = document.createElement('div');\r\n  details.appendChild(body);\r\n  build(body);\r\n  container.appendChild(details);\r\n}\r\n\r\n// Renderiza UNA entrada \"kind:'composition'\" del registro dentro de una\r\n// seccion de acordeon ya creada -- extraido de renderModuleAdjustAccordion\r\n// para que el panel dedicado de Penales (Argentina Streamers) pueda\r\n// reusar exactamente la misma logica (incluida la resolucion de escudo\r\n// por equipo) sin duplicarla.\r\nfunction renderCompositionEntry(body, entry, data, onDirty, saveOptions) {\r\n  const crestTarget = entry.crestTeam ? resolveCrestTeamTarget(entry, data) : null;\r\n  if (crestTarget) {\r\n    renderCompositionControl(body, crestTarget.data, onDirty, {\r\n      title: '', note: `Posici\u00F3n propia de ${crestTarget.label} en este slot -- independiente de los dem\u00E1s equipos.`,\r\n      keys: { xKey: entry.xKey, yKey: entry.yKey, scaleKey: entry.scaleKey },\r\n      ...saveOptions,\r\n      elementSpec: { kind: 'composition', dataPath: crestTarget.dataPath, xKey: entry.xKey, yKey: entry.yKey, scaleKey: entry.scaleKey },\r\n    });\r\n  } else {\r\n    renderCompositionControl(body, data, onDirty, {\r\n      title: '', note: '',\r\n      keys: { xKey: entry.xKey, yKey: entry.yKey, scaleKey: entry.scaleKey },\r\n      ...saveOptions,\r\n      elementSpec: { kind: 'composition', dataPath: [], xKey: entry.xKey, yKey: entry.yKey, scaleKey: entry.scaleKey },\r\n    });\r\n  }\r\n}\r\n\r\nfunction renderModuleAdjustAccordion(container, moduleId, data) {\r\n  container.innerHTML = '';\r\n  const onDirty = () => scheduleAutoSave(moduleId);\r\n  const saveOptions = buildSaveOptions(moduleId);\r\n  const section = (title, build) => buildAccordionSection(container, title, build);\r\n\r\n  // Panel dedicado (2026-09-01, pedido explicito del usuario: \"control\r\n  // total desde Master Control\" para los 10 circulos de Penales + nombres\r\n  // de equipo, agrupados en 2 acordeones propios en vez del listado plano\r\n  // de siempre) -- SOLO para Argentina Streamers. GLA sigue exactamente\r\n  // por el camino generico de abajo, sin ningun cambio.\r\n  if (moduleId === 'marcadorPenales' && activeThemeId === ARGENTINA_STREAMERS_THEME_ID) {\r\n    renderPenalesArgentinaSections(container, data, onDirty, saveOptions, section);\r\n    return;\r\n  }\r\n\r\n  const heading = document.createElement('h2');\r\n  heading.className = 'adjust-accordion-heading';\r\n  heading.textContent = 'AJUSTE DE COMPOSICI\u00D3N';\r\n  container.appendChild(heading);\r\n\r\n  section('COMPOSICI\u00D3N COMPLETA', (body) => {\r\n    renderCompositionControl(body, data, onDirty, {\r\n      title: '', note: 'Mueve y escala TODO el m\u00F3dulo como una sola unidad.',\r\n      keys: { xKey: 'compositionOffsetX', yKey: 'compositionOffsetY', scaleKey: 'compositionScale' },\r\n      ...saveOptions,\r\n      elementSpec: { kind: 'composition', dataPath: [], xKey: 'compositionOffsetX', yKey: 'compositionOffsetY', scaleKey: 'compositionScale' },\r\n    });\r\n  });\r\n\r\n  const entries = ADJUST_REGISTRY[moduleId]?.elements || [];\r\n  for (const entry of entries) {\r\n    // \"themeOnly\" (ver shared/adjust-registry.js): entradas nuevas que\r\n    // solo tienen sentido para un theme puntual -- GLA nunca las ve en\r\n    // este acordeon generico, sin tener que declarar nada especial en\r\n    // shared/modules.js ni en Program.\r\n    if (entry.themeOnly && entry.themeOnly !== activeThemeId) continue;\r\n    // \"variant\" (Z\u00D3CALO VS): solo los ajustes de la variante elegida.\r\n    if (entry.variant && entry.variant !== data.variante) continue;\r\n    if (entry.kind === 'text') {\r\n      section(entry.label, (body) => {\r\n        mountAdjustControl(body, data, entry.textKey, onDirty, saveOptions);\r\n      });\r\n    } else if (entry.kind === 'composition') {\r\n      section(entry.label, (body) => renderCompositionEntry(body, entry, data, onDirty, saveOptions));\r\n    }\r\n  }\r\n}\r\n\r\n// PANEL DEDICADO \u2014 MARCADOR DE PENALES (ARGENTINA STREAMERS) (2026-09-01,\r\n// pedido explicito del usuario, seccion 15 de su mensaje: \"AJUSTE DE\r\n// INTENTOS\" con los 10 circulos agrupados, y \"AJUSTE DE ELEMENTOS\" con\r\n// el resto, en vez del listado plano de siempre). Reusa\r\n// renderCompositionEntry/mountAdjustControl -- ningun mecanismo nuevo,\r\n// solo una agrupacion/orden distinta de las MISMAS entradas del registro\r\n// (mas \"COMPOSICI\u00D3N COMPLETA\", que para este panel se movio al final del\r\n// segundo grupo en vez de ser siempre la primera seccion, tal como pidio\r\n// el usuario).\r\nfunction renderPenalesArgentinaSections(container, data, onDirty, saveOptions, section) {\r\n  const entries = ADJUST_REGISTRY.marcadorPenales?.elements || [];\r\n  const byId = Object.fromEntries(entries.map((e) => [e.id, e]));\r\n\r\n  const heading1 = document.createElement('h2');\r\n  heading1.className = 'adjust-accordion-heading';\r\n  heading1.textContent = 'AJUSTE DE INTENTOS';\r\n  container.appendChild(heading1);\r\n\r\n  const kickIds = [\r\n    'kickLocal1', 'kickLocal2', 'kickLocal3', 'kickLocal4', 'kickLocal5',\r\n    'kickVisitante1', 'kickVisitante2', 'kickVisitante3', 'kickVisitante4', 'kickVisitante5',\r\n  ];\r\n  for (const id of kickIds) {\r\n    const entry = byId[id];\r\n    if (!entry) continue;\r\n    section(entry.label, (body) => renderCompositionEntry(body, entry, data, onDirty, saveOptions));\r\n  }\r\n\r\n  const heading2 = document.createElement('h2');\r\n  heading2.className = 'adjust-accordion-heading';\r\n  heading2.textContent = 'AJUSTE DE ELEMENTOS';\r\n  container.appendChild(heading2);\r\n\r\n  const elementSections = [\r\n    ['nombreLocal', 'NOMBRE LOCAL'],\r\n    ['nombreVisitante', 'NOMBRE VISITANTE'],\r\n    ['localCrest', 'ESCUDO LOCAL'],\r\n    ['awayCrest', 'ESCUDO VISITANTE'],\r\n    ['scoreA', 'RESULTADO LOCAL'],\r\n    ['separator', 'GUI\u00D3N'],\r\n    ['scoreB', 'RESULTADO VISITANTE'],\r\n    // SPONSOR eliminado de Penales AS (2026-10-09, pedido explicito del\r\n    // usuario) -- GLA conserva su sponsor por el acordeon generico.\r\n  ];\r\n  for (const [id, label] of elementSections) {\r\n    const entry = byId[id];\r\n    if (!entry) continue;\r\n    section(label, (body) => {\r\n      if (entry.kind === 'text') {\r\n        mountAdjustControl(body, data, entry.textKey, onDirty, saveOptions);\r\n      } else {\r\n        renderCompositionEntry(body, entry, data, onDirty, saveOptions);\r\n      }\r\n    });\r\n  }\r\n\r\n  section('COMPOSICI\u00D3N COMPLETA', (body) => {\r\n    renderCompositionControl(body, data, onDirty, {\r\n      title: '', note: 'Mueve y escala TODO el m\u00F3dulo como una sola unidad.',\r\n      keys: { xKey: 'compositionOffsetX', yKey: 'compositionOffsetY', scaleKey: 'compositionScale' },\r\n      ...saveOptions,\r\n      elementSpec: { kind: 'composition', dataPath: [], xKey: 'compositionOffsetX', yKey: 'compositionOffsetY', scaleKey: 'compositionScale' },\r\n    });\r\n  });\r\n}\r\n\r\n// POSICI\u00D3N DE ESCUDO POR EQUIPO (2026-09-01, pedido explicito del\r\n// usuario -- ver \"crestTeam\" en shared/adjust-registry.js). Solo tiene\r\n// efecto en Argentina Streamers: para cualquier otro theme (GLA)\r\n// devuelve null a proposito y el caller usa el camino de siempre (una\r\n// unica posicion por slot) -- \"GRAN LIGA REL\u00C1MPAGO debe quedar\r\n// exactamente como est\u00E1\" es un requisito explicito de esta misma tarea.\r\n//\r\n// Resuelve el teamId SIEMPRE contra el Marcador (draft.scoreboard.teamA/\r\n// teamB) -- confirmado leyendo los 10 renderers que muestran escudos de\r\n// equipo (scoreboard/marcadorEntretiempo/marcadorPenales/vsPrepartido/\r\n// vsResultado/vs/zocaloCompuesto/estrellas heredan sb.teamA/teamB en\r\n// vivo; tarjeta/cambios heredan el mismo par pero eligen uno segun\r\n// \"data.equipo\") -- ninguno tiene un campo de equipo propio distinto.\r\n//\r\n// Sin equipo seleccionado todavia en ese slot: devuelve null (mismo\r\n// comportamiento de siempre, el operador ajusta el generico) -- \"no\r\n// quiero errores si aparece un equipo nuevo sin configuracion\" ya queda\r\n// cubierto porque CUALQUIER teamId nuevo simplemente no tiene entrada\r\n// en \"crestByTeam\" todavia, y se inicializa aca mismo desde el valor\r\n// generico actual (fallback), nunca desde 0/0/1.\r\nfunction resolveCrestTeamTarget(entry, data) {\r\n  if (activeThemeId !== ARGENTINA_STREAMERS_THEME_ID) return null;\r\n\r\n  // BUG encontrado y corregido (2026-09-04, \"los controles no mueven el\r\n  // escudo correctamente\" en Cronograma Hoy): esta funcion es GENERICA,\r\n  // compartida por todos los modulos con \"crestTeam\" (vsPrepartido,\r\n  // vsResultado, zocaloCompuestoEquipos, etc.) -- todos ellos heredan\r\n  // LOCAL/VISITANTE del Marcador de verdad, asi que resolvia el teamId\r\n  // SIEMPRE contra \"draft.scoreboard.teamA/teamB\". Pero \"cronogramaHoy\"\r\n  // dejo de depender del Marcador este mismo dia (seleccion manual propia,\r\n  // \"data.teamLocal\"/\"data.teamVisitante\", ver shared/modules.js) -- esta\r\n  // funcion nunca se actualizo para ese caso, asi que el editor de\r\n  // composicion seguia guardando/leyendo bajo el equipo del MARCADOR\r\n  // (normalmente otro distinto), mientras el renderer (program/js/\r\n  // renderers/cronogramaHoy.js) ya lee \"data.crestByTeam[slot][teamId]\"\r\n  // con el teamId de \"teamLocal\"/\"teamVisitante\" -- mover las flechas\r\n  // escribia en una entrada que el renderer nunca leia, asi que en\r\n  // pantalla no pasaba nada. \"data.teamLocal\" (con \"!== undefined\", no\r\n  // solo truthy: hay que distinguir \"este modulo tiene seleccion manual\r\n  // propia\" de \"el campo esta vacio ahora mismo\") es una se\u00F1al exclusiva\r\n  // de \"cronogramaHoy\" hoy -- ningun otro modulo con \"crestTeam\" declara\r\n  // ese campo.\r\n  const hasManualTeamSelection = data.teamLocal !== undefined && data.teamVisitante !== undefined;\r\n\r\n  let slot;\r\n  let teamId;\r\n  if (entry.crestTeam === 'dynamic') {\r\n    const isVisitante = data.equipo === 'visitante';\r\n    slot = isVisitante ? 'away' : 'local';\r\n    teamId = isVisitante ? draft.scoreboard?.teamB : draft.scoreboard?.teamA;\r\n  } else if (entry.crestTeam === 'B') {\r\n    slot = 'away';\r\n    teamId = hasManualTeamSelection ? data.teamVisitante : draft.scoreboard?.teamB;\r\n  } else {\r\n    slot = 'local';\r\n    teamId = hasManualTeamSelection ? data.teamLocal : draft.scoreboard?.teamA;\r\n  }\r\n  // \"crestSlot\" (Z\u00D3CALO VS, 2026-10-09): slot propio por variante, ver\r\n  // shared/adjust-registry.js -- mismo criterio en program/js/visual-compose.js.\r\n  if (entry.crestSlot) slot = entry.crestSlot;\r\n  if (!teamId) return null;\r\n\r\n  if (typeof data.crestByTeam !== 'object' || data.crestByTeam === null) data.crestByTeam = {};\r\n  if (typeof data.crestByTeam[slot] !== 'object' || data.crestByTeam[slot] === null) data.crestByTeam[slot] = {};\r\n  if (typeof data.crestByTeam[slot][teamId] !== 'object' || data.crestByTeam[slot][teamId] === null) {\r\n    // Primera vez que se toca este equipo en este slot: arranca desde el\r\n    // valor GEN\u00C9RICO actual del slot (fallback), nunca desde 0/0/1 --\r\n    // \"preservar los defaults/layouts actuales como fallback\" (pedido\r\n    // explicito). A partir de aca es un objeto independiente: modificarlo\r\n    // no vuelve a tocar la version generica de \"data\".\r\n    data.crestByTeam[slot][teamId] = {\r\n      [entry.xKey]: data[entry.xKey] ?? 0,\r\n      [entry.yKey]: data[entry.yKey] ?? 0,\r\n      [entry.scaleKey]: data[entry.scaleKey] ?? 1,\r\n    };\r\n  }\r\n\r\n  return {\r\n    data: data.crestByTeam[slot][teamId],\r\n    dataPath: ['crestByTeam', slot, teamId],\r\n    label: teamName(teamId) || teamId,\r\n  };\r\n}\r\n\r\nfunction renderPanel() {\r\n  if (panelCleanup) {\r\n    panelCleanup();\r\n    panelCleanup = null;\r\n  }\r\n  if (assetResourcesCleanup) {\r\n    assetResourcesCleanup();\r\n    assetResourcesCleanup = null;\r\n  }\r\n  assetResourceContainer.innerHTML = '';\r\n\r\n  mcPanel.scrollTop = 0;\r\n\r\n  if (activeId === 'abreviaturas') {\r\n    // \"marcadorSubnav\" (bug preexistente encontrado durante BLOQUE 3, se\r\n    // corrige de paso por ser identico al que afecta a \"jugadoresAdmin\"\r\n    // mas abajo): si el operador viene de MARCADOR/alguna de sus\r\n    // subsecciones, el sub-nav quedaba visible encima de este panel porque\r\n    // el bloque que lo oculta (mas abajo en esta funcion) nunca se\r\n    // alcanzaba con un \"return\" temprano.\r\n    if (marcadorSubnav) marcadorSubnav.style.display = 'none';\r\n    panelTitle.textContent = 'Equipos';\r\n    if (panelAssetBadge) panelAssetBadge.hidden = true;\r\n    fieldsContainer.innerHTML = '';\r\n    extraContainer.innerHTML = '';\r\n    compositionContainer.innerHTML = '';\r\n    takeBtn.style.display = 'none';\r\n    updateBtn.style.display = 'none';\r\n    outBtn.style.display = 'none';\r\n    previewBtn.style.display = 'none';\r\n    panelCleanup = renderEquiposPanel(extraContainer, {\r\n      themeId: activeThemeId,\r\n      teamColors: activeThemeId === DEFAULT_THEME_ID ? glaTeamColors : null,\r\n    });\r\n    updatePanelStatus();\r\n    return;\r\n  }\r\n\r\n  // ACTUALIZADOR DE DATOS solo existe en GLA: si se cambia de theme parado\r\n  // ahi, se vuelve al Marcador.\r\n  if (activeId === 'actualizadorDatos' && activeThemeId !== DEFAULT_THEME_ID) activeId = 'scoreboard';\r\n  if (activeId === 'actualizadorDatos') {\r\n    if (marcadorSubnav) marcadorSubnav.style.display = 'none';\r\n    panelTitle.textContent = 'Actualizador de datos \u2014 Torneo';\r\n    if (panelAssetBadge) panelAssetBadge.hidden = true;\r\n    fieldsContainer.innerHTML = '';\r\n    extraContainer.innerHTML = '';\r\n    compositionContainer.innerHTML = '';\r\n    takeBtn.style.display = 'none';\r\n    updateBtn.style.display = 'none';\r\n    outBtn.style.display = 'none';\r\n    previewBtn.style.display = 'none';\r\n    panelCleanup = renderActualizadorDatosPanel(extraContainer);\r\n    updatePanelStatus();\r\n    return;\r\n  }\r\n\r\n  if (activeId === 'jugadoresAdmin') {\r\n    if (marcadorSubnav) marcadorSubnav.style.display = 'none';\r\n    panelTitle.textContent = 'Jugadores \u2014 Administraci\u00F3n de planteles';\r\n    if (panelAssetBadge) panelAssetBadge.hidden = true;\r\n    fieldsContainer.innerHTML = '';\r\n    extraContainer.innerHTML = '';\r\n    compositionContainer.innerHTML = '';\r\n    takeBtn.style.display = 'none';\r\n    updateBtn.style.display = 'none';\r\n    outBtn.style.display = 'none';\r\n    previewBtn.style.display = 'none';\r\n    panelCleanup = renderJugadoresPanel(extraContainer, draft.scoreboard);\r\n    updatePanelStatus();\r\n    return;\r\n  }\r\n\r\n  takeBtn.style.display = '';\r\n  updateBtn.style.display = '';\r\n  outBtn.style.display = '';\r\n  previewBtn.style.display = '';\r\n  // \"ACTUALIZAR\" eliminado de TODAS las subsecciones de MARCADOR\r\n  // (BLOQUE 2 para \"scoreboard\"; ampliado 2026-09-10 al resto -- pedido\r\n  // explicito del usuario: \"todas las subsecciones de MARCADOR deben ser\r\n  // LIVE, no solo el Marcador Principal\"). Confirmado que TODO lo que antes\r\n  // dependia de este boton en estas 5 subsecciones ya opera LIVE sin el\r\n  // (ver \"sendMarcadorSubsectionLive\" mas abajo) -- queda redundante solo\r\n  // aca. TOMAR AL AIRE/SACAR DEL AIRE siguen intactos, y el resto de los\r\n  // modulos de LIVE GRAPHICS (fuera de MARCADOR) conserva ACTUALIZAR sin\r\n  // cambios, a proposito -- \"no convertir globalmente todo a live-edit\".\r\n  // \"formacionEquipos\" (2026-09-10, pedido explicito del usuario, mismo\r\n  // criterio que MARCADOR): ACTUALIZAR queda redundante ahi tambien, ver\r\n  // \"sendFormacionLive\" mas abajo. \"ALWAYS_LIVE_MODULE_IDS\" (mismo dia,\r\n  // ronda de correcciones siguiente): VAR Chequeo y Replay, mismo criterio.\r\n  if (MARCADOR_SUBSECTION_IDS.has(activeId) || activeId === 'formacionEquipos' || ALWAYS_LIVE_MODULE_IDS.has(activeId) || isArgentinaLiveModule(activeId)) {\r\n    updateBtn.style.display = 'none';\r\n  }\r\n\r\n  const mod = MODULES[activeId];\r\n  const idForThisRender = activeId;\r\n\r\n  // Sub-nav de MARCADOR (2026-08-15, pedido explicito del usuario): solo\r\n  // se muestra cuando la pesta\u00F1a activa es una de las 5 subsecciones\r\n  // agrupadas (ver MARCADOR_SUBSECTIONS mas arriba). Reutiliza\r\n  // \"selectModule\" tal cual, mismo camino que cualquier otra tab.\r\n  if (marcadorSubnav) {\r\n    marcadorSubnav.innerHTML = '';\r\n    if (MARCADOR_SUBSECTION_IDS.has(activeId)) {\r\n      marcadorSubnav.style.display = '';\r\n      panelTitle.textContent = `MARCADOR \u2014 ${mod.label}`;\r\n      updateAssetBadge(activeId);\r\n      for (const sub of MARCADOR_SUBSECTIONS) {\r\n        // Z\u00D3CALO VS (2026-10-09): en Argentina Streamers el VS deja de ser\r\n        // parte del grupo MARCADOR -- vive como modulo propio (\"zocaloVs\").\r\n        // GLA conserva su VS COMPACTO aca, sin cambios.\r\n        if (sub.id === 'vs' && activeThemeId === ARGENTINA_STREAMERS_THEME_ID) continue;\r\n        const subBtn = document.createElement('button');\r\n        subBtn.type = 'button';\r\n        subBtn.className = 'marcador-subnav-btn';\r\n        subBtn.textContent = sub.label;\r\n        subBtn.classList.toggle('active', sub.id === activeId);\r\n        const st = serverState[sub.id];\r\n        subBtn.classList.toggle('on-air', st && st.status === MODULE_STATUS.ON);\r\n        subBtn.addEventListener('click', () => selectModule(sub.id));\r\n        marcadorSubnav.appendChild(subBtn);\r\n      }\r\n      renderMarcadorEntretiempoToggle(marcadorSubnav);\r\n      renderShootoutToggle(marcadorSubnav);\r\n    } else {\r\n      marcadorSubnav.style.display = 'none';\r\n      panelTitle.textContent = moduleDisplayLabel(activeId);\r\n      updateAssetBadge(activeId);\r\n    }\r\n  } else {\r\n    panelTitle.textContent = moduleDisplayLabel(activeId);\r\n    updateAssetBadge(activeId);\r\n  }\r\n\r\n  let fields = mod.fields;\r\n  // COLOR PERSONALIZADO (2026-10-23, SOLO GLA): el selector de color del\r\n  // Marcador suma PERSONALIZADO (el HEX exacto se elige en EQUIPOS; si el\r\n  // equipo todavia no tiene uno, arranca del color que tenia).\r\n  if (activeId === 'scoreboard' && activeThemeId === DEFAULT_THEME_ID) {\r\n    fields = fields.map((field) => (field.key === 'teamAColor' || field.key === 'teamBColor')\r\n      ? { ...field, options: [...field.options, { id: CUSTOM_COLOR_ID, label: 'Personalizado' }] }\r\n      : field);\r\n  }\r\n  const isRosterEvent = activeId === 'tarjeta' || activeId === 'cambios';\r\n  if (isRosterEvent) {\r\n    const localName = teamName(draft.scoreboard.teamA) || 'Sin equipo';\r\n    const visitorName = teamName(draft.scoreboard.teamB) || 'Sin equipo';\r\n    fields = mod.fields.map((field) => field.key === 'equipo' ? {\r\n      ...field,\r\n      options: [\r\n        { id: 'local', label: `LOCAL \u2014 ${localName}` },\r\n        { id: 'visitante', label: `VISITANTE \u2014 ${visitorName}` },\r\n      ],\r\n    } : field);\r\n  }\r\n  // \"NOMBRE MOSTRADO\" (2026-09-01, pedido explicito del usuario: VS\r\n  // Prepartido/VS Con Resultado necesitan un nombre de broadcast propio\r\n  // por equipo, AUTOM\u00C1TICO o MANUAL -- ver shared/broadcast-names.js).\r\n  // Los campos \"nameAMode/nameAManual/nameBMode/nameBManual\" YA existen\r\n  // en los defaults de ambos modulos (shared/modules.js, validos para\r\n  // cualquier theme), pero el CONTROL solo se agrega para Argentina\r\n  // Streamers -- GLA nunca ve estos 4 campos nuevos en su panel (mismo\r\n  // criterio que \"usesAdjustAccordion\" mas abajo: \"GRAN LIGA REL\u00C1MPAGO\r\n  // debe quedar exactamente como est\u00E1\", pedido explicito de esta tarea).\r\n  const isVsNameModule = (activeId === 'vsPrepartido' || activeId === 'vsResultado') && activeThemeId === ARGENTINA_STREAMERS_THEME_ID;\r\n  if (isVsNameModule) {\r\n    const nameModeOptions = [\r\n      { id: 'auto', label: 'AUTOM\u00C1TICO' },\r\n      { id: 'manual', label: 'MANUAL' },\r\n    ];\r\n    const extraFields = [\r\n      { key: 'nameAMode', label: 'NOMBRE LOCAL \u2014 MODO', type: FIELD_TYPES.SELECT, options: nameModeOptions },\r\n      { key: 'nameAManual', label: 'NOMBRE LOCAL MANUAL (solo si MODO = MANUAL)', type: FIELD_TYPES.TEXT },\r\n      { key: 'nameBMode', label: 'NOMBRE VISITANTE \u2014 MODO', type: FIELD_TYPES.SELECT, options: nameModeOptions },\r\n      { key: 'nameBManual', label: 'NOMBRE VISITANTE MANUAL (solo si MODO = MANUAL)', type: FIELD_TYPES.TEXT },\r\n    ];\r\n    const tituloIdx = fields.findIndex((f) => f.key === 'titulo');\r\n    const insertAt = tituloIdx === -1 ? 0 : tituloIdx + 1;\r\n    fields = [...fields.slice(0, insertAt), ...extraFields, ...fields.slice(insertAt)];\r\n  }\r\n  // \"NOMBRE EQUIPO LOCAL/VISITANTE\" de Penales (2026-09-01, pedido\r\n  // explicito del usuario, seccion 4-7 de su mensaje): misma logica\r\n  // AUTOM\u00C1TICO/MANUAL de VS Prepartido/Resultado de arriba, reusando el\r\n  // mismo mapping de shared/broadcast-names.js -- solo que ac\u00E1 los campos\r\n  // se llaman \"nombreLocalMode/nombreLocalManual/nombreVisitanteMode/\r\n  // nombreVisitanteManual\" (shared/modules.js). Van en la secci\u00F3n \"DATOS\"\r\n  // pedida, ANTES de \"kicksA/kicksB\" (INTENTOS) -- se insertan justo\r\n  // despu\u00E9s de \"titulo\".\r\n  const isPenalesArgentina = activeId === 'marcadorPenales' && activeThemeId === ARGENTINA_STREAMERS_THEME_ID;\r\n  if (isPenalesArgentina) {\r\n    // Sin selector de SPONSOR en Penales AS (2026-10-09, pedido explicito).\r\n    fields = fields.filter((field) => field.key !== 'sponsor');\r\n    const nameModeOptions = [\r\n      { id: 'auto', label: 'AUTOM\u00C1TICO' },\r\n      { id: 'manual', label: 'MANUAL' },\r\n    ];\r\n    const extraFields = [\r\n      { key: 'nombreLocalMode', label: 'NOMBRE LOCAL \u2014 MODO', type: FIELD_TYPES.SELECT, options: nameModeOptions },\r\n      { key: 'nombreLocalManual', label: 'NOMBRE LOCAL MANUAL (solo si MODO = MANUAL)', type: FIELD_TYPES.TEXT },\r\n      { key: 'nombreVisitanteMode', label: 'NOMBRE VISITANTE \u2014 MODO', type: FIELD_TYPES.SELECT, options: nameModeOptions },\r\n      { key: 'nombreVisitanteManual', label: 'NOMBRE VISITANTE MANUAL (solo si MODO = MANUAL)', type: FIELD_TYPES.TEXT },\r\n    ];\r\n    const tituloIdx = fields.findIndex((f) => f.key === 'titulo');\r\n    const insertAt = tituloIdx === -1 ? 0 : tituloIdx + 1;\r\n    fields = [...fields.slice(0, insertAt), ...extraFields, ...fields.slice(insertAt)];\r\n  }\r\n  // \"MOSTRAR GOLES\" de VS COMPACTO (2026-10-22, pedido explicito del\r\n  // usuario, SOLO GLA): CON GOLES / SIN GOLES, primer control del panel.\r\n  // Cambiarlo se manda EN VIVO (mismo mecanismo que VAR/Replay) para que\r\n  // Preview y Program lo reflejen sin ACTUALIZAR. Argentina Streamers no\r\n  // ve este control.\r\n  const isGlaVsCompacto = activeId === 'vs' && activeThemeId === DEFAULT_THEME_ID;\r\n  if (isGlaVsCompacto) {\r\n    fields = [{\r\n      key: 'mostrarGoles',\r\n      label: 'MOSTRAR GOLES',\r\n      type: FIELD_TYPES.SELECT,\r\n      options: [\r\n        { id: 'con', label: 'CON GOLES' },\r\n        { id: 'sin', label: 'SIN GOLES' },\r\n      ],\r\n    }, ...fields];\r\n  }\r\n  let renderedMostrarGoles = isGlaVsCompacto ? draft.vs.mostrarGoles : null;\r\n  let renderedTeamSide = isRosterEvent ? draft[activeId].equipo : null;\r\n  const isVarCheck = activeId === 'varCheck';\r\n  const renderedMotivoPreset = isVarCheck ? draft.varCheck.motivoPreset : null;\r\n  // \"ASIGNAR COLOR AL EQUIPO\" (2026-08-16, pedido explicito del usuario):\r\n  // al cambiar el equipo local/visitante, autocompletar el color guardado\r\n  // para ese equipo (si existe) -- mismo patron que el auto-completado de\r\n  // nombre en Tarjetas/Cambios de arriba. Sin asignacion previa, vuelve al\r\n  // default neutro (\"gris\") en vez de dejar el color del equipo anterior\r\n  // (pedido explicito: \"no quiero que seleccionar otro equipo herede el\r\n  // color del anterior\").\r\n  const isScoreboard = activeId === 'scoreboard';\r\n  let renderedTeamA = isScoreboard ? draft.scoreboard.teamA : null;\r\n  let renderedTeamB = isScoreboard ? draft.scoreboard.teamB : null;\r\n  let renderedTeamAColor = isScoreboard ? draft.scoreboard.teamAColor : null;\r\n  let renderedTeamBColor = isScoreboard ? draft.scoreboard.teamBColor : null;\r\n  // \"TIPO\" de Z\u00F3calo Compuesto (2026-08-16): cambiar EQUIPOS/LOGO decide\r\n  // si el panel de escudos (extraContainer, mas abajo) tiene sentido\r\n  // mostrarse -- necesita un renderPanel() completo para reflejarlo,\r\n  // mismo patron que isRosterEvent/isScoreboard de arriba.\r\n  const isZocaloCompuesto = activeId === 'zocaloCompuesto';\r\n  let renderedTipo = isZocaloCompuesto ? draft.zocaloCompuesto.tipo : null;\r\n  renderFields(fieldsContainer, fields, draft[activeId], () => {\r\n    if (isRosterEvent && renderedTeamSide !== draft[activeId].equipo) renderPanel();\r\n    if (isScoreboard) {\r\n      // BLOQUE 2 (2026-09-09, pedido explicito del usuario: \"Seleccionar un\r\n      // nuevo equipo debe actualizar inmediatamente nombre/abreviatura/\r\n      // escudo... no quiero que quede una mezcla temporal entre equipo\r\n      // viejo/nuevo\"): \"sendScoreboardLive()\" reemplaza a \"scheduleAutoSave\"\r\n      // para TODOS los campos genericos del Marcador (equipos, colores,\r\n      // sponsor) -- un unico mensaje \"isExplicitUpdate\" con el draft YA\r\n      // actualizado (equipo + color recalculado, mas abajo, en el MISMO\r\n      // tick sincronico) en vez de dos autosaves separados que podian\r\n      // llegar a Program en momentos distintos.\r\n      let colorChanged = false;\r\n      if (renderedTeamA !== draft.scoreboard.teamA) {\r\n        draft.scoreboard.teamAColor = draft.scoreboard.teamColorAssignments?.[draft.scoreboard.teamA] || 'gris';\r\n        colorChanged = true;\r\n      }\r\n      if (renderedTeamB !== draft.scoreboard.teamB) {\r\n        draft.scoreboard.teamBColor = draft.scoreboard.teamColorAssignments?.[draft.scoreboard.teamB] || 'gris';\r\n        colorChanged = true;\r\n      }\r\n      // GLA (2026-10-22): el color pertenece al EQUIPO, no al slot -- elegir\r\n      // otro color para el equipo ya elegido lo guarda en el mismo mapa que\r\n      // edita EQUIPOS (sin boton \"ASIGNAR\" aparte). Si el mismo equipo esta\r\n      // en los dos lados, el otro lado toma el mismo color.\r\n      if (activeThemeId === DEFAULT_THEME_ID) {\r\n        const sb = draft.scoreboard;\r\n        for (const [teamKey, colorKey, rendered] of [['teamA', 'teamAColor', renderedTeamAColor], ['teamB', 'teamBColor', renderedTeamBColor]]) {\r\n          const teamId = sb[teamKey];\r\n          if (!teamId || sb[colorKey] === rendered || colorChanged) continue;\r\n          if (!sb.teamColorAssignments || typeof sb.teamColorAssignments !== 'object') sb.teamColorAssignments = {};\r\n          sb.teamColorAssignments[teamId] = sb[colorKey];\r\n          if (sb[colorKey] === CUSTOM_COLOR_ID && !normalizeHexColor(sb.teamColorCustomHex?.[teamId])) {\r\n            if (!sb.teamColorCustomHex || typeof sb.teamColorCustomHex !== 'object') sb.teamColorCustomHex = {};\r\n            sb.teamColorCustomHex[teamId] = colorHex(rendered && rendered !== CUSTOM_COLOR_ID ? rendered : 'gris');\r\n          }\r\n          if (sb.teamA === teamId && sb.teamAColor !== sb[colorKey]) { sb.teamAColor = sb[colorKey]; colorChanged = true; }\r\n          if (sb.teamB === teamId && sb.teamBColor !== sb[colorKey]) { sb.teamBColor = sb[colorKey]; colorChanged = true; }\r\n        }\r\n        renderedTeamAColor = sb.teamAColor;\r\n        renderedTeamBColor = sb.teamBColor;\r\n      }\r\n      sendScoreboardLive();\r\n      if (colorChanged) renderPanel();\r\n    } else {\r\n      // \"motivoPreset\" (2026-08-15, pedido explicito del usuario): elegir\r\n      // uno de los 3 presets autocompleta \"motivo\" -- PERSONALIZADO deja el\r\n      // texto tal cual esta para que el operador lo tipee a mano. Mismo\r\n      // patron que el auto-completado de nombre de equipo en Tarjetas/\r\n      // Cambios arriba. Se resuelve ANTES de mandar el live/autosave de\r\n      // abajo (no despues, como quedaba antes de volver \"varCheck\" LIVE) --\r\n      // sin este orden, el mensaje en vivo salia con el \"motivo\" viejo (sin\r\n      // autocompletar todavia) y el texto correcto recien llegaba a Program\r\n      // en la proxima edicion del operador.\r\n      let motivoPresetChanged = false;\r\n      if (isVarCheck && renderedMotivoPreset !== draft.varCheck.motivoPreset) {\r\n        if (MOTIVO_PRESET_TEXT[draft.varCheck.motivoPreset]) {\r\n          draft.varCheck.motivo = MOTIVO_PRESET_TEXT[draft.varCheck.motivoPreset];\r\n        }\r\n        motivoPresetChanged = true;\r\n      }\r\n      const vsGoalsChanged = isGlaVsCompacto && renderedMostrarGoles !== draft.vs.mostrarGoles;\r\n      if (vsGoalsChanged) renderedMostrarGoles = draft.vs.mostrarGoles;\r\n      if (vsGoalsChanged || MARCADOR_SUBSECTION_IDS.has(idForThisRender) || ALWAYS_LIVE_MODULE_IDS.has(idForThisRender) || isArgentinaLiveModule(idForThisRender)) {\r\n        sendMarcadorSubsectionLive(idForThisRender);\r\n      } else {\r\n        scheduleAutoSave(idForThisRender);\r\n      }\r\n      if (motivoPresetChanged) renderPanel();\r\n    }\r\n    if (isZocaloCompuesto && renderedTipo !== draft.zocaloCompuesto.tipo) renderPanel();\r\n  }, (() => {\r\n    // Evita duplicar en la lista generica de campos el control de ajuste\r\n    // de un campo de texto que YA vive en el acordeon \"AJUSTE DE\r\n    // COMPOSICI\u00D3N\" (ver renderModuleAdjustAccordion). El acordeon se\r\n    // muestra para cualquier modulo EXCEPTO \"scoreboard\" en GLA (que\r\n    // conserva su interfaz de siempre, sin acordeon) -- mismo condicional\r\n    // que decide que va en compositionContainer, mas abajo. Derivado del\r\n    // registro: cualquier entrada \"kind:'text'\" de ADJUST_REGISTRY[activeId]\r\n    // se oculta aca automaticamente, sin mantener una lista a mano por\r\n    // modulo.\r\n    const usesAdjustAccordion = !(isScoreboard && activeThemeId !== ARGENTINA_STREAMERS_THEME_ID);\r\n    if (!usesAdjustAccordion) return undefined;\r\n    const textKeys = (ADJUST_REGISTRY[activeId]?.elements || [])\r\n      .filter((entry) => entry.kind === 'text')\r\n      .map((entry) => entry.textKey);\r\n    if (!textKeys.length) return undefined;\r\n    return { hideAdjustFor: new Set(textKeys) };\r\n  })());\r\n\r\n  extraContainer.innerHTML = '';\r\n  if (activeId === 'scoreboard') {\r\n    panelCleanup = renderScoreboardClockPanel(extraContainer, draft[activeId], (patch) => {\r\n      ws.send({ type: WS_MSG.UPDATE, moduleId: activeId, data: patch });\r\n      sendPreviewUpdateIfActive(activeId);\r\n    }, {\r\n      onGoalPlus: scoreGoal,\r\n      onGoalMinus: undoGoal,\r\n      onResetGoles: resetGoles,\r\n      onResetLocal: resetGolesLocal,\r\n      onResetVisitante: resetGolesVisitante,\r\n      golData: draft.gol,\r\n      golOnDirty: () => scheduleAutoSave('gol'),\r\n      golSaveOptions: buildSaveOptions('gol'),\r\n      // GLA (2026-10-21): GOL sigue la composicion del Marcador; su control\r\n      // es el ajuste fino RELATIVO, y se puede ver en el bus PREVIEW.\r\n      golRelativeToScoreboard: activeThemeId === DEFAULT_THEME_ID,\r\n      // GLA (2026-10-22): el color se guarda por equipo al elegirlo (ver\r\n      // arriba) y tambien desde EQUIPOS -- los botones \"ASIGNAR COLOR\" ya no\r\n      // hacen falta.\r\n      hideTeamColorAssign: activeThemeId === DEFAULT_THEME_ID,\r\n      onPreviewGol: activeThemeId === DEFAULT_THEME_ID ? () => {\r\n        previewedModuleId = 'gol';\r\n        ws.send({ type: 'PREVIEW_MODULE', moduleId: 'gol', data: draft.gol, allData: draft, replay: true });\r\n      } : null,\r\n    });\r\n  } else if (activeId === 'formacionEquipos') {\r\n    // \"sendFormacionLive\" (2026-09-10, pedido explicito del usuario: \"en\r\n    // FORMACI\u00D3N tampoco quiero depender de ACTUALIZAR... si est\u00E1 al aire,\r\n    // los cambios deben reflejarse inmediatamente\"), mismo patron exacto\r\n    // que \"sendMarcadorSubsectionLive\" -- manda el draft completo con\r\n    // \"isExplicitUpdate:true\" en vez de esperar el debounce+freeze de\r\n    // \"scheduleAutoSave\". Scoped a este unico modulo (no toca el resto).\r\n    panelCleanup = renderFormationListPanel(extraContainer, draft[activeId], draft.scoreboard, () => {\r\n      ws.send({ type: WS_MSG.UPDATE, moduleId: idForThisRender, data: draft[idForThisRender], isExplicitUpdate: true });\r\n      sendPreviewUpdateIfActive(idForThisRender);\r\n    }, {\r\n      transitioning: formationTransitioning,\r\n      pendingSide: formationPendingSide,\r\n      onSelectSide: handleFormationSideChange,\r\n      saveOptions: buildSaveOptions(activeId),\r\n    });\r\n  } else if (activeId === 'shortSimple') {\r\n    // BANCO GLOBAL (2026-09-27, pedido explicito, SOLO GLA): Largo Doble/\r\n    // Corto Simple/Compuesto comparten el mismo banco de presets -- ver\r\n    // \"globalLowerThirdBank\" mas arriba. Argentina Streamers sigue con su\r\n    // \"textPresets\" propio de siempre, sin ningun cambio. \"main\" es el\r\n    // nombre canonico compartido por los 3 modulos (aca es el unico campo\r\n    // de texto que tiene Corto Simple); \"sub\" no aplica -- ni se guarda ni\r\n    // se pide, pero si el preset cargado lo trae (creado desde un modulo\r\n    // doble) simplemente se ignora, nunca se borra del preset.\r\n    if (activeThemeId === DEFAULT_THEME_ID) {\r\n      renderPresetsControl(extraContainer, globalLowerThirdBank, {\r\n        presetKey: 'textPresets',\r\n        title: 'PRESETS DE TEXTO (Z\u00D3CALOS GLA)',\r\n        buttons: [\r\n          { label: 'GUARDAR PRESET', type: 'complete', getFields: () => ({ main: draft.shortSimple.text }) },\r\n        ],\r\n        onApply: (fields) => {\r\n          if (fields.main !== undefined) draft.shortSimple.text = fields.main;\r\n          renderPanel();\r\n          scheduleAutoSave('shortSimple');\r\n        },\r\n        onDirty: saveGlobalLowerThirdBank,\r\n      });\r\n    } else if (activeThemeId === ARGENTINA_STREAMERS_THEME_ID) {\r\n      // BANCO GLOBAL AS (2026-10-08): Corto Simple guarda su texto como\r\n      // MAIN (SUB vacio) y al aplicar usa solo MAIN -- el SUB de un preset\r\n      // creado desde un zocalo doble se ignora sin borrarse.\r\n      if (!themeLowerThirdBank.loaded) {\r\n        renderThemeBankLoadingNote(extraContainer);\r\n      } else {\r\n        renderPresetsControl(extraContainer, themeLowerThirdBank, {\r\n          presetKey: 'textPresets',\r\n          title: 'PRESETS GLOBALES DE Z\u00D3CALOS (LARGO DOBLE / CORTO SIMPLE / COMPUESTO)',\r\n          buttons: [\r\n            { label: 'GUARDAR PRESET', type: 'complete', getFields: () => ({ main: draft.shortSimple.text, sub: '' }) },\r\n          ],\r\n          onApply: (fields) => {\r\n            if (fields.main !== undefined) draft.shortSimple.text = fields.main;\r\n            renderPanel();\r\n            scheduleAutoSave('shortSimple');\r\n          },\r\n          onDirty: saveThemeLowerThirdBank,\r\n        });\r\n      }\r\n    } else {\r\n      renderPresetsControl(extraContainer, draft.shortSimple, {\r\n        presetKey: 'textPresets',\r\n        title: 'PRESETS DE TEXTO (Z\u00D3CALO CORTO SIMPLE)',\r\n        buttons: [\r\n          { label: 'GUARDAR PRESET', type: 'complete', getFields: () => ({ text: draft.shortSimple.text }) },\r\n        ],\r\n        onApply: (fields) => {\r\n          if (fields.text !== undefined) draft.shortSimple.text = fields.text;\r\n          renderPanel();\r\n        },\r\n        onDirty: () => scheduleAutoSave('shortSimple'),\r\n      });\r\n    }\r\n  } else if (activeId === 'shortDouble') {\r\n    panelCleanup = renderShortDoublePanel(extraContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions('shortDouble'));\r\n    // TALENTOS (nombre AS de este modulo, 2026-10-08): banco EXCLUSIVO\r\n    // per-modulo de siempre -- nunca el banco global de zocalos.\r\n    renderPresetsControl(extraContainer, draft.shortDouble, {\r\n      presetKey: 'textPresets',\r\n      title: activeThemeId === ARGENTINA_STREAMERS_THEME_ID ? 'PRESETS DE TALENTOS (EXCLUSIVOS)' : 'PRESETS DE TEXTO (Z\u00D3CALO CORTO DOBLE)',\r\n      // \"double1.name/.role\" (2026-09-26, BUG encontrado y corregido: los\r\n      // presets de Zocalo Corto Doble no guardaban ni cargaban nada -- este\r\n      // panel seguia leyendo/escribiendo \"draft.shortDouble.name/.role\" a\r\n      // nivel raiz, campos eliminados el 2026-09-10 cuando el modo \"single\"\r\n      // paso a reusar \"double1\" directamente, ver shared/modules.js y\r\n      // program/js/renderers/shortDouble.js). El campo visible en pantalla\r\n      // (modo individual) es \"double1\", nunca la raiz.\r\n      buttons: [\r\n        { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ name: draft.shortDouble.double1.name, role: draft.shortDouble.double1.role }) },\r\n        { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ name: draft.shortDouble.double1.name }) },\r\n        { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ role: draft.shortDouble.double1.role }) },\r\n      ],\r\n      onApply: (fields) => {\r\n        if (fields.name !== undefined) draft.shortDouble.double1.name = fields.name;\r\n        if (fields.role !== undefined) draft.shortDouble.double1.role = fields.role;\r\n        renderPanel();\r\n      },\r\n      onDirty: () => scheduleAutoSave('shortDouble'),\r\n    });\r\n  } else if (activeId === 'longDouble') {\r\n    // BANCO GLOBAL (2026-09-27, ver nota completa en \"shortSimple\" arriba):\r\n    // \"main\"/\"sub\" (canonico) <-> \"line1\"/\"line2\" (campo real de este\r\n    // modulo). Argentina Streamers sigue con \"textPresets\" propio.\r\n    if (activeThemeId === DEFAULT_THEME_ID) {\r\n      renderPresetsControl(extraContainer, globalLowerThirdBank, {\r\n        presetKey: 'textPresets',\r\n        title: 'PRESETS DE TEXTO (Z\u00D3CALOS GLA)',\r\n        buttons: [\r\n          { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ main: draft.longDouble.line1, sub: draft.longDouble.line2 }) },\r\n          { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ main: draft.longDouble.line1 }) },\r\n          { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ sub: draft.longDouble.line2 }) },\r\n        ],\r\n        onApply: (fields) => {\r\n          if (fields.main !== undefined) draft.longDouble.line1 = fields.main;\r\n          if (fields.sub !== undefined) draft.longDouble.line2 = fields.sub;\r\n          renderPanel();\r\n          scheduleAutoSave('longDouble');\r\n        },\r\n        onDirty: saveGlobalLowerThirdBank,\r\n      });\r\n    } else if (activeThemeId === ARGENTINA_STREAMERS_THEME_ID) {\r\n      // BANCO GLOBAL AS (2026-10-08): MAIN/SUB <-> line1/line2.\r\n      if (!themeLowerThirdBank.loaded) {\r\n        renderThemeBankLoadingNote(extraContainer);\r\n      } else {\r\n        renderPresetsControl(extraContainer, themeLowerThirdBank, {\r\n          presetKey: 'textPresets',\r\n          title: 'PRESETS GLOBALES DE Z\u00D3CALOS (LARGO DOBLE / CORTO SIMPLE / COMPUESTO)',\r\n          buttons: [\r\n            { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ main: draft.longDouble.line1, sub: draft.longDouble.line2 }) },\r\n            { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ main: draft.longDouble.line1 }) },\r\n            { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ sub: draft.longDouble.line2 }) },\r\n          ],\r\n          onApply: (fields) => {\r\n            if (fields.main !== undefined) draft.longDouble.line1 = fields.main;\r\n            if (fields.sub !== undefined) draft.longDouble.line2 = fields.sub;\r\n            renderPanel();\r\n            scheduleAutoSave('longDouble');\r\n          },\r\n          onDirty: saveThemeLowerThirdBank,\r\n        });\r\n      }\r\n    } else {\r\n      renderPresetsControl(extraContainer, draft.longDouble, {\r\n        presetKey: 'textPresets',\r\n        title: 'PRESETS DE TEXTO (Z\u00D3CALO LARGO DOBLE)',\r\n        buttons: [\r\n          { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ line1: draft.longDouble.line1, line2: draft.longDouble.line2 }) },\r\n          { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ line1: draft.longDouble.line1 }) },\r\n          { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ line2: draft.longDouble.line2 }) },\r\n        ],\r\n        onApply: (fields) => {\r\n          if (fields.line1 !== undefined) draft.longDouble.line1 = fields.line1;\r\n          if (fields.line2 !== undefined) draft.longDouble.line2 = fields.line2;\r\n          renderPanel();\r\n        },\r\n        onDirty: () => scheduleAutoSave('longDouble'),\r\n      });\r\n    }\r\n  } else if (activeId === 'zocaloFinal') {\r\n    renderPresetsControl(extraContainer, draft.zocaloFinal, {\r\n      presetKey: 'textPresets',\r\n      title: 'PRESETS DE TEXTO (Z\u00D3CALO LOGO GLA)',\r\n      buttons: [\r\n        { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ texto1: draft.zocaloFinal.texto1, texto2: draft.zocaloFinal.texto2 }) },\r\n        { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ texto1: draft.zocaloFinal.texto1 }) },\r\n        { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ texto2: draft.zocaloFinal.texto2 }) },\r\n      ],\r\n      onApply: (fields) => {\r\n        if (fields.texto1 !== undefined) draft.zocaloFinal.texto1 = fields.texto1;\r\n        if (fields.texto2 !== undefined) draft.zocaloFinal.texto2 = fields.texto2;\r\n        renderPanel();\r\n      },\r\n      onDirty: () => scheduleAutoSave('zocaloFinal'),\r\n    });\r\n    panelCleanup = renderZocaloSponsorsPanel(extraContainer, draft[activeId], () => scheduleAutoSave(idForThisRender));\r\n  } else if (activeId === 'zocaloFinalDiv') {\r\n    renderZocaloEscudosPanel(extraContainer, draft.zocaloFinalDiv, () => scheduleAutoSave('zocaloFinalDiv'));\r\n    renderPresetsControl(extraContainer, draft.zocaloFinalDiv, {\r\n      presetKey: 'textPresets',\r\n      title: 'PRESETS DE TEXTO (Z\u00D3CALO CON EQUIPOS)',\r\n      buttons: [\r\n        { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ texto1: draft.zocaloFinalDiv.texto1, texto2: draft.zocaloFinalDiv.texto2 }) },\r\n        { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ texto1: draft.zocaloFinalDiv.texto1 }) },\r\n        { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ texto2: draft.zocaloFinalDiv.texto2 }) },\r\n      ],\r\n      onApply: (fields) => {\r\n        if (fields.texto1 !== undefined) draft.zocaloFinalDiv.texto1 = fields.texto1;\r\n        if (fields.texto2 !== undefined) draft.zocaloFinalDiv.texto2 = fields.texto2;\r\n        renderPanel();\r\n      },\r\n      onDirty: () => scheduleAutoSave('zocaloFinalDiv'),\r\n    });\r\n    panelCleanup = renderZocaloSponsorsPanel(extraContainer, draft[activeId], () => scheduleAutoSave(idForThisRender));\r\n  } else if (activeId === 'zocaloCompuesto') {\r\n    // Panel de escudos SOLO tiene sentido en tipo EQUIPOS -- en LOGO no se\r\n    // muestra (pedido explicito: \"al cambiar TIPO... no dejar ambas\r\n    // variantes superpuestas\", aca aplica tambien al propio panel de\r\n    // edicion, no solo a Program).\r\n    if (draft.zocaloCompuesto.tipo !== 'logo') {\r\n      renderZocaloEscudosPanel(extraContainer, draft.zocaloCompuesto, () => scheduleAutoSave('zocaloCompuesto'));\r\n    }\r\n    // BANCO GLOBAL (2026-09-27, ver nota completa en \"shortSimple\" arriba):\r\n    // \"main\"/\"sub\" (canonico) <-> \"texto1\"/\"texto2\" (campo real de este\r\n    // modulo). Argentina Streamers no usa \"zocaloCompuesto\" (usa\r\n    // \"zocaloCompuestoEquipos\"/\"zocaloCompuestoLogo\", paneles propios sin\r\n    // tocar) pero se deja igual el mismo guard por consistencia/seguridad.\r\n    if (activeThemeId === DEFAULT_THEME_ID) {\r\n      renderPresetsControl(extraContainer, globalLowerThirdBank, {\r\n        presetKey: 'textPresets',\r\n        title: 'PRESETS DE TEXTO (Z\u00D3CALOS GLA)',\r\n        buttons: [\r\n          { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ main: draft.zocaloCompuesto.texto1, sub: draft.zocaloCompuesto.texto2 }) },\r\n          { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ main: draft.zocaloCompuesto.texto1 }) },\r\n          { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ sub: draft.zocaloCompuesto.texto2 }) },\r\n        ],\r\n        onApply: (fields) => {\r\n          if (fields.main !== undefined) draft.zocaloCompuesto.texto1 = fields.main;\r\n          if (fields.sub !== undefined) draft.zocaloCompuesto.texto2 = fields.sub;\r\n          renderPanel();\r\n          scheduleAutoSave('zocaloCompuesto');\r\n        },\r\n        onDirty: saveGlobalLowerThirdBank,\r\n      });\r\n    } else {\r\n      renderPresetsControl(extraContainer, draft.zocaloCompuesto, {\r\n        presetKey: 'textPresets',\r\n        title: 'PRESETS DE TEXTO (Z\u00D3CALO COMPUESTO)',\r\n        buttons: [\r\n          { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ texto1: draft.zocaloCompuesto.texto1, texto2: draft.zocaloCompuesto.texto2 }) },\r\n          { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ texto1: draft.zocaloCompuesto.texto1 }) },\r\n          { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ texto2: draft.zocaloCompuesto.texto2 }) },\r\n        ],\r\n        onApply: (fields) => {\r\n          if (fields.texto1 !== undefined) draft.zocaloCompuesto.texto1 = fields.texto1;\r\n          if (fields.texto2 !== undefined) draft.zocaloCompuesto.texto2 = fields.texto2;\r\n          renderPanel();\r\n        },\r\n        onDirty: () => scheduleAutoSave('zocaloCompuesto'),\r\n      });\r\n    }\r\n    panelCleanup = renderZocaloSponsorsPanel(extraContainer, draft[activeId], () => scheduleAutoSave(idForThisRender));\r\n  } else if (activeId === 'vsPrepartido') {\r\n    renderPresetsControl(extraContainer, draft.vsPrepartido, {\r\n      presetKey: 'titlePresets',\r\n      title: 'PRESETS DE T\u00CDTULO (VS PREPARTIDO)',\r\n      buttons: [\r\n        { label: 'GUARDAR T\u00CDTULO', type: 'title', getFields: () => ({ titulo: draft.vsPrepartido.titulo }) },\r\n      ],\r\n      onApply: (fields) => {\r\n        if (fields.titulo !== undefined) draft.vsPrepartido.titulo = fields.titulo;\r\n        renderPanel();\r\n      },\r\n      onDirty: () => scheduleAutoSave('vsPrepartido'),\r\n    });\r\n  } else if (activeId === 'vsResultado') {\r\n    renderPresetsControl(extraContainer, draft.vsResultado, {\r\n      presetKey: 'titlePresets',\r\n      title: 'PRESETS DE T\u00CDTULO (VS CON RESULTADO)',\r\n      buttons: [\r\n        { label: 'GUARDAR T\u00CDTULO', type: 'title', getFields: () => ({ titulo: draft.vsResultado.titulo }) },\r\n      ],\r\n      onApply: (fields) => {\r\n        if (fields.titulo !== undefined) draft.vsResultado.titulo = fields.titulo;\r\n        renderPanel();\r\n      },\r\n      onDirty: () => scheduleAutoSave('vsResultado'),\r\n    });\r\n  } else if (activeId === 'marcadorPenales') {\r\n    renderPenalesPanel(extraContainer, draft[activeId], () => {\r\n      if (isArgentinaLiveModule(idForThisRender)) sendMarcadorSubsectionLive(idForThisRender);\r\n      else scheduleAutoSave(idForThisRender);\r\n    });\r\n  } else if (activeId === 'zocaloVs') {\r\n    // Z\u00D3CALO VS (2026-10-09): todo en vivo (sin ACTUALIZAR); cambiar de\r\n    // variante vuelve a armar el panel para mostrar los ajustes de esa variante.\r\n    panelCleanup = renderZocaloVsPanel(extraContainer, draft[activeId], draft.scoreboard, () => {\r\n      sendMarcadorSubsectionLive(idForThisRender);\r\n    }, { onVarianteChange: () => renderPanel() });\r\n  } else if (activeId === 'grupos') {\r\n    // GLA (2026-10-23): puntos y VALIDAR WEB van en vivo (Grupos reordena\r\n    // en Preview y Program sin ACTUALIZAR); el resto sigue con autosave.\r\n    panelCleanup = renderGruposPanel(extraContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId), {\r\n      onLive: activeThemeId === DEFAULT_THEME_ID ? () => sendMarcadorSubsectionLive(idForThisRender) : null,\r\n    });\r\n  } else if (activeId === 'sideTable') {\r\n    panelCleanup = renderResultadosPanel(extraContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId));\r\n  } else if (activeId === 'estrellas') {\r\n    // Tablas locales de Goleadores/Asistidores (Argentina Streamers,\r\n    // \"ESTRELLA POR\" GOLES/ASISTENCIAS usa su primer jugador por rama).\r\n    panelCleanup = renderEstrellasPanel(extraContainer, draft[activeId], draft['scoreboard'], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId), { goleadores: draft.goleadores, asistidores: draft.asistidores });\r\n  } else if (activeId === 'posiciones') {\r\n    panelCleanup = renderPosicionesPanel(extraContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, { saveOptions: buildSaveOptions(activeId) });\r\n  } else if (activeId === 'posicionesTorneo') {\r\n    panelCleanup = renderPosicionesTorneoPanel(extraContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId));\r\n  } else if (isRosterEvent) {\r\n    panelCleanup = renderMatchRosterPanel(fieldsContainer, draft[activeId], draft.scoreboard, activeId, () => {\r\n      scheduleAutoSave(idForThisRender);\r\n      renderPanel();\r\n    });\r\n  } else if (activeId === 'goleadores' || activeId === 'asistidores' || activeId === 'jugadores') {\r\n    // \"argentinaCtx\" (2026-09-02, pedido explicito del usuario): SOLO se\r\n    // pasa para Argentina Streamers -- ver renderPerformanceTablePanel.\r\n    // \"siblingData\" apunta directo a \"draft\" (misma referencia que ya usa\r\n    // todo este archivo), asi el selector 5/10 SLOTS lee/escribe el\r\n    // estado real sin duplicarlo.\r\n    const argentinaCtx = activeThemeId === ARGENTINA_STREAMERS_THEME_ID\r\n      ? { siblingData: draft, scheduleAutoSave }\r\n      : undefined;\r\n    panelCleanup = renderPerformanceTablePanel(extraContainer, draft[activeId], activeId, () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId), argentinaCtx);\r\n  } else if (activeId === 'fichaJugador') {\r\n    panelCleanup = renderFichaJugadorPanel(extraContainer, draft[activeId], draft.scoreboard, () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId));\r\n  } else if (activeId === 'cronogramaHoy') {\r\n    // ESCUDO POR EQUIPO (2026-10-09, bug real corregido): Cronograma elige\r\n    // LOCAL/VISITANTE dentro de su propio panel; el acordeon de ajuste\r\n    // quedaba atado al equipo de cuando se abrio el panel, asi que mover el\r\n    // escudo despues de cambiar de equipo pisaba la posicion del equipo\r\n    // ANTERIOR. Al cambiar de equipo se vuelve a armar el acordeon.\r\n    let crestTeams = `${draft[activeId].teamLocal}|${draft[activeId].teamVisitante}`;\r\n    panelCleanup = renderCronogramaHoyPanel(fieldsContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n      const nextTeams = `${draft[idForThisRender].teamLocal}|${draft[idForThisRender].teamVisitante}`;\r\n      if (nextTeams !== crestTeams && activeId === idForThisRender) {\r\n        crestTeams = nextTeams;\r\n        renderModuleAdjustAccordion(compositionContainer, idForThisRender, draft[idForThisRender]);\r\n      }\r\n    }, buildSaveOptions(activeId)) || (() => {});\r\n  } else if (activeId === 'resultadosParciales') {\r\n    // T\u00CDTULO con selector ENTRETIEMPO/RESULTADO FINAL/MANUAL: SOLO\r\n    // Argentina Streamers (2026-10-08); GLA conserva su campo de texto libre.\r\n    panelCleanup = renderResultadosParcialesPanel(fieldsContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, { tituloConSelector: activeThemeId === ARGENTINA_STREAMERS_THEME_ID }) || (() => {});\r\n  } else if (activeId === 'historial') {\r\n    panelCleanup = renderHistorialPanel(fieldsContainer, draft[activeId], () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId)) || (() => {});\r\n  } else if (activeId === 'zocaloCompuestoEquipos') {\r\n    // BANCO GLOBAL AS (2026-10-08): este es el \"Z\u00D3CALO COMPUESTO\" de\r\n    // Argentina Streamers -- comparte el banco global con Largo Doble y\r\n    // Corto Simple (null mientras el banco no llego: el panel muestra\r\n    // \"cargando\" en vez de permitir guardar sobre una lista parcial).\r\n    panelCleanup = renderZocaloCompuestoPanel(extraContainer, draft[activeId], draft.scoreboard, () => {\r\n      scheduleAutoSave(idForThisRender);\r\n    }, buildSaveOptions(activeId), {\r\n      holder: themeLowerThirdBank.loaded ? themeLowerThirdBank : null,\r\n      onDirty: saveThemeLowerThirdBank,\r\n    });\r\n  } else if (mod.autoRunClock) {\r\n    // \"FIN DEL CONTADOR\" (2026-08-15, pedido explicito del usuario): solo\r\n    // Marcador Zocalo lo pidio (default 06:00) -- Tiempo Adicional sigue\r\n    // llamando esto SIN el 4to parametro, sin cambios de comportamiento.\r\n    const clockOptions = activeId === 'marcadorZocalo'\r\n      ? { limitKey: 'clockEndText', defaultLimitText: '06:00', onDirty: () => scheduleAutoSave(idForThisRender) }\r\n      : {};\r\n    panelCleanup = renderLiveClockDisplay(extraContainer, draft[activeId], mod.autoRunClock, clockOptions);\r\n  }\r\n\r\n  takeBtn.textContent = mod.oneShot ? 'REPRODUCIR' : 'TOMAR AL AIRE';\r\n  outBtn.textContent = mod.oneShot ? 'DETENER' : 'SACAR DEL AIRE';\r\n  takeBtn.disabled = activeId === 'formacionEquipos' && formationTransitioning;\r\n\r\n  if (activeId === 'scoreboard' && activeThemeId !== ARGENTINA_STREAMERS_THEME_ID) {\r\n    // GLA conserva su control unico de siempre (sin acordeon). GUARDAR\r\n    // POSICI\u00D3N agregado (2026-10-21, pedido explicito del usuario: \"GUARDAR\r\n    // POSICI\u00D3N del Marcador debe consolidar la nueva base sin romper la\r\n    // relacion con Gol\") -- mismo mecanismo que el resto de los modulos.\r\n    renderCompositionControl(compositionContainer, draft[activeId], () => scheduleAutoSave(idForThisRender), {\r\n      ...buildSaveOptions(activeId),\r\n      elementSpec: { kind: 'composition', dataPath: [], xKey: 'compositionOffsetX', yKey: 'compositionOffsetY', scaleKey: 'compositionScale' },\r\n    });\r\n  } else {\r\n    // Todo modulo (con o sin entradas en ADJUST_REGISTRY) usa el acordeon\r\n    // generico -- ver renderModuleAdjustAccordion. \"varCheck\" ya no\r\n    // necesita sus 2 llamadas hardcodeadas: sus 2 grupos (composicion\r\n    // completa = grupo VAR/sponsor, motivoGroup) y su sponsor/motivo\r\n    // ahora viven en shared/adjust-registry.js.\r\n    renderModuleAdjustAccordion(compositionContainer, activeId, draft[activeId]);\r\n  }\r\n\r\n  // RECURSO GR\u00C1FICO (SOFTX): solo aparece si el m\u00F3dulo tiene recursos\r\n  // registrados para el sistema activo (shared/asset-registry.js).\r\n  assetResourcesCleanup = renderAssetResources(assetResourceContainer, activeId, {\r\n    isOnAir: (moduleId) => serverState[moduleId]?.status === MODULE_STATUS.ON,\r\n    onReloaded: previewAfterAssetReload,\r\n  });\r\n\r\n  updatePanelStatus();\r\n}\r\n\r\n// RECARGAR muestra el resultado en el monitor Preview (nunca en Program).\r\nfunction previewAfterAssetReload(moduleId) {\r\n  if (moduleId === 'gol') {\r\n    ws.send({ type: 'PREVIEW_MODULE', moduleId: 'gol', data: draft.gol, allData: draft, replay: true });\r\n    return;\r\n  }\r\n  previewedModuleId = activeId;\r\n  sendPreviewSnapshot(activeId);\r\n}\r\n\r\nfunction updatePanelStatus() {\r\n  if (activeId === 'abreviaturas' || activeId === 'jugadoresAdmin' || activeId === 'actualizadorDatos') {\r\n    panelStatus.textContent = 'CONFIG';\r\n    panelStatus.className = 'status-pill off';\r\n    return;\r\n  }\r\n  const isOn = serverState[activeId] && serverState[activeId].status === MODULE_STATUS.ON;\r\n  panelStatus.textContent = isOn ? 'EN AIRE' : 'FUERA DE AIRE';\r\n  panelStatus.className = isOn ? 'status-pill on' : 'status-pill off';\r\n}\r\n\r\nconst ws = connect({\r\n  onOpen() {\r\n    connStatus.textContent = 'CONECTADO';\r\n    connStatus.className = 'conn on';\r\n    wsConnected = true;\r\n  },\r\n  onClose() {\r\n    connStatus.textContent = 'SIN CONEXION...';\r\n    connStatus.className = 'conn off';\r\n    wsConnected = false;\r\n  },\r\n  onMessage(msg) {\r\n    if (msg.type === 'TEAM_CATALOG_UPDATE') {\r\n      updateLocalTeamCatalog(msg.catalog);\r\n      // \"scoreboard\" agregado (2026-08-21, sistema multi-theme): es el\r\n      // \u00FAnico m\u00F3dulo que muestra el cat\u00E1logo de equipos directo en un\r\n      // SELECT (ver TEAM_OPTIONS en shared/modules.js) -- sin esto, elegir\r\n      // ARGENTINA STREAMERS segu\u00EDa mostrando el desplegable de equipos de\r\n      // GLA hasta cambiar de tab y volver.\r\n      if (activeId === 'abreviaturas' || activeId === 'jugadoresAdmin' || activeId === 'zocaloFinalDiv' || activeId === 'zocaloCompuesto' || activeId === 'scoreboard') {\r\n        renderPanel();\r\n      }\r\n    } else if (msg.type === 'GLA_TORNEO_EDICION_UPDATE') {\r\n      // ACTUALIZADOR DE DATOS (2026-10-21): otra pesta\u00F1a cambio la edicion\r\n      // del torneo -- las leyendas \"FUENTE ACTUAL\" se repintan solas.\r\n      setGlaTorneoEdicion(msg.edicion);\r\n      if (activeId === 'actualizadorDatos') renderPanel();\r\n    } else if (msg.type === 'GLOBAL_LOWER_THIRD_PRESETS_UPDATE') {\r\n      // Mismo motivo que \"TEAM_CATALOG_UPDATE\" arriba: otro Master Control\r\n      // pudo haber guardado/borrado un preset del banco global -- si el\r\n      // operador esta parado en uno de los 3 paneles que lo comparten,\r\n      // refrescar para que la lista se vea al dia.\r\n      if (Array.isArray(msg.presets)) globalLowerThirdBank.textPresets = msg.presets;\r\n      if (GLOBAL_LOWER_THIRD_MODULE_IDS.has(activeId) && activeThemeId === DEFAULT_THEME_ID) renderPanel();\r\n    } else if (msg.type === 'THEME_LOWER_THIRD_PRESETS_UPDATE') {\r\n      if (msg.themeId === themeLowerThirdBank.themeId && Array.isArray(msg.presets)) {\r\n        themeLowerThirdBank.textPresets = msg.presets;\r\n        themeLowerThirdBank.loaded = true;\r\n        if (THEME_LOWER_THIRD_MODULE_IDS.has(activeId) && activeThemeId === msg.themeId) renderPanel();\r\n      }\r\n    } else if (msg.type === WS_MSG.THEME_UPDATE) {\r\n      applyThemeUI(msg.themeId);\r\n    } else if (msg.type === WS_MSG.STATE_SNAPSHOT) {\r\n      if (msg.theme) applyThemeUI(msg.theme);\r\n      // Resync completo de \"draft\" (2026-08-21, sistema multi-theme,\r\n      // pedido expl\u00EDcito: \"el mismo Master cambia... datos... seg\u00FAn\r\n      // THEME\"): un STATE_SNAPSHOT con un theme DISTINTO al que ya ten\u00EDa\r\n      // cargado el draft no es un eco de autoguardado -- es un cambio de\r\n      // contexto real (el operador cambi\u00F3 de theme), as\u00ED que ac\u00E1 S\u00CD\r\n      // corresponde pisar el draft entero con los datos reales del theme\r\n      // nuevo, a diferencia de MODULE_UPDATE (que preserva tipeo en\r\n      // curso). Cualquier edici\u00F3n sin confirmar del theme anterior se\r\n      // pierde de la UI (nunca se hab\u00EDa mandado al servidor, as\u00ED que no\r\n      // se pierde nada persistido).\r\n      const isThemeSwitch = msg.theme && draftThemeId !== null && msg.theme !== draftThemeId;\r\n      if (msg.theme) draftThemeId = msg.theme;\r\n      // \"forceDraftResync\" (auditoria final de perfiles, 2026-09-09): lo\r\n      // manda el servidor tras APLICAR PERFIL -- un reemplazo total e\r\n      // intencional del estado, igual que un cambio de theme -- para que el\r\n      // panel abierto muestre YA los valores del perfil recien aplicado en\r\n      // vez de la posicion vieja que tenia este \"draft\" (ver server/\r\n      // index.js, handler de APPLY_MATCH_PROFILE, para el bug que esto\r\n      // corrige: sin este flag el operador podia pisar el perfil recien\r\n      // aplicado con su propio dato viejo en el proximo autoguardado).\r\n      for (const id of MODULE_IDS) {\r\n        if (msg.state[id]) {\r\n          serverState[id] = msg.state[id];\r\n          if (!snapshotLoaded || isThemeSwitch || msg.forceDraftResync) draft[id] = JSON.parse(JSON.stringify(msg.state[id].data));\r\n        } else {\r\n          console.warn(`[GLA] M\u00F3dulo faltante en el snapshot del servidor: ${id}. Inicializando fallback local.`);\r\n          serverState[id] = { status: MODULE_STATUS.OUT, data: cloneDefaults(id) };\r\n          if (!snapshotLoaded) draft[id] = cloneDefaults(id);\r\n        }\r\n      }\r\n      // Migracion unica (2026-08-16, \"preservar presets existentes si es\r\n      // posible\"): si \"zocaloCompuesto\" todavia esta en blanco (nunca se\r\n      // guardo nada ahi) y alguno de los dos modulos viejos SI tiene\r\n      // contenido real, se copia una sola vez -- solo texto/sponsors/\r\n      // escudos/presets (datos), nunca offsets/escala (esos ya arrancan en\r\n      // 0/0/1 en el modulo nuevo, \"no cambies dise\u00F1o base\"). Prioriza\r\n      // zocaloFinalDiv (Equipos) si ambos tienen contenido; puramente un\r\n      // desempate arbitrario, ninguno pisa al otro (los dos siguen\r\n      // intactos en su propia clave, esto solo COPIA, no borra).\r\n      const zc = draft.zocaloCompuesto;\r\n      const zcEmpty = !zc.texto1 && !zc.texto2 && (!zc.sponsorsRotation || zc.sponsorsRotation.length === 0);\r\n      if (zcEmpty) {\r\n        const zfd = draft.zocaloFinalDiv;\r\n        const zf = draft.zocaloFinal;\r\n        const source = (zfd.texto1 || zfd.texto2) ? { data: zfd, tipo: 'equipos' }\r\n          : (zf.texto1 || zf.texto2) ? { data: zf, tipo: 'logo' }\r\n          : null;\r\n        if (source) {\r\n          zc.tipo = source.tipo;\r\n          zc.texto1 = source.data.texto1 || '';\r\n          zc.texto2 = source.data.texto2 || '';\r\n          zc.sponsorsRotation = Array.isArray(source.data.sponsorsRotation) ? [...source.data.sponsorsRotation] : [];\r\n          zc.textPresets = Array.isArray(source.data.textPresets) ? JSON.parse(JSON.stringify(source.data.textPresets)) : [];\r\n          if (source.tipo === 'equipos') {\r\n            zc.escudosFuente = zfd.escudosFuente || 'MARCADOR';\r\n            zc.customTeamA = zfd.customTeamA || '';\r\n            zc.customTeamB = zfd.customTeamB || '';\r\n            zc.shieldPresets = Array.isArray(zfd.shieldPresets) ? JSON.parse(JSON.stringify(zfd.shieldPresets)) : [];\r\n          }\r\n          scheduleAutoSave('zocaloCompuesto');\r\n        }\r\n      }\r\n      snapshotLoaded = true;\r\n      buildTabs();\r\n      renderPanel();\r\n    } else if (msg.type === WS_MSG.MODULE_UPDATE) {\r\n      // Estado previo (2026-08-16, pedido explicito del usuario: \"cada vez\r\n      // que edito un campo la interfaz se vuelve arriba de todo, pierdo el\r\n      // scroll, se deselecciona el textbox\"). Causa real: CADA autosave de\r\n      // texto (una tecla -> UPDATE -> el servidor le hace eco a este mismo\r\n      // cliente v\u00EDa este mismo MODULE_UPDATE) volvia a llamar renderPanel()\r\n      // completo para \"shortDouble\" sin importar que hubiera cambiado --\r\n      // eso reconstruye TODO el DOM del panel (inputs nuevos, foco/scroll/\r\n      // cursor perdidos) por cada letra tipeada. Ahora solo se reconstruye\r\n      // si de verdad cambio algo que el panel necesita reflejar visualmente\r\n      // sin que el operador haya tocado nada aca mismo (status ON/OFF o\r\n      // modo single/doble, ej. un TAKE/OUT/cambio de modo disparado desde\r\n      // ESTE mismo panel completando su propio viaje de ida y vuelta por\r\n      // WS) -- nunca en cada tecla de \"Nombre\"/\"Rol\"/etc.\r\n      const previousShortDoubleStatus = serverState.shortDouble?.status;\r\n      const previousShortDoubleAirMode = serverState.shortDouble?.data?.airMode;\r\n      const previousMarcadorZocaloStatus = serverState.marcadorZocalo?.status;\r\n      serverState[msg.moduleId] = msg.moduleState;\r\n      // PARTIDOS SORTEO (2026-10-22, SOLO GLA): el servidor reasigno equipos\r\n      // del SORTEO a partir de Grupos -- la copia local de Master Control se\r\n      // refresca para no reenviar equipos viejos en la proxima edicion.\r\n      if (msg.moduleId === 'sideTable' && msg.syncedFromGrupos && activeThemeId === DEFAULT_THEME_ID && msg.moduleState?.data) {\r\n        draft.sideTable = JSON.parse(JSON.stringify(msg.moduleState.data));\r\n        if (activeId === 'sideTable') renderPanel();\r\n        sendPreviewUpdateIfActive('sideTable');\r\n      }\r\n      updateTabStates();\r\n      if (msg.moduleId === activeId) updatePanelStatus();\r\n      if (msg.moduleId === 'scoreboard' && activeId === 'estrellas') {\r\n        renderPanel();\r\n      }\r\n      // SHOOTOUT (2026-09-27): si Penales cambia de estado desde CUALQUIER\r\n      // lado (su propio panel, el boton SHOOTOUT de otro Master Control\r\n      // conectado, la exclusion mutua, etc.) y el operador esta parado en\r\n      // una subseccion de Marcador (donde vive el boton SHOOTOUT), refrescar\r\n      // para que el boton muestre el estado real -- mismo criterio que el\r\n      // resto de este handler (solo re-renderiza si hay algo que reflejar).\r\n      if (msg.moduleId === 'marcadorPenales' && MARCADOR_SUBSECTION_IDS.has(activeId)) {\r\n        renderPanel();\r\n      }\r\n      // MARCADOR Z\u00D3CALO (Argentina Streamers, 2026-10-08): mismo criterio\r\n      // para su acceso rapido, pero SOLO ante un cambio real de ON/OFF --\r\n      // Marcador Z\u00F3calo es una subseccion editable, re-renderizar en cada\r\n      // autosave le robaria el foco al operador mientras escribe.\r\n      if (\r\n        msg.moduleId === 'marcadorZocalo' && activeThemeId === ARGENTINA_STREAMERS_THEME_ID\r\n        && MARCADOR_SUBSECTION_IDS.has(activeId) && msg.moduleState.status !== previousMarcadorZocaloStatus\r\n      ) {\r\n        renderPanel();\r\n      }\r\n      if (\r\n        msg.moduleId === 'shortDouble' && activeId === 'shortDouble'\r\n        && (msg.moduleState.status !== previousShortDoubleStatus\r\n          || msg.moduleState.data?.airMode !== previousShortDoubleAirMode)\r\n      ) {\r\n        renderPanel();\r\n      }\r\n      // GOL: la animacion recien termino (el propio Program la saco del\r\n      // aire sola, ver handleOneShotEnded en program/js/main.js) -- si hay\r\n      // otro gol encolado, recien ahora es el momento de dispararlo, para\r\n      // que nunca queden dos animaciones superpuestas.\r\n      if (msg.moduleId === 'gol' && msg.moduleState.status === MODULE_STATUS.OUT) {\r\n        fireNextGolAnimation();\r\n      }\r\n    }\r\n  },\r\n});\r\n\r\n// Goleadores y Asistidores comparten una unica composicion operativa solo\r\n// en PLACA L. Se reutilizan sus dos estados existentes (uno por tabla): no\r\n// se crea un modulo contenedor ni una segunda fuente de datos. TAKE/UPDATE/\r\n// OUT se envian una vez a cada estado para que Program pinte Goleadores en\r\n// el slot superior y Asistidores en el inferior. Los modos fullscreen no\r\n// pasan por este helper y conservan su operacion individual.\r\nconst PERFORMANCE_PAIR_IDS = ['goleadores', 'asistidores'];\r\n\r\nfunction isPerformancePairModule(id) {\r\n  return PERFORMANCE_PAIR_IDS.includes(id);\r\n}\r\n\r\n// Theme-scoped a proposito (2026-09-02): \"posicion\" default de estos 2\r\n// modulos sigue siendo 'placaL' (shared/modules.js) para CUALQUIER theme\r\n// -- sin este chequeo, una sesion nueva de Argentina Streamers que\r\n// todavia no toco el selector 5/10 SLOTS (ver mas abajo) caeria en el\r\n// mecanismo VIEJO de GLA por el simple hecho de no haber sido editada\r\n// todavia. GLA sigue exactamente igual, nunca usa las posiciones nuevas.\r\nfunction usesPerformancePairPlacaL(id) {\r\n  return activeThemeId !== ARGENTINA_STREAMERS_THEME_ID && isPerformancePairModule(id) && draft[id]?.posicion === 'placaL';\r\n}\r\n\r\nfunction sendPerformancePair(type) {\r\n  for (const id of PERFORMANCE_PAIR_IDS) {\r\n    draft[id].posicion = 'placaL';\r\n    ws.send({ type, moduleId: id, data: draft[id] });\r\n  }\r\n}\r\n\r\n// \"MODO CANTIDAD\" 5/10 SLOTS (2026-09-02, pedido explicito del usuario,\r\n// Argentina Streamers): generaliza el mecanismo de arriba a los 3\r\n// candidatos (Goleadores/Asistidores/Participaciones) y a una eleccion\r\n// LIBRE de cuales 1 o 2 mostrar, en vez del par fijo de GLA. Misma idea:\r\n// \"posicion\" (ya elegida por master-control/js/performance-table-panel.js)\r\n// es la unica fuente de verdad, sin estado nuevo. Los candidatos SIN una\r\n// posicion de slot valida se mandan a OUT -- asi cambiar la seleccion y\r\n// volver a Tomar al Aire siempre deja el estado real alineado con lo que\r\n// el operador configuro, sin importar que habia antes.\r\nconst ARGENTINA_PERFORMANCE_IDS = ['goleadores', 'asistidores', 'jugadores'];\r\nconst ARGENTINA_SLOT_POSITIONS = new Set(['placaL-top', 'placaL-bottom', 'placaL-solo']);\r\n\r\nfunction usesArgentinaPerformanceSelection(id) {\r\n  return activeThemeId === ARGENTINA_STREAMERS_THEME_ID\r\n    && ARGENTINA_PERFORMANCE_IDS.includes(id)\r\n    && ARGENTINA_SLOT_POSITIONS.has(draft[id]?.posicion);\r\n}\r\n\r\nfunction sendArgentinaPerformanceSelection(type) {\r\n  for (const id of ARGENTINA_PERFORMANCE_IDS) {\r\n    if (ARGENTINA_SLOT_POSITIONS.has(draft[id]?.posicion)) {\r\n      ws.send({ type, moduleId: id, data: draft[id] });\r\n    } else {\r\n      ws.send({ type: WS_MSG.OUT, moduleId: id });\r\n    }\r\n  }\r\n}\r\n\r\n// --- PLACAS DERECHA (grupo exclusivo) ---\r\n// (2026-09-04, pedido explicito del usuario: \"solo UNA de estas placas\r\n// puede estar al aire a la vez... TOMAR AL AIRE de una tiene que sacar\r\n// automaticamente a la anterior, sin que yo tenga que apretar SACAR DEL\r\n// AIRE a mano\"). IDs reales, no nombres/strings sueltos -- esta es la\r\n// definicion central unica que se usa para decidir la exclusion. No\r\n// incluye ningun modulo que no ocupe fisicamente esa misma zona (Marcador,\r\n// VAR, Zocalos, Formacion, etc. quedan afuera a proposito).\r\n//\r\n// POR THEME (2026-09-24, pedido explicito del usuario: \"quiero esta MISMA\r\n// logica para el grupo derecho tipo L de GLA -- Grupos/Resultados/\r\n// Goleadores/Asistidores/Jugadores\"). Hasta ahora esta exclusion SOLO\r\n// corria para Argentina Streamers (\"isRightPanelExclusive\" comparaba\r\n// \"activeThemeId === ARGENTINA_STREAMERS_THEME_ID\" a mano) -- ni un solo\r\n// modulo de GLA quedaba cubierto, aunque comparta exactamente la misma\r\n// zona fisica (goleadores/asistidores/jugadores ya estaban en la lista\r\n// vieja, pero la funcion los ignoraba por completo mientras el theme\r\n// activo fuera GLA). Un objeto por theme reemplaza esa comparacion\r\n// hardcodeada: cada theme declara SU propio grupo, sin pisarse entre si.\r\n// \"grupos\"/\"sideTable\" (Grupos/Resultados) son EXCLUSIVOS de GLA -- ni\r\n// siquiera son seleccionables desde la navegacion de Argentina Streamers\r\n// (ver ARGENTINA_STREAMERS_HIDDEN_MODULES mas abajo en este archivo), asi\r\n// que no tiene sentido que aparezcan en su lista. El grupo de Argentina\r\n// Streamers queda EXACTAMENTE igual que antes -- ninguno de sus 7 modulos\r\n// se toco.\r\nconst RIGHT_PANEL_EXCLUSIVE_MODULES_BY_THEME = {\r\n  [ARGENTINA_STREAMERS_THEME_ID]: [\r\n    'goleadores', 'asistidores', 'jugadores',\r\n    'historial', 'cronogramaHoy', 'resultadosParciales', 'sitioWebPromoL',\r\n  ],\r\n  [DEFAULT_THEME_ID]: [\r\n    'grupos', 'sideTable', 'goleadores', 'asistidores', 'jugadores',\r\n  ],\r\n};\r\n// Mismo criterio ya usado (FORMATION_OUT_WAIT_MS/MARCADOR_ENTRETIEMPO_WAIT_MS,\r\n// mas arriba en este archivo): tiempo real medido para que termine la\r\n// salida completa de un modulo \"sequencedReveal\" (fundido de contenido +\r\n// fundido de asset, ver program/js/main.js) antes de traer el siguiente --\r\n// reutiliza la MISMA animacion de entrada/salida que cada modulo ya tiene\r\n// (pedido explicito: \"no quiero una placa desaparece seca -> aparece otra\r\n// seca\", \"reutilizar la logica/transicion existente\"), sin CSS/timer nuevo.\r\n// Valido para los dos grupos: \"grupos\"/\"sideTable\" (nuevos, GLA) tambien\r\n// son \"sequencedReveal:true\" (mismo perfil de salida que\r\n// historial/cronogramaHoy/resultadosParciales/sitioWebPromoL, que ya\r\n// usaban este mismo numero), y \"goleadores\"/\"asistidores\"/\"jugadores\" (sin\r\n// \"sequencedReveal\", salida mas corta) ya venian cubiertos de sobra por\r\n// este mismo valor -- no hace falta un numero distinto por theme.\r\nconst RIGHT_PANEL_EXIT_WAIT_MS = 750;\r\nlet rightPanelSwapTimer = null;\r\n\r\nfunction currentRightPanelGroup() {\r\n  return RIGHT_PANEL_EXCLUSIVE_MODULES_BY_THEME[activeThemeId] || [];\r\n}\r\n\r\nfunction isRightPanelExclusive(id) {\r\n  return currentRightPanelGroup().includes(id);\r\n}\r\n\r\n// Modulo del grupo que esta ON ahora mismo, distinto del que se esta por\r\n// tomar (puede haber como mucho uno: este mismo mecanismo garantiza esa\r\n// invariante en cada TAKE). \"serverState\" es la unica fuente de verdad del\r\n// status real (lo que ya usa \"updatePanelStatus\" un poco mas arriba) -- no\r\n// se inventa un estado paralelo.\r\n//\r\n// \"equivalentIds\" (2026-09-24, bug real encontrado probando el grupo nuevo\r\n// de GLA): \"goleadores\"/\"asistidores\" en GLA son SIEMPRE el mismo par\r\n// combinado en una unica placa (ver \"usesPerformancePairPlacaL\" mas arriba\r\n// -- Tomar cualquiera de los dos ya manda TAKE a los dos). Sin este\r\n// chequeo, tomar \"asistidores\" mientras \"goleadores\" (su propio par) ya\r\n// esta al aire se detectaba a si mismo como \"otro modulo bloqueando\" y le\r\n// mandaba OUT innecesariamente -- microsegundos despues el propio\r\n// \"sendPerformancePair\" lo volvia a prender, pero de pura casualidad de\r\n// timing (dos TAKE/OUT del mismo par cruzandose) podia dejar la mitad del\r\n// par apagada. Cuando \"id\" es del par, su propio companero NUNCA cuenta\r\n// como bloqueador -- son la misma placa, no dos superpuestas.\r\nfunction otherRightPanelModuleOn(id) {\r\n  const equivalentIds = usesPerformancePairPlacaL(id) ? PERFORMANCE_PAIR_IDS : [id];\r\n  return currentRightPanelGroup().find(\r\n    (other) => !equivalentIds.includes(other) && serverState[other]?.status === MODULE_STATUS.ON\r\n  );\r\n}\r\n\r\n// Saca del aire el modulo bloqueador detectado arriba. Si ese bloqueador\r\n// es parte del par Goleadores/Asistidores (2026-09-24, mismo caso que el\r\n// comentario de arriba), hay que sacar LOS DOS -- son una unica placa\r\n// fisica, sacar solo la mitad dejaria la otra mitad huerfana al aire\r\n// mientras entra el modulo nuevo. Mismo criterio que ya usa el boton\r\n// SACAR DEL AIRE manual para este mismo par, mas abajo en este archivo.\r\nfunction outRightPanelModule(blockerId) {\r\n  if (usesPerformancePairPlacaL(blockerId)) {\r\n    for (const pairId of PERFORMANCE_PAIR_IDS) ws.send({ type: WS_MSG.OUT, moduleId: pairId });\r\n  } else {\r\n    ws.send({ type: WS_MSG.OUT, moduleId: blockerId });\r\n  }\r\n}\r\n\r\ntakeBtn.addEventListener('click', () => {\r\n  const mod = MODULES[activeId];\r\n  // \"autoRunClock\": al tomar al aire, ese campo de reloj arranca solo desde\r\n  // 00:00 (ej. Tiempo adicional) \u2014 no hace falta un panel de Play/Pause aparte.\r\n  if (mod.autoRunClock) {\r\n    draft[activeId][mod.autoRunClock] = { running: true, accumulatedMs: 0, startedAt: Date.now() };\r\n  }\r\n\r\n  function doTake() {\r\n    if (usesPerformancePairPlacaL(activeId)) {\r\n      sendPerformancePair(WS_MSG.TAKE);\r\n      return;\r\n    }\r\n    if (usesArgentinaPerformanceSelection(activeId)) {\r\n      sendArgentinaPerformanceSelection(WS_MSG.TAKE);\r\n      return;\r\n    }\r\n    ws.send({ type: WS_MSG.TAKE, moduleId: activeId, data: draft[activeId] });\r\n  }\r\n\r\n  // PLACAS DERECHA \u2014 grupo exclusivo (2026-09-04, ver definicion arriba):\r\n  // si otro modulo del grupo ya esta al aire, lo sacamos primero y\r\n  // esperamos a que termine de salir (misma animacion de siempre) antes\r\n  // de tomar este -- asi nunca quedan dos \"ON\" en simultaneo, y el TAKE\r\n  // en si nunca se pisa con la salida (evita el video/DOM duplicado que\r\n  // pediste evitar). Un unico timer pendiente por vez: un TAKE nuevo antes\r\n  // de que venza el anterior lo reemplaza en vez de acumularlo.\r\n  if (rightPanelSwapTimer) {\r\n    clearTimeout(rightPanelSwapTimer);\r\n    rightPanelSwapTimer = null;\r\n  }\r\n  const blocker = isRightPanelExclusive(activeId) ? otherRightPanelModuleOn(activeId) : null;\r\n  if (blocker) {\r\n    outRightPanelModule(blocker);\r\n    rightPanelSwapTimer = setTimeout(() => {\r\n      rightPanelSwapTimer = null;\r\n      doTake();\r\n    }, RIGHT_PANEL_EXIT_WAIT_MS);\r\n    return;\r\n  }\r\n  doTake();\r\n});\r\nupdateBtn.addEventListener('click', () => {\r\n  if (usesPerformancePairPlacaL(activeId)) {\r\n    sendPerformancePair(WS_MSG.UPDATE);\r\n    return;\r\n  }\r\n  if (usesArgentinaPerformanceSelection(activeId)) {\r\n    sendArgentinaPerformanceSelection(WS_MSG.UPDATE);\r\n    return;\r\n  }\r\n  ws.send({ type: WS_MSG.UPDATE, moduleId: activeId, data: draft[activeId], isExplicitUpdate: true });\r\n  sendPreviewUpdateIfActive(activeId);\r\n});\r\n// PREVIEW (2026-09-27, pedido explicito del usuario: \"ver la grafica ANTES\r\n// de mandarla al aire... sin disparar onAir, sin tocar el Program real\").\r\n// Manda el DRAFT actual (nunca lo persiste ni lo confirma, es exactamente\r\n// el mismo objeto que ya se manda con TAKE/UPDATE) mas el draft COMPLETO\r\n// como \"allData\" -- los renderers que dependen de otro modulo (ej. Tarjeta\r\n// lee \"allData.scoreboard\" para el escudo) resuelven igual que en\r\n// Program real. El servidor de esto SOLO hace de relay (ver\r\n// server/index.js, \"PREVIEW_MODULE\") -- nunca toca \"status\"/\"data\"\r\n// autoritativo de ningun modulo, as\u00ED que el Program real (OBS/vMix) nunca\r\n// se entera de que esto paso.\r\npreviewBtn.addEventListener('click', () => {\r\n  previewedModuleId = activeId;\r\n  sendPreviewSnapshot(activeId);\r\n});\r\noutBtn.addEventListener('click', () => {\r\n  // Si el operador saca Formacion a mano mientras hay un cambio de equipo\r\n  // en curso (OUT ya disparado, esperando para el TAKE automatico), hay\r\n  // que cancelar ese TAKE pendiente -- si no, el modulo volveria solo al\r\n  // aire un momento despues sin que el operador lo haya pedido.\r\n  if (activeId === 'formacionEquipos' && formationTransitioning) {\r\n    cancelFormationTransition();\r\n    renderPanel();\r\n  }\r\n  const activePairIsOn = activeThemeId !== ARGENTINA_STREAMERS_THEME_ID\r\n    && isPerformancePairModule(activeId)\r\n    && serverState[activeId]?.status === MODULE_STATUS.ON\r\n    && serverState[activeId]?.data?.posicion === 'placaL';\r\n  if (usesPerformancePairPlacaL(activeId) || activePairIsOn) {\r\n    for (const id of PERFORMANCE_PAIR_IDS) ws.send({ type: WS_MSG.OUT, moduleId: id });\r\n    return;\r\n  }\r\n  if (activeThemeId === ARGENTINA_STREAMERS_THEME_ID && ARGENTINA_PERFORMANCE_IDS.includes(activeId)) {\r\n    for (const id of ARGENTINA_PERFORMANCE_IDS) ws.send({ type: WS_MSG.OUT, moduleId: id });\r\n    return;\r\n  }\r\n  ws.send({ type: WS_MSG.OUT, moduleId: activeId });\r\n});\r\n\r\n// STOP ALL: saca del aire cualquier grafica activa, sin tocar los datos\r\n// cargados en cada draft (solo cambia el estado ON -> OUT).\r\nstopAllBtn.addEventListener('click', () => {\r\n  if (formationTransitioning) {\r\n    // Mismo motivo que en outBtn: durante la ventana de espera el estado\r\n    // del servidor para Formacion ya es OUT (no entraria en el loop de\r\n    // abajo), pero el TAKE automatico sigue programado y hay que frenarlo.\r\n    cancelFormationTransition();\r\n    if (activeId === 'formacionEquipos') renderPanel();\r\n  }\r\n  for (const id of MODULE_IDS) {\r\n    if (serverState[id].status === MODULE_STATUS.ON) {\r\n      ws.send({ type: WS_MSG.OUT, moduleId: id });\r\n    }\r\n  }\r\n});\r\n\r\nbuildTabs();\r\nrenderPanel();\r\nsetupPreviewMonitor();\r\n\r\n// Monitor de preview (columna derecha): un iframe que carga el Program\r\n// real (misma URL que se usa como Browser Source/Input en OBS/vMix) a su\r\n// resolucion nativa 1920x1080 y se escala en CSS para entrar en el\r\n// recuadro 16:9 \u2014 asi se ve exactamente la composicion completa, nunca\r\n// recortada, sin depender de que el Program sea \"responsive\" (no lo es,\r\n// esta pensado para 1920x1080 fijo). pointer-events:none (ver\r\n// overlay.css) bloquea toda interaccion accidental; scrolling=\"no\" mas\r\n// el overflow:hidden del contenedor evitan cualquier scrollbar. Es una\r\n// pesta\u00F1a de Program mas entre las que el servidor ya sabe atender\r\n// (misma arquitectura de broadcast a multiples clientes), no afecta ni\r\n// duplica el Program real que esta al aire en OBS.\r\nfunction setupPreviewMonitor() {\r\n  const frame = document.querySelector('.preview-frame');\r\n  const scaleWrap = document.querySelector('.preview-scale-wrap');\r\n  const iframe = document.getElementById('preview-iframe');\r\n  const urlEl = document.getElementById('preview-url');\r\n  const copyBtn = document.getElementById('btn-copy-url');\r\n\r\n  const programUrl = `${location.origin}/program`;\r\n  // \"PREVIEW | PROGRAM\" (2026-09-27, pedido explicito del usuario: poder\r\n  // alternar el monitor entre ver el PROGRAM real o un PREVIEW\r\n  // independiente, sin que eso cambie el link/output real que entra a\r\n  // vMix/OBS). \"urlEl\"/\"copyBtn\" SIEMPRE muestran/copian la URL de\r\n  // PROGRAM, sin importar que este mirando el operador en este momento --\r\n  // ese es el unico contrato que vMix/OBS conocen. Solo \"iframe.src\"\r\n  // cambia con el toggle. Default: PROGRAM (mismo comportamiento de\r\n  // siempre para quien nunca toque el toggle nuevo).\r\n  const previewUrl = `${location.origin}/program/preview.html`;\r\n  urlEl.textContent = programUrl;\r\n  iframe.src = programUrl;\r\n\r\n  const btnPreview = document.getElementById('btn-monitor-preview');\r\n  const btnProgram = document.getElementById('btn-monitor-program');\r\n  function setMonitorMode(mode) {\r\n    iframe.src = mode === 'preview' ? previewUrl : programUrl;\r\n    btnPreview.classList.toggle('active', mode === 'preview');\r\n    btnProgram.classList.toggle('active', mode !== 'preview');\r\n  }\r\n  btnPreview.addEventListener('click', () => setMonitorMode('preview'));\r\n  btnProgram.addEventListener('click', () => setMonitorMode('program'));\r\n\r\n  function rescale() {\r\n    const scale = frame.getBoundingClientRect().width / 1920;\r\n    scaleWrap.style.transform = `scale(${scale})`;\r\n  }\r\n  rescale();\r\n  window.addEventListener('resize', rescale);\r\n\r\n  copyBtn.addEventListener('click', async () => {\r\n    try {\r\n      await navigator.clipboard.writeText(programUrl);\r\n      copyBtn.textContent = 'Copiado';\r\n      copyBtn.classList.add('copied');\r\n      setTimeout(() => {\r\n        copyBtn.textContent = 'Copiar';\r\n        copyBtn.classList.remove('copied');\r\n      }, 1500);\r\n    } catch {\r\n      // Clipboard API puede fallar sin HTTPS/permiso; el texto ya es\r\n      // seleccionable a mano (user-select:all en .preview-url).\r\n    }\r\n  });\r\n}\r\n","http://localhost:4430/shared/modules.js","// Registro central de modulos de graficas.\r\n// Agregar una grafica nueva = agregar una entrada aca (Master Control genera el\r\n// panel solo a partir de \"fields\"; Program necesita ademas un renderer en\r\n// program/js/renderers/<id>.js y su posicionamiento en program/css/overlay.css).\r\n//\r\n// Flags especiales que puede tener un modulo:\r\n// - live: true       -> Program vuelve a renderizar cada 500ms mientras esta ON\r\n//                        (para que un reloj se vea andar sin mensajes WS extra).\r\n// - oneShot: true     -> el asset tiene su propia animacion de entrada Y salida\r\n//                        adentro del archivo (ej. un festejo de gol, una\r\n//                        transicion). Program avisa solo cuando el video\r\n//                        termina y vuelve a OUT sin que el operador tenga que\r\n//                        apretar Sacar.\r\n// - autoRunClock: 'clock' -> al hacer Tomar al aire, Master Control arranca\r\n//                        automaticamente ese campo de reloj desde 00:00\r\n//                        (para piezas que son \"un cronometro que se prende\").\r\n// - sequencedReveal: true -> Program (program/js/main.js) secuencia la entrada\r\n//                        en dos tiempos: el asset entra solo, el contenido\r\n//                        dinamico (\".gfx-overlay\": escudos, texto, numeros)\r\n//                        se revela recien despues de que la animacion horneada\r\n//                        del asset termina de asentarse. Al Sacar del aire se\r\n//                        invierte: el contenido desaparece primero y recien\r\n//                        despues sale el asset. No requiere nada del lado del\r\n//                        renderer del modulo (ver program/css/overlay.css y\r\n//                        program/js/main.js) \u2014 es logica 100% compartida.\r\n\r\nimport { FIELD_TYPES, PENALTY_KICK_STATUS } from './constants.js';\r\nimport { TEAM_COLORS } from './team-colors.js';\r\nimport { TEAM_OPTIONS } from './teams.js';\r\nimport { SPONSOR_OPTIONS } from './sponsors.js';\r\nimport { emptyClock } from './clock.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from './themes.js';\r\nimport { deepMergeAdjustFields } from './adjust-path.js';\r\n\r\nfunction penaltyKicksDefault(count) {\r\n  return Array.from({ length: count }, () => ({ status: PENALTY_KICK_STATUS.PENDING }));\r\n}\r\n\r\n// \"textAdjust\" (2026-08-14, pedido explicito del usuario: herramienta de\r\n// edicion manual de posicion X/Y y tama\u00F1o por CADA campo de texto de los\r\n// zocalos, sin tocar codigo). Cada clave de este objeto es el mismo \"key\"\r\n// del campo (o una ruta \"grupo.campo\" para datos anidados, ver\r\n// \"shortDouble\" mas abajo) y guarda { dx, dy, dSize } en pixeles logicos\r\n// -- se persiste junto con el resto de \"data\" del modulo (mismo mecanismo\r\n// que ya existia, server/state.js no necesito ningun cambio) y Program lo\r\n// aplica como una capa ADICIONAL sobre la posicion/tama\u00F1o de dise\u00F1o (ver\r\n// applyFittedText en program/js/text-fit.js), nunca reemplazandola --\r\n// resetear un campo es simplemente volver su entrada a {dx:0,dy:0,dSize:0}.\r\nfunction textAdjustDefaults(...keys) {\r\n  return Object.fromEntries(keys.map((key) => [key, { dx: 0, dy: 0, dSize: 0 }]));\r\n}\r\n\r\nconst TEAM_COLOR_OPTIONS = TEAM_COLORS.map((c) => ({ id: c.id, label: c.label }));\r\n\r\nexport const MATCH_STATUS_OPTIONS = [\r\n  { id: '', label: 'Sin estado' },\r\n  { id: 'proximo', label: 'A CONTINUACION' },\r\n  { id: 'final', label: 'FINAL' },\r\n  { id: 'entretiempo', label: 'ENTRETIEMPO' },\r\n];\r\n\r\nexport const MODULES = {\r\n  // ---------------------------------------------------------------------\r\n  // MARCADOR\r\n  // ---------------------------------------------------------------------\r\n  // \"teamA\"/\"teamB\" guardan el ID del equipo (catalogo global, ver\r\n  // shared/teams.js) \u2014 no texto libre ni un escudo por separado. Escudo y\r\n  // abreviatura de 3 letras se resuelven SIEMPRE a partir de ese ID (ver\r\n  // program/js/renderers/scoreboard.js), nunca se vuelven a cargar a mano;\r\n  // todos los demas modulos que necesitan datos de equipo (Entretiempo,\r\n  // Penales, Tarjetas, Cambios, VS Compacto) leen este mismo ID en vivo\r\n  // desde \"scoreboard\" en vez de tener su propio campo de equipo.\r\n  scoreboard: {\r\n    id: 'scoreboard',\r\n    label: 'Marcador principal',\r\n    category: 'Marcador',\r\n    layer: 'top-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'teamA', label: 'Equipo local', type: FIELD_TYPES.SELECT, options: TEAM_OPTIONS },\r\n      { key: 'teamAColor', label: 'Color de camiseta - local', type: FIELD_TYPES.SELECT, options: TEAM_COLOR_OPTIONS },\r\n      { key: 'teamB', label: 'Equipo visitante', type: FIELD_TYPES.SELECT, options: TEAM_OPTIONS },\r\n      { key: 'teamBColor', label: 'Color de camiseta - visitante', type: FIELD_TYPES.SELECT, options: TEAM_COLOR_OPTIONS },\r\n      // \"scoreA\"/\"scoreB\" (BLOQUE 2, 2026-09-09, pedido explicito del\r\n      // usuario: \"eliminar los textbox/input num\u00E9ricos manuales actuales\r\n      // para goles\"): pasan de TEXT editable a ADJUST_ONLY -- mismo\r\n      // criterio que \"period\"/\"clock\"/\"nameA\"/\"nameB\" mas abajo, el VALOR\r\n      // ya no se tipea aca (ahora exclusivamente via los botones +/-/RESET\r\n      // del panel dedicado, ver scoreboard-clock-panel.js), pero la\r\n      // posicion/tama\u00F1o se sigue ajustando igual (arrows inline para GLA,\r\n      // acordeon AJUSTE DE COMPOSICI\u00D3N para Argentina Streamers -- ningun\r\n      // cambio en ADJUST_REGISTRY, sigue apuntando a \"scoreA\"/\"scoreB\").\r\n      { key: 'scoreA', label: 'Goles local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Goles visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'sponsor', label: 'Sponsor Marcador', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.scoreboard },\r\n      // \"nameA\"/\"nameB\"/\"clock\" (2026-08-15, auditoria completa): no se\r\n      // tipean aca (la abreviatura sale del equipo elegido arriba, el reloj\r\n      // corre solo) pero igual son texto visible en Program -> ADJUST_ONLY,\r\n      // mismo mecanismo que un campo TEXT adjustable, sin input de texto.\r\n      { key: 'nameA', label: 'Abreviatura equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Abreviatura equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'clock', label: 'Reloj (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      // \"period\" (2026-08-15, pedido explicito del usuario: botones 1T/2T/\r\n      // ET/PERSONALIZADO en vez de un input de texto suelto) -- el TEXTO\r\n      // libre se tipea ahora desde el panel a medida\r\n      // (master-control/js/scoreboard-clock-panel.js), pero el AJUSTE de\r\n      // posicion/tama\u00F1o sigue siendo generico -> ADJUST_ONLY, mismo criterio\r\n      // que \"clock\" arriba.\r\n      { key: 'period', label: 'Per\u00EDodo / tiempo (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    // El reloj (clock, arranque/pausa) y el periodo (botones 1T/2T/ET/\r\n    // personalizado) se controlan con un panel a medida en Master Control\r\n    // (ver master-control/js/scoreboard-clock-panel.js), no con \"fields\" --\r\n    // el AJUSTE de posicion/tama\u00F1o de sus textos si se resuelve con los\r\n    // campos ADJUST_ONLY de arriba, generico.\r\n    defaults: {\r\n      teamA: '', teamB: '', teamAColor: 'gris', teamBColor: 'gris', scoreA: '0', scoreB: '0', period: '',\r\n      clock: emptyClock(),\r\n      // \"clockEndText\" (2026-08-15, pedido explicito del usuario: \"FIN DEL\r\n      // CONTADOR\" configurable, default 15:00) -- ver shared/clock.js\r\n      // (parseClockLimit) y program/js/renderers/scoreboard.js.\r\n      clockEndText: '15:00',\r\n      sponsor: '',\r\n      // \"teamColorAssignments\" (2026-08-16, pedido explicito del usuario:\r\n      // \"ASIGNAR COLOR AL EQUIPO\"): mapa persistente { teamId: colorId }.\r\n      // Al elegir un equipo en \"teamA\"/\"teamB\", si existe una entrada aca\r\n      // se autocompleta \"teamAColor\"/\"teamBColor\" con ese color (ver\r\n      // master-control/js/main.js); el boton de asignar lo escribe/pisa\r\n      // (master-control/js/scoreboard-clock-panel.js). Cambiar el color\r\n      // sin apretar el boton es solo temporal, no toca este mapa.\r\n      teamColorAssignments: {},\r\n      textAdjust: textAdjustDefaults('scoreA', 'scoreB', 'period', 'nameA', 'nameB', 'clock'),\r\n      // \"localCrestOffset*/awayCrestOffset*/separatorOffset*\" (2026-08-31,\r\n      // pedido explicito del usuario: cada elemento del marcador debe\r\n      // poder moverse/escalarse por separado -- ver\r\n      // master-control/js/composition-control.js). Mismo criterio que\r\n      // \"compositionOffsetX/Y/Scale\" (COMPOSITION_DEFAULTS mas abajo):\r\n      // sufijo \"OffsetX\"/\"OffsetY\"/\"Scale\" para que program/js/main.js\r\n      // (\"isVisualKey\") los trate como ajuste visual en vivo sin cambios\r\n      // ahi. Default 0/0/1 = no-op -- GLA nunca los toca desde su panel\r\n      // (el acordeon nuevo es exclusivo de Argentina Streamers, ver\r\n      // master-control/js/main.js) pero quedan disponibles para cualquier\r\n      // theme sin romper nada.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      separatorOffsetX: 0, separatorOffsetY: 0, separatorScale: 1,\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31, auditoria completa de\r\n      // edicion individual): el logo de sponsor del Marcador nunca tuvo\r\n      // ajuste propio.\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n    },\r\n  },\r\n\r\n  marcadorTiempoAdicional: {\r\n    id: 'marcadorTiempoAdicional',\r\n    label: 'Tiempo adicional',\r\n    category: 'Marcador',\r\n    layer: 'top-left',\r\n    live: true,\r\n    autoRunClock: 'clock',\r\n    fields: [\r\n      { key: 'addedMinutes', label: 'Minutos agregados (ej. 5)', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      // \"autoTake\" (2026-09-27, pedido explicito del usuario): si el TAKE\r\n      // automatico al llegar a FIN DEL CONTADOR del Marcador principal\r\n      // esta habilitado. String 'si'/'no' (mismo criterio que cualquier\r\n      // otro campo SELECT del proyecto) -- persistido junto al resto de\r\n      // \"data\" de este modulo, sin mecanismo nuevo. Default 'si': mismo\r\n      // comportamiento de siempre para quien no lo toque.\r\n      { key: 'autoTake', label: 'AUTOM\u00C1TICO', type: FIELD_TYPES.SELECT, options: [{ id: 'si', label: 'S\u00CD' }, { id: 'no', label: 'NO' }] },\r\n      { key: 'clock', label: 'Reloj (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      addedMinutes: '5', clock: emptyClock(), autoTake: 'si',\r\n      textAdjust: textAdjustDefaults('addedMinutes', 'clock'),\r\n    },\r\n  },\r\n\r\n  marcadorEntretiempo: {\r\n    id: 'marcadorEntretiempo',\r\n    label: 'Marcador - Entretiempo',\r\n    category: 'Marcador',\r\n    layer: 'top-left',\r\n    // Sin fields propios: reutiliza en vivo los datos ya cargados en\r\n    // \"scoreboard\" (escudos, colores, codigo de equipo, goles) \u2014 el\r\n    // operador los edita una sola vez, desde el marcador principal. El\r\n    // renderer de Program lee ese estado directamente (ver\r\n    // program/js/renderers/marcadorEntretiempo.js). \"live\" hace que se\r\n    // vuelva a pintar cada 500ms mientras esta al aire, para reflejar\r\n    // cambios que el operador haga en el marcador principal sin tener\r\n    // que tocar este modulo.\r\n    live: true,\r\n    sequencedReveal: true,\r\n    // \"nameA\"/\"nameB\"/\"scoreA\"/\"scoreB\" (2026-08-15, auditoria completa):\r\n    // los 4 textos visibles se derivan en vivo de \"scoreboard\" (arriba) sin\r\n    // campo propio -- ADJUST_ONLY les da el editor de posicion/tama\u00F1o\r\n    // igual que a cualquier otro texto, sin agregar un input que duplicaria\r\n    // la carga de datos.\r\n    fields: [\r\n      { key: 'nameA', label: 'Abreviatura equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Abreviatura equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreA', label: 'Gol local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Gol visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      // \"separador\" (2026-09-04, pedido explicito del usuario, exclusivo\r\n      // Argentina Streamers -- ver shared/adjust-registry.js \"themeOnly\"):\r\n      // editor propio para el \"-\" entre los goles.\r\n      textAdjust: textAdjustDefaults('nameA', 'nameB', 'scoreA', 'scoreB', 'separador'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio, solo src-swap.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n    },\r\n  },\r\n\r\n  marcadorPenales: {\r\n    id: 'marcadorPenales',\r\n    label: 'Marcador de penales (mejor de 3)',\r\n    category: 'Marcador',\r\n    layer: 'bottom-left-secondary',\r\n    // Sin campos de equipo/color propios: se leen en vivo de \"scoreboard\"\r\n    // (mismo patron que marcadorEntretiempo, ver program/js/renderers/\r\n    // marcadorPenales.js) \u2014 el operador solo carga el estado de cada\r\n    // penal, no vuelve a tipear el equipo.\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00EDtulo', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'kicksA', label: 'Tandas equipo A', type: FIELD_TYPES.PENALTY_SERIES, count: 3 },\r\n      { key: 'kicksB', label: 'Tandas equipo B', type: FIELD_TYPES.PENALTY_SERIES, count: 3 },\r\n      { key: 'nameA', label: 'Abreviatura equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Abreviatura equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      // \"scoreA\"/\"scoreB\" (2026-08-31, correcci\u00F3n expl\u00EDcita del usuario):\r\n      // dejaron de mostrar el resultado del PARTIDO (sb.scoreA/scoreB) \u2014\r\n      // ahora Program calcula el resultado de la TANDA DE PENALES en vivo\r\n      // a partir de \"kicksA\"/\"kicksB\" (cuenta de intentos en 'scored'), ver\r\n      // program/js/renderers/marcadorPenales.js. Este campo sigue siendo\r\n      // solo de posici\u00F3n/tama\u00F1o (el numero no se tipea, se calcula solo).\r\n      { key: 'scoreA', label: 'Resultado de penales local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Resultado de penales visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      // \"sponsor\" (2026-08-31, pedido explicito del usuario): mismo\r\n      // catalogo/categoria que Zocalo VS Compacto (\"vs_compact\"), sin\r\n      // inventar un catalogo nuevo.\r\n      { key: 'sponsor', label: 'Sponsor Penales', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.vs_compact },\r\n    ],\r\n    defaults: {\r\n      titulo: 'PENALES',\r\n      kicksA: penaltyKicksDefault(3), kicksB: penaltyKicksDefault(3),\r\n      sponsor: '',\r\n      // \"suddenDeath\" (2026-08-15, pedido explicito del usuario: indicar\r\n      // MUERTE SUBITA sin inventar un asset nuevo) -- toggle desde un panel\r\n      // a medida (ver master-control/js/penales-panel.js). Cuando esta en\r\n      // true, el renderer (program/js/renderers/marcadorPenales.js) le\r\n      // agrega \" \u2014 MUERTE S\u00DABITA\" al mismo titulo de siempre, reusando la\r\n      // zona/auto-ajuste de fuente que ya existe para ese texto -- no es un\r\n      // campo de texto propio, no se persiste por separado del titulo.\r\n      suddenDeath: false,\r\n      textAdjust: textAdjustDefaults('titulo', 'nameA', 'nameB', 'scoreA', 'scoreB', 'nombreLocal', 'nombreVisitante'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio, solo src-swap.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      // \"kicksLocalOffset*/kicksVisitanteOffset*\" (2026-08-31, pedido\r\n      // explicito del usuario): cada fila de circulos de penales se mueve\r\n      // como grupo, independiente del escudo y del resultado.\r\n      kicksLocalOffsetX: 0, kicksLocalOffsetY: 0, kicksLocalScale: 1,\r\n      kicksVisitanteOffsetX: 0, kicksVisitanteOffsetY: 0, kicksVisitanteScale: 1,\r\n      // \"kickLocal{1-5}Offset*\"/\"kickVisitante{1-5}Offset*\" (2026-09-01,\r\n      // pedido explicito del usuario: \"no quiero seguir pidiendote mover\r\n      // circulos a mano en codigo... quiero CONTROL TOTAL desde Master\r\n      // Control\"). Capa ADITIVA por-circulo, encima de la posicion base ya\r\n      // definida en program/css/overlay.css (que sigue existiendo como\r\n      // default -- \"los defaults pueden existir\") y de \"kicksLocalOffset*\"\r\n      // (que sigue moviendo la FILA completa como grupo) -- 0/0/1 es un\r\n      // no-op, cada circulo queda exactamente donde esta hoy hasta que el\r\n      // operador lo ajuste y confirme con GUARDAR POSICI\u00D3N. Solo tiene\r\n      // panel propio para Argentina Streamers (ver \"themeOnly\" en\r\n      // shared/adjust-registry.js) -- GLA nunca los toca ni los ve.\r\n      kickLocal1OffsetX: 0, kickLocal1OffsetY: 0, kickLocal1Scale: 1,\r\n      kickLocal2OffsetX: 0, kickLocal2OffsetY: 0, kickLocal2Scale: 1,\r\n      kickLocal3OffsetX: 0, kickLocal3OffsetY: 0, kickLocal3Scale: 1,\r\n      kickLocal4OffsetX: 0, kickLocal4OffsetY: 0, kickLocal4Scale: 1,\r\n      kickLocal5OffsetX: 0, kickLocal5OffsetY: 0, kickLocal5Scale: 1,\r\n      kickVisitante1OffsetX: 0, kickVisitante1OffsetY: 0, kickVisitante1Scale: 1,\r\n      kickVisitante2OffsetX: 0, kickVisitante2OffsetY: 0, kickVisitante2Scale: 1,\r\n      kickVisitante3OffsetX: 0, kickVisitante3OffsetY: 0, kickVisitante3Scale: 1,\r\n      kickVisitante4OffsetX: 0, kickVisitante4OffsetY: 0, kickVisitante4Scale: 1,\r\n      kickVisitante5OffsetX: 0, kickVisitante5OffsetY: 0, kickVisitante5Scale: 1,\r\n      // \"separatorOffset*\" (2026-08-31): gui\u00F3n entre el resultado local y\r\n      // visitante de la tanda de penales -- mismo criterio que el gui\u00F3n\r\n      // del Marcador principal (scoreboard.separatorOffsetX/Y/Scale).\r\n      separatorOffsetX: 0, separatorOffsetY: 0, separatorScale: 1,\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31): unico elemento visual del\r\n      // sponsor, nunca tuvo ajuste propio.\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      // \"nombreLocal/VisitanteMode/Manual\" (2026-09-01, pedido explicito\r\n      // del usuario): mismo mecanismo que VS Prepartido/VS Resultado, ver\r\n      // shared/broadcast-names.js. Solo se muestra/usa para Argentina\r\n      // Streamers -- inocuo para GLA (nunca se lee ahi).\r\n      nombreLocalMode: 'auto', nombreLocalManual: '',\r\n      nombreVisitanteMode: 'auto', nombreVisitanteManual: '',\r\n    },\r\n  },\r\n\r\n  // Reemplaza al ex \"Shootout\" (penales 1 c/u): mismo lugar en la familia\r\n  // Marcador, logica completamente nueva y mas simple \u2014 asset propio\r\n  // (imagen estatica, sin video), un solo campo de texto libre y el mismo\r\n  // reloj automatico que ya usa \"marcadorTiempoAdicional\" (autoRunClock):\r\n  // arranca solo al Tomar al aire, sin panel de Play/Pause propio. Se\r\n  // renderiza DETRAS del marcador principal a proposito (ver orden de\r\n  // nodos en program/index.html): el operador lo usa para asomar un\r\n  // titulo por debajo de la barra del marcador ya al aire.\r\n  marcadorZocalo: {\r\n    id: 'marcadorZocalo',\r\n    label: 'Marcador Z\u00F3calo',\r\n    category: 'Marcador',\r\n    layer: 'top-left-secondary',\r\n    live: true,\r\n    autoRunClock: 'clock',\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00CDTULO', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'clock', label: 'Reloj (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      titulo: '', clock: emptyClock(),\r\n      // \"clockEndText\" (2026-08-15, pedido explicito del usuario: \"FIN DEL\r\n      // CONTADOR\" configurable, default 06:00 para Marcador Zocalo) -- ver\r\n      // shared/clock.js (parseClockLimit) y\r\n      // master-control/js/live-clock-display.js.\r\n      clockEndText: '06:00',\r\n      textAdjust: textAdjustDefaults('titulo', 'clock'),\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // PLACAS FULLSCREEN Y MID-FULL\r\n  // ---------------------------------------------------------------------\r\n  formacionEquipos: {\r\n    id: 'formacionEquipos',\r\n    label: 'Formacion',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    // Sin \"teamSide\" generico aca: el selector LOCAL/VISITANTE vive en el\r\n    // panel dedicado (master-control/js/formation-list-panel.js), que\r\n    // ademas de mostrar el toggle tiene que disparar la secuencia\r\n    // OUT->cargar preset->TAKE cuando el modulo esta al aire (ver ese\r\n    // archivo y master-control/js/main.js) -- el editor generico de\r\n    // campos (field-editors.js) no tiene forma de engancharse a eso.\r\n    fields: [],\r\n    defaults: {\r\n      teamSide: 'local',\r\n      // \"starters\"/\"substitutes\" son SIEMPRE el contenido activo (lo que\r\n      // lee program/js/renderers/formacionEquipos.js) -- el panel los\r\n      // mantiene sincronizados con \"presets[teamSide]\" en cada edicion.\r\n      // \"presets\" guarda titulares+suplentes de cada equipo por separado\r\n      // (2026-08-05, pedido explicito del usuario: preparar ambas\r\n      // formaciones con anticipacion sin que se mezclen entre si).\r\n      starters: [], substitutes: [],\r\n      presets: {\r\n        local: { starters: [], substitutes: [] },\r\n        visitor: { starters: [], substitutes: [] },\r\n      },\r\n      // \"playerName\"/\"playerNumber\" (2026-08-15, auditoria completa): un\r\n      // unico ajuste compartido por las 6 posiciones de titulares (misma\r\n      // clase visual en el asset, ver program/js/renderers/\r\n      // formacionEquipos.js) -- \"subsTitle\" es el rotulo fijo \"SUPLENTES\",\r\n      // \"subsList\" es el bloque completo de la lista de suplentes.\r\n      textAdjust: textAdjustDefaults('playerName', 'playerNumber', 'subsTitle', 'subsList'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): el escudo\r\n      // del equipo activo nunca tuvo ajuste propio, solo src-swap.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  vsPrepartido: {\r\n    id: 'vsPrepartido',\r\n    label: 'VS Prepartido',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00CDTULO', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'nameA', label: 'Nombre equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Nombre equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      titulo: 'PR\u00D3XIMO PARTIDO',\r\n      titlePresets: [],\r\n      textAdjust: textAdjustDefaults('titulo', 'nameA', 'nameB'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      // \"nameXMode\"/\"nameXManual\" (2026-09-01, pedido explicito del\r\n      // usuario: \"los nombres actuales quedan mal visualmente\" -- ver\r\n      // shared/broadcast-names.js). \"auto\" (default) resuelve un nombre\r\n      // de BROADCAST propio para los 4 equipos de Argentina Streamers sin\r\n      // tocar el nombre real del equipo; cualquier otro teamId (todos los\r\n      // de GLA) cae exactamente en \"teamName()\" de siempre, cero cambio\r\n      // visual ahi. El control en Master Control solo se muestra para\r\n      // Argentina Streamers (ver renderPanel() en main.js) -- estos\r\n      // defaults son inocuos para GLA aunque el campo exista en su arbol\r\n      // de datos.\r\n      nameAMode: 'auto', nameAManual: '',\r\n      nameBMode: 'auto', nameBManual: '',\r\n    },\r\n  },\r\n\r\n  vsResultado: {\r\n    id: 'vsResultado',\r\n    label: 'VS Con resultado',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00CDTULO', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'nameA', label: 'Nombre equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Nombre equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreA', label: 'Gol local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Gol visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      titulo: 'RESULTADO',\r\n      titlePresets: [],\r\n      // \"scoreSep\" (guion dinamico entre goles): RETIRADO para GLA\r\n      // (2026-09-27, su asset ya trae el guion) y VUELTO solo para\r\n      // ARGENTINA STREAMERS (2026-10-08, pedido explicito: \"agregar un guion\r\n      // dinamico entre GOL LOCAL y GOL VISITANTE\" con ajuste propio). El\r\n      // nodo existe siempre en el renderer pero solo se muestra con\r\n      // body[data-theme='argentinaStreamers'] (ver overlay.css); el control\r\n      // de ajuste es \"themeOnly\" en shared/adjust-registry.js.\r\n      textAdjust: textAdjustDefaults('titulo', 'nameA', 'nameB', 'scoreA', 'scoreB', 'scoreSep'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      // \"nameXMode\"/\"nameXManual\" (2026-09-01): mismo mecanismo que\r\n      // vsPrepartido, ver el comentario ahi y shared/broadcast-names.js.\r\n      nameAMode: 'auto', nameAManual: '',\r\n      nameBMode: 'auto', nameBManual: '',\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // EVENTOS DEL PARTIDO\r\n  // ---------------------------------------------------------------------\r\n  // Un solo modulo/solapa para las 3 tarjetas (amarilla/roja/azul) \u2014 el campo\r\n  // \"tipo\" elige la variante visual (que asset .mp4 se reproduce, ver\r\n  // program/js/renderers/tarjeta.js), no hay 3 modulos ni 3 solapas\r\n  // separadas. Sin campo de equipo/escudo propio: se lee en vivo de\r\n  // \"scoreboard\" (`live: true`, mismo patron que marcadorPenales/\r\n  // marcadorEntretiempo) segun lo que el operador elija en \"equipo\".\r\n  tarjeta: {\r\n    id: 'tarjeta',\r\n    label: 'Tarjetas',\r\n    category: 'Eventos',\r\n    layer: 'bottom-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'equipo',\r\n        label: 'Equipo',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'local', label: 'Local' },\r\n          { id: 'visitante', label: 'Visitante' },\r\n        ],\r\n      },\r\n      {\r\n        key: 'tipo',\r\n        label: 'Tipo de tarjeta',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'amarilla', label: 'Amarilla' },\r\n          { id: 'roja', label: 'Roja' },\r\n          { id: 'azul', label: 'Azul' },\r\n        ],\r\n      },\r\n      { key: 'jugador', label: 'Nombre del jugador', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      equipo: 'local', tipo: 'amarilla', jugador: '', textAdjust: textAdjustDefaults('jugador'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, pedido explicito del usuario:\r\n      // extender la edicion individual a todo el software) -- el escudo\r\n      // de este modulo nunca tuvo ajuste propio, solo src-swap (ver\r\n      // program/js/renderers/tarjeta.js). Default 0/0/1 = no-op, ver\r\n      // shared/adjust-registry.js.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // El asset tiene un unico casillero de escudo (una sustitucion es\r\n  // siempre del mismo equipo para \"entra\"/\"sale\") \u2014 se lee en vivo de\r\n  // \"scoreboard\" (`live: true`, mismo patron que `tarjeta`) segun el\r\n  // campo \"equipo\" elegido por el operador.\r\n  cambios: {\r\n    id: 'cambios',\r\n    label: 'Cambios',\r\n    category: 'Eventos',\r\n    layer: 'bottom-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'equipo',\r\n        label: 'Equipo',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'local', label: 'Local' },\r\n          { id: 'visitante', label: 'Visitante' },\r\n        ],\r\n      },\r\n      { key: 'entra', label: 'Entra', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'sale', label: 'Sale', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    // \"titulo\" ELIMINADO (2026-09-01, pedido explicito del usuario: \"NO\r\n    // QUIERO T\u00CDTULO... eliminar completamente de la l\u00F3gica operativa y del\r\n    // panel\"). Sin campo, sin default, sin textAdjust -- el modulo queda\r\n    // enfocado en equipo/escudo/entra/sale, ver program/js/renderers/\r\n    // cambios.js (ya no tiene ningun rastro de titulo tampoco).\r\n    defaults: {\r\n      equipo: 'local', entra: '', sale: '',\r\n      textAdjust: textAdjustDefaults('entra', 'sale'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, pedido explicito del usuario):\r\n      // mismo criterio que \"tarjeta\" -- el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  gol: {\r\n    id: 'gol',\r\n    label: 'Gol',\r\n    category: 'Eventos',\r\n    layer: 'top-left-secondary',\r\n    oneShot: true,\r\n    fields: [],\r\n    // \"golRelativoMarcador\" (2026-10-21, solo GLA lo usa): marca que su\r\n    // composicion ya es el ajuste fino RELATIVO al Marcador (ver la\r\n    // migracion unica en server/state.js). Inocuo para Argentina Streamers.\r\n    defaults: { golRelativoMarcador: true },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // VAR / REPLAY\r\n  // ---------------------------------------------------------------------\r\n  varCheck: {\r\n    id: 'varCheck',\r\n    label: 'VAR Chequeo',\r\n    category: 'VAR / Replay',\r\n    layer: 'bottom-left-secondary',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'sponsor', label: 'Sponsor VAR', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.var },\r\n      // \"motivoPreset\" (2026-08-15, pedido explicito del usuario): selector\r\n      // con 3 textos predefinidos + PERSONALIZADO. Elegir un preset\r\n      // autocompleta \"motivo\" (logica en master-control/js/main.js, mismo\r\n      // patron que el auto-completado de LOCAL/VISITANTE en Tarjetas/\r\n      // Cambios) -- \"motivo\" sigue siendo el mismo campo TEXT de siempre,\r\n      // con su editor de posicion/tama\u00F1o intacto (adjustable:true), asset\r\n      // cortito, animaciones y logica TAKE/UPDATE/OUT sin cambios.\r\n      {\r\n        key: 'motivoPreset',\r\n        label: 'Motivo',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'posible_penal', label: 'POSIBLE PENAL' },\r\n          { id: 'gol_no_valido', label: 'GOL NO V\u00C1LIDO' },\r\n          { id: 'posible_roja', label: 'POSIBLE ROJA' },\r\n          { id: 'personalizado', label: 'PERSONALIZADO' },\r\n        ],\r\n      },\r\n      { key: 'motivo', label: 'Texto Motivo', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      sponsor: '', motivoPreset: 'posible_penal', motivo: 'POSIBLE PENAL',\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n      motivoOffsetX: 0, motivoOffsetY: 0, motivoScale: 1,\r\n      textAdjust: textAdjustDefaults('motivo'),\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31, pedido explicito del\r\n      // usuario): el logo de sponsor nunca tuvo ajuste propio (solo\r\n      // fade-swap, ver program/js/renderers/varCheck.js).\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      // \"varGroupOffsetX/Y/Scale\" (2026-08-31): antes de este campo,\r\n      // \".ov-var-group1\" (clip VAR + sponsor) leia manualmente las MISMAS\r\n      // keys que \"compositionOffsetX/Y/Scale\" (COMPOSICION COMPLETA, ver\r\n      // COMPOSITION_DEFAULTS mas abajo) -- como ese grupo es hijo de\r\n      // \".content\" y \"COMPOSICION COMPLETA\" YA mueve \".content\" entero,\r\n      // el offset se aplicaba DOS VECES (compuesto) sobre group1 mientras\r\n      // que \".ov-var-motivo-group\" solo lo heredaba una vez de \".content\"\r\n      // -- rompia el requisito de que \"Composicion completa\" mueva TODO\r\n      // el modulo como una unidad rigida. Se separa en un campo propio\r\n      // para que group1 tenga su ajuste fino independiente sin volver a\r\n      // leer las keys universales.\r\n      varGroupOffsetX: 0, varGroupOffsetY: 0, varGroupScale: 1,\r\n    },\r\n  },\r\n\r\n  replay: {\r\n    id: 'replay',\r\n    label: 'Replay (con sponsor)',\r\n    category: 'VAR / Replay',\r\n    layer: 'bottom-left-secondary',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'sponsor', label: 'Sponsor REPLAY', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.var },\r\n    ],\r\n    defaults: {\r\n      sponsor: '',\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31, pedido explicito del\r\n      // usuario): unico elemento visual de este modulo, nunca tuvo ajuste.\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // MOSCA\r\n  // ---------------------------------------------------------------------\r\n  // Sin campos: la franja que antes mostraba un texto editable a mano\r\n  // ahora muestra la hora actual del sistema, generada sola por el\r\n  // renderer (ver program/js/renderers/bug.js) \u2014 Master Control solo\r\n  // necesita Tomar/Sacar del aire, nada que tipear.\r\n  bug: {\r\n    id: 'bug',\r\n    label: 'Mosca LocalStrike',\r\n    category: 'Mosca',\r\n    layer: 'top-right',\r\n    sequencedReveal: true,\r\n    // \"clock\" (2026-08-15, auditoria completa): unico texto dinamico real\r\n    // de este modulo (hora del sistema, sin campo tipeable) -> ADJUST_ONLY.\r\n    // \".ov-mosca-vivo\" (\"VIVO\") NO se incluye a proposito: esta oculto por\r\n    // CSS (display:none, ver overlay.css) porque el \"VIVO\" real ya viene\r\n    // horneado en el video (ver program/js/renderers/bug.js) -- no es texto\r\n    // visible en Program, agregarle un editor no tendria ningun efecto.\r\n    fields: [\r\n      { key: 'clock', label: 'Hora (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: { textAdjust: textAdjustDefaults('clock') },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // ZOCALOS\r\n  // ---------------------------------------------------------------------\r\n  // DESACTIVADO TEMPORALMENTE a pedido explicito del usuario (2026-07-31):\r\n  // falta reemplazar el asset. Toda la logica (schema, renderer en\r\n  // program/js/renderers/longSimple.js, registro en\r\n  // program/js/renderers/index.js, nodo en program/index.html) se\r\n  // conserva intacta, solo comentada \u2014 al no estar en MODULES/MODULE_IDS\r\n  // el modulo desaparece solo del panel de Master Control (generado desde\r\n  // este schema) y del loop de program/js/main.js, sin tocar ningun otro\r\n  // archivo. Para reactivar cuando haya asset nuevo: descomentar este\r\n  // bloque, el import+entrada en program/js/renderers/index.js, y el\r\n  // <div id=\"mod-longSimple\"> en program/index.html (buscar \"DESACTIVADO\r\n  // TEMPORALMENTE\" en cada archivo).\r\n  // longSimple: {\r\n  //   id: 'longSimple',\r\n  //   label: 'Zocalo largo simple',\r\n  //   category: 'Zocalos',\r\n  //   layer: 'bottom-wide',\r\n  //   sequencedReveal: true,\r\n  //   fields: [\r\n  //     { key: 'text', label: 'Texto', type: FIELD_TYPES.TEXT },\r\n  //   ],\r\n  //   defaults: { text: '' },\r\n  // },\r\n\r\n  longDouble: {\r\n    id: 'longDouble',\r\n    label: 'Zocalo largo doble',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'line1', label: 'Titulo principal', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'line2', label: 'Subtitulo / bajada', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      line1: '', line2: '', textPresets: [],\r\n      textAdjust: textAdjustDefaults('line1', 'line2'),\r\n    },\r\n  },\r\n\r\n  shortSimple: {\r\n    id: 'shortSimple',\r\n    label: 'Zocalo corto simple',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'text', label: 'Texto', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      text: '', textPresets: [],\r\n      textAdjust: textAdjustDefaults('text'),\r\n    },\r\n  },\r\n\r\n  // \"airMode\" (2026-08-06, pedido explicito del usuario: poder mostrar uno\r\n  // o dos zocalos cortos dobles a la vez, ej. dos relatores juntos):\r\n  // 'single' reusa exactamente la logica/posicion de siempre (\"name\"/\r\n  // \"role\"); 'double' muestra dos instancias independientes del mismo\r\n  // renderer/asset lado a lado (\"double1\"/\"double2\"), ver\r\n  // program/js/renderers/shortDouble.js. Sin \"fields\" generico: el panel\r\n  // dedicado (master-control/js/short-double-panel.js) tiene que mostrar\r\n  // las tres secciones (individual + doble 1 + doble 2) y los controles de\r\n  // aire propios -- mismo criterio que Formacion (fields: []).\r\n  shortDouble: {\r\n    id: 'shortDouble',\r\n    label: 'Zocalo corto doble',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      // \"name\"/\"role\" a nivel raiz ELIMINADOS (2026-09-10, pedido explicito\r\n      // del usuario: \"que el z\u00F3calo doble 1 sea el z\u00F3calo individual...\r\n      // que en el panel no me muestre 3 opciones de z\u00F3calo\"). Antes existia\r\n      // un tercer slot de datos independiente (\"Z\u00D3CALO INDIVIDUAL\", sin\r\n      // relacion con \"double1\"/\"double2\") que el modo \"single\" del renderer\r\n      // leia aparte -- ahora el modo \"single\" reutiliza directamente\r\n      // \"double1\" (ver program/js/renderers/shortDouble.js), asi que mandar\r\n      // un solo zocalo o mandar dos es SIEMPRE la misma fuente de datos\r\n      // (double1, double1+double2), sin una tercera copia paralela.\r\n      airMode: 'single',\r\n      double1: { name: '', role: '' },\r\n      double2: { name: '', role: '' },\r\n      textPresets: [],\r\n      // Claves con ruta \"grupo.campo\" para los textos de los pares del\r\n      // modo doble -- distinguen el ajuste de \"double1.name\" del de\r\n      // \"double2.name\" aunque compartan las mismas clases CSS (ver\r\n      // program/js/renderers/shortDouble.js), porque son campos de datos\r\n      // independientes, no un unico elemento reutilizado. \"double1.role\"/\r\n      // \"double2.role\" quedan (el renderer los sigue leyendo -- el campo\r\n      // \"Sub texto\" solo se elimin\u00F3 del PANEL, ver short-double-panel.js)\r\n      // aunque ya no tengan textbox propio en Master Control.\r\n      textAdjust: textAdjustDefaults('double1.name', 'double1.role', 'double2.name', 'double2.role'),\r\n    },\r\n  },\r\n\r\n  // Sin campos de equipo propios: equipo A/B (nombre, abreviatura y\r\n  // escudo) se leen en vivo de \"scoreboard\" (`live: true`, mismo patron\r\n  // que \"vs\" mas arriba) \u2014 el VS\r\n  // siempre anuncia el mismo partido cargado en el marcador principal, no\r\n  // hace falta volver a elegir los equipos aca.\r\n  vs: {\r\n    id: 'vs',\r\n    label: 'Zocalo VS compacto',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-center',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'renglon',\r\n        label: 'Altura de renglon',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'normal', label: 'Normal' },\r\n          { id: 'alto', label: 'Alto' },\r\n          { id: 'medio', label: 'Medio' },\r\n          { id: 'fino', label: 'Fino' },\r\n        ],\r\n      },\r\n      {\r\n        // \"CONTENIDO CENTRAL\" (2026-09-10, pedido explicito del usuario:\r\n        // \"simplificar VS COMPACTO\" -- eliminados el selector \"Estado del\r\n        // encuentro\" y el selector \"Contenido central: Resultado/Estado vs\r\n        // Sponsor\", que en los hechos no controlaba nada real en el\r\n        // renderer, ver program/js/renderers/vs.js). Texto 100% manual: lo\r\n        // que el operador escribe es EXACTAMENTE lo que se renderiza en el\r\n        // renglon central, sin ningun preset de respaldo -- vacio renderiza\r\n        // vacio, nunca se fuerza un valor.\r\n        key: 'statusTexto',\r\n        label: 'Contenido central (texto libre \u2014 vac\u00EDo no muestra nada)',\r\n        type: FIELD_TYPES.TEXT,\r\n        adjustable: true,\r\n      },\r\n      {\r\n        key: 'sponsor',\r\n        label: 'Sponsor Zocalo Medio',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: SPONSOR_OPTIONS.vs_compact,\r\n      },\r\n      // \"nameA\"/\"nameB\"/\"goalA\"/\"goalB\" (2026-08-15, auditoria completa):\r\n      // nombre y gol de cada equipo se derivan en vivo de \"scoreboard\" (sin\r\n      // campo propio), pero necesitan su propio ajuste de posicion/tama\u00F1o.\r\n      { key: 'nameA', label: 'Nombre equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Nombre equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'goalA', label: 'Gol local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'goalB', label: 'Gol visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      renglon: 'normal', statusTexto: '', sponsor: '',\r\n      // \"MOSTRAR GOLES\" (2026-10-22, pedido explicito del usuario, SOLO GLA):\r\n      // 'con' = goles en vivo del Marcador (como siempre); 'sin' = oculta\r\n      // unicamente los dos goles. El control solo aparece en GLA (ver\r\n      // master-control/js/main.js) y el renderer solo lo lee en GLA.\r\n      mostrarGoles: 'con',\r\n      textAdjust: textAdjustDefaults('statusTexto', 'nameA', 'nameB', 'goalA', 'goalB'),\r\n      // \"localCrestOffset*/awayCrestOffset*/sponsorOffset*\" (2026-08-31,\r\n      // auditoria completa): ninguno de los 3 tenia ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n    },\r\n  },\r\n\r\n  // Z\u00D3CALO VS (2026-10-09, pedido explicito del usuario, SOLO Argentina\r\n  // Streamers -- GLA no lo ve en su navegacion): modulo independiente con 2\r\n  // variantes de asset (\"solo\" = escudo/nombre VS nombre/escudo; \"goles\" =\r\n  // ademas el gol de cada lado). Equipos, escudos y goles NO tienen estado\r\n  // propio: se leen en vivo de \"scoreboard\" (`live: true`, 5to argumento del\r\n  // renderer, mismo patron que \"vs\"/marcadorPenales). Solo guarda lo propio\r\n  // del modulo: variante, nombre AUTOM\u00C1TICO/MANUAL por lado (shared/\r\n  // broadcast-names.js) y ajustes de composicion. Los ajustes son POR\r\n  // VARIANTE (claves \"solo*\"/\"goles*\": las dos piezas tienen la pastilla\r\n  // central de distinto ancho, asi que nombres/goles no caen en el mismo\r\n  // lugar) y los escudos ademas POR EQUIPO (\"crestByTeam[soloLocal|\r\n  // soloAway|golesLocal|golesAway][teamId]\", ver \"crestSlot\" en\r\n  // shared/adjust-registry.js). El \"VS\" viene dibujado dentro del asset.\r\n  zocaloVs: {\r\n    id: 'zocaloVs',\r\n    label: 'Z\u00F3calo VS',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-center',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      variante: 'solo',\r\n      nombreLocalMode: 'auto', nombreLocalManual: '',\r\n      nombreVisitanteMode: 'auto', nombreVisitanteManual: '',\r\n      textAdjust: textAdjustDefaults(\r\n        'soloNombreLocal', 'soloNombreVisitante',\r\n        'golesNombreLocal', 'golesGolLocal', 'golesGolVisitante', 'golesNombreVisitante',\r\n      ),\r\n      soloLocalCrestOffsetX: 0, soloLocalCrestOffsetY: 0, soloLocalCrestScale: 1,\r\n      soloAwayCrestOffsetX: 0, soloAwayCrestOffsetY: 0, soloAwayCrestScale: 1,\r\n      golesLocalCrestOffsetX: 0, golesLocalCrestOffsetY: 0, golesLocalCrestScale: 1,\r\n      golesAwayCrestOffsetX: 0, golesAwayCrestOffsetY: 0, golesAwayCrestScale: 1,\r\n      crestByTeam: { soloLocal: {}, soloAway: {}, golesLocal: {}, golesAway: {} },\r\n    },\r\n  },\r\n\r\n  // Sin campo de equipo propio: escudo local/visitante se leen en vivo de\r\n  // \"scoreboard\" (`live: true`, mismo patron que \"vs\" mas arriba) \u2014 el\r\n  // separador ya horneado en el asset divide ambos escudos, no hace falta\r\n  // volver a elegir equipo aca. \"texto1\"/\"texto2\" son independientes, cada\r\n  // uno controla su propio zocalo central (mismo patron que \"line1\"/\r\n  // \"line2\" de longDouble). El sector derecho del asset queda sin usar a\r\n  // proposito (pedido explicito del usuario, preparado para el futuro).\r\n  zocaloFinalDiv: {\r\n    id: 'zocaloFinalDiv',\r\n    label: 'Zocalo Compuesto con Equipos',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'texto1', label: 'TEXTO 1', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'texto2', label: 'TEXTO 2', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      texto1: '', texto2: '', sponsorsRotation: [],\r\n      escudosFuente: 'MARCADOR', customTeamA: '', customTeamB: '',\r\n      shieldPresets: [], textPresets: [],\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2')\r\n    },\r\n  },\r\n\r\n  // Misma logica que \"zocaloFinalDiv\" de arriba, base tomada de ese modulo\r\n  // (mismo asset central/derecho, mismo comportamiento de texto1/texto2 y\r\n  // animaciones) -- unica diferencia real: el sector izquierdo no tiene\r\n  // escudos ni separador, en su lugar va un unico logo GLA estatico (sin\r\n  // datos del Marcador, no hay \"live\" por esa parte -- solo se mantiene\r\n  // por si en el futuro se agrega algo que dependa de scoreboard, hoy no\r\n  // se usa). Sin campo de logo en el panel: el logo es fijo, no elegible.\r\n  zocaloFinal: {\r\n    id: 'zocaloFinal',\r\n    label: 'Zocalo Compuesto Logo GLA',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'texto1', label: 'TEXTO 1', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'texto2', label: 'TEXTO 2', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: { texto1: '', texto2: '', sponsorsRotation: [], textPresets: [], textAdjust: textAdjustDefaults('texto1', 'texto2') },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // Z\u00D3CALO COMPUESTO (unificado) -- 2026-08-16, pedido explicito del\r\n  // usuario: \"no quiero duplicar dos modulos casi id\u00E9nticos\". Reemplaza en\r\n  // la navegacion a \"zocaloFinal\"/\"zocaloFinalDiv\" (ambos arriba: quedan\r\n  // registrados y con su renderer intacto para no perder datos/presets\r\n  // viejos ya persistidos, pero ocultos de la lista de tabs -- ver\r\n  // HIDDEN_FROM_NAV_IDS en master-control/js/main.js, mismo patron que\r\n  // \"gol\"). \"tipo\" elige que sector izquierdo mostrar (EQUIPOS: escudos en\r\n  // vivo del Marcador, mismo campo/logica que zocaloFinalDiv; LOGO: logo\r\n  // GLA fijo, mismo criterio que zocaloFinal) -- texto1/texto2/sponsors/\r\n  // presets/ajustes de composicion y de texto son UNA sola copia\r\n  // compartida entre ambos tipos (program/js/renderers/zocaloCompuesto.js\r\n  // hace el swap de video+contenido, ver ese archivo para el detalle de\r\n  // \"transicion segura\" al cambiar tipo estando al aire).\r\n  zocaloCompuesto: {\r\n    id: 'zocaloCompuesto',\r\n    label: 'Z\u00F3calo Compuesto',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'tipo', label: 'Tipo', type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'equipos', label: 'EQUIPOS (escudos del Marcador)' },\r\n          { id: 'logo', label: 'LOGO GLA' },\r\n        ],\r\n      },\r\n      { key: 'texto1', label: 'TEXTO 1', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'texto2', label: 'TEXTO 2', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      tipo: 'equipos',\r\n      texto1: '', texto2: '', sponsorsRotation: [],\r\n      escudosFuente: 'MARCADOR', customTeamA: '', customTeamB: '',\r\n      shieldPresets: [], textPresets: [], completePresets: [],\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2'),\r\n      // \"localCrestOffset*/awayCrestOffset*/logoOffset*\" (2026-08-31,\r\n      // auditoria completa): ninguno tenia ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      logoOffsetX: 0, logoOffsetY: 0, logoScale: 1,\r\n      // \"sponsorsOffsetX/Y/Scale\" (2026-09-24, pedido explicito del\r\n      // usuario: \"TODOS los sponsors del rotativo deben compartir UN UNICO\r\n      // ajuste de composicion\"). Reemplaza \"sponsor1Offset*\"/\"sponsor2Offset*\"\r\n      // (uno por cada uno de los 2 <img> del crossfade interno, ver\r\n      // program/js/renderers/zocaloCompuesto.js) -- con dos ajustes\r\n      // independientes, el mismo sponsor \"saltaba\" de posicion/escala segun\r\n      // en cual de los 2 slots del rotativo le tocara aparecer. Ahora los 2\r\n      // <img> comparten el mismo \"data-adjust\" (ver ese renderer), asi que\r\n      // ESTE unico valor se aplica a cualquiera de los dos por igual --\r\n      // mismo mecanismo ya usado para columnas de tablas (grupos/sideTable/\r\n      // posiciones), que tambien aplican un unico ajuste a varios nodos con\r\n      // el mismo id. Base elegida: la posicion COMUN ya guardada del modulo\r\n      // (0/0/1, ver shared/theme-layouts/gla.json) -- ni sponsor1 ni\r\n      // sponsor2 tenian una posicion distinta CONFIRMADA con \"Guardar\r\n      // posici\u00F3n\" (solo ajustes en vivo sin guardar, y distintos entre si),\r\n      // asi que no habia ninguna base real que preservar sin inventarla.\r\n      sponsorsOffsetX: 0, sponsorsOffsetY: 0, sponsorsScale: 1,\r\n    },\r\n  },\r\n\r\n  // \"zocaloCompuestoEquipos\" (2026-09-10, UNIFICADO con \"zocaloCompuestoLogo\"\r\n  // -- pedido explicito del usuario: \"es todo lo mismo, solo cambia el\r\n  // asset... necesito que sean un solo m\u00F3dulo, con la opci\u00F3n de men\u00FA\r\n  // desplegable CON LOGO LOCALSTRIKE | CON EQUIPOS\"). \"tipo\" decide que\r\n  // sector izquierdo se manda: EQUIPOS (escudos en vivo del Marcador, con\r\n  // linea separadora) o LOGO (logo LocalStrike fijo, sin linea) -- resto\r\n  // (texto1/texto2/subColor/sponsor/presets/composicion) es UNA sola copia\r\n  // compartida entre ambos tipos, mismo criterio ya probado en\r\n  // \"zocaloCompuesto\" (el modulo de GLA, sin relacion con este -- assets\r\n  // completamente distintos, ver program/js/renderers/zocaloCompuesto.js\r\n  // para el patron de \"transicion segura al cambiar tipo\" que este\r\n  // renderer reusa). \"zocaloCompuestoLogo\" (mas abajo) queda registrado\r\n  // SOLO para no perder datos/presets ya persistidos de quien lo haya\r\n  // usado antes de esta unificacion -- oculto de toda navegacion (ver\r\n  // HIDDEN_FROM_NAV_IDS en master-control/js/main.js, mismo patron que\r\n  // \"zocaloFinal\"/\"zocaloFinalDiv\"/\"gol\"), nunca mas editable directo.\r\n  zocaloCompuestoEquipos: {\r\n    id: 'zocaloCompuestoEquipos',\r\n    label: 'Z\u00F3calo Compuesto',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    // \"fields: []\" (2026-09-02, auditoria de wiring): el CONTENIDO\r\n    // (texto1/texto2/sponsor) lo muestra el panel dedicado\r\n    // (master-control/js/zocalo-compuesto-panel.js) -- declararlos aca\r\n    // tambien los duplicaba (2 cajas \"TEXTO MAIN\" en pantalla, una\r\n    // generica sin ACTUALIZAR y otra del panel). Mismo criterio que\r\n    // \"formacionEquipos\" mas arriba.\r\n    fields: [],\r\n    defaults: {\r\n      tipo: 'equipos',\r\n      // \"subColor\" (2026-09-02, pedido explicito del usuario): SOLO afecta\r\n      // texto2/SUBTEXTO -- texto1/MAIN se mantiene siempre blanco fijo, sin\r\n      // campo propio, tal como ya estaba. \"sponsorsRotation\" reemplaza al\r\n      // dropdown unico \"sponsor\" (mismo campo/mismo shape que ya usa\r\n      // zocaloCompuesto/zocaloFinal/zocaloFinalDiv -- array de ids,\r\n      // reutiliza el panel/renderer de rotacion existentes en vez de\r\n      // inventar uno nuevo).\r\n      texto1: '', texto2: '', subColor: 'negro', sponsorsRotation: [], textPresets: [],\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n      // \"logoOffsetX/Y/Scale\" (2026-09-10, fusionado desde\r\n      // \"zocaloCompuestoLogo\"): posicion propia del logo LocalStrike,\r\n      // independiente de la posicion de los escudos.\r\n      logoOffsetX: 0, logoOffsetY: 0, logoScale: 1,\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2'),\r\n      crestByTeam: { local: {}, away: {} },\r\n    },\r\n  },\r\n\r\n  // LEGACY -- ver comentario en \"zocaloCompuestoEquipos\" arriba. No editable\r\n  // desde Master Control (oculto de toda navegacion), solo conserva datos\r\n  // ya persistidos de antes de la unificacion 2026-09-10.\r\n  zocaloCompuestoLogo: {\r\n    id: 'zocaloCompuestoLogo',\r\n    label: 'Z\u00F3calo Compuesto con Logo',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      texto1: '', texto2: '', subColor: 'negro', sponsorsRotation: [], textPresets: [],\r\n      logoOffsetX: 0, logoOffsetY: 0, logoScale: 1,\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2'),\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // GRUPOS\r\n  // ---------------------------------------------------------------------\r\n  // Un unico modulo con un selector de variante (\"variante\": que PNG\r\n  // mostrar, Grupo 1 o Grupo 2) en vez de dos modulos separados \u2014 mismo\r\n  // criterio que Tarjeta (un campo elige que asset/variante se usa). Sin\r\n  // \"fields\" genericos: el selector de variante y las filas (escudo +\r\n  // nombre automaticos desde el catalogo de equipos + puntos) viven en un\r\n  // panel dedicado (master-control/js/grupos-panel.js) porque la cantidad\r\n  // de filas y el desplegable de equipo por fila no entran en el editor\r\n  // generico de schema (FIELD_TYPES.LIST no soporta un SELECT por fila ni\r\n  // una cantidad fija sin agregar/quitar \u2014 ver docs/ARCHITECTURE.md).\r\n  // Cada variante guarda su propio arreglo de filas por separado (no\r\n  // comparten datos entre si): son grupos de equipos distintos, cambiar\r\n  // el selector no tiene por que pisar lo cargado en el otro grupo.\r\n  // Cantidad de filas medida directamente sobre cada PNG (alfa/color real,\r\n  // no a ojo): ambos assets traen exactamente 3 casilleros de equipo.\r\n  //\r\n  // \"posicion\" (agregado 2026-07-31, a pedido explicito del usuario):\r\n  // modo de salida \u2014 'placaL' (posicion aprobada original: Grupo 1 y\r\n  // Grupo 2 se muestran juntos, apilados) o 'fullscreenDerecha'/\r\n  // 'fullscreenIzquierda' (un unico grupo, elegido con \"variante\", en la\r\n  // esquina inferior correspondiente). \"variante\" pasa a ser relevante\r\n  // solo en los modos fullscreen (\"Grupo visible\" en el panel); en modo\r\n  // Placa L se ignora porque se muestran ambos grupos siempre. El orden\r\n  // de cada tabla (mayor a menor puntaje) NO se persiste por separado:\r\n  // se recalcula siempre en el renderer (program/js/renderers/grupos.js)\r\n  // a partir de \"puntos\", con un sort estable para que los empates\r\n  // conserven el orden de carga original sin inventar un criterio de\r\n  // desempate adicional.\r\n  grupos: {\r\n    id: 'grupos',\r\n    label: 'Grupos',\r\n    category: 'Grupos',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      posicion: 'placaL',\r\n      variante: 'grupo1',\r\n      grupo1: { filas: [{ teamId: '', puntos: '' }, { teamId: '', puntos: '' }, { teamId: '', puntos: '' }] },\r\n      grupo2: { filas: [{ teamId: '', puntos: '' }, { teamId: '', puntos: '' }, { teamId: '', puntos: '' }] },\r\n      ultimaActualizacionWeb: '',\r\n      // Ajuste column-level compartido entre Grupo 1 y Grupo 2 (2026-08-15,\r\n      // auditoria completa) -- ver master-control/js/grupos-panel.js.\r\n      textAdjust: textAdjustDefaults('nombre', 'puntos'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): mismo\r\n      // criterio column-level que \"nombre\"/\"puntos\" -- un unico ajuste\r\n      // mueve el escudo de TODAS las filas visibles (Grupo 1 y Grupo 2\r\n      // por igual), nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // Sin asset nuevo todavia (se mantienen del sistema anterior)\r\n  // ---------------------------------------------------------------------\r\n  sideTable: {\r\n    id: 'sideTable',\r\n    label: 'Resultados',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'RESULTADOS',\r\n      posicion: 'placaL',\r\n      // PARTIDOS EVENTO / SORTEO (2026-10-22, SOLO GLA -- ver\r\n      // syncBracketCrestsFromGrupos en server/state.js): modo activo y la\r\n      // lista guardada del modo inactivo ({ encuentros, tanda } o null).\r\n      modoPartidos: 'evento',\r\n      partidosEvento: null,\r\n      partidosSorteo: null,\r\n      // Maximo 6 brackets visibles a la vez en Program; con mas de 6\r\n      // encuentros cargados, \"tanda\" elige que ventana de 6 se muestra\r\n      // ('tanda1' = partidos 1-6, 'tanda2' = partidos 4 en adelante) --\r\n      // ver program/js/renderers/sideTable.js.\r\n      tanda: 'tanda1',\r\n      encuentros: [\r\n        {\r\n          teamA: '',\r\n          teamB: '',\r\n          scoreA: '0',\r\n          scoreB: '0',\r\n          status: 'final',\r\n          hora: '',\r\n          // Titulo individual por encuentro (2026-08-15, pedido explicito\r\n          // del usuario: \"CUARTOS 1\", \"SEMIS 1\", \"GRAN FINAL\", etc.) --\r\n          // texto propio de CADA encuentro (a diferencia de golLocal/\r\n          // estado/etc., que son campos por-encuentro pero de tipo fijo),\r\n          // ver program/js/renderers/sideTable.js.\r\n          titulo: '',\r\n          // \"penalesA\"/\"penalesB\" (2026-08-16, pedido explicito del\r\n          // usuario: soportar \"6(3) - 6(1)\"): OPCIONALES, string vacio =\r\n          // sin definicion por penales -- Program muestra solo \"6 - 6\".\r\n          // Con ambos cargados, el numero de penales sale entre parentesis\r\n          // y mas chico junto al resultado (ver sideTable.js/overlay.css).\r\n          penalesA: '',\r\n          penalesB: ''\r\n        }\r\n      ],\r\n      faseWeb: 'grupos',\r\n      snapshotsWeb: {},\r\n      ultimaActualizacionWeb: '',\r\n      // Ajuste column-level (2026-08-15, auditoria completa): ver\r\n      // master-control/js/resultados-panel.js. \"tituloBracket\" es el\r\n      // ajuste de posicion/tama\u00F1o del titulo individual por encuentro\r\n      // (arriba del estado/hora); se llama distinto de \"titulo\" porque ese\r\n      // key ya lo usa el titulo GENERAL de todo el modulo (arriba de la\r\n      // tabla, ej. \"RESULTADOS\").\r\n      textAdjust: textAdjustDefaults('titulo', 'golLocal', 'golVisitante', 'estado', 'estadoFullscreen', 'tituloBracket'),\r\n      // \"crestLocalOffset*/crestVisitanteOffset*\" (2026-08-31, auditoria\r\n      // completa): ajuste column-level (mueve el escudo de TODOS los\r\n      // encuentros visibles) -- nunca tuvo ajuste propio.\r\n      crestLocalOffsetX: 0, crestLocalOffsetY: 0, crestLocalScale: 1,\r\n      crestVisitanteOffsetX: 0, crestVisitanteOffsetY: 0, crestVisitanteScale: 1,\r\n    },\r\n  },\r\n\r\n  estrellas: {\r\n    id: 'estrellas',\r\n    label: 'Estrellas',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'LOS MEJORES DE CADA EQUIPO',\r\n      fuente: 'liga',\r\n      snapshots: {},\r\n      formatoJugador: 'numero_apodo',\r\n      localJugador: null,\r\n      localNombre: '',\r\n      localG: 0,\r\n      localA: 0,\r\n      localPJ: 0,\r\n      visitanteJugador: null,\r\n      visitanteNombre: '',\r\n      visitanteG: 0,\r\n      visitanteA: 0,\r\n      visitantePJ: 0,\r\n      ultimaActualizacionWeb: '',\r\n      // \"localJugadorId\"/\"visitanteJugadorId\" (2026-09-10, pedido explicito\r\n      // del usuario: \"Estrellas... tiene que hacer la misma l\u00F3gica de Ficha\r\n      // Jugador\" -- identidad ESTABLE del jugador del plantel central de\r\n      // Argentina Streamers, ver server/playerRosters.js), para poder\r\n      // sincronizar Goles/Asistencias/Partidos Jugados contra\r\n      // argentinastreamers.com reusando el mismo endpoint/logica que Ficha\r\n      // Jugador (server/argentinaStreamersPlayerStats.js) -- vacio para un\r\n      // jugador tipeado a mano o para GLA (que sigue con su propio sync de\r\n      // gla.futbol, sin tocar).\r\n      localJugadorId: '',\r\n      visitanteJugadorId: '',\r\n      localWebSyncStatus: '', localWebSyncError: '',\r\n      visitanteWebSyncStatus: '', visitanteWebSyncError: '',\r\n      // 9 ajustes individuales (2026-08-15, auditoria completa): estructura\r\n      // fija (2 jugadores), cada texto se ajusta por separado -- ver\r\n      // master-control/js/estrellas-panel.js.\r\n      textAdjust: textAdjustDefaults(\r\n        'titulo',\r\n        'localNombre', 'localG', 'localA', 'localPJ',\r\n        'visitanteNombre', 'visitanteG', 'visitanteA', 'visitantePJ',\r\n      ),\r\n      // \"localCrestOffset*/visitanteCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los 2 escudos nunca tuvieron ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      visitanteCrestOffsetX: 0, visitanteCrestOffsetY: 0, visitanteCrestScale: 1,\r\n    },\r\n  },\r\n\r\n  // Tabla de posiciones: la liga tiene 11 equipos, \"filas\" guarda los 11\r\n  // (posicion real 1-11, nunca renumerada) aunque el asset solo tenga\r\n  // casilleros para una pagina a la vez. \"pagina\" ('pagina1' = posiciones\r\n  // 1-6 con posiciones-alpha.mp4, 'pagina2' = posiciones 7-11 con\r\n  // posiciones-5-alpha.mp4, ver program/js/renderers/posiciones.js) decide\r\n  // que subset de \"filas\" se compone en Program -- una unica sincronizacion\r\n  // web (o carga manual) llena las 11, el selector solo elige que ventana\r\n  // mostrar, no dispara una segunda consulta. Columnas numericas reales\r\n  // impresas en el grafico -- PTS, PJ, G, GXP, PXP, P, GF, GC, DG -- sin\r\n  // inventar ni recortar siglas. \"equipo\" guarda solo el ID del catalogo\r\n  // global (shared/teams.js); escudo y nombre completo se derivan siempre\r\n  // de ahi, nunca se cargan a mano. El orden de \"filas\" es el oficial tal\r\n  // como llega (de la web o cargado a mano): Program ya no recalcula un\r\n  // ranking propio por PTS/DG, solo filtra por rango de posicion y ordena\r\n  // por el campo \"posicion\" (ver renderer).\r\n  posiciones: {\r\n    id: 'posiciones',\r\n    label: 'Tabla Global',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'POSICIONES',\r\n      pagina: 'pagina1',\r\n      filas: [\r\n        { posicion: 1, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 2, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 3, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 4, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 5, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 6, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 7, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 8, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 9, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 10, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 11, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n      ],\r\n      // Ajuste column-level (2026-08-15, auditoria completa): un unico\r\n      // control por columna se aplica a todas las filas visibles -- ver\r\n      // master-control/js/posiciones-panel.js.\r\n      textAdjust: textAdjustDefaults('titulo', 'numero', 'equipo', 'pts', 'pj', 'g', 'gxp', 'pxp', 'p', 'gf', 'gc', 'dg'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): mismo\r\n      // criterio column-level -- el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  posicionesTorneo: {\r\n    id: 'posicionesTorneo',\r\n    label: 'Posiciones Torneo',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'POSICIONES TORNEO',\r\n      pagina: 'pagina1',\r\n      filas: Array.from({ length: 6 }, (_, index) => ({\r\n        posicion: index + 1, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0,\r\n        pxp: 0, p: 0, gf: 0, gc: 0, dg: 0,\r\n      })),\r\n      ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'numero', 'equipo', 'pts', 'pj', 'g', 'gxp', 'pxp', 'p', 'gf', 'gc', 'dg'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): mismo\r\n      // criterio column-level que \"posiciones\" -- el escudo nunca tuvo\r\n      // ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // \"cronogramaHoy\"/\"resultadosParciales\"/\"historial\" (2026-09-02):\r\n  // modulos de BRACKETS para Argentina Streamers, entregados por un\r\n  // agente concurrente -- integrados tal cual el handoff (ver\r\n  // docs/PATCH_SHARED_CLAUDE.md y docs/BRACKETS_ARGENTINA_STREAMERS.md),\r\n  // sin modificar su forma de datos/logica. Renderer y panel dedicados\r\n  // propios, sin tocar goleadores/asistidores/jugadores/fichaJugador.\r\n  cronogramaHoy: {\r\n    id: 'cronogramaHoy',\r\n    label: 'Cronograma Hoy',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    // \"encuentros\" (2026-09-02, reconstruido desde cero -- ver informe):\r\n    // la implementacion anterior (2 partidos manuales, tarjeta fabricada\r\n    // en CSS) se descarto por completo, pedido explicito del usuario (\"no\r\n    // reutilizar la placa vertical falsa anterior\", \"no quiero selector\r\n    // duplicado de equipos\"). Ahora hay un PNG real\r\n    // (cronograma-hoy.png, VS_DEFAULT entregado) con UN solo partido.\r\n    // \"teamLocal\"/\"teamVisitante\" (2026-09-04, cambio explicito del\r\n    // usuario: \"quiero poder armar manualmente un enfrentamiento\" --\r\n    // reemplaza la herencia automatica de scoreboard.teamA/teamB de\r\n    // arriba, que ya no se usa) -- seleccion manual desde el panel\r\n    // dedicado, catalogo Argentina Streamers. \"presets\" guarda\r\n    // combinaciones completas (titulo+local+visitante, NO posiciones,\r\n    // que siguen siendo layout) -- misma filosofia/helper que los presets\r\n    // de texto de zocalos (ver master-control/js/presets-helper.js).\r\n    // \"crestByTeam\" seedeado por teamId real (mismo patron que\r\n    // zocaloCompuestoEquipos), asi la posicion de cada escudo sobrevive a\r\n    // que cambie el equipo elegido.\r\n    defaults: {\r\n      titulo: 'PR\u00D3XIMO PARTIDO',\r\n      teamLocal: '',\r\n      teamVisitante: '',\r\n      presets: [],\r\n      textAdjust: textAdjustDefaults('titulo'),\r\n      crestByTeam: { local: {}, away: {} },\r\n    },\r\n  },\r\n\r\n  resultadosParciales: {\r\n    id: 'resultadosParciales',\r\n    label: 'Resultados Parciales',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'RESULTADOS PARCIALES',\r\n      // \"encuentros\" (2 partidos manuales con estado): NO se borra --\r\n      // pedido explicito del usuario (\"si ya tiene su propia l\u00F3gica de\r\n      // datos, no la destruyas\"). Queda sin uso por el renderer nuevo\r\n      // (2026-09-03, reconstruido sobre VS_RESULTADO.png real: un solo\r\n      // partido, escudos+resultado heredados en vivo del Marcador, mismo\r\n      // criterio que vsResultado/cronogramaHoy -- confirmado con el\r\n      // usuario). Se conserva por si se reactiva un uso futuro.\r\n      encuentros: [\r\n        { teamA: 'argentina-streamers', teamB: 'oxen', scoreA: '2', scoreB: '1', estado: 'FINAL' },\r\n        { teamA: 'peru-creadores', teamB: 'argentina-streamers-fem', scoreA: '0', scoreB: '0', estado: 'EN JUEGO' },\r\n      ],\r\n      textAdjust: textAdjustDefaults('titulo', 'teamA1', 'teamB1', 'scoreA1', 'scoreB1', 'estado1', 'teamA2', 'teamB2', 'scoreA2', 'scoreB2', 'estado2', 'scoreLocal', 'scoreVisitante'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" + \"crestByTeam\" (2026-09-03):\r\n      // escudos heredados en vivo del Marcador (sb.teamA/teamB), mismo\r\n      // mecanismo \"crestTeam\" que ya usan vsResultado/cronogramaHoy (ver\r\n      // resolveCrestTeamOverride en program/js/main.js) -- el offset\r\n      // flat es el default/fallback, \"crestByTeam\" guarda la posicion\r\n      // propia por equipo una vez que el operador la ajusta y guarda.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      crestByTeam: { local: {}, away: {} },\r\n    },\r\n  },\r\n\r\n  // \"historial\" (2026-09-02, reconstruido desde cero -- ver informe): la\r\n  // version anterior de Antigravity (categorias + paginacion + tarjeta\r\n  // fabricada en CSS) se descarto por completo, pedido explicito del\r\n  // usuario (\"NO reutilices su dise\u00F1o CSS/provisorio... la geometria/render\r\n  // debe partir del NUEVO asset\"). Ahora hay un PNG real\r\n  // (assets/themes/argentina-streamers/tablas/historial.png, medido pixel\r\n  // a pixel: 5 filas fijas LOCAL/GOL LOCAL/GOL VISITANTE/VISITANTE, sin\r\n  // fecha/competencia/categoria -- esas columnas no existen en el asset\r\n  // real). Shape minimo pedido: 5 partidos fijos, cada uno con equipo\r\n  // local/visitante (teamId real, escudo automatico) + goles como texto\r\n  // libre (no siempre son numeros -- \"P\" de penales, etc., decision igual\r\n  // que el resto del proyecto: nunca forzar tipo numerico en un campo que\r\n  // el operador tipea).\r\n  historial: {\r\n    id: 'historial',\r\n    label: 'Historial',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      // \"titulo\"/\"tipoHistorial\" (2026-09-02, pedido explicito del\r\n      // usuario): titulo manual (aparece en la zona superior real del\r\n      // PNG, ver overlay.css/\".ov-performance-titulo\" que reutiliza este\r\n      // modulo) + categoria, valores internos estables para cuando se\r\n      // conecte la web mas adelante -- por ahora es solo un dato mas que\r\n      // el operador elige, sin logica de fetch.\r\n      titulo: '',\r\n      tipoHistorial: 'iwc',\r\n      // \"teamBCrestUrl\"/\"penalLocal\"/\"penalVisitante\" (2026-09-04, pedido\r\n      // explicito del usuario -- ver server/argentinaStreamersSync.js):\r\n      // \"teamBCrestUrl\" es el escudo de un RIVAL HISTORICO sin equipo en\r\n      // el catalogo local (Colombia/Malasia/etc, ver\r\n      // server/argentinaStreamersClient.js), solo lo llena la sincro web;\r\n      // el editor manual (teamB, select del catalogo local) siempre tiene\r\n      // prioridad en el renderer y lo limpia al elegir un equipo a mano.\r\n      // \"penalLocal/penalVisitante\" son SOLO texto (nunca inventados, ver\r\n      // \"wentToPenalties\" real de la web) -- vacios = el partido no se\r\n      // definio por penales, el renderer no dibuja nada debajo del gol.\r\n      // \"fase\" (2026-09-04, pedido explicito del usuario): campo REAL de la\r\n      // web (\"stage\" en product.matches[]/product.competitions.*[].matches,\r\n      // ver server/argentinaStreamersSync.js) -- \"FASE DE GRUPO IWC\",\r\n      // \"SEMIFINAL ICC\", \"Amistoso\", etc. Nunca inferido de la posicion del\r\n      // partido; vacio si la web no publico fase para ese encuentro.\r\n      partidos: [\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n      ],\r\n      // Ajuste POR COLUMNA (2026-09-02, pedido explicito del usuario:\r\n      // \"criterio por columna/bloque, no fila individual\") -- un unico\r\n      // offset se aplica a los 5 escudos locales por igual, otro a los 5\r\n      // visitantes, mismo patron que \"goleadores/asistidores\" mas abajo.\r\n      crestLocalOffsetX: 0, crestLocalOffsetY: 0, crestLocalScale: 1,\r\n      crestVisitanteOffsetX: 0, crestVisitanteOffsetY: 0, crestVisitanteScale: 1,\r\n      // \"tituloCrestOffsetX/Y/Scale\" (2026-09-04, pedido explicito del\r\n      // usuario, item 7: escudo Argentina Streamers masculino a la\r\n      // izquierda del titulo -- nunca existio para este modulo, se agrega\r\n      // ahora, mismo patron ya usado en goleadores/asistidores/jugadores).\r\n      tituloCrestOffsetX: 0, tituloCrestOffsetY: 0, tituloCrestScale: 1,\r\n      // \"tituloByCategoria\" (2026-09-04, pedido explicito del usuario:\r\n      // \"no quiero una unica posicion/escala global del titulo, quiero\r\n      // guardar ajustes INDEPENDIENTES por categoria\" -- HISTORIAL - IWC\r\n      // es mucho mas corto que HISTORIAL - AMISTOSOS OFICIALES). Un\r\n      // textAdjust {dx,dy,dSize} completo por categoria, misma llave que\r\n      // \"tipoHistorial\" -- el renderer/panel eligen cual usar segun la\r\n      // categoria activa en vez del \"textAdjust.titulo\" unico de siempre\r\n      // (que se mantiene igual para el ESCUDO del titulo, item 7 del\r\n      // pedido: \"no separar salvo que haga falta tecnicamente\" -- el\r\n      // escudo NO depende del largo del texto, sigue con un unico ajuste).\r\n      tituloByCategoria: {\r\n        iwc: { dx: 0, dy: 0, dSize: 0 },\r\n        'copa-america': { dx: 0, dy: 0, dSize: 0 },\r\n        'amistosos-oficiales': { dx: 0, dy: 0, dSize: 0 },\r\n        amistosos: { dx: 0, dy: 0, dSize: 0 },\r\n      },\r\n      // \"resultadoNormal\"/\"resultadoConPenales\"/\"penalesFino\" (2026-09-04,\r\n      // pedido explicito del usuario: \"GOL LOCAL\"/\"GOL VISITANTE\" como dos\r\n      // controles de columna INDEPENDIENTES quedan eliminados -- \"los dos\r\n      // goles deben moverse juntos\", y ademas con geometria propia segun\r\n      // si la fila tiene penales o no, porque compartian demasiado la\r\n      // misma logica de posicionamiento). Los 3 son bloques {dx,dy,dSize}\r\n      // UNICOS (no por columna individual):\r\n      //  - \"resultadoNormal\": mueve/escala JUNTOS gol local + gol\r\n      //    visitante, SOLO en filas sin penales.\r\n      //  - \"resultadoConPenales\": mueve/escala JUNTOS gol local + gol\r\n      //    visitante + penal local + penal visitante, SOLO en filas CON\r\n      //    penales (nunca toca las filas sin penales -- geometria\r\n      //    completamente separada).\r\n      //  - \"penalesFino\": ajuste ADICIONAL, encima de \"resultadoConPenales\",\r\n      //    exclusivo de penal local/penal visitante -- mueve la segunda\r\n      //    linea \"(N) (N)\" respecto del score reglamentario sin tocar\r\n      //    donde esta parado el bloque completo.\r\n      // Migracion de baseline (item 10 del pedido: \"preservar las\r\n      // posiciones actuales, no desacomodar todo de golpe\"): los offsets\r\n      // YA guardados en las columnas viejas (\"textAdjust.golLocal/\r\n      // golVisitante/penalLocal/penalVisitante\", ver\r\n      // shared/theme-layouts/argentinaStreamers.json) NO se descartan --\r\n      // se hornean como base FIJA por elemento en\r\n      // program/js/renderers/historial.js (GOL_LOCAL_BASE_ADJUST, etc.),\r\n      // asi el look actual queda identico y estos 3 campos nuevos arrancan\r\n      // en 0/0/0 (el punto de partida correcto para un ajuste ADICIONAL).\r\n      resultadoNormal: { dx: 0, dy: 0, dSize: 0 },\r\n      resultadoConPenales: { dx: 0, dy: 0, dSize: 0 },\r\n      penalesFino: { dx: 0, dy: 0, dSize: 0 },\r\n      textAdjust: textAdjustDefaults('fase'),\r\n    },\r\n  },\r\n\r\n  // \"Sitio Web Promo L\" (2026-09-02, pedido explicito del usuario): placa\r\n  // full-bleed estatica con el PNG real (ANUNCIO_AS entregado) -- sin\r\n  // texto dinamico, el asset ya trae su contenido horneado (captura del\r\n  // sitio web + boton \"INGRES\u00C1\"). Categoria nueva \"Extras\" (ninguna de las\r\n  // existentes encajaba con \"publicidad/promocion\"). SOLO Argentina\r\n  // Streamers -- GLA_HIDDEN_MODULES en master-control/js/main.js lo oculta\r\n  // de su navegacion, mismo criterio que fichaJugador/historial/etc.\r\n  sitioWebPromoL: {\r\n    id: 'sitioWebPromoL',\r\n    label: 'Sitio Web Promo L',\r\n    category: 'Extras',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    // \"asset\" (2026-09-14, RESTAURADO -- pedido explicito del usuario: \"se\r\n    // perdi\u00F3/regres\u00F3 el desplegable que ya hab\u00EDamos agregado\"). Investigado\r\n    // antes de recrear a ciegas: revis\u00E9 `git log` sobre este m\u00F3dulo -- el\r\n    // \u00FAnico commit que lo toca (\"83cf1fa\") nunca tuvo este campo, as\u00ED que\r\n    // nunca lleg\u00F3 a confirmarse en un commit; era trabajo sin guardar de\r\n    // una sesi\u00F3n anterior que se perdi\u00F3 sin dejar rastro en el historial\r\n    // (no hay ning\u00FAn diff/commit que lo haya \"roto\" -- simplemente nunca\r\n    // qued\u00F3 persistido). Campo SELECT gen\u00E9rico (sin panel dedicado, este\r\n    // m\u00F3dulo nunca tuvo uno) -- decide qu\u00E9 variante de imagen usa\r\n    // \"resolveImageSrc\" v\u00EDa \"asset.variants\" en shared/themes.js.\r\n    fields: [\r\n      {\r\n        key: 'asset', label: 'ASSET', type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'argentina-streamers', label: 'ARGENTINA STREAMERS' },\r\n          { id: 'punch', label: 'PUNCH' },\r\n        ],\r\n      },\r\n    ],\r\n    defaults: {\r\n      asset: 'argentina-streamers',\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n    },\r\n  },\r\n\r\n  // Tablas de rendimiento: comparten panel y renderer, pero cada modulo\r\n  // conserva sus propios jugadores y posicion. El orden no se guarda como\r\n  // una segunda fuente de datos: se deriva de estas estadisticas con sort\r\n  // estable cada vez que Program renderiza. El estado visual sigue fuera\r\n  // de defaults, por lo que un reinicio siempre las deja OUT.\r\n  goleadores: {\r\n    id: 'goleadores',\r\n    label: 'Goleadores',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      // \"titulo\" (2026-09-02, pedido explicito del usuario: \"T\u00CDTULO\r\n      // configurable seg\u00FAn m\u00F3dulo\" sobre TABLA_ESTADISTICAS.png) -- vacio\r\n      // por default, el renderer cae al nombre de broadcast del modulo\r\n      // (\"GOLEADORES\") si el operador no escribio nada, nunca lo pisa.\r\n      titulo: '',\r\n      posicion: 'placaL', fuente: 'liga', jugadores: [], snapshots: {}, ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'position', 'name', 'primaryStat'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): ajuste\r\n      // column-level, el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  asistidores: {\r\n    id: 'asistidores',\r\n    label: 'Asistidores',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      titulo: '',\r\n      posicion: 'placaL', fuente: 'liga', jugadores: [], snapshots: {}, ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'position', 'name', 'primaryStat'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): ajuste\r\n      // column-level, el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  jugadores: {\r\n    id: 'jugadores',\r\n    label: 'Jugadores',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      // \"titulo\" (2026-09-02): en Argentina Streamers el renderer usa modo\r\n      // \"ranking\" (posicion+nombre+UN estadistica -- ver\r\n      // program/js/renderers/performanceTable.js) sobre el mismo PNG que\r\n      // goleadores/asistidores, con \"PARTICIPACIONES\" (PJ del jugador,\r\n      // metrica ya existente en el modulo) como estadistica -- GLA sigue\r\n      // exactamente con su layout de 3 columnas (G/A/PJ) de siempre, sin\r\n      // \"position\" ni \"titulo\" en su propio asset.\r\n      titulo: '',\r\n      posicion: 'placaL', fuente: 'liga', jugadores: [], snapshots: {}, ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'position', 'name', 'primaryStat', 'stat0', 'stat1', 'stat2'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): ajuste\r\n      // column-level, el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // FICHA JUGADOR (2026-09-02, pedido explicito del usuario: placa\r\n  // vertical individual con los datos de UN jugador, para Argentina\r\n  // Streamers). Modulo NUEVO, registrado igual para los dos themes (mismo\r\n  // criterio que el resto del proyecto: la estructura existe siempre, el\r\n  // ASSET real es lo que falta -- ver \"getModuleAssetStatus\", que ya\r\n  // infiere 'pending' sin \"image\"/\"video\" reales, sin tener que declarar\r\n  // \"status\" a mano aca). GLA no tiene pedido ningun uso de este modulo\r\n  // -- queda disponible en su navegacion (mismo patron que cualquier otro\r\n  // modulo del registro) pero sin contenido/flujo pensado para GLA.\r\n  //\r\n  // REHECHO EN BLOQUE 4 (2026-09-09, pedido explicito del usuario: \"FICHA\r\n  // JUGADOR debe consumir el sistema central de JUGADORES implementado en\r\n  // el BLOQUE 3... no crear otra lista manual independiente\"). Antes de\r\n  // este bloque el modulo mantenia su PROPIA lista de jugadores\r\n  // (jugadores[]/snapshots/fuente, igual que Goleadores/Asistidores) --\r\n  // eso quedaba desconectado del plantel central (server/playerRosters.js)\r\n  // y obligaba a cargar cada jugador dos veces. Ahora el modulo solo\r\n  // guarda una SELECCION (\"equipo\"+\"jugadorId\", apuntando al plantel\r\n  // central) mas una COPIA sincronizada de lo ultimo confirmado (nombre +\r\n  // 4 stats) -- exactamente el mismo patron que ya usa Estrellas\r\n  // (\"localJugador\"/\"localNombre\"/\"localG\", ver mas arriba en este\r\n  // archivo) para que Program nunca dependa de golpear la red: la copia\r\n  // es lo que Program realmente lee, la sincronizacion real pasa por\r\n  // server/playerRosters.js + server/argentinaStreamersPlayerStats.js\r\n  // (persistida ahi, reusable por cualquier otro modulo que a futuro\r\n  // quiera los mismos datos). \"xDisponible\" distingue \"la web confirmo 0\"\r\n  // de \"la web nunca informo este dato\" (pedido explicito, seccion 7: \"no\r\n  // calcular una estadistica distinta y llamarla MVP\" si no esta\r\n  // disponible) -- el renderer nunca inventa un numero para un stat\r\n  // marcado como no disponible. Sin \"g+a\": el PNG real (ver\r\n  // assets/themes/argentina-streamers/tablas/ficha-jugador.png) NO tiene\r\n  // ese recuadro -- se elimina el campo inventado de la version anterior\r\n  // (creada antes de tener el asset real).\r\n  fichaJugador: {\r\n    id: 'fichaJugador',\r\n    label: 'Ficha Jugador',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      equipo: 'local', // 'local' | 'visitante' -- mismo criterio que Tarjeta/Cambios\r\n      jugadorId: '', // id del jugador en el plantel central (server/playerRosters.js)\r\n      teamId: '',\r\n      nombre: '',\r\n      goles: 0, asistencias: 0, presencias: 0, mvps: 0,\r\n      golesDisponible: true, asistenciasDisponible: true, presenciasDisponible: true, mvpsDisponible: true,\r\n      ultimaActualizacionWeb: '',\r\n      webSyncStatus: '', // '' | 'ok' | 'error' | 'not-found' | 'ambiguous'\r\n      webSyncError: '',\r\n      textAdjust: textAdjustDefaults('nombre', 'goles', 'asistencias', 'presencias', 'mvps'),\r\n    },\r\n  },\r\n\r\n};\r\n\r\nexport const MODULE_IDS = Object.keys(MODULES);\r\n\r\n// \"AJUSTE DE COMPOSICI\u00D3N\" (2026-08-14, pedido explicito del usuario):\r\n// posicion X/Y + escala de TODO un modulo, aplicados como una capa\r\n// adicional sobre el dise\u00F1o base (\"posicion final = base + offset\",\r\n// \"escala final = base \u00D7 ajuste\") -- ver program/js/main.js\r\n// (applyModuleState) para donde se aplica el transform en Program, y\r\n// master-control/js/composition-control.js para el control de UI.\r\n// Mezclados aca, en el UNICO lugar por el que pasa CUALQUIER modulo al\r\n// inicializar su estado (server/state.js y master-control/js/main.js\r\n// llaman los dos a esta funcion), en vez de agregar estas 3 claves a mano\r\n// en los ~25 \"defaults\" de arriba -- asi un modulo nuevo que se registre\r\n// en el futuro hereda esta capa automaticamente, sin tocar este archivo\r\n// de nuevo ni el panel de Master Control.\r\nconst COMPOSITION_DEFAULTS = {\r\n  compositionOffsetX: 0,\r\n  compositionOffsetY: 0,\r\n  compositionScale: 1,\r\n};\r\n\r\n// \"layoutOverride\" (2026-09-01, LAYOUT BASE VERSIONADO -- pedido explicito\r\n// del usuario: \"GUARDAR POSICI\u00D3N\" tiene que producir un cambio que viaje\r\n// con Git, no solo con el estado runtime gitignorado). Opcional a\r\n// proposito: server/state.js es el UNICO caller que lo pasa (carga\r\n// shared/theme-layouts/<themeId>.json al arrancar, ver ese archivo) --\r\n// cualquier otro caller (ej. el placeholder que arma master-control/js/\r\n// main.js antes de recibir el snapshot real del servidor) sigue sin\r\n// pasarlo y obtiene exactamente el comportamiento de siempre (0/0/1\r\n// estructural). Es un subconjunto disperso del mismo arbol de \"defaults\"\r\n// (solo las claves de offset/escala/textAdjust que alguna vez se\r\n// confirmaron con GUARDAR POSICI\u00D3N) -- \"deepMergeAdjustFields\" lo aplica\r\n// ENCIMA de los defaults estructurales, nunca al reves, para que un modulo\r\n// nuevo o un campo nuevo sin base guardada todavia siga cayendo en su\r\n// default de dise\u00F1o de siempre.\r\nexport function cloneDefaults(moduleId, themeId, layoutOverride) {\r\n  const cloned = {\r\n    ...COMPOSITION_DEFAULTS,\r\n    ...JSON.parse(JSON.stringify(MODULES[moduleId].defaults)),\r\n  };\r\n  // Argentina Streamers usa un asset de penales con 5 espacios por equipo\r\n  // (GLA sigue en 3, sin cambios) -- pedido explicito del usuario, ver\r\n  // CHANGELOG.md. Unico chokepoint: ac\u00E1 se genera el array por defecto de\r\n  // \"kicksA\"/\"kicksB\"; el panel (buildPenaltyEditor) y el renderer de\r\n  // Program (buildStructure) ya son 100% length-driven, no necesitan tocarse.\r\n  if (moduleId === 'marcadorPenales' && themeId === ARGENTINA_STREAMERS_THEME_ID) {\r\n    cloned.kicksA = penaltyKicksDefault(5);\r\n    cloned.kicksB = penaltyKicksDefault(5);\r\n  }\r\n  if (layoutOverride) deepMergeAdjustFields(cloned, layoutOverride);\r\n  return cloned;\r\n}\r\n","http://localhost:4430/shared/constants.js","// Tipos de mensaje del protocolo WebSocket entre Master Control, Program y el servidor.\r\n// Compartido entre Node (server) y navegador (master-control / program) via ES modules.\r\n\r\nexport const WS_MSG = {\r\n  // Servidor -> clientes\r\n  STATE_SNAPSHOT: 'STATE_SNAPSHOT',\r\n  MODULE_UPDATE: 'MODULE_UPDATE',\r\n  // THEME_UPDATE (2026-08-20, sistema multi-theme): el theme activo es\r\n  // GLOBAL -- Master Control y Program tienen que enterarse del mismo\r\n  // cambio sin refrescar, mismo mecanismo de broadcast que ya usan\r\n  // TAKE/UPDATE/OUT (ver shared/themes.js, server/theme.js).\r\n  THEME_UPDATE: 'THEME_UPDATE',\r\n  // RECURSO GR\u00C1FICO (SOFTX): versi\u00F3n de cada archivo registrado (cache\r\n  // busting) + rutas cambiadas por un RECARGAR. Ver server/asset-resources.js.\r\n  ASSET_VERSIONS: 'ASSET_VERSIONS',\r\n  // Cliente (Master Control) -> servidor\r\n  TAKE: 'TAKE',\r\n  OUT: 'OUT',\r\n  UPDATE: 'UPDATE',\r\n  SET_THEME: 'SET_THEME',\r\n  // GUARDAR POSICI\u00D3N (2026-09-01, layout base versionado, pedido explicito\r\n  // del usuario): consolida el valor absoluto actual de UN elemento\r\n  // (moduleId + elementSpec, ver server/theme-layouts.js) dentro del\r\n  // archivo versionado del theme activo. No toca el estado runtime -- ver\r\n  // applyPositionCommit en server/state.js.\r\n  COMMIT_POSITION: 'COMMIT_POSITION',\r\n  // PERFILES DE PARTIDO (2026-09-05, ver server/match-profiles.js): global,\r\n  // Argentina Streamers unicamente. \"APPLY\" pisa el estado visual EN VIVO\r\n  // (mismo broadcast STATE_SNAPSHOT que SET_THEME, para que Program y\r\n  // Master Control se enteren sin refrescar); \"SAVE\"/\"SAVE_AS\"/\"DELETE\" son\r\n  // operaciones de archivo (ver server/match-profiles.js), el servidor\r\n  // responde con la lista actualizada via PROFILE_LIST_UPDATE.\r\n  PROFILE_LIST_UPDATE: 'PROFILE_LIST_UPDATE',\r\n  APPLY_MATCH_PROFILE: 'APPLY_MATCH_PROFILE',\r\n  SAVE_MATCH_PROFILE: 'SAVE_MATCH_PROFILE',\r\n  SAVE_AS_NEW_MATCH_PROFILE: 'SAVE_AS_NEW_MATCH_PROFILE',\r\n  DELETE_MATCH_PROFILE: 'DELETE_MATCH_PROFILE',\r\n  ACTIVE_MATCH_PROFILE_UPDATE: 'ACTIVE_MATCH_PROFILE_UPDATE',\r\n};\r\n\r\nexport const MODULE_STATUS = {\r\n  OUT: 'OUT',\r\n  ON: 'ON',\r\n};\r\n\r\nexport const FIELD_TYPES = {\r\n  TEXT: 'text',\r\n  TEXTAREA: 'textarea',\r\n  SELECT: 'select',\r\n  LIST: 'list',\r\n  PENALTY_SERIES: 'penaltySeries',\r\n  // Texto visible en Program que NO es editable a mano (viene del Marcador,\r\n  // de un reloj, o es un rotulo fijo del dise\u00F1o) pero igual necesita el\r\n  // editor de posicion/tama\u00F1o (2026-08-15, auditoria completa pedida por\r\n  // el usuario). Solo pinta la etiqueta + el control de ajuste, sin input\r\n  // de texto -- field-editors.js lo resuelve igual que \"adjustable:true\"\r\n  // en un campo TEXT, pero sin la parte de tipear.\r\n  ADJUST_ONLY: 'adjustOnly',\r\n};\r\n\r\nexport const PENALTY_KICK_STATUS = {\r\n  PENDING: 'pending',\r\n  SCORED: 'scored',\r\n  MISSED: 'missed',\r\n};\r\n\r\nexport const WS_PATH = '/ws';\r\n","http://localhost:4430/shared/ws-client.js","// Cliente WebSocket compartido por Master Control y Program.\r\n// Reconecta solo si se corta la conexion: en un stream en vivo no nos podemos\r\n// dar el lujo de perder el control por un hiccup de red momentaneo.\r\n\r\nimport { WS_PATH } from './constants.js';\r\n\r\n// Techo defensivo (2026-09-26, BUG real en vivo -- \"presiono OUT y no sale,\r\n// tengo que volver a hacer TAKE\" -- causa real: \"send()\" descartaba el\r\n// mensaje EN SILENCIO si el socket no estaba OPEN en ese instante exacto\r\n// -- ej. durante el hueco de reconexion de 1500ms tras un hiccup de red\r\n// momentaneo, o el reinicio del servidor -- sin cola ni feedback, el click\r\n// de OUT simplemente se perdia; el operador interpretaba que un TAKE\r\n// posterior \"lo arreglaba\", pero en realidad solo el intento QUE LLEGO\r\n// DESPUES de que el socket ya habia reconectado tenia efecto). Limite\r\n// generoso: una reconexion normal tarda 1500ms y el autosave manda cada\r\n// 80ms mientras se tipea, asi que un corte breve encola a lo sumo unas\r\n// pocas decenas de mensajes -- este techo es solo para no crecer sin\r\n// limite en un corte anormalmente largo (laptop en suspension, etc.),\r\n// descartando los mensajes MAS VIEJOS (los mas nuevos, mas cerca del\r\n// estado real actual, son los que importa conservar).\r\nconst MAX_QUEUED_MESSAGES = 500;\r\n\r\nexport function connect({ onMessage, onOpen, onClose } = {}) {\r\n  const protocol = location.protocol === 'https:' ? 'wss' : 'ws';\r\n  const url = `${protocol}://${location.host}${WS_PATH}`;\r\n  let socket = null;\r\n  // \"pendingQueue\" (2026-09-26): mensajes pedidos mientras el socket NO\r\n  // estaba OPEN -- se reenvian en orden apenas reconecta, en vez de\r\n  // perderse. TAKE/OUT explicitos y autosaves comparten la misma cola sin\r\n  // tratamiento especial: reenviar un autosave viejo de mas no rompe nada\r\n  // (el servidor solo aplica el ultimo Object.assign, idempotente), pero\r\n  // perder un TAKE/OUT explicito si rompe la confiabilidad pedida.\r\n  let pendingQueue = [];\r\n\r\n  function flushQueue() {\r\n    if (!pendingQueue.length) return;\r\n    const toSend = pendingQueue;\r\n    pendingQueue = [];\r\n    for (const msg of toSend) {\r\n      socket.send(JSON.stringify(msg));\r\n    }\r\n  }\r\n\r\n  function open() {\r\n    socket = new WebSocket(url);\r\n\r\n    socket.addEventListener('open', () => {\r\n      flushQueue();\r\n      if (onOpen) onOpen();\r\n    });\r\n\r\n    socket.addEventListener('message', (event) => {\r\n      let msg;\r\n      try {\r\n        msg = JSON.parse(event.data);\r\n      } catch {\r\n        return;\r\n      }\r\n      if (onMessage) onMessage(msg);\r\n    });\r\n\r\n    socket.addEventListener('close', () => {\r\n      if (onClose) onClose();\r\n      setTimeout(open, 1500);\r\n    });\r\n  }\r\n\r\n  open();\r\n\r\n  return {\r\n    send(msg) {\r\n      if (socket && socket.readyState === WebSocket.OPEN) {\r\n        socket.send(JSON.stringify(msg));\r\n        return;\r\n      }\r\n      pendingQueue.push(msg);\r\n      if (pendingQueue.length > MAX_QUEUED_MESSAGES) {\r\n        pendingQueue.splice(0, pendingQueue.length - MAX_QUEUED_MESSAGES);\r\n      }\r\n    },\r\n  };\r\n}\r\n","http://localhost:4430/master-control/js/live-clock-display.js","import { elapsedMs, formatClock, parseClockLimit } from '../../shared/clock.js';\r\n\r\n// Panel minimo de solo lectura para modulos con \"autoRunClock\": el reloj\r\n// arranca solo al Tomar al aire (ver master-control/js/main.js), aca solo se\r\n// muestra el valor corriendo, sin botones.\r\n//\r\n// \"options.limitKey\"/\"options.defaultLimitText\"/\"options.onDirty\" (2026-08-15,\r\n// pedido explicito del usuario: \"FIN DEL CONTADOR\" configurable, hoy solo\r\n// para Marcador Zocalo -- Tiempo Adicional sigue llamando esta funcion SIN\r\n// el 4to parametro, asi que su comportamiento no cambia en nada). Cuando se\r\n// pasa \"limitKey\", se agrega el input \"FIN DEL CONTADOR\" y el reloj mostrado\r\n// queda topeado en ese limite (mismo mecanismo que scoreboard-clock-panel.js).\r\nexport function renderLiveClockDisplay(container, data, clockKey, options = {}) {\r\n  const { limitKey, defaultLimitText, onDirty } = options;\r\n  container.innerHTML = '';\r\n\r\n  const box = document.createElement('div');\r\n  box.className = 'clock-box';\r\n\r\n  const title = document.createElement('div');\r\n  title.className = 'clock-box-title';\r\n  title.textContent = 'CONTADOR (arranca al Tomar al aire)';\r\n  box.appendChild(title);\r\n\r\n  const display = document.createElement('div');\r\n  display.className = 'clock-display';\r\n  box.appendChild(display);\r\n\r\n  if (limitKey) {\r\n    if (!data[limitKey]) data[limitKey] = defaultLimitText || '15:00';\r\n\r\n    const limitRow = document.createElement('div');\r\n    limitRow.className = 'clock-manual';\r\n\r\n    const limitLabel = document.createElement('label');\r\n    limitLabel.className = 'clock-end-label';\r\n    limitLabel.textContent = 'FIN DEL CONTADOR';\r\n    limitRow.appendChild(limitLabel);\r\n\r\n    const limitInput = document.createElement('input');\r\n    limitInput.type = 'text';\r\n    limitInput.className = 'clock-end-input';\r\n    limitInput.placeholder = defaultLimitText || '15:00';\r\n    limitInput.value = data[limitKey];\r\n    limitInput.addEventListener('input', () => {\r\n      data[limitKey] = limitInput.value;\r\n      if (onDirty) onDirty();\r\n      tick();\r\n    });\r\n    limitRow.appendChild(limitInput);\r\n\r\n    box.appendChild(limitRow);\r\n  }\r\n\r\n  container.appendChild(box);\r\n\r\n  function tick() {\r\n    const limitMs = limitKey ? parseClockLimit(data[limitKey], parseClockLimit(defaultLimitText, null)) : null;\r\n    display.textContent = formatClock(elapsedMs(data[clockKey], limitMs));\r\n  }\r\n  tick();\r\n\r\n  const interval = setInterval(tick, 500);\r\n  return () => clearInterval(interval);\r\n}\r\n","http://localhost:4430/master-control/js/scoreboard-clock-panel.js","import { elapsedMs, formatClock, emptyClock, parseClockLimit } from '../../shared/clock.js';\r\nimport { renderCompositionControl } from './composition-control.js';\r\n\r\n// \"FIN DEL CONTADOR\" (2026-08-15, pedido explicito del usuario): default\r\n// 15:00 para el reloj del Marcador principal -- ver shared/clock.js\r\n// (elapsedMs con limitMs) y program/js/renderers/scoreboard.js (mismo\r\n// default replicado ahi para que Program lo aplique igual si el operador\r\n// nunca toco el campo).\r\nconst DEFAULT_CLOCK_END_TEXT = '15:00';\r\n\r\n// \"PERIODO\" (2026-08-15, pedido explicito del usuario): botones claros en\r\n// vez de un dropdown. PERSONALIZADO habilita un textbox libre -- el dato\r\n// final sigue siendo el mismo \"data.period\" de siempre (string libre que\r\n// ya lee program/js/renderers/scoreboard.js), esto solo cambia COMO se\r\n// tipea, no que se guarda.\r\nconst PERIOD_PRESETS = [\r\n  { id: '1T', label: '1T' },\r\n  { id: '2T', label: '2T' },\r\n  { id: 'ET', label: 'ET' },\r\n];\r\n\r\n// Panel a medida para el reloj del Marcador principal. A diferencia de los\r\n// campos genericos (que quedan en el draft hasta que el operador aprieta\r\n// Tomar/Actualizar), los controles de aca mandan el cambio al instante: son\r\n// acciones discretas (Play/Pause/Reset), no texto libre.\r\n//\r\n// \"onGoalPlus\"/\"onGoalMinus\" (2026-08-15, pedido explicito del usuario: GOL\r\n// automatico al sumar desde el Marcador): callbacks que vive en\r\n// master-control/js/main.js (unico lugar con acceso a \"ws\"/\"serverState\"\r\n// para encolar la animacion sin duplicar logica aca) -- este panel solo\r\n// pinta los botones y avisa el click, mismo patron que \"onSelectSide\" de\r\n// Formacion (ver handleFormationSideChange en main.js).\r\n//\r\n// Devuelve una funcion de limpieza que hay que llamar al salir de este panel\r\n// (cambiar de tab) para frenar el intervalo que refresca el reloj en pantalla.\r\nexport function renderScoreboardClockPanel(container, data, sendPatch, { onGoalPlus, onGoalMinus, onResetGoles, onResetLocal, onResetVisitante, golData, golOnDirty, golSaveOptions, golRelativeToScoreboard, onPreviewGol, hideTeamColorAssign } = {}) {\r\n  container.innerHTML = '';\r\n\r\n  if (!data.clockEndText) data.clockEndText = DEFAULT_CLOCK_END_TEXT;\r\n  if (!data.period) data.period = '';\r\n\r\n  function currentLimitMs() {\r\n    return parseClockLimit(data.clockEndText, parseClockLimit(DEFAULT_CLOCK_END_TEXT, null));\r\n  }\r\n\r\n  // --- Reloj del partido ---\r\n  const clockBox = document.createElement('div');\r\n  clockBox.className = 'clock-box';\r\n\r\n  const clockTitle = document.createElement('div');\r\n  clockTitle.className = 'clock-box-title';\r\n  clockTitle.textContent = 'RELOJ DEL PARTIDO';\r\n  clockBox.appendChild(clockTitle);\r\n\r\n  const display = document.createElement('div');\r\n  display.className = 'clock-display';\r\n  clockBox.appendChild(display);\r\n\r\n  const btnRow = document.createElement('div');\r\n  btnRow.className = 'clock-buttons';\r\n  btnRow.append(\r\n    mkBtn('Play', () => {\r\n      // \"elapsedMs(data.clock, currentLimitMs())\" (no sin limite): si ya\r\n      // estaba trabado en el fin del contador, Play vuelve a arrancar\r\n      // DESDE ese valor topeado -- como el siguiente tick lo vuelve a\r\n      // topear de inmediato, en la practica queda igual de trabado hasta\r\n      // que el operador suba el limite o aprete Reset (comportamiento\r\n      // pedido explicitamente: \"queda trabado hasta intervencion del\r\n      // operador\").\r\n      data.clock = { running: true, accumulatedMs: elapsedMs(data.clock, currentLimitMs()), startedAt: Date.now() };\r\n      sendPatch({ clock: data.clock });\r\n      tick();\r\n    }),\r\n    mkBtn('Pause', () => {\r\n      data.clock = { running: false, accumulatedMs: elapsedMs(data.clock, currentLimitMs()), startedAt: null };\r\n      sendPatch({ clock: data.clock });\r\n      tick();\r\n    }),\r\n    mkBtn('Reset', () => {\r\n      data.clock = emptyClock();\r\n      sendPatch({ clock: data.clock });\r\n      tick();\r\n    }),\r\n  );\r\n  clockBox.appendChild(btnRow);\r\n\r\n  const manualRow = document.createElement('div');\r\n  manualRow.className = 'clock-manual';\r\n\r\n  const minInput = document.createElement('input');\r\n  minInput.type = 'number';\r\n  minInput.min = '0';\r\n  minInput.placeholder = 'Min';\r\n\r\n  const secInput = document.createElement('input');\r\n  secInput.type = 'number';\r\n  secInput.min = '0';\r\n  secInput.max = '59';\r\n  secInput.placeholder = 'Seg';\r\n\r\n  manualRow.append(\r\n    minInput,\r\n    secInput,\r\n    mkBtn('Fijar', () => {\r\n      const minutes = parseInt(minInput.value, 10) || 0;\r\n      const seconds = parseInt(secInput.value, 10) || 0;\r\n      const wasRunning = data.clock.running;\r\n      data.clock = {\r\n        running: wasRunning,\r\n        accumulatedMs: (minutes * 60 + seconds) * 1000,\r\n        startedAt: wasRunning ? Date.now() : null,\r\n      };\r\n      sendPatch({ clock: data.clock });\r\n      tick();\r\n    }, 'btn-clock-set'),\r\n  );\r\n  clockBox.appendChild(manualRow);\r\n\r\n  const limitRow = document.createElement('div');\r\n  limitRow.className = 'clock-manual';\r\n  const limitLabel = document.createElement('label');\r\n  limitLabel.className = 'clock-end-label';\r\n  limitLabel.textContent = 'FIN DEL CONTADOR';\r\n  const limitInput = document.createElement('input');\r\n  limitInput.type = 'text';\r\n  limitInput.className = 'clock-end-input';\r\n  limitInput.placeholder = DEFAULT_CLOCK_END_TEXT;\r\n  limitInput.value = data.clockEndText;\r\n  limitInput.addEventListener('input', () => {\r\n    data.clockEndText = limitInput.value;\r\n    sendPatch({ clockEndText: data.clockEndText });\r\n    tick();\r\n  });\r\n  limitRow.append(limitLabel, limitInput);\r\n  clockBox.appendChild(limitRow);\r\n\r\n  container.appendChild(clockBox);\r\n\r\n  function tick() {\r\n    display.textContent = formatClock(elapsedMs(data.clock, currentLimitMs()));\r\n  }\r\n  tick();\r\n  const interval = setInterval(tick, 500);\r\n\r\n  // --- Periodo / tiempo del partido ---\r\n  const periodBox = document.createElement('div');\r\n  periodBox.className = 'clock-box';\r\n  const periodTitle = document.createElement('div');\r\n  periodTitle.className = 'clock-box-title';\r\n  periodTitle.textContent = 'PER\u00CDODO / TIEMPO';\r\n  periodBox.appendChild(periodTitle);\r\n\r\n  const periodBtnRow = document.createElement('div');\r\n  periodBtnRow.className = 'clock-buttons';\r\n\r\n  const isPreset = PERIOD_PRESETS.some((p) => p.id === data.period);\r\n  let customMode = data.period !== '' && !isPreset;\r\n\r\n  function setPeriod(value) {\r\n    data.period = value;\r\n    sendPatch({ period: value });\r\n  }\r\n\r\n  for (const preset of PERIOD_PRESETS) {\r\n    const btn = mkBtn(preset.label, () => {\r\n      customMode = false;\r\n      setPeriod(preset.id);\r\n      renderPeriodState();\r\n    });\r\n    btn.dataset.periodId = preset.id;\r\n    periodBtnRow.appendChild(btn);\r\n  }\r\n  const customBtn = mkBtn('PERSONALIZADO', () => {\r\n    customMode = true;\r\n    setPeriod('');\r\n    renderPeriodState();\r\n    customInput.focus();\r\n  });\r\n  periodBtnRow.appendChild(customBtn);\r\n  periodBox.appendChild(periodBtnRow);\r\n\r\n  const customInput = document.createElement('input');\r\n  customInput.type = 'text';\r\n  customInput.placeholder = 'Texto libre (ej. ALARGUE, 3T...)';\r\n  customInput.className = 'clock-end-input';\r\n  customInput.value = customMode ? data.period : '';\r\n  customInput.addEventListener('input', () => {\r\n    setPeriod(customInput.value);\r\n  });\r\n  periodBox.appendChild(customInput);\r\n\r\n  function renderPeriodState() {\r\n    for (const btn of periodBtnRow.querySelectorAll('button[data-period-id]')) {\r\n      btn.classList.toggle('active', !customMode && btn.dataset.periodId === data.period);\r\n    }\r\n    customBtn.classList.toggle('active', customMode);\r\n    customInput.style.display = customMode ? '' : 'none';\r\n    if (!customMode) customInput.value = '';\r\n  }\r\n  renderPeriodState();\r\n\r\n  container.appendChild(periodBox);\r\n\r\n  // --- Goles: [-] N [+] por lado + RESET LOCAL/VISITANTE/GENERAL (BLOQUE 2,\r\n  // 2026-09-09, pedido explicito del usuario: \"eliminar los textbox/input\r\n  // num\u00E9ricos manuales actuales para goles... dos controles separados, GOL\r\n  // LOCAL y GOL VISITANTE, cada uno con su propio RESET, m\u00E1s un RESET\r\n  // GENERAL\"). \"+1\" sigue disparando la animaci\u00F3n de GOL sincronizada\r\n  // (onGoalPlus, sin cambios de arquitectura); \"-1\" y los 3 RESET nunca la\r\n  // disparan (onGoalMinus/onResetLocal/onResetVisitante/onResetGoles, mismo\r\n  // criterio que ya reg\u00EDa para \"-1\"/\"RESETEAR GOLES\" antes de este bloque).\r\n  // El valor mostrado entre \"[-]\"/\"[+]\" se lee de \"data.scoreA/scoreB\" en\r\n  // cada render de este panel -- ya se refresca solo porque main.js llama\r\n  // \"renderPanel()\" (rearma este panel entero) despu\u00E9s de cada click en\r\n  // scoreGoal/undoGoal/resetGoles* (ver esas funciones).\r\n  if (onGoalPlus && onGoalMinus) {\r\n    const golBox = document.createElement('div');\r\n    golBox.className = 'clock-box';\r\n    const golTitle = document.createElement('div');\r\n    golTitle.className = 'clock-box-title';\r\n    golTitle.textContent = 'GOLES (dispara la animaci\u00F3n autom\u00E1ticamente)';\r\n    golBox.appendChild(golTitle);\r\n\r\n    function buildGoalCounter(sideLabel, scoreKey, side, onReset, resetLabel) {\r\n      const group = document.createElement('div');\r\n      group.className = 'gol-counter-group';\r\n\r\n      const label = document.createElement('div');\r\n      label.className = 'gol-counter-label';\r\n      label.textContent = sideLabel;\r\n      group.appendChild(label);\r\n\r\n      const row = document.createElement('div');\r\n      row.className = 'gol-counter-row';\r\n\r\n      const minusBtn = mkGoalBtn('\u2212', () => onGoalMinus(side), 'gol-counter-btn gol-counter-minus');\r\n      const value = document.createElement('span');\r\n      value.className = 'gol-counter-value';\r\n      value.textContent = String(parseInt(data[scoreKey], 10) || 0);\r\n      const plusBtn = mkGoalBtn('+', () => onGoalPlus(side), 'gol-counter-btn gol-counter-plus');\r\n\r\n      row.append(minusBtn, value, plusBtn);\r\n      group.appendChild(row);\r\n\r\n      if (onReset) {\r\n        group.appendChild(mkBtn(resetLabel, onReset, 'btn-clock-danger gol-btn gol-reset-side'));\r\n      }\r\n\r\n      return group;\r\n    }\r\n\r\n    golBox.appendChild(buildGoalCounter('GOL LOCAL', 'scoreA', 'A', onResetLocal, 'RESET LOCAL'));\r\n    golBox.appendChild(buildGoalCounter('GOL VISITANTE', 'scoreB', 'B', onResetVisitante, 'RESET VISITANTE'));\r\n\r\n    // \"RESETEAR GOLES\" / RESET GENERAL (2026-08-16, ampliado BLOQUE 2): pone\r\n    // ambos lados en 0 en un unico click -- vuelve a 0 sin animacion de GOL\r\n    // (el callback en main.js NO pasa por scoreGoal/undoGoal, nunca encola\r\n    // ni dispara la pieza de festejo).\r\n    if (onResetGoles) {\r\n      const resetRow = document.createElement('div');\r\n      resetRow.className = 'clock-buttons gol-buttons-grid gol-buttons-reset';\r\n      resetRow.appendChild(mkBtn('RESET GENERAL (0-0)', onResetGoles, 'btn-clock-danger gol-btn'));\r\n      golBox.appendChild(resetRow);\r\n    }\r\n\r\n    container.appendChild(golBox);\r\n  }\r\n\r\n  // --- Ajuste de composici\u00F3n de la animaci\u00F3n de GOL (2026-09-10, pedido\r\n  // explicito del usuario): \"gol\" es un modulo real del servidor (oneShot,\r\n  // ver shared/modules.js) pero nunca tuvo tab propia en la navegacion (se\r\n  // dispara solo, ver \"onGoalPlus\"/fireNextGolAnimation en main.js) -- este\r\n  // es el unico lugar del operador para ajustar su posicion/escala, ya que\r\n  // conceptualmente pertenece al Marcador (quien lo dispara). Mismo\r\n  // componente universal que cualquier otro modulo (renderCompositionControl,\r\n  // compositionOffsetX/Y/Scale ya la inyecta cloneDefaults para CUALQUIER\r\n  // modulo, incluido \"gol\") -- Program ya aplica ese transform de forma\r\n  // generica (applyComposition en program/js/main.js) sin que\r\n  // program/js/renderers/gol.js necesite saber nada de esto. Los cambios se\r\n  // ven LIVE de inmediato incluso a mitad de la animacion (mismo mecanismo\r\n  // \"applyVisualLive\" que ya usa el resto del proyecto), sin tocar la\r\n  // logica automatica de disparo (scoreGoal/fireNextGolAnimation intactos).\r\n  if (golData) {\r\n    const golAdjustBox = document.createElement('div');\r\n    golAdjustBox.className = 'clock-box';\r\n    const golAdjustTitle = document.createElement('div');\r\n    golAdjustTitle.className = 'clock-box-title';\r\n    // GLA (2026-10-21, pedido explicito del usuario): GOL ya sigue solo la\r\n    // composicion del Marcador (ver composedCompositionData en\r\n    // program/js/visual-compose.js) -- este control pasa a ser el AJUSTE\r\n    // FINO RELATIVO de GOL respecto del Marcador; su RESET no toca el\r\n    // Marcador. Argentina Streamers conserva el texto/comportamiento de siempre.\r\n    golAdjustTitle.textContent = golRelativeToScoreboard\r\n      ? 'AJUSTE FINO DE LA ANIMACI\u00D3N DE GOL (relativo al Marcador)'\r\n      : 'AJUSTE DE COMPOSICI\u00D3N \u2014 ANIMACI\u00D3N DE GOL';\r\n    golAdjustBox.appendChild(golAdjustTitle);\r\n    const golAdjustBody = document.createElement('div');\r\n    golAdjustBox.appendChild(golAdjustBody);\r\n    renderCompositionControl(golAdjustBody, golData, golOnDirty || (() => {}), {\r\n      title: '',\r\n      note: golRelativeToScoreboard\r\n        ? 'La animaci\u00F3n de GOL ya acompa\u00F1a autom\u00E1ticamente la posici\u00F3n y escala del MARCADOR. Esto es solo el ajuste fino propio de GOL; RESET no mueve el Marcador.'\r\n        : 'Mueve y escala la animaci\u00F3n de GOL como una sola unidad.',\r\n      ...(golSaveOptions || {}),\r\n      elementSpec: { kind: 'composition', dataPath: [], xKey: 'compositionOffsetX', yKey: 'compositionOffsetY', scaleKey: 'compositionScale' },\r\n    });\r\n    if (onPreviewGol) {\r\n      const previewRow = document.createElement('div');\r\n      previewRow.className = 'clock-buttons';\r\n      previewRow.appendChild(mkBtn('PREVIEW GOL (ver la animaci\u00F3n en el monitor PREVIEW)', onPreviewGol));\r\n      golAdjustBox.appendChild(previewRow);\r\n    }\r\n    container.appendChild(golAdjustBox);\r\n  }\r\n\r\n  // --- Color de equipo (2026-08-16, pedido explicito del usuario:\r\n  // \"ASIGNAR COLOR AL EQUIPO\") ---------------------------------------\r\n  // Cambiar el color arriba (campo generico \"teamAColor\"/\"teamBColor\") es\r\n  // siempre temporal. Solo apretando este boton se guarda en\r\n  // \"data.teamColorAssignments[teamId]\" -- de ahi en mas, cada vez que ese\r\n  // equipo se vuelva a elegir como local o visitante (en cualquier lado),\r\n  // \"master-control/js/main.js\" autocompleta el color guardado. Volver a\r\n  // apretar el boton con un color distinto pisa la asignacion anterior.\r\n  if (hideTeamColorAssign) return () => clearInterval(interval);\r\n  const colorBox = document.createElement('div');\r\n  // \"clock-box-team-color\" (2026-08-28, pedido explicito del usuario:\r\n  // ocultar TODO control de color de camiseta/equipo del panel de MARCADOR\r\n  // solo para Argentina Streamers -- ver master.css\r\n  // \"body[data-theme='argentinaStreamers'] .clock-box-team-color\").\r\n  colorBox.className = 'clock-box clock-box-team-color';\r\n  const colorTitle = document.createElement('div');\r\n  colorTitle.className = 'clock-box-title';\r\n  colorTitle.textContent = 'COLOR DE EQUIPO';\r\n  colorBox.appendChild(colorTitle);\r\n\r\n  const colorNote = document.createElement('p');\r\n  colorNote.className = 'clock-note';\r\n  colorNote.textContent = 'Eleg\u00ED el color arriba y apret\u00E1 para recordarlo: la pr\u00F3xima vez que selecciones ese equipo (local o visitante), se autocompleta solo.';\r\n  colorBox.appendChild(colorNote);\r\n\r\n  const colorRow = document.createElement('div');\r\n  colorRow.className = 'clock-buttons';\r\n  colorRow.append(\r\n    mkBtn('ASIGNAR COLOR \u2014 EQUIPO LOCAL', () => {\r\n      if (!data.teamA) return;\r\n      if (!data.teamColorAssignments || typeof data.teamColorAssignments !== 'object') data.teamColorAssignments = {};\r\n      data.teamColorAssignments[data.teamA] = data.teamAColor;\r\n      sendPatch({ teamColorAssignments: data.teamColorAssignments });\r\n    }),\r\n    mkBtn('ASIGNAR COLOR \u2014 EQUIPO VISITANTE', () => {\r\n      if (!data.teamB) return;\r\n      if (!data.teamColorAssignments || typeof data.teamColorAssignments !== 'object') data.teamColorAssignments = {};\r\n      data.teamColorAssignments[data.teamB] = data.teamBColor;\r\n      sendPatch({ teamColorAssignments: data.teamColorAssignments });\r\n    }),\r\n  );\r\n  colorBox.appendChild(colorRow);\r\n  container.appendChild(colorBox);\r\n\r\n  return () => clearInterval(interval);\r\n}\r\n\r\nfunction mkBtn(label, onClick, extraClass) {\r\n  const btn = document.createElement('button');\r\n  btn.type = 'button';\r\n  btn.textContent = label;\r\n  btn.className = extraClass ? `btn-clock ${extraClass}` : 'btn-clock';\r\n  btn.addEventListener('click', onClick);\r\n  return btn;\r\n}\r\n\r\n// Boton de gol con su propio debounce corto (2026-08-15, pedido explicito\r\n// del usuario: \"evitar... clicks repetidos\"): un click real de un gol no\r\n// se pierde (ver onGoalPlus en main.js, que encola la animacion), pero un\r\n// doble-click accidental sobre EL MISMO boton en menos de 600ms no debe\r\n// contar como dos goles -- el boton se autodeshabilita brevemente despues\r\n// de cada click, tiempo de sobra para que un click intencional distinto\r\n// (otro gol real) siga funcionando sin problema.\r\nfunction mkGoalBtn(label, onClick, extraClass) {\r\n  const btn = mkBtn(label, () => {\r\n    if (btn.disabled) return;\r\n    btn.disabled = true;\r\n    onClick();\r\n    setTimeout(() => { btn.disabled = false; }, 600);\r\n  }, extraClass);\r\n  return btn;\r\n}\r\n","http://localhost:4430/master-control/js/match-roster-panel.js","import { teamName } from '../../shared/teams.js';\r\n\r\nexport function renderMatchRosterPanel(container, data, scoreboardData, moduleId, onChanged) {\r\n  const side = data.equipo === 'visitante' ? 'visitante' : 'local';\r\n  const teamId = side === 'visitante' ? scoreboardData?.teamB : scoreboardData?.teamA;\r\n  const name = teamName(teamId) || (side === 'visitante' ? 'VISITANTE' : 'LOCAL');\r\n  const root = document.createElement('section');\r\n  root.className = 'match-roster-panel';\r\n  container.appendChild(root);\r\n  // En Tarjetas/Cambios el panel de plantel debe quedar inmediatamente\r\n  // despues de EQUIPO y antes de los campos manuales/tipo restantes.\r\n  const nextGenericField = container.children[1];\r\n  if (nextGenericField && nextGenericField !== root) container.insertBefore(root, nextGenericField);\r\n  let snapshot = null;\r\n  let status = null;\r\n  let disposed = false;\r\n\r\n  async function loadSnapshot() {\r\n    if (!teamId) return;\r\n    try {\r\n      const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}`);\r\n      const body = await response.json().catch(() => null);\r\n      if (response.ok && body?.ok) snapshot = body.snapshot;\r\n    } catch {\r\n      // Sin red local o sin servidor: mantener el editor manual existente.\r\n    }\r\n    if (!disposed) render();\r\n  }\r\n\r\n  async function syncRoster() {\r\n    if (!teamId) return;\r\n    status = { kind: 'loading', text: 'Actualizando...' };\r\n    render();\r\n    try {\r\n      const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}/sync-web`, { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      snapshot = body.snapshot;\r\n      status = { kind: 'success', text: 'PLANTEL ACTUALIZADO' };\r\n    } catch (error) {\r\n      status = { kind: 'error', text: 'ERROR AL ACTUALIZAR', detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  function playerSelect(label, field) {\r\n    const wrap = document.createElement('label');\r\n    wrap.className = 'field';\r\n    const title = document.createElement('span');\r\n    title.textContent = label;\r\n    const select = document.createElement('select');\r\n    const empty = document.createElement('option');\r\n    empty.value = '';\r\n    empty.textContent = 'Seleccionar jugador del plantel';\r\n    select.appendChild(empty);\r\n    for (const player of snapshot?.jugadores || []) {\r\n      const option = document.createElement('option');\r\n      option.value = player.nombreTV;\r\n      option.textContent = player.nombreTV;\r\n      select.appendChild(option);\r\n    }\r\n    select.value = (snapshot?.jugadores || []).some((player) => player.nombreTV === data[field]) ? data[field] : '';\r\n    select.disabled = !snapshot?.jugadores?.length;\r\n    select.addEventListener('change', () => {\r\n      if (!select.value) return;\r\n      data[field] = select.value;\r\n      onChanged();\r\n    });\r\n    wrap.append(title, select);\r\n    return wrap;\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n    const heading = document.createElement('h3');\r\n    heading.textContent = `PLANTEL \u2014 ${side.toUpperCase()} \u2014 ${name}`;\r\n    root.appendChild(heading);\r\n    const syncRow = document.createElement('div');\r\n    syncRow.className = 'performance-sync';\r\n    const button = document.createElement('button');\r\n    button.type = 'button';\r\n    button.className = 'performance-sync-btn';\r\n    button.textContent = 'ACTUALIZAR PLANTILLA DESDE WEB';\r\n    button.disabled = !teamId || status?.kind === 'loading';\r\n    button.addEventListener('click', syncRoster);\r\n    syncRow.appendChild(button);\r\n    if (status) {\r\n      const message = document.createElement('span');\r\n      message.className = `performance-sync-status ${status.kind}`;\r\n      message.textContent = status.text;\r\n      if (status.detail) message.title = status.detail;\r\n      syncRow.appendChild(message);\r\n    }\r\n    root.appendChild(syncRow);\r\n    if (!teamId) {\r\n      const note = document.createElement('p');\r\n      note.className = 'performance-note';\r\n      note.textContent = 'Selecciona los equipos LOCAL y VISITANTE en Marcador para cargar el plantel.';\r\n      root.appendChild(note);\r\n      return;\r\n    }\r\n    if (!snapshot?.jugadores?.length) {\r\n      const note = document.createElement('p');\r\n      note.className = 'performance-note';\r\n      note.textContent = 'No hay snapshot de plantel. La escritura manual sigue disponible.';\r\n      root.appendChild(note);\r\n    }\r\n    if (moduleId === 'tarjeta') root.appendChild(playerSelect('JUGADOR DEL PLANTEL', 'jugador'));\r\n    if (moduleId === 'cambios') {\r\n      root.appendChild(playerSelect('JUGADOR QUE ENTRA', 'entra'));\r\n      root.appendChild(playerSelect('JUGADOR QUE SALE', 'sale'));\r\n    }\r\n  }\r\n\r\n  render();\r\n  loadSnapshot();\r\n  return () => { disposed = true; };\r\n}\r\n","http://localhost:4430/master-control/js/field-editors.js","import { FIELD_TYPES, PENALTY_KICK_STATUS } from '../../shared/constants.js';\r\nimport { renderTextAdjustControl } from './text-adjust-control.js';\r\n\r\nconst KICK_CYCLE = [PENALTY_KICK_STATUS.PENDING, PENALTY_KICK_STATUS.SCORED, PENALTY_KICK_STATUS.MISSED];\r\nconst KICK_LABEL = { pending: '\u2014', scored: 'GOL', missed: 'X' };\r\n\r\n// Compartido por \"adjustable:true\" (campo TEXT) y \"ADJUST_ONLY\" (texto sin\r\n// input propio) -- si el modulo todavia no tiene \"textAdjust\" en su\r\n// estado persistido (dato viejo, de antes de este mecanismo) lo crea aca\r\n// mismo, mismo shape que \"textAdjustDefaults()\" en shared/modules.js.\r\nexport function mountAdjustControl(wrap, data, key, onDirty, options) {\r\n  if (!data.textAdjust || typeof data.textAdjust !== 'object') data.textAdjust = {};\r\n  if (!data.textAdjust[key] || typeof data.textAdjust[key] !== 'object') {\r\n    data.textAdjust[key] = { dx: 0, dy: 0, dSize: 0 };\r\n  }\r\n  // \"elementSpec\" (2026-09-01, layout base versionado): \"key\" ya identifica\r\n  // sin ambiguedad donde vive este ajuste dentro de \"textAdjust\" (incluidas\r\n  // las rutas planas tipo \"double1.name\") -- se arma UNA sola vez aca, el\r\n  // unico lugar por el que pasa CUALQUIER campo de texto ajustable de todo\r\n  // el sistema, asi ningun caller (field-editors genericos, paneles\r\n  // dedicados) tiene que saber nada de esto.\r\n  renderTextAdjustControl(wrap, data.textAdjust[key], onDirty, {\r\n    ...options,\r\n    elementSpec: { kind: 'text', dataPath: ['textAdjust', key] },\r\n  });\r\n}\r\n\r\n// Genera el panel de edicion completo a partir del schema de un modulo.\r\n// `data` se muta in-place (es el draft local del operador); `onDirty` se\r\n// llama en cada cambio para que el caller sepa que hay ediciones pendientes.\r\n// \"hideAdjustFor\" (2026-08-31, pedido explicito del usuario: acordeon de\r\n// ajuste individual del MARCADOR en Argentina Streamers -- ver\r\n// \"renderScoreboardAdjustAccordion\" en main.js) -- Set opcional de field\r\n// keys cuyo control de ajuste YA se muestra en otro lado (el acordeon) y\r\n// no debe duplicarse aca: un ADJUST_ONLY con la key ahi se omite entero\r\n// (label+ajuste eran todo su contenido); un TEXT \"adjustable\" se sigue\r\n// mostrando normal (el operador todavia necesita tipear el valor), solo\r\n// se omite el bloque de flechitas. Sin este parametro (el 99% de los\r\n// casos, todo modulo salvo scoreboard/Argentina) el comportamiento es\r\n// exactamente el de siempre.\r\nexport function renderFields(container, fields, data, onDirty, { hideAdjustFor } = {}) {\r\n  function rerender() {\r\n    renderFields(container, fields, data, onDirty, { hideAdjustFor });\r\n  }\r\n\r\n  container.innerHTML = '';\r\n\r\n  for (const field of fields) {\r\n    const adjustHidden = hideAdjustFor?.has(field.key);\r\n    if (adjustHidden && field.type === FIELD_TYPES.ADJUST_ONLY) continue;\r\n\r\n    const wrap = document.createElement('div');\r\n    // \"field-<key>\" (2026-08-28, pedido explicito del usuario: ocultar\r\n    // controles de color SOLO para Argentina Streamers, sin tocar GLA ni\r\n    // borrar el campo/dato) -- clase generica y reusable para que\r\n    // master.css pueda ocultar un campo puntual con\r\n    // \"body[data-theme='...'] .field-<key> { display:none; }\" sin togear\r\n    // nada a nivel de logica/render aca.\r\n    wrap.className = `field field-${field.key}`;\r\n\r\n    const label = document.createElement('label');\r\n    label.textContent = field.label;\r\n    wrap.appendChild(label);\r\n\r\n    if (field.type === FIELD_TYPES.TEXT) {\r\n      const input = document.createElement('input');\r\n      input.type = 'text';\r\n      input.value = data[field.key] ?? '';\r\n      input.addEventListener('input', () => {\r\n        data[field.key] = input.value;\r\n        onDirty();\r\n      });\r\n      wrap.appendChild(input);\r\n\r\n      // \"adjustable\" (2026-08-14, pedido explicito del usuario): campos de\r\n      // texto que ademas de tipear el texto pueden ajustarse en X/Y/tama\u00F1o\r\n      // con flechitas, sin tocar codigo.\r\n      if (field.adjustable && !adjustHidden) {\r\n        mountAdjustControl(wrap, data, field.key, onDirty);\r\n      }\r\n    } else if (field.type === FIELD_TYPES.ADJUST_ONLY) {\r\n      // Texto visible en Program que no se tipea aca (viene del Marcador,\r\n      // de un reloj en vivo, o es un rotulo fijo del asset/dise\u00F1o) pero\r\n      // igual tiene que poder ajustarse en posicion/tama\u00F1o (2026-08-15,\r\n      // auditoria completa pedida por el usuario). Sin input: solo la\r\n      // etiqueta (ya agregada arriba) + el control de ajuste.\r\n      mountAdjustControl(wrap, data, field.key, onDirty);\r\n    } else if (field.type === FIELD_TYPES.TEXTAREA) {\r\n      const textarea = document.createElement('textarea');\r\n      textarea.rows = 3;\r\n      textarea.value = data[field.key] ?? '';\r\n      textarea.addEventListener('input', () => {\r\n        data[field.key] = textarea.value;\r\n        onDirty();\r\n      });\r\n      wrap.appendChild(textarea);\r\n    } else if (field.type === FIELD_TYPES.SELECT) {\r\n      const select = document.createElement('select');\r\n      const currentValue = data[field.key] ?? '';\r\n      for (const opt of field.options) {\r\n        // \"visible\" (2026-09-26, MOSTRAR/OCULTAR EQUIPOS -- ver\r\n        // shared/teams.js): generico, no especifico de equipos -- cualquier\r\n        // \"options\" con \"visible:false\" en una entrada la salta aca, salvo\r\n        // que sea el valor YA seleccionado (pedido explicito: \"no romper\r\n        // ese estado, simplemente evitar ofrecerlo en nuevas selecciones\").\r\n        if (opt.visible === false && opt.id !== currentValue) continue;\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        select.appendChild(option);\r\n      }\r\n      select.value = currentValue;\r\n      select.addEventListener('change', () => {\r\n        data[field.key] = select.value;\r\n        onDirty();\r\n      });\r\n      wrap.appendChild(select);\r\n    } else if (field.type === FIELD_TYPES.LIST) {\r\n      wrap.appendChild(buildListEditor(field, data, onDirty, rerender));\r\n    } else if (field.type === FIELD_TYPES.PENALTY_SERIES) {\r\n      wrap.appendChild(buildPenaltyEditor(field, data, onDirty, rerender));\r\n    }\r\n\r\n    container.appendChild(wrap);\r\n  }\r\n}\r\n\r\nfunction buildListEditor(field, data, onDirty, rerender) {\r\n  const box = document.createElement('div');\r\n  box.className = 'list-editor';\r\n  const items = data[field.key];\r\n\r\n  items.forEach((item, index) => {\r\n    const row = document.createElement('div');\r\n    row.className = 'list-row';\r\n\r\n    for (const sub of field.itemFields) {\r\n      const input = document.createElement('input');\r\n      input.type = 'text';\r\n      input.placeholder = sub.label;\r\n      input.value = item[sub.key] ?? '';\r\n      input.addEventListener('input', () => {\r\n        item[sub.key] = input.value;\r\n        onDirty();\r\n      });\r\n      row.appendChild(input);\r\n    }\r\n\r\n    const removeBtn = document.createElement('button');\r\n    removeBtn.type = 'button';\r\n    removeBtn.className = 'btn-remove';\r\n    removeBtn.textContent = '\u2715';\r\n    removeBtn.addEventListener('click', () => {\r\n      items.splice(index, 1);\r\n      onDirty();\r\n      rerender();\r\n    });\r\n    row.appendChild(removeBtn);\r\n\r\n    box.appendChild(row);\r\n  });\r\n\r\n  const addBtn = document.createElement('button');\r\n  addBtn.type = 'button';\r\n  addBtn.className = 'btn-add';\r\n  addBtn.textContent = `+ Agregar ${field.itemLabel || 'item'}`;\r\n  addBtn.addEventListener('click', () => {\r\n    const blank = {};\r\n    for (const sub of field.itemFields) blank[sub.key] = '';\r\n    items.push(blank);\r\n    onDirty();\r\n    rerender();\r\n  });\r\n  box.appendChild(addBtn);\r\n\r\n  return box;\r\n}\r\n\r\nfunction buildPenaltyEditor(field, data, onDirty, rerender) {\r\n  const box = document.createElement('div');\r\n  box.className = 'penalty-editor';\r\n  const kicks = data[field.key];\r\n\r\n  kicks.forEach((kick, index) => {\r\n    const btn = document.createElement('button');\r\n    btn.type = 'button';\r\n    btn.className = `kick-btn kick-${kick.status}`;\r\n    btn.textContent = `${index + 1}: ${KICK_LABEL[kick.status]}`;\r\n    btn.addEventListener('click', () => {\r\n      kick.status = KICK_CYCLE[(KICK_CYCLE.indexOf(kick.status) + 1) % KICK_CYCLE.length];\r\n      onDirty();\r\n      rerender();\r\n    });\r\n    box.appendChild(btn);\r\n  });\r\n\r\n  return box;\r\n}\r\n","http://localhost:4430/master-control/js/formation-list-panel.js","import { formatPlayer, normalizePlayers, parsePlayer } from '../../shared/player-lists.js';\r\nimport { teamName } from '../../shared/teams.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID, getThemeAsset } from '../../shared/themes.js';\r\nimport { mountAdjustControl } from './field-editors.js';\r\nimport { renderCompositionControl } from './composition-control.js';\r\n\r\n// GLA conserva 6 (asset original, sin cambios). Argentina Streamers pasa a\r\n// 11 titulares (2026-09-03, pedido explicito: \"una formacion de futbol\r\n// tiene que permitir 11 titulares\") -- mismo criterio ya usado en esta\r\n// funcion para \"CAMISETAS / FORMACI\u00D3N EQUIPO\" (linea ~153, chequeo directo\r\n// de \"document.body.dataset.theme\"), sin depender de recargar la pagina.\r\nfunction getStarterLimit() {\r\n  return document.body.dataset.theme === ARGENTINA_STREAMERS_THEME_ID ? 11 : 6;\r\n}\r\n\r\nconst SIDES = [\r\n  { id: 'local', label: 'LOCAL' },\r\n  { id: 'visitor', label: 'VISITANTE' },\r\n];\r\n\r\n// Mismo criterio de normalizaci\u00F3n que server/playerRosters.js (sin\r\n// acentos/may\u00FAsculas/espacios de m\u00E1s) para comparar \"\u00BFeste jugador del\r\n// plantel ya est\u00E1 entre los titulares?\" sin duplicar la l\u00F3gica del\r\n// servidor ni depender de una llamada de red extra.\r\nfunction normalizePlayerKey(value) {\r\n  return String(value || '')\r\n    .normalize('NFD').replace(/[\u0300-\u036F]/g, '')\r\n    .toLowerCase().trim().replace(/\\s+/g, ' ');\r\n}\r\n\r\nfunction ensurePresetsShape(data) {\r\n  if (!data.presets || typeof data.presets !== 'object') {\r\n    data.presets = { local: { starters: [], substitutes: [] }, visitor: { starters: [], substitutes: [] } };\r\n  }\r\n  for (const s of ['local', 'visitor']) {\r\n    if (!data.presets[s] || typeof data.presets[s] !== 'object') {\r\n      data.presets[s] = { starters: [], substitutes: [] };\r\n    }\r\n  }\r\n}\r\n\r\n// Panel dedicado de Formacion. Ademas de editar titulares/suplentes (como\r\n// ya hacia), ahora tambien es due\u00F1o del selector LOCAL/VISITANTE: se saco\r\n// del editor generico de campos (ver \"fields: []\" en shared/modules.js)\r\n// porque cambiar de equipo necesita logica propia -- cargar el preset del\r\n// otro equipo, y si el modulo esta al aire, disparar la secuencia\r\n// OUT -> esperar el fin real de la salida -> TAKE (ver\r\n// handleFormationSideChange en master-control/js/main.js, que decide esa\r\n// logica y es quien pasa el parametro \"side\" aca; este panel solo pinta\r\n// el estado que le llega y avisa clicks via \"side.onSelectSide\").\r\n//\r\n// \"starters\"/\"substitutes\" en el nivel superior de \"data\" son SIEMPRE el\r\n// contenido activo (lo que Program realmente renderiza, sin cambios en su\r\n// contrato). Este panel los deja referenciando el MISMO arreglo que\r\n// \"data.presets[data.teamSide]\" desde el montaje: como todas las\r\n// ediciones (agregar/quitar/reordenar/tipear, ver buildSection) mutan ese\r\n// arreglo en el lugar (splice/push/asignacion por indice) en vez de\r\n// reemplazarlo, quedan escritas automaticamente en el preset del equipo\r\n// activo sin necesitar sincronizacion manual en cada tecla.\r\nexport function renderFormationListPanel(container, data, scoreboardData, onDirty, side) {\r\n  data.starters = normalizePlayers(data.starters);\r\n  data.substitutes = normalizePlayers(data.substitutes);\r\n  ensurePresetsShape(data);\r\n\r\n  const activeSide = data.teamSide === 'visitor' ? 'visitor' : 'local';\r\n  const teamId = activeSide === 'visitor' ? scoreboardData?.teamB : scoreboardData?.teamA;\r\n  const activeTeamName = teamName(teamId) || (activeSide === 'visitor' ? 'VISITANTE' : 'LOCAL');\r\n  data.presets[activeSide].starters = data.starters;\r\n  data.presets[activeSide].substitutes = data.substitutes;\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'formation-editor';\r\n  container.appendChild(root);\r\n  let rosterSnapshot = null;\r\n  let rosterStatus = null;\r\n  let disposed = false;\r\n\r\n  async function loadRoster() {\r\n    if (!teamId) return;\r\n    try {\r\n      const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}`);\r\n      const body = await response.json().catch(() => null);\r\n      if (response.ok && body?.ok) rosterSnapshot = body.snapshot;\r\n    } catch {\r\n      // El modo manual sigue operativo sin snapshot.\r\n    }\r\n    if (!disposed) render();\r\n  }\r\n\r\n  async function syncRoster() {\r\n    rosterStatus = { kind: 'loading', text: 'Actualizando...' };\r\n    render();\r\n    try {\r\n      const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}/sync-web`, { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      rosterSnapshot = body.snapshot;\r\n      rosterStatus = { kind: 'success', text: 'PLANTEL ACTUALIZADO' };\r\n    } catch (error) {\r\n      rosterStatus = { kind: 'error', text: 'ERROR AL ACTUALIZAR', detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  // \"AGREGAR NOMBRE MANUALMENTE... agregarlo autom\u00E1ticamente al roster\r\n  // central\" (BLOQUE 3, secci\u00F3n 10, pedido explicito del usuario): cuando\r\n  // el operador escribe un jugador PERSONALIZADO en Formaci\u00F3n (no viene\r\n  // del desplegable del plantel), ese nombre se suma tambien al plantel\r\n  // central del equipo -- server/playerRosters.js ya deduplica por nombre\r\n  // normalizado (sin acentos/may\u00FAsculas/espacios de m\u00E1s), asi que llamar\r\n  // esto con un jugador que YA existe en el plantel es un no-op seguro\r\n  // (nunca crea un duplicado ni pisa el jugador real ya cargado).\r\n  async function addManualToRoster(player) {\r\n    if (!teamId || !player?.name?.trim()) return;\r\n    try {\r\n      const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}/jugadores`, {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ dorsal: player.number || '', nombre: player.name }),\r\n      });\r\n      const body = await response.json().catch(() => null);\r\n      if (response.ok && body?.ok) {\r\n        rosterSnapshot = body.snapshot;\r\n        if (!disposed) render();\r\n      }\r\n    } catch {\r\n      // Sin red: el jugador queda igual en Formaci\u00F3n, solo no se propaga\r\n      // al plantel central hasta el proximo guardado/sync exitoso.\r\n    }\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n    const transitioning = Boolean(side && side.transitioning);\r\n\r\n    const tabs = document.createElement('div');\r\n    tabs.className = 'formation-side-tabs';\r\n    for (const opt of SIDES) {\r\n      const tab = document.createElement('button');\r\n      tab.type = 'button';\r\n      tab.className = 'formation-side-tab';\r\n      tab.classList.toggle('active', activeSide === opt.id);\r\n      tab.textContent = opt.label;\r\n      tab.disabled = transitioning;\r\n      tab.addEventListener('click', () => {\r\n        if (opt.id === activeSide || transitioning) return;\r\n        side?.onSelectSide?.(opt.id);\r\n      });\r\n      tabs.appendChild(tab);\r\n    }\r\n    root.appendChild(tabs);\r\n\r\n    const rosterHeading = document.createElement('p');\r\n    rosterHeading.className = 'formation-limit-note';\r\n    rosterHeading.textContent = `PLANTEL ${activeSide === 'visitor' ? 'VISITANTE' : 'LOCAL'} \u2014 ${activeTeamName}`;\r\n    root.appendChild(rosterHeading);\r\n    const syncRow = document.createElement('div');\r\n    syncRow.className = 'performance-sync';\r\n    const syncButton = document.createElement('button');\r\n    syncButton.type = 'button';\r\n    syncButton.className = 'performance-sync-btn';\r\n    syncButton.textContent = 'ACTUALIZAR PLANTILLA DESDE WEB';\r\n    syncButton.disabled = !teamId || rosterStatus?.kind === 'loading' || transitioning;\r\n    syncButton.addEventListener('click', syncRoster);\r\n    syncRow.appendChild(syncButton);\r\n    if (rosterStatus) {\r\n      const status = document.createElement('span');\r\n      status.className = `performance-sync-status ${rosterStatus.kind}`;\r\n      status.textContent = rosterStatus.text;\r\n      if (rosterStatus.detail) status.title = rosterStatus.detail;\r\n      syncRow.appendChild(status);\r\n    }\r\n    root.appendChild(syncRow);\r\n\r\n    if (transitioning) {\r\n      const note = document.createElement('p');\r\n      note.className = 'formation-transition-note';\r\n      const label = SIDES.find((s) => s.id === side.pendingSide)?.label || '';\r\n      note.textContent = `Cambiando a ${label}: esperando que termine la animaci\u00F3n de salida antes de cargar el nuevo preset\u2026`;\r\n      root.appendChild(note);\r\n    }\r\n\r\n    const starterLimit = getStarterLimit();\r\n    root.appendChild(buildSection({\r\n      title: 'LISTA FORMACI\u00D3N',\r\n      key: 'starters',\r\n      addLabel: 'Agregar titular',\r\n      limit: starterLimit,\r\n      limitText: `El asset dispone de ${starterLimit} posiciones de titulares.`,\r\n      disabled: transitioning,\r\n    }));\r\n    root.appendChild(buildSection({\r\n      title: 'LISTA DE SUPLENTES',\r\n      key: 'substitutes',\r\n      addLabel: 'Agregar suplente',\r\n      disabled: transitioning,\r\n    }));\r\n    if (document.body.dataset.theme === ARGENTINA_STREAMERS_THEME_ID) {\r\n      root.appendChild(buildFormationKitSection());\r\n      // \"ESCUDO\" por equipo (2026-09-04): SOLO Argentina Streamers -- pedido\r\n      // explicito de esta tarea es puntual a este theme, y la regla\r\n      // absoluta de la sesion es \"no tocar GLA\" (ni su interfaz). GLA sigue\r\n      // exactamente con el acordeon generico de siempre para el escudo\r\n      // (adjust-registry.js ya no tiene \"crest\" para este modulo, pero el\r\n      // acordeon generico de main.js simplemente no muestra nada si no hay\r\n      // entradas -- GLA no pierde ningun control real: su escudo nunca tuvo\r\n      // ajuste propio antes de esta tarea tampoco, ver historial del\r\n      // archivo).\r\n      root.appendChild(buildCrestSection());\r\n    }\r\n    root.appendChild(buildAdjustSection());\r\n  }\r\n\r\n  // ESCUDO por equipo (2026-09-04, pedido explicito del usuario: \"guardar\r\n  // posicion independiente del escudo segun el equipo seleccionado\").\r\n  // Mismo patron que \"buildFormationKitSection\" arriba (dataPath por\r\n  // teamId, sin \"local\"/\"away\" -- el modulo solo muestra un equipo a la\r\n  // vez), pero con una diferencia clave: la posicion actual del escudo\r\n  // (data.crestOffsetX/Y/Scale, YA acomodada por el usuario) es el\r\n  // fallback que usa el renderer para cualquier equipo sin entrada propia\r\n  // (ver program/js/renderers/formacionEquipos.js) -- si esta seccion\r\n  // sembrara 0/0/1 como \"buildFormationKitSection\" hace para las\r\n  // camisetas, guardar sin tocar las flechas correria el escudo a 0/0/1\r\n  // para ese equipo. Se siembra en cambio desde el valor plano actual, asi\r\n  // \"GUARDAR POSICI\u00D3N\" sin mover nada no cambia nada visualmente.\r\n  function buildCrestSection() {\r\n    const section = document.createElement('section');\r\n    section.className = 'formation-list-section';\r\n    const heading = document.createElement('h2');\r\n    heading.textContent = 'ESCUDO';\r\n    section.appendChild(heading);\r\n\r\n    if (!teamId) {\r\n      const pending = document.createElement('p');\r\n      pending.className = 'formation-limit-note';\r\n      pending.textContent = 'ESCUDO: sin equipo seleccionado en el Marcador.';\r\n      section.appendChild(pending);\r\n      return section;\r\n    }\r\n\r\n    if (!data.crestByTeam || typeof data.crestByTeam !== 'object') {\r\n      data.crestByTeam = {};\r\n    }\r\n    if (!data.crestByTeam[teamId] || typeof data.crestByTeam[teamId] !== 'object') {\r\n      data.crestByTeam[teamId] = {\r\n        crestOffsetX: data.crestOffsetX || 0,\r\n        crestOffsetY: data.crestOffsetY || 0,\r\n        crestScale: data.crestScale ?? 1,\r\n      };\r\n    }\r\n    const note = document.createElement('p');\r\n    note.className = 'formation-limit-note';\r\n    note.textContent = `${activeTeamName} \u2014 posici\u00F3n y escala propias por equipo. Mientras no guardes una espec\u00EDfica, usa la posici\u00F3n actual del escudo.`;\r\n    section.appendChild(note);\r\n    const control = document.createElement('div');\r\n    section.appendChild(control);\r\n    renderCompositionControl(control, data.crestByTeam[teamId], onDirty, {\r\n      title: '',\r\n      note: '',\r\n      keys: { xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n      ...(side?.saveOptions || {}),\r\n      elementSpec: {\r\n        kind: 'composition',\r\n        dataPath: ['crestByTeam', teamId],\r\n        xKey: 'crestOffsetX',\r\n        yKey: 'crestOffsetY',\r\n        scaleKey: 'crestScale',\r\n      },\r\n    });\r\n    return section;\r\n  }\r\n\r\n  function buildFormationKitSection() {\r\n    const section = document.createElement('section');\r\n    section.className = 'formation-list-section';\r\n    const heading = document.createElement('h2');\r\n    heading.textContent = 'CAMISETAS / FORMACI\u00D3N EQUIPO';\r\n    section.appendChild(heading);\r\n\r\n    const assetPath = getThemeAsset(ARGENTINA_STREAMERS_THEME_ID, 'formacionEquipos')\r\n      ?.formationAssetsByTeam?.[teamId];\r\n    if (!teamId || !assetPath) {\r\n      const pending = document.createElement('p');\r\n      pending.className = 'formation-limit-note';\r\n      pending.textContent = 'CAMISETA / FORMACI\u00D3N DEL EQUIPO: ASSET PENDIENTE';\r\n      section.appendChild(pending);\r\n      return section;\r\n    }\r\n\r\n    if (!data.formationKitByTeam || typeof data.formationKitByTeam !== 'object') {\r\n      data.formationKitByTeam = {};\r\n    }\r\n    if (!data.formationKitByTeam[teamId] || typeof data.formationKitByTeam[teamId] !== 'object') {\r\n      data.formationKitByTeam[teamId] = { offsetX: 0, offsetY: 0, scale: 1 };\r\n    }\r\n    const note = document.createElement('p');\r\n    note.className = 'formation-limit-note';\r\n    note.textContent = `${activeTeamName} \u2014 posici\u00F3n y escala propias por teamId.`;\r\n    section.appendChild(note);\r\n    const control = document.createElement('div');\r\n    section.appendChild(control);\r\n    renderCompositionControl(control, data.formationKitByTeam[teamId], onDirty, {\r\n      title: '',\r\n      note: '',\r\n      keys: { xKey: 'offsetX', yKey: 'offsetY', scaleKey: 'scale' },\r\n      ...(side?.saveOptions || {}),\r\n      elementSpec: {\r\n        kind: 'composition',\r\n        dataPath: ['formationKitByTeam', teamId],\r\n        xKey: 'offsetX',\r\n        yKey: 'offsetY',\r\n        scaleKey: 'scale',\r\n      },\r\n    });\r\n    return section;\r\n  }\r\n\r\n  // \"AJUSTE DE TEXTOS\" (2026-08-15, auditoria completa): \"playerName\"/\r\n  // \"playerNumber\" se aplican por igual a las 6 posiciones de titulares\r\n  // (misma clase CSS en el asset, ver program/js/renderers/\r\n  // formacionEquipos.js) -- un unico control por columna, mismo criterio\r\n  // que las tablas dinamicas (Posiciones/Resultados/Goleadores). \"subsTitle\"\r\n  // es el rotulo fijo \"SUPLENTES\" y \"subsList\" es el bloque completo de la\r\n  // lista de suplentes (posicion + tama\u00F1o de toda la lista/marquesina).\r\n  function buildAdjustSection() {\r\n    const section = document.createElement('section');\r\n    section.className = 'formation-list-section';\r\n    const heading = document.createElement('h2');\r\n    heading.textContent = 'AJUSTE DE TEXTOS';\r\n    section.appendChild(heading);\r\n    const starterLimit = getStarterLimit();\r\n    const note = document.createElement('p');\r\n    note.className = 'formation-limit-note';\r\n    note.textContent = `\"Nombre titular\" y \"N\u00FAmero\" ajustan las ${starterLimit} posiciones a la vez (comparten la misma clase visual en el asset).`;\r\n    section.appendChild(note);\r\n\r\n    for (const { key, label } of [\r\n      { key: 'playerName', label: `Nombre titular (las ${starterLimit} posiciones)` },\r\n      { key: 'playerNumber', label: `N\u00FAmero (las ${starterLimit} posiciones)` },\r\n      { key: 'subsTitle', label: 'T\u00EDtulo \"SUPLENTES\"' },\r\n      { key: 'subsList', label: 'Bloque lista de suplentes' },\r\n    ]) {\r\n      const wrap = document.createElement('div');\r\n      wrap.className = 'field';\r\n      const lbl = document.createElement('label');\r\n      lbl.textContent = label;\r\n      wrap.appendChild(lbl);\r\n      mountAdjustControl(wrap, data, key, onDirty, side && side.saveOptions);\r\n      section.appendChild(wrap);\r\n    }\r\n    return section;\r\n  }\r\n\r\n  function buildSection({ title, key, addLabel, limit, limitText, disabled }) {\r\n    const section = document.createElement('section');\r\n    section.className = 'formation-list-section';\r\n\r\n    const heading = document.createElement('h2');\r\n    heading.textContent = title;\r\n    section.appendChild(heading);\r\n\r\n    const items = data[key];\r\n    // \"usedJugadorIds\" (2026-09-10, pedido explicito del usuario, item 13:\r\n    // \"un mismo jugador no puede ocupar dos posiciones titulares\r\n    // simultaneamente... usar el identificador estable, no solo el texto\r\n    // visible\"). Solo se exige para TITULARES (\"starters\") -- el pedido no\r\n    // menciona suplentes, y un jugador manual (sin jugadorId, texto tipeado\r\n    // a mano) nunca entra en este chequeo por id -- no hay forma confiable\r\n    // de saber si dos textos distintos son \"la misma persona\".\r\n    const rosterPlayers = rosterSnapshot?.jugadores || [];\r\n    for (const row of buildPlayerRows({\r\n      items, key, title, disabled, rosterPlayers,\r\n      onDirty, render, addManualToRoster,\r\n    })) section.appendChild(row);\r\n\r\n    const rosterSelect = document.createElement('select');\r\n    rosterSelect.setAttribute('aria-label', `${title}, jugador del plantel`);\r\n    const emptyOption = document.createElement('option');\r\n    emptyOption.value = '';\r\n    emptyOption.textContent = 'JUGADOR DEL PLANTEL';\r\n    rosterSelect.appendChild(emptyOption);\r\n    // Duplicados tambien en el ALTA (2026-09-10, mismo pedido item 13): un\r\n    // jugador ya titular no deberia poder agregarse OTRA VEZ desde este\r\n    // select -- <option disabled> SI es confiable entre navegadores (a\r\n    // diferencia del COLOR, ver renderPlayerDropdown mas abajo), asi que\r\n    // alcanza con el atributo nativo aca, sin reconstruir este control.\r\n    const usedIdsForAdd = key === 'starters' ? new Set(items.map((p) => p.jugadorId).filter(Boolean)) : new Set();\r\n    for (const player of rosterPlayers) {\r\n      const option = document.createElement('option');\r\n      option.value = player.id;\r\n      option.textContent = usedIdsForAdd.has(player.id) ? `${player.nombreTV} (ya titular)` : player.nombreTV;\r\n      option.disabled = usedIdsForAdd.has(player.id);\r\n      rosterSelect.appendChild(option);\r\n    }\r\n    rosterSelect.disabled = disabled || !rosterPlayers.length || Boolean(limit && items.length >= limit);\r\n    section.appendChild(rosterSelect);\r\n\r\n    const addRoster = document.createElement('button');\r\n    addRoster.type = 'button';\r\n    addRoster.className = 'btn-add formation-add';\r\n    addRoster.textContent = '+ AGREGAR JUGADOR DEL PLANTEL';\r\n    addRoster.disabled = rosterSelect.disabled;\r\n    addRoster.addEventListener('click', () => {\r\n      const selected = rosterPlayers.find((p) => p.id === rosterSelect.value);\r\n      if (!selected) return;\r\n      items.push({ ...parsePlayer(selected.nombreTV), jugadorId: selected.id });\r\n      onDirty();\r\n      render();\r\n    });\r\n    section.appendChild(addRoster);\r\n\r\n    const add = document.createElement('button');\r\n    add.type = 'button';\r\n    add.className = 'btn-add formation-add';\r\n    add.textContent = `+ PERSONALIZADO / ESCRIBIR NOMBRE (${addLabel})`;\r\n    add.disabled = disabled || Boolean(limit && items.length >= limit);\r\n    add.addEventListener('click', () => {\r\n      items.push({ number: '', name: '', jugadorId: '' });\r\n      onDirty();\r\n      render();\r\n      // \"section\" quedo desmontado por el \"render()\" de arriba (reconstruye\r\n      // TODA la raiz, ver \"root.innerHTML=''\" mas abajo) -- hay que buscar\r\n      // la nueva fila en el DOM real (root), no en la referencia vieja.\r\n      const triggers = root.querySelectorAll('.player-dropdown-trigger');\r\n      triggers[triggers.length - 1]?.click();\r\n    });\r\n    section.appendChild(add);\r\n\r\n    // \"SUPLENTES = PLANTEL - TITULARES\" (BLOQUE 3, secci\u00F3n 12, pedido\r\n    // explicito del usuario: \"los jugadores del roster que no est\u00E1n entre\r\n    // los 11 titulares deben quedar disponibles autom\u00E1ticamente como\r\n    // SUPLENTES... no quiero volver a cargar manualmente todos los\r\n    // suplentes\"). Solo en la secci\u00F3n de suplentes (sin \"limit\"): un click\r\n    // reemplaza la lista de suplentes por TODO el plantel que no est\u00E1 ya\r\n    // en titulares -- accion explicita (no automatica en cada tecla) para\r\n    // que el operador pueda ajustar a mano despues sin que se le pise solo.\r\n    if (key === 'substitutes' && rosterSnapshot?.jugadores?.length) {\r\n      const autoFill = document.createElement('button');\r\n      autoFill.type = 'button';\r\n      autoFill.className = 'btn-add formation-add';\r\n      autoFill.textContent = 'SUPLENTES = RESTO DEL PLANTEL';\r\n      autoFill.disabled = disabled;\r\n      autoFill.addEventListener('click', () => {\r\n        // Excluye por \"jugadorId\" cuando el titular vino del plantel (mas\r\n        // confiable, ver item 13) y por nombre normalizado para titulares\r\n        // tipeados a mano (sin id posible) -- mismo criterio dual.\r\n        const startersIds = new Set(data.starters.map((p) => p.jugadorId).filter(Boolean));\r\n        const startersKeys = new Set(data.starters.map((p) => normalizePlayerKey(formatPlayer(p))));\r\n        const remaining = rosterSnapshot.jugadores\r\n          .filter((p) => !startersIds.has(p.id) && !startersKeys.has(normalizePlayerKey(p.nombreTV)))\r\n          .map((p) => ({ ...parsePlayer(p.nombreTV), jugadorId: p.id }));\r\n        data.substitutes.length = 0;\r\n        data.substitutes.push(...remaining);\r\n        onDirty();\r\n        render();\r\n      });\r\n      section.appendChild(autoFill);\r\n    }\r\n\r\n    if (limitText) {\r\n      const note = document.createElement('p');\r\n      note.className = 'formation-limit-note';\r\n      note.textContent = limitText;\r\n      section.appendChild(note);\r\n    }\r\n    if (limit) {\r\n      const limitStatus = document.createElement('p');\r\n      limitStatus.className = 'formation-limit-note';\r\n      if (items.length >= limit) {\r\n        limitStatus.textContent = `L\u00CDMITE ALCANZADO: ${items.length}/${limit} titulares. No se puede agregar un titular m\u00E1s -- sac\u00E1 uno para agregar otro.`;\r\n        limitStatus.style.color = '#e88';\r\n        limitStatus.style.fontWeight = '700';\r\n      } else {\r\n        limitStatus.textContent = `${items.length}/${limit} titulares cargados.`;\r\n      }\r\n      section.appendChild(limitStatus);\r\n    }\r\n\r\n    return section;\r\n  }\r\n\r\n  // \"buildPlayerRows\" (2026-09-10, pedido explicito del usuario, items\r\n  // 12/13/14/15): cada posicion sigue siendo SIEMPRE un desplegable\r\n  // editable (nunca se transforma en texto fijo tras elegir -- item 12),\r\n  // marca en rojo + deshabilita jugadores ya usados como titulares (items\r\n  // 13/14, ver \"renderPlayerDropdown\" mas abajo) y reemplaza las flechas\r\n  // \u2191/\u2193 por un handle de arrastre con drag & drop nativo (item 15).\r\n  function buildPlayerRows({ items, key, title, disabled, rosterPlayers, onDirty, render, addManualToRoster }) {\r\n    const rows = [];\r\n    items.forEach((player, index) => {\r\n      const row = document.createElement('div');\r\n      row.className = 'formation-player-row';\r\n\r\n      const handle = document.createElement('span');\r\n      handle.className = 'formation-drag-handle';\r\n      handle.textContent = '\u2630';\r\n      handle.title = 'Manten\u00E9 apretado y arrastr\u00E1 para reordenar';\r\n      handle.setAttribute('aria-label', `${title}, jugador ${index + 1}, arrastrar para reordenar`);\r\n      handle.draggable = !disabled;\r\n      row.appendChild(handle);\r\n\r\n      // \"usedJugadorIds\" recalculado por FILA (no una sola vez para toda la\r\n      // seccion): el propio jugador de ESTA fila nunca debe verse marcado\r\n      // como \"usado\" en su propio desplegable (podria seguir siendo el\r\n      // mismo sin problema), solo los usados en OTRAS posiciones.\r\n      const usedJugadorIds = key === 'starters'\r\n        ? new Set(items.filter((p, i) => i !== index).map((p) => p.jugadorId).filter(Boolean))\r\n        : new Set();\r\n\r\n      const dropdownContainer = document.createElement('div');\r\n      dropdownContainer.className = 'formation-dropdown-container';\r\n      row.appendChild(dropdownContainer);\r\n      renderPlayerDropdown(dropdownContainer, {\r\n        player,\r\n        ariaLabel: `${title}, jugador ${index + 1}`,\r\n        rosterPlayers,\r\n        usedJugadorIds,\r\n        disabled,\r\n        onSelect: (newPlayer) => {\r\n          items[index] = newPlayer;\r\n          onDirty();\r\n          addManualToRoster(newPlayer);\r\n          render();\r\n        },\r\n      });\r\n\r\n      row.appendChild(actionButton('\u00D7', 'Eliminar', disabled, () => {\r\n        items.splice(index, 1);\r\n        onDirty();\r\n        render();\r\n      }, 'remove'));\r\n\r\n      handle.addEventListener('dragstart', (e) => {\r\n        e.dataTransfer.effectAllowed = 'move';\r\n        e.dataTransfer.setData('text/plain', String(index));\r\n        row.classList.add('is-dragging');\r\n      });\r\n      handle.addEventListener('dragend', () => row.classList.remove('is-dragging'));\r\n      row.addEventListener('dragover', (e) => {\r\n        if (disabled) return;\r\n        e.preventDefault();\r\n        e.dataTransfer.dropEffect = 'move';\r\n        row.classList.add('is-drop-target');\r\n      });\r\n      row.addEventListener('dragleave', () => row.classList.remove('is-drop-target'));\r\n      row.addEventListener('drop', (e) => {\r\n        e.preventDefault();\r\n        row.classList.remove('is-drop-target');\r\n        if (disabled) return;\r\n        const fromIndex = parseInt(e.dataTransfer.getData('text/plain'), 10);\r\n        if (Number.isNaN(fromIndex) || fromIndex === index) return;\r\n        const [moved] = items.splice(fromIndex, 1);\r\n        items.splice(index, 0, moved);\r\n        onDirty();\r\n        render();\r\n      });\r\n\r\n      rows.push(row);\r\n    });\r\n    return rows;\r\n  }\r\n\r\n  // \"renderPlayerDropdown\" (2026-09-10, pedido explicito del usuario, item\r\n  // 14: \"investig\u00E1 cu\u00E1l es la forma m\u00E1s fiable de estilizar opciones del\r\n  // select en los navegadores que utilizamos... si el <select><option>\r\n  // nativo no permite garantizar el color rojo de forma consistente,\r\n  // implement\u00E1 un selector custom\"). El color de un <option> nativo NO se\r\n  // puede fijar de forma confiable entre Chrome/OBS Browser Source/vMix\r\n  // Browser Input -- el motor de renderizado del propio sistema operativo\r\n  // dibuja el popup nativo, ignorando el CSS del documento en varios de\r\n  // esos casos -- asi que esto reemplaza <select> por un boton + panel con\r\n  // <div> reales: control total del color/disabled de cada fila. Sigue\r\n  // siendo SIEMPRE el mismo control (nunca se destruye tras elegir, item\r\n  // 12): \"onSelect\" reemplaza el jugador de la fila sin tocar el resto de\r\n  // la lista.\r\n  function renderPlayerDropdown(container, { player, ariaLabel, rosterPlayers, usedJugadorIds, disabled, onSelect }) {\r\n    container.innerHTML = '';\r\n    const trigger = document.createElement('button');\r\n    trigger.type = 'button';\r\n    trigger.className = 'player-dropdown-trigger';\r\n    trigger.textContent = (player.number || player.name) ? formatPlayer(player) : 'Seleccionar jugador\u2026';\r\n    trigger.setAttribute('aria-label', ariaLabel);\r\n    trigger.disabled = disabled;\r\n    container.appendChild(trigger);\r\n\r\n    let panel = null;\r\n    function closePanel() {\r\n      if (!panel) return;\r\n      panel.remove();\r\n      panel = null;\r\n      document.removeEventListener('mousedown', onOutsideClick, true);\r\n    }\r\n    function onOutsideClick(e) {\r\n      if (panel && !panel.contains(e.target) && e.target !== trigger) closePanel();\r\n    }\r\n    function openPanel() {\r\n      panel = document.createElement('div');\r\n      panel.className = 'player-dropdown-panel';\r\n\r\n      const emptyItem = document.createElement('div');\r\n      emptyItem.className = 'player-dropdown-item player-dropdown-empty';\r\n      emptyItem.textContent = 'SIN ASIGNAR';\r\n      emptyItem.addEventListener('click', () => {\r\n        onSelect({ number: '', name: '', jugadorId: '' });\r\n        closePanel();\r\n      });\r\n      panel.appendChild(emptyItem);\r\n\r\n      for (const rosterPlayer of rosterPlayers) {\r\n        const isUsed = usedJugadorIds.has(rosterPlayer.id);\r\n        const item = document.createElement('div');\r\n        item.className = 'player-dropdown-item' + (isUsed ? ' is-used' : '');\r\n        item.textContent = isUsed ? `${rosterPlayer.nombreTV} (YA TITULAR)` : rosterPlayer.nombreTV;\r\n        if (isUsed) {\r\n          item.setAttribute('aria-disabled', 'true');\r\n        } else {\r\n          item.addEventListener('click', () => {\r\n            onSelect({ ...parsePlayer(rosterPlayer.nombreTV), jugadorId: rosterPlayer.id });\r\n            closePanel();\r\n          });\r\n        }\r\n        panel.appendChild(item);\r\n      }\r\n\r\n      const customItem = document.createElement('div');\r\n      customItem.className = 'player-dropdown-item player-dropdown-custom';\r\n      const customInput = document.createElement('input');\r\n      customInput.type = 'text';\r\n      customInput.placeholder = 'PERSONALIZADO: 19. NOMBRE';\r\n      customInput.value = player.jugadorId ? '' : formatPlayer(player);\r\n      customInput.addEventListener('keydown', (e) => {\r\n        if (e.key !== 'Enter') return;\r\n        e.preventDefault();\r\n        onSelect({ ...parsePlayer(customInput.value), jugadorId: '' });\r\n        closePanel();\r\n      });\r\n      customItem.appendChild(customInput);\r\n      panel.appendChild(customItem);\r\n\r\n      container.appendChild(panel);\r\n      customInput.focus();\r\n      document.addEventListener('mousedown', onOutsideClick, true);\r\n    }\r\n\r\n    trigger.addEventListener('click', () => {\r\n      if (panel) closePanel();\r\n      else openPanel();\r\n    });\r\n  }\r\n\r\n  function actionButton(text, label, disabled, handler, variant = '') {\r\n    const button = document.createElement('button');\r\n    button.type = 'button';\r\n    button.className = `formation-row-action ${variant}`.trim();\r\n    button.textContent = text;\r\n    button.title = label;\r\n    button.setAttribute('aria-label', label);\r\n    button.disabled = disabled;\r\n    button.addEventListener('click', handler);\r\n    return button;\r\n  }\r\n\r\n  render();\r\n  loadRoster();\r\n  return () => { disposed = true; };\r\n}\r\n","http://localhost:4430/master-control/js/short-double-panel.js","// Panel dedicado de Zocalo corto doble (2026-08-06, pedido explicito del\r\n// usuario). Reemplaza al editor generico de campos (ver \"fields: []\" en\r\n// shared/modules.js) porque hay dos operaciones independientes (Z\u00D3CALO\r\n// INDIVIDUAL: 1 instancia, solo nombre; Z\u00D3CALO DOBLE: 2 instancias,\r\n// nombre+sub texto cada una) -- mismo criterio que el panel de Formacion\r\n// (formation-list-panel.js), que tambien tiene su propio control especial.\r\n//\r\n// \"MODO\" (BLOQUE 1, 2026-09-09, pedido explicito del usuario: \"hacer que\r\n// la operacion sea coherente con el resto de LIVE GRAPHICS\"): reemplaza a\r\n// la fila de 3 botones FUERA/AIRE 1 Z\u00D3CALO/AIRE DOBLE que antes disparaba\r\n// TAKE/OUT directo -- ahora es un campo de configuracion mas (igual\r\n// criterio que \"tipo\" en zocaloCompuesto: EQUIPOS/LOGO), que solo decide\r\n// que variante toma el boton EST\u00C1NDAR \"TOMAR AL AIRE\" del header (ya\r\n// funcionaba para este modulo -- ver \"doTake()\" en main.js, que siempre\r\n// mando \"draft.shortDouble\" completo, \"airMode\" incluido). Sin logica de\r\n// TAKE/OUT propia en este panel: mismo patron que el resto de LIVE\r\n// GRAPHICS (elegis el campo, apretas TOMAR AL AIRE/ACTUALIZAR arriba).\r\n//\r\n// \"TALENTOS\" (BLOQUE 1, pedido explicito del usuario: \"el textbox que dice\r\n// talentos, que solo me deje modificar 1 renglon, que es el de nombre\"):\r\n// se elimina el campo \"Rol/Talento\" de la seccion INDIVIDUAL -- esa\r\n// seccion pasa a editar UN solo renglon (Nombre). Los dos pares de Z\u00D3CALO\r\n// DOBLE (que si son 2 renglones reales, nombre+sub texto) no cambian.\r\n// \"data.role\"/sus presets (\"GUARDAR SUB TEXTO\" en main.js) se dejan\r\n// intactos sin tocar -- solo se quita el INPUT de edicion, no el dato ni\r\n// los presets existentes.\r\n//\r\n// \"textField\" ahora acepta un \"adjustKey\" opcional (2026-08-14, pedido\r\n// explicito del usuario) que muestra el mismo control de ajuste\r\n// X/Y/tama\u00F1o que usan los campos genericos via field-editors.js -- este\r\n// panel es dedicado (no pasa por ahi, ver comentario de arriba) asi que\r\n// importa el mismo componente compartido directo en vez de duplicar su\r\n// logica de botones.\r\nimport { renderTextAdjustControl } from './text-adjust-control.js';\r\n\r\nfunction ensureTextAdjust(data, key) {\r\n  if (!data.textAdjust || typeof data.textAdjust !== 'object') data.textAdjust = {};\r\n  if (!data.textAdjust[key] || typeof data.textAdjust[key] !== 'object') {\r\n    data.textAdjust[key] = { dx: 0, dy: 0, dSize: 0 };\r\n  }\r\n  return data.textAdjust[key];\r\n}\r\n\r\nexport function renderShortDoublePanel(container, data, onDirty, saveOptions) {\r\n  if (!data.double1 || typeof data.double1 !== 'object') data.double1 = { name: '', role: '' };\r\n  if (!data.double2 || typeof data.double2 !== 'object') data.double2 = { name: '', role: '' };\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'short-double-editor';\r\n  container.appendChild(root);\r\n\r\n  function textField(labelText, value, onInput, adjustKey) {\r\n    const wrap = document.createElement('div');\r\n    wrap.className = 'field';\r\n    const label = document.createElement('label');\r\n    label.textContent = labelText;\r\n    wrap.appendChild(label);\r\n    const input = document.createElement('input');\r\n    input.type = 'text';\r\n    input.value = value ?? '';\r\n    input.addEventListener('input', () => onInput(input.value));\r\n    wrap.appendChild(input);\r\n    if (adjustKey) {\r\n      renderTextAdjustControl(wrap, ensureTextAdjust(data, adjustKey), onDirty, {\r\n        ...saveOptions,\r\n        elementSpec: { kind: 'text', dataPath: ['textAdjust', adjustKey] },\r\n      });\r\n    }\r\n    return wrap;\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n\r\n    // --- MODO: decide que variante toma el boton estandar TOMAR AL AIRE ---\r\n    const modeSection = document.createElement('section');\r\n    modeSection.className = 'short-double-section';\r\n    const modeHeading = document.createElement('h2');\r\n    modeHeading.textContent = 'MODO';\r\n    modeSection.appendChild(modeHeading);\r\n    const modeWrap = document.createElement('div');\r\n    modeWrap.className = 'field';\r\n    const modeLabel = document.createElement('label');\r\n    modeLabel.textContent = 'Qu\u00E9 toma \"TOMAR AL AIRE\"';\r\n    modeWrap.appendChild(modeLabel);\r\n    const modeSelect = document.createElement('select');\r\n    for (const opt of [\r\n      { id: 'single', label: 'Z\u00D3CALO INDIVIDUAL' },\r\n      { id: 'double', label: 'Z\u00D3CALO DOBLE' },\r\n    ]) {\r\n      const option = document.createElement('option');\r\n      option.value = opt.id;\r\n      option.textContent = opt.label;\r\n      modeSelect.appendChild(option);\r\n    }\r\n    modeSelect.value = data.airMode === 'double' ? 'double' : 'single';\r\n    modeSelect.addEventListener('change', () => { data.airMode = modeSelect.value; onDirty(); });\r\n    modeWrap.appendChild(modeSelect);\r\n    modeSection.appendChild(modeWrap);\r\n    root.appendChild(modeSection);\r\n\r\n    // --- Z\u00D3CALO 1 / Z\u00D3CALO 2 (2026-09-10, pedido explicito del usuario:\r\n    // \"que el z\u00F3calo doble 1 sea el z\u00F3calo individual... que en el panel no\r\n    // me muestre 3 opciones de z\u00F3calo\"). Ya no hay una seccion\r\n    // \"INDIVIDUAL\" con su propio dato aparte -- \"Z\u00D3CALO 1\" (antes \"Z\u00D3CALO\r\n    // DOBLE 1\", ver \"double1\") ES el zocalo individual: si el MODO de\r\n    // arriba es Z\u00D3CALO INDIVIDUAL, TOMAR AL AIRE manda solo esto (ver\r\n    // program/js/renderers/shortDouble.js); si es Z\u00D3CALO DOBLE, manda esto\r\n    // + Z\u00D3CALO 2 juntos. \"Sub texto\" (mismo pedido: \"borrame ese textbox\")\r\n    // se elimina de las dos secciones -- el dato/render de \"role\" sigue\r\n    // existiendo por si el operador ya tenia algo cargado, pero deja de\r\n    // ser editable desde aca. ---\r\n    const doubleGroup = document.createElement('div');\r\n    doubleGroup.className = 'short-double-group';\r\n\r\n    for (const [key, title] of [['double1', 'Z\u00D3CALO 1'], ['double2', 'Z\u00D3CALO 2']]) {\r\n      const section = document.createElement('section');\r\n      section.className = 'short-double-section';\r\n      const heading = document.createElement('h3');\r\n      heading.textContent = title;\r\n      section.appendChild(heading);\r\n      section.appendChild(textField('Texto', data[key].name, (v) => { data[key].name = v; onDirty(); }, `${key}.name`));\r\n      doubleGroup.appendChild(section);\r\n    }\r\n    root.appendChild(doubleGroup);\r\n  }\r\n\r\n  render();\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/grupos-panel.js","import { TEAM_OPTIONS, teamName } from '../../shared/teams.js';\r\nimport { desempateVigente, firmaGrupo, hayEmpate, ordenarGrupo, puntosValue, slotLabel } from '../../shared/grupos-orden.js';\r\nimport { createGlaTorneoSourceNote, glaTorneoLabel } from './gla-torneo-source.js';\r\n// EQUIPOS VISIBLES (2026-10-21, pedido explicito del usuario, SOLO GLA):\r\n// un equipo oculto en EQUIPOS no se ofrece para nuevas selecciones; el ya\r\n// elegido se sigue mostrando (ocultar no borra ni rompe estados guardados).\r\nfunction isHiddenGlaOption(opt, currentId) {\r\n  return document.body.dataset.theme === 'gla' && opt.visible === false && opt.id !== (currentId || '');\r\n}\r\n\r\nimport { mountAdjustControl } from './field-editors.js';\r\n\r\nconst VARIANTS = [\r\n  { id: 'grupo1', label: 'Grupo 1' },\r\n  { id: 'grupo2', label: 'Grupo 2' },\r\n];\r\n\r\n// MODOS (2026-10-23, pedido explicito del usuario, SOLO GLA): MANUAL usa\r\n// \"grupo1\"/\"grupo2\" de siempre (tambien arman los cruces de S\u00C1BADO, que no\r\n// cambian); WEB usa su propio snapshot \"gruposWeb\" (Fase de Grupos de\r\n// Rel\u00E1mpago #4, ver /api/grupos/web-update). Cambiar de modo no copia ni\r\n// borra nada del otro; Program y Preview muestran el modo activo.\r\nconst MODOS_GRUPOS = [\r\n  { id: 'manual', label: 'MANUAL' },\r\n  { id: 'web', label: 'WEB' },\r\n];\r\n// Estadisticas de cada fila (las mismas que publica la tabla web).\r\nconst STAT_FIELDS = [\r\n  { key: 'pj', label: 'PJ' }, { key: 'g', label: 'G' }, { key: 'e', label: 'E' }, { key: 'p', label: 'P' },\r\n  { key: 'gxp', label: 'GXP' }, { key: 'pxp', label: 'PXP' },\r\n  { key: 'gf', label: 'GF' }, { key: 'gc', label: 'GC' }, { key: 'dg', label: 'DG' },\r\n];\r\n\r\nconst POSICIONES = [\r\n  { id: 'placaL', label: 'PLACA L' },\r\n  { id: 'fullscreenDerecha', label: 'FULLSCREEN \u2014 ABAJO DERECHA' },\r\n  { id: 'fullscreenIzquierda', label: 'FULLSCREEN \u2014 ABAJO IZQUIERDA' },\r\n];\r\n\r\n// Panel dedicado (no el editor generico de schema, ver docs/ARCHITECTURE.md):\r\n// el editor generico (field-editors.js) no tiene un tipo de campo que\r\n// combine un SELECT de equipo por fila con una cantidad de filas fija (sin\r\n// agregar/quitar) que ademas cambia segun la variante elegida \u2014 mismo\r\n// criterio que el panel dedicado de Formacion (formation-list-panel.js),\r\n// pero con filas de cantidad fija en vez de lista libre.\r\n//\r\n// Cada variante (grupo1/grupo2) guarda su propio arreglo \"filas\" por\r\n// separado en \"data\" \u2014 son grupos de equipos distintos, cambiar el\r\n// selector no pisa lo cargado en el otro grupo. Escudo y nombre completo\r\n// NUNCA se escriben a mano: se derivan siempre del mismo catalogo de\r\n// equipos que usa el Marcador principal (TEAM_OPTIONS/crestFile/teamName,\r\n// shared/teams.js) a partir del \"teamId\" elegido en el desplegable. El\r\n// orden de exhibicion (mayor a menor puntaje) se calcula solo en Program\r\n// (program/js/renderers/grupos.js) \u2014 este panel edita los datos crudos\r\n// tal como se cargan, sin reordenar filas mientras el operador tipea.\r\n//\r\n// \"posicion\" (2026-07-31): modo de salida. En Placa L se muestran Grupo 1\r\n// y Grupo 2 juntos siempre, asi que el selector de \"Grupo visible\" no\r\n// aplica y se oculta (evita un control redundante/confuso) \u2014 se muestra\r\n// una nota aclarando que van los dos. En los modos fullscreen si aplica,\r\n// porque solo se muestra un grupo por vez.\r\n//\r\n// \"editingGrupo\" es un toggle puramente local del panel (no se persiste,\r\n// no afecta lo que esta al aire): decide que tabla de filas se ve para\r\n// editar en este momento. Existe porque el operador tiene que poder\r\n// cargar/editar AMBOS grupos sin importar el modo de salida elegido (ej.\r\n// preparar el Grupo 2 con anticipacion mientras el modo fullscreen activo\r\n// todavia muestra el Grupo 1).\r\n// \"onLive\" (2026-10-23, GLA): cambios de PUNTOS y de VALIDAR WEB se mandan\r\n// en vivo (Preview y Program reordenan sin ACTUALIZAR); sin \"onLive\" se usa\r\n// onDirty como siempre.\r\nexport function renderGruposPanel(container, data, onDirty, saveOptions, { onLive } = {}) {\r\n  const root = document.createElement('div');\r\n  root.className = 'grupos-editor';\r\n  container.appendChild(root);\r\n  const sendLive = onLive || onDirty;\r\n\r\n  let editingGrupo = data.variante === 'grupo2' ? 'grupo2' : 'grupo1';\r\n  let syncStatus = null;\r\n  // Resultado del ultimo pedido VALIDAR WEB por grupo (solo para el aviso\r\n  // en pantalla; el desempate valido queda en data.desempateWeb).\r\n  const validarStatus = {};\r\n\r\n  // VALIDAR WEB (2026-10-23): orden oficial de Rel\u00E1mpago #4 para el grupo,\r\n  // guardado con la huella de los datos validados (equipos/puntos/slots).\r\n  // Nunca toca los puntos cargados; si la web no tiene datos o algo no se\r\n  // puede asociar, se conserva el orden y la ultima validacion valida.\r\n  async function validarWeb(grupoKey) {\r\n    const filas = data[grupoKey].filas;\r\n    const firma = firmaGrupo(filas);\r\n    validarStatus[grupoKey] = { kind: 'loading', text: 'Consultando gla.futbol (Rel\u00E1mpago #4)...' };\r\n    render();\r\n    try {\r\n      const response = await fetch('/api/grupos/validar-web', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ grupo: grupoKey, teamIds: filas.map((f) => f.teamId || '') }),\r\n      });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) {\r\n        const error = new Error(body?.error || `HTTP ${response.status}`);\r\n        error.sinDatos = !!body?.sinDatos;\r\n        throw error;\r\n      }\r\n      data.desempateWeb = {\r\n        ...(data.desempateWeb && typeof data.desempateWeb === 'object' ? data.desempateWeb : {}),\r\n        [grupoKey]: { orden: body.orden, detalle: body.detalle, firma, validadoEn: body.validadoEn, fuente: `${body.edicion} \u2014 ${body.grupo}` },\r\n      };\r\n      validarStatus[grupoKey] = { kind: 'success', text: `DESEMPATE VALIDADO CON ${body.edicion} \u2014 ${body.grupo}` };\r\n      sendLive();\r\n    } catch (error) {\r\n      validarStatus[grupoKey] = error.sinDatos\r\n        ? { kind: 'error', text: error.message }\r\n        : { kind: 'error', text: `NO SE PUDO VALIDAR \u2014 ${error.message === 'fetch failed' ? 'sin conexi\u00F3n con gla.futbol' : error.message}. Se conserva el orden actual.` };\r\n    }\r\n    render();\r\n  }\r\n\r\n  const isGla = document.body.dataset.theme === 'gla';\r\n  const modoWeb = () => isGla && data.modoGrupos === 'web';\r\n\r\n  // MODO WEB: reemplaza SOLO el snapshot WEB con la tabla oficial de\r\n  // Rel\u00E1mpago #4 (el servidor ya lo guarda y lo manda a Program); si la web\r\n  // no tiene datos o falla, no se toca nada y se conserva el ultimo valido.\r\n  async function updateWebSnapshot() {\r\n    syncStatus = { kind: 'loading', text: 'Consultando gla.futbol (Rel\u00E1mpago #4)...' };\r\n    render();\r\n    try {\r\n      const response = await fetch('/api/grupos/web-update', { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) {\r\n        const error = new Error(body?.error || `HTTP ${response.status}`);\r\n        error.sinDatos = !!body?.sinDatos;\r\n        throw error;\r\n      }\r\n      data.gruposWeb = body.gruposWeb;\r\n      syncStatus = { kind: 'success', text: `GRUPOS A Y B ACTUALIZADOS (${body.gruposWeb.fuente})`, unmatchedTeams: body.unmatchedTeams || [] };\r\n      sendLive();\r\n    } catch (error) {\r\n      syncStatus = error.sinDatos\r\n        ? { kind: 'error', text: `${error.message} \u2014 SE CONSERVAN LOS \u00DALTIMOS DATOS WEB V\u00C1LIDOS` }\r\n        : { kind: 'error', text: 'NO SE PUDO ACTUALIZAR \u2014 SE CONSERVAN LOS \u00DALTIMOS DATOS WEB V\u00C1LIDOS', detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  async function syncFromWeb() {\r\n    syncStatus = { kind: 'loading', text: 'Actualizando...' };\r\n    render();\r\n    try {\r\n      const response = await fetch('/api/grupos/sync-web', { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      data.grupo1 = body.grupo1;\r\n      data.grupo2 = body.grupo2;\r\n      data.ultimaActualizacionWeb = body.ultimaActualizacionWeb;\r\n      syncStatus = { kind: 'success', text: `GRUPOS A Y B ACTUALIZADOS${body.edicion ? ` (${body.edicion.label})` : ''}`, unmatchedTeams: body.unmatchedTeams || [] };\r\n      onDirty();\r\n    } catch (error) {\r\n      syncStatus = { kind: 'error', text: `ERROR AL ACTUALIZAR \u2014 ${error.message}`, detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n    const isWeb = modoWeb();\r\n\r\n    // --- Modo (solo GLA) ---\r\n    if (isGla) {\r\n      const modoField = document.createElement('div');\r\n      modoField.className = 'field';\r\n      const modoLabel = document.createElement('label');\r\n      modoLabel.textContent = 'MODO';\r\n      modoField.appendChild(modoLabel);\r\n      const modoSelect = document.createElement('select');\r\n      modoSelect.setAttribute('aria-label', 'MODO');\r\n      for (const opt of MODOS_GRUPOS) {\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        modoSelect.appendChild(option);\r\n      }\r\n      modoSelect.value = isWeb ? 'web' : 'manual';\r\n      modoSelect.addEventListener('change', () => {\r\n        data.modoGrupos = modoSelect.value;\r\n        syncStatus = null;\r\n        sendLive();\r\n        render();\r\n      });\r\n      modoField.appendChild(modoSelect);\r\n      root.appendChild(modoField);\r\n    }\r\n\r\n    // --- Posicion ---\r\n    const posicionField = document.createElement('div');\r\n    posicionField.className = 'field';\r\n    const posicionLabel = document.createElement('label');\r\n    posicionLabel.textContent = 'Posici\u00F3n';\r\n    posicionField.appendChild(posicionLabel);\r\n    const posicionSelect = document.createElement('select');\r\n    for (const opt of POSICIONES) {\r\n      const option = document.createElement('option');\r\n      option.value = opt.id;\r\n      option.textContent = opt.label;\r\n      posicionSelect.appendChild(option);\r\n    }\r\n    posicionSelect.value = POSICIONES.some((p) => p.id === data.posicion) ? data.posicion : 'placaL';\r\n    posicionSelect.addEventListener('change', () => {\r\n      data.posicion = posicionSelect.value;\r\n      onDirty();\r\n      render();\r\n    });\r\n    posicionField.appendChild(posicionSelect);\r\n    root.appendChild(posicionField);\r\n\r\n    // GLA: el boton web existe solo en modo WEB (y carga su snapshot); en\r\n    // MANUAL todo se carga a mano. Otro theme: comportamiento de siempre.\r\n    const syncRow = document.createElement('div');\r\n    syncRow.className = 'performance-sync';\r\n    const syncButton = document.createElement('button');\r\n    syncButton.type = 'button';\r\n    syncButton.className = 'performance-sync-btn';\r\n    syncButton.textContent = 'ACTUALIZAR DESDE WEB';\r\n    syncButton.disabled = syncStatus?.kind === 'loading';\r\n    syncButton.addEventListener('click', isGla ? updateWebSnapshot : syncFromWeb);\r\n    syncRow.appendChild(syncButton);\r\n    if (isGla) {\r\n      const source = document.createElement('span');\r\n      source.className = 'performance-sync-status';\r\n      const at = data.gruposWeb?.actualizadoEn ? new Date(data.gruposWeb.actualizadoEn).toLocaleString() : 'nunca';\r\n      source.textContent = `FUENTE: GLA REL\u00C1MPAGO #4 \u2014 FASE DE GRUPOS \u00B7 \u00DAltima actualizaci\u00F3n: ${at}`;\r\n      syncRow.appendChild(source);\r\n    } else {\r\n      // ACTUALIZADOR DE DATOS (2026-10-21): edicion del torneo de la que salen.\r\n      syncRow.appendChild(createGlaTorneoSourceNote());\r\n    }\r\n    if (syncStatus) {\r\n      const status = document.createElement('span');\r\n      status.className = `performance-sync-status ${syncStatus.kind}`;\r\n      status.textContent = syncStatus.text;\r\n      if (syncStatus.detail) status.title = syncStatus.detail;\r\n      syncRow.appendChild(status);\r\n    }\r\n    if (!isGla || isWeb) root.appendChild(syncRow);\r\n    if ((!isGla || isWeb) && syncStatus?.unmatchedTeams?.length) {\r\n      const warning = document.createElement('p');\r\n      warning.className = 'performance-sync-warning';\r\n      warning.textContent = `Sin equipo local equivalente para: ${syncStatus.unmatchedTeams.join(', ')}`;\r\n      root.appendChild(warning);\r\n    }\r\n\r\n    const posicion = posicionSelect.value;\r\n    const esFullscreen = posicion === 'fullscreenDerecha' || posicion === 'fullscreenIzquierda';\r\n\r\n    // --- Grupo visible (solo fullscreen) / nota (Placa L) ---\r\n    if (esFullscreen) {\r\n      const varianteField = document.createElement('div');\r\n      varianteField.className = 'field';\r\n      const varianteLabel = document.createElement('label');\r\n      varianteLabel.textContent = 'Grupo visible';\r\n      varianteField.appendChild(varianteLabel);\r\n      const varianteSelect = document.createElement('select');\r\n      for (const opt of VARIANTS) {\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        varianteSelect.appendChild(option);\r\n      }\r\n      varianteSelect.value = data.variante === 'grupo2' ? 'grupo2' : 'grupo1';\r\n      varianteSelect.addEventListener('change', () => {\r\n        data.variante = varianteSelect.value;\r\n        editingGrupo = varianteSelect.value;\r\n        onDirty();\r\n        render();\r\n      });\r\n      varianteField.appendChild(varianteSelect);\r\n      root.appendChild(varianteField);\r\n    } else {\r\n      const note = document.createElement('p');\r\n      note.className = 'grupos-limit-note';\r\n      note.textContent = 'En Placa L se muestran Grupo 1 (arriba) y Grupo 2 (abajo) al mismo tiempo.';\r\n      root.appendChild(note);\r\n    }\r\n\r\n    // --- Toggle local: que tabla se esta editando ---\r\n    const tabs = document.createElement('div');\r\n    tabs.className = 'grupos-edit-tabs';\r\n    for (const opt of VARIANTS) {\r\n      const tab = document.createElement('button');\r\n      tab.type = 'button';\r\n      tab.className = 'grupos-edit-tab';\r\n      tab.classList.toggle('active', editingGrupo === opt.id);\r\n      tab.textContent = `Editar ${opt.label}`;\r\n      tab.addEventListener('click', () => {\r\n        if (editingGrupo === opt.id) return;\r\n        editingGrupo = opt.id;\r\n        render();\r\n      });\r\n      tabs.appendChild(tab);\r\n    }\r\n    root.appendChild(tabs);\r\n\r\n    const fuente = isWeb ? data.gruposWeb : data;\r\n    const filas = fuente?.[editingGrupo]?.filas || [];\r\n\r\n    const section = document.createElement('section');\r\n    section.className = 'grupos-rows-section';\r\n    const heading = document.createElement('h2');\r\n    heading.textContent = `${VARIANTS.find((v) => v.id === editingGrupo).label.toUpperCase()}${isGla ? (isWeb ? ' \u2014 WEB (Rel\u00E1mpago #4)' : ' \u2014 MANUAL') : ''}`;\r\n    section.appendChild(heading);\r\n    if (isWeb && !filas.length) {\r\n      const empty = document.createElement('p');\r\n      empty.className = 'grupos-limit-note';\r\n      empty.textContent = 'Todav\u00EDa no hay datos WEB guardados: apret\u00E1 ACTUALIZAR DESDE WEB.';\r\n      section.appendChild(empty);\r\n    }\r\n\r\n    filas.forEach((fila, index) => {\r\n      const row = document.createElement('div');\r\n      row.className = 'grupos-row';\r\n\r\n      // SLOT DEL SORTEO (2026-10-23): la fila es el slot (A1..B3) y nunca\r\n      // se reordena aca; el orden por puntos se ve en \"TABLA VISIBLE\".\r\n      // En modo WEB la fila es la posicion oficial de gla.futbol.\r\n      const slot = document.createElement('span');\r\n      slot.textContent = isWeb ? `${fila.posicion || index + 1}\u00B0` : slotLabel(editingGrupo, index);\r\n      slot.title = isWeb ? 'Posici\u00F3n oficial (gla.futbol)' : 'Slot del sorteo (arma los cruces de PARTIDOS > S\u00C1BADO)';\r\n      slot.style.cssText = 'min-width:28px;font-weight:800;color:#e5a93b;align-self:center;';\r\n      row.style.gridTemplateColumns = '32px minmax(0, 1fr) 70px';\r\n      row.appendChild(slot);\r\n\r\n      const teamSelect = document.createElement('select');\r\n      teamSelect.setAttribute('aria-label', `Equipo, fila ${index + 1}`);\r\n      for (const opt of TEAM_OPTIONS) {\r\n        if (isHiddenGlaOption(opt, fila.teamId)) continue;\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        teamSelect.appendChild(option);\r\n      }\r\n      teamSelect.value = fila.teamId || '';\r\n      // WEB: equipo de la web que no se pudo asociar al catalogo.\r\n      if (isWeb && !fila.teamId && fila.nombreWeb && teamSelect.options[0]) {\r\n        teamSelect.options[0].textContent = `${fila.nombreWeb} (web, sin equipo local)`;\r\n      }\r\n      teamSelect.addEventListener('change', () => {\r\n        fila.teamId = teamSelect.value;\r\n        onDirty();\r\n        renderOrden();\r\n      });\r\n      row.appendChild(teamSelect);\r\n\r\n      const puntosInput = document.createElement('input');\r\n      puntosInput.type = 'text';\r\n      puntosInput.inputMode = 'numeric';\r\n      puntosInput.placeholder = 'Pts';\r\n      puntosInput.className = 'grupos-puntos-input';\r\n      puntosInput.value = fila.puntos ?? '';\r\n      puntosInput.addEventListener('input', () => {\r\n        fila.puntos = puntosInput.value;\r\n        sendLive();\r\n        renderOrden();\r\n      });\r\n      row.appendChild(puntosInput);\r\n\r\n      section.appendChild(row);\r\n\r\n      // Estadisticas de la fila (GLA): se guardan en el modo activo.\r\n      if (isGla) {\r\n        const stats = document.createElement('div');\r\n        stats.className = 'grupos-stats';\r\n        stats.style.cssText = 'display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 10px 38px;';\r\n        for (const { key, label } of STAT_FIELDS) {\r\n          const wrap = document.createElement('label');\r\n          wrap.style.cssText = 'display:flex;flex-direction:column;font-size:10px;color:#999;font-weight:700;';\r\n          wrap.textContent = label;\r\n          const input = document.createElement('input');\r\n          input.type = 'text';\r\n          input.inputMode = 'numeric';\r\n          input.value = fila[key] ?? '';\r\n          input.setAttribute('aria-label', `${label}, fila ${index + 1}`);\r\n          input.style.cssText = 'width:44px;text-align:center;';\r\n          input.addEventListener('input', () => {\r\n            fila[key] = input.value;\r\n            onDirty();\r\n          });\r\n          wrap.appendChild(input);\r\n          stats.appendChild(wrap);\r\n        }\r\n        section.appendChild(stats);\r\n      }\r\n    });\r\n\r\n    const note = document.createElement('p');\r\n    note.className = 'grupos-limit-note';\r\n    note.textContent = isWeb\r\n      ? 'Orden oficial de gla.futbol (GLA REL\u00C1MPAGO #4). Lo que edites ac\u00E1 queda solo en el snapshot WEB; ACTUALIZAR DESDE WEB vuelve a cargar los datos oficiales. MANUAL no se toca.'\r\n      : `El asset de ${VARIANTS.find((v) => v.id === editingGrupo).label} trae ${filas.length} casilleros de equipo \u2014 la cantidad de filas no se puede cambiar. El orden final al aire se calcula solo por puntos (mayor a menor).`;\r\n    section.appendChild(note);\r\n\r\n    // TABLA VISIBLE (2026-10-23): misma vista ordenada que Program/Preview\r\n    // (shared/grupos-orden.js), se actualiza al tipear puntos. Solo MANUAL\r\n    // (en WEB manda el orden oficial de la web).\r\n    if (!isWeb) {\r\n      const ordenBox = document.createElement('div');\r\n      ordenBox.className = 'grupos-orden-visible';\r\n      ordenBox.style.cssText = 'margin-top:10px;padding:10px;border:1px solid #333;border-radius:6px;background:rgba(255,255,255,0.03);display:flex;flex-direction:column;gap:6px;';\r\n      section.appendChild(ordenBox);\r\n      renderOrden = () => paintOrden(ordenBox, editingGrupo);\r\n      renderOrden();\r\n    } else {\r\n      renderOrden = () => {};\r\n    }\r\n\r\n    root.appendChild(section);\r\n\r\n    // \"AJUSTE DE TEXTOS\" (2026-08-15, auditoria completa): un unico ajuste\r\n    // por columna (\"nombre\"/\"puntos\") compartido entre Grupo 1 y Grupo 2 --\r\n    // ambas tarjetas reusan exactamente la misma clase CSS por fila (ver\r\n    // cardMarkup en program/js/renderers/grupos.js), asi que un control por\r\n    // columna alcanza para las dos, sin duplicarlo por grupo.\r\n    const adjustSection = document.createElement('section');\r\n    const adjustHeading = document.createElement('h2');\r\n    adjustHeading.textContent = 'AJUSTE DE TEXTOS (Grupo 1 y Grupo 2)';\r\n    adjustSection.appendChild(adjustHeading);\r\n    for (const { key, label } of [\r\n      { key: 'nombre', label: 'Columna Nombre de equipo' },\r\n      { key: 'puntos', label: 'Columna Puntos' },\r\n    ]) {\r\n      const wrap = document.createElement('div');\r\n      wrap.className = 'field';\r\n      const lbl = document.createElement('label');\r\n      lbl.textContent = label;\r\n      wrap.appendChild(lbl);\r\n      mountAdjustControl(wrap, data, key, onDirty, saveOptions);\r\n      adjustSection.appendChild(wrap);\r\n    }\r\n    root.appendChild(adjustSection);\r\n  }\r\n\r\n  let renderOrden = () => {};\r\n\r\n  function paintOrden(box, grupoKey) {\r\n    box.innerHTML = '';\r\n    const filas = data[grupoKey].filas;\r\n    const vigente = desempateVigente(data, grupoKey);\r\n    const title = document.createElement('div');\r\n    title.style.cssText = 'font-size:11px;font-weight:800;color:#aaa;';\r\n    title.textContent = 'TABLA VISIBLE (orden por puntos \u2014 el slot del sorteo no cambia)';\r\n    box.appendChild(title);\r\n    ordenarGrupo(filas, vigente).forEach(({ fila, slot }, index) => {\r\n      const line = document.createElement('div');\r\n      line.style.cssText = 'font-size:12px;font-weight:700;';\r\n      line.textContent = `${index + 1}\u00B0 ${fila.teamId ? teamName(fila.teamId) : '(sin equipo)'} (${slotLabel(grupoKey, slot)}) \u2014 ${puntosValue(fila.puntos)} pts`;\r\n      box.appendChild(line);\r\n    });\r\n\r\n    const letra = grupoKey === 'grupo1' ? 'A' : 'B';\r\n    const empate = hayEmpate(filas);\r\n    const guardado = data.desempateWeb?.[grupoKey];\r\n    const estado = document.createElement('div');\r\n    estado.style.cssText = 'font-size:11px;';\r\n    if (empate && vigente) {\r\n      estado.style.color = '#7ed67e';\r\n      estado.textContent = `Empate resuelto con el orden oficial de ${vigente.fuente} (validado ${new Date(vigente.validadoEn).toLocaleString()}).`;\r\n    } else if (empate && guardado) {\r\n      estado.style.color = '#e5a93b';\r\n      estado.textContent = 'VALIDACI\u00D3N DESACTUALIZADA: cambiaron puntos, equipos o slots desde la \u00FAltima validaci\u00F3n. Hasta validar de nuevo, los empatados quedan en el orden del sorteo.';\r\n    } else if (empate) {\r\n      estado.style.color = '#e5a93b';\r\n      estado.textContent = 'EMPATE EN PUNTOS: los empatados quedan en el orden del sorteo hasta validar con la web.';\r\n    }\r\n    if (estado.textContent) box.appendChild(estado);\r\n\r\n    if (empate) {\r\n      const row = document.createElement('div');\r\n      row.className = 'performance-sync';\r\n      const button = document.createElement('button');\r\n      button.type = 'button';\r\n      button.className = 'performance-sync-btn';\r\n      button.textContent = `VALIDAR WEB \u2014 GRUPO ${letra}`;\r\n      button.disabled = validarStatus[grupoKey]?.kind === 'loading';\r\n      button.addEventListener('click', () => validarWeb(grupoKey));\r\n      row.appendChild(button);\r\n      const st = validarStatus[grupoKey];\r\n      // El \"validado\" de un pedido anterior no se sigue mostrando si esos\r\n      // datos ya cambiaron (el aviso de arriba dice DESACTUALIZADA).\r\n      if (st && !(st.kind === 'success' && !vigente)) {\r\n        const status = document.createElement('span');\r\n        status.className = `performance-sync-status ${st.kind}`;\r\n        status.textContent = st.text;\r\n        row.appendChild(status);\r\n      }\r\n      box.appendChild(row);\r\n    }\r\n  }\r\n\r\n  render();\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/estrellas-panel.js","import { crestFile, teamName } from '../../shared/teams.js';\r\nimport { formatPlayerName, PLAYER_NAME_FORMAT } from '../../shared/player-name-format.js';\r\nimport { mountAdjustControl } from './field-editors.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../shared/themes.js';\r\nimport { createGlaTorneoSourceNote, glaTorneoLabel } from './gla-torneo-source.js';\r\n\r\n// \"AJUSTE DE TEXTOS\" (2026-08-15, auditoria completa): Estrellas tiene\r\n// estructura FIJA (2 jugadores, siempre los mismos 8 campos + el titulo),\r\n// a diferencia de las tablas dinamicas (Posiciones/Resultados/Goleadores)\r\n// -- por eso cada texto tiene su PROPIO ajuste individual (nombre/G/A/PJ de\r\n// cada lado por separado) en vez de un control compartido por columna.\r\nconst ADJUST_FIELDS = [\r\n  { key: 'titulo', label: 'T\u00EDtulo (fijo: \"LOS MEJORES DE CADA EQUIPO\")' },\r\n  { key: 'localNombre', label: 'Nombre \u2014 Jugador Local' },\r\n  { key: 'localG', label: 'G (Goles) \u2014 Local' },\r\n  { key: 'localA', label: 'A (Asistencias) \u2014 Local' },\r\n  { key: 'localPJ', label: 'PJ (Partidos) \u2014 Local' },\r\n  { key: 'visitanteNombre', label: 'Nombre \u2014 Jugador Visitante' },\r\n  { key: 'visitanteG', label: 'G (Goles) \u2014 Visitante' },\r\n  { key: 'visitanteA', label: 'A (Asistencias) \u2014 Visitante' },\r\n  { key: 'visitantePJ', label: 'PJ (Partidos) \u2014 Visitante' },\r\n];\r\n\r\n// Mensajes del sync AS por status (2026-09-10, misma logica que Ficha\r\n// Jugador -- ver server/argentinaStreamersPlayerStats.js): nunca se\r\n// inventa un dato, cada status describe EXACTAMENTE lo que paso.\r\nconst STATUS_TEXT = {\r\n  ok: 'datos actualizados.',\r\n  'not-found': 'no se encontr\u00F3 este jugador en argentinastreamers.com \u2014 no se inventaron datos.',\r\n  ambiguous: 'hay m\u00E1s de un jugador con ese nombre en la web \u2014 eleg\u00ED a cu\u00E1l corresponde:',\r\n  'stale-web-id': 'este jugador estaba asociado a un perfil web que ya no existe.',\r\n  error: 'error al actualizar \u2014 se conserv\u00F3 el \u00FAltimo dato v\u00E1lido.',\r\n};\r\n\r\nconst STAR_SNAPSHOT_KEYS = [\r\n  'localJugador', 'localNombre', 'localG', 'localA', 'localPJ',\r\n  'visitanteJugador', 'visitanteNombre', 'visitanteG', 'visitanteA', 'visitantePJ',\r\n  'ultimaActualizacionWeb',\r\n];\r\n\r\nfunction snapshotFromData(data) {\r\n  return Object.fromEntries(STAR_SNAPSHOT_KEYS.map((key) => [\r\n    key,\r\n    data[key] && typeof data[key] === 'object'\r\n      ? JSON.parse(JSON.stringify(data[key]))\r\n      : data[key],\r\n  ]));\r\n}\r\n\r\nexport function renderEstrellasPanel(containerEl, data, scoreboardData, onChanged, saveOptions, siblingTables) {\r\n  // \"isArgentina\" (2026-09-10, pedido explicito del usuario: \"Estrellas...\r\n  // misma l\u00F3gica de Ficha Jugador\" -- identidad ESTABLE por jugadorId, no\r\n  // solo texto). Declarado ARRIBA de todo (no cerca de \"loadRosterOptions\",\r\n  // donde se usaba antes) porque el bloque de sync AS mas abajo tambien lo\r\n  // necesita y corre primero en el cuerpo de esta funcion.\r\n  const isArgentina = document.body.dataset.theme === ARGENTINA_STREAMERS_THEME_ID;\r\n  data.fuente = data.fuente === 'torneo' ? 'torneo' : 'liga';\r\n  if (!data.snapshots || typeof data.snapshots !== 'object') data.snapshots = {};\r\n  if (!data.snapshots[data.fuente]) data.snapshots[data.fuente] = snapshotFromData(data);\r\n  data.formatoJugador ||= PLAYER_NAME_FORMAT.NUMBER_NICKNAME;\r\n  const teamA = scoreboardData?.teamA || '';\r\n  const teamB = scoreboardData?.teamB || '';\r\n\r\n  const crestA = crestFile(teamA);\r\n  const crestB = crestFile(teamB);\r\n  const nameA = teamName(teamA) || 'LOCAL';\r\n  const nameB = teamName(teamB) || 'VISITANTE';\r\n\r\n  containerEl.innerHTML = `\r\n    <div class=\"estrellas-format-field\">\r\n      <label for=\"est-formato-jugador\">FORMATO DEL JUGADOR</label>\r\n      <select id=\"est-formato-jugador\" class=\"estrellas-format-select\">\r\n        <option value=\"${PLAYER_NAME_FORMAT.NUMBER_NICKNAME}\" ${data.formatoJugador === PLAYER_NAME_FORMAT.NUMBER_NICKNAME ? 'selected' : ''}>N\u00DAMERO + APODO</option>\r\n        <option value=\"${PLAYER_NAME_FORMAT.NUMBER_INITIAL_LASTNAME}\" ${data.formatoJugador === PLAYER_NAME_FORMAT.NUMBER_INITIAL_LASTNAME ? 'selected' : ''}>N\u00DAMERO + INICIAL + APELLIDO</option>\r\n      </select>\r\n    </div>\r\n    <div class=\"estrellas-panel-wrapper\">\r\n      <!-- Tarjeta Jugador Local -->\r\n      <div class=\"estrellas-card\">\r\n        <div class=\"estrellas-card-header\">\r\n          ${crestA ? `<img src=\"${crestA}\" class=\"estrellas-crest-preview\" alt=\"local\">` : '<div class=\"estrellas-crest-placeholder\"></div>'}\r\n          <div class=\"estrellas-team-title\">JUGADOR EQUIPO LOCAL (${nameA})</div>\r\n        </div>\r\n        <div class=\"estrellas-card-body\">\r\n          <div class=\"field-row\">\r\n            <label for=\"est-local-nombre\">Nombre del Jugador</label>\r\n            <input type=\"text\" id=\"est-local-nombre\" class=\"est-input-text\" value=\"${data.localNombre || ''}\" placeholder=\"Ej. L. Messi\">\r\n            <select id=\"est-local-roster\" class=\"estrellas-format-select\" aria-label=\"Jugador del plantel local\"><option value=\"\">JUGADOR DEL PLANTEL</option></select>\r\n          </div>\r\n          <div class=\"stats-grid\">\r\n            <div class=\"stat-field\">\r\n              <label for=\"est-local-g\">G (Goles)</label>\r\n              <input type=\"number\" id=\"est-local-g\" class=\"est-input-num\" min=\"0\" max=\"99\" value=\"${data.localG ?? 0}\">\r\n            </div>\r\n            <div class=\"stat-field\">\r\n              <label for=\"est-local-a\">A (Asistencias)</label>\r\n              <input type=\"number\" id=\"est-local-a\" class=\"est-input-num\" min=\"0\" max=\"99\" value=\"${data.localA ?? 0}\">\r\n            </div>\r\n            <div class=\"stat-field\">\r\n              <label for=\"est-local-pj\">PJ (Partidos)</label>\r\n              <input type=\"number\" id=\"est-local-pj\" class=\"est-input-num\" min=\"0\" max=\"99\" value=\"${data.localPJ ?? 0}\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Tarjeta Jugador Visitante -->\r\n      <div class=\"estrellas-card\">\r\n        <div class=\"estrellas-card-header\">\r\n          ${crestB ? `<img src=\"${crestB}\" class=\"estrellas-crest-preview\" alt=\"visitor\">` : '<div class=\"estrellas-crest-placeholder\"></div>'}\r\n          <div class=\"estrellas-team-title\">JUGADOR EQUIPO VISITANTE (${nameB})</div>\r\n        </div>\r\n        <div class=\"estrellas-card-body\">\r\n          <div class=\"field-row\">\r\n            <label for=\"est-visitante-nombre\">Nombre del Jugador</label>\r\n            <input type=\"text\" id=\"est-visitante-nombre\" class=\"est-input-text\" value=\"${data.visitanteNombre || ''}\" placeholder=\"Ej. C. Ronaldo\">\r\n            <select id=\"est-visitante-roster\" class=\"estrellas-format-select\" aria-label=\"Jugador del plantel visitante\"><option value=\"\">JUGADOR DEL PLANTEL</option></select>\r\n          </div>\r\n          <div class=\"stats-grid\">\r\n            <div class=\"stat-field\">\r\n              <label for=\"est-visitante-g\">G (Goles)</label>\r\n              <input type=\"number\" id=\"est-visitante-g\" class=\"est-input-num\" min=\"0\" max=\"99\" value=\"${data.visitanteG ?? 0}\">\r\n            </div>\r\n            <div class=\"stat-field\">\r\n              <label for=\"est-visitante-a\">A (Asistencias)</label>\r\n              <input type=\"number\" id=\"est-visitante-a\" class=\"est-input-num\" min=\"0\" max=\"99\" value=\"${data.visitanteA ?? 0}\">\r\n            </div>\r\n            <div class=\"stat-field\">\r\n              <label for=\"est-visitante-pj\">PJ (Partidos)</label>\r\n              <input type=\"number\" id=\"est-visitante-pj\" class=\"est-input-num\" min=\"0\" max=\"99\" value=\"${data.visitantePJ ?? 0}\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <section class=\"estrellas-adjust-section\">\r\n      <h2 class=\"estrellas-adjust-heading\">AJUSTE DE TEXTOS</h2>\r\n    </section>\r\n  `;\r\n\r\n  // T\u00CDTULO MANUAL (2026-10-09, pedido explicito del usuario, SOLO Argentina\r\n  // Streamers): texto libre, independiente de jugadores/estadisticas (ni la\r\n  // carga de jugadores ni \"ESTRELLA POR\"/web lo tocan). Vacio = titulo por\r\n  // defecto. GLA conserva su titulo fijo de siempre.\r\n  if (isArgentina) {\r\n    if (typeof data.titulo !== 'string') data.titulo = 'LOS MEJORES DE CADA EQUIPO';\r\n    const tituloField = document.createElement('div');\r\n    tituloField.className = 'estrellas-format-field';\r\n    const tituloLabel = document.createElement('label');\r\n    tituloLabel.htmlFor = 'est-titulo';\r\n    tituloLabel.textContent = 'T\u00CDTULO';\r\n    const tituloInput = document.createElement('input');\r\n    tituloInput.type = 'text';\r\n    tituloInput.id = 'est-titulo';\r\n    tituloInput.className = 'est-input-text';\r\n    tituloInput.maxLength = 60;\r\n    tituloInput.value = data.titulo;\r\n    tituloInput.placeholder = 'LOS MEJORES DE CADA EQUIPO';\r\n    tituloInput.addEventListener('input', () => {\r\n      data.titulo = tituloInput.value;\r\n      onChanged();\r\n    });\r\n    tituloField.append(tituloLabel, tituloInput);\r\n    containerEl.prepend(tituloField);\r\n  }\r\n\r\n  const syncRow = document.createElement('div');\r\n  syncRow.className = 'performance-sync';\r\n  const syncButton = document.createElement('button');\r\n  syncButton.type = 'button';\r\n  syncButton.className = 'performance-sync-btn';\r\n  syncButton.textContent = 'ACTUALIZAR MEJORES DESDE WEB';\r\n  const syncStatus = document.createElement('span');\r\n  syncStatus.className = 'performance-sync-status';\r\n  syncButton.addEventListener('click', async () => {\r\n    syncButton.disabled = true;\r\n    syncStatus.className = 'performance-sync-status loading';\r\n    syncStatus.textContent = 'Actualizando...';\r\n    try {\r\n      const response = await fetch(`/api/estrellas/sync-web?teamA=${encodeURIComponent(teamA)}&teamB=${encodeURIComponent(teamB)}&fuente=${encodeURIComponent(data.fuente)}`, { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      for (const key of ['fuente', 'snapshots', 'formatoJugador', 'localJugador', 'localNombre', 'localG', 'localA', 'localPJ', 'visitanteJugador', 'visitanteNombre', 'visitanteG', 'visitanteA', 'visitantePJ']) {\r\n        if (body[key] !== undefined) data[key] = body[key];\r\n      }\r\n      data.ultimaActualizacionWeb = body.ultimaActualizacionWeb;\r\n      document.getElementById('est-local-nombre').value = data.localNombre || '';\r\n      document.getElementById('est-local-g').value = data.localG ?? 0;\r\n      document.getElementById('est-local-a').value = data.localA ?? 0;\r\n      document.getElementById('est-local-pj').value = data.localPJ ?? 0;\r\n      document.getElementById('est-visitante-nombre').value = data.visitanteNombre || '';\r\n      document.getElementById('est-visitante-g').value = data.visitanteG ?? 0;\r\n      document.getElementById('est-visitante-a').value = data.visitanteA ?? 0;\r\n      document.getElementById('est-visitante-pj').value = data.visitantePJ ?? 0;\r\n      syncStatus.className = 'performance-sync-status success';\r\n      syncStatus.textContent = `MEJORES JUGADORES ACTUALIZADOS${body.edicion ? ` (${body.edicion.label})` : ''}`;\r\n      onChanged();\r\n    } catch (error) {\r\n      syncStatus.className = 'performance-sync-status error';\r\n      syncStatus.textContent = data.fuente === 'torneo' ? `ERROR AL ACTUALIZAR \u2014 ${error.message}` : 'ERROR AL ACTUALIZAR';\r\n      syncStatus.title = error.message;\r\n    } finally {\r\n      syncButton.disabled = false;\r\n    }\r\n  });\r\n  syncRow.append(syncButton, syncStatus);\r\n  // ACTUALIZADOR DE DATOS (2026-10-21, solo GLA con FUENTE = TORNEO).\r\n  if (!isArgentina && data.fuente === 'torneo') syncRow.appendChild(createGlaTorneoSourceNote());\r\n  // \"isArgentina\" (2026-09-10, pedido explicito del usuario: \"Estrellas...\r\n  // misma l\u00F3gica de Ficha Jugador\" -- el sync de gla.futbol de arriba es\r\n  // exclusivo de GLA, nunca funciono para Argentina Streamers, que tiene su\r\n  // propia fuente real). Reusa EXACTAMENTE el mismo endpoint/resolucion de\r\n  // identidad que Ficha Jugador (server/argentinaStreamersPlayerStats.js,\r\n  // via /api/planteles/:teamId/jugadores/:jugadorId/sync-web) -- goles/\r\n  // asistencias/presencias (=PJ) por jugador puntual, nunca \"mvps\" (no\r\n  // aplica aca). Nunca inventa datos: not-found/stale-web-id se informan\r\n  // tal cual, ambiguous ofrece los candidatos reales para que el operador\r\n  // elija (nunca se adivina), mismo criterio que Ficha Jugador.\r\n  if (isArgentina) {\r\n    const asSyncSection = document.createElement('div');\r\n    asSyncSection.className = 'performance-sync';\r\n    asSyncSection.style.flexDirection = 'column';\r\n    asSyncSection.style.alignItems = 'stretch';\r\n    asSyncSection.style.gap = '8px';\r\n\r\n    // ESTRELLA POR (2026-10-08, pedido explicito del usuario): por cada lado\r\n    // con equipo web (Argentina Streamers -> MASCULINO, Argentina Streamers\r\n    // FEM -> FEMENINO): GOLES = primer jugador de la tabla de GOLEADORES de\r\n    // esa rama, ASISTENCIAS = primero de ASISTIDORES, AMBOS = primero de\r\n    // CONTRIBUCIONES (G+A) de ESTADISTICAS. Para GOLES/ASISTENCIAS se manda\r\n    // el primer jugador de las tablas LOCALES de esos modulos (ya\r\n    // actualizadas por el operador); los numeros G/A/PJ salen del perfil\r\n    // web del elegido. Un lado con rival no se toca (carga manual), y\r\n    // vacio/error tampoco pisan nada. Cambiar el criterio recalcula desde el\r\n    // cache (no consulta la web); el boton ACTUALIZAR DESDE WEB si la relee.\r\n    const CRITERIO_LABELS = { goles: 'GOLES', asistencias: 'ASISTENCIAS', ambos: 'AMBOS (G+A)' };\r\n    if (!CRITERIO_LABELS[data.estrellaPor]) data.estrellaPor = 'ambos';\r\n\r\n    const criterioField = document.createElement('label');\r\n    criterioField.className = 'estrellas-format-field';\r\n    const criterioLabel = document.createElement('span');\r\n    criterioLabel.textContent = 'ESTRELLA POR (equipos con datos web)';\r\n    criterioLabel.style.color = '#d5a753';\r\n    criterioLabel.style.fontSize = '12px';\r\n    criterioLabel.style.fontWeight = '700';\r\n    const criterioSelect = document.createElement('select');\r\n    criterioSelect.className = 'estrellas-format-select';\r\n    for (const [value, label] of Object.entries(CRITERIO_LABELS)) {\r\n      const option = document.createElement('option');\r\n      option.value = value;\r\n      option.textContent = label;\r\n      criterioSelect.appendChild(option);\r\n    }\r\n    criterioSelect.value = data.estrellaPor;\r\n    criterioField.append(criterioLabel, criterioSelect);\r\n\r\n    const leaderButton = document.createElement('button');\r\n    leaderButton.type = 'button';\r\n    leaderButton.className = 'performance-sync-btn';\r\n    leaderButton.textContent = 'ACTUALIZAR DESDE WEB';\r\n    const leaderStatusEl = document.createElement('div');\r\n    leaderStatusEl.style.display = 'flex';\r\n    leaderStatusEl.style.flexDirection = 'column';\r\n    leaderStatusEl.style.gap = '4px';\r\n\r\n    // Primer jugador de la tabla LOCAL de un modulo (Goleadores/Asistidores)\r\n    // para una rama: la tabla visible si esa es su rama, si no el slot\r\n    // guardado de esa rama. Mismo orden que el grafico (mayor numero\r\n    // primero, empates en orden de carga). Filas del equipo de la OTRA rama\r\n    // se ignoran (datos mezclados de una version anterior).\r\n    const RAMA_TEAM = { masculino: 'argentina-streamers', femenino: 'argentina-streamers-fem' };\r\n    function localLeader(moduleData, rama, statKey) {\r\n      if (!moduleData) return null;\r\n      const rows = moduleData.ramaWeb === rama ? moduleData.jugadores : moduleData.snapshotsRama?.[rama]?.jugadores;\r\n      const otherTeam = RAMA_TEAM[rama === 'masculino' ? 'femenino' : 'masculino'];\r\n      const valid = (Array.isArray(rows) ? rows : []).filter((row) => row && String(row.nombre || '').trim() && row.teamId !== otherTeam);\r\n      if (!valid.length) return null;\r\n      let best = valid[0];\r\n      for (const row of valid) if ((Number(row[statKey]) || 0) > (Number(best[statKey]) || 0)) best = row;\r\n      return { webId: best.webId || null, nombre: best.nombre, count: Number(best[statKey]) || 0 };\r\n    }\r\n    function lideresLocales() {\r\n      const out = {};\r\n      for (const rama of ['masculino', 'femenino']) {\r\n        out[rama] = {\r\n          goles: localLeader(siblingTables?.goleadores, rama, 'g'),\r\n          asistencias: localLeader(siblingTables?.asistidores, rama, 'a'),\r\n        };\r\n      }\r\n      return out;\r\n    }\r\n\r\n    function applyLeader(side, result) {\r\n      const prefix = side === 'local' ? 'local' : 'visitante';\r\n      data[`${prefix}Jugador`] = result.jugador;\r\n      data[`${prefix}Nombre`] = formatPlayerName(result.jugador, data.formatoJugador);\r\n      data[`${prefix}G`] = result.g ?? 0;\r\n      data[`${prefix}A`] = result.a ?? 0;\r\n      data[`${prefix}PJ`] = result.pj ?? 0;\r\n      data[`${prefix}JugadorId`] = '';\r\n      data[`${prefix}JugadorWebId`] = result.jugador?.webId || '';\r\n    }\r\n\r\n    const ORIGEN_LABELS = { goles: 'GOLEADORES', asistencias: 'ASISTIDORES', ambos: 'CONTRIBUCIONES G+A' };\r\n    function leaderLine(label, result) {\r\n      const line = document.createElement('span');\r\n      const kind = result.status === 'ok' ? 'success' : (result.status === 'manual' ? '' : 'error');\r\n      line.className = `performance-sync-status ${kind}`;\r\n      if (result.status === 'ok') {\r\n        const nombre = formatPlayerName(result.jugador, data.formatoJugador);\r\n        const origen = result.origenEstrella === 'tabla-local' ? 'tabla local' : 'web';\r\n        line.textContent = `${label}: 1\u00B0 de ${ORIGEN_LABELS[result.criterio]} ${result.rama.toUpperCase()} (${origen}) \u2014 ${nombre} \u00B7 G ${result.g} \u00B7 A ${result.a} \u00B7 PJ ${result.pj}`;\r\n      } else {\r\n        line.textContent = `${label}: ${result.mensaje}`;\r\n        if (result.detalle) line.title = result.detalle;\r\n      }\r\n      return line;\r\n    }\r\n\r\n    async function cargarEstrellas(forzar) {\r\n      leaderButton.disabled = true;\r\n      criterioSelect.disabled = true;\r\n      leaderStatusEl.innerHTML = '';\r\n      const loading = document.createElement('span');\r\n      loading.className = 'performance-sync-status loading';\r\n      loading.textContent = forzar ? 'Consultando ESTAD\u00CDSTICAS en argentinastreamers.com...' : 'Calculando estrella...';\r\n      leaderStatusEl.appendChild(loading);\r\n      try {\r\n        const query = `teamA=${encodeURIComponent(teamA)}&teamB=${encodeURIComponent(teamB)}&criterio=${encodeURIComponent(data.estrellaPor)}${forzar ? '&forzar=1' : ''}`;\r\n        const response = await fetch(`/api/argentina-streamers/estrellas/sync-web?${query}`, {\r\n          method: 'POST',\r\n          headers: { 'Content-Type': 'application/json' },\r\n          body: JSON.stringify({ lideresLocales: lideresLocales() }),\r\n        });\r\n        const body = await response.json().catch(() => null);\r\n        if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n        leaderStatusEl.innerHTML = '';\r\n        let changed = false;\r\n        for (const [side, label] of [['local', 'LOCAL'], ['visitante', 'VISITANTE']]) {\r\n          const result = body.lados?.[side];\r\n          if (!result) continue;\r\n          if (result.status === 'ok') {\r\n            applyLeader(side, result);\r\n            changed = true;\r\n          }\r\n          leaderStatusEl.appendChild(leaderLine(label, result));\r\n        }\r\n        if (changed) {\r\n          localNombreInput.value = data.localNombre || '';\r\n          localGInput.value = data.localG ?? 0;\r\n          localAInput.value = data.localA ?? 0;\r\n          localPJInput.value = data.localPJ ?? 0;\r\n          visitanteNombreInput.value = data.visitanteNombre || '';\r\n          visitanteGInput.value = data.visitanteG ?? 0;\r\n          visitanteAInput.value = data.visitanteA ?? 0;\r\n          visitantePJInput.value = data.visitantePJ ?? 0;\r\n          data.ultimaActualizacionWeb = new Date().toISOString();\r\n          saveActiveSnapshot();\r\n          onChanged();\r\n        }\r\n      } catch (error) {\r\n        leaderStatusEl.innerHTML = '';\r\n        const line = document.createElement('span');\r\n        line.className = 'performance-sync-status error';\r\n        line.textContent = 'NO SE PUDO ACTUALIZAR \u2014 SE CONSERVAN LOS DATOS ACTUALES';\r\n        line.title = error.message;\r\n        leaderStatusEl.appendChild(line);\r\n      } finally {\r\n        leaderButton.disabled = false;\r\n        criterioSelect.disabled = false;\r\n      }\r\n    }\r\n\r\n    leaderButton.addEventListener('click', () => cargarEstrellas(true));\r\n    criterioSelect.addEventListener('change', () => {\r\n      data.estrellaPor = criterioSelect.value;\r\n      onChanged();\r\n      cargarEstrellas(false);\r\n    });\r\n\r\n    // Sync puntual del jugador ELEGIDO del plantel (funcionalidad anterior,\r\n    // se conserva como opcion secundaria): estadisticas de ese jugador en\r\n    // la rama de su equipo.\r\n    const asSyncButton = document.createElement('button');\r\n    asSyncButton.type = 'button';\r\n    asSyncButton.className = 'performance-sync-btn';\r\n    asSyncButton.textContent = 'ACTUALIZAR STATS DEL JUGADOR ELEGIDO DEL PLANTEL';\r\n\r\n    const localStatusEl = document.createElement('div');\r\n    const visitanteStatusEl = document.createElement('div');\r\n\r\n    function renderSideStatus(el, label, jugadorId, statusKey, errorKey, onPickCandidate) {\r\n      el.innerHTML = '';\r\n      if (!jugadorId) {\r\n        const note = document.createElement('span');\r\n        note.className = 'performance-sync-status';\r\n        note.textContent = `${label}: eleg\u00ED un jugador del plantel para poder sincronizar.`;\r\n        el.appendChild(note);\r\n        return;\r\n      }\r\n      const status = data[statusKey];\r\n      if (status) {\r\n        const statusEl = document.createElement('span');\r\n        const kind = status === 'ok' ? 'success' : (status === 'ambiguous' ? 'info' : 'error');\r\n        statusEl.className = `performance-sync-status ${kind}`;\r\n        statusEl.textContent = `${label}: ${STATUS_TEXT[status] || status}`;\r\n        if (data[errorKey]) statusEl.title = data[errorKey];\r\n        el.appendChild(statusEl);\r\n      }\r\n      const candidates = data[`${statusKey}Candidates`];\r\n      if (status === 'ambiguous' && Array.isArray(candidates)) {\r\n        const list = document.createElement('div');\r\n        list.className = 'performance-rows';\r\n        for (const candidate of candidates) {\r\n          const row = document.createElement('button');\r\n          row.type = 'button';\r\n          row.className = 'btn';\r\n          row.textContent = `${candidate.displayName} (${candidate.name})`;\r\n          row.addEventListener('click', () => onPickCandidate(candidate.webId));\r\n          list.appendChild(row);\r\n        }\r\n        el.appendChild(list);\r\n      }\r\n    }\r\n\r\n    async function syncSide(side) {\r\n      const jugadorId = side === 'local' ? data.localJugadorId : data.visitanteJugadorId;\r\n      const teamId = side === 'local' ? teamA : teamB;\r\n      const statusKey = side === 'local' ? 'localWebSyncStatus' : 'visitanteWebSyncStatus';\r\n      const errorKey = side === 'local' ? 'localWebSyncError' : 'visitanteWebSyncError';\r\n      if (!jugadorId || !teamId) return;\r\n      return syncJugadorLado(side, jugadorId, teamId, statusKey, errorKey, null);\r\n    }\r\n\r\n    async function syncJugadorLado(side, jugadorId, teamId, statusKey, errorKey, explicitWebId) {\r\n      try {\r\n        const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}/jugadores/${encodeURIComponent(jugadorId)}/sync-web`, {\r\n          method: 'POST',\r\n          headers: { 'Content-Type': 'application/json' },\r\n          body: JSON.stringify(explicitWebId ? { webId: explicitWebId } : {}),\r\n        });\r\n        const body = await response.json().catch(() => null);\r\n        if (!response.ok || !body?.ok) {\r\n          data[statusKey] = 'error';\r\n          data[errorKey] = body?.error || `HTTP ${response.status}`;\r\n          return;\r\n        }\r\n        data[statusKey] = body.status;\r\n        data[`${statusKey}Candidates`] = body.status === 'ambiguous' ? body.candidates : null;\r\n        if (body.status === 'ok') {\r\n          const stats = body.stats || {};\r\n          if (side === 'local') {\r\n            data.localG = stats.golesDisponible ? (stats.goles ?? 0) : data.localG;\r\n            data.localA = stats.asistenciasDisponible ? (stats.asistencias ?? 0) : data.localA;\r\n            data.localPJ = stats.presenciasDisponible ? (stats.presencias ?? 0) : data.localPJ;\r\n            localGInput.value = data.localG;\r\n            localAInput.value = data.localA;\r\n            localPJInput.value = data.localPJ;\r\n          } else {\r\n            data.visitanteG = stats.golesDisponible ? (stats.goles ?? 0) : data.visitanteG;\r\n            data.visitanteA = stats.asistenciasDisponible ? (stats.asistencias ?? 0) : data.visitanteA;\r\n            data.visitantePJ = stats.presenciasDisponible ? (stats.presencias ?? 0) : data.visitantePJ;\r\n            visitanteGInput.value = data.visitanteG;\r\n            visitanteAInput.value = data.visitanteA;\r\n            visitantePJInput.value = data.visitantePJ;\r\n          }\r\n          data.ultimaActualizacionWeb = body.ultimaActualizacionWeb;\r\n          saveActiveSnapshot();\r\n        }\r\n      } catch (error) {\r\n        data[statusKey] = 'error';\r\n        data[errorKey] = error.message;\r\n      }\r\n    }\r\n\r\n    function refreshAsStatus() {\r\n      renderSideStatus(localStatusEl, 'LOCAL', data.localJugadorId, 'localWebSyncStatus', 'localWebSyncError', (webId) => {\r\n        syncJugadorLado('local', data.localJugadorId, teamA, 'localWebSyncStatus', 'localWebSyncError', webId).then(() => { refreshAsStatus(); onChanged(); });\r\n      });\r\n      renderSideStatus(visitanteStatusEl, 'VISITANTE', data.visitanteJugadorId, 'visitanteWebSyncStatus', 'visitanteWebSyncError', (webId) => {\r\n        syncJugadorLado('visitante', data.visitanteJugadorId, teamB, 'visitanteWebSyncStatus', 'visitanteWebSyncError', webId).then(() => { refreshAsStatus(); onChanged(); });\r\n      });\r\n    }\r\n\r\n    asSyncButton.addEventListener('click', async () => {\r\n      asSyncButton.disabled = true;\r\n      try {\r\n        await Promise.all([syncSide('local'), syncSide('visitante')]);\r\n        refreshAsStatus();\r\n        onChanged();\r\n      } finally {\r\n        asSyncButton.disabled = false;\r\n      }\r\n    });\r\n\r\n    asSyncSection.append(criterioField, leaderButton, leaderStatusEl, asSyncButton, localStatusEl, visitanteStatusEl);\r\n    containerEl.prepend(asSyncSection);\r\n    refreshAsStatus();\r\n  } else {\r\n    containerEl.prepend(syncRow);\r\n  }\r\n\r\n  const adjustSection = containerEl.querySelector('.estrellas-adjust-section');\r\n  for (const { key, label } of ADJUST_FIELDS) {\r\n    const wrap = document.createElement('div');\r\n    wrap.className = 'field';\r\n    const lbl = document.createElement('label');\r\n    lbl.textContent = isArgentina && key === 'titulo' ? 'T\u00EDtulo' : label;\r\n    wrap.appendChild(lbl);\r\n    mountAdjustControl(wrap, data, key, onChanged, saveOptions);\r\n    adjustSection.appendChild(wrap);\r\n  }\r\n\r\n  // Estilos inline del panel para un look premium oscuro y evitar contaminar clases globales del Master\r\n  const styleId = 'estrellas-panel-styles';\r\n  if (!document.getElementById(styleId)) {\r\n    const styleEl = document.createElement('style');\r\n    styleEl.id = styleId;\r\n    styleEl.textContent = `\r\n      .estrellas-panel-wrapper {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 20px;\r\n        margin-top: 10px;\r\n      }\r\n      .estrellas-format-field {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 7px;\r\n        margin-bottom: 14px;\r\n      }\r\n      .estrellas-format-field label {\r\n        color: #d5a753;\r\n        font-size: 12px;\r\n        font-weight: 700;\r\n        letter-spacing: 0.5px;\r\n      }\r\n      .estrellas-format-select {\r\n        background: #111;\r\n        border: 1px solid #444;\r\n        border-radius: 4px;\r\n        color: #fff;\r\n        padding: 9px 12px;\r\n      }\r\n      .estrellas-format-select:focus {\r\n        border-color: #d5a753;\r\n        outline: none;\r\n      }\r\n      .estrellas-card {\r\n        background: #1e1e1e;\r\n        border: 1px solid #333;\r\n        border-radius: 8px;\r\n        overflow: hidden;\r\n      }\r\n      .estrellas-card-header {\r\n        background: #2a2a2a;\r\n        padding: 12px 16px;\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 12px;\r\n        border-bottom: 1px solid #333;\r\n      }\r\n      .estrellas-crest-preview {\r\n        width: 32px;\r\n        height: 32px;\r\n        object-fit: contain;\r\n      }\r\n      .estrellas-crest-placeholder {\r\n        width: 32px;\r\n        height: 32px;\r\n        border: 1px dashed #555;\r\n        border-radius: 4px;\r\n      }\r\n      .estrellas-team-title {\r\n        color: #d5a753;\r\n        font-weight: 700;\r\n        font-size: 14px;\r\n        letter-spacing: 0.5px;\r\n      }\r\n      .estrellas-card-body {\r\n        padding: 16px;\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 16px;\r\n      }\r\n      .field-row {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 6px;\r\n      }\r\n      .field-row label {\r\n        color: #aaa;\r\n        font-size: 12px;\r\n        font-weight: 600;\r\n      }\r\n      .est-input-text {\r\n        background: #111;\r\n        border: 1px solid #444;\r\n        color: #fff;\r\n        padding: 8px 12px;\r\n        border-radius: 4px;\r\n        font-size: 14px;\r\n      }\r\n      .est-input-text:focus {\r\n        border-color: #d5a753;\r\n        outline: none;\r\n      }\r\n      .stats-grid {\r\n        display: grid;\r\n        grid-template-columns: repeat(3, 1fr);\r\n        gap: 12px;\r\n      }\r\n      .stat-field {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 6px;\r\n      }\r\n      .stat-field label {\r\n        color: #aaa;\r\n        font-size: 12px;\r\n        font-weight: 600;\r\n      }\r\n      .est-input-num {\r\n        background: #111;\r\n        border: 1px solid #444;\r\n        color: #fff;\r\n        padding: 8px;\r\n        border-radius: 4px;\r\n        font-size: 14px;\r\n        text-align: center;\r\n      }\r\n      .est-input-num:focus {\r\n        border-color: #d5a753;\r\n        outline: none;\r\n      }\r\n      .estrellas-adjust-section {\r\n        background: #1e1e1e;\r\n        border: 1px solid #333;\r\n        border-radius: 8px;\r\n        padding: 16px;\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 14px;\r\n      }\r\n      .estrellas-adjust-heading {\r\n        color: #d5a753;\r\n        font-weight: 700;\r\n        font-size: 14px;\r\n        letter-spacing: 0.5px;\r\n        margin: 0;\r\n      }\r\n    `;\r\n    document.head.appendChild(styleEl);\r\n  }\r\n\r\n  // Capturar elementos\r\n  const localNombreInput = document.getElementById('est-local-nombre');\r\n  const formatoJugadorSelect = document.getElementById('est-formato-jugador');\r\n  const localGInput = document.getElementById('est-local-g');\r\n  const localAInput = document.getElementById('est-local-a');\r\n  const localPJInput = document.getElementById('est-local-pj');\r\n\r\n  const visitanteNombreInput = document.getElementById('est-visitante-nombre');\r\n  const visitanteGInput = document.getElementById('est-visitante-g');\r\n  const visitanteAInput = document.getElementById('est-visitante-a');\r\n  const visitantePJInput = document.getElementById('est-visitante-pj');\r\n\r\n  const localRosterSelect = document.getElementById('est-local-roster');\r\n  const visitanteRosterSelect = document.getElementById('est-visitante-roster');\r\n  let disposed = false;\r\n\r\n  // \"NOMBRE DEL JUGADOR... integrar con el roster central\" (BLOQUE 3,\r\n  // secci\u00F3n 13, pedido explicito del usuario): desplegable adicional, NO\r\n  // reemplaza el input de texto libre (sigue disponible para un nombre\r\n  // fuera del plantel) -- mismo patron de lectura que match-roster-panel.js\r\n  // (Tarjeta/Cambios), misma fuente central (/api/planteles/:teamId). SOLO\r\n  // para Argentina Streamers el <option> usa el id real del plantel\r\n  // central como value (necesario para el sync web, ver \"isArgentina\" mas\r\n  // arriba en esta funcion) -- GLA sigue exactamente igual que siempre\r\n  // (value=nombreTV, sin jugadorId, su propio sync de gla.futbol intacto).\r\n  let localRosterJugadores = [];\r\n  let visitanteRosterJugadores = [];\r\n  async function loadRosterOptions(select, teamId, storeInto) {\r\n    if (!select || !teamId) return;\r\n    try {\r\n      const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}`);\r\n      const body = await response.json().catch(() => null);\r\n      if (disposed || !response.ok || !body?.ok) return;\r\n      const jugadores = body.snapshot?.jugadores || [];\r\n      if (storeInto === 'local') localRosterJugadores = jugadores;\r\n      else visitanteRosterJugadores = jugadores;\r\n      for (const jugador of jugadores) {\r\n        const option = document.createElement('option');\r\n        option.value = isArgentina ? jugador.id : jugador.nombreTV;\r\n        option.textContent = jugador.nombreTV;\r\n        select.appendChild(option);\r\n      }\r\n    } catch {\r\n      // Sin red: el desplegable queda vacio, el input de texto libre sigue andando.\r\n    }\r\n  }\r\n  loadRosterOptions(localRosterSelect, teamA, 'local');\r\n  loadRosterOptions(visitanteRosterSelect, teamB, 'visitante');\r\n\r\n  function handleLocalRosterSelect() {\r\n    if (!localRosterSelect.value) return;\r\n    if (isArgentina) {\r\n      const jugador = localRosterJugadores.find((j) => j.id === localRosterSelect.value);\r\n      if (!jugador) return;\r\n      data.localJugadorId = jugador.id;\r\n      localNombreInput.value = jugador.nombreTV;\r\n    } else {\r\n      localNombreInput.value = localRosterSelect.value;\r\n    }\r\n    handleInput();\r\n  }\r\n  function handleVisitanteRosterSelect() {\r\n    if (!visitanteRosterSelect.value) return;\r\n    if (isArgentina) {\r\n      const jugador = visitanteRosterJugadores.find((j) => j.id === visitanteRosterSelect.value);\r\n      if (!jugador) return;\r\n      data.visitanteJugadorId = jugador.id;\r\n      visitanteNombreInput.value = jugador.nombreTV;\r\n    } else {\r\n      visitanteNombreInput.value = visitanteRosterSelect.value;\r\n    }\r\n    handleInput();\r\n  }\r\n\r\n  function saveActiveSnapshot() {\r\n    data.snapshots[data.fuente] = snapshotFromData(data);\r\n  }\r\n\r\n  // Callback de cambio\r\n  function handleInput() {\r\n    if (!isArgentina) data.titulo = 'LOS MEJORES DE CADA EQUIPO';\r\n    data.localNombre = localNombreInput.value;\r\n    data.localG = parseInt(localGInput.value) || 0;\r\n    data.localA = parseInt(localAInput.value) || 0;\r\n    data.localPJ = parseInt(localPJInput.value) || 0;\r\n\r\n    data.visitanteNombre = visitanteNombreInput.value;\r\n    data.visitanteG = parseInt(visitanteGInput.value) || 0;\r\n    data.visitanteA = parseInt(visitanteAInput.value) || 0;\r\n    data.visitantePJ = parseInt(visitantePJInput.value) || 0;\r\n\r\n    saveActiveSnapshot();\r\n    onChanged();\r\n  }\r\n\r\n  function handleFormatChange() {\r\n    data.formatoJugador = formatoJugadorSelect.value;\r\n    if (data.localJugador) {\r\n      data.localNombre = formatPlayerName(data.localJugador, data.formatoJugador);\r\n      localNombreInput.value = data.localNombre;\r\n    }\r\n    if (data.visitanteJugador) {\r\n      data.visitanteNombre = formatPlayerName(data.visitanteJugador, data.formatoJugador);\r\n      visitanteNombreInput.value = data.visitanteNombre;\r\n    }\r\n    saveActiveSnapshot();\r\n    onChanged();\r\n  }\r\n\r\n  // \"handleLocalNombreTyped\"/\"handleVisitanteNombreTyped\" (2026-09-10):\r\n  // tipear a mano en el input de nombre desvincula el \"jugadorId\" estable\r\n  // (si habia uno, ver handleLocalRosterSelect arriba) -- sin esto, un\r\n  // ACTUALIZAR DESDE ARGENTINASTREAMERS.COM posterior sincronizaria contra\r\n  // el jugador VIEJO aunque el nombre visible ya sea otro.\r\n  function handleLocalNombreTyped() {\r\n    data.localJugadorId = '';\r\n    handleInput();\r\n  }\r\n  function handleVisitanteNombreTyped() {\r\n    data.visitanteJugadorId = '';\r\n    handleInput();\r\n  }\r\n\r\n  // Listeners\r\n  localNombreInput.addEventListener('input', handleLocalNombreTyped);\r\n  localGInput.addEventListener('input', handleInput);\r\n  localAInput.addEventListener('input', handleInput);\r\n  localPJInput.addEventListener('input', handleInput);\r\n\r\n  visitanteNombreInput.addEventListener('input', handleVisitanteNombreTyped);\r\n  visitanteGInput.addEventListener('input', handleInput);\r\n  visitanteAInput.addEventListener('input', handleInput);\r\n  visitantePJInput.addEventListener('input', handleInput);\r\n  formatoJugadorSelect.addEventListener('change', handleFormatChange);\r\n  localRosterSelect.addEventListener('change', handleLocalRosterSelect);\r\n  visitanteRosterSelect.addEventListener('change', handleVisitanteRosterSelect);\r\n\r\n  // Retornar limpieza\r\n  return () => {\r\n    disposed = true;\r\n    localNombreInput.removeEventListener('input', handleLocalNombreTyped);\r\n    localGInput.removeEventListener('input', handleInput);\r\n    localAInput.removeEventListener('input', handleInput);\r\n    localPJInput.removeEventListener('input', handleInput);\r\n\r\n    visitanteNombreInput.removeEventListener('input', handleVisitanteNombreTyped);\r\n    visitanteGInput.removeEventListener('input', handleInput);\r\n    visitanteAInput.removeEventListener('input', handleInput);\r\n    visitantePJInput.removeEventListener('input', handleInput);\r\n    formatoJugadorSelect.removeEventListener('change', handleFormatChange);\r\n    localRosterSelect.removeEventListener('change', handleLocalRosterSelect);\r\n    visitanteRosterSelect.removeEventListener('change', handleVisitanteRosterSelect);\r\n  };\r\n}\r\n","http://localhost:4430/master-control/js/resultados-panel.js","import { TEAM_OPTIONS } from '../../shared/teams.js';\r\nimport { createGlaTorneoSourceNote, glaTorneoLabel } from './gla-torneo-source.js';\r\n// EQUIPOS VISIBLES (2026-10-21, pedido explicito del usuario, SOLO GLA):\r\n// un equipo oculto en EQUIPOS no se ofrece para nuevas selecciones; el ya\r\n// elegido se sigue mostrando (ocultar no borra ni rompe estados guardados).\r\nfunction isHiddenGlaOption(opt, currentId) {\r\n  return document.body.dataset.theme === 'gla' && opt.visible === false && opt.id !== (currentId || '');\r\n}\r\n\r\nimport { mountAdjustControl } from './field-editors.js';\r\nimport { renderPresetsControl } from './presets-helper.js';\r\nimport { renderCompositionControl } from './composition-control.js';\r\n\r\n// Claves que forman el snapshot COMPLETO del modulo para \"GUARDAR PRESET\r\n// COMPLETO\" (2026-08-16, pedido urgente del usuario: \"quiero un snapshot\r\n// COMPLETO... no quiero guardar solamente equipos/resultados\"). Incluye\r\n// datos (encuentros, tanda, posicion, titulo general) Y AJUSTES VISUALES\r\n// (textAdjust por columna + composicion global) para que cargar el preset\r\n// devuelva el modulo exactamente a como estaba, con o sin el modulo al aire\r\n// (se aplica via el mismo onDirty -> UPDATE que ya usa el resto del panel,\r\n// nunca TAKE, asi que si Resultados esta al aire no hay ningun corte).\r\nconst SNAPSHOT_KEYS = [\r\n  'encuentros', 'tanda', 'posicion', 'titulo', 'textAdjust',\r\n  'compositionOffsetX', 'compositionOffsetY', 'compositionScale',\r\n  'faseWeb', 'snapshotsWeb', 'ultimaActualizacionWeb',\r\n];\r\n\r\nfunction captureSnapshot(data) {\r\n  const snap = {};\r\n  for (const key of SNAPSHOT_KEYS) snap[key] = data[key];\r\n  return JSON.parse(JSON.stringify(snap));\r\n}\r\n\r\n// \"AJUSTE DE TEXTOS\" (2026-08-15, auditoria completa): Resultados es una\r\n// tabla dinamica (hasta 9 encuentros, 6 visibles a la vez por tanda) -- un\r\n// unico ajuste por COLUMNA se aplica a todos los encuentros visibles,\r\n// mismo criterio que Posiciones/Goleadores. \"estado\" y \"estadoFullscreen\"\r\n// son elementos DISTINTOS en el DOM (ver program/js/renderers/\r\n// sideTable.js): el primero se ve cuando hay goles cargados, el segundo\r\n// cuando el encuentro todavia no tiene resultado (PROXIMO/HORA/etc.) -- se\r\n// ajustan por separado porque tienen su propia caja/tama\u00F1o de fuente.\r\nconst ADJUST_COLUMNS = [\r\n  { key: 'golLocal', label: 'Columna Gol Local' },\r\n  { key: 'golVisitante', label: 'Columna Gol Visitante' },\r\n  { key: 'estado', label: 'Estado (modo compacto, con goles)' },\r\n  { key: 'estadoFullscreen', label: 'Estado (modo fullscreen, sin goles)' },\r\n  { key: 'tituloBracket', label: 'T\u00EDtulo de encuentro (arriba del estado/hora)' },\r\n];\r\n\r\nconst POSICIONES = [\r\n  { id: 'placaL', label: 'PLACA L' },\r\n  { id: 'fullscreenDerecha', label: 'FULLSCREEN \u2014 ABAJO DERECHA' },\r\n  { id: 'fullscreenIzquierda', label: 'FULLSCREEN \u2014 ABAJO IZQUIERDA' },\r\n];\r\n\r\nconst ESTADOS = [\r\n  { id: 'final', label: 'FINAL' },\r\n  { id: 'proximo', label: 'PR\u00D3XIMO' },\r\n  { id: 'entretiempo', label: 'ENTRETIEMPO' },\r\n  { id: 'en_juego', label: 'EN JUEGO' },\r\n  { id: 'suspendido', label: 'SUSPENDIDO' },\r\n  { id: 'hora', label: 'HORA ESPEC\u00CDFICA' },\r\n];\r\n\r\nconst MAX_ENCUENTROS = 9;\r\nconst VISIBLE_ENCUENTROS = 6;\r\n\r\n// PARTIDOS: MODOS EVENTO / SORTEO (2026-10-22, pedido explicito del\r\n// usuario, SOLO GLA -- ver syncBracketCrestsFromGrupos en server/state.js).\r\n// \"encuentros\" es siempre la lista del modo ACTIVO; la del otro modo queda\r\n// guardada en \"partidosEvento\"/\"partidosSorteo\" y se intercambia al cambiar\r\n// de modo, asi EVENTO vuelve exactamente como estaba. En SORTEO los equipos\r\n// los define GRUPOS (slot -> equipo, lo resuelve el servidor): aca solo se\r\n// muestran, y no se agregan/eliminan partidos (son exactamente 9).\r\n// \"sorteo\" se muestra como S\u00C1BADO (2026-10-23, pedido explicito: solo el\r\n// nombre visible; id interno, estado y datos guardados sin cambios).\r\nconst MODOS_PARTIDOS = [\r\n  { id: 'evento', label: 'EVENTO' },\r\n  { id: 'sorteo', label: 'S\u00C1BADO' },\r\n];\r\n// Solo para mostrar el cruce de cada partido (la fuente es el servidor).\r\nconst SORTEO_SLOTS = [\r\n  ['A1', 'A2'], ['B1', 'B2'], ['A3', 'B3'], ['A2', 'B2'], ['B1', 'B3'],\r\n  ['A1', 'A3'], ['B2', 'B3'], ['A2', 'A3'], ['A1', 'B1'],\r\n];\r\n// S\u00C1BADO (2026-10-23): primer partido MANUAL de las 11:00, editable y fuera\r\n// de la sincronizacion con Grupos (ver server/state.js).\r\nconst SABADO_MANUAL_ID = 'sabado-manual-1100';\r\nfunction sorteoAutoNumber(encuentro) {\r\n  const match = /^sorteo-p(\\d+)$/.exec(encuentro?.id || '');\r\n  return match ? Number(match[1]) : null;\r\n}\r\n// Segunda tanda: 4 en adelante (7-9 partidos, como siempre) o 5-10 (10).\r\nfunction tanda2Desde(count) {\r\n  return Math.max(4, count - VISIBLE_ENCUENTROS + 1);\r\n}\r\nfunction partidosStashKey(modo) {\r\n  return modo === 'sorteo' ? 'partidosSorteo' : 'partidosEvento';\r\n}\r\n\r\nexport function renderResultadosPanel(container, data, onDirty, saveOptions) {\r\n  const root = document.createElement('div');\r\n  root.className = 'resultados-editor';\r\n  container.appendChild(root);\r\n\r\n  // Inicializar encuentros si no existen\r\n  if (!data.encuentros) {\r\n    data.encuentros = [\r\n      { teamA: '', teamB: '', scoreA: '0', scoreB: '0', status: 'final', hora: '', titulo: '', penalesA: '', penalesB: '' }\r\n    ];\r\n  }\r\n  // Encuentros creados antes de agregar \"titulo\" (2026-08-15) no lo tienen.\r\n  for (const encuentro of data.encuentros) {\r\n    if (typeof encuentro.titulo !== 'string') encuentro.titulo = '';\r\n    if (typeof encuentro.penalesA !== 'string') encuentro.penalesA = '';\r\n    if (typeof encuentro.penalesB !== 'string') encuentro.penalesB = '';\r\n  }\r\n  if (!data.snapshotsWeb || typeof data.snapshotsWeb !== 'object') data.snapshotsWeb = {};\r\n  if (!data.visualByFase || typeof data.visualByFase !== 'object') data.visualByFase = {};\r\n  let syncStatus = null;\r\n  const isGla = document.body.dataset.theme === 'gla';\r\n\r\n  function modoActual() {\r\n    return isGla && data.modoPartidos === 'sorteo' ? 'sorteo' : 'evento';\r\n  }\r\n  function cambiarModo(nuevo) {\r\n    const actual = modoActual();\r\n    if (nuevo === actual) return;\r\n    data[partidosStashKey(actual)] = JSON.parse(JSON.stringify({ encuentros: data.encuentros, tanda: data.tanda }));\r\n    const guardado = data[partidosStashKey(nuevo)];\r\n    data.encuentros = guardado && Array.isArray(guardado.encuentros) ? guardado.encuentros : [];\r\n    data.tanda = guardado?.tanda || 'tanda1';\r\n    data[partidosStashKey(nuevo)] = null;\r\n    data.modoPartidos = nuevo;\r\n    syncStatus = null;\r\n    onDirty();\r\n    render();\r\n  }\r\n\r\n  // AJUSTES VISUALES INDEPENDIENTES POR FASE (2026-08-16, pedido urgente\r\n  // del usuario: mover flechas/escala en PLAYOFFS no debe pisar ni\r\n  // depender de FASE DE GRUPOS y viceversa). El mecanismo UNIVERSAL de\r\n  // composicion (program/js/main.js \"applyComposition\", master-control/js/\r\n  // main.js \"renderCompositionControl\") sigue leyendo/escribiendo un unico\r\n  // set de claves activas (\"compositionOffsetX/Y/Scale\", \"textAdjust\")\r\n  // -- no se toca ese mecanismo. Lo que se agrega es un swap: antes de\r\n  // cambiar de fase se guarda el ajuste activo bajo la fase VIEJA en\r\n  // \"data.visualByFase\", y se carga (o resetea a neutro si es la primera\r\n  // vez) el de la fase NUEVA en esas mismas claves activas.\r\n  function snapshotVisual() {\r\n    return {\r\n      compositionOffsetX: data.compositionOffsetX || 0,\r\n      compositionOffsetY: data.compositionOffsetY || 0,\r\n      compositionScale: data.compositionScale !== undefined ? data.compositionScale : 1,\r\n      textAdjust: JSON.parse(JSON.stringify(data.textAdjust || {})),\r\n    };\r\n  }\r\n  function applyVisual(visual) {\r\n    data.compositionOffsetX = visual.compositionOffsetX;\r\n    data.compositionOffsetY = visual.compositionOffsetY;\r\n    data.compositionScale = visual.compositionScale;\r\n    data.textAdjust = visual.textAdjust;\r\n  }\r\n  function refreshCompositionWidget() {\r\n    const compositionContainer = document.getElementById('composition-container');\r\n    if (compositionContainer) {\r\n      renderCompositionControl(compositionContainer, data, onDirty, {\r\n        onSave: saveOptions?.onSave,\r\n        isPendingSave: saveOptions?.isPendingSave,\r\n        isConnected: saveOptions?.isConnected,\r\n        elementSpec: { kind: 'composition', dataPath: [], xKey: 'compositionOffsetX', yKey: 'compositionOffsetY', scaleKey: 'compositionScale' },\r\n      });\r\n    }\r\n  }\r\n\r\n  async function syncFromWeb(fase) {\r\n    syncStatus = { kind: 'loading', fase, text: 'Actualizando...' };\r\n    render();\r\n    try {\r\n      const response = await fetch(`/api/resultados/${fase}/sync-web`, { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n\r\n      const previousFase = data.faseWeb;\r\n      if (previousFase && previousFase !== fase) {\r\n        data.visualByFase[previousFase] = snapshotVisual();\r\n      }\r\n      const savedForNewFase = data.visualByFase[fase];\r\n      const neutralTextAdjust = Object.fromEntries(\r\n        Object.keys(data.textAdjust || {}).map((k) => [k, { dx: 0, dy: 0, dSize: 0 }])\r\n      );\r\n      applyVisual(savedForNewFase || {\r\n        compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n        textAdjust: neutralTextAdjust,\r\n      });\r\n\r\n      data.faseWeb = fase;\r\n      data.snapshotsWeb = body.snapshotsWeb || data.snapshotsWeb;\r\n      // DATOS vs AJUSTES VISUALES (2026-08-16, pedido urgente del usuario):\r\n      // equipos/goles/estado/hora SIEMPRE vienen frescos de la web, pero un\r\n      // titulo que el operador ya haya personalizado a mano (distinto del\r\n      // default del slot, ej. cambio \"SEMIS 1\" por \"SEMIFINAL A\") no debe\r\n      // perderse en la proxima sincronizacion -- se matchea por \"id\" (los\r\n      // slots de playoffs traen id estable, ver server/glaFutbolSync.js);\r\n      // sin \"id\" (fase de grupos) no hay como matchear, se usa el dato\r\n      // nuevo tal cual (comportamiento sin cambios para ese caso).\r\n      const previousById = new Map(\r\n        (Array.isArray(data.encuentros) ? data.encuentros : [])\r\n          .filter((e) => e && e.id)\r\n          .map((e) => [e.id, e])\r\n      );\r\n      data.encuentros = body.encuentros.map((enc) => {\r\n        const previous = enc.id ? previousById.get(enc.id) : null;\r\n        if (previous && previous.titulo && previous.titulo !== enc.titulo) {\r\n          return { ...enc, titulo: previous.titulo };\r\n        }\r\n        return enc;\r\n      });\r\n      data.tanda = 'tanda1';\r\n      data.ultimaActualizacionWeb = body.ultimaActualizacionWeb;\r\n      syncStatus = { kind: 'success', fase, text: `RESULTADOS ACTUALIZADOS${body.edicion ? ` (${body.edicion.label})` : ''}`, unmatchedTeams: body.unmatchedTeams || [] };\r\n      onDirty();\r\n      // El widget de \"AJUSTE DE COMPOSICI\u00D3N\" lo monta main.js aparte, en\r\n      // \"#composition-container\" -- sin este refresh el dato queda bien\r\n      // swapeado pero el readout en pantalla se ve viejo (mismo fix que\r\n      // ya se aplico para \"cargar preset completo\").\r\n      refreshCompositionWidget();\r\n    } catch (error) {\r\n      syncStatus = { kind: 'error', fase, text: `ERROR AL ACTUALIZAR \u2014 ${error.message}`, detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n    const isSorteo = modoActual() === 'sorteo';\r\n\r\n    if (isGla) {\r\n      const modoField = document.createElement('div');\r\n      modoField.className = 'field';\r\n      const modoLabel = document.createElement('label');\r\n      modoLabel.textContent = 'MODO';\r\n      modoField.appendChild(modoLabel);\r\n      const modoSelect = document.createElement('select');\r\n      modoSelect.setAttribute('aria-label', 'MODO');\r\n      for (const opt of MODOS_PARTIDOS) {\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        modoSelect.appendChild(option);\r\n      }\r\n      modoSelect.value = modoActual();\r\n      modoSelect.addEventListener('change', () => cambiarModo(modoSelect.value));\r\n      modoField.appendChild(modoSelect);\r\n      root.appendChild(modoField);\r\n    }\r\n\r\n    // \"A) CRONOGRAMA / B) CARGA MANUAL\" (2026-09-27, pedido explicito del\r\n    // usuario: \"dos secciones claras\"). Sin rehacer el panel -- el\r\n    // mecanismo ya es exactamente ese (web llena los campos, despues son\r\n    // inputs editables normales, nunca se vuelven a pisar salvo que se\r\n    // aprete el boton de nuevo) -- esto solo etiqueta con encabezados lo\r\n    // que ya funciona asi, para que quede visualmente separado.\r\n    // SORTEO: sin \"ACTUALIZAR DESDE WEB\" ni presets completos (pisarian el\r\n    // fixture de 9 partidos que arma GRUPOS).\r\n    const cronogramaHeading = document.createElement('h3');\r\n    cronogramaHeading.textContent = 'A) CRONOGRAMA \u2014 ACTUALIZAR DESDE WEB';\r\n    cronogramaHeading.style.marginBottom = '6px';\r\n    if (!isSorteo) root.appendChild(cronogramaHeading);\r\n\r\n    const syncRow = document.createElement('div');\r\n    syncRow.className = 'performance-sync resultados-sync';\r\n    for (const [fase, label] of [\r\n      ['grupos', 'ACTUALIZAR RESULTADOS DE FASE DE GRUPOS'],\r\n      ['playoffs', 'ACTUALIZAR RESULTADOS DE PLAYOFFS'],\r\n    ]) {\r\n      const button = document.createElement('button');\r\n      button.type = 'button';\r\n      button.className = 'performance-sync-btn';\r\n      button.textContent = label;\r\n      button.disabled = syncStatus?.kind === 'loading';\r\n      button.addEventListener('click', () => syncFromWeb(fase));\r\n      syncRow.appendChild(button);\r\n    }\r\n    // ACTUALIZADOR DE DATOS (2026-10-21): edicion del torneo de la que salen.\r\n    syncRow.appendChild(createGlaTorneoSourceNote());\r\n    if (syncStatus) {\r\n      const status = document.createElement('span');\r\n      status.className = `performance-sync-status ${syncStatus.kind}`;\r\n      status.textContent = syncStatus.text;\r\n      if (syncStatus.detail) status.title = syncStatus.detail;\r\n      syncRow.appendChild(status);\r\n    }\r\n    if (!isSorteo) root.appendChild(syncRow);\r\n    if (!isSorteo && syncStatus?.unmatchedTeams?.length) {\r\n      const warning = document.createElement('p');\r\n      warning.className = 'performance-sync-warning';\r\n      warning.textContent = `Sin equipo local equivalente para: ${syncStatus.unmatchedTeams.join(', ')}`;\r\n      root.appendChild(warning);\r\n    }\r\n\r\n    // --- Preset completo (2026-08-16, pedido urgente del usuario): un\r\n    // snapshot de TODO el modulo (encuentros, tanda, posicion, titulo\r\n    // general, textAdjust por columna, composicion global) para volver\r\n    // exactamente al estado visual+datos de cuando se guardo, incluso\r\n    // despues de \"ACTUALIZAR PLAYOFFS\" + acomodar todo a mano. Usa el\r\n    // mismo helper/infraestructura de CARGAR/RENOMBRAR/ELIMINAR que ya\r\n    // usan los demas modulos (ver presets-helper.js).\r\n    const presetsBox = document.createElement('div');\r\n    renderPresetsControl(presetsBox, data, {\r\n      presetKey: 'completePresets',\r\n      title: 'PRESET COMPLETO DE RESULTADOS (DATOS + AJUSTES VISUALES)',\r\n      buttons: [\r\n        {\r\n          label: 'GUARDAR PRESET COMPLETO',\r\n          type: 'complete',\r\n          getFields: () => ({\r\n            resumen: `${data.encuentros.length} encuentro(s) \u2014 ${data.tanda === 'tanda2' ? 'partidos 4\u20139' : 'partidos 1\u20136'}`,\r\n            __snapshot: captureSnapshot(data),\r\n          }),\r\n        },\r\n      ],\r\n      onApply: (fields) => {\r\n        const snap = fields.__snapshot;\r\n        if (!snap) return;\r\n        Object.assign(data, JSON.parse(JSON.stringify(snap)));\r\n        render();\r\n        // \"AJUSTE DE COMPOSICI\u00D3N\" de este modulo lo monta main.js aparte,\r\n        // en \"#composition-container\" (fuera del arbol que reconstruye\r\n        // este panel) -- sin este refresh, el dato queda bien restaurado\r\n        // pero el readout de flechas visible en pantalla se ve viejo hasta\r\n        // el proximo click o cambio de pesta\u00F1a. Mismo llamado/target que ya\r\n        // usa main.js para Resultados (no es \"varCheck\", que usa dos cajas\r\n        // con keys custom).\r\n        const compositionContainer = document.getElementById('composition-container');\r\n        if (compositionContainer) {\r\n          renderCompositionControl(compositionContainer, data, onDirty);\r\n        }\r\n      },\r\n      onDirty,\r\n    });\r\n    if (!isSorteo) root.appendChild(presetsBox);\r\n\r\n    // --- Posici\u00F3n ---\r\n    const posicionField = document.createElement('div');\r\n    posicionField.className = 'field';\r\n    const posicionLabel = document.createElement('label');\r\n    posicionLabel.textContent = 'Posici\u00F3n';\r\n    posicionField.appendChild(posicionLabel);\r\n    \r\n    const posicionSelect = document.createElement('select');\r\n    for (const opt of POSICIONES) {\r\n      const option = document.createElement('option');\r\n      option.value = opt.id;\r\n      option.textContent = opt.label;\r\n      posicionSelect.appendChild(option);\r\n    }\r\n    posicionSelect.value = data.posicion || 'placaL';\r\n    posicionSelect.addEventListener('change', () => {\r\n      data.posicion = posicionSelect.value;\r\n      onDirty();\r\n    });\r\n    posicionField.appendChild(posicionSelect);\r\n    root.appendChild(posicionField);\r\n\r\n    // --- T\u00EDtulo General ---\r\n    const tituloField = document.createElement('div');\r\n    tituloField.className = 'field';\r\n    const tituloLabel = document.createElement('label');\r\n    tituloLabel.textContent = 'T\u00EDtulo General';\r\n    tituloField.appendChild(tituloLabel);\r\n    \r\n    const tituloInput = document.createElement('input');\r\n    tituloInput.type = 'text';\r\n    tituloInput.value = data.titulo ?? 'RESULTADOS';\r\n    tituloInput.placeholder = 'Escribe el t\u00EDtulo superior...';\r\n    tituloInput.addEventListener('input', () => {\r\n      data.titulo = tituloInput.value;\r\n      onDirty();\r\n    });\r\n    tituloField.appendChild(tituloInput);\r\n    mountAdjustControl(tituloField, data, 'titulo', onDirty, saveOptions);\r\n    root.appendChild(tituloField);\r\n\r\n    // --- Tanda / vista ---\r\n    // Maximo 6 brackets a la vez en Program (composicion aprobada, no se\r\n    // achica para hacer entrar mas): con 7-9 encuentros, esta tanda decide\r\n    // que ventana de 6 se muestra -- tanda1 = partidos 1-6, tanda2 =\r\n    // partidos 4 en adelante (los mismos 4/5/6 suben y entran 7/8/9 desde\r\n    // abajo, ver program/js/renderers/sideTable.js). Sin rotacion\r\n    // automatica: el control manual es el que pidio el usuario que exista\r\n    // si o si, y evita meter un timer sincronizado por red.\r\n    const tandaField = document.createElement('div');\r\n    tandaField.className = 'field';\r\n    const tandaLabel = document.createElement('label');\r\n    tandaLabel.textContent = 'TANDA / VISTA';\r\n    tandaField.appendChild(tandaLabel);\r\n\r\n    const tandaSelect = document.createElement('select');\r\n    tandaSelect.setAttribute('aria-label', 'TANDA / VISTA');\r\n\r\n    const tanda1Option = document.createElement('option');\r\n    tanda1Option.value = 'tanda1';\r\n    tanda1Option.textContent = 'PARTIDOS 1\u20136';\r\n    tandaSelect.appendChild(tanda1Option);\r\n\r\n    const tanda2Option = document.createElement('option');\r\n    tanda2Option.value = 'tanda2';\r\n    tanda2Option.textContent = `PARTIDOS ${tanda2Desde(data.encuentros.length)}\u2013${Math.max(data.encuentros.length, 9)}`;\r\n    tanda2Option.disabled = data.encuentros.length <= VISIBLE_ENCUENTROS;\r\n    tandaSelect.appendChild(tanda2Option);\r\n\r\n    tandaSelect.value = data.encuentros.length > VISIBLE_ENCUENTROS && data.tanda === 'tanda2'\r\n      ? 'tanda2'\r\n      : 'tanda1';\r\n    tandaSelect.addEventListener('change', () => {\r\n      data.tanda = tandaSelect.value;\r\n      onDirty();\r\n    });\r\n    tandaField.appendChild(tandaSelect);\r\n    root.appendChild(tandaField);\r\n\r\n    // --- Secci\u00F3n de Encuentros ---\r\n    const section = document.createElement('section');\r\n    section.className = 'resultados-encuentros-section';\r\n    \r\n    const heading = document.createElement('h3');\r\n    heading.textContent = isSorteo\r\n      ? 'S\u00C1BADO \u2014 10 PARTIDOS (11:00 manual + 9 seg\u00FAn GRUPOS)'\r\n      : 'B) CARGA MANUAL / EDICI\u00D3N \u2014 ENCUENTROS';\r\n    heading.style.marginTop = '20px';\r\n    heading.style.marginBottom = '4px';\r\n    section.appendChild(heading);\r\n    const manualHint = document.createElement('p');\r\n    manualHint.textContent = isSorteo\r\n      ? 'El partido de las 11:00 es manual: todo se edita ac\u00E1 y Grupos no lo toca. En los otros 9 los equipos salen de GRUPOS (slots del sorteo A1\u2013A3 / B1\u2013B3) y se actualizan solos; hora, t\u00EDtulo, estado y resultado se editan ac\u00E1.'\r\n      : 'Edit\u00E1 ac\u00E1 cualquier campo (equipo, hora, t\u00EDtulo, estado) sea que vino de \"ACTUALIZAR DESDE WEB\" o lo cargaste a mano. No se pisa hasta que vuelvas a apretar ACTUALIZAR DESDE WEB.';\r\n    manualHint.style.fontSize = '11px';\r\n    manualHint.style.opacity = '0.75';\r\n    manualHint.style.marginTop = '0';\r\n    manualHint.style.marginBottom = '10px';\r\n    section.appendChild(manualHint);\r\n\r\n    data.encuentros.forEach((encuentro, index) => {\r\n      const card = document.createElement('div');\r\n      card.className = 'resultados-encuentro-card';\r\n      card.style.border = '1px solid rgba(255, 255, 255, 0.1)';\r\n      card.style.padding = '15px';\r\n      card.style.marginBottom = '15px';\r\n      card.style.borderRadius = '6px';\r\n      card.style.background = 'rgba(255, 255, 255, 0.02)';\r\n\r\n      const titleRow = document.createElement('div');\r\n      titleRow.style.display = 'flex';\r\n      titleRow.style.justifyContent = 'space-between';\r\n      titleRow.style.alignItems = 'center';\r\n      titleRow.style.marginBottom = '10px';\r\n\r\n      const cardTitle = document.createElement('h4');\r\n      const autoNumber = isSorteo ? sorteoAutoNumber(encuentro) : null;\r\n      const isAuto = autoNumber !== null && !!SORTEO_SLOTS[autoNumber - 1];\r\n      if (isSorteo && encuentro.id === SABADO_MANUAL_ID) {\r\n        cardTitle.textContent = `Partido ${index + 1} \u2014 MANUAL (no depende de Grupos)`;\r\n      } else if (isAuto) {\r\n        cardTitle.textContent = `Partido ${index + 1} \u2014 P${autoNumber}: ${SORTEO_SLOTS[autoNumber - 1][0]} vs ${SORTEO_SLOTS[autoNumber - 1][1]}`;\r\n      } else {\r\n        cardTitle.textContent = `Encuentro ${index + 1}`;\r\n      }\r\n      cardTitle.style.margin = '0';\r\n      titleRow.appendChild(cardTitle);\r\n\r\n      // Bot\u00F3n Eliminar\r\n      const deleteBtn = document.createElement('button');\r\n      deleteBtn.type = 'button';\r\n      deleteBtn.textContent = 'ELIMINAR';\r\n      deleteBtn.className = 'btn-danger';\r\n      deleteBtn.style.padding = '4px 8px';\r\n      deleteBtn.style.fontSize = '12px';\r\n      deleteBtn.style.cursor = 'pointer';\r\n      \r\n      // Permitir borrar siempre que haya al menos 1 encuentro\r\n      if (data.encuentros.length <= 1) {\r\n        deleteBtn.disabled = true;\r\n        deleteBtn.style.opacity = '0.5';\r\n        deleteBtn.style.cursor = 'not-allowed';\r\n      } else {\r\n        deleteBtn.addEventListener('click', () => {\r\n          data.encuentros.splice(index, 1);\r\n          if (data.encuentros.length <= VISIBLE_ENCUENTROS) data.tanda = 'tanda1';\r\n          onDirty();\r\n          render();\r\n        });\r\n      }\r\n      if (!isSorteo) titleRow.appendChild(deleteBtn);\r\n      card.appendChild(titleRow);\r\n\r\n      // Fila de Equipos y Goles\r\n      const teamsRow = document.createElement('div');\r\n      teamsRow.style.display = 'grid';\r\n      teamsRow.style.gridTemplateColumns = '1fr 60px 60px 1fr';\r\n      teamsRow.style.gap = '10px';\r\n      teamsRow.style.marginBottom = '10px';\r\n\r\n      // Equipo Local\r\n      const localSelect = document.createElement('select');\r\n      localSelect.setAttribute('aria-label', `Equipo Local, encuentro ${index + 1}`);\r\n      for (const opt of TEAM_OPTIONS) {\r\n        if (isHiddenGlaOption(opt, encuentro.teamA)) continue;\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        localSelect.appendChild(option);\r\n      }\r\n      localSelect.value = encuentro.teamA || '';\r\n      localSelect.disabled = isAuto;\r\n      localSelect.addEventListener('change', () => {\r\n        encuentro.teamA = localSelect.value;\r\n        onDirty();\r\n      });\r\n\r\n      // Goles Local\r\n      const localScore = document.createElement('input');\r\n      localScore.type = 'text';\r\n      localScore.value = encuentro.scoreA ?? '0';\r\n      localScore.placeholder = '0';\r\n      localScore.style.textAlign = 'center';\r\n      localScore.addEventListener('input', () => {\r\n        encuentro.scoreA = localScore.value;\r\n        onDirty();\r\n      });\r\n\r\n      // Goles Visitante\r\n      const visitorScore = document.createElement('input');\r\n      visitorScore.type = 'text';\r\n      visitorScore.value = encuentro.scoreB ?? '0';\r\n      visitorScore.placeholder = '0';\r\n      visitorScore.style.textAlign = 'center';\r\n      visitorScore.addEventListener('input', () => {\r\n        encuentro.scoreB = visitorScore.value;\r\n        onDirty();\r\n      });\r\n\r\n      // Equipo Visitante\r\n      const visitorSelect = document.createElement('select');\r\n      visitorSelect.setAttribute('aria-label', `Equipo Visitante, encuentro ${index + 1}`);\r\n      for (const opt of TEAM_OPTIONS) {\r\n        if (isHiddenGlaOption(opt, encuentro.teamB)) continue;\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        visitorSelect.appendChild(option);\r\n      }\r\n      visitorSelect.value = encuentro.teamB || '';\r\n      visitorSelect.disabled = isAuto;\r\n      visitorSelect.addEventListener('change', () => {\r\n        encuentro.teamB = visitorSelect.value;\r\n        onDirty();\r\n      });\r\n\r\n      teamsRow.appendChild(localSelect);\r\n      teamsRow.appendChild(localScore);\r\n      teamsRow.appendChild(visitorScore);\r\n      teamsRow.appendChild(visitorSelect);\r\n      card.appendChild(teamsRow);\r\n\r\n      // Penales (2026-08-16, pedido explicito del usuario: soportar\r\n      // \"6(3) - 6(1)\") -- OPCIONAL: si cualquiera de los dos queda vacio,\r\n      // Program muestra solo el resultado normal, sin parentesis (ver\r\n      // program/js/renderers/sideTable.js). Fila propia, chica, debajo de\r\n      // GOLES para no confundir con el resultado principal.\r\n      const penalesRow = document.createElement('div');\r\n      penalesRow.style.display = 'grid';\r\n      penalesRow.style.gridTemplateColumns = '1fr 1fr';\r\n      penalesRow.style.gap = '10px';\r\n      penalesRow.style.marginBottom = '10px';\r\n\r\n      const penalesLocalField = document.createElement('div');\r\n      penalesLocalField.className = 'field';\r\n      const penalesLocalLabel = document.createElement('label');\r\n      penalesLocalLabel.textContent = 'Penales local (opcional)';\r\n      const penalesLocalInput = document.createElement('input');\r\n      penalesLocalInput.type = 'text';\r\n      penalesLocalInput.value = encuentro.penalesA ?? '';\r\n      penalesLocalInput.placeholder = 'Ej: 3';\r\n      penalesLocalInput.style.textAlign = 'center';\r\n      penalesLocalInput.addEventListener('input', () => {\r\n        encuentro.penalesA = penalesLocalInput.value;\r\n        onDirty();\r\n      });\r\n      penalesLocalField.appendChild(penalesLocalLabel);\r\n      penalesLocalField.appendChild(penalesLocalInput);\r\n\r\n      const penalesVisitanteField = document.createElement('div');\r\n      penalesVisitanteField.className = 'field';\r\n      const penalesVisitanteLabel = document.createElement('label');\r\n      penalesVisitanteLabel.textContent = 'Penales visitante (opcional)';\r\n      const penalesVisitanteInput = document.createElement('input');\r\n      penalesVisitanteInput.type = 'text';\r\n      penalesVisitanteInput.value = encuentro.penalesB ?? '';\r\n      penalesVisitanteInput.placeholder = 'Ej: 1';\r\n      penalesVisitanteInput.style.textAlign = 'center';\r\n      penalesVisitanteInput.addEventListener('input', () => {\r\n        encuentro.penalesB = penalesVisitanteInput.value;\r\n        onDirty();\r\n      });\r\n      penalesVisitanteField.appendChild(penalesVisitanteLabel);\r\n      penalesVisitanteField.appendChild(penalesVisitanteInput);\r\n\r\n      penalesRow.appendChild(penalesLocalField);\r\n      penalesRow.appendChild(penalesVisitanteField);\r\n      card.appendChild(penalesRow);\r\n\r\n      // T\u00EDtulo individual (aparece arriba del estado/hora en Program, ej.\r\n      // \"SEMIS 1\" / \"GRAN FINAL\" -- ver program/js/renderers/sideTable.js).\r\n      // La posicion/tama\u00F1o de este texto se ajusta por columna, junto con\r\n      // el resto de \"AJUSTE DE TEXTOS\" mas abajo (mismo criterio que\r\n      // golLocal/estado/etc.).\r\n      const tituloEncField = document.createElement('div');\r\n      tituloEncField.className = 'field';\r\n      const tituloEncLabel = document.createElement('label');\r\n      tituloEncLabel.textContent = 'T\u00EDtulo del encuentro';\r\n      tituloEncField.appendChild(tituloEncLabel);\r\n\r\n      const tituloEncInput = document.createElement('input');\r\n      tituloEncInput.type = 'text';\r\n      tituloEncInput.value = encuentro.titulo ?? '';\r\n      tituloEncInput.placeholder = 'Ej: SEMIS 1, GRAN FINAL...';\r\n      tituloEncInput.setAttribute('aria-label', `T\u00EDtulo, encuentro ${index + 1}`);\r\n      tituloEncInput.addEventListener('input', () => {\r\n        encuentro.titulo = tituloEncInput.value;\r\n        onDirty();\r\n      });\r\n      tituloEncField.appendChild(tituloEncInput);\r\n      card.appendChild(tituloEncField);\r\n\r\n      // Fila de Estado e Info adicional\r\n      const statusRow = document.createElement('div');\r\n      statusRow.style.display = 'grid';\r\n      statusRow.style.gridTemplateColumns = '1fr 1fr';\r\n      statusRow.style.gap = '10px';\r\n\r\n      // Selector de Estado\r\n      const statusSelect = document.createElement('select');\r\n      statusSelect.setAttribute('aria-label', `Estado, encuentro ${index + 1}`);\r\n      for (const opt of ESTADOS) {\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        statusSelect.appendChild(option);\r\n      }\r\n      statusSelect.value = encuentro.status || 'final';\r\n\r\n      // Campo de hora (se habilita solo si es HORA ESPEC\u00CDFICA)\r\n      const horaInput = document.createElement('input');\r\n      horaInput.type = 'text';\r\n      horaInput.value = encuentro.hora ?? '';\r\n      horaInput.placeholder = 'Ej: 18:00 o 20:30';\r\n      horaInput.style.display = statusSelect.value === 'hora' ? 'block' : 'none';\r\n\r\n      statusSelect.addEventListener('change', () => {\r\n        encuentro.status = statusSelect.value;\r\n        horaInput.style.display = statusSelect.value === 'hora' ? 'block' : 'none';\r\n        \r\n        // L\u00F3gica visual del estado: Ocultar o deshabilitar goles en los inputs si corresponde\r\n        const ocultaGoles = statusSelect.value === 'proximo' || statusSelect.value === 'hora';\r\n        localScore.disabled = ocultaGoles;\r\n        visitorScore.disabled = ocultaGoles;\r\n        if (ocultaGoles) {\r\n          localScore.style.opacity = '0.4';\r\n          visitorScore.style.opacity = '0.4';\r\n        } else {\r\n          localScore.style.opacity = '1';\r\n          visitorScore.style.opacity = '1';\r\n        }\r\n        \r\n        onDirty();\r\n      });\r\n\r\n      // Aplicar estado inicial de deshabilitado de goles al cargar\r\n      const ocultaGolesInicial = statusSelect.value === 'proximo' || statusSelect.value === 'hora';\r\n      localScore.disabled = ocultaGolesInicial;\r\n      visitorScore.disabled = ocultaGolesInicial;\r\n      if (ocultaGolesInicial) {\r\n        localScore.style.opacity = '0.4';\r\n        visitorScore.style.opacity = '0.4';\r\n      }\r\n\r\n      horaInput.addEventListener('input', () => {\r\n        encuentro.hora = horaInput.value;\r\n        onDirty();\r\n      });\r\n\r\n      statusRow.appendChild(statusSelect);\r\n      statusRow.appendChild(horaInput);\r\n      card.appendChild(statusRow);\r\n\r\n      section.appendChild(card);\r\n    });\r\n\r\n    root.appendChild(section);\r\n\r\n    // --- Ajuste de textos (column-level, aplica a todos los encuentros visibles) ---\r\n    const adjustSection = document.createElement('section');\r\n    const adjustHeading = document.createElement('h3');\r\n    adjustHeading.textContent = 'AJUSTE DE TEXTOS (por columna)';\r\n    adjustHeading.style.marginTop = '20px';\r\n    adjustHeading.style.marginBottom = '10px';\r\n    adjustSection.appendChild(adjustHeading);\r\n    for (const { key, label } of ADJUST_COLUMNS) {\r\n      const wrap = document.createElement('div');\r\n      wrap.className = 'field';\r\n      const lbl = document.createElement('label');\r\n      lbl.textContent = label;\r\n      wrap.appendChild(lbl);\r\n      mountAdjustControl(wrap, data, key, onDirty, saveOptions);\r\n      adjustSection.appendChild(wrap);\r\n    }\r\n    root.appendChild(adjustSection);\r\n\r\n    // --- Footer y Bot\u00F3n A\u00F1adir ---\r\n    const footer = document.createElement('div');\r\n    footer.style.marginTop = '15px';\r\n    footer.style.display = 'flex';\r\n    footer.style.flexDirection = 'column';\r\n    footer.style.gap = '8px';\r\n\r\n    const addBtn = document.createElement('button');\r\n    addBtn.type = 'button';\r\n    addBtn.textContent = 'A\u00D1ADIR ENCUENTRO';\r\n    addBtn.className = 'btn';\r\n    addBtn.style.padding = '10px';\r\n    addBtn.style.fontWeight = 'bold';\r\n    addBtn.style.cursor = 'pointer';\r\n\r\n    const limitReached = data.encuentros.length >= MAX_ENCUENTROS;\r\n    if (limitReached) {\r\n      addBtn.disabled = true;\r\n      addBtn.style.opacity = '0.5';\r\n      addBtn.style.cursor = 'not-allowed';\r\n\r\n      const warning = document.createElement('p');\r\n      warning.textContent = `L\u00EDmite alcanzado: m\u00E1ximo de ${MAX_ENCUENTROS} encuentros cargados.`;\r\n      warning.style.color = '#e74c3c';\r\n      warning.style.fontSize = '13px';\r\n      warning.style.margin = '0';\r\n      warning.style.fontWeight = 'bold';\r\n      footer.appendChild(warning);\r\n    } else {\r\n      addBtn.addEventListener('click', () => {\r\n        if (data.encuentros.length === VISIBLE_ENCUENTROS) data.tanda = 'tanda1';\r\n        data.encuentros.push({\r\n          teamA: '',\r\n          teamB: '',\r\n          scoreA: '0',\r\n          scoreB: '0',\r\n          status: 'final',\r\n          hora: '',\r\n          titulo: '',\r\n          penalesA: '',\r\n          penalesB: ''\r\n        });\r\n        onDirty();\r\n        render();\r\n      });\r\n    }\r\n\r\n    footer.appendChild(addBtn);\r\n    if (!isSorteo) root.appendChild(footer);\r\n  }\r\n\r\n  render();\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/posiciones-panel.js","import { TEAM_OPTIONS, crestFile, teamName } from '../../shared/teams.js';\r\nimport { createGlaTorneoSourceNote, glaTorneoLabel } from './gla-torneo-source.js';\r\n// EQUIPOS VISIBLES (2026-10-21, pedido explicito del usuario, SOLO GLA):\r\n// un equipo oculto en EQUIPOS no se ofrece para nuevas selecciones; el ya\r\n// elegido se sigue mostrando (ocultar no borra ni rompe estados guardados).\r\nfunction isHiddenGlaOption(opt, currentId) {\r\n  return document.body.dataset.theme === 'gla' && opt.visible === false && opt.id !== (currentId || '');\r\n}\r\n\r\nimport { escapeHtml } from '../../shared/dom-utils.js';\r\nimport { mountAdjustControl } from './field-editors.js';\r\n\r\n// \"AJUSTE DE TEXTOS\" (2026-08-15, auditoria completa): Posiciones es una\r\n// tabla dinamica (5-6 filas visibles por pagina, hasta 11 en total) -- un\r\n// unico ajuste por COLUMNA se aplica por igual a todas las filas\r\n// visibles (mismo criterio ya usado en Resultados/Goleadores), no un\r\n// control por fila individual (la cantidad de filas cambia con la pagina\r\n// elegida, no tiene sentido un ajuste \"por instancia\" que se perderia al\r\n// cambiar de pagina).\r\nconst ADJUST_COLUMNS = [\r\n  { key: 'numero', label: 'Columna \"#\" (posici\u00F3n)' },\r\n  { key: 'equipo', label: 'Columna Equipo' },\r\n  { key: 'pts', label: 'Columna PTS' },\r\n  { key: 'pj', label: 'Columna PJ' },\r\n  { key: 'g', label: 'Columna G' },\r\n  { key: 'gxp', label: 'Columna GXP' },\r\n  { key: 'pxp', label: 'Columna PXP' },\r\n  { key: 'p', label: 'Columna P' },\r\n  { key: 'gf', label: 'Columna GF' },\r\n  { key: 'gc', label: 'Columna GC' },\r\n  { key: 'dg', label: 'Columna DG' },\r\n];\r\n\r\n// La liga tiene 11 equipos: se editan las 11 filas (posicion real 1-11,\r\n// nunca renumeradas) aca, aunque el asset de Program solo tenga\r\n// casilleros para 6 (pagina 1, posiciones 1-6) o 5 (pagina 2, posiciones\r\n// 7-11) a la vez -- ver PAGINAS mas abajo y program/js/renderers/posiciones.js.\r\n// 11 -> 16 filas + \"POSICIONES 12-16\" (2026-10-22): la liga de gla.futbol\r\n// ya tiene 16 equipos (ver POSICIONES_ROWS en server/glaFutbolSync.js).\r\nconst TOTAL_ROWS = 16;\r\n\r\nconst PAGINAS = [\r\n  { id: 'pagina1', label: 'POSICIONES 1-6', desde: 1, hasta: 6 },\r\n  { id: 'pagina2', label: 'POSICIONES 7-11', desde: 7, hasta: 11 },\r\n  { id: 'pagina3', label: 'POSICIONES 12-16', desde: 12, hasta: 16 },\r\n];\r\n\r\n// Mismo orden/nombres de columna que el asset real (ver overlay.css /\r\n// program/js/renderers/posiciones.js): PTS se edita aparte (mas grande,\r\n// resaltada) porque tambien gobierna el orden automatico; las otras 8 son\r\n// las estadisticas numericas impresas en el grafico, sin inventar siglas.\r\nconst STAT_COLS = [\r\n  { key: 'pj', label: 'PJ' },\r\n  { key: 'g', label: 'G' },\r\n  { key: 'gxp', label: 'GXP' },\r\n  { key: 'pxp', label: 'PXP' },\r\n  { key: 'p', label: 'P' },\r\n  { key: 'gf', label: 'GF' },\r\n  { key: 'gc', label: 'GC' },\r\n  { key: 'dg', label: 'DG' },\r\n];\r\n\r\nfunction teamOptionsMarkup(selectedId) {\r\n  return `<option value=\"\">Sin equipo</option>` + TEAM_OPTIONS.filter((opt) => !isHiddenGlaOption(opt, selectedId)).map((opt) => (\r\n    `<option value=\"${opt.id}\" ${opt.id === selectedId ? 'selected' : ''}>${opt.label}</option>`\r\n  )).join('');\r\n}\r\n\r\nfunction rowMarkup(fila, index, totalRows) {\r\n  const crest = crestFile(fila.teamId);\r\n  const nombre = teamName(fila.teamId) || 'Sin equipo';\r\n  const statsMarkup = STAT_COLS.map(({ key, label }) => `\r\n    <div class=\"pos-stat-field\">\r\n      <label for=\"pos-${index}-${key}\">${label}</label>\r\n      <input type=\"number\" id=\"pos-${index}-${key}\" class=\"pos-input-num\" data-row=\"${index}\" data-field=\"${key}\" min=\"0\" max=\"99\" value=\"${fila[key] ?? 0}\">\r\n    </div>\r\n  `).join('');\r\n\r\n  return `\r\n    <div class=\"pos-card\">\r\n      <div class=\"pos-card-header\">\r\n        ${crest ? `<img src=\"${crest}\" class=\"pos-crest-preview\" alt=\"\">` : '<div class=\"pos-crest-placeholder\"></div>'}\r\n        <div class=\"pos-header-fields\">\r\n          <div class=\"pos-field-inline\">\r\n            <label for=\"pos-${index}-posicion\">#</label>\r\n            <input type=\"number\" id=\"pos-${index}-posicion\" class=\"pos-input-num pos-input-posicion\" data-row=\"${index}\" data-field=\"posicion\" min=\"1\" max=\"${totalRows}\" value=\"${fila.posicion ?? index + 1}\">\r\n          </div>\r\n          <div class=\"pos-field-inline pos-field-team\">\r\n            <label for=\"pos-${index}-equipo\">EQUIPO</label>\r\n            <select id=\"pos-${index}-equipo\" class=\"pos-input-select\" data-row=\"${index}\" data-field=\"teamId\">\r\n              ${teamOptionsMarkup(fila.teamId)}\r\n            </select>\r\n          </div>\r\n          <div class=\"pos-team-title\">${nombre}</div>\r\n        </div>\r\n      </div>\r\n      <div class=\"pos-card-body\">\r\n        <div class=\"pos-field-inline pos-field-pts\">\r\n          <label for=\"pos-${index}-puntos\">PTS</label>\r\n          <input type=\"number\" id=\"pos-${index}-puntos\" class=\"pos-input-num pos-input-pts\" data-row=\"${index}\" data-field=\"puntos\" min=\"0\" max=\"999\" value=\"${fila.puntos ?? 0}\">\r\n        </div>\r\n        <div class=\"pos-stats-grid\">${statsMarkup}</div>\r\n      </div>\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction formatUpdatedAt(isoString) {\r\n  if (!isoString) return null;\r\n  const date = new Date(isoString);\r\n  if (Number.isNaN(date.getTime())) return null;\r\n  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\r\n}\r\n\r\nexport function renderPosicionesPanel(containerEl, data, onChanged, options = {}) {\r\n  const totalRows = options.totalRows || TOTAL_ROWS;\r\n  const paginas = options.paginas || PAGINAS;\r\n  const syncEndpoint = options.syncEndpoint || '/api/posiciones/sync-web';\r\n  // \"torneoSource\" (2026-10-21, ACTUALIZADOR DE DATOS): el titulo y la\r\n  // leyenda salen de la edicion central, ya no de un \"#3\" fijo.\r\n  const tableLabel = options.torneoSource ? `TABLA DE TORNEO \u2014 ${glaTorneoLabel()}` : (options.tableLabel || 'TABLA GLOBAL');\r\n  const saveOptions = options.saveOptions;\r\n  if (!Array.isArray(data.filas) || data.filas.length !== totalRows) {\r\n    data.filas = Array.from({ length: totalRows }, (_, i) => (\r\n      data.filas && data.filas[i] ? data.filas[i] : { posicion: i + 1, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 }\r\n    ));\r\n  }\r\n  if (!paginas.some((p) => p.id === data.pagina)) data.pagina = 'pagina1';\r\n\r\n  // Sincronizacion manual contra gla.futbol (server/glaFutbolSync.js),\r\n  // misma arquitectura que Goleadores/Asistidores/Mejores Jugadores (ver\r\n  // performance-table-panel.js) -- reutiliza las mismas clases CSS\r\n  // .performance-sync* de master.css. El orden que trae la web se respeta\r\n  // tal cual (no se recalcula por PTS/DG aca).\r\n  let syncStatus = null; // { kind: 'loading' | 'success' | 'error', text, unmatchedTeams? }\r\n  let syncStatusTimer = null;\r\n\r\n  function setSyncStatus(next) {\r\n    syncStatus = next;\r\n    clearTimeout(syncStatusTimer);\r\n    if (next && next.kind !== 'loading') {\r\n      syncStatusTimer = setTimeout(() => {\r\n        syncStatus = null;\r\n        render();\r\n      }, 6000);\r\n    }\r\n  }\r\n\r\n  async function syncFromWeb() {\r\n    setSyncStatus({ kind: 'loading', text: 'Actualizando...' });\r\n    render();\r\n    try {\r\n      const res = await fetch(syncEndpoint, { method: 'POST' });\r\n      const body = await res.json().catch(() => null);\r\n      if (!res.ok || !body?.ok) throw new Error(body?.error || `HTTP ${res.status}`);\r\n      data.filas = body.filas;\r\n      data.ultimaActualizacionWeb = body.ultimaActualizacionWeb;\r\n      setSyncStatus({ kind: 'success', text: `DATOS ACTUALIZADOS${body.edicion ? ` (${body.edicion.label})` : ''}`, unmatchedTeams: body.unmatchedTeams || [] });\r\n    } catch (err) {\r\n      setSyncStatus({ kind: 'error', text: options.torneoSource ? `ERROR AL ACTUALIZAR \u2014 ${err.message}` : 'ERROR AL ACTUALIZAR', detail: err.message });\r\n    }\r\n    onChanged();\r\n    render();\r\n  }\r\n\r\n  function syncRowMarkup() {\r\n    const statusMarkup = syncStatus\r\n      ? `<span class=\"performance-sync-status ${escapeHtml(syncStatus.kind)}\" ${syncStatus.detail ? `title=\"${escapeHtml(syncStatus.detail)}\"` : ''}>${escapeHtml(syncStatus.text)}</span>`\r\n      : '';\r\n    const updatedAt = formatUpdatedAt(data.ultimaActualizacionWeb);\r\n    const updatedMarkup = updatedAt ? `<span class=\"performance-sync-updated-at\">\u00DAltima actualizaci\u00F3n: ${escapeHtml(updatedAt)}</span>` : '';\r\n    const warningMarkup = syncStatus?.kind === 'success' && syncStatus.unmatchedTeams?.length\r\n      ? `<p class=\"performance-sync-warning\">Sin equipo local equivalente para: ${escapeHtml(syncStatus.unmatchedTeams.join(', '))}. Asign\u00E1 el equipo a mano en la tarjeta correspondiente.</p>`\r\n      : '';\r\n    return `\r\n      <div class=\"performance-sync\">\r\n        <button type=\"button\" class=\"performance-sync-btn\" id=\"pos-sync-btn\" ${syncStatus?.kind === 'loading' ? 'disabled' : ''}>ACTUALIZAR DESDE WEB</button>\r\n        ${statusMarkup}\r\n        ${updatedMarkup}\r\n        ${options.torneoSource ? `<span class=\"performance-sync-updated-at gla-torneo-source\">FUENTE ACTUAL: ${escapeHtml(glaTorneoLabel())}</span>` : ''}\r\n      </div>\r\n      ${warningMarkup}\r\n    `;\r\n  }\r\n\r\n  function paginaSelectorMarkup() {\r\n    const options = paginas.map((p) => (\r\n      `<option value=\"${p.id}\" ${p.id === data.pagina ? 'selected' : ''}>${p.label}</option>`\r\n    )).join('');\r\n    return `\r\n      <div class=\"pos-title-row\">\r\n        <label for=\"pos-pagina\">TABLA A MOSTRAR</label>\r\n        <select id=\"pos-pagina\" class=\"pos-input-pagina\">${options}</select>\r\n      </div>\r\n    `;\r\n  }\r\n\r\n  function render() {\r\n    containerEl.innerHTML = `\r\n      <div class=\"pos-panel-wrapper\">\r\n        <!-- Fila de Titulo General -->\r\n        <div class=\"pos-title-row\">\r\n          <label for=\"pos-titulo\">T\u00CDTULO</label>\r\n          <input type=\"text\" id=\"pos-titulo\" class=\"pos-input-text pos-input-title\" value=\"${data.titulo || ''}\" placeholder=\"Ej. TABLA DE POSICIONES\">\r\n        </div>\r\n        ${paginaSelectorMarkup()}\r\n        ${syncRowMarkup()}\r\n        <p class=\"pos-note\">${tableLabel}: se cargan y editan ${totalRows} filas con su posicion oficial. La actualizacion usa estadisticas web y conserva equipos, escudos e identidad del catalogo local.</p>\r\n        ${data.filas.map((fila, i) => rowMarkup(fila, i, totalRows)).join('')}\r\n        <section class=\"pos-adjust-section\">\r\n          <h2 class=\"pos-adjust-heading\">AJUSTE DE TEXTOS (por columna, aplica a todas las filas visibles)</h2>\r\n        </section>\r\n      </div>\r\n    `;\r\n    injectStyles();\r\n    attachListeners();\r\n    document.getElementById('pos-sync-btn')?.addEventListener('click', syncFromWeb);\r\n    document.getElementById('pos-pagina')?.addEventListener('change', handlePaginaChange);\r\n\r\n    const adjustSection = containerEl.querySelector('.pos-adjust-section');\r\n    const tituloWrap = document.createElement('div');\r\n    tituloWrap.className = 'field';\r\n    const tituloLbl = document.createElement('label');\r\n    tituloLbl.textContent = 'T\u00EDtulo general';\r\n    tituloWrap.appendChild(tituloLbl);\r\n    mountAdjustControl(tituloWrap, data, 'titulo', onChanged, saveOptions);\r\n    adjustSection.appendChild(tituloWrap);\r\n    for (const { key, label } of ADJUST_COLUMNS) {\r\n      const wrap = document.createElement('div');\r\n      wrap.className = 'field';\r\n      const lbl = document.createElement('label');\r\n      lbl.textContent = label;\r\n      wrap.appendChild(lbl);\r\n      mountAdjustControl(wrap, data, key, onChanged, saveOptions);\r\n      adjustSection.appendChild(wrap);\r\n    }\r\n  }\r\n\r\n  function attachListeners() {\r\n    const inputs = containerEl.querySelectorAll('.pos-input-num, .pos-input-select');\r\n    for (const input of inputs) {\r\n      input.addEventListener('input', handleInput);\r\n      if (input.tagName === 'SELECT') input.addEventListener('change', handleInput);\r\n    }\r\n    const tituloInput = document.getElementById('pos-titulo');\r\n    if (tituloInput) {\r\n      tituloInput.addEventListener('input', handleTitleInput);\r\n    }\r\n  }\r\n\r\n  function handleTitleInput(evt) {\r\n    data.titulo = evt.target.value;\r\n    onChanged();\r\n  }\r\n\r\n  function handlePaginaChange(evt) {\r\n    data.pagina = evt.target.value;\r\n    onChanged();\r\n  }\r\n\r\n  function handleInput(evt) {\r\n    const el = evt.target;\r\n    const row = Number(el.dataset.row);\r\n    const field = el.dataset.field;\r\n    const fila = data.filas[row];\r\n    if (field === 'teamId') {\r\n      fila.teamId = el.value;\r\n    } else if (field === 'posicion') {\r\n      fila.posicion = parseInt(el.value, 10) || (row + 1);\r\n    } else {\r\n      fila[field] = parseInt(el.value, 10) || 0;\r\n    }\r\n    onChanged();\r\n    // El escudo/nombre en el header de la tarjeta dependen del equipo\r\n    // elegido -- se re-dibuja solo esa tarjeta para reflejarlo, sin\r\n    // perder el foco del resto de los inputs.\r\n    if (field === 'teamId') render();\r\n  }\r\n\r\n  function injectStyles() {\r\n    const styleId = 'posiciones-panel-styles';\r\n    if (document.getElementById(styleId)) return;\r\n    const styleEl = document.createElement('style');\r\n    styleEl.id = styleId;\r\n    styleEl.textContent = `\r\n      .pos-panel-wrapper {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 14px;\r\n        margin-top: 10px;\r\n      }\r\n      .pos-title-row {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 6px;\r\n        background: #1e1e1e;\r\n        border: 1px solid #333;\r\n        padding: 16px;\r\n        border-radius: 8px;\r\n      }\r\n      .pos-title-row label {\r\n        color: #d5a753;\r\n        font-size: 12px;\r\n        font-weight: 700;\r\n        letter-spacing: 0.5px;\r\n      }\r\n      .pos-input-title {\r\n        font-weight: bold;\r\n        font-size: 16px;\r\n        background: #111;\r\n        border: 1px solid #444;\r\n        color: #fff;\r\n        padding: 8px 12px;\r\n        border-radius: 4px;\r\n        width: 100%;\r\n        box-sizing: border-box;\r\n      }\r\n      .pos-input-title:focus {\r\n        border-color: #d5a753;\r\n        outline: none;\r\n      }\r\n      .pos-note {\r\n        color: #aaa;\r\n        font-size: 12px;\r\n        margin: 0;\r\n      }\r\n      .pos-card {\r\n        background: #1e1e1e;\r\n        border: 1px solid #333;\r\n        border-radius: 8px;\r\n        overflow: hidden;\r\n      }\r\n      .pos-card-header {\r\n        background: #2a2a2a;\r\n        padding: 10px 14px;\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 12px;\r\n        border-bottom: 1px solid #333;\r\n        flex-wrap: wrap;\r\n      }\r\n      .pos-crest-preview {\r\n        width: 28px;\r\n        height: 28px;\r\n        object-fit: contain;\r\n        flex-shrink: 0;\r\n      }\r\n      .pos-crest-placeholder {\r\n        width: 28px;\r\n        height: 28px;\r\n        border: 1px dashed #555;\r\n        border-radius: 4px;\r\n        flex-shrink: 0;\r\n      }\r\n      .pos-header-fields {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 12px;\r\n        flex-wrap: wrap;\r\n        flex: 1;\r\n      }\r\n      .pos-field-inline {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 6px;\r\n      }\r\n      .pos-field-inline label {\r\n        color: #d5a753;\r\n        font-size: 11px;\r\n        font-weight: 700;\r\n        letter-spacing: 0.5px;\r\n      }\r\n      .pos-field-team select {\r\n        min-width: 140px;\r\n      }\r\n      .pos-team-title {\r\n        color: #fff;\r\n        font-weight: 700;\r\n        font-size: 13px;\r\n      }\r\n      .pos-card-body {\r\n        padding: 12px 14px;\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 10px;\r\n      }\r\n      .pos-field-pts .pos-input-pts {\r\n        width: 70px;\r\n        font-weight: 800;\r\n        border-color: #d5a753;\r\n      }\r\n      .pos-stats-grid {\r\n        display: grid;\r\n        grid-template-columns: repeat(4, 1fr);\r\n        gap: 8px;\r\n      }\r\n      .pos-stat-field {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 4px;\r\n      }\r\n      .pos-stat-field label {\r\n        color: #aaa;\r\n        font-size: 11px;\r\n        font-weight: 600;\r\n      }\r\n      .pos-input-num, .pos-input-select, .pos-input-pagina {\r\n        background: #111;\r\n        border: 1px solid #444;\r\n        color: #fff;\r\n        padding: 6px 8px;\r\n        border-radius: 4px;\r\n        font-size: 13px;\r\n      }\r\n      .pos-input-pagina {\r\n        width: 100%;\r\n        font-weight: 700;\r\n      }\r\n      .pos-input-pagina:focus {\r\n        border-color: #d5a753;\r\n        outline: none;\r\n      }\r\n      .pos-input-num {\r\n        text-align: center;\r\n        width: 100%;\r\n      }\r\n      .pos-input-posicion {\r\n        width: 48px;\r\n      }\r\n      .pos-input-num:focus, .pos-input-select:focus {\r\n        border-color: #d5a753;\r\n        outline: none;\r\n      }\r\n      .pos-adjust-section {\r\n        background: #1e1e1e;\r\n        border: 1px solid #333;\r\n        border-radius: 8px;\r\n        padding: 16px;\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 14px;\r\n      }\r\n      .pos-adjust-heading {\r\n        color: #d5a753;\r\n        font-weight: 700;\r\n        font-size: 14px;\r\n        letter-spacing: 0.5px;\r\n        margin: 0;\r\n      }\r\n    `;\r\n    document.head.appendChild(styleEl);\r\n  }\r\n\r\n  render();\r\n\r\n  return () => {\r\n    const inputs = containerEl.querySelectorAll('.pos-input-num, .pos-input-select');\r\n    for (const input of inputs) {\r\n      input.removeEventListener('input', handleInput);\r\n      if (input.tagName === 'SELECT') input.removeEventListener('change', handleInput);\r\n    }\r\n    const tituloInput = document.getElementById('pos-titulo');\r\n    if (tituloInput) {\r\n      tituloInput.removeEventListener('input', handleTitleInput);\r\n    }\r\n    const paginaSelect = document.getElementById('pos-pagina');\r\n    if (paginaSelect) {\r\n      paginaSelect.removeEventListener('change', handlePaginaChange);\r\n    }\r\n  };\r\n}\r\n\r\nexport function renderPosicionesTorneoPanel(containerEl, data, onChanged, saveOptions) {\r\n  return renderPosicionesPanel(containerEl, data, onChanged, {\r\n    totalRows: 6,\r\n    paginas: [{ id: 'pagina1', label: 'POSICIONES 1-6', desde: 1, hasta: 6 }],\r\n    syncEndpoint: '/api/posiciones-torneo/sync-web',\r\n    torneoSource: true,\r\n    saveOptions,\r\n  });\r\n}\r\n","http://localhost:4430/master-control/js/performance-table-panel.js","import { TEAM_OPTIONS, crestFile } from '../../shared/teams.js';\r\nimport { createGlaTorneoSourceNote, glaTorneoLabel } from './gla-torneo-source.js';\r\nimport { mountAdjustControl } from './field-editors.js';\r\n\r\n// \"AJUSTE DE TEXTOS\" (2026-08-15, auditoria completa): tabla dinamica\r\n// (hasta 6 filas visibles) -- un unico ajuste por COLUMNA se aplica a\r\n// todas las filas, mismo criterio que Posiciones/Resultados. \"goleadores\"/\r\n// \"asistidores\" (modo ranking) tienen posicion+nombre+estadistica\r\n// principal; \"jugadores\" tiene nombre + 3 estadisticas (G/A/PJ).\r\n// \"titulo\" (2026-09-02, pedido explicito del usuario, TABLA_ESTADISTICAS.png\r\n// -- Argentina Streamers, modo \"placaL-solo\"): la 4ta columna editable\r\n// pedida (\"COMPOSICI\u00D3N COMPLETA/T\u00CDTULO/POSICI\u00D3N/JUGADOR/ESTAD\u00CDSTICA\"). Se\r\n// separa en \"argentinaOnly\" (2026-09-02, corrigiendo un descuido propio:\r\n// declararla siempre le agregaba a GLA un campo \"T\u00EDtulo\" y, en jugadores,\r\n// \"posici\u00F3n\"/\"participaciones\" que no hacen NADA en su propio asset --\r\n// \"no modificar el panel de GLA\" aplica tambien a agregarle campos\r\n// muertos, no solo a tocar los que ya tenia) -- solo se agregan cuando\r\n// \"isArgentinaCandidate\" es true (equivale a \"theme=Argentina Streamers\",\r\n// ver mas abajo).\r\nconst ADJUST_COLUMNS_BY_MODULE = {\r\n  goleadores: {\r\n    always: [\r\n      { key: 'position', label: 'Columna posici\u00F3n (#)' },\r\n      { key: 'name', label: 'Columna Nombre' },\r\n      { key: 'primaryStat', label: 'Columna Goles' },\r\n    ],\r\n    argentinaOnly: [{ key: 'titulo', label: 'T\u00EDtulo' }],\r\n  },\r\n  asistidores: {\r\n    always: [\r\n      { key: 'position', label: 'Columna posici\u00F3n (#)' },\r\n      { key: 'name', label: 'Columna Nombre' },\r\n      { key: 'primaryStat', label: 'Columna Asistencias' },\r\n    ],\r\n    argentinaOnly: [{ key: 'titulo', label: 'T\u00EDtulo' }],\r\n  },\r\n  jugadores: {\r\n    always: [\r\n      { key: 'name', label: 'Columna Nombre' },\r\n      { key: 'stat0', label: 'Columna G' },\r\n      { key: 'stat1', label: 'Columna A' },\r\n      { key: 'stat2', label: 'Columna PJ' },\r\n    ],\r\n    argentinaOnly: [\r\n      { key: 'titulo', label: 'T\u00EDtulo' },\r\n      { key: 'position', label: 'Columna posici\u00F3n (#)' },\r\n      { key: 'primaryStat', label: 'Columna Participaciones (PJ)' },\r\n    ],\r\n  },\r\n};\r\n\r\nconst MAX_ROWS = 6;\r\nconst SOURCES = [\r\n  { id: 'liga', label: 'LIGA' },\r\n  { id: 'torneo', label: 'TORNEO' },\r\n];\r\n\r\nconst CONFIG = {\r\n  goleadores: {\r\n    stats: [{ key: 'g', label: 'GOLES' }],\r\n    orderNote: 'La posici\u00F3n se calcula autom\u00E1ticamente por goles, de mayor a menor. Los empates conservan el orden de carga.',\r\n  },\r\n  asistidores: {\r\n    stats: [{ key: 'a', label: 'ASISTS' }],\r\n    orderNote: 'La posici\u00F3n se calcula autom\u00E1ticamente por asistencias, de mayor a menor. Los empates conservan el orden de carga.',\r\n  },\r\n  jugadores: {\r\n    stats: [{ key: 'g', label: 'G' }, { key: 'a', label: 'A' }, { key: 'pj', label: 'PJ' }],\r\n    computed: null,\r\n    orderNote: 'Orden: (G + A) / PJ de mayor a menor; los empates conservan el orden de carga.',\r\n  },\r\n};\r\n\r\nconst POSITIONS = [\r\n  { id: 'placaL', label: 'PLACA L' },\r\n  { id: 'fullscreenDerecha', label: 'FULLSCREEN \u2014 ABAJO DERECHA' },\r\n  { id: 'fullscreenIzquierda', label: 'FULLSCREEN \u2014 ABAJO IZQUIERDA' },\r\n];\r\n\r\n// \"MODO CANTIDAD\" 5/10 SLOTS (2026-09-02, pedido explicito del usuario,\r\n// exclusivo de Argentina Streamers -- ver \"argentinaCtx\" en\r\n// renderPerformanceTablePanel). Reutiliza el MISMO campo \"posicion\" que\r\n// ya usan estos 3 modulos (ver POSITIONS arriba) con 3 valores NUEVOS que\r\n// GLA nunca escribe ni lee: \"placaL-top\"/\"placaL-bottom\" (modo 5 SLOTS,\r\n// dos placas apiladas) y \"placaL-solo\" (modo 10 SLOTS, una sola placa\r\n// ocupando toda la zona). \"PARTICIPACIONES\" es el nombre de broadcast que\r\n// pidio el usuario para \"jugadores\" SOLO en Argentina Streamers -- el\r\n// modulo/id/label interno de GLA no cambia.\r\nconst ARGENTINA_CANDIDATE_IDS = ['goleadores', 'asistidores', 'jugadores'];\r\nconst ARGENTINA_CANDIDATE_LABELS = { goleadores: 'GOLEADORES', asistidores: 'ASISTIDORES', jugadores: 'PARTICIPACIONES' };\r\nconst ARGENTINA_SLOT_POSITIONS = new Set(['placaL-top', 'placaL-bottom', 'placaL-solo']);\r\nconst RAMA_LABELS = { masculino: 'MASCULINO', femenino: 'FEMENINO' };\r\nconst RAMA_TEAM_IDS = { masculino: 'argentina-streamers', femenino: 'argentina-streamers-fem' };\r\n\r\n// Lee el estado actual de la seleccion 5/10 SLOTS a partir de \"posicion\"\r\n// en los 3 modulos candidatos -- no hay una fuente de estado aparte,\r\n// \"posicion\" YA es la fuente de verdad (evita duplicar estado).\r\nfunction readArgentinaSelection(siblingData) {\r\n  let top = null;\r\n  let bottom = null;\r\n  let solo = null;\r\n  for (const id of ARGENTINA_CANDIDATE_IDS) {\r\n    const pos = siblingData[id]?.posicion;\r\n    if (pos === 'placaL-top') top = id;\r\n    else if (pos === 'placaL-bottom') bottom = id;\r\n    else if (pos === 'placaL-solo') solo = id;\r\n  }\r\n  return { mode: solo ? '10' : '5', top, bottom, solo };\r\n}\r\n\r\nfunction numeric(value) {\r\n  const parsed = Number.parseInt(value, 10);\r\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;\r\n}\r\n\r\nfunction createField(labelText, input) {\r\n  const field = document.createElement('label');\r\n  field.className = 'performance-field';\r\n  const label = document.createElement('span');\r\n  label.textContent = labelText;\r\n  field.append(label, input);\r\n  return field;\r\n}\r\n\r\nfunction createNumberInput(value, ariaLabel) {\r\n  const input = document.createElement('input');\r\n  input.type = 'number';\r\n  input.min = '0';\r\n  input.max = '99';\r\n  input.inputMode = 'numeric';\r\n  input.value = String(numeric(value));\r\n  input.setAttribute('aria-label', ariaLabel);\r\n  return input;\r\n}\r\n\r\n// Los 3 modulos de esta familia (Goleadores, Asistidores, Mejores\r\n// Jugadores) tienen sincronizacion web -- Posiciones la tiene tambien pero\r\n// vive en su propio panel (posiciones-panel.js) por tener una forma de\r\n// datos distinta (filas de equipo, no jugadores).\r\nconst WEB_SYNC_MODULE_IDS = ['goleadores', 'asistidores', 'jugadores'];\r\n\r\nfunction formatUpdatedAt(isoString) {\r\n  if (!isoString) return null;\r\n  const date = new Date(isoString);\r\n  if (Number.isNaN(date.getTime())) return null;\r\n  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\r\n}\r\n\r\n// \"argentinaCtx\" (2026-09-02, pedido explicito del usuario): SOLO se pasa\r\n// (ver master-control/js/main.js) cuando el theme activo es Argentina\r\n// Streamers -- `{ siblingData, scheduleAutoSave }`. Sin este parametro\r\n// (GLA, siempre) el panel funciona EXACTAMENTE igual que antes, cero\r\n// cambios de comportamiento ahi. \"siblingData\" son los `draft` de los 3\r\n// modulos candidatos (goleadores/asistidores/jugadores) -- necesarios\r\n// porque la seleccion 5/10 SLOTS es una decision CRUZADA entre los 3, no\r\n// algo que viva en un solo modulo.\r\nexport function renderPerformanceTablePanel(container, data, moduleId, onDirty, saveOptions, argentinaCtx) {\r\n  const config = CONFIG[moduleId];\r\n  if (!config) throw new Error(`Tabla de rendimiento desconocida: ${moduleId}`);\r\n  if (!Array.isArray(data.jugadores)) data.jugadores = [];\r\n  const isArgentinaCandidate = argentinaCtx && ARGENTINA_CANDIDATE_IDS.includes(moduleId);\r\n  if (!POSITIONS.some((position) => position.id === data.posicion) && !(isArgentinaCandidate && ARGENTINA_SLOT_POSITIONS.has(data.posicion))) {\r\n    data.posicion = 'placaL';\r\n  }\r\n  if (!SOURCES.some((source) => source.id === data.fuente)) data.fuente = 'liga';\r\n  if (!data.snapshots || typeof data.snapshots !== 'object') data.snapshots = {};\r\n  if (!data.snapshots[data.fuente]) {\r\n    data.snapshots[data.fuente] = {\r\n      jugadores: JSON.parse(JSON.stringify(data.jugadores)),\r\n      ultimaActualizacionWeb: data.ultimaActualizacionWeb || '',\r\n    };\r\n  }\r\n\r\n  // RAMA MASCULINO/FEMENINO (2026-10-08, pedido explicito del usuario, SOLO\r\n  // Argentina Streamers): cada rama de ESTADISTICAS de la web conserva su\r\n  // propia tabla en \"snapshotsRama\" (mismo patron que LIGA/TORNEO de GLA) --\r\n  // actualizar FEMENINO nunca pisa la tabla MASCULINO ni las ediciones\r\n  // manuales hechas sobre ella. \"ramaWeb\" persiste la eleccion.\r\n  if (isArgentinaCandidate) {\r\n    data.ramaWeb = data.ramaWeb === 'femenino' ? 'femenino' : 'masculino';\r\n    if (!data.snapshotsRama || typeof data.snapshotsRama !== 'object') data.snapshotsRama = {};\r\n    // Limpieza de datos mezclados (2026-10-08, BUG real: un servidor viejo\r\n    // devolvia la tabla MASCULINA al pedir FEMENINO y quedo guardada en el\r\n    // slot femenino). Un slot cuyas filas son TODAS del equipo web de la\r\n    // OTRA rama es de la otra rama: se descarta (las filas manuales de\r\n    // otros equipos nunca se tocan).\r\n    let cleaned = false;\r\n    for (const rama of ['masculino', 'femenino']) {\r\n      const otherTeam = RAMA_TEAM_IDS[rama === 'masculino' ? 'femenino' : 'masculino'];\r\n      const isForeign = (rows) => Array.isArray(rows) && rows.length > 0 && rows.every((row) => row?.teamId === otherTeam);\r\n      if (isForeign(data.snapshotsRama[rama]?.jugadores)) {\r\n        data.snapshotsRama[rama] = { jugadores: [], ultimaActualizacionWeb: '' };\r\n        cleaned = true;\r\n      }\r\n      if (data.ramaWeb === rama && isForeign(data.jugadores)) {\r\n        data.jugadores = [];\r\n        data.ultimaActualizacionWeb = '';\r\n        cleaned = true;\r\n      }\r\n    }\r\n    if (cleaned) onDirty();\r\n    if (!data.snapshotsRama[data.ramaWeb]) {\r\n      data.snapshotsRama[data.ramaWeb] = {\r\n        jugadores: JSON.parse(JSON.stringify(data.jugadores)),\r\n        ultimaActualizacionWeb: data.ultimaActualizacionWeb || '',\r\n      };\r\n    }\r\n  }\r\n\r\n  const root = document.createElement('div');\r\n  root.className = `performance-editor performance-editor--${moduleId}`;\r\n  container.appendChild(root);\r\n\r\n  // Sincronizacion manual contra gla.futbol (server/glaFutbolSync.js). El\r\n  // estado vive fuera de render() para sobrevivir a los re-render que\r\n  // dispara el resto del panel. Misma arquitectura para los 3 modulos de\r\n  // esta familia -- unico dato que cambia entre ellos es el endpoint,\r\n  // derivado directamente de moduleId.\r\n  let syncStatus = null; // { kind: 'loading' | 'success' | 'error', text, unmatchedTeams? }\r\n  let syncStatusTimer = null;\r\n\r\n  // \"ACTUALIZAR DATOS DE LA WEB\" contra https://argentinastreamers.com\r\n  // (2026-09-04, pedido explicito del usuario -- distinto del bloque\r\n  // \"ACTUALIZAR DESDE WEB\"/gla.futbol de arriba, que es exclusivo de GLA).\r\n  // Estado propio y separado (nunca se mezcla con \"syncStatus\") para que\r\n  // ambas integraciones puedan mostrar su resultado sin pisarse.\r\n  let webSyncStatus = null; // { kind: 'loading' | 'success' | 'error', text, unmatchedTeams? }\r\n  let webSyncStatusTimer = null;\r\n\r\n  function saveActiveSnapshot() {\r\n    data.snapshots[data.fuente] = {\r\n      jugadores: JSON.parse(JSON.stringify(data.jugadores)),\r\n      ultimaActualizacionWeb: data.ultimaActualizacionWeb || '',\r\n    };\r\n    if (isArgentinaCandidate) {\r\n      data.snapshotsRama[data.ramaWeb] = {\r\n        jugadores: JSON.parse(JSON.stringify(data.jugadores)),\r\n        ultimaActualizacionWeb: data.ultimaActualizacionWeb || '',\r\n      };\r\n    }\r\n  }\r\n\r\n  function markDirty() {\r\n    saveActiveSnapshot();\r\n    onDirty();\r\n  }\r\n\r\n  function setSyncStatus(next) {\r\n    syncStatus = next;\r\n    clearTimeout(syncStatusTimer);\r\n    if (next && next.kind !== 'loading') {\r\n      syncStatusTimer = setTimeout(() => {\r\n        syncStatus = null;\r\n        render();\r\n      }, 6000);\r\n    }\r\n  }\r\n\r\n  // Solo el \"ok\" se borra solo: un aviso de vacio/error queda visible\r\n  // hasta la proxima accion (el operador tiene que poder leerlo).\r\n  function setWebSyncStatus(next) {\r\n    webSyncStatus = next;\r\n    clearTimeout(webSyncStatusTimer);\r\n    if (next && next.kind === 'success') {\r\n      webSyncStatusTimer = setTimeout(() => {\r\n        webSyncStatus = null;\r\n        render();\r\n      }, 6000);\r\n    }\r\n  }\r\n\r\n  // Solo actualiza el draft (data.jugadores/ultimaActualizacionWeb) -- NUNCA\r\n  // manda al aire por si sola (pedido explicito del usuario, seccion 22):\r\n  // el operador decide TAKE/UPDATE despues, con los datos ya visibles en\r\n  // el panel para revisar antes de salir en vivo.\r\n  // Fuente: ESTADISTICAS de la rama elegida (server/argentinaStreamersSync.js).\r\n  // Respuesta \"vacio\"/\"error\" (ok:false + mensaje): la tabla actual NO se\r\n  // toca, solo se muestra el motivo.\r\n  async function syncFromArgentinaStreamersWeb() {\r\n    const rama = data.ramaWeb;\r\n    setWebSyncStatus({ kind: 'loading', text: 'ACTUALIZANDO...' });\r\n    render();\r\n    try {\r\n      const res = await fetch(`/api/argentina-streamers/${moduleId}/sync-web?rama=${encodeURIComponent(rama)}`, { method: 'POST' });\r\n      const body = await res.json().catch(() => null);\r\n      if (!body) throw new Error(`HTTP ${res.status}`);\r\n      if (!body.ok) {\r\n        setWebSyncStatus({ kind: 'error', text: body.mensaje || 'NO SE PUDO ACTUALIZAR \u2014 SE CONSERVAN LOS \u00DALTIMOS DATOS V\u00C1LIDOS', detail: body.detalle || body.error });\r\n      } else if (body.rama !== rama) {\r\n        // BUG real (2026-10-08): un servidor viejo ignoraba \"?rama=\" y\r\n        // devolvia la tabla MASCULINA aunque se pidiera FEMENINO -- nunca\r\n        // se guarda una tabla de otra rama en el slot equivocado.\r\n        setWebSyncStatus({ kind: 'error', text: `EL SERVIDOR DEVOLVI\u00D3 DATOS DE OTRA RAMA (${String(body.rama || 'desconocida').toUpperCase()}) \u2014 NO SE APLICARON. Reinici\u00E1 SOFTX.` });\r\n      } else {\r\n        // Se guarda en el slot de la rama PEDIDA (aunque el operador haya\r\n        // cambiado de pesta\u00F1a mientras esperaba) y solo se muestra si esa\r\n        // es la rama visible: nunca una tabla en la pesta\u00F1a equivocada.\r\n        const snapshot = { jugadores: JSON.parse(JSON.stringify(body.jugadores)), ultimaActualizacionWeb: body.ultimaActualizacionWeb };\r\n        data.snapshotsRama[rama] = snapshot;\r\n        if (data.ramaWeb === rama) {\r\n          data.jugadores = JSON.parse(JSON.stringify(body.jugadores));\r\n          data.ultimaActualizacionWeb = body.ultimaActualizacionWeb;\r\n        }\r\n        markDirty();\r\n        setWebSyncStatus({ kind: 'success', text: `DATOS ACTUALIZADOS \u2713 (ESTAD\u00CDSTICAS ${RAMA_LABELS[rama]})` });\r\n      }\r\n    } catch (err) {\r\n      setWebSyncStatus({ kind: 'error', text: 'NO SE PUDO ACTUALIZAR \u2014 SE CONSERVAN LOS \u00DALTIMOS DATOS V\u00C1LIDOS', detail: err.message });\r\n    }\r\n    render();\r\n  }\r\n\r\n  async function syncFromWeb() {\r\n    setSyncStatus({ kind: 'loading', text: 'Actualizando...' });\r\n    render();\r\n    try {\r\n      const res = await fetch(`/api/${moduleId}/sync-web?fuente=${encodeURIComponent(data.fuente)}`, { method: 'POST' });\r\n      const body = await res.json().catch(() => null);\r\n      if (!res.ok || !body?.ok) throw new Error(body?.error || `HTTP ${res.status}`);\r\n      data.jugadores = body.jugadores;\r\n      data.ultimaActualizacionWeb = body.ultimaActualizacionWeb;\r\n      data.snapshots = body.snapshots || data.snapshots;\r\n      setSyncStatus({ kind: 'success', text: `DATOS ACTUALIZADOS${body.edicion ? ` (${body.edicion.label})` : ''}`, unmatchedTeams: body.unmatchedTeams || [] });\r\n    } catch (err) {\r\n      setSyncStatus({ kind: 'error', text: data.fuente === 'torneo' ? `ERROR AL ACTUALIZAR \u2014 ${err.message}` : 'ERROR AL ACTUALIZAR', detail: err.message });\r\n    }\r\n    render();\r\n  }\r\n\r\n  // 5 SLOTS (top/bottom) o 10 SLOTS (solo) -- ver ARGENTINA_SLOT_POSITIONS\r\n  // arriba. GLA sigue con MAX_ROWS fijo en 6, sin cambios.\r\n  function effectiveMaxRows() {\r\n    if (isArgentinaCandidate) {\r\n      if (data.posicion === 'placaL-solo') return 10;\r\n      if (data.posicion === 'placaL-top' || data.posicion === 'placaL-bottom') return 5;\r\n    }\r\n    return MAX_ROWS;\r\n  }\r\n\r\n  // Selector cruzado 5/10 SLOTS (2026-09-02, Argentina Streamers). Escribe\r\n  // \"posicion\" en los 3 modulos candidatos (via argentinaCtx.siblingData,\r\n  // la MISMA referencia que master-control/js/main.js usa como \"draft\") y\r\n  // dispara autoguardado en cada uno que cambio -- \"markDirty()\" solo\r\n  // cubre el modulo activo, por eso este selector llama\r\n  // \"argentinaCtx.scheduleAutoSave(id)\" directo para los otros dos.\r\n  function buildArgentinaSelector() {\r\n    const { siblingData, scheduleAutoSave: scheduleSiblingSave } = argentinaCtx;\r\n    const selection = readArgentinaSelection(siblingData);\r\n\r\n    function setPosicion(id, value) {\r\n      if (!id) return;\r\n      siblingData[id].posicion = value;\r\n      scheduleSiblingSave(id);\r\n    }\r\n    function clearIfMatches(id, ...values) {\r\n      if (id && values.includes(siblingData[id]?.posicion)) {\r\n        siblingData[id].posicion = 'placaL';\r\n        scheduleSiblingSave(id);\r\n      }\r\n    }\r\n\r\n    const section = document.createElement('section');\r\n    section.className = 'performance-argentina-selector';\r\n\r\n    const heading = document.createElement('h3');\r\n    heading.textContent = 'MODO CANTIDAD';\r\n    section.appendChild(heading);\r\n\r\n    const modeField = document.createElement('label');\r\n    modeField.className = 'field';\r\n    const modeLabel = document.createElement('span');\r\n    modeLabel.textContent = 'Modo';\r\n    const modeSelect = document.createElement('select');\r\n    for (const opt of [{ id: '5', label: '5 SLOTS (dos placas)' }, { id: '10', label: '10 SLOTS (una placa)' }]) {\r\n      const option = document.createElement('option');\r\n      option.value = opt.id;\r\n      option.textContent = opt.label;\r\n      modeSelect.appendChild(option);\r\n    }\r\n    modeSelect.value = selection.mode;\r\n    modeSelect.addEventListener('change', () => {\r\n      if (modeSelect.value === selection.mode) return;\r\n      if (modeSelect.value === '10') {\r\n        // Pasa a 10 SLOTS: limpia top/bottom, y si habia una placa en\r\n        // top la deja como unica de arranque (menos clicks para el\r\n        // operador) -- el resto queda \"\u2014 Ninguna \u2014\" hasta que elija.\r\n        clearIfMatches(selection.bottom, 'placaL-bottom');\r\n        if (selection.top) setPosicion(selection.top, 'placaL-solo');\r\n      } else {\r\n        // Pasa a 5 SLOTS: limpia la unica, arranca sin ninguna placa\r\n        // asignada (el operador elige arriba/abajo a proposito, para no\r\n        // adivinar el orden).\r\n        clearIfMatches(selection.solo, 'placaL-solo');\r\n      }\r\n      render();\r\n    });\r\n    modeField.append(modeLabel, modeSelect);\r\n    section.appendChild(modeField);\r\n\r\n    function candidateOptions(excludeId) {\r\n      const opts = [{ id: '', label: '\u2014 Ninguna \u2014' }];\r\n      for (const id of ARGENTINA_CANDIDATE_IDS) {\r\n        if (id === excludeId) continue;\r\n        opts.push({ id, label: ARGENTINA_CANDIDATE_LABELS[id] });\r\n      }\r\n      return opts;\r\n    }\r\n\r\n    function buildSlotSelect(labelText, currentId, excludeId, onPick) {\r\n      const field = document.createElement('label');\r\n      field.className = 'field';\r\n      const label = document.createElement('span');\r\n      label.textContent = labelText;\r\n      const select = document.createElement('select');\r\n      for (const opt of candidateOptions(excludeId)) {\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        select.appendChild(option);\r\n      }\r\n      select.value = currentId || '';\r\n      select.addEventListener('change', onPick(select));\r\n      field.append(label, select);\r\n      return field;\r\n    }\r\n\r\n    if (selection.mode === '5') {\r\n      section.appendChild(buildSlotSelect('Placa arriba', selection.top, selection.bottom, (select) => () => {\r\n        clearIfMatches(selection.top, 'placaL-top');\r\n        setPosicion(select.value, 'placaL-top');\r\n        render();\r\n      }));\r\n      section.appendChild(buildSlotSelect('Placa abajo', selection.bottom, selection.top, (select) => () => {\r\n        clearIfMatches(selection.bottom, 'placaL-bottom');\r\n        setPosicion(select.value, 'placaL-bottom');\r\n        render();\r\n      }));\r\n    } else {\r\n      section.appendChild(buildSlotSelect('Placa \u00FAnica', selection.solo, null, (select) => () => {\r\n        clearIfMatches(selection.solo, 'placaL-solo');\r\n        setPosicion(select.value, 'placaL-solo');\r\n        render();\r\n      }));\r\n    }\r\n\r\n    return section;\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n\r\n    const sourceTabs = document.createElement('div');\r\n    sourceTabs.className = 'performance-source-tabs';\r\n    // Argentina Streamers: MASCULINO/FEMENINO (ramas de ESTADISTICAS de la\r\n    // web) en lugar de LIGA/TORNEO, que son fuentes de gla.futbol (GLA).\r\n    if (isArgentinaCandidate) {\r\n      for (const rama of ['masculino', 'femenino']) {\r\n        const button = document.createElement('button');\r\n        button.type = 'button';\r\n        button.className = 'performance-sync-btn';\r\n        button.classList.toggle('active', data.ramaWeb === rama);\r\n        button.textContent = RAMA_LABELS[rama];\r\n        button.addEventListener('click', () => {\r\n          if (data.ramaWeb === rama) return;\r\n          saveActiveSnapshot();\r\n          data.ramaWeb = rama;\r\n          const snapshot = data.snapshotsRama[rama];\r\n          data.jugadores = JSON.parse(JSON.stringify(snapshot?.jugadores || []));\r\n          data.ultimaActualizacionWeb = snapshot?.ultimaActualizacionWeb || '';\r\n          setWebSyncStatus(null);\r\n          markDirty();\r\n          render();\r\n        });\r\n        sourceTabs.appendChild(button);\r\n      }\r\n    }\r\n    for (const source of (isArgentinaCandidate ? [] : SOURCES)) {\r\n      const button = document.createElement('button');\r\n      button.type = 'button';\r\n      button.className = 'performance-sync-btn';\r\n      button.classList.toggle('active', data.fuente === source.id);\r\n      button.textContent = source.label;\r\n      button.addEventListener('click', () => {\r\n        if (data.fuente === source.id) return;\r\n        saveActiveSnapshot();\r\n        data.fuente = source.id;\r\n        const snapshot = data.snapshots[source.id];\r\n        data.jugadores = JSON.parse(JSON.stringify(snapshot?.jugadores || []));\r\n        data.ultimaActualizacionWeb = snapshot?.ultimaActualizacionWeb || '';\r\n        markDirty();\r\n        render();\r\n      });\r\n      sourceTabs.appendChild(button);\r\n    }\r\n    root.appendChild(sourceTabs);\r\n\r\n    if (isArgentinaCandidate) {\r\n      root.appendChild(buildArgentinaSelector());\r\n    } else {\r\n      const positionField = document.createElement('label');\r\n      positionField.className = 'field';\r\n      const positionLabel = document.createElement('span');\r\n      positionLabel.textContent = 'Posici\u00F3n';\r\n      const positionSelect = document.createElement('select');\r\n      for (const position of POSITIONS) {\r\n        const option = document.createElement('option');\r\n        option.value = position.id;\r\n        option.textContent = position.label;\r\n        positionSelect.appendChild(option);\r\n      }\r\n      positionSelect.value = data.posicion;\r\n      positionSelect.addEventListener('change', () => {\r\n        data.posicion = positionSelect.value;\r\n        markDirty();\r\n      });\r\n      positionField.append(positionLabel, positionSelect);\r\n      root.appendChild(positionField);\r\n    }\r\n\r\n    // T\u00CDTULO (2026-09-02, pedido explicito del usuario): texto libre, cae\r\n    // al nombre de broadcast del modulo si queda vacio (ver\r\n    // program/js/renderers/performanceTable.js, DEFAULT_TITLE). Solo\r\n    // Argentina Streamers: el asset de GLA no tiene zona de titulo, un\r\n    // campo que no hace nada ahi es ruido en su panel.\r\n    if (isArgentinaCandidate) {\r\n      const tituloField = document.createElement('label');\r\n      tituloField.className = 'field';\r\n      const tituloLabel = document.createElement('span');\r\n      tituloLabel.textContent = 'T\u00EDtulo';\r\n      const tituloInput = document.createElement('input');\r\n      tituloInput.type = 'text';\r\n      tituloInput.placeholder = ARGENTINA_CANDIDATE_LABELS[moduleId] || '';\r\n      tituloInput.value = data.titulo || '';\r\n      tituloInput.addEventListener('input', () => {\r\n        data.titulo = tituloInput.value;\r\n        markDirty();\r\n      });\r\n      tituloField.append(tituloLabel, tituloInput);\r\n      root.appendChild(tituloField);\r\n    }\r\n\r\n    // \"ACTUALIZAR DATOS DE LA WEB\" (argentinastreamers.com) -- exclusivo\r\n    // de Argentina Streamers, separado del bloque de gla.futbol de mas\r\n    // abajo. Solo actualiza el draft del panel (data.jugadores), nunca\r\n    // manda al aire por si solo.\r\n    if (isArgentinaCandidate) {\r\n      const webSyncRow = document.createElement('div');\r\n      webSyncRow.className = 'performance-sync';\r\n\r\n      const webSyncBtn = document.createElement('button');\r\n      webSyncBtn.type = 'button';\r\n      webSyncBtn.className = 'performance-sync-btn';\r\n      webSyncBtn.textContent = `ACTUALIZAR DATOS DE LA WEB (${RAMA_LABELS[data.ramaWeb]})`;\r\n      webSyncBtn.disabled = webSyncStatus?.kind === 'loading';\r\n      webSyncBtn.addEventListener('click', syncFromArgentinaStreamersWeb);\r\n      webSyncRow.appendChild(webSyncBtn);\r\n\r\n      if (webSyncStatus) {\r\n        const statusEl = document.createElement('span');\r\n        statusEl.className = `performance-sync-status ${webSyncStatus.kind}`;\r\n        statusEl.textContent = webSyncStatus.text;\r\n        if (webSyncStatus.detail) statusEl.title = webSyncStatus.detail;\r\n        webSyncRow.appendChild(statusEl);\r\n      }\r\n\r\n      const webUpdatedAt = formatUpdatedAt(data.ultimaActualizacionWeb);\r\n      if (webUpdatedAt) {\r\n        const updatedEl = document.createElement('span');\r\n        updatedEl.className = 'performance-sync-updated-at';\r\n        updatedEl.textContent = `\u00DAltima actualizaci\u00F3n: ${webUpdatedAt}`;\r\n        webSyncRow.appendChild(updatedEl);\r\n      }\r\n      root.appendChild(webSyncRow);\r\n    }\r\n\r\n    // \"ACTUALIZAR DESDE WEB\" de gla.futbol: solo GLA (en Argentina Streamers\r\n    // el servidor lo rechaza siempre -- era un boton que solo podia fallar).\r\n    if (WEB_SYNC_MODULE_IDS.includes(moduleId) && !isArgentinaCandidate) {\r\n      const syncRow = document.createElement('div');\r\n      syncRow.className = 'performance-sync';\r\n\r\n      const syncBtn = document.createElement('button');\r\n      syncBtn.type = 'button';\r\n      syncBtn.className = 'performance-sync-btn';\r\n      syncBtn.textContent = 'ACTUALIZAR DESDE WEB';\r\n      syncBtn.disabled = syncStatus?.kind === 'loading';\r\n      syncBtn.addEventListener('click', syncFromWeb);\r\n      syncRow.appendChild(syncBtn);\r\n      // ACTUALIZADOR DE DATOS (2026-10-21): con FUENTE = TORNEO, edicion de\r\n      // la que salen los datos (LIGA no depende de esto).\r\n      if (data.fuente === 'torneo') syncRow.appendChild(createGlaTorneoSourceNote());\r\n\r\n      if (syncStatus) {\r\n        const statusEl = document.createElement('span');\r\n        statusEl.className = `performance-sync-status ${syncStatus.kind}`;\r\n        statusEl.textContent = syncStatus.text;\r\n        if (syncStatus.detail) statusEl.title = syncStatus.detail;\r\n        syncRow.appendChild(statusEl);\r\n      }\r\n\r\n      const updatedAt = formatUpdatedAt(data.ultimaActualizacionWeb);\r\n      if (updatedAt) {\r\n        const updatedEl = document.createElement('span');\r\n        updatedEl.className = 'performance-sync-updated-at';\r\n        updatedEl.textContent = `\u00DAltima actualizaci\u00F3n: ${updatedAt}`;\r\n        syncRow.appendChild(updatedEl);\r\n      }\r\n      root.appendChild(syncRow);\r\n\r\n      if (syncStatus?.kind === 'success' && syncStatus.unmatchedTeams?.length) {\r\n        const warning = document.createElement('p');\r\n        warning.className = 'performance-sync-warning';\r\n        warning.textContent = `Sin equipo local equivalente para: ${syncStatus.unmatchedTeams.join(', ')}. Asign\u00E1 el equipo a mano en la fila correspondiente.`;\r\n        root.appendChild(warning);\r\n      }\r\n    }\r\n\r\n    const note = document.createElement('p');\r\n    note.className = 'performance-note';\r\n    const maxRows = effectiveMaxRows();\r\n    let pairNote = '';\r\n    if (isArgentinaCandidate && (data.posicion === 'placaL-top' || data.posicion === 'placaL-bottom')) {\r\n      pairNote = 'En modo 5 SLOTS, TAKE, UPDATE y OUT operan juntas las dos placas elegidas arriba. ';\r\n    } else if (!isArgentinaCandidate && (moduleId === 'goleadores' || moduleId === 'asistidores') && data.posicion === 'placaL') {\r\n      pairNote = 'En PLACA L, TAKE, UPDATE y OUT operan Goleadores y Asistidores juntas. ';\r\n    }\r\n    note.textContent = `${pairNote}${config.orderNote} M\u00E1ximo ${maxRows} jugadores${isArgentinaCandidate ? ' en este modo' : ', seg\u00FAn los casilleros del asset'}.`;\r\n    root.appendChild(note);\r\n\r\n    const rows = document.createElement('div');\r\n    rows.className = 'performance-rows';\r\n\r\n    data.jugadores.forEach((player, index) => {\r\n      const row = document.createElement('section');\r\n      row.className = 'performance-row-editor';\r\n\r\n      const rowHeader = document.createElement('div');\r\n      rowHeader.className = 'performance-row-header';\r\n      const rowTitle = document.createElement('strong');\r\n      rowTitle.textContent = `JUGADOR ${index + 1}`;\r\n      const removeButton = document.createElement('button');\r\n      removeButton.type = 'button';\r\n      removeButton.className = 'performance-remove';\r\n      removeButton.textContent = 'ELIMINAR';\r\n      removeButton.addEventListener('click', () => {\r\n        data.jugadores.splice(index, 1);\r\n        markDirty();\r\n        render();\r\n      });\r\n      rowHeader.append(rowTitle, removeButton);\r\n      row.appendChild(rowHeader);\r\n\r\n      const identity = document.createElement('div');\r\n      identity.className = 'performance-identity';\r\n      const crest = document.createElement('img');\r\n      crest.className = 'performance-crest-preview';\r\n      crest.alt = '';\r\n      const crestSrc = crestFile(player.teamId);\r\n      if (crestSrc) crest.src = crestSrc;\r\n\r\n      const teamSelect = document.createElement('select');\r\n      teamSelect.setAttribute('aria-label', `Equipo del jugador ${index + 1}`);\r\n      for (const team of TEAM_OPTIONS) {\r\n        // Argentina Streamers (2026-10-08): equipos ocultos en EQUIPOS no se\r\n        // ofrecen, salvo el ya elegido en esta fila. GLA sin cambios.\r\n        if (isArgentinaCandidate && team.visible === false && team.id !== (player.teamId || '')) continue;\r\n        // GLA (2026-10-21): mismo criterio para sus tablas.\r\n        if (document.body.dataset.theme === 'gla' && team.visible === false && team.id !== (player.teamId || '')) continue;\r\n        const option = document.createElement('option');\r\n        option.value = team.id;\r\n        option.textContent = team.label;\r\n        teamSelect.appendChild(option);\r\n      }\r\n      teamSelect.value = player.teamId || '';\r\n      teamSelect.addEventListener('change', () => {\r\n        player.teamId = teamSelect.value;\r\n        const src = crestFile(player.teamId);\r\n        if (src) crest.src = src;\r\n        else crest.removeAttribute('src');\r\n        markDirty();\r\n      });\r\n\r\n      const nameInput = document.createElement('input');\r\n      nameInput.type = 'text';\r\n      nameInput.maxLength = 80;\r\n      nameInput.value = player.nombre || '';\r\n      nameInput.placeholder = 'Nombre del jugador';\r\n      nameInput.setAttribute('aria-label', `Nombre del jugador ${index + 1}`);\r\n      nameInput.addEventListener('input', () => {\r\n        player.nombre = nameInput.value;\r\n        markDirty();\r\n      });\r\n      identity.append(crest, teamSelect, nameInput);\r\n      row.appendChild(identity);\r\n\r\n      const stats = document.createElement('div');\r\n      stats.className = 'performance-stats';\r\n      for (const stat of config.stats) {\r\n        const input = createNumberInput(player[stat.key], `${stat.label}, jugador ${index + 1}`);\r\n        input.addEventListener('input', () => {\r\n          player[stat.key] = numeric(input.value);\r\n          markDirty();\r\n        });\r\n        stats.appendChild(createField(stat.label, input));\r\n      }\r\n      row.appendChild(stats);\r\n      rows.appendChild(row);\r\n    });\r\n\r\n    if (data.jugadores.length === 0) {\r\n      const empty = document.createElement('p');\r\n      empty.className = 'performance-empty';\r\n      empty.textContent = 'Todav\u00EDa no hay jugadores cargados.';\r\n      rows.appendChild(empty);\r\n    }\r\n    root.appendChild(rows);\r\n\r\n    const adjustSection = document.createElement('section');\r\n    adjustSection.className = 'performance-adjust-section';\r\n    const adjustHeading = document.createElement('h3');\r\n    adjustHeading.textContent = 'AJUSTE DE TEXTOS (por columna)';\r\n    adjustSection.appendChild(adjustHeading);\r\n    const adjustColumns = ADJUST_COLUMNS_BY_MODULE[moduleId];\r\n    const activeAdjustColumns = isArgentinaCandidate\r\n      ? [...adjustColumns.always, ...adjustColumns.argentinaOnly]\r\n      : adjustColumns.always;\r\n    for (const { key, label } of activeAdjustColumns) {\r\n      const wrap = document.createElement('label');\r\n      wrap.className = 'performance-field';\r\n      const lbl = document.createElement('span');\r\n      lbl.textContent = label;\r\n      wrap.appendChild(lbl);\r\n      mountAdjustControl(wrap, data, key, markDirty, saveOptions);\r\n      adjustSection.appendChild(wrap);\r\n    }\r\n    root.appendChild(adjustSection);\r\n\r\n    const addButton = document.createElement('button');\r\n    addButton.type = 'button';\r\n    addButton.className = 'btn performance-add';\r\n    addButton.textContent = 'A\u00D1ADIR JUGADOR';\r\n    addButton.disabled = data.jugadores.length >= maxRows;\r\n    addButton.addEventListener('click', () => {\r\n      if (data.jugadores.length >= maxRows) return;\r\n      const player = { teamId: '', nombre: '' };\r\n      for (const stat of config.stats) player[stat.key] = 0;\r\n      data.jugadores.push(player);\r\n      markDirty();\r\n      render();\r\n    });\r\n    root.appendChild(addButton);\r\n  }\r\n\r\n  render();\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/cronograma-hoy-panel.js","// Reescrito (2026-09-04, pedido explicito del usuario: \"quiero poder\r\n// armar manualmente un enfrentamiento\" -- reemplaza la herencia\r\n// automatica del Marcador que tenia antes, con presets). Este panel\r\n// resuelve T\u00CDTULO + selectores LOCAL/VISITANTE (catalogo Argentina\r\n// Streamers, 4 equipos fijos) + presets completos (titulo+local+\r\n// visitante, NO posiciones -- esas siguen siendo layout, ver\r\n// shared/theme-layouts/argentinaStreamers.json). Escudos LOCAL/VISITANTE,\r\n// su posicion y \"COMPOSICI\u00D3N COMPLETA\" los sigue cubriendo el acordeon\r\n// generico de main.js (via shared/adjust-registry.js, entrada\r\n// \"cronogramaHoy\" con crestTeam) -- un composition-control propio aca\r\n// pisaria (container.innerHTML='' interno) el resto del panel, mismo bug\r\n// ya encontrado y corregido en los paneles de Z\u00F3calo Compuesto.\r\nimport { renderPresetsControl } from './presets-helper.js';\r\nimport { TEAM_OPTIONS as CATALOG_TEAM_OPTIONS } from '../../shared/teams.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../shared/themes.js';\r\n\r\n// Catalogo fijo (2026-09-04, pedido explicito del usuario: exactamente\r\n// estos 4, no el catalogo completo de equipos que mezclaria GLA). Mismos\r\n// IDs reales usados en todo el resto del proyecto para estos equipos.\r\nconst TEAM_OPTIONS = [\r\n  { id: '', label: 'SIN EQUIPO' },\r\n  { id: 'argentina-streamers', label: 'ARGENTINA STREAMERS' },\r\n  { id: 'argentina-streamers-fem', label: 'ARGENTINA STREAMERS FEM' },\r\n  { id: 'oxen', label: 'OXEN' },\r\n  { id: 'peru-creadores', label: 'PER\u00DA CREADORES' },\r\n  { id: 'argentina-senior', label: 'ARGENTINA SENIOR' },\r\n];\r\n\r\nfunction ensureDefaults(data) {\r\n  if (!data || typeof data !== 'object') return;\r\n  if (typeof data.titulo !== 'string') data.titulo = '';\r\n  if (typeof data.teamLocal !== 'string') data.teamLocal = '';\r\n  if (typeof data.teamVisitante !== 'string') data.teamVisitante = '';\r\n  if (!Array.isArray(data.presets)) data.presets = [];\r\n}\r\n\r\nexport function renderCronogramaHoyPanel(container, data, onDirty) {\r\n  if (!data) return () => {};\r\n  ensureDefaults(data);\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'cronograma-editor';\r\n  container.appendChild(root);\r\n\r\n  const section = document.createElement('div');\r\n  section.className = 'panel-section';\r\n  section.innerHTML = `\r\n    <h3 class=\"panel-subtitle\">CONTENIDO DE CRONOGRAMA HOY</h3>\r\n    <div class=\"field-group\">\r\n      <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">T\u00CDTULO</label>\r\n      <input type=\"text\" class=\"mc-input inp-titulo\" value=\"${escapeAttr(data.titulo)}\" placeholder=\"PR\u00D3XIMO PARTIDO / HOY 18:00 / PARTIDO DEL D\u00CDA...\" />\r\n    </div>\r\n    <div class=\"field-group\">\r\n      <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">EQUIPO LOCAL</label>\r\n      <select class=\"mc-select sel-local\">${renderTeamOptions(data.teamLocal)}</select>\r\n    </div>\r\n    <div class=\"field-group\">\r\n      <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">EQUIPO VISITANTE</label>\r\n      <select class=\"mc-select sel-visitante\">${renderTeamOptions(data.teamVisitante)}</select>\r\n    </div>\r\n    <div style=\"font-size:11px; opacity:0.8; margin:6px 0 10px;\">\r\n      Los escudos aparecen autom\u00E1ticamente seg\u00FAn el equipo elegido. Posici\u00F3n individual de cada escudo en AJUSTE DE COMPOSICI\u00D3N, m\u00E1s abajo.\r\n    </div>\r\n  `;\r\n\r\n  const inpTitulo = section.querySelector('.inp-titulo');\r\n  inpTitulo.addEventListener('input', () => {\r\n    data.titulo = inpTitulo.value;\r\n    onDirty();\r\n  });\r\n\r\n  const selLocal = section.querySelector('.sel-local');\r\n  selLocal.addEventListener('change', () => {\r\n    data.teamLocal = selLocal.value;\r\n    onDirty();\r\n  });\r\n\r\n  const selVisitante = section.querySelector('.sel-visitante');\r\n  selVisitante.addEventListener('change', () => {\r\n    data.teamVisitante = selVisitante.value;\r\n    onDirty();\r\n  });\r\n\r\n  root.appendChild(section);\r\n\r\n  const presetsBox = document.createElement('div');\r\n  root.appendChild(presetsBox);\r\n  renderPresetsControl(presetsBox, data, {\r\n    presetKey: 'presets',\r\n    title: 'PRESETS DE ENFRENTAMIENTO (CRONOGRAMA HOY)',\r\n    buttons: [\r\n      {\r\n        label: 'GUARDAR PRESET',\r\n        type: 'complete',\r\n        getFields: () => ({ titulo: data.titulo, teamLocal: data.teamLocal, teamVisitante: data.teamVisitante }),\r\n      },\r\n    ],\r\n    onApply: (fields) => {\r\n      if (fields.titulo !== undefined) data.titulo = fields.titulo;\r\n      if (fields.teamLocal !== undefined) data.teamLocal = fields.teamLocal;\r\n      if (fields.teamVisitante !== undefined) data.teamVisitante = fields.teamVisitante;\r\n      inpTitulo.value = data.titulo;\r\n      selLocal.value = data.teamLocal;\r\n      selVisitante.value = data.teamVisitante;\r\n      onDirty();\r\n    },\r\n    onDirty,\r\n  });\r\n\r\n  return () => {};\r\n}\r\n\r\n// Argentina Streamers (2026-10-08, pedido explicito: \"EQUIPOS es la fuente\r\n// central del catalogo, no mantener listas divergentes por modulo\"): usa el\r\n// catalogo central del theme respetando VISIBLE (el equipo ya elegido se\r\n// sigue mostrando aunque este oculto). GLA conserva la lista fija de antes.\r\nfunction renderTeamOptions(selectedId) {\r\n  const isArgentina = document.body.dataset.theme === ARGENTINA_STREAMERS_THEME_ID;\r\n  const source = isArgentina\r\n    ? CATALOG_TEAM_OPTIONS\r\n      .filter((t) => t.visible !== false || t.id === selectedId)\r\n      .map((t) => ({ id: t.id, label: t.id ? t.label.toUpperCase() : 'SIN EQUIPO' }))\r\n    : TEAM_OPTIONS;\r\n  return source.map(\r\n    (t) => `<option value=\"${t.id}\" ${t.id === selectedId ? 'selected' : ''}>${escapeAttr(t.label)}</option>`\r\n  ).join('');\r\n}\r\n\r\nfunction escapeAttr(str) {\r\n  return String(str || '')\r\n    .replace(/&/g, '&amp;')\r\n    .replace(/\"/g, '&quot;')\r\n    .replace(/</g, '&lt;')\r\n    .replace(/>/g, '&gt;');\r\n}\r\n","http://localhost:4430/master-control/js/ficha-jugador-panel.js","// FICHA JUGADOR (Argentina Streamers; GLA no muestra este modulo).\r\n//\r\n// Rehecho 2026-10-08 (pedido explicito del usuario: \"FICHA JUGADOR NO usa\r\n// Convocados\") y filtrado por PLANTELES 2026-10-09 (pedido explicito: \"que\r\n// solo me aparezcan en el desplegable los jugadores que figuran en\r\n// PLANTELES\"), sobre el adaptador web compartido\r\n// (server/argentinaStreamersWebData.js):\r\n//   - EQUIPO del Marcador con datos web (Argentina Streamers / FEM):\r\n//       LISTA del desplegable <- PLANTELES del equipo de la rama elegida\r\n//         (server/argentinaStreamersPlayerStats.js, \"plantelFicha\");\r\n//       NUMEROS <- PERFIL web del jugador asociado (seccion JUGADORES; lo\r\n//         mismo que abre el sitio al hacer click en el jugador). Elegirlo\r\n//         vuelve a leer la web. Sin asociacion web: \"SIN ASOCIACI\u00D3N WEB\",\r\n//         numeros a mano.\r\n//   - EQUIPO rival (sin datos web): plantel de PLANTELES, carga manual.\r\n// NOMBRE EN PANTALLA (por jugador, guardado en el plantel): como se ve el\r\n// nombre en la Ficha; vacio = nombre normal del plantel. No toca la\r\n// identidad web del jugador.\r\n// Los 4 numeros quedan editables a mano despues de cualquier carga web (un\r\n// nuevo ACTUALIZAR los vuelve a pisar solo porque el operador lo pidio).\r\n// TAKE nunca consulta la web: Program lee lo copiado en \"data\".\r\nimport { teamName } from '../../shared/teams.js';\r\nimport { mountAdjustControl } from './field-editors.js';\r\n\r\nconst STATS = [\r\n  { key: 'goles', label: 'GOLES' },\r\n  { key: 'asistencias', label: 'ASISTENCIAS' },\r\n  { key: 'presencias', label: 'PRESENCIAS' },\r\n  { key: 'mvps', label: 'MVPS' },\r\n];\r\n\r\nconst ADJUST_FIELDS = [\r\n  { key: 'nombre', label: 'Nombre del jugador' },\r\n  { key: 'goles', label: 'Goles' },\r\n  { key: 'asistencias', label: 'Asistencias' },\r\n  { key: 'presencias', label: 'Presencias' },\r\n  { key: 'mvps', label: 'MVPs' },\r\n];\r\n\r\nconst RAMA_POR_EQUIPO = { 'argentina-streamers': 'masculino', 'argentina-streamers-fem': 'femenino' };\r\nconst RAMA_LABELS = { masculino: 'MASCULINO', femenino: 'FEMENINO' };\r\n\r\nfunction formatFecha(iso) {\r\n  if (!iso) return '';\r\n  const d = new Date(iso);\r\n  return Number.isNaN(d.getTime()) ? '' : d.toLocaleString('es-AR', { hour12: false });\r\n}\r\n\r\n// Nombre que ve Program: NOMBRE EN PANTALLA si el operador lo cargo, si no\r\n// el nombre normal del plantel (\"18. KITO SHELBY\").\r\nfunction fichaNombre(nombrePantalla, nombreTV) {\r\n  return String(nombrePantalla || '').trim().toUpperCase() || nombreTV || '';\r\n}\r\n\r\n// Plantel central (modo manual / rival) -- mismo comportamiento de antes.\r\nfunction applyRosterPlayer(data, jugador) {\r\n  data.jugadorKey = `plantel:${jugador.id}`;\r\n  data.jugadorId = jugador.id;\r\n  data.jugadorWebId = jugador.webId || '';\r\n  data.teamId = jugador.teamId;\r\n  data.nombre = fichaNombre(jugador.metadata?.nombrePantalla, jugador.nombreTV);\r\n  data.asociacionEstadistica = '';\r\n  const stats = jugador.metadata?.stats;\r\n  if (stats) {\r\n    data.goles = stats.goles ?? 0;\r\n    data.asistencias = stats.asistencias ?? 0;\r\n    data.presencias = stats.presencias ?? 0;\r\n    data.mvps = stats.mvps ?? 0;\r\n    data.golesDisponible = stats.golesDisponible !== false;\r\n    data.asistenciasDisponible = stats.asistenciasDisponible !== false;\r\n    data.presenciasDisponible = stats.presenciasDisponible !== false;\r\n    data.mvpsDisponible = stats.mvpsDisponible !== false;\r\n  } else {\r\n    data.goles = 0; data.asistencias = 0; data.presencias = 0; data.mvps = 0;\r\n    data.golesDisponible = true; data.asistenciasDisponible = true; data.presenciasDisponible = true; data.mvpsDisponible = true;\r\n  }\r\n}\r\n\r\n// Numeros del PERFIL web (goles, asistencias, presencias, MVPs). Sin perfil\r\n// publicado NO se inventa nada: \"no disponibles\" (Program muestra \"\u2014\").\r\nfunction applyPerfil(data, perfil) {\r\n  data.asociacionEstadistica = perfil ? 'ok' : 'sin-perfil';\r\n  data.perfilFuente = perfil?.fuente || '';\r\n  for (const { key } of STATS) {\r\n    const value = perfil?.[key];\r\n    const disponible = value !== null && value !== undefined;\r\n    data[key] = disponible ? value : 0;\r\n    data[`${key}Disponible`] = disponible;\r\n  }\r\n}\r\n\r\n// Jugador del PLANTEL (modo web): identidad del plantel + numeros de SU\r\n// perfil web si esta asociado; sin asociacion, numeros a mano (0 editables).\r\nfunction applyPlantelPlayer(data, jugador, rama) {\r\n  data.jugadorKey = `plantel:${jugador.id}`;\r\n  data.jugadorId = jugador.id;\r\n  data.jugadorWebId = jugador.webId || '';\r\n  data.teamId = jugador.teamId;\r\n  data.ramaWeb = rama;\r\n  data.nombre = fichaNombre(jugador.nombrePantalla, jugador.nombreTV);\r\n  if (jugador.asociacion === 'ok') {\r\n    applyPerfil(data, jugador.web?.perfil || null);\r\n    return;\r\n  }\r\n  data.asociacionEstadistica = 'sin-asociacion';\r\n  data.perfilFuente = '';\r\n  for (const { key } of STATS) {\r\n    data[key] = 0;\r\n    data[`${key}Disponible`] = true;\r\n  }\r\n}\r\n\r\nexport function renderFichaJugadorPanel(container, data, scoreboardData, onDirty, saveOptions) {\r\n  if (data.equipo !== 'visitante') data.equipo = 'local';\r\n  let teamId = null;\r\n  let webMode = false;\r\n  // Equipo del lado elegido (LOCAL/VISITANTE del Marcador). Se recalcula\r\n  // al cambiar de lado (antes quedaba fijo al abrir el panel y el cambio de\r\n  // lado seguia cargando el plantel del equipo anterior).\r\n  function resolveTeam() {\r\n    teamId = data.equipo === 'visitante' ? scoreboardData?.teamB : scoreboardData?.teamA;\r\n    const teamRama = RAMA_POR_EQUIPO[teamId] || null;\r\n    if (teamRama && data.ramaWeb !== 'masculino' && data.ramaWeb !== 'femenino') data.ramaWeb = teamRama;\r\n    webMode = !!teamRama;\r\n  }\r\n  resolveTeam();\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'performance-editor performance-editor--fichaJugador';\r\n  container.appendChild(root);\r\n\r\n  let roster = null;\r\n  let webList = null; // respuesta de /api/argentina-streamers/ficha/jugadores\r\n  let status = null; // {kind, text, detail}\r\n  let disposed = false;\r\n\r\n  function loadForMode() {\r\n    if (webMode) loadWebList();\r\n    else loadRoster();\r\n  }\r\n\r\n  async function loadRoster() {\r\n    if (!teamId) { render(); return; }\r\n    try {\r\n      const response = await fetch(`/api/planteles/${encodeURIComponent(teamId)}`);\r\n      const body = await response.json().catch(() => null);\r\n      if (response.ok && body?.ok) roster = body.snapshot;\r\n    } catch {\r\n      // Sin red: el selector queda vacio, no rompe el resto del panel.\r\n    }\r\n    if (!disposed) render();\r\n  }\r\n\r\n  // Lista desde el cache del servidor (PLANTELES + seccion JUGADORES). Si la\r\n  // seccion web nunca se descargo, se pide UNA vez a la web automaticamente\r\n  // (solo la lista: nunca toca los datos del jugador ya cargado en el modulo).\r\n  let autoRefreshDone = false;\r\n  let webListError = null;\r\n  async function loadWebList() {\r\n    webListError = null;\r\n    try {\r\n      const response = await fetch(`/api/argentina-streamers/ficha/jugadores?rama=${encodeURIComponent(data.ramaWeb)}`);\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      webList = body;\r\n      if (!body.jugadores.length && !body.seccion?.ultimaActualizacion && !autoRefreshDone) {\r\n        autoRefreshDone = true;\r\n        await actualizarWeb();\r\n        return;\r\n      }\r\n    } catch (error) {\r\n      webListError = error.message;\r\n    }\r\n    if (!disposed) render();\r\n  }\r\n\r\n  // Jugador del plantel elegido. Compatibilidad: una ficha cargada antes de\r\n  // este cambio (clave \"web:...\") se reconoce por su id de la web.\r\n  function selectedPlantelPlayer() {\r\n    const plantel = webList?.plantel || [];\r\n    return plantel.find((j) => j.id === data.jugadorId)\r\n      || (data.jugadorWebId ? plantel.find((j) => j.webId === data.jugadorWebId) : null)\r\n      || null;\r\n  }\r\n\r\n  // \"ACTUALIZAR DATOS DE LA WEB\": relee JUGADORES + perfiles de la rama y\r\n  // reaplica el perfil del jugador elegido.\r\n  async function actualizarWeb() {\r\n    status = { kind: 'loading', text: `Leyendo JUGADORES ${RAMA_LABELS[data.ramaWeb]} en argentinastreamers.com...` };\r\n    render();\r\n    try {\r\n      const response = await fetch(`/api/argentina-streamers/ficha/sync-web?rama=${encodeURIComponent(data.ramaWeb)}`, { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      webList = body;\r\n      webListError = null;\r\n      const jugador = selectedPlantelPlayer();\r\n      if (jugador) {\r\n        applyPlantelPlayer(data, jugador, data.ramaWeb);\r\n        onDirty();\r\n      }\r\n      if (!body.refresh?.ok) {\r\n        status = { kind: 'error', text: 'NO SE PUDO ACTUALIZAR \u2014 SE CONSERVAN LOS \u00DALTIMOS DATOS V\u00C1LIDOS', detail: body.refresh?.error };\r\n      } else if (jugador && jugador.asociacion !== 'ok') {\r\n        status = { kind: 'error', text: 'DATOS WEB ACTUALIZADOS \u2014 ESTE JUGADOR NO TIENE ASOCIACI\u00D3N WEB (carg\u00E1 los n\u00FAmeros a mano)' };\r\n      } else if (jugador && data.asociacionEstadistica !== 'ok') {\r\n        status = { kind: 'error', text: 'DATOS WEB ACTUALIZADOS \u2014 LA WEB NO PUBLICA PERFIL PARA ESTE JUGADOR (carg\u00E1 los n\u00FAmeros a mano)' };\r\n      } else {\r\n        status = { kind: 'success', text: jugador ? `FICHA ACTUALIZADA: ${data.nombre}` : `DATOS WEB ${RAMA_LABELS[data.ramaWeb]} ACTUALIZADOS \u2014 eleg\u00ED un jugador` };\r\n      }\r\n    } catch (error) {\r\n      status = { kind: 'error', text: 'NO SE PUDO ACTUALIZAR \u2014 SE CONSERVAN LOS \u00DALTIMOS DATOS V\u00C1LIDOS', detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  // Elegir jugador = \"hacer click en el jugador y leer su ficha\": se aplica\r\n  // al instante el ultimo perfil conocido y se relee SU perfil en la web;\r\n  // si la web falla, queda el ultimo perfil valido (se avisa). Sin\r\n  // asociacion web no hay nada que leer: numeros a mano.\r\n  let fichaRequest = 0;\r\n  async function leerFicha(jugador) {\r\n    const requestId = ++fichaRequest;\r\n    applyPlantelPlayer(data, jugador, data.ramaWeb);\r\n    onDirty();\r\n    if (jugador.asociacion !== 'ok') {\r\n      status = {\r\n        kind: 'error',\r\n        text: jugador.asociacion === 'ambigua'\r\n          ? 'SIN ASOCIACI\u00D3N WEB \u2014 hay m\u00E1s de un jugador con ese nombre en la web, no se adivina (carg\u00E1 los n\u00FAmeros a mano)'\r\n          : 'SIN ASOCIACI\u00D3N WEB \u2014 este jugador del plantel no figura en la web (carg\u00E1 los n\u00FAmeros a mano)',\r\n      };\r\n      render();\r\n      return;\r\n    }\r\n    status = { kind: 'loading', text: `Leyendo la ficha de ${jugador.nombreTV} en argentinastreamers.com...` };\r\n    render();\r\n    try {\r\n      const response = await fetch(`/api/argentina-streamers/ficha/perfil?rama=${encodeURIComponent(data.ramaWeb)}&webId=${encodeURIComponent(jugador.webId)}`, { method: 'POST' });\r\n      const body = await response.json().catch(() => null);\r\n      if (requestId !== fichaRequest || disposed) return;\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      if (body.status === 'not-found') {\r\n        status = { kind: 'error', text: body.mensaje };\r\n      } else {\r\n        applyPerfil(data, body.jugador?.perfil || null);\r\n        onDirty();\r\n        if (body.status === 'sin-perfil') {\r\n          status = { kind: 'error', text: 'LA WEB NO PUBLICA PERFIL PARA ESTE JUGADOR \u2014 DATO NO DISPONIBLE (carg\u00E1 los n\u00FAmeros a mano)' };\r\n        } else if (body.desdeCache) {\r\n          status = { kind: 'error', text: 'NO SE PUDO LEER LA WEB \u2014 SE USA EL \u00DALTIMO PERFIL V\u00C1LIDO', detail: body.refresh?.error };\r\n        } else {\r\n          const distinciones = (body.jugador.perfil?.distinciones || []).map((d) => d.titulo).filter(Boolean);\r\n          status = { kind: 'success', text: `FICHA LE\u00CDDA DESDE LA WEB: ${data.nombre}${distinciones.length ? ` \u2014 distinciones: ${distinciones.join(', ')}` : ''}` };\r\n        }\r\n      }\r\n    } catch (error) {\r\n      if (requestId !== fichaRequest || disposed) return;\r\n      status = { kind: 'error', text: 'NO SE PUDO LEER LA WEB \u2014 SE USA EL \u00DALTIMO PERFIL V\u00C1LIDO', detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  // NOMBRE EN PANTALLA: se guarda en el plantel (persistente, por jugador) y\r\n  // se copia al nombre de la ficha. Vacio = nombre normal del plantel.\r\n  async function guardarNombrePantalla(jugadorTeamId, jugadorId, valor, nombreTV, onSaved) {\r\n    try {\r\n      const response = await fetch('/api/argentina-streamers/ficha/nombre-pantalla', {\r\n        method: 'PUT',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ teamId: jugadorTeamId, jugadorId, nombrePantalla: valor }),\r\n      });\r\n      const body = await response.json().catch(() => null);\r\n      if (!response.ok || !body?.ok) throw new Error(body?.error || `HTTP ${response.status}`);\r\n      const guardado = body.jugador?.metadata?.nombrePantalla || '';\r\n      onSaved(guardado);\r\n      if (data.jugadorId === jugadorId) {\r\n        data.nombre = fichaNombre(guardado, nombreTV);\r\n        onDirty();\r\n      }\r\n      status = { kind: 'success', text: guardado ? `NOMBRE EN PANTALLA GUARDADO: ${data.nombre}` : `NOMBRE EN PANTALLA BORRADO \u2014 se usa ${nombreTV}` };\r\n    } catch (error) {\r\n      status = { kind: 'error', text: 'NO SE PUDO GUARDAR EL NOMBRE EN PANTALLA', detail: error.message };\r\n    }\r\n    render();\r\n  }\r\n\r\n  function renderNombrePantalla(jugadorTeamId, jugadorId, actual, nombreTV, onSaved) {\r\n    const field = document.createElement('label');\r\n    field.className = 'performance-field';\r\n    const label = document.createElement('span');\r\n    label.textContent = `NOMBRE EN PANTALLA (vac\u00EDo = ${nombreTV})`;\r\n    const row = document.createElement('div');\r\n    row.className = 'performance-sync';\r\n    const input = document.createElement('input');\r\n    input.type = 'text';\r\n    input.maxLength = 60;\r\n    input.value = actual || '';\r\n    input.placeholder = nombreTV;\r\n    const saveBtn = document.createElement('button');\r\n    saveBtn.type = 'button';\r\n    saveBtn.className = 'performance-sync-btn';\r\n    saveBtn.textContent = 'GUARDAR NOMBRE';\r\n    const save = () => guardarNombrePantalla(jugadorTeamId, jugadorId, input.value, nombreTV, onSaved);\r\n    saveBtn.addEventListener('click', save);\r\n    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); save(); } });\r\n    row.append(input, saveBtn);\r\n    field.append(label, row);\r\n    root.appendChild(field);\r\n  }\r\n\r\n  function renderEquipoRow() {\r\n    const equipoRow = document.createElement('div');\r\n    equipoRow.className = 'performance-sync';\r\n    for (const [side, label] of [['local', 'LOCAL'], ['visitante', 'VISITANTE']]) {\r\n      const btn = document.createElement('button');\r\n      btn.type = 'button';\r\n      btn.className = 'performance-sync-btn';\r\n      btn.classList.toggle('active', data.equipo === side);\r\n      const sideTeam = side === 'visitante' ? scoreboardData?.teamB : scoreboardData?.teamA;\r\n      btn.textContent = `${label} \u2014 ${teamName(sideTeam) || 'SIN EQUIPO'}`;\r\n      btn.addEventListener('click', () => {\r\n        if (data.equipo === side) return;\r\n        data.equipo = side;\r\n        const rama = RAMA_POR_EQUIPO[sideTeam];\r\n        if (rama) data.ramaWeb = rama;\r\n        onDirty();\r\n        resolveTeam();\r\n        roster = null;\r\n        webList = null;\r\n        status = null;\r\n        render();\r\n        loadForMode();\r\n      });\r\n      equipoRow.appendChild(btn);\r\n    }\r\n    root.appendChild(equipoRow);\r\n  }\r\n\r\n  function renderStatus() {\r\n    if (!status) return;\r\n    const statusEl = document.createElement('p');\r\n    statusEl.className = `performance-sync-status ${status.kind}`;\r\n    statusEl.textContent = status.text;\r\n    if (status.detail) statusEl.title = status.detail;\r\n    root.appendChild(statusEl);\r\n  }\r\n\r\n  // Los 4 numeros: precargados por la web, editables a mano despues.\r\n  function renderStatsEditor() {\r\n    const statsEditor = document.createElement('div');\r\n    statsEditor.className = 'performance-stats';\r\n    for (const stat of STATS) {\r\n      const field = document.createElement('label');\r\n      field.className = 'performance-field';\r\n      const label = document.createElement('span');\r\n      const disponible = data[`${stat.key}Disponible`] !== false;\r\n      const sinAsociacion = data.asociacionEstadistica && !['ok', 'sin-perfil'].includes(data.asociacionEstadistica);\r\n      label.textContent = disponible\r\n        ? stat.label\r\n        : `${stat.label} (${sinAsociacion ? 'SIN ASOCIACI\u00D3N \u2014 CARGA MANUAL' : 'DATO NO DISPONIBLE EN LA WEB'})`;\r\n      const input = document.createElement('input');\r\n      input.type = 'number';\r\n      input.min = '0';\r\n      input.max = '999';\r\n      input.value = disponible ? String(data[stat.key] ?? 0) : '';\r\n      input.placeholder = '\u2014';\r\n      input.addEventListener('input', () => {\r\n        const value = Number.parseInt(input.value, 10);\r\n        data[stat.key] = Number.isFinite(value) && value >= 0 ? value : 0;\r\n        data[`${stat.key}Disponible`] = input.value.trim() !== '';\r\n        onDirty();\r\n      });\r\n      field.append(label, input);\r\n      statsEditor.appendChild(field);\r\n    }\r\n    root.appendChild(statsEditor);\r\n  }\r\n\r\n  function renderAdjust() {\r\n    const adjustSection = document.createElement('section');\r\n    adjustSection.className = 'performance-adjust-section';\r\n    const adjustHeading = document.createElement('h3');\r\n    adjustHeading.textContent = 'AJUSTE DE TEXTOS';\r\n    adjustSection.appendChild(adjustHeading);\r\n    for (const { key, label } of ADJUST_FIELDS) {\r\n      const wrap = document.createElement('label');\r\n      wrap.className = 'performance-field';\r\n      const lbl = document.createElement('span');\r\n      lbl.textContent = label;\r\n      wrap.appendChild(lbl);\r\n      mountAdjustControl(wrap, data, key, onDirty, saveOptions);\r\n      adjustSection.appendChild(wrap);\r\n    }\r\n    root.appendChild(adjustSection);\r\n  }\r\n\r\n  function optionLabel(jugador) {\r\n    const pantalla = jugador.nombrePantalla ? ` \u2014 EN PANTALLA: ${jugador.nombrePantalla.toUpperCase()}` : '';\r\n    if (jugador.asociacion !== 'ok') return `${jugador.nombreTV}${pantalla} \u2014 SIN ASOCIACI\u00D3N WEB`;\r\n    return `${jugador.nombreTV}${pantalla}${jugador.web?.perfil ? '' : ' (sin perfil en la web)'}`;\r\n  }\r\n\r\n  function renderWebMode() {\r\n    const ramaRow = document.createElement('div');\r\n    ramaRow.className = 'performance-source-tabs';\r\n    for (const rama of ['masculino', 'femenino']) {\r\n      const btn = document.createElement('button');\r\n      btn.type = 'button';\r\n      btn.className = 'performance-sync-btn';\r\n      btn.classList.toggle('active', data.ramaWeb === rama);\r\n      btn.textContent = RAMA_LABELS[rama];\r\n      btn.addEventListener('click', () => {\r\n        if (data.ramaWeb === rama) return;\r\n        data.ramaWeb = rama;\r\n        onDirty();\r\n        webList = null;\r\n        status = null;\r\n        autoRefreshDone = false;\r\n        render();\r\n        loadWebList();\r\n      });\r\n      ramaRow.appendChild(btn);\r\n    }\r\n    root.appendChild(ramaRow);\r\n\r\n    const plantel = webList?.plantel || [];\r\n    const plantelName = teamName(webList?.teamId) || webList?.teamId || '';\r\n    const fuente = document.createElement('p');\r\n    fuente.className = 'performance-note';\r\n    if (webListError) {\r\n      fuente.textContent = `NO SE PUDO CARGAR LA LISTA (${webListError}). Apret\u00E1 ACTUALIZAR DATOS DE LA WEB.`;\r\n    } else if (!webList) {\r\n      fuente.textContent = 'Cargando lista...';\r\n    } else if (!plantel.length) {\r\n      fuente.textContent = `EL PLANTEL DE ${plantelName} EST\u00C1 VAC\u00CDO \u2014 carg\u00E1 los jugadores en PLANTELES.`;\r\n    } else {\r\n      const s = webList.seccion || {};\r\n      const sinAsociacion = plantel.filter((j) => j.asociacion !== 'ok').length;\r\n      fuente.textContent = `Lista: PLANTELES de ${plantelName} (${plantel.length} jugadores${sinAsociacion ? `, ${sinAsociacion} sin asociaci\u00F3n web` : ''}). Datos: secci\u00F3n JUGADORES ${RAMA_LABELS[webList.rama]} de argentinastreamers.com \u2014 \u00FAltimo dato v\u00E1lido ${formatFecha(s.ultimaActualizacion) || 'nunca'}${s.ultimoResultado === 'error' ? ` (\u26A0 \u00FAltimo intento fall\u00F3: ${s.ultimoError})` : ''}.`;\r\n    }\r\n    root.appendChild(fuente);\r\n\r\n    const selectField = document.createElement('label');\r\n    selectField.className = 'field';\r\n    const selectLabel = document.createElement('span');\r\n    selectLabel.textContent = 'JUGADOR';\r\n    const select = document.createElement('select');\r\n    const emptyOpt = document.createElement('option');\r\n    emptyOpt.value = '';\r\n    emptyOpt.textContent = webList ? 'Seleccionar jugador del plantel' : 'Cargando...';\r\n    select.appendChild(emptyOpt);\r\n    for (const jugador of plantel) {\r\n      const option = document.createElement('option');\r\n      option.value = jugador.id;\r\n      option.textContent = optionLabel(jugador);\r\n      select.appendChild(option);\r\n    }\r\n    const selected = selectedPlantelPlayer();\r\n    select.value = selected ? selected.id : '';\r\n    select.disabled = !plantel.length || status?.kind === 'loading';\r\n    select.addEventListener('change', () => {\r\n      const jugador = plantel.find((j) => j.id === select.value);\r\n      if (!jugador) return;\r\n      leerFicha(jugador);\r\n    });\r\n    selectField.append(selectLabel, select);\r\n    root.appendChild(selectField);\r\n\r\n    if (webList && !selected && data.nombre) {\r\n      const gone = document.createElement('p');\r\n      gone.className = 'performance-empty';\r\n      gone.textContent = `La ficha cargada (${data.nombre}) no corresponde a ning\u00FAn jugador de este plantel \u2014 eleg\u00ED uno de la lista.`;\r\n      root.appendChild(gone);\r\n    }\r\n\r\n    if (selected) {\r\n      renderNombrePantalla(selected.teamId, selected.id, selected.nombrePantalla, selected.nombreTV, (guardado) => {\r\n        selected.nombrePantalla = guardado;\r\n      });\r\n    }\r\n\r\n    const webRow = document.createElement('div');\r\n    webRow.className = 'performance-sync';\r\n    const webBtn = document.createElement('button');\r\n    webBtn.type = 'button';\r\n    webBtn.className = 'performance-sync-btn';\r\n    webBtn.textContent = `ACTUALIZAR DATOS DE LA WEB (${RAMA_LABELS[data.ramaWeb]})`;\r\n    webBtn.disabled = status?.kind === 'loading';\r\n    webBtn.addEventListener('click', actualizarWeb);\r\n    webRow.appendChild(webBtn);\r\n    root.appendChild(webRow);\r\n    renderStatus();\r\n  }\r\n\r\n  function renderManualMode() {\r\n    const equipoName = teamName(teamId) || (data.equipo === 'visitante' ? 'VISITANTE' : 'LOCAL');\r\n    const note = document.createElement('p');\r\n    note.className = 'performance-note';\r\n    note.textContent = teamId\r\n      ? `NO HAY DATOS WEB PARA ESTE EQUIPO \u2014 plantel de ${equipoName} desde PLANTELES, n\u00FAmeros a mano.`\r\n      : 'Eleg\u00ED el equipo correspondiente en MARCADOR para ver su plantel.';\r\n    root.appendChild(note);\r\n    if (!teamId) return;\r\n\r\n    const selectField = document.createElement('label');\r\n    selectField.className = 'field';\r\n    const selectLabel = document.createElement('span');\r\n    selectLabel.textContent = 'JUGADOR';\r\n    const select = document.createElement('select');\r\n    const emptyOpt = document.createElement('option');\r\n    emptyOpt.value = '';\r\n    emptyOpt.textContent = roster ? 'Seleccionar jugador del plantel' : 'Cargando plantel...';\r\n    select.appendChild(emptyOpt);\r\n    for (const jugador of roster?.jugadores || []) {\r\n      const option = document.createElement('option');\r\n      option.value = jugador.id;\r\n      const pantalla = jugador.metadata?.nombrePantalla;\r\n      option.textContent = pantalla ? `${jugador.nombreTV} \u2014 EN PANTALLA: ${pantalla.toUpperCase()}` : jugador.nombreTV;\r\n      select.appendChild(option);\r\n    }\r\n    const current = roster?.jugadores.find((j) => j.id === data.jugadorId);\r\n    select.value = current ? current.id : '';\r\n    select.disabled = !roster?.jugadores?.length;\r\n    select.addEventListener('change', () => {\r\n      const jugador = roster?.jugadores.find((j) => j.id === select.value);\r\n      if (!jugador) return;\r\n      applyRosterPlayer(data, jugador);\r\n      status = null;\r\n      onDirty();\r\n      render();\r\n    });\r\n    selectField.append(selectLabel, select);\r\n    root.appendChild(selectField);\r\n\r\n    if (current) {\r\n      renderNombrePantalla(teamId, current.id, current.metadata?.nombrePantalla, current.nombreTV, (guardado) => {\r\n        current.metadata = { ...(current.metadata || {}) };\r\n        if (guardado) current.metadata.nombrePantalla = guardado;\r\n        else delete current.metadata.nombrePantalla;\r\n      });\r\n    }\r\n\r\n    if (roster && !roster.jugadores?.length) {\r\n      const empty = document.createElement('p');\r\n      empty.className = 'performance-empty';\r\n      empty.textContent = `${equipoName} todav\u00EDa no tiene jugadores cargados -- cargalos desde PLANTELES.`;\r\n      root.appendChild(empty);\r\n    }\r\n    renderStatus();\r\n  }\r\n\r\n  function render() {\r\n    if (disposed) return;\r\n    root.innerHTML = '';\r\n    renderEquipoRow();\r\n    if (webMode) renderWebMode();\r\n    else renderManualMode();\r\n    if (data.jugadorKey || data.jugadorId || data.nombre) renderStatsEditor();\r\n    renderAdjust();\r\n  }\r\n\r\n  render();\r\n  loadForMode();\r\n  return () => { disposed = true; };\r\n}\r\n","http://localhost:4430/master-control/js/resultados-parciales-panel.js","// Reconstruido desde cero (2026-09-03, correcci\u00F3n expl\u00EDcita del usuario):\r\n// la implementacion anterior (2 partidos manuales con selector de\r\n// equipo propio, tarjeta fabricada en CSS) se descarto por completo --\r\n// mismo criterio ya aplicado a \"cronogramaHoy\" (ver cronograma-hoy-panel.js):\r\n// \"no reutilices a ciegas... adapt\u00E1 el renderer visual al PNG nuevo\".\r\n// Confirmado con el usuario (AskUserQuestion): un solo partido, escudos y\r\n// resultado heredados en vivo del Marcador -- sin selector de equipo\r\n// propio aca. Este panel solo resuelve lo que el acordeon generico de\r\n// main.js no puede: el t\u00EDtulo (borrador con ACTUALIZAR). Escudos LOCAL/\r\n// VISITANTE, resultado LOCAL/VISITANTE y \"COMPOSICI\u00D3N COMPLETA\" ya los\r\n// cubre renderModuleAdjustAccordion (via shared/adjust-registry.js,\r\n// entrada \"resultadosParciales\") -- un composition-control propio aca\r\n// pisaria (container.innerHTML='' interno) el resto del panel, mismo bug\r\n// ya encontrado y corregido en Z\u00F3calo Compuesto/Cronograma Hoy.\r\nfunction ensureDefaults(data) {\r\n  if (!data || typeof data !== 'object') return;\r\n  if (typeof data.titulo !== 'string') data.titulo = '';\r\n}\r\n\r\n// T\u00CDTULO con selector (2026-10-08, pedido explicito del usuario, SOLO\r\n// Argentina Streamers): ENTRETIEMPO / RESULTADO FINAL / MANUAL. Escribe el\r\n// MISMO \"data.titulo\" que ya lee el renderer (sin tocar equipos, escudos,\r\n// goles, asset, composicion ni animacion); \"tituloModo\"/\"tituloManual\"\r\n// persisten la eleccion y el texto manual aunque se cambie de modo.\r\nconst TITULO_MODOS = [\r\n  { id: 'entretiempo', label: 'ENTRETIEMPO', texto: 'ENTRETIEMPO' },\r\n  { id: 'final', label: 'RESULTADO FINAL', texto: 'RESULTADO FINAL' },\r\n  { id: 'manual', label: 'MANUAL', texto: null },\r\n];\r\n\r\nfunction ensureTituloModo(data) {\r\n  if (TITULO_MODOS.some((m) => m.id === data.tituloModo)) {\r\n    if (typeof data.tituloManual !== 'string') data.tituloManual = '';\r\n    return;\r\n  }\r\n  const current = (data.titulo || '').trim().toUpperCase();\r\n  const preset = TITULO_MODOS.find((m) => m.texto && m.texto === current);\r\n  data.tituloModo = preset ? preset.id : 'manual';\r\n  data.tituloManual = preset ? (data.tituloManual || '') : (data.titulo || '');\r\n}\r\n\r\nfunction renderTituloSelector(section, data, onDirty) {\r\n  ensureTituloModo(data);\r\n  section.innerHTML = `\r\n    <h3 class=\"panel-subtitle\">CONTENIDO DE RESULTADOS PARCIALES</h3>\r\n    <div style=\"font-size:11px; opacity:0.8; margin-bottom:10px;\">\r\n      Escudos y resultado se heredan autom\u00E1ticamente del Marcador: <strong>primer slot = LOCAL, segundo slot = VISITANTE</strong>. Su posici\u00F3n individual se ajusta en AJUSTE DE COMPOSICI\u00D3N, m\u00E1s abajo.\r\n    </div>\r\n    <div class=\"field-group\" style=\"margin-bottom: 10px;\">\r\n      <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">T\u00CDTULO</label>\r\n      <select class=\"mc-input sel-titulo-modo\">\r\n        ${TITULO_MODOS.map((m) => `<option value=\"${m.id}\">${m.label}</option>`).join('')}\r\n      </select>\r\n    </div>\r\n    <div class=\"field-group manual-wrap\">\r\n      <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">T\u00CDTULO MANUAL</label>\r\n      <input type=\"text\" class=\"mc-input inp-titulo-manual\" value=\"${escapeAttr(data.tituloManual)}\" placeholder=\"RESULTADOS PARCIALES\" />\r\n    </div>\r\n  `;\r\n  const select = section.querySelector('.sel-titulo-modo');\r\n  const manualWrap = section.querySelector('.manual-wrap');\r\n  const manualInput = section.querySelector('.inp-titulo-manual');\r\n  select.value = data.tituloModo;\r\n\r\n  function apply() {\r\n    const modo = TITULO_MODOS.find((m) => m.id === data.tituloModo);\r\n    data.titulo = modo.texto ?? data.tituloManual;\r\n    manualWrap.style.display = modo.id === 'manual' ? '' : 'none';\r\n  }\r\n  select.addEventListener('change', () => {\r\n    data.tituloModo = select.value;\r\n    apply();\r\n    onDirty();\r\n  });\r\n  manualInput.addEventListener('input', () => {\r\n    data.tituloManual = manualInput.value;\r\n    apply();\r\n    onDirty();\r\n  });\r\n  apply();\r\n}\r\n\r\nexport function renderResultadosParcialesPanel(container, data, onDirty, { tituloConSelector = false } = {}) {\r\n  if (!data) return () => {};\r\n  ensureDefaults(data);\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'resultados-parciales-editor';\r\n  container.appendChild(root);\r\n\r\n  if (tituloConSelector) {\r\n    const selectorSection = document.createElement('div');\r\n    selectorSection.className = 'panel-section';\r\n    renderTituloSelector(selectorSection, data, onDirty);\r\n    root.appendChild(selectorSection);\r\n    return () => {};\r\n  }\r\n\r\n  const section = document.createElement('div');\r\n  section.className = 'panel-section';\r\n  section.innerHTML = `\r\n    <h3 class=\"panel-subtitle\">CONTENIDO DE RESULTADOS PARCIALES</h3>\r\n    <div style=\"font-size:11px; opacity:0.8; margin-bottom:10px;\">\r\n      Escudos y resultado se heredan autom\u00E1ticamente del Marcador: <strong>primer slot = LOCAL, segundo slot = VISITANTE</strong>. Su posici\u00F3n individual se ajusta en AJUSTE DE COMPOSICI\u00D3N, m\u00E1s abajo.\r\n    </div>\r\n    <div class=\"field-group\">\r\n      <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">T\u00CDTULO</label>\r\n      <input type=\"text\" class=\"mc-input inp-titulo\" value=\"${escapeAttr(data.titulo)}\" placeholder=\"RESULTADOS PARCIALES\" />\r\n    </div>\r\n  `;\r\n\r\n  const inpTitulo = section.querySelector('.inp-titulo');\r\n  inpTitulo.addEventListener('input', () => {\r\n    data.titulo = inpTitulo.value;\r\n    onDirty();\r\n  });\r\n\r\n  root.appendChild(section);\r\n  return () => {};\r\n}\r\n\r\nfunction escapeAttr(str) {\r\n  return String(str || '')\r\n    .replace(/&/g, '&amp;')\r\n    .replace(/\"/g, '&quot;')\r\n    .replace(/</g, '&lt;')\r\n    .replace(/>/g, '&gt;');\r\n}\r\n","http://localhost:4430/master-control/js/historial-panel.js","import { TEAM_OPTIONS } from '../../shared/teams.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../shared/themes.js';\r\nimport { renderTextAdjustControl } from './text-adjust-control.js';\r\n\r\nconst ROW_COUNT = 5;\r\n\r\n// Valores internos estables (2026-09-02, pedido explicito del usuario):\r\n// se preparan aca para cuando se conecte la web mas adelante, pero HOY\r\n// no disparan ningun fetch/scraping/API -- ver \"btnWeb\" mas abajo.\r\nconst TIPO_HISTORIAL_OPTIONS = [\r\n  { id: 'iwc', label: 'IWC' },\r\n  { id: 'copa-america', label: 'COPA AMERICA' },\r\n  { id: 'amistosos-oficiales', label: 'AMISTOSOS OFICIALES' },\r\n  { id: 'amistosos', label: 'AMISTOSOS' },\r\n];\r\n\r\n// T\u00EDtulo autom\u00E1tico por categor\u00EDa (2026-09-04, pedido explicito del\r\n// usuario, seccion 14 del pedido de integracion web): \"HISTORIAL - <id>\",\r\n// mismos rotulos que TIPO_HISTORIAL_OPTIONS -- se aplica SOLO al apretar\r\n// \"ACTUALIZAR DATOS DE LA WEB\" (no en cada cambio del selector, para no\r\n// pisar un titulo custom que el operador este tipeando mientras solo\r\n// esta mirando categorias).\r\nfunction autoTituloFor(tipoHistorial) {\r\n  const opt = TIPO_HISTORIAL_OPTIONS.find((t) => t.id === tipoHistorial);\r\n  return opt ? `HISTORIAL - ${opt.label}` : 'HISTORIAL';\r\n}\r\n\r\n// \"AJUSTE DE COMPOSICI\u00D3N\" (COMPOSICI\u00D3N COMPLETA + ESCUDO LOCAL/VISITANTE +\r\n// GOL LOCAL/VISITANTE, todo por columna) NO se arma aca -- ver el mismo\r\n// criterio ya aplicado en zocalo-compuesto-equipos-panel.js/zocalo-\r\n// compuesto-logo-panel.js (2026-09-02): main.js ya renderiza el acordeon\r\n// generico (renderModuleAdjustAccordion, dentro de \"compositionContainer\")\r\n// a partir de shared/adjust-registry.js -- ese registro ya declara las 4\r\n// columnas de este modulo. Un \"renderCompositionControl(root, ...)\" propio\r\n// ACA duplicaria el control (y si se le pasara el mismo \"root\" donde se\r\n// agregan las filas, lo borraria por completo: esa funcion hace\r\n// \"container.innerHTML=''\" al entrar). Este panel dedicado se limita a lo\r\n// que el acordeon generico no puede resolver: el contenido en si (5\r\n// partidos fijos, equipo local/visitante + goles).\r\nfunction ensureDefaults(data) {\r\n  if (!data || typeof data !== 'object') return;\r\n  if (typeof data.titulo !== 'string') data.titulo = '';\r\n  if (!TIPO_HISTORIAL_OPTIONS.some((t) => t.id === data.tipoHistorial)) data.tipoHistorial = 'iwc';\r\n  if (!Array.isArray(data.partidos) || data.partidos.length !== ROW_COUNT) {\r\n    const existing = Array.isArray(data.partidos) ? data.partidos : [];\r\n    data.partidos = Array.from({ length: ROW_COUNT }, (_, i) => existing[i] || {\r\n      teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '',\r\n    });\r\n  }\r\n  // \"tituloByCategoria\" (2026-09-04, pedido explicito del usuario, items\r\n  // 5-6): un {dx,dy,dSize} INDEPENDIENTE por categoria -- se asegura la\r\n  // forma de las 4 aca (defensivo, por si el draft viene de antes de este\r\n  // cambio) para que renderTituloAdjust() siempre tenga un objeto real\r\n  // para mutar in-place.\r\n  if (!data.tituloByCategoria || typeof data.tituloByCategoria !== 'object') data.tituloByCategoria = {};\r\n  for (const { id } of TIPO_HISTORIAL_OPTIONS) {\r\n    if (!data.tituloByCategoria[id] || typeof data.tituloByCategoria[id] !== 'object') {\r\n      data.tituloByCategoria[id] = { dx: 0, dy: 0, dSize: 0 };\r\n    }\r\n  }\r\n  // \"resultadoNormal\"/\"resultadoConPenales\"/\"penalesFino\" (2026-09-04,\r\n  // pedido explicito del usuario): defensivo, por si el draft viene de\r\n  // antes de este cambio.\r\n  for (const key of ['resultadoNormal', 'resultadoConPenales', 'penalesFino']) {\r\n    if (!data[key] || typeof data[key] !== 'object') data[key] = { dx: 0, dy: 0, dSize: 0 };\r\n  }\r\n}\r\n\r\nexport function renderHistorialPanel(container, data, onDirty, saveOptions) {\r\n  if (!data) return () => {};\r\n  ensureDefaults(data);\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'historial-editor';\r\n  container.appendChild(root);\r\n\r\n  // RAMA (2026-10-08, solo Argentina Streamers): la seccion PARTIDOS de la\r\n  // web tiene su propio MASC/FEM -- Historial la respeta (nunca usa\r\n  // Convocados ni Estadisticas). Persistida en \"ramaWeb\".\r\n  const isArgentina = document.body.dataset.theme === ARGENTINA_STREAMERS_THEME_ID;\r\n  if (isArgentina) data.ramaWeb = data.ramaWeb === 'femenino' ? 'femenino' : 'masculino';\r\n\r\n  const topSection = document.createElement('div');\r\n  topSection.className = 'panel-section';\r\n  topSection.innerHTML = `\r\n    <h3 class=\"panel-subtitle\">HISTORIAL \u2014 T\u00CDTULO Y CATEGOR\u00CDA</h3>\r\n    <div style=\"margin-bottom:10px;\">\r\n      <label style=\"display:block; font-size:11px; margin-bottom:4px; opacity:0.8;\">T\u00CDTULO</label>\r\n      <input type=\"text\" class=\"mc-input inp-titulo\" value=\"${escapeAttr(data.titulo)}\" placeholder=\"HISTORIAL\" />\r\n    </div>\r\n    <div style=\"margin-bottom:10px;\">\r\n      <label style=\"display:block; font-size:11px; margin-bottom:4px; opacity:0.8;\">TIPO DE HISTORIAL</label>\r\n      <select class=\"mc-select sel-tipoHistorial\">${renderTipoHistorialOptions(data.tipoHistorial)}</select>\r\n    </div>\r\n    ${isArgentina ? `\r\n    <div style=\"margin-bottom:10px;\">\r\n      <label style=\"display:block; font-size:11px; margin-bottom:4px; opacity:0.8;\">RAMA (PARTIDOS DE LA WEB)</label>\r\n      <select class=\"mc-select sel-rama\">\r\n        <option value=\"masculino\" ${data.ramaWeb === 'masculino' ? 'selected' : ''}>MASCULINO</option>\r\n        <option value=\"femenino\" ${data.ramaWeb === 'femenino' ? 'selected' : ''}>FEMENINO</option>\r\n      </select>\r\n    </div>` : ''}\r\n    <div class=\"titulo-adjust-box\" style=\"margin-bottom:10px;\"></div>\r\n    <div style=\"margin-bottom:4px;\">\r\n      <button type=\"button\" class=\"performance-sync-btn btn-actualizar-web\">ACTUALIZAR DATOS DE LA WEB</button>\r\n      <div class=\"web-update-msg\" style=\"font-size:11px; opacity:0.7; margin-top:6px;\"></div>\r\n    </div>\r\n    <h3 class=\"panel-subtitle\" style=\"margin-top:16px;\">HISTORIAL \u2014 RESULTADOS</h3>\r\n    <div style=\"font-size:11px; opacity:0.7; margin-bottom:8px;\">\r\n      GOL LOCAL y GOL VISITANTE se mueven SIEMPRE juntos. \"RESULTADO NORMAL\" solo afecta partidos sin penales; \"RESULTADO CON PENALES\" solo afecta partidos definidos por penales (nunca se pisan entre s\u00ED). \"PENALES\" ajusta fino la segunda l\u00EDnea \"(N) (N)\" respecto del score reglamentario.\r\n    </div>\r\n    <div class=\"resultado-normal-box\" style=\"margin-bottom:10px;\"></div>\r\n    <div class=\"resultado-penales-box\" style=\"margin-bottom:10px;\"></div>\r\n    <div class=\"penales-fino-box\" style=\"margin-bottom:10px;\"></div>\r\n  `;\r\n\r\n  const inpTitulo = topSection.querySelector('.inp-titulo');\r\n  inpTitulo.addEventListener('input', () => {\r\n    data.titulo = inpTitulo.value;\r\n    onDirty();\r\n  });\r\n\r\n  // T\u00CDTULO \u2014 posici\u00F3n/escala INDEPENDIENTE por categor\u00EDa (2026-09-04,\r\n  // pedido explicito del usuario, items 5-6: \"HISTORIAL - IWC\" es mucho\r\n  // mas corto que \"HISTORIAL - AMISTOSOS OFICIALES\", no quiero una unica\r\n  // posicion global\"). Reusa el MISMO componente generico que el resto del\r\n  // proyecto (renderTextAdjustControl) pero apuntado a\r\n  // \"data.tituloByCategoria[tipoHistorial]\" en vez de \"data.textAdjust.X\"\r\n  // -- por eso NO vive en shared/adjust-registry.js/el acordeon generico\r\n  // (que solo sabe escribir textAdjust), se arma a mano aca. Se reconstruye\r\n  // completo cada vez que cambia la categoria (adjustBox.innerHTML=''),\r\n  // as\u00ED siempre muestra/edita el ajuste de la categoria ACTUALMENTE\r\n  // elegida -- RESET tambien queda automaticamente acotado a esa unica\r\n  // categoria (nunca toca las otras 3, que ni siquiera se tocan).\r\n  const adjustBox = topSection.querySelector('.titulo-adjust-box');\r\n  function renderTituloAdjust() {\r\n    adjustBox.innerHTML = '';\r\n    const cat = data.tipoHistorial;\r\n    const adjust = data.tituloByCategoria[cat];\r\n    const catLabel = TIPO_HISTORIAL_OPTIONS.find((t) => t.id === cat)?.label || cat;\r\n    renderTextAdjustControl(adjustBox, adjust, onDirty, {\r\n      label: `T\u00CDTULO \u2014 POSICI\u00D3N/ESCALA (${catLabel})`,\r\n      ...saveOptions,\r\n      elementSpec: { kind: 'text', dataPath: ['tituloByCategoria', cat] },\r\n      // Snapshot de la posicion YA confirmada para ESTA categoria (2026-09-04):\r\n      // este control se reconstruye entero cada vez que cambia la categoria\r\n      // (arriba), asi que sin esto \"baseline\" olvidaria cualquier GUARDAR\r\n      // POSICI\u00D3N de una vuelta anterior y RESET volveria a 0/0/0 en vez de a\r\n      // la ultima base real -- ver el comentario en text-adjust-control.js.\r\n      initialBaseline: { ...adjust },\r\n    });\r\n  }\r\n  renderTituloAdjust();\r\n\r\n  // RESULTADO NORMAL / CON PENALES / PENALES (2026-09-04, pedido explicito\r\n  // del usuario: \"eliminar la edicion independiente GOL LOCAL/GOL\r\n  // VISITANTE... los dos goles deben moverse juntos\", con geometria\r\n  // COMPLETAMENTE separada segun si la fila tiene penales o no). Mismo\r\n  // componente generico (renderTextAdjustControl) apuntado a 3 campos de\r\n  // NIVEL SUPERIOR de \"data\" (no textAdjust.X, no por columna individual):\r\n  // la aplicacion CONDICIONAL real (que fila usa cual bloque) vive en\r\n  // program/js/renderers/historial.js. Se montan UNA sola vez (no dependen\r\n  // de la categoria activa, a diferencia del titulo) asi que no necesitan\r\n  // el patron de reconstruccion+\"initialBaseline\" de arriba.\r\n  renderTextAdjustControl(topSection.querySelector('.resultado-normal-box'), data.resultadoNormal, onDirty, {\r\n    label: 'RESULTADO NORMAL (gol local + gol visitante, SIN penales)',\r\n    ...saveOptions,\r\n    elementSpec: { kind: 'text', dataPath: ['resultadoNormal'] },\r\n  });\r\n  renderTextAdjustControl(topSection.querySelector('.resultado-penales-box'), data.resultadoConPenales, onDirty, {\r\n    label: 'RESULTADO CON PENALES (gol local + gol visitante + penales, junto)',\r\n    ...saveOptions,\r\n    elementSpec: { kind: 'text', dataPath: ['resultadoConPenales'] },\r\n  });\r\n  renderTextAdjustControl(topSection.querySelector('.penales-fino-box'), data.penalesFino, onDirty, {\r\n    label: 'PENALES / SEGUNDA L\u00CDNEA (ajuste fino, respecto del score reglamentario)',\r\n    ...saveOptions,\r\n    elementSpec: { kind: 'text', dataPath: ['penalesFino'] },\r\n  });\r\n\r\n  const selTipo = topSection.querySelector('.sel-tipoHistorial');\r\n  selTipo.addEventListener('change', () => {\r\n    data.tipoHistorial = selTipo.value;\r\n    renderTituloAdjust();\r\n    onDirty();\r\n  });\r\n  const selRama = topSection.querySelector('.sel-rama');\r\n  if (selRama) {\r\n    selRama.addEventListener('change', () => {\r\n      data.ramaWeb = selRama.value;\r\n      onDirty();\r\n    });\r\n  }\r\n\r\n  const btnWeb = topSection.querySelector('.btn-actualizar-web');\r\n  const webMsg = topSection.querySelector('.web-update-msg');\r\n  // Integracion real (2026-09-04, pedido explicito del usuario -- ver\r\n  // server/argentinaStreamersSync.js): fetch/parseo corre SOLO en el\r\n  // servidor (server/index.js, ruta /api/argentina-streamers/historial/\r\n  // sync-web), nunca desde este panel ni desde Program (seccion 24 del\r\n  // pedido: \"Program NO consulta argentinastreamers.com\"). Este boton\r\n  // solo actualiza el draft (data.partidos/titulo) -- nunca manda al aire\r\n  // por si solo, el operador decide TAKE/UPDATE despues.\r\n  // GLA sigue con el placeholder original tal cual (este modulo existe\r\n  // para los dos themes, pero la integracion web es exclusiva de\r\n  // Argentina Streamers -- \"document.body.dataset.theme\" ya lo fija\r\n  // main.js globalmente, sin tener que cambiar la firma de\r\n  // renderHistorialPanel para pasarlo aparte).\r\n  let webSyncTimer = null;\r\n  btnWeb.addEventListener('click', async () => {\r\n    if (document.body.dataset.theme !== 'argentinaStreamers') {\r\n      webMsg.className = 'web-update-msg';\r\n      webMsg.textContent = 'INTEGRACI\u00D3N WEB PENDIENTE';\r\n      return;\r\n    }\r\n    clearTimeout(webSyncTimer);\r\n    webMsg.className = 'web-update-msg loading';\r\n    webMsg.textContent = 'ACTUALIZANDO...';\r\n    btnWeb.disabled = true;\r\n    try {\r\n      const categoria = encodeURIComponent(data.tipoHistorial);\r\n      const rama = encodeURIComponent(data.ramaWeb || 'masculino');\r\n      const res = await fetch(`/api/argentina-streamers/historial/sync-web?categoria=${categoria}&rama=${rama}`, { method: 'POST' });\r\n      const body = await res.json().catch(() => null);\r\n      // Sin partidos jugados de esa categoria/rama: el historial actual se\r\n      // conserva tal cual (el servidor tampoco lo toca) -- aviso, no error.\r\n      if (body && body.ok === false && body.status === 'vacio') {\r\n        webMsg.className = 'web-update-msg error';\r\n        webMsg.textContent = body.mensaje;\r\n        btnWeb.disabled = false;\r\n        webSyncTimer = setTimeout(() => { webMsg.textContent = ''; webMsg.className = 'web-update-msg'; }, 12000);\r\n        return;\r\n      }\r\n      if (!res.ok || !body?.ok) throw new Error(body?.error || `HTTP ${res.status}`);\r\n      data.partidos = body.partidos;\r\n      data.titulo = autoTituloFor(data.tipoHistorial);\r\n      inpTitulo.value = data.titulo;\r\n      for (let i = 0; i < ROW_COUNT; i++) {\r\n        const partido = data.partidos[i] || { teamA: '', golLocal: '', golVisitante: '', teamB: '' };\r\n        const row = rowInputs[i];\r\n        row.selA.value = partido.teamA;\r\n        row.selB.value = partido.teamB;\r\n        row.inpGolLocal.value = partido.golLocal;\r\n        row.inpGolVisitante.value = partido.golVisitante;\r\n      }\r\n      onDirty();\r\n      webMsg.className = 'web-update-msg success';\r\n      webMsg.textContent = body.unmatchedTeams?.length\r\n        ? `DATOS ACTUALIZADOS \u2713 \u2014 sin equipo local para: ${body.unmatchedTeams.join(', ')}`\r\n        : 'DATOS ACTUALIZADOS \u2713';\r\n    } catch (err) {\r\n      webMsg.className = 'web-update-msg error';\r\n      webMsg.textContent = `ERROR AL ACTUALIZAR \u2014 ${err.message}`;\r\n    }\r\n    btnWeb.disabled = false;\r\n    webSyncTimer = setTimeout(() => { webMsg.textContent = ''; webMsg.className = 'web-update-msg'; }, 8000);\r\n  });\r\n\r\n  root.appendChild(topSection);\r\n\r\n  const section = document.createElement('div');\r\n  section.className = 'panel-section';\r\n  section.innerHTML = `\r\n    <h3 class=\"panel-subtitle\">HISTORIAL \u2014 PARTIDOS (${ROW_COUNT})</h3>\r\n    <div style=\"font-size:11px; opacity:0.8; margin-bottom:10px;\">\r\n      Carg\u00E1 hasta ${ROW_COUNT} resultados manualmente. Los escudos se toman autom\u00E1ticamente del equipo elegido. M\u00E1s adelante esto se completar\u00E1 con datos reales de la web -- por ahora es 100% manual.\r\n    </div>\r\n  `;\r\n\r\n  const rowInputs = [];\r\n  for (let i = 0; i < ROW_COUNT; i++) {\r\n    const partido = data.partidos[i];\r\n    const box = document.createElement('div');\r\n    box.className = 'match-box-card';\r\n    box.style.marginBottom = '12px';\r\n    box.style.padding = '10px';\r\n    box.style.background = 'rgba(255,255,255,0.04)';\r\n    box.style.borderRadius = '6px';\r\n    box.style.border = '1px solid rgba(255,255,255,0.08)';\r\n\r\n    box.innerHTML = `\r\n      <div style=\"font-weight: bold; margin-bottom: 8px; font-size: 13px; color: var(--gold-bright, #ffc107);\">PARTIDO ${i + 1}</div>\r\n      <div style=\"display: grid; grid-template-columns: 2fr 1fr 1fr 2fr; gap: 8px; align-items: end;\">\r\n        <div>\r\n          <label style=\"display:block; font-size:11px; margin-bottom:4px; opacity:0.8;\">LOCAL</label>\r\n          <select class=\"mc-select sel-teamA\">${renderTeamOptions(partido.teamA)}</select>\r\n        </div>\r\n        <div>\r\n          <label style=\"display:block; font-size:11px; margin-bottom:4px; opacity:0.8;\">GOL LOCAL</label>\r\n          <input type=\"text\" class=\"mc-input inp-golLocal\" value=\"${escapeAttr(partido.golLocal)}\" placeholder=\"0\" />\r\n        </div>\r\n        <div>\r\n          <label style=\"display:block; font-size:11px; margin-bottom:4px; opacity:0.8;\">GOL VISITANTE</label>\r\n          <input type=\"text\" class=\"mc-input inp-golVisitante\" value=\"${escapeAttr(partido.golVisitante)}\" placeholder=\"0\" />\r\n        </div>\r\n        <div>\r\n          <label style=\"display:block; font-size:11px; margin-bottom:4px; opacity:0.8;\">VISITANTE</label>\r\n          <select class=\"mc-select sel-teamB\">${renderTeamOptions(partido.teamB)}</select>\r\n        </div>\r\n      </div>\r\n    `;\r\n\r\n    const selA = box.querySelector('.sel-teamA');\r\n    const selB = box.querySelector('.sel-teamB');\r\n    const inpGolLocal = box.querySelector('.inp-golLocal');\r\n    const inpGolVisitante = box.querySelector('.inp-golVisitante');\r\n\r\n    selA.addEventListener('change', () => {\r\n      data.partidos[i].teamA = selA.value;\r\n      onDirty();\r\n    });\r\n    selB.addEventListener('change', () => {\r\n      data.partidos[i].teamB = selB.value;\r\n      // Elegir un equipo del catalogo a mano reemplaza cualquier escudo de\r\n      // rival historico que haya traido la sincro web (2026-09-04) -- sin\r\n      // esto quedaria un \"teamBCrestUrl\" viejo colgado (inofensivo para el\r\n      // renderer, que ya prioriza \"teamB\" real, pero prolijo limpiarlo).\r\n      data.partidos[i].teamBCrestUrl = '';\r\n      onDirty();\r\n    });\r\n    inpGolLocal.addEventListener('input', () => {\r\n      data.partidos[i].golLocal = inpGolLocal.value;\r\n      onDirty();\r\n    });\r\n    inpGolVisitante.addEventListener('input', () => {\r\n      data.partidos[i].golVisitante = inpGolVisitante.value;\r\n      onDirty();\r\n    });\r\n\r\n    rowInputs.push({ selA, selB, inpGolLocal, inpGolVisitante });\r\n    section.appendChild(box);\r\n  }\r\n\r\n  root.appendChild(section);\r\n  return () => {};\r\n}\r\n\r\nfunction renderTipoHistorialOptions(selectedId) {\r\n  return TIPO_HISTORIAL_OPTIONS.map(\r\n    (t) => `<option value=\"${t.id}\" ${t.id === selectedId ? 'selected' : ''}>${escapeAttr(t.label)}</option>`\r\n  ).join('');\r\n}\r\n\r\nfunction renderTeamOptions(selectedId) {\r\n  // Argentina Streamers (2026-10-08): respeta VISIBLE del catalogo central\r\n  // (el equipo ya elegido se sigue mostrando). GLA sin cambios.\r\n  const isArgentina = document.body.dataset.theme === ARGENTINA_STREAMERS_THEME_ID;\r\n  const opts = isArgentina\r\n    ? [{ id: '', label: 'SIN EQUIPO' }, ...TEAM_OPTIONS.filter((t) => t.id && (t.visible !== false || t.id === selectedId))]\r\n    : [{ id: '', label: 'SIN EQUIPO' }, ...TEAM_OPTIONS];\r\n  return opts.map(\r\n    (t) => `<option value=\"${t.id}\" ${t.id === selectedId ? 'selected' : ''}>${escapeAttr(t.label)}</option>`\r\n  ).join('');\r\n}\r\n\r\nfunction escapeAttr(str) {\r\n  return String(str || '')\r\n    .replace(/&/g, '&amp;')\r\n    .replace(/\"/g, '&quot;')\r\n    .replace(/</g, '&lt;')\r\n    .replace(/>/g, '&gt;');\r\n}\r\n","http://localhost:4430/master-control/js/zocalo-compuesto-panel.js","import { renderPresetsControl } from './presets-helper.js';\r\nimport { renderZocaloSponsorsPanel } from './zocalo-sponsors-panel.js';\r\n\r\n// Panel unificado de Z\u00F3calo Compuesto (2026-09-10, pedido explicito del\r\n// usuario: \"es todo lo mismo, solo cambia el asset... un solo m\u00F3dulo, con\r\n// la opci\u00F3n de men\u00FA desplegable CON LOGO LOCALSTRIKE | CON EQUIPOS\").\r\n// Reemplaza a \"zocalo-compuesto-equipos-panel.js\"/\r\n// \"zocalo-compuesto-logo-panel.js\" (ambos casi id\u00E9nticos, ver historial) --\r\n// \"tipo\" decide que nota/seccion mostrar (EQUIPOS trae la nota de escudos\r\n// heredados del Marcador; LOGO no) pero el resto del formulario\r\n// (texto1/texto2/subColor/presets/sponsors) es UNA sola copia compartida.\r\n//\r\n// \"AJUSTE DE COMPOSICI\u00D3N\" (COMPOSICI\u00D3N COMPLETA + Texto 1 + Texto 2 +\r\n// ESCUDO LOCAL/VISITANTE + LOGO + SPONSOR) NO se arma aca (2026-09-02,\r\n// causa real de que el editor apareciera vacio, ver informe): main.js YA\r\n// renderiza un acordeon generico para CUALQUIER modulo\r\n// (renderModuleAdjustAccordion, dentro de \"compositionContainer\") a partir\r\n// de shared/adjust-registry.js -- esa entrada ya declara escudo por equipo\r\n// (con \"crestTeam\"), logo y sponsor. Este panel dedicado se limita a lo\r\n// que el acordeon generico NO puede resolver: el contenido en si (TIPO/\r\n// TEXTO MAIN/SUBTEXTO/SPONSOR como borrador, con ACTUALIZAR) y sus\r\n// PRESETS.\r\nfunction ensureDefaults(data) {\r\n  if (!data || typeof data !== 'object') return;\r\n  if (data.tipo !== 'logo' && data.tipo !== 'equipos') data.tipo = 'equipos';\r\n  if (typeof data.texto1 !== 'string') data.texto1 = '';\r\n  if (typeof data.texto2 !== 'string') data.texto2 = '';\r\n  if (data.subColor !== 'negro' && data.subColor !== 'blanco') data.subColor = 'negro';\r\n  if (!Array.isArray(data.sponsorsRotation)) data.sponsorsRotation = [];\r\n  if (!Array.isArray(data.textPresets)) data.textPresets = [];\r\n}\r\n\r\n// \"globalBank\" (2026-10-08, pedido explicito del usuario): banco global de\r\n// zocalos de Argentina Streamers ({ holder, onDirty } -- ver main.js,\r\n// \"themeLowerThirdBank\"), compartido con Largo Doble/Corto Simple. MAIN/\r\n// SUB del banco <-> texto1/texto2 de este modulo. \"holder\" null = banco\r\n// todavia cargando (no se ofrece guardar para no pisar la lista real).\r\nexport function renderZocaloCompuestoPanel(container, data, scoreboardData, onDirty, saveOptions, globalBank) {\r\n  if (!data) return () => {};\r\n  ensureDefaults(data);\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'zocalo-compuesto-editor';\r\n  container.appendChild(root);\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n    try {\r\n      // TIPO: decide el asset (escudos con l\u00EDnea separadora, o logo\r\n      // LocalStrike sin l\u00EDnea) -- ver program/js/renderers/\r\n      // zocaloCompuestoEquipos.js para la transici\u00F3n segura al cambiar.\r\n      const tipoSection = document.createElement('div');\r\n      tipoSection.className = 'panel-section';\r\n      tipoSection.innerHTML = `\r\n        <h3 class=\"panel-subtitle\">TIPO DE Z\u00D3CALO COMPUESTO</h3>\r\n        <div class=\"field-group\" style=\"margin-bottom: 12px;\">\r\n          <select class=\"mc-input sel-tipo\">\r\n            <option value=\"equipos\">CON EQUIPOS</option>\r\n            <option value=\"logo\">CON LOGO LOCALSTRIKE</option>\r\n          </select>\r\n        </div>\r\n      `;\r\n      const selTipo = tipoSection.querySelector('.sel-tipo');\r\n      selTipo.value = data.tipo;\r\n      selTipo.addEventListener('change', () => {\r\n        data.tipo = selTipo.value;\r\n        onDirty();\r\n        render();\r\n      });\r\n      root.appendChild(tipoSection);\r\n\r\n      // CONTENIDO (TEXTO MAIN, SUBTEXTO, SPONSOR) -- borrador: ACTUALIZAR\r\n      // (isVisualKey en program/js/main.js) recien lo manda a Program.\r\n      const textSection = document.createElement('div');\r\n      textSection.className = 'panel-section';\r\n      const localTeamId = scoreboardData?.teamA || '';\r\n      const awayTeamId = scoreboardData?.teamB || '';\r\n      const equiposNote = data.tipo === 'equipos'\r\n        ? `<div style=\"font-size:11px; opacity:0.8; margin-bottom:10px;\">\r\n            Los escudos se heredan autom\u00E1ticamente del Marcador: <strong>LOCAL (${escapeAttr(localTeamId) || 'sin equipo'})</strong> y <strong>VISITANTE (${escapeAttr(awayTeamId) || 'sin equipo'})</strong>. Su posici\u00F3n individual se ajusta m\u00E1s abajo, en AJUSTE DE COMPOSICI\u00D3N.\r\n          </div>`\r\n        : '';\r\n      textSection.innerHTML = `\r\n        <h3 class=\"panel-subtitle\">CONTENIDO DE Z\u00D3CALO COMPUESTO</h3>\r\n        ${equiposNote}\r\n        <div class=\"field-group\" style=\"margin-bottom: 12px;\">\r\n          <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">TEXTO MAIN (TIRA AZUL - BLANCO #FFFFFF)</label>\r\n          <input type=\"text\" class=\"mc-input inp-texto1\" value=\"${escapeAttr(data.texto1)}\" placeholder=\"Escribir texto main en tira azul...\" />\r\n        </div>\r\n        <div class=\"field-group\" style=\"margin-bottom: 12px;\">\r\n          <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">SUBTEXTO (TIRA VERDE)</label>\r\n          <input type=\"text\" class=\"mc-input inp-texto2\" value=\"${escapeAttr(data.texto2)}\" placeholder=\"Escribir subtexto en tira verde...\" />\r\n        </div>\r\n        <div class=\"field-group\">\r\n          <label style=\"display:block; font-size:12px; margin-bottom:4px; font-weight:bold;\">COLOR SUBTEXTO</label>\r\n          <div class=\"sub-color-toggle\" style=\"display:flex; gap:8px;\">\r\n            <button type=\"button\" class=\"mc-button sub-color-btn\" data-color=\"negro\">NEGRO</button>\r\n            <button type=\"button\" class=\"mc-button sub-color-btn\" data-color=\"blanco\">BLANCO</button>\r\n          </div>\r\n        </div>\r\n      `;\r\n\r\n      const inp1 = textSection.querySelector('.inp-texto1');\r\n      const inp2 = textSection.querySelector('.inp-texto2');\r\n      const colorBtns = Array.from(textSection.querySelectorAll('.sub-color-btn'));\r\n\r\n      inp1.addEventListener('input', () => {\r\n        data.texto1 = inp1.value;\r\n        onDirty();\r\n      });\r\n\r\n      inp2.addEventListener('input', () => {\r\n        data.texto2 = inp2.value;\r\n        onDirty();\r\n      });\r\n\r\n      function refreshColorBtns() {\r\n        for (const btn of colorBtns) {\r\n          const isActive = btn.dataset.color === data.subColor;\r\n          btn.style.background = isActive ? '#2e7d32' : '';\r\n          btn.style.color = isActive ? '#fff' : '';\r\n          btn.style.fontWeight = isActive ? 'bold' : '';\r\n        }\r\n      }\r\n      for (const btn of colorBtns) {\r\n        btn.addEventListener('click', () => {\r\n          data.subColor = btn.dataset.color;\r\n          refreshColorBtns();\r\n          onDirty();\r\n        });\r\n      }\r\n      refreshColorBtns();\r\n\r\n      root.appendChild(textSection);\r\n\r\n      // PRESETS DE TEXTO\r\n      if (globalBank && !globalBank.holder) {\r\n        const loading = document.createElement('p');\r\n        loading.className = 'performance-note';\r\n        loading.textContent = 'Cargando presets globales de z\u00F3calos...';\r\n        root.appendChild(loading);\r\n      } else if (globalBank) {\r\n        renderPresetsControl(root, globalBank.holder, {\r\n          presetKey: 'textPresets',\r\n          title: 'PRESETS GLOBALES DE Z\u00D3CALOS (LARGO DOBLE / CORTO SIMPLE / COMPUESTO)',\r\n          buttons: [\r\n            { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ main: data.texto1, sub: data.texto2 }) },\r\n            { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ main: data.texto1 }) },\r\n            { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ sub: data.texto2 }) },\r\n          ],\r\n          onApply: (fields) => {\r\n            if (fields.main !== undefined) data.texto1 = fields.main;\r\n            if (fields.sub !== undefined) data.texto2 = fields.sub;\r\n            if (inp1) inp1.value = data.texto1;\r\n            if (inp2) inp2.value = data.texto2;\r\n            onDirty();\r\n          },\r\n          onDirty: globalBank.onDirty,\r\n        });\r\n      } else {\r\n        renderPresetsControl(root, data, {\r\n          presetKey: 'textPresets',\r\n          title: 'PRESETS DE TEXTO (Z\u00D3CALO COMPUESTO)',\r\n          buttons: [\r\n            { label: 'GUARDAR PRESET COMPLETO', type: 'complete', getFields: () => ({ texto1: data.texto1, texto2: data.texto2 }) },\r\n            { label: 'GUARDAR TEXTO MAIN', type: 'main', getFields: () => ({ texto1: data.texto1 }) },\r\n            { label: 'GUARDAR SUB TEXTO', type: 'sub', getFields: () => ({ texto2: data.texto2 }) },\r\n          ],\r\n          onApply: (fields) => {\r\n            if (fields.texto1 !== undefined) data.texto1 = fields.texto1;\r\n            if (fields.texto2 !== undefined) data.texto2 = fields.texto2;\r\n            if (inp1) inp1.value = data.texto1;\r\n            if (inp2) inp2.value = data.texto2;\r\n            onDirty();\r\n          },\r\n          onDirty,\r\n        });\r\n      }\r\n\r\n      // SPONSORS EN ROTACI\u00D3N (2026-09-02, pedido explicito del usuario: nada\r\n      // de dropdown unico -- reutiliza el mismo panel de checkboxes + la\r\n      // misma logica de rotacion de 10s que ya usan zocaloCompuesto/\r\n      // zocaloFinal/zocaloFinalDiv, ver program/js/renderers/zocaloCompuesto.js).\r\n      renderZocaloSponsorsPanel(root, data, onDirty);\r\n    } catch (err) {\r\n      console.error('[GLA] Error al renderizar panel Z\u00F3calo Compuesto:', err);\r\n    }\r\n  }\r\n\r\n  render();\r\n  return () => {};\r\n}\r\n\r\nfunction escapeAttr(str) {\r\n  return String(str || '')\r\n    .replace(/&/g, '&amp;')\r\n    .replace(/\"/g, '&quot;')\r\n    .replace(/</g, '&lt;')\r\n    .replace(/>/g, '&gt;');\r\n}\r\n","http://localhost:4430/master-control/js/zocalo-sponsors-panel.js","import { SPONSOR_OPTIONS } from '../../shared/sponsors.js';\r\n\r\nexport function renderZocaloSponsorsPanel(container, data, onDirty) {\r\n  if (!data.sponsorsRotation) {\r\n    data.sponsorsRotation = [];\r\n  }\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'zocalo-sponsors-editor';\r\n  container.appendChild(root);\r\n\r\n  // We can add some CSS classes dynamically if not present, but let's just use CSS or standard classes.\r\n  const styleId = 'zocalo-sponsors-panel-styles';\r\n  if (!document.getElementById(styleId)) {\r\n    const style = document.createElement('style');\r\n    style.id = styleId;\r\n    style.textContent = `\r\n      .zocalo-sponsors-editor {\r\n        background: #1e1e1e;\r\n        padding: 15px;\r\n        border: 1px solid #333;\r\n        border-radius: 6px;\r\n        margin-top: 15px;\r\n      }\r\n      .zocalo-sponsors-editor h2 {\r\n        font-family: 'Montserrat', sans-serif;\r\n        font-size: 14px;\r\n        font-weight: 700;\r\n        color: #e5a93b;\r\n        margin: 0 0 12px 0;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n      }\r\n      .zocalo-sponsors-grid {\r\n        display: grid;\r\n        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));\r\n        gap: 10px;\r\n        margin-bottom: 12px;\r\n      }\r\n      .zocalo-sponsor-item {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 8px;\r\n        background: #2a2a2a;\r\n        padding: 8px 10px;\r\n        border-radius: 4px;\r\n        cursor: pointer;\r\n        user-select: none;\r\n        border: 1px solid #444;\r\n        transition: background 0.2s, border-color 0.2s;\r\n      }\r\n      .zocalo-sponsor-item:hover {\r\n        background: #333;\r\n        border-color: #555;\r\n      }\r\n      .zocalo-sponsor-item.active {\r\n        background: rgba(229, 169, 59, 0.15);\r\n        border-color: #e5a93b;\r\n      }\r\n      .zocalo-sponsor-item input {\r\n        cursor: pointer;\r\n      }\r\n      .zocalo-sponsor-item span {\r\n        font-size: 12px;\r\n        font-weight: 600;\r\n        color: #ddd;\r\n      }\r\n      .zocalo-sponsors-note {\r\n        font-size: 11px;\r\n        color: #888;\r\n        margin: 5px 0 0 0;\r\n        line-height: 1.4;\r\n      }\r\n    `;\r\n    document.head.appendChild(style);\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n\r\n    const title = document.createElement('h2');\r\n    title.textContent = 'Sponsors para Rotaci\u00F3n';\r\n    root.appendChild(title);\r\n\r\n    const grid = document.createElement('div');\r\n    grid.className = 'zocalo-sponsors-grid';\r\n\r\n    const options = SPONSOR_OPTIONS.zocalo || [];\r\n    for (const opt of options) {\r\n      const isActive = data.sponsorsRotation.includes(opt.id);\r\n\r\n      const label = document.createElement('label');\r\n      label.className = `zocalo-sponsor-item ${isActive ? 'active' : ''}`;\r\n\r\n      const checkbox = document.createElement('input');\r\n      checkbox.type = 'checkbox';\r\n      checkbox.checked = isActive;\r\n      checkbox.addEventListener('change', () => {\r\n        if (checkbox.checked) {\r\n          if (!data.sponsorsRotation.includes(opt.id)) {\r\n            data.sponsorsRotation.push(opt.id);\r\n          }\r\n        } else {\r\n          data.sponsorsRotation = data.sponsorsRotation.filter((id) => id !== opt.id);\r\n        }\r\n        onDirty();\r\n        render();\r\n      });\r\n\r\n      const span = document.createElement('span');\r\n      span.textContent = opt.label;\r\n\r\n      label.appendChild(checkbox);\r\n      label.appendChild(span);\r\n      grid.appendChild(label);\r\n    }\r\n\r\n    root.appendChild(grid);\r\n\r\n    const note = document.createElement('p');\r\n    note.className = 'zocalo-sponsors-note';\r\n    if (data.sponsorsRotation.length === 0) {\r\n      note.textContent = '\u26A0\uFE0F Ning\u00FAn sponsor seleccionado. El recuadro del sponsor se mantendr\u00E1 vac\u00EDo.';\r\n    } else if (data.sponsorsRotation.length === 1) {\r\n      note.textContent = `\u2139\uFE0F 1 sponsor seleccionado: ${data.sponsorsRotation[0]} (se mantendr\u00E1 fijo sin rotar).`;\r\n    } else {\r\n      note.textContent = `\uF504 Rotaci\u00F3n activa con ${data.sponsorsRotation.length} sponsors (BETANO, CARONE, etc.), cambiando cada 10 segundos en loop.`;\r\n    }\r\n    root.appendChild(note);\r\n  }\r\n\r\n  render();\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/composition-control.js","// Control UNIVERSAL de \"AJUSTE DE COMPOSICI\u00D3N\" (2026-08-14, pedido\r\n// explicito del usuario): posicion X/Y + escala de TODO un modulo como\r\n// una unica unidad rigida. Mismo concepto y mismo patron de boton que\r\n// text-adjust-control.js (edicion por texto, turno anterior), pero\r\n// operando sobre \"compositionOffsetX/Y/Scale\" en vez de \"dx/dy/dSize\" de\r\n// un campo puntual.\r\n//\r\n// Montado UNA sola vez por modulo desde master-control/js/main.js\r\n// (ver \"#composition-container\" en index.html), sin que ningun renderer\r\n// ni panel dedicado tenga que saber nada de esto -- es la pieza que hace\r\n// que un modulo NUEVO futuro (agregado solo en shared/modules.js)\r\n// herede este control automaticamente sin escribir una linea mas aca.\r\nimport { renderSavePositionControl } from './save-position-control.js';\r\n\r\nconst STEP_PX = 2;\r\n// Intensidad \"0.5\" (BLOQUE 1, 2026-09-09, pedido explicito del usuario):\r\n// exactamente la mitad del paso normal (\"1.0\" = STEP_PX), respetando la\r\n// unidad existente. Solo aplica a Offset X/Y (el pedido es \"por\r\n// direccion\") -- Escala sigue con un unico paso (STEP_SCALE), sin tocar.\r\nconst HALF_STEP_PX = STEP_PX / 2;\r\nconst STEP_SCALE = 0.01;\r\nconst REPEAT_DELAY_MS = 400;\r\nconst REPEAT_INTERVAL_MS = 80;\r\nconst MIN_SCALE = 0.1;\r\n\r\nfunction ensureShape(data, xKey, yKey, scaleKey, defaultX, defaultY, defaultScale) {\r\n  if (typeof data[xKey] !== 'number') data[xKey] = defaultX;\r\n  if (typeof data[yKey] !== 'number') data[yKey] = defaultY;\r\n  if (typeof data[scaleKey] !== 'number') data[scaleKey] = defaultScale;\r\n}\r\n\r\nfunction repeatButton(label, title, onFire) {\r\n  const btn = document.createElement('button');\r\n  btn.type = 'button';\r\n  btn.className = 'text-adjust-btn';\r\n  btn.textContent = label;\r\n  btn.title = title;\r\n  btn.setAttribute('aria-label', title);\r\n\r\n  let delayTimer = null;\r\n  let repeatTimer = null;\r\n  function stop() {\r\n    clearTimeout(delayTimer);\r\n    clearInterval(repeatTimer);\r\n    delayTimer = null;\r\n    repeatTimer = null;\r\n  }\r\n  btn.addEventListener('mousedown', (e) => {\r\n    e.preventDefault();\r\n    stop();\r\n    onFire();\r\n    delayTimer = setTimeout(() => {\r\n      repeatTimer = setInterval(onFire, REPEAT_INTERVAL_MS);\r\n    }, REPEAT_DELAY_MS);\r\n  });\r\n  btn.addEventListener('mouseup', stop);\r\n  btn.addEventListener('mouseleave', stop);\r\n  return btn;\r\n}\r\n\r\nexport function renderCompositionControl(container, data, onDirty, options = {}) {\r\n  const {\r\n    title = 'AJUSTE DE COMPOSICI\u00D3N',\r\n    note = 'Mueve y escala todo el elemento como una sola unidad.',\r\n    keys = {},\r\n    defaultX = 0,\r\n    defaultY = 0,\r\n    defaultScale = 1,\r\n    onSave,\r\n    isPendingSave,\r\n    isConnected,\r\n    // \"elementSpec\" (2026-09-01, layout base versionado -- pedido explicito\r\n    // del usuario): identifica ESTE elemento puntual para que GUARDAR\r\n    // POSICI\u00D3N sepa donde consolidar el valor absoluto actual dentro de\r\n    // shared/theme-layouts/<themeId>.json (ver server/theme-layouts.js).\r\n    // Quien llama a este componente ya conoce \"dataPath\"/\"xKey\"/\"yKey\"/\r\n    // \"scaleKey\" (son los mismos \"keys\" de arriba) -- sin \"elementSpec\" no\r\n    // hay boton de GUARDAR POSICI\u00D3N (mismo comportamiento que hoy si no se\r\n    // pasa \"onSave\").\r\n    elementSpec,\r\n  } = options;\r\n\r\n  const xKey = keys.xKey || 'compositionOffsetX';\r\n  const yKey = keys.yKey || 'compositionOffsetY';\r\n  const scaleKey = keys.scaleKey || 'compositionScale';\r\n\r\n  ensureShape(data, xKey, yKey, scaleKey, defaultX, defaultY, defaultScale);\r\n  container.innerHTML = '';\r\n\r\n  // \"baseline\" (2026-09-01, layout base versionado; corregido 2026-09-10,\r\n  // auditoria de GUARDAR POSICI\u00D3N pedida por el usuario): referencia LOCAL\r\n  // de \"posici\u00F3n ya confirmada\". ANTES arrancaba siempre en el default de\r\n  // dise\u00F1o (defaultX/Y/Scale, normalmente 0/0/1) sin importar si el modulo\r\n  // ya tenia una base distinta guardada -- asi que cada vez que este\r\n  // control se volvia a montar (cambiar de tab y volver, refresh, restart)\r\n  // el readout mostraba como \"pendiente\" una posicion que en realidad YA\r\n  // estaba consolidada, y RESET la revertia por completo al dise\u00F1o\r\n  // original en vez de a la ultima base guardada (justo el bug que el\r\n  // usuario pidio auditar: \"GUARDAR POSICI\u00D3N solamente guarda un offset\r\n  // temporal y no consolida una nueva base real\"). Ahora arranca en el\r\n  // valor ABSOLUTO actual de \"data[xKey/yKey/scaleKey]\" -- que YA es la\r\n  // ultima base confirmada (GUARDAR POSICI\u00D3N, theme-layout o perfil,\r\n  // resueltos todos antes de llegar aca) salvo que haya un ajuste sin\r\n  // guardar de ESTA MISMA sesion, en cuyo caso ese es el punto de partida\r\n  // correcto igual. El dato real nunca se toca aca -- el readout/RESET\r\n  // siguen siendo puramente visuales en Master Control.\r\n  const baseline = { x: data[xKey], y: data[yKey], scale: data[scaleKey] };\r\n\r\n  const root = document.createElement('section');\r\n  root.className = 'composition-adjust';\r\n\r\n  if (title) {\r\n    const heading = document.createElement('h2');\r\n    heading.textContent = title;\r\n    root.appendChild(heading);\r\n  }\r\n\r\n  if (note) {\r\n    const noteEl = document.createElement('p');\r\n    noteEl.className = 'composition-adjust-note';\r\n    noteEl.textContent = note;\r\n    root.appendChild(noteEl);\r\n  }\r\n\r\n  const readout = document.createElement('span');\r\n  readout.className = 'text-adjust-readout';\r\n  function refreshReadout() {\r\n    const relX = data[xKey] - baseline.x;\r\n    const relY = data[yKey] - baseline.y;\r\n    const relScale = Math.round((data[scaleKey] - baseline.scale) * 100) / 100;\r\n    readout.textContent = `X:${relX} Y:${relY} Escala:${relScale >= 0 ? '+' : ''}${relScale.toFixed(2)}`;\r\n    readout.classList.toggle('is-zero', relX === 0 && relY === 0 && relScale === 0);\r\n  }\r\n  refreshReadout();\r\n\r\n  const row = document.createElement('div');\r\n  row.className = 'text-adjust-row composition-adjust-row';\r\n  let saveControl = null;\r\n\r\n  function bumpOffset(prop, delta) {\r\n    data[prop] += delta;\r\n    refreshReadout();\r\n    onDirty();\r\n    saveControl?.markDirty();\r\n  }\r\n  function bumpScale(delta) {\r\n    const next = Math.round((data[scaleKey] + delta) * 100) / 100;\r\n    data[scaleKey] = Math.max(MIN_SCALE, next);\r\n    refreshReadout();\r\n    onDirty();\r\n    saveControl?.markDirty();\r\n  }\r\n\r\n  row.appendChild(repeatButton('\u2190', `Mover a la izquierda (${STEP_PX}px)`, () => bumpOffset(xKey, -STEP_PX)));\r\n  row.appendChild(repeatButton('\u2191', `Subir (${STEP_PX}px)`, () => bumpOffset(yKey, -STEP_PX)));\r\n  row.appendChild(repeatButton('\u2193', `Bajar (${STEP_PX}px)`, () => bumpOffset(yKey, STEP_PX)));\r\n  row.appendChild(repeatButton('\u2192', `Mover a la derecha (${STEP_PX}px)`, () => bumpOffset(xKey, STEP_PX)));\r\n  row.appendChild(repeatButton('\u2212', 'Achicar', () => bumpScale(-STEP_SCALE)));\r\n  row.appendChild(repeatButton('+', 'Agrandar', () => bumpScale(STEP_SCALE)));\r\n\r\n  // Segunda fila: intensidad \"0.5\" (BLOQUE 1, pedido explicito del\r\n  // usuario) -- mismas 4 direcciones de Offset X/Y, mitad del paso de\r\n  // arriba. Mismo boton con auto-repeat y misma mutacion in-place de\r\n  // \"data[xKey]/[yKey]\", ningun mecanismo nuevo. Escala sin cambios.\r\n  const halfRow = document.createElement('div');\r\n  halfRow.className = 'text-adjust-row composition-adjust-row text-adjust-row-half';\r\n  halfRow.appendChild(repeatButton('\u2190\u00BD', `Mover a la izquierda (${HALF_STEP_PX}px)`, () => bumpOffset(xKey, -HALF_STEP_PX)));\r\n  halfRow.appendChild(repeatButton('\u2191\u00BD', `Subir (${HALF_STEP_PX}px)`, () => bumpOffset(yKey, -HALF_STEP_PX)));\r\n  halfRow.appendChild(repeatButton('\u2193\u00BD', `Bajar (${HALF_STEP_PX}px)`, () => bumpOffset(yKey, HALF_STEP_PX)));\r\n  halfRow.appendChild(repeatButton('\u2192\u00BD', `Mover a la derecha (${HALF_STEP_PX}px)`, () => bumpOffset(xKey, HALF_STEP_PX)));\r\n\r\n  const resetBtn = document.createElement('button');\r\n  resetBtn.type = 'button';\r\n  resetBtn.className = 'text-adjust-reset';\r\n  resetBtn.textContent = 'RESET';\r\n  resetBtn.title = 'Volver a la \u00FAltima posici\u00F3n guardada (o al dise\u00F1o original si nunca se guard\u00F3)';\r\n  resetBtn.addEventListener('click', () => {\r\n    // \"baseline\" (no \"defaultX/Y/Scale\" directo): una vez que GUARDAR\r\n    // POSICI\u00D3N consolido una base nueva, RESET tiene que volver A ESA base\r\n    // (la posicion aprobada actual), no al dise\u00F1o original de antes de esa\r\n    // consolidacion -- si nunca se guardo nada, \"baseline\" sigue siendo el\r\n    // default de siempre, mismo comportamiento que antes.\r\n    data[xKey] = baseline.x;\r\n    data[yKey] = baseline.y;\r\n    data[scaleKey] = baseline.scale;\r\n    refreshReadout();\r\n    onDirty();\r\n    saveControl?.markDirty();\r\n  });\r\n  row.appendChild(resetBtn);\r\n  row.appendChild(readout);\r\n\r\n  root.appendChild(row);\r\n  root.appendChild(halfRow);\r\n\r\n  // Fila propia (no adentro de \"row\", que es un grid de columnas fijas\r\n  // pensado para los 8 controles de siempre) -- as\u00ED no desalinea ni\r\n  // desborda ning\u00FAn caller existente.\r\n  const saveRow = document.createElement('div');\r\n  saveRow.className = 'text-adjust-save-row';\r\n  // \"elementSpec\" identifica el elemento -- sin el (o sin \"onSave\") no hay\r\n  // boton, mismo criterio que antes. Al confirmar: dispara \"onSave\"\r\n  // (consolida el valor absoluto actual en shared/theme-layouts/, ver\r\n  // server/theme-layouts.js) y ACTUALIZA \"baseline\" al toque (optimista,\r\n  // sin esperar la vuelta del servidor -- mismo criterio que el resto de\r\n  // esta funcion, que ya no espera confirmacion para nada) para que el\r\n  // readout pase a mostrar 0/0/+0.00 sin mover el dato real ni un pixel.\r\n  const wrappedOnSave = (onSave && elementSpec)\r\n    ? () => {\r\n      onSave(elementSpec);\r\n      baseline.x = data[xKey];\r\n      baseline.y = data[yKey];\r\n      baseline.scale = data[scaleKey];\r\n      refreshReadout();\r\n    }\r\n    : undefined;\r\n  saveControl = renderSavePositionControl(saveRow, { onSave: wrappedOnSave, isPendingSave, isConnected });\r\n  if (saveControl) root.appendChild(saveRow);\r\n\r\n  container.appendChild(root);\r\n  return root;\r\n}\r\n","http://localhost:4430/master-control/js/presets-helper.js","// Helper re\u00FAtil para la gesti\u00F3n de Presets en Master Control.\r\n// Permite guardar contenidos (texto o escudos) sin alterar los offsets visuales (textAdjust).\r\n// Soporta acciones de Cargar, Renombrar y Eliminar, con persistencia autom\u00E1tica.\r\n\r\n// \"savePresetEntry\" (2026-08-19, extra\u00EDdo del bot\u00F3n GUARDAR de m\u00E1s abajo\r\n// para que el GENERADOR DE Z\u00D3CALOS pueda guardar sus propuestas \"usando\r\n// el sistema de presets existente... no crear un sistema paralelo\" --\r\n// pedido expl\u00EDcito). Misma forma exacta de preset que ya crea el bot\u00F3n\r\n// GUARDAR PRESET COMPLETO/MAIN/SUB de siempre.\r\nexport function savePresetEntry(data, presetKey, fields, type = 'text', presetLabel) {\r\n  if (!Array.isArray(data[presetKey])) data[presetKey] = [];\r\n  const defaultName = Object.entries(fields)\r\n    .filter(([k, v]) => !k.startsWith('__') && v)\r\n    .map(([, v]) => v)\r\n    .join(' | ') || 'Preset sin nombre';\r\n  const name = presetLabel !== undefined ? presetLabel : prompt('Nombre para el preset:', defaultName);\r\n  if (name === null) return false;\r\n  data[presetKey].unshift({\r\n    id: 'preset-' + Date.now() + '-' + Math.random().toString(36).substr(2, 4),\r\n    label: (name || '').trim() || defaultName,\r\n    type,\r\n    fields,\r\n    createdAt: new Date().toISOString(),\r\n  });\r\n  return true;\r\n}\r\n\r\nexport function renderPresetsControl(container, data, {\r\n  presetKey = 'textPresets',\r\n  title = 'PRESETS',\r\n  buttons = [],\r\n  onApply,\r\n  onDirty,\r\n}) {\r\n  if (!Array.isArray(data[presetKey])) {\r\n    data[presetKey] = [];\r\n  }\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'presets-control-box';\r\n\r\n  const styleId = 'presets-control-styles';\r\n  if (!document.getElementById(styleId)) {\r\n    const style = document.createElement('style');\r\n    style.id = styleId;\r\n    style.textContent = `\r\n      .presets-control-box {\r\n        background: #1a1a1a;\r\n        padding: 14px;\r\n        border: 1px solid #333;\r\n        border-radius: 6px;\r\n        margin-top: 14px;\r\n      }\r\n      .presets-title {\r\n        font-family: 'Montserrat', sans-serif;\r\n        font-size: 13px;\r\n        font-weight: 700;\r\n        color: #e5a93b;\r\n        margin: 0 0 10px 0;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n      }\r\n      .presets-btn-group {\r\n        display: flex;\r\n        flex-wrap: wrap;\r\n        gap: 8px;\r\n        margin-bottom: 12px;\r\n      }\r\n      .presets-btn {\r\n        background: #2a2a2a;\r\n        color: #fff;\r\n        border: 1px solid #444;\r\n        padding: 6px 12px;\r\n        border-radius: 4px;\r\n        font-size: 11px;\r\n        font-weight: 700;\r\n        cursor: pointer;\r\n        transition: background 0.15s, border-color 0.15s;\r\n        text-transform: uppercase;\r\n      }\r\n      .presets-btn:hover {\r\n        background: #383838;\r\n        border-color: #e5a93b;\r\n      }\r\n      .presets-btn.save-complete {\r\n        background: #20402b;\r\n        border-color: #2e663e;\r\n      }\r\n      .presets-btn.save-complete:hover {\r\n        background: #285437;\r\n      }\r\n      .presets-list {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 6px;\r\n        max-height: 220px;\r\n        overflow-y: auto;\r\n      }\r\n      .preset-item {\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: space-between;\r\n        background: #242424;\r\n        padding: 6px 10px;\r\n        border-radius: 4px;\r\n        border: 1px solid #383838;\r\n        gap: 8px;\r\n        cursor: grab;\r\n        transition: background 0.15s, border-color 0.15s, opacity 0.15s;\r\n      }\r\n      .preset-item.is-dragging {\r\n        opacity: 0.4;\r\n        background: #333;\r\n      }\r\n      .preset-item.drag-over {\r\n        border: 2px dashed #e5a93b;\r\n        background: #2d2618;\r\n      }\r\n      .preset-drag-handle {\r\n        color: #777;\r\n        font-size: 14px;\r\n        user-select: none;\r\n        padding-right: 4px;\r\n      }\r\n      .preset-drag-handle:hover {\r\n        color: #e5a93b;\r\n      }\r\n      .preset-info {\r\n        display: flex;\r\n        flex-direction: column;\r\n        overflow: hidden;\r\n        flex: 1;\r\n      }\r\n      .preset-name {\r\n        font-size: 12px;\r\n        font-weight: 700;\r\n        color: #eee;\r\n        white-space: nowrap;\r\n        overflow: hidden;\r\n        text-overflow: ellipsis;\r\n      }\r\n      .preset-details {\r\n        font-size: 10px;\r\n        color: #aaa;\r\n        white-space: nowrap;\r\n        overflow: hidden;\r\n        text-overflow: ellipsis;\r\n      }\r\n      .preset-actions {\r\n        display: flex;\r\n        gap: 4px;\r\n        flex-shrink: 0;\r\n      }\r\n      .preset-act-btn {\r\n        background: #333;\r\n        color: #ccc;\r\n        border: 1px solid #555;\r\n        padding: 4px 8px;\r\n        border-radius: 3px;\r\n        font-size: 10px;\r\n        font-weight: 600;\r\n        cursor: pointer;\r\n      }\r\n      .preset-act-btn:hover {\r\n        background: #444;\r\n        color: #fff;\r\n      }\r\n      .preset-act-btn.load {\r\n        background: #e5a93b;\r\n        color: #111;\r\n        border: none;\r\n        font-weight: 800;\r\n      }\r\n      .preset-act-btn.load:hover {\r\n        background: #f5b94b;\r\n      }\r\n      .preset-act-btn.delete:hover {\r\n        background: #752222;\r\n        border-color: #933;\r\n        color: #fff;\r\n      }\r\n      .presets-empty {\r\n        font-size: 11px;\r\n        color: #777;\r\n        font-style: italic;\r\n      }\r\n    `;\r\n    document.head.appendChild(style);\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n\r\n    const heading = document.createElement('div');\r\n    heading.className = 'presets-title';\r\n    heading.textContent = title;\r\n    root.appendChild(heading);\r\n\r\n    const btnGroup = document.createElement('div');\r\n    btnGroup.className = 'presets-btn-group';\r\n\r\n    for (const b of buttons) {\r\n      const btn = document.createElement('button');\r\n      btn.type = 'button';\r\n      btn.className = `presets-btn ${b.type === 'complete' ? 'save-complete' : ''}`;\r\n      btn.textContent = b.label;\r\n      btn.addEventListener('click', () => {\r\n        if (!savePresetEntry(data, presetKey, b.getFields(), b.type || 'text')) return;\r\n        if (onDirty) onDirty();\r\n        render();\r\n      });\r\n      btnGroup.appendChild(btn);\r\n    }\r\n\r\n    root.appendChild(btnGroup);\r\n\r\n    const list = document.createElement('div');\r\n    list.className = 'presets-list';\r\n\r\n    const presets = data[presetKey];\r\n    if (presets.length === 0) {\r\n      const empty = document.createElement('div');\r\n      empty.className = 'presets-empty';\r\n      empty.textContent = 'No hay presets guardados.';\r\n      list.appendChild(empty);\r\n    } else {\r\n      presets.forEach((preset, index) => {\r\n        const item = document.createElement('div');\r\n        item.className = 'preset-item';\r\n        item.setAttribute('draggable', 'true');\r\n\r\n        const dragHandle = document.createElement('span');\r\n        dragHandle.className = 'preset-drag-handle';\r\n        dragHandle.textContent = '\u283F';\r\n        dragHandle.title = 'Arrastrar para reordenar';\r\n        item.appendChild(dragHandle);\r\n\r\n        item.addEventListener('dragstart', (e) => {\r\n          e.dataTransfer.setData('text/plain', String(index));\r\n          e.dataTransfer.effectAllowed = 'move';\r\n          item.classList.add('is-dragging');\r\n        });\r\n        item.addEventListener('dragover', (e) => {\r\n          e.preventDefault();\r\n          e.dataTransfer.dropEffect = 'move';\r\n          item.classList.add('drag-over');\r\n        });\r\n        item.addEventListener('dragleave', () => {\r\n          item.classList.remove('drag-over');\r\n        });\r\n        item.addEventListener('drop', (e) => {\r\n          e.preventDefault();\r\n          item.classList.remove('drag-over');\r\n          const fromIndex = parseInt(e.dataTransfer.getData('text/plain'), 10);\r\n          if (!isNaN(fromIndex) && fromIndex !== index) {\r\n            const [moved] = presets.splice(fromIndex, 1);\r\n            presets.splice(index, 0, moved);\r\n            if (onDirty) onDirty();\r\n            render();\r\n          }\r\n        });\r\n        item.addEventListener('dragend', () => {\r\n          item.classList.remove('is-dragging');\r\n          item.classList.remove('drag-over');\r\n        });\r\n\r\n        const info = document.createElement('div');\r\n        info.className = 'preset-info';\r\n\r\n        const nameEl = document.createElement('span');\r\n        nameEl.className = 'preset-name';\r\n        nameEl.textContent = preset.label;\r\n\r\n        const detailsEl = document.createElement('span');\r\n        detailsEl.className = 'preset-details';\r\n        detailsEl.textContent = Object.entries(preset.fields)\r\n          .filter(([k]) => !k.startsWith('__'))\r\n          .map(([k, v]) => `${k}: \"${v}\"`)\r\n          .join(' \u2014 ');\r\n\r\n        info.appendChild(nameEl);\r\n        info.appendChild(detailsEl);\r\n        item.appendChild(info);\r\n\r\n        const actions = document.createElement('div');\r\n        actions.className = 'preset-actions';\r\n\r\n        const loadBtn = document.createElement('button');\r\n        loadBtn.type = 'button';\r\n        loadBtn.className = 'preset-act-btn load';\r\n        loadBtn.textContent = 'CARGAR';\r\n        loadBtn.addEventListener('click', () => {\r\n          if (onApply) onApply(preset.fields);\r\n          if (onDirty) onDirty();\r\n        });\r\n\r\n        const renameBtn = document.createElement('button');\r\n        renameBtn.type = 'button';\r\n        renameBtn.className = 'preset-act-btn';\r\n        renameBtn.textContent = 'RENOMBRAR';\r\n        renameBtn.addEventListener('click', () => {\r\n          const newName = prompt('Nuevo nombre para el preset:', preset.label);\r\n          if (newName !== null && newName.trim()) {\r\n            preset.label = newName.trim();\r\n            if (onDirty) onDirty();\r\n            render();\r\n          }\r\n        });\r\n\r\n        const delBtn = document.createElement('button');\r\n        delBtn.type = 'button';\r\n        delBtn.className = 'preset-act-btn delete';\r\n        delBtn.textContent = 'ELIMINAR';\r\n        delBtn.addEventListener('click', () => {\r\n          if (confirm(`\u00BFEliminar preset \"${preset.label}\"?`)) {\r\n            presets.splice(index, 1);\r\n            if (onDirty) onDirty();\r\n            render();\r\n          }\r\n        });\r\n\r\n        actions.appendChild(loadBtn);\r\n        actions.appendChild(renameBtn);\r\n        actions.appendChild(delBtn);\r\n        item.appendChild(actions);\r\n\r\n        list.appendChild(item);\r\n      });\r\n    }\r\n\r\n    root.appendChild(list);\r\n  }\r\n\r\n  render();\r\n  container.appendChild(root);\r\n}\r\n","http://localhost:4430/master-control/js/asset-resources-panel.js","// RECURSO GR\u00C1FICO (SOFTX, 2026-10-29): secci\u00F3n compacta dentro de cada\r\n// m\u00F3dulo con asset externo. Lista cada recurso por separado (ej. TARJETA:\r\n// AMARILLA / ROJA / AZUL) con ABRIR CARPETA y RECARGAR propios. Solo manda\r\n// IDs del registro central (shared/asset-registry.js); el servidor resuelve\r\n// la ruta real (server/asset-resources.js).\r\n\r\n// Secciones abiertas por el operador en esta sesi\u00F3n (sobrevive al re-render\r\n// del panel, no se persiste).\r\nconst openModules = new Set();\r\n// \u00DAltimo resultado de RECARGAR/ABRIR por recurso (se ve tras re-renders).\r\nconst lastResults = new Map();\r\n\r\nasync function postJson(url, body) {\r\n  const res = await fetch(url, {\r\n    method: 'POST',\r\n    headers: { 'Content-Type': 'application/json' },\r\n    body: JSON.stringify(body || {}),\r\n  });\r\n  const data = await res.json().catch(() => null);\r\n  if (!res.ok || !data?.ok) throw new Error(data?.error || `HTTP ${res.status}`);\r\n  return data;\r\n}\r\n\r\nfunction el(tag, className, text) {\r\n  const node = document.createElement(tag);\r\n  if (className) node.className = className;\r\n  if (text !== undefined) node.textContent = text;\r\n  return node;\r\n}\r\n\r\nfunction describeProbe(probe) {\r\n  if (!probe?.exists) return 'NO EXISTE';\r\n  const parts = [probe.format];\r\n  if (probe.codec) parts.push(probe.codec);\r\n  if (probe.width && probe.height) parts.push(`${probe.width}x${probe.height}`);\r\n  if (probe.fps) parts.push(`${probe.fps} FPS`);\r\n  if (probe.durationSec) parts.push(`${probe.durationSec.toFixed(2)} s`);\r\n  if (probe.stackedAlpha !== undefined) parts.push(probe.stackedAlpha ? 'alfa apilado \u2713' : 'sin alfa apilado');\r\n  else if (probe.hasAlpha !== undefined) parts.push(probe.hasAlpha ? 'transparencia \u2713' : 'sin transparencia');\r\n  if (probe.sizeBytes) parts.push(`${(probe.sizeBytes / 1024 / 1024).toFixed(2)} MB`);\r\n  return parts.join(' \u00B7 ');\r\n}\r\n\r\n// options: { isOnAir(moduleId) -> bool, onReloaded(moduleId) }\r\nexport function renderAssetResources(container, moduleId, options = {}) {\r\n  container.innerHTML = '';\r\n  let disposed = false;\r\n\r\n  const load = async () => {\r\n    let assets;\r\n    try {\r\n      const res = await fetch(`/api/assets/module/${encodeURIComponent(moduleId)}`);\r\n      const data = await res.json();\r\n      assets = data?.ok ? data.assets : [];\r\n    } catch {\r\n      assets = [];\r\n    }\r\n    if (disposed || !container.isConnected) return;\r\n    render(assets);\r\n  };\r\n\r\n  function render(assets) {\r\n    container.innerHTML = '';\r\n    if (!assets.length) return;\r\n    const box = el('details', 'asset-res');\r\n    box.open = openModules.has(moduleId);\r\n    box.addEventListener('toggle', () => {\r\n      if (box.open) openModules.add(moduleId); else openModules.delete(moduleId);\r\n    });\r\n    const summary = el('summary', 'asset-res-summary');\r\n    summary.appendChild(el('span', 'asset-res-title', assets.length > 1 ? `RECURSOS GR\u00C1FICOS (${assets.length})` : 'RECURSO GR\u00C1FICO'));\r\n    summary.appendChild(el('span', 'asset-res-summary-file', assets.length > 1 ? assets.map((a) => a.label.toUpperCase()).join(' \u00B7 ') : assets[0].fileName));\r\n    if (assets.some((a) => a.warnings.length)) summary.appendChild(el('span', 'asset-res-warn-dot', '\u26A0'));\r\n    box.appendChild(summary);\r\n\r\n    const note = el('p', 'asset-res-note', 'Para cambiar la pieza: ABRIR CARPETA, reemplaz\u00E1 el archivo con el MISMO nombre y apret\u00E1 RECARGAR. No manda nada al aire.');\r\n    box.appendChild(note);\r\n\r\n    for (const asset of assets) box.appendChild(buildRow(asset));\r\n    container.appendChild(box);\r\n  }\r\n\r\n  function buildRow(asset) {\r\n    const row = el('div', 'asset-res-row');\r\n    const head = el('div', 'asset-res-head');\r\n    head.appendChild(el('span', 'asset-res-label', asset.label.toUpperCase()));\r\n    head.appendChild(el('code', 'asset-res-file', asset.fileName));\r\n    row.appendChild(head);\r\n\r\n    row.appendChild(el('div', 'asset-res-line', `CARPETA: ${asset.folder}/`));\r\n    row.appendChild(el('div', 'asset-res-line', `FORMATO ESPERADO: ${asset.expected}`));\r\n    row.appendChild(el('div', 'asset-res-line', `ARCHIVO ACTUAL: ${describeProbe(asset.probe)}`));\r\n    for (const warning of asset.warnings) row.appendChild(el('div', 'asset-res-warning', warning));\r\n\r\n    const actions = el('div', 'asset-res-actions');\r\n    const openBtn = el('button', 'asset-res-btn', 'ABRIR CARPETA');\r\n    openBtn.type = 'button';\r\n    const reloadBtn = el('button', 'asset-res-btn primary', 'RECARGAR');\r\n    reloadBtn.type = 'button';\r\n    actions.append(openBtn, reloadBtn);\r\n    const status = el('div', 'asset-res-status');\r\n    const previous = lastResults.get(asset.id);\r\n    if (previous) {\r\n      status.className = `asset-res-status ${previous.kind}`;\r\n      status.textContent = previous.text;\r\n    }\r\n    row.append(actions, status);\r\n\r\n    const setStatus = (kind, text) => {\r\n      lastResults.set(asset.id, { kind, text });\r\n      status.className = `asset-res-status ${kind}`;\r\n      status.textContent = text;\r\n    };\r\n\r\n    openBtn.addEventListener('click', async () => {\r\n      try {\r\n        const data = await postJson('/api/assets/open-folder', { assetId: asset.id });\r\n        setStatus('success', data.archivo ? `CARPETA ABIERTA \u2014 ${asset.fileName} seleccionado.` : `CARPETA ABIERTA \u2014 ${asset.fileName} no existe todav\u00EDa: copialo ah\u00ED.`);\r\n      } catch (err) {\r\n        setStatus('error', `NO SE PUDO ABRIR LA CARPETA: ${err.message}`);\r\n      }\r\n    });\r\n\r\n    reloadBtn.addEventListener('click', async () => {\r\n      reloadBtn.disabled = true;\r\n      try {\r\n        const data = await postJson('/api/assets/reload', { assetId: asset.id });\r\n        const result = data.asset;\r\n        const onAir = options.isOnAir?.(asset.moduleId);\r\n        const base = result.probe.exists\r\n          ? (data.changed ? 'RECURSO RECARGADO: se usa el archivo nuevo.' : 'RECURSO RECARGADO (el archivo no cambi\u00F3 desde la \u00FAltima carga).')\r\n          : 'EL ARCHIVO NO EXISTE: Program conserva lo \u00FAltimo que ten\u00EDa cargado.';\r\n        const where = onAir\r\n          ? ' El m\u00F3dulo est\u00E1 AL AIRE: el recurso nuevo se aplica cuando salga del aire (pr\u00F3ximo TAKE).'\r\n          : ' Preview actualizado; Program lo usa en el pr\u00F3ximo TAKE.';\r\n        const text = [`${base}${result.probe.exists ? where : ''}`, `CARGADO: ${describeProbe(result.probe)}`, ...result.warnings].join('\\n');\r\n        setStatus(result.warnings.length || !result.probe.exists ? 'warning' : 'success', text);\r\n        options.onReloaded?.(asset.moduleId);\r\n        await load();\r\n      } catch (err) {\r\n        setStatus('error', `NO SE PUDO RECARGAR: ${err.message}`);\r\n        reloadBtn.disabled = false;\r\n      }\r\n    });\r\n    return row;\r\n  }\r\n\r\n  load();\r\n  return () => { disposed = true; };\r\n}\r\n","http://localhost:4430/master-control/js/equipos-panel.js","// EQUIPOS (2026-10-08, pedido explicito del usuario, Argentina Streamers;\r\n// extendido a GLA 2026-10-21, mismo pedido para GLA): reemplaza a\r\n// \"Abreviaturas\". Fuente central del catalogo del theme activo (server/\r\n// teams.js): por equipo NOMBRE COMPLETO + ABREVIATURA + VISIBLE EN\r\n// DESPLEGABLE (y en GLA tambien el ESCUDO asociado). Ocultar NUNCA borra\r\n// (id, escudo, plantel y referencias quedan intactos).\r\n//\r\n// AGREGAR EQUIPO abre la carpeta REAL de escudos del theme (endpoint local,\r\n// ver server/index.js \"open-crest-folder\"); REFRESCAR relee esa carpeta: un\r\n// PNG nuevo aparece como equipo PENDIENTE (nombre propuesto desde el\r\n// archivo, oculto de los desplegables) hasta que el operador lo guarda. En\r\n// GLA, un escudo nuevo que en realidad es de un equipo que ya existe se\r\n// ASOCIA a ese equipo en vez de crear un duplicado.\r\nimport { TEAMS, updateLocalTeamCatalog } from '../../shared/teams.js';\r\nimport { DEFAULT_THEME_ID } from '../../shared/themes.js';\r\nimport { TEAM_COLORS, CUSTOM_COLOR_ID, colorHex, normalizeHexColor } from '../../shared/team-colors.js';\r\n\r\nfunction injectStyles() {\r\n  if (document.getElementById('equipos-panel-styles')) return;\r\n  const style = document.createElement('style');\r\n  style.id = 'equipos-panel-styles';\r\n  style.textContent = `\r\n    .eq-panel { background: #181818; padding: 16px; border: 1px solid #333; border-radius: 6px; display: flex; flex-direction: column; gap: 14px; }\r\n    .eq-desc { font-size: 12px; color: #aaa; line-height: 1.4; margin: 0; }\r\n    .eq-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }\r\n    .eq-btn { background: #333; color: #ddd; border: 1px solid #555; padding: 8px 12px; border-radius: 4px; font-size: 11px; font-weight: 700; cursor: pointer; }\r\n    .eq-btn:hover { background: #444; color: #fff; }\r\n    .eq-btn.primary { background: #e5a93b; color: #111; border: none; }\r\n    .eq-btn.primary:hover { background: #f5b94b; }\r\n    .eq-btn:disabled { opacity: 0.5; cursor: default; }\r\n    .eq-status { font-size: 11px; color: #aaa; }\r\n    .eq-status.success { color: #7ed67e; }\r\n    .eq-status.error { color: #e88; }\r\n    .eq-list { display: flex; flex-direction: column; gap: 10px; }\r\n    .eq-row { display: grid; grid-template-columns: 40px minmax(0, 1fr) 64px 104px auto; gap: 10px; align-items: end; background: #242424; padding: 10px 12px; border-radius: 6px; border: 1px solid #333; }\r\n    /* GLA (2026-10-29): fila en 2 lineas para que NOMBRE tenga el ancho libre\r\n       y nada se superponga. Linea 1: handle, escudo, NOMBRE, ABREVIATURA.\r\n       Linea 2 (.eq-options, pasa a otra linea si no entra): COLOR, VISIBLE,\r\n       ESCUDO, GUARDAR. Debajo, el color PERSONALIZADO solo cuando esta elegido. */\r\n    .eq-row.eq-row--crest { grid-template-columns: 26px 44px minmax(0, 1fr) 84px; row-gap: 10px; }\r\n    .eq-row--crest > .eq-handle { grid-row: 1 / span 2; align-self: stretch; display: flex; align-items: center; justify-content: center; border-radius: 4px; }\r\n    .eq-row--crest > .eq-handle:hover { background: #2e2e2e; }\r\n    .eq-row--crest > .eq-crest { grid-row: 1 / span 2; width: 44px; height: 44px; }\r\n    .eq-row--crest > .eq-options { grid-column: 3 / -1; display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; min-width: 0; }\r\n    .eq-options > .eq-field:nth-child(1) { flex: 1.4 1 180px; }\r\n    .eq-options > .eq-field:nth-child(2) { flex: 0.6 1 90px; }\r\n    .eq-options > .eq-field:nth-child(3) { flex: 1 1 150px; }\r\n    .eq-row--crest > .eq-custom-color { grid-column: 3 / -1; }\r\n    .eq-options > .eq-btn.primary { white-space: nowrap; margin-left: auto; }\r\n    .eq-handle { align-self: center; cursor: grab; color: #888; font-size: 20px; line-height: 1; text-align: center; user-select: none; touch-action: none; padding: 6px 0; }\r\n    .eq-handle:hover { color: #e5a93b; }\r\n    .eq-row.is-dragging { outline: 2px solid #e5a93b; opacity: 0.85; }\r\n    .eq-list.is-sorting, .eq-list.is-sorting * { cursor: grabbing !important; user-select: none; }\r\n    .eq-color { display: flex; gap: 6px; align-items: center; }\r\n    .eq-color select { flex: 1; min-width: 0; }\r\n    .eq-swatch { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #777; flex: 0 0 auto; }\r\n    .eq-custom-color { grid-column: 1 / -1; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 11px; color: #ccc; }\r\n    .eq-custom-color[hidden] { display: none; }\r\n    .eq-hex-preview { width: 30px; height: 30px; border-radius: 4px; border: 1px solid #777; flex: 0 0 auto; }\r\n    .eq-custom-color input[type=\"color\"] { width: 44px; height: 30px; padding: 0; border: 1px solid #555; background: #111; border-radius: 4px; cursor: pointer; }\r\n    .eq-custom-color input.hex { width: 96px; background: #111; border: 1px solid #555; color: #fff; padding: 6px; border-radius: 4px; font-size: 12px; font-weight: 700; text-transform: uppercase; font-family: monospace; }\r\n    .eq-custom-color input.hex.invalid { border-color: #e88; }\r\n    .eq-row.is-hidden-team { opacity: 0.6; }\r\n    .eq-row.is-pending { border-color: #e5a93b; }\r\n    @media (max-width: 900px) {\r\n      .eq-row { grid-template-columns: 44px 1fr; }\r\n      .eq-row.eq-row--crest { grid-template-columns: 26px 44px minmax(0, 1fr) 72px; }\r\n    }\r\n    .eq-crest { width: 40px; height: 40px; object-fit: contain; align-self: center; }\r\n    .eq-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }\r\n    .eq-field span { font-size: 10px; color: #999; font-weight: 700; text-transform: uppercase; }\r\n    .eq-field input, .eq-field select { background: #111; border: 1px solid #555; color: #fff; padding: 6px; border-radius: 4px; font-size: 12px; font-weight: 700; min-width: 0; }\r\n    .eq-field input.abbr { text-transform: uppercase; text-align: center; }\r\n    .eq-meta { grid-column: 1 / -1; font-size: 10px; color: #888; }\r\n    .eq-pending-badge { color: #e5a93b; font-weight: 800; }\r\n    .eq-assoc { grid-column: 1 / -1; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 11px; color: #ccc; }\r\n    .eq-assoc select { background: #111; border: 1px solid #555; color: #fff; padding: 6px; border-radius: 4px; font-size: 12px; }\r\n  `;\r\n  document.head.appendChild(style);\r\n}\r\n\r\nasync function postJson(url, body) {\r\n  const res = await fetch(url, {\r\n    method: 'POST',\r\n    headers: { 'Content-Type': 'application/json' },\r\n    body: JSON.stringify(body || {}),\r\n  });\r\n  const data = await res.json().catch(() => null);\r\n  if (!res.ok || !data?.ok) throw new Error(data?.error || `HTTP ${res.status}`);\r\n  return data;\r\n}\r\n\r\n// El ultimo aviso sobrevive al re-render que dispara el propio\r\n// TEAM_CATALOG_UPDATE (main.js reconstruye este panel al recibirlo, a veces\r\n// ANTES de que llegue la respuesta del GUARDAR): el aviso se guarda aca y\r\n// se pinta siempre en la instancia del panel que este visible.\r\nlet lastStatus = null;\r\nlet renderVisiblePanel = null;\r\nconst STATUS_TTL_MS = 10000;\r\n\r\n// \"teamColors\" (2026-10-22, SOLO GLA): { get(teamId) -> { colorId, hex },\r\n// set(teamId, colorId, hex?) }\r\n// sobre el MISMO mapa teamId -> colorId que ya usa el Marcador\r\n// (scoreboard.teamColorAssignments, ver master-control/js/main.js) -- no es\r\n// un segundo sistema de colores.\r\nexport function renderEquiposPanel(container, { themeId = 'argentinaStreamers', teamColors = null } = {}) {\r\n  injectStyles();\r\n  container.innerHTML = '';\r\n  const root = document.createElement('div');\r\n  root.className = 'eq-panel';\r\n  container.appendChild(root);\r\n\r\n  // GLA (2026-10-21): escudo asociado editable + asociacion de escudos\r\n  // nuevos a equipos existentes. Argentina Streamers sin cambios.\r\n  const isGla = themeId === DEFAULT_THEME_ID;\r\n  let crestFiles = [];\r\n\r\n  let status = lastStatus && Date.now() - lastStatus.at < STATUS_TTL_MS ? lastStatus : null;\r\n\r\n  function setStatus(next) {\r\n    lastStatus = next ? { ...next, at: Date.now() } : null;\r\n    if (root.isConnected) {\r\n      status = lastStatus;\r\n      render();\r\n    } else if (renderVisiblePanel) {\r\n      renderVisiblePanel(lastStatus);\r\n    }\r\n  }\r\n\r\n  async function loadCrestFiles() {\r\n    if (!isGla) return;\r\n    try {\r\n      const res = await fetch('/api/teams/crest-files');\r\n      const data = await res.json();\r\n      crestFiles = Array.isArray(data?.files) ? data.files : [];\r\n    } catch {\r\n      crestFiles = [];\r\n    }\r\n    if (root.isConnected) render();\r\n  }\r\n\r\n  async function refreshCatalog(text) {\r\n    try {\r\n      const data = await postJson('/api/teams/refresh');\r\n      updateLocalTeamCatalog(data.catalog);\r\n      await loadCrestFiles();\r\n      const pending = data.catalog.filter((t) => t.pending).length;\r\n      setStatus({ kind: 'success', text: text || `EQUIPOS / ESCUDOS ACTUALIZADOS \u2014 ${data.catalog.length} equipos${pending ? `, ${pending} pendiente(s) de completar` : ''}.` });\r\n    } catch (err) {\r\n      setStatus({ kind: 'error', text: `NO SE PUDO REFRESCAR: ${err.message}` });\r\n    }\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n\r\n    const desc = document.createElement('p');\r\n    desc.className = 'eq-desc';\r\n    desc.textContent = isGla\r\n      ? 'Cat\u00E1logo central de equipos de GRAN LIGA REL\u00C1MPAGO (escudos de assets/crests/): Marcador, VS, Grupos, Brackets, Formaci\u00F3n, Tarjetas, Cambios y el resto de los selectores usan esta lista. Ocultar un equipo NO lo borra: conserva escudo, plantel y datos, y sigue funcionando donde ya estaba elegido.'\r\n      : 'Cat\u00E1logo central de equipos de Argentina Streamers: Marcador, VS, Formaci\u00F3n, Planteles y el resto de los selectores usan esta lista. Ocultar un equipo NO lo borra: conserva escudo, plantel y datos, y sigue funcionando donde ya estaba elegido.';\r\n    root.appendChild(desc);\r\n\r\n    const actions = document.createElement('div');\r\n    actions.className = 'eq-actions';\r\n    const addBtn = document.createElement('button');\r\n    addBtn.type = 'button';\r\n    addBtn.className = 'eq-btn primary';\r\n    addBtn.textContent = 'AGREGAR EQUIPO';\r\n    addBtn.title = isGla\r\n      ? 'Abre la carpeta de escudos de GLA (assets/crests): copi\u00E1 ah\u00ED el PNG y despu\u00E9s apret\u00E1 REFRESCAR.'\r\n      : 'Abre la carpeta de escudos de Argentina Streamers: copi\u00E1 ah\u00ED el PNG y despu\u00E9s apret\u00E1 REFRESCAR.';\r\n    addBtn.addEventListener('click', async () => {\r\n      try {\r\n        const data = await postJson('/api/teams/open-crest-folder');\r\n        setStatus({ kind: 'success', text: `CARPETA ABIERTA: ${data.carpeta} \u2014 copi\u00E1 el PNG del escudo y apret\u00E1 REFRESCAR EQUIPOS / ESCUDOS.` });\r\n      } catch (err) {\r\n        setStatus({ kind: 'error', text: `NO SE PUDO ABRIR LA CARPETA: ${err.message}` });\r\n      }\r\n    });\r\n    const refreshBtn = document.createElement('button');\r\n    refreshBtn.type = 'button';\r\n    refreshBtn.className = 'eq-btn';\r\n    refreshBtn.textContent = 'REFRESCAR EQUIPOS / ESCUDOS';\r\n    refreshBtn.addEventListener('click', () => refreshCatalog());\r\n    actions.append(addBtn, refreshBtn);\r\n    if (status) {\r\n      const statusEl = document.createElement('span');\r\n      statusEl.className = `eq-status ${status.kind}`;\r\n      statusEl.textContent = status.text;\r\n      actions.appendChild(statusEl);\r\n    }\r\n    root.appendChild(actions);\r\n\r\n    const list = document.createElement('div');\r\n    list.className = 'eq-list';\r\n    // GLA (2026-10-22): orden manual del catalogo (el mismo de todos los\r\n    // desplegables). Argentina Streamers conserva \"pendientes primero\".\r\n    const ordered = isGla ? [...TEAMS] : [...TEAMS].sort((a, b) => Number(!!b.pending) - Number(!!a.pending));\r\n    for (const team of ordered) list.appendChild(buildRow(team));\r\n    root.appendChild(list);\r\n  }\r\n\r\n  // ORDEN MANUAL POR ARRASTRE (2026-10-22, SOLO GLA): se agarra el handle\r\n  // de la izquierda, la fila se mueve en vivo dentro de la lista y al\r\n  // soltar se guarda el orden completo (ocultos incluidos) en el servidor\r\n  // (POST /api/teams/order, ver server/teams.js setGlaTeamOrder).\r\n  function startSort(event, row) {\r\n    if (event.button !== undefined && event.button !== 0) return;\r\n    event.preventDefault();\r\n    const list = row.parentElement;\r\n    const before = [...list.children].map((r) => r.dataset.teamId).join('|');\r\n    list.classList.add('is-sorting');\r\n    row.classList.add('is-dragging');\r\n    let lastY = event.clientY;\r\n    const placeAt = (clientY) => {\r\n      const rows = [...list.children].filter((r) => r !== row);\r\n      const target = rows.find((r) => {\r\n        const rect = r.getBoundingClientRect();\r\n        return clientY < rect.top + rect.height / 2;\r\n      });\r\n      if (target) {\r\n        if (row.nextElementSibling !== target) list.insertBefore(row, target);\r\n      } else if (list.lastElementChild !== row) {\r\n        list.appendChild(row);\r\n      }\r\n    };\r\n    const onMove = (moveEvent) => {\r\n      lastY = moveEvent.clientY;\r\n      placeAt(lastY);\r\n    };\r\n    // La lista es mas alta que la pantalla: cerca del borde superior/inferior\r\n    // la pagina se desplaza sola mientras se arrastra.\r\n    const EDGE = 60;\r\n    const autoScroll = setInterval(() => {\r\n      const step = lastY < EDGE ? -16 : (lastY > window.innerHeight - EDGE ? 16 : 0);\r\n      if (!step) return;\r\n      window.scrollBy(0, step);\r\n      placeAt(lastY);\r\n    }, 16);\r\n    const onUp = async () => {\r\n      clearInterval(autoScroll);\r\n      window.removeEventListener('pointermove', onMove);\r\n      window.removeEventListener('pointerup', onUp);\r\n      window.removeEventListener('pointercancel', onUp);\r\n      list.classList.remove('is-sorting');\r\n      row.classList.remove('is-dragging');\r\n      const order = [...list.children].map((r) => r.dataset.teamId);\r\n      if (order.join('|') === before) return;\r\n      try {\r\n        const data = await postJson('/api/teams/order', { order });\r\n        updateLocalTeamCatalog(data.catalog);\r\n        setStatus({ kind: 'success', text: 'ORDEN DE EQUIPOS GUARDADO \u2014 los desplegables usan este orden.' });\r\n      } catch (err) {\r\n        setStatus({ kind: 'error', text: `NO SE PUDO GUARDAR EL ORDEN: ${err.message}` });\r\n      }\r\n    };\r\n    window.addEventListener('pointermove', onMove);\r\n    window.addEventListener('pointerup', onUp);\r\n    window.addEventListener('pointercancel', onUp);\r\n  }\r\n\r\n  async function saveTeam(team, payload, okText, button) {\r\n    if (button) button.disabled = true;\r\n    try {\r\n      const data = await postJson('/api/teams/team', { theme: themeId, teamId: team.id, ...payload });\r\n      updateLocalTeamCatalog(data.catalog);\r\n      setStatus({ kind: 'success', text: okText });\r\n    } catch (err) {\r\n      if (button) button.disabled = false;\r\n      setStatus({ kind: 'error', text: `NO SE PUDO GUARDAR ${team.name}: ${err.message}` });\r\n    }\r\n  }\r\n\r\n  function buildRow(team) {\r\n    const row = document.createElement('div');\r\n    row.className = 'eq-row';\r\n    row.dataset.teamId = team.id;\r\n    row.classList.toggle('eq-row--crest', isGla);\r\n    row.classList.toggle('is-hidden-team', team.visible === false);\r\n    row.classList.toggle('is-pending', !!team.pending);\r\n\r\n    const crest = document.createElement('img');\r\n    crest.className = 'eq-crest';\r\n    crest.alt = team.name;\r\n    if (team.file) crest.src = team.file;\r\n\r\n    const field = (label, input, title) => {\r\n      const wrap = document.createElement('label');\r\n      wrap.className = 'eq-field';\r\n      if (title) wrap.title = title;\r\n      const span = document.createElement('span');\r\n      span.textContent = label;\r\n      wrap.append(span, input);\r\n      return wrap;\r\n    };\r\n\r\n    const nameInput = document.createElement('input');\r\n    nameInput.type = 'text';\r\n    nameInput.maxLength = 60;\r\n    nameInput.value = team.name || '';\r\n    const abbrInput = document.createElement('input');\r\n    abbrInput.type = 'text';\r\n    abbrInput.className = 'abbr';\r\n    abbrInput.maxLength = 4;\r\n    abbrInput.value = team.abbr || '';\r\n    const visibleSelect = document.createElement('select');\r\n    for (const [value, label] of [['si', 'S\u00CD'], ['no', 'NO']]) {\r\n      const option = document.createElement('option');\r\n      option.value = value;\r\n      option.textContent = label;\r\n      visibleSelect.appendChild(option);\r\n    }\r\n    // GLA: un pendiente se propone visible (confirmarlo es justamente\r\n    // sumarlo). Argentina Streamers conserva su comportamiento de siempre.\r\n    visibleSelect.value = isGla && team.pending ? 'si' : (team.visible === false ? 'no' : 'si');\r\n\r\n    // GLA: ESCUDO asociado (un archivo real de assets/crests/).\r\n    let crestSelect = null;\r\n    if (isGla) {\r\n      crestSelect = document.createElement('select');\r\n      const files = crestFiles.length ? crestFiles : [team.crestFile].filter(Boolean);\r\n      for (const file of files) {\r\n        const option = document.createElement('option');\r\n        option.value = file;\r\n        option.textContent = file === team.ownFile ? `${file} (propio)` : file;\r\n        crestSelect.appendChild(option);\r\n      }\r\n      crestSelect.value = team.crestFile || team.ownFile || '';\r\n      crestSelect.addEventListener('change', () => {\r\n        crest.src = `/assets/crests/${crestSelect.value}`;\r\n      });\r\n    }\r\n\r\n    const saveBtn = document.createElement('button');\r\n    saveBtn.type = 'button';\r\n    saveBtn.className = 'eq-btn primary';\r\n    saveBtn.textContent = team.pending ? 'CONFIRMAR EQUIPO' : 'GUARDAR';\r\n    const save = async () => {\r\n      const name = nameInput.value.trim();\r\n      const abbr = abbrInput.value.trim().toUpperCase();\r\n      if (!name || !abbr) {\r\n        setStatus({ kind: 'error', text: 'NOMBRE COMPLETO y ABREVIATURA son obligatorios.' });\r\n        return;\r\n      }\r\n      await saveTeam(team, {\r\n        fullName: name,\r\n        abbreviation: abbr,\r\n        visible: visibleSelect.value === 'si',\r\n        ...(crestSelect ? { crestFile: crestSelect.value } : {}),\r\n      }, `${name} GUARDADO.`, saveBtn);\r\n    };\r\n    saveBtn.addEventListener('click', save);\r\n    for (const input of [nameInput, abbrInput]) {\r\n      input.addEventListener('keydown', (e) => { if (e.key === 'Enter') save(); });\r\n    }\r\n\r\n    const meta = document.createElement('div');\r\n    meta.className = 'eq-meta';\r\n    const fileName = team.file ? decodeURIComponent(team.file.split('/').pop()) : 'sin escudo';\r\n    if (team.pending) {\r\n      const badge = document.createElement('span');\r\n      badge.className = 'eq-pending-badge';\r\n      badge.textContent = 'PENDIENTE \u2014 escudo nuevo detectado: complet\u00E1 los datos y confirm\u00E1. ';\r\n      meta.appendChild(badge);\r\n    }\r\n    meta.appendChild(document.createTextNode(`ID: ${team.id} \u00B7 Escudo: ${fileName}${team.isCustom ? ` \u00B7 Original: ${team.baseName} / ${team.baseAbbr}` : ''}`));\r\n\r\n    const nameField = field('Nombre completo', nameInput);\r\n    const abbrField = field('Abreviatura', abbrInput);\r\n    const visibleField = isGla\r\n      ? field('Visible', visibleSelect, 'Visible en los desplegables')\r\n      : field('Visible en desplegable', visibleSelect);\r\n    let handle = null;\r\n    if (isGla) {\r\n      handle = document.createElement('span');\r\n      handle.className = 'eq-handle';\r\n      handle.textContent = '\u283F';\r\n      handle.title = 'Arrastrar para ordenar';\r\n      handle.addEventListener('pointerdown', (event) => startSort(event, row));\r\n    }\r\n    let colorField = null;\r\n    // COLOR DE EQUIPO (2026-10-22, SOLO GLA): se aplica al elegirlo (no\r\n    // espera GUARDAR) y es el mismo color que recupera el Marcador.\r\n    // PERSONALIZADO (2026-10-23): paleta + HEX editable, debajo de la fila.\r\n    let customColorRow = null;\r\n    if (isGla && teamColors) {\r\n      const colorWrap = document.createElement('div');\r\n      colorWrap.className = 'eq-color';\r\n      const swatch = document.createElement('span');\r\n      swatch.className = 'eq-swatch';\r\n      const colorSelect = document.createElement('select');\r\n      colorSelect.setAttribute('aria-label', `Color, ${team.name}`);\r\n      const none = document.createElement('option');\r\n      none.value = '';\r\n      none.textContent = 'SIN ASIGNAR (gris)';\r\n      colorSelect.appendChild(none);\r\n      for (const color of TEAM_COLORS) {\r\n        const option = document.createElement('option');\r\n        option.value = color.id;\r\n        option.textContent = color.label.toUpperCase();\r\n        colorSelect.appendChild(option);\r\n      }\r\n      const custom = document.createElement('option');\r\n      custom.value = CUSTOM_COLOR_ID;\r\n      custom.textContent = 'PERSONALIZADO';\r\n      colorSelect.appendChild(custom);\r\n      const current = teamColors.get(team.id);\r\n      colorSelect.value = current.colorId || '';\r\n      // Ultimo HEX personalizado del equipo (se conserva aunque hoy use un\r\n      // predefinido); sin ninguno todavia, arranca del color que tiene.\r\n      let customHex = current.hex || colorHex(current.colorId && current.colorId !== CUSTOM_COLOR_ID ? current.colorId : 'gris');\r\n\r\n      customColorRow = document.createElement('div');\r\n      customColorRow.className = 'eq-custom-color';\r\n      const customLabel = document.createElement('span');\r\n      customLabel.textContent = 'COLOR PERSONALIZADO:';\r\n      const picker = document.createElement('input');\r\n      picker.type = 'color';\r\n      picker.setAttribute('aria-label', `Paleta, ${team.name}`);\r\n      const hexLabel = document.createElement('span');\r\n      hexLabel.textContent = 'HEX';\r\n      const hexInput = document.createElement('input');\r\n      hexInput.type = 'text';\r\n      hexInput.className = 'hex';\r\n      hexInput.maxLength = 7;\r\n      hexInput.placeholder = '#12A8E0';\r\n      hexInput.setAttribute('aria-label', `HEX, ${team.name}`);\r\n      const hexPreview = document.createElement('span');\r\n      hexPreview.className = 'eq-hex-preview';\r\n      hexPreview.title = 'Vista previa del color';\r\n      customColorRow.append(customLabel, picker, hexLabel, hexInput, hexPreview);\r\n\r\n      const paint = () => {\r\n        const isCustom = colorSelect.value === CUSTOM_COLOR_ID;\r\n        swatch.style.background = isCustom ? customHex : colorHex(colorSelect.value || 'gris');\r\n        picker.value = customHex.toLowerCase();\r\n        hexInput.value = customHex;\r\n        hexPreview.style.background = customHex;\r\n        hexInput.classList.remove('invalid');\r\n        customColorRow.hidden = !isCustom;\r\n      };\r\n      // Mientras se escribe: vista previa si el HEX ya es valido (con o sin #);\r\n      // se aplica recien con Enter o al salir del campo.\r\n      hexInput.addEventListener('input', () => {\r\n        const hex = normalizeHexColor(hexInput.value);\r\n        hexInput.classList.toggle('invalid', !hex && hexInput.value.trim() !== '');\r\n        if (hex) hexPreview.style.background = hex;\r\n      });\r\n      paint();\r\n      const applyCustom = (hex) => {\r\n        customHex = hex;\r\n        teamColors.set(team.id, CUSTOM_COLOR_ID, hex);\r\n        paint();\r\n        setStatus({ kind: 'success', text: `COLOR DE ${team.name}: PERSONALIZADO ${hex}.` });\r\n      };\r\n      colorSelect.addEventListener('change', () => {\r\n        if (colorSelect.value === CUSTOM_COLOR_ID) {\r\n          applyCustom(customHex);\r\n          return;\r\n        }\r\n        teamColors.set(team.id, colorSelect.value);\r\n        paint();\r\n        const label = TEAM_COLORS.find((c) => c.id === colorSelect.value)?.label.toUpperCase() || 'SIN ASIGNAR (gris)';\r\n        setStatus({ kind: 'success', text: `COLOR DE ${team.name}: ${label}.` });\r\n      });\r\n      // La paleta previsualiza mientras se mueve y aplica al soltar/cerrar.\r\n      picker.addEventListener('input', () => {\r\n        const hex = normalizeHexColor(picker.value);\r\n        if (!hex) return;\r\n        swatch.style.background = hex;\r\n        hexInput.value = hex;\r\n        hexPreview.style.background = hex;\r\n      });\r\n      picker.addEventListener('change', () => {\r\n        const hex = normalizeHexColor(picker.value);\r\n        if (hex) applyCustom(hex);\r\n      });\r\n      const commitHex = () => {\r\n        const hex = normalizeHexColor(hexInput.value);\r\n        if (!hex) {\r\n          hexInput.classList.add('invalid');\r\n          setStatus({ kind: 'error', text: `HEX INV\u00C1LIDO para ${team.name}: us\u00E1 #RRGGBB (ej. #12A8E0). Se conserva ${customHex}.` });\r\n          return;\r\n        }\r\n        applyCustom(hex);\r\n      };\r\n      hexInput.addEventListener('change', commitHex);\r\n      hexInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') commitHex(); });\r\n      colorWrap.append(swatch, colorSelect);\r\n      colorField = field('Color', colorWrap);\r\n    }\r\n    if (isGla) {\r\n      const options = document.createElement('div');\r\n      options.className = 'eq-options';\r\n      if (colorField) options.appendChild(colorField);\r\n      options.appendChild(visibleField);\r\n      if (crestSelect) options.appendChild(field('Escudo', crestSelect));\r\n      options.appendChild(saveBtn);\r\n      row.append(handle, crest, nameField, abbrField, options);\r\n      if (customColorRow) row.appendChild(customColorRow);\r\n      row.appendChild(meta);\r\n    } else {\r\n      row.append(crest, nameField, abbrField, visibleField, saveBtn, meta);\r\n    }\r\n\r\n    // GLA: un escudo nuevo que en realidad es de un equipo existente se\r\n    // asocia a ese equipo (no se crea un duplicado).\r\n    if (isGla && team.pending) {\r\n      const assoc = document.createElement('div');\r\n      assoc.className = 'eq-assoc';\r\n      const label = document.createElement('span');\r\n      const duplicate = TEAMS.find((t) => t.id === team.posibleDuplicadoDe);\r\n      label.textContent = duplicate\r\n        ? `\u00BFEs ${duplicate.name}? Parece el mismo equipo \u2014 en vez de crear uno nuevo, us\u00E1 este escudo para:`\r\n        : '\u00BFEs un equipo que ya existe? Us\u00E1 este escudo para:';\r\n      const teamSelect = document.createElement('select');\r\n      for (const other of TEAMS.filter((t) => !t.pending)) {\r\n        const option = document.createElement('option');\r\n        option.value = other.id;\r\n        option.textContent = other.name;\r\n        teamSelect.appendChild(option);\r\n      }\r\n      if (duplicate) teamSelect.value = duplicate.id;\r\n      const assocBtn = document.createElement('button');\r\n      assocBtn.type = 'button';\r\n      assocBtn.className = 'eq-btn';\r\n      assocBtn.textContent = 'ASOCIAR ESCUDO A ESE EQUIPO';\r\n      assocBtn.addEventListener('click', () => {\r\n        const target = TEAMS.find((t) => t.id === teamSelect.value);\r\n        if (!target) return;\r\n        saveTeam(target, { crestFile: team.ownFile }, `ESCUDO ${team.ownFile} ASOCIADO A ${target.name} (no se cre\u00F3 un equipo nuevo).`, assocBtn);\r\n      });\r\n      assoc.append(label, teamSelect, assocBtn);\r\n      row.appendChild(assoc);\r\n    }\r\n    return row;\r\n  }\r\n\r\n  renderVisiblePanel = (nextStatus) => {\r\n    status = nextStatus;\r\n    render();\r\n  };\r\n  render();\r\n  loadCrestFiles();\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/jugadores-panel.js","// JUGADORES \u2014 administraci\u00F3n de planteles (BLOQUE 3, 2026-09-09, pedido\r\n// explicito del usuario: \"UNA FUENTE CENTRAL DE JUGADORES POR EQUIPO\").\r\n// Pseudo-m\u00F3dulo (mismo patr\u00F3n que \"abreviaturas-panel.js\"): NO es una\r\n// gr\u00E1fica, no tiene TAKE/OUT/ACTUALIZAR, no vive en shared/modules.js ni\r\n// en el sistema de draft/autosave -- lee/escribe directo contra\r\n// /api/planteles/:teamId (server/playerRosters.js), la misma fuente que ya\r\n// consumen Tarjeta/Cambios/Formaci\u00F3n/Estrellas.\r\n//\r\n// Los jugadores pertenecen al EQUIPO (teamId), nunca al slot LOCAL/\r\n// VISITANTE -- este panel simplemente muestra dos columnas, una por cada\r\n// teamId actualmente elegido en el Marcador (scoreboardData.teamA/teamB),\r\n// y cada columna opera sobre el plantel de ESE equipo.\r\nimport { teamName } from '../../shared/teams.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../shared/themes.js';\r\n\r\nconst TIPO_CARGA = { MANUAL: 'manual', WEB: 'web' };\r\n\r\n// ARGENTINA STREAMERS (2026-10-08, pedido explicito del usuario): cada lado\r\n// elige su fuente (WEB = CONVOCADOS de la rama elegida / MANUAL) y la\r\n// eleccion persiste con el plantel del EQUIPO (PUT .../preferencias). Solo\r\n// los dos equipos propios tienen datos en la web; su rama por defecto sale\r\n// del equipo. GLA conserva su flujo de siempre (gla.futbol), sin cambios.\r\nconst RAMA_POR_EQUIPO = { 'argentina-streamers': 'masculino', 'argentina-streamers-fem': 'femenino' };\r\nconst RAMA_LABELS = { masculino: 'MASCULINO', femenino: 'FEMENINO' };\r\n\r\nfunction emptyRow() {\r\n  return { dorsal: '', nombre: '', apellido: '', apodo: '' };\r\n}\r\n\r\nfunction normalizeName(value) {\r\n  return String(value || '').normalize('NFD').replace(/\\p{Diacritic}/gu, '').toLowerCase().replace(/\\s+/g, ' ').trim();\r\n}\r\n\r\nfunction playerKey(jugador) {\r\n  return normalizeName(jugador.nombreCompleto || [jugador.nombre, jugador.apellido].filter(Boolean).join(' ') || jugador.apodo);\r\n}\r\n\r\n// \"CARGAR LISTA\": un jugador por linea, en orden. El numero inicial de la\r\n// linea ES EL DORSAL (2026-10-09, corregido -- pedido explicito del usuario:\r\n// \"no me tom\u00F3 las dorsales\"; antes se descartaba como numeracion de lista):\r\n// \"1- X\", \"18-X\", \"2 - X\", \"22 \u2013 X\", \"3 \u2014 X\", \"16. X\", \"21) X\", \"11 X\",\r\n// \"#10 X\", \"(10) X\". Sin numero inicial -> sin dorsal (nunca se inventa).\r\n// Vi\u00F1etas y espacios se limpian; las tildes se conservan. Primer palabra ->\r\n// nombre, resto -> apellido (editables despues como cualquier fila).\r\nconst LIST_BULLET = /^[-\u2013\u2014\u2022\u00B7*\u25AA\u25BA>]+\\s*/u;\r\nconst LIST_DORSAL = /^(?:#\\s*|\\(\\s*)?(\\d{1,3})\\s*\\)?\\s*(?:[.)\\-\u2013\u2014:\u00BA\u00B0]+\\s*|\\s+)(?=\\S)/u;\r\nexport function parsePastedList(text) {\r\n  const jugadores = [];\r\n  const avisos = [];\r\n  const seen = new Map();\r\n  for (const raw of String(text || '').split(/\\r?\\n/)) {\r\n    let line = raw.trim();\r\n    while (LIST_BULLET.test(line)) line = line.replace(LIST_BULLET, '');\r\n    let dorsal = '';\r\n    const match = line.match(LIST_DORSAL);\r\n    if (match) {\r\n      dorsal = String(Number(match[1]));\r\n      line = line.slice(match[0].length);\r\n    }\r\n    line = line.replace(/\\s+/g, ' ').trim();\r\n    if (!line || !/\\p{L}/u.test(line)) continue;\r\n    const words = line.split(' ');\r\n    const jugador = { dorsal, nombre: words[0], apellido: words.slice(1).join(' '), apodo: '' };\r\n    const key = playerKey(jugador);\r\n    if (seen.has(key)) {\r\n      if (seen.get(key).dorsal !== dorsal) avisos.push(`${line} aparece dos veces en la lista con distinto dorsal \u2014 se us\u00F3 la primera l\u00EDnea (#${seen.get(key).dorsal || 'sin dorsal'}).`);\r\n      continue;\r\n    }\r\n    seen.set(key, jugador);\r\n    jugadores.push(jugador);\r\n  }\r\n  return { jugadores, avisos };\r\n}\r\n\r\nfunction displayNameOf(jugador) {\r\n  return [jugador.nombre, jugador.apellido].filter(Boolean).join(' ') || jugador.apodo || jugador.nombreCompleto || '';\r\n}\r\n\r\n// Fusiona la lista pegada con el plantel actual (Argentina Streamers):\r\n// jugador nuevo -> se agrega al final; jugador ya cargado (mismo nombre,\r\n// sin importar mayusculas/tildes) -> solo se completa/actualiza su dorsal\r\n// (avisando si cambia uno que ya tenia), nunca se duplica. \"nombreTV\" se\r\n// descarta al cambiar el dorsal para que el servidor lo regenere (\"18. X\",\r\n// lo que leen Formacion/Tarjetas/Cambios). Dorsales repetidos entre\r\n// jugadores DISTINTOS se informan, nunca se fusionan ni se pisan.\r\nfunction mergeListaEnPlantel(draft, parsed) {\r\n  const avisos = [...parsed.avisos];\r\n  let agregados = 0;\r\n  let actualizados = 0;\r\n  const byKey = new Map(draft.map((j) => [playerKey(j), j]).filter(([key]) => key));\r\n  for (const jugador of parsed.jugadores) {\r\n    const existing = byKey.get(playerKey(jugador));\r\n    if (!existing) {\r\n      draft.push(jugador);\r\n      byKey.set(playerKey(jugador), jugador);\r\n      agregados += 1;\r\n      continue;\r\n    }\r\n    if (!jugador.dorsal || String(existing.dorsal || '').trim() === jugador.dorsal) continue;\r\n    if (String(existing.dorsal || '').trim()) {\r\n      avisos.push(`${displayNameOf(existing)}: dorsal ${existing.dorsal} reemplazado por ${jugador.dorsal} (seg\u00FAn la lista).`);\r\n    }\r\n    existing.dorsal = jugador.dorsal;\r\n    delete existing.nombreTV;\r\n    actualizados += 1;\r\n  }\r\n  const porDorsal = new Map();\r\n  for (const j of draft) {\r\n    const dorsal = String(j.dorsal || '').trim();\r\n    if (!dorsal) continue;\r\n    if (!porDorsal.has(dorsal)) porDorsal.set(dorsal, []);\r\n    porDorsal.get(dorsal).push(displayNameOf(j));\r\n  }\r\n  for (const [dorsal, nombres] of porDorsal) {\r\n    if (nombres.length > 1) avisos.push(`DORSAL ${dorsal} REPETIDO: ${nombres.join(' / ')} \u2014 revisalo.`);\r\n  }\r\n  return { agregados, actualizados, avisos };\r\n}\r\n\r\nexport function renderJugadoresPanel(container, scoreboardData) {\r\n  container.innerHTML = '';\r\n\r\n  const styleId = 'jugadores-panel-styles';\r\n  if (!document.getElementById(styleId)) {\r\n    const style = document.createElement('style');\r\n    style.id = styleId;\r\n    style.textContent = `\r\n      .jug-panel { display: flex; flex-direction: column; gap: 20px; }\r\n      .jug-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }\r\n      @media (max-width: 900px) { .jug-columns { grid-template-columns: 1fr; } }\r\n      .jug-team-box { background: #181818; border: 1px solid #333; border-radius: 6px; padding: 16px; display: flex; flex-direction: column; gap: 12px; }\r\n      .jug-team-title { font-size: 15px; font-weight: 800; color: #e5a93b; text-transform: uppercase; }\r\n      .jug-tipo-carga { display: flex; gap: 8px; }\r\n      .jug-tipo-btn { flex: 1; padding: 8px; border-radius: 4px; border: 1px solid #555; background: #222; color: #ccc; font-weight: 700; font-size: 11px; cursor: pointer; letter-spacing: 0.5px; }\r\n      .jug-tipo-btn.active { background: #e5a93b; color: #111; border-color: #e5a93b; }\r\n      .jug-row { display: grid; grid-template-columns: 56px 1fr 1fr 1fr auto; gap: 6px; align-items: center; }\r\n      .jug-row input { background: #111; border: 1px solid #444; color: #fff; padding: 6px; border-radius: 4px; font-size: 12px; }\r\n      .jug-row-remove { background: #332222; border: 1px solid #553333; color: #eaa; border-radius: 4px; padding: 6px 8px; cursor: pointer; font-size: 11px; }\r\n      .jug-actions { display: flex; gap: 8px; flex-wrap: wrap; }\r\n      .jug-btn { padding: 8px 12px; border-radius: 4px; border: 1px solid #555; background: #292929; color: #ccc; font-weight: 700; font-size: 11px; cursor: pointer; }\r\n      .jug-btn:hover { background: #383838; color: #fff; }\r\n      .jug-btn.primary { background: #e5a93b; color: #111; border: none; }\r\n      .jug-btn.primary:hover { background: #f5b94b; }\r\n      .jug-btn:disabled { opacity: 0.5; cursor: default; }\r\n      .jug-status { font-size: 11px; color: #aaa; }\r\n      .jug-status.success { color: #7ed67e; }\r\n      .jug-status.error { color: #e88; }\r\n      .jug-status.loading { color: #e5a93b; }\r\n      .jug-status.warning { color: #f0c060; }\r\n      .jug-empty { font-size: 12px; color: #888; font-style: italic; }\r\n      .jug-note { font-size: 11px; color: #888; line-height: 1.4; }\r\n      .jug-count { font-size: 11px; color: #888; }\r\n    `;\r\n    document.head.appendChild(style);\r\n  }\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'jug-panel';\r\n  container.appendChild(root);\r\n\r\n  const header = document.createElement('div');\r\n  header.className = 'abbr-header';\r\n  header.textContent = 'JUGADORES \u2014 Administraci\u00F3n de planteles';\r\n  root.appendChild(header);\r\n\r\n  const desc = document.createElement('p');\r\n  desc.className = 'jug-note';\r\n  desc.textContent = 'Fuente central de jugadores por equipo (independiente del slot LOCAL/VISITANTE): Tarjeta, Cambios, Formaci\u00F3n y Estrellas leen esta misma lista. Carg\u00E1 manualmente o desde la web y asign\u00E1 al equipo actual.';\r\n  root.appendChild(desc);\r\n\r\n  const columns = document.createElement('div');\r\n  columns.className = 'jug-columns';\r\n  root.appendChild(columns);\r\n\r\n  const isArgentina = document.body.dataset.theme === ARGENTINA_STREAMERS_THEME_ID;\r\n  const state = {\r\n    local: { tipo: TIPO_CARGA.MANUAL, rama: null, draft: [], status: null, avisos: [], loaded: false, snapshot: null, listaTexto: '' },\r\n    visitante: { tipo: TIPO_CARGA.MANUAL, rama: null, draft: [], status: null, avisos: [], loaded: false, snapshot: null, listaTexto: '' },\r\n  };\r\n\r\n  function teamIdFor(side) {\r\n    return side === 'local' ? scoreboardData?.teamA : scoreboardData?.teamB;\r\n  }\r\n\r\n  async function loadRoster(side) {\r\n    const teamId = teamIdFor(side);\r\n    if (!teamId) { state[side].loaded = true; renderColumn(side); return; }\r\n    try {\r\n      const res = await fetch(`/api/planteles/${encodeURIComponent(teamId)}`);\r\n      const body = await res.json().catch(() => null);\r\n      if (res.ok && body?.ok && body.snapshot) {\r\n        state[side].snapshot = body.snapshot;\r\n        state[side].draft = (body.snapshot.jugadores || []).map((j) => ({ ...j }));\r\n      } else {\r\n        state[side].draft = [];\r\n      }\r\n    } catch {\r\n      state[side].draft = [];\r\n    }\r\n    if (isArgentina) {\r\n      const prefs = state[side].snapshot?.preferencias || {};\r\n      state[side].tipo = prefs.modoCarga\r\n        || (state[side].snapshot?.fuente === 'argentina-streamers-web' ? TIPO_CARGA.WEB : TIPO_CARGA.MANUAL);\r\n      state[side].rama = prefs.ramaWeb || state[side].snapshot?.ramaWeb || RAMA_POR_EQUIPO[teamId] || null;\r\n    }\r\n    state[side].loaded = true;\r\n    renderColumn(side);\r\n  }\r\n\r\n  async function guardarPreferencias(side) {\r\n    const teamId = teamIdFor(side);\r\n    if (!teamId || !isArgentina) return;\r\n    try {\r\n      await fetch(`/api/planteles/${encodeURIComponent(teamId)}/preferencias`, {\r\n        method: 'PUT',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ modoCarga: state[side].tipo, ...(state[side].rama ? { ramaWeb: state[side].rama } : {}) }),\r\n      });\r\n    } catch {\r\n      // Sin red: la eleccion queda solo en pantalla hasta el proximo intento.\r\n    }\r\n  }\r\n\r\n  // \"CARGAR LISTA\" (Argentina Streamers): agrega los jugadores pegados al\r\n  // final de la lista actual (sin duplicar; a los ya cargados les completa\r\n  // el dorsal) y la guarda de inmediato.\r\n  async function importarLista(side) {\r\n    const parsed = parsePastedList(state[side].listaTexto);\r\n    const { agregados, actualizados, avisos } = mergeListaEnPlantel(state[side].draft, parsed);\r\n    state[side].avisos = avisos;\r\n    if (!agregados && !actualizados) {\r\n      state[side].status = { kind: 'error', text: 'LA LISTA NO TIENE CAMBIOS (vac\u00EDa, o esos jugadores ya est\u00E1n cargados con el mismo dorsal).' };\r\n      renderColumn(side);\r\n      return;\r\n    }\r\n    state[side].listaTexto = '';\r\n    await guardarLista(side, `LISTA IMPORTADA Y GUARDADA \u2014 ${agregados} jugador(es) nuevo(s), ${actualizados} dorsal(es) completado(s) en jugadores ya cargados`);\r\n  }\r\n\r\n  async function guardarLista(side, successText) {\r\n    const teamId = teamIdFor(side);\r\n    if (!teamId) return;\r\n    state[side].status = { kind: 'loading', text: 'Guardando...' };\r\n    renderColumn(side);\r\n    try {\r\n      const jugadores = state[side].draft.filter((j) => (j.nombre || j.apellido || j.apodo || j.nombreTV || '').trim());\r\n      const res = await fetch(`/api/planteles/${encodeURIComponent(teamId)}`, {\r\n        method: 'PUT',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ jugadores }),\r\n      });\r\n      const body = await res.json().catch(() => null);\r\n      if (!res.ok || !body?.ok) throw new Error(body?.error || `HTTP ${res.status}`);\r\n      state[side].snapshot = body.snapshot;\r\n      state[side].draft = body.snapshot.jugadores.map((j) => ({ ...j }));\r\n      state[side].status = { kind: 'success', text: successText || `LISTA GUARDADA Y ASIGNADA A ${teamName(teamId) || teamId}` };\r\n    } catch (error) {\r\n      state[side].status = { kind: 'error', text: 'ERROR AL GUARDAR', detail: error.message };\r\n    }\r\n    renderColumn(side);\r\n  }\r\n\r\n  async function sincronizarWeb(side) {\r\n    const teamId = teamIdFor(side);\r\n    if (!teamId) return;\r\n    state[side].status = { kind: 'loading', text: isArgentina ? 'Consultando CONVOCADOS en argentinastreamers.com...' : 'Sincronizando...' };\r\n    renderColumn(side);\r\n    try {\r\n      const rama = isArgentina ? state[side].rama : null;\r\n      const url = `/api/planteles/${encodeURIComponent(teamId)}/sync-web${rama ? `?rama=${encodeURIComponent(rama)}` : ''}`;\r\n      const res = await fetch(url, { method: 'POST' });\r\n      const body = await res.json().catch(() => null);\r\n      // Argentina Streamers: vacio / error / equipo sin datos web llegan con\r\n      // ok:false + mensaje y el plantel actual NO cambia (ni aca ni en el\r\n      // servidor).\r\n      if (isArgentina && body && body.ok === false && body.mensaje) {\r\n        let text = body.mensaje;\r\n        if (body.ultimoValido) {\r\n          text += ` (\u00FAltimo dato v\u00E1lido: ${body.ultimoValido.cantidad} convocados del ${new Date(body.ultimoValido.fecha).toLocaleString('es-AR', { hour12: false })})`;\r\n        }\r\n        state[side].status = { kind: 'error', text, detail: body.detalle };\r\n        renderColumn(side);\r\n        return;\r\n      }\r\n      if (!res.ok || !body?.ok) throw new Error(body?.error || `HTTP ${res.status}`);\r\n      state[side].snapshot = body.snapshot;\r\n      state[side].draft = body.snapshot.jugadores.map((j) => ({ ...j }));\r\n      const partido = body.partido ? ` \u2014 partido ${new Date(body.partido.fecha).toLocaleDateString('es-AR')} vs ${body.partido.rival}` : '';\r\n      state[side].status = {\r\n        kind: 'success',\r\n        text: isArgentina\r\n          ? `CONVOCADOS ${RAMA_LABELS[body.rama] || ''} CARGADOS (${body.snapshot.jugadores.length} jugadores${partido})`\r\n          : `PLANTEL ACTUALIZADO DESDE LA WEB (${body.snapshot.jugadores.length} jugadores)`,\r\n      };\r\n    } catch (error) {\r\n      state[side].status = {\r\n        kind: 'error',\r\n        text: isArgentina ? 'NO SE PUDO ACTUALIZAR \u2014 SE CONSERVAN LOS \u00DALTIMOS DATOS V\u00C1LIDOS' : 'NO SE PUDO OBTENER DESDE LA WEB',\r\n        detail: error.message,\r\n      };\r\n    }\r\n    renderColumn(side);\r\n  }\r\n\r\n  function renderColumn(side) {\r\n    const label = side === 'local' ? 'LOCAL' : 'VISITANTE';\r\n    const teamId = teamIdFor(side);\r\n    const name = teamName(teamId) || (teamId || 'SIN EQUIPO');\r\n    let box = columns.querySelector(`[data-side=\"${side}\"]`);\r\n    if (!box) {\r\n      box = document.createElement('div');\r\n      box.className = 'jug-team-box';\r\n      box.dataset.side = side;\r\n      columns.appendChild(box);\r\n    }\r\n    box.innerHTML = '';\r\n\r\n    const title = document.createElement('div');\r\n    title.className = 'jug-team-title';\r\n    title.textContent = `LISTA JUGADORES EQUIPO ${label} \u2014 ${name}`;\r\n    box.appendChild(title);\r\n\r\n    if (!teamId) {\r\n      const note = document.createElement('p');\r\n      note.className = 'jug-empty';\r\n      note.textContent = `Eleg\u00ED el equipo ${label} en MARCADOR para administrar su plantel.`;\r\n      box.appendChild(note);\r\n      return;\r\n    }\r\n\r\n    const tipoRow = document.createElement('div');\r\n    tipoRow.className = 'jug-tipo-carga';\r\n    for (const [tipo, label2] of [[TIPO_CARGA.MANUAL, 'CARGA MANUAL'], [TIPO_CARGA.WEB, 'CARGAR DESDE LA WEB']]) {\r\n      const btn = document.createElement('button');\r\n      btn.type = 'button';\r\n      btn.className = 'jug-tipo-btn';\r\n      btn.classList.toggle('active', state[side].tipo === tipo);\r\n      btn.textContent = label2;\r\n      btn.addEventListener('click', () => {\r\n        state[side].tipo = tipo;\r\n        state[side].status = null;\r\n        renderColumn(side);\r\n        guardarPreferencias(side);\r\n      });\r\n      tipoRow.appendChild(btn);\r\n    }\r\n    box.appendChild(tipoRow);\r\n\r\n    if (isArgentina && state[side].tipo === TIPO_CARGA.WEB) {\r\n      box.appendChild(buildArgentinaWebSection(side, teamId));\r\n    } else if (state[side].tipo === TIPO_CARGA.WEB) {\r\n      const webActions = document.createElement('div');\r\n      webActions.className = 'jug-actions';\r\n      const syncBtn = document.createElement('button');\r\n      syncBtn.type = 'button';\r\n      syncBtn.className = 'jug-btn primary';\r\n      syncBtn.textContent = 'SINCRONIZAR PLANTEL DESDE LA WEB';\r\n      syncBtn.disabled = state[side].status?.kind === 'loading';\r\n      syncBtn.addEventListener('click', () => sincronizarWeb(side));\r\n      webActions.appendChild(syncBtn);\r\n      box.appendChild(webActions);\r\n      const webNote = document.createElement('p');\r\n      webNote.className = 'jug-note';\r\n      webNote.textContent = 'Si la web no publica un plantel confiable para este equipo, se informa el error ac\u00E1 abajo -- no se inventa ning\u00FAn jugador.';\r\n      box.appendChild(webNote);\r\n    }\r\n\r\n    if (state[side].status) {\r\n      const status = document.createElement('p');\r\n      status.className = `jug-status ${state[side].status.kind}`;\r\n      status.textContent = state[side].status.text;\r\n      if (state[side].status.detail) status.title = state[side].status.detail;\r\n      box.appendChild(status);\r\n    }\r\n    for (const aviso of state[side].avisos || []) {\r\n      const warning = document.createElement('p');\r\n      warning.className = 'jug-status warning';\r\n      warning.textContent = `\u26A0 ${aviso}`;\r\n      box.appendChild(warning);\r\n    }\r\n\r\n    if (!state[side].loaded) {\r\n      const loading = document.createElement('p');\r\n      loading.className = 'jug-empty';\r\n      loading.textContent = 'Cargando plantel...';\r\n      box.appendChild(loading);\r\n      return;\r\n    }\r\n\r\n    const count = document.createElement('p');\r\n    count.className = 'jug-count';\r\n    count.textContent = `${state[side].draft.length} jugador(es) en el plantel actual de ${name}.`;\r\n    box.appendChild(count);\r\n\r\n    if (state[side].draft.length === 0) {\r\n      const empty = document.createElement('p');\r\n      empty.className = 'jug-empty';\r\n      empty.textContent = 'Sin jugadores todav\u00EDa.';\r\n      box.appendChild(empty);\r\n    }\r\n\r\n    const rowsWrap = document.createElement('div');\r\n    rowsWrap.style.display = 'flex';\r\n    rowsWrap.style.flexDirection = 'column';\r\n    rowsWrap.style.gap = '6px';\r\n    state[side].draft.forEach((jugador, index) => {\r\n      const row = document.createElement('div');\r\n      row.className = 'jug-row';\r\n\r\n      const dorsalInput = document.createElement('input');\r\n      dorsalInput.placeholder = '#';\r\n      dorsalInput.value = jugador.dorsal || '';\r\n      // Argentina Streamers: editar dorsal/nombre/apodo descarta el\r\n      // \"nombreTV\" guardado para que el servidor lo regenere al guardar\r\n      // (\"18. X\", lo que leen Formacion/Tarjetas/Cambios) -- antes quedaba\r\n      // el viejo (sin el dorsal nuevo). GLA conserva su nombreTV de siempre.\r\n      const touchName = () => { if (isArgentina) delete jugador.nombreTV; };\r\n      dorsalInput.addEventListener('input', () => { jugador.dorsal = dorsalInput.value; touchName(); });\r\n\r\n      const nombreInput = document.createElement('input');\r\n      nombreInput.placeholder = 'Nombre';\r\n      nombreInput.value = jugador.nombre || '';\r\n      nombreInput.addEventListener('input', () => { jugador.nombre = nombreInput.value; touchName(); });\r\n\r\n      const apellidoInput = document.createElement('input');\r\n      apellidoInput.placeholder = 'Apellido';\r\n      apellidoInput.value = jugador.apellido || '';\r\n      apellidoInput.addEventListener('input', () => { jugador.apellido = apellidoInput.value; touchName(); });\r\n\r\n      const apodoInput = document.createElement('input');\r\n      apodoInput.placeholder = 'Apodo / nombre TV (opcional)';\r\n      apodoInput.value = jugador.apodo || '';\r\n      apodoInput.addEventListener('input', () => { jugador.apodo = apodoInput.value; touchName(); });\r\n\r\n      const removeBtn = document.createElement('button');\r\n      removeBtn.type = 'button';\r\n      removeBtn.className = 'jug-row-remove';\r\n      removeBtn.textContent = '\u2715';\r\n      removeBtn.title = 'Eliminar jugador';\r\n      removeBtn.addEventListener('click', () => {\r\n        state[side].draft.splice(index, 1);\r\n        renderColumn(side);\r\n      });\r\n\r\n      row.append(dorsalInput, nombreInput, apellidoInput, apodoInput, removeBtn);\r\n      rowsWrap.appendChild(row);\r\n    });\r\n    box.appendChild(rowsWrap);\r\n\r\n    if (isArgentina && state[side].tipo === TIPO_CARGA.MANUAL) {\r\n      box.appendChild(buildCargarListaSection(side));\r\n    }\r\n\r\n    const actions = document.createElement('div');\r\n    actions.className = 'jug-actions';\r\n\r\n    const addBtn = document.createElement('button');\r\n    addBtn.type = 'button';\r\n    addBtn.className = 'jug-btn';\r\n    addBtn.textContent = '+ AGREGAR JUGADOR';\r\n    addBtn.addEventListener('click', () => {\r\n      state[side].draft.push(emptyRow());\r\n      renderColumn(side);\r\n      const inputs = box.querySelectorAll('.jug-row input');\r\n      inputs[inputs.length - 4]?.focus();\r\n    });\r\n    actions.appendChild(addBtn);\r\n\r\n    const saveBtn = document.createElement('button');\r\n    saveBtn.type = 'button';\r\n    saveBtn.className = 'jug-btn primary';\r\n    saveBtn.textContent = 'GUARDAR LISTA / ASIGNAR AL EQUIPO';\r\n    saveBtn.disabled = state[side].status?.kind === 'loading';\r\n    saveBtn.addEventListener('click', () => guardarLista(side));\r\n    actions.appendChild(saveBtn);\r\n\r\n    box.appendChild(actions);\r\n  }\r\n\r\n  // CARGAR DESDE LA WEB (Argentina Streamers): CONVOCADOS de la rama. Solo\r\n  // los equipos propios tienen rama (y datos) en la web; cualquier otro\r\n  // equipo informa que no hay datos y conserva su lista manual.\r\n  function buildArgentinaWebSection(side, teamId) {\r\n    const wrap = document.createElement('div');\r\n    wrap.style.display = 'flex';\r\n    wrap.style.flexDirection = 'column';\r\n    wrap.style.gap = '8px';\r\n    const hasWebData = !!RAMA_POR_EQUIPO[teamId];\r\n\r\n    if (hasWebData) {\r\n      const ramaRow = document.createElement('div');\r\n      ramaRow.className = 'jug-tipo-carga';\r\n      for (const rama of ['masculino', 'femenino']) {\r\n        const btn = document.createElement('button');\r\n        btn.type = 'button';\r\n        btn.className = 'jug-tipo-btn';\r\n        btn.classList.toggle('active', state[side].rama === rama);\r\n        btn.textContent = `CONVOCADOS ${RAMA_LABELS[rama]}`;\r\n        btn.addEventListener('click', () => {\r\n          state[side].rama = rama;\r\n          renderColumn(side);\r\n          guardarPreferencias(side);\r\n        });\r\n        ramaRow.appendChild(btn);\r\n      }\r\n      wrap.appendChild(ramaRow);\r\n    }\r\n\r\n    const actions = document.createElement('div');\r\n    actions.className = 'jug-actions';\r\n    const syncBtn = document.createElement('button');\r\n    syncBtn.type = 'button';\r\n    syncBtn.className = 'jug-btn primary';\r\n    syncBtn.textContent = 'ACTUALIZAR DATOS / CARGAR DESDE WEB';\r\n    syncBtn.disabled = state[side].status?.kind === 'loading';\r\n    syncBtn.addEventListener('click', () => sincronizarWeb(side));\r\n    actions.appendChild(syncBtn);\r\n    wrap.appendChild(actions);\r\n\r\n    const note = document.createElement('p');\r\n    note.className = 'jug-note';\r\n    note.textContent = hasWebData\r\n      ? 'Fuente: secci\u00F3n CONVOCADOS de argentinastreamers.com (rama elegida arriba). Si la web todav\u00EDa no publica convocados, la lista actual se conserva y no se inventa ning\u00FAn jugador.'\r\n      : 'NO HAY DATOS WEB PARA ESTE EQUIPO \u2014 argentinastreamers.com solo publica Argentina Streamers (masculino/femenino). Us\u00E1 CARGA MANUAL; la lista actual se conserva.';\r\n    wrap.appendChild(note);\r\n\r\n    const partido = state[side].snapshot?.partidoWeb;\r\n    if (state[side].snapshot?.fuente === 'argentina-streamers-web') {\r\n      const meta = document.createElement('p');\r\n      meta.className = 'jug-note';\r\n      const fecha = state[side].snapshot.ultimaActualizacion ? new Date(state[side].snapshot.ultimaActualizacion).toLocaleString('es-AR', { hour12: false }) : '';\r\n      meta.textContent = `Lista actual: convocados ${RAMA_LABELS[state[side].snapshot.ramaWeb] || ''}${partido ? ` del partido vs ${partido.rival}` : ''} (cargada ${fecha}).`;\r\n      wrap.appendChild(meta);\r\n    }\r\n    return wrap;\r\n  }\r\n\r\n  function buildCargarListaSection(side) {\r\n    const wrap = document.createElement('div');\r\n    wrap.style.display = 'flex';\r\n    wrap.style.flexDirection = 'column';\r\n    wrap.style.gap = '6px';\r\n    const label = document.createElement('p');\r\n    label.className = 'jug-note';\r\n    label.textContent = 'CARGAR LISTA: peg\u00E1 un jugador por l\u00EDnea; el n\u00FAmero inicial es el DORSAL (\"18- Kito Shelby\", \"16. Facu Navajas\", \"11 Ian Diaz\"). Sin n\u00FAmero se importa sin dorsal. Se agregan al final sin duplicar (a los ya cargados se les completa el dorsal) y se guardan al importar.';\r\n    const textarea = document.createElement('textarea');\r\n    textarea.rows = 5;\r\n    textarea.placeholder = '1- JUAN P\u00C9REZ\\n18-MART\u00CDN L\u00D3PEZ\\nNICOL\u00C1S G\u00D3MEZ';\r\n    textarea.value = state[side].listaTexto;\r\n    textarea.style.background = '#111';\r\n    textarea.style.border = '1px solid #444';\r\n    textarea.style.color = '#fff';\r\n    textarea.style.borderRadius = '4px';\r\n    textarea.style.padding = '6px';\r\n    textarea.style.fontSize = '12px';\r\n    textarea.addEventListener('input', () => { state[side].listaTexto = textarea.value; });\r\n    const importBtn = document.createElement('button');\r\n    importBtn.type = 'button';\r\n    importBtn.className = 'jug-btn primary';\r\n    importBtn.textContent = 'CARGAR LISTA';\r\n    importBtn.disabled = state[side].status?.kind === 'loading';\r\n    importBtn.addEventListener('click', () => importarLista(side));\r\n    const actions = document.createElement('div');\r\n    actions.className = 'jug-actions';\r\n    actions.appendChild(importBtn);\r\n    wrap.append(label, textarea, actions);\r\n    return wrap;\r\n  }\r\n\r\n  renderColumn('local');\r\n  renderColumn('visitante');\r\n  loadRoster('local');\r\n  loadRoster('visitante');\r\n\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/zocalo-escudos-panel.js","import { TEAM_OPTIONS } from '../../shared/teams.js';\r\n// EQUIPOS VISIBLES (2026-10-21, pedido explicito del usuario, SOLO GLA):\r\n// un equipo oculto en EQUIPOS no se ofrece para nuevas selecciones; el ya\r\n// elegido se sigue mostrando (ocultar no borra ni rompe estados guardados).\r\nfunction isHiddenGlaOption(opt, currentId) {\r\n  return document.body.dataset.theme === 'gla' && opt.visible === false && opt.id !== (currentId || '');\r\n}\r\n\r\nimport { renderPresetsControl } from './presets-helper.js';\r\n\r\nexport function renderZocaloEscudosPanel(container, data, onDirty) {\r\n  if (!data.escudosFuente) data.escudosFuente = 'MARCADOR';\r\n  if (data.customTeamA === undefined) data.customTeamA = '';\r\n  if (data.customTeamB === undefined) data.customTeamB = '';\r\n  if (!Array.isArray(data.shieldPresets)) data.shieldPresets = [];\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'zocalo-escudos-box';\r\n\r\n  const styleId = 'zocalo-escudos-panel-styles';\r\n  if (!document.getElementById(styleId)) {\r\n    const style = document.createElement('style');\r\n    style.id = styleId;\r\n    style.textContent = `\r\n      .zocalo-escudos-box {\r\n        background: #1e1e1e;\r\n        padding: 14px;\r\n        border: 1px solid #333;\r\n        border-radius: 6px;\r\n        margin-top: 14px;\r\n      }\r\n      .ze-title {\r\n        font-family: 'Montserrat', sans-serif;\r\n        font-size: 13px;\r\n        font-weight: 700;\r\n        color: #e5a93b;\r\n        margin: 0 0 10px 0;\r\n        text-transform: uppercase;\r\n        letter-spacing: 0.5px;\r\n      }\r\n      .ze-source-selector {\r\n        display: flex;\r\n        gap: 16px;\r\n        margin-bottom: 12px;\r\n      }\r\n      .ze-radio-label {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 6px;\r\n        font-size: 12px;\r\n        font-weight: 700;\r\n        color: #eee;\r\n        cursor: pointer;\r\n      }\r\n      .ze-custom-teams {\r\n        display: grid;\r\n        grid-template-columns: 1fr 1fr;\r\n        gap: 12px;\r\n        margin-bottom: 12px;\r\n        background: #262626;\r\n        padding: 10px;\r\n        border-radius: 4px;\r\n        border: 1px solid #444;\r\n      }\r\n      .ze-field {\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 4px;\r\n      }\r\n      .ze-field label {\r\n        font-size: 10px;\r\n        font-weight: 700;\r\n        color: #aaa;\r\n        text-transform: uppercase;\r\n      }\r\n      .ze-field select {\r\n        background: #111;\r\n        border: 1px solid #555;\r\n        color: #fff;\r\n        padding: 6px 8px;\r\n        border-radius: 4px;\r\n        font-size: 12px;\r\n        font-weight: 700;\r\n      }\r\n    `;\r\n    document.head.appendChild(style);\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n\r\n    const heading = document.createElement('div');\r\n    heading.className = 'ze-title';\r\n    heading.textContent = 'ESCUDOS';\r\n    root.appendChild(heading);\r\n\r\n    const sourceSelector = document.createElement('div');\r\n    sourceSelector.className = 'ze-source-selector';\r\n\r\n    const radioMarcadorLabel = document.createElement('label');\r\n    radioMarcadorLabel.className = 'ze-radio-label';\r\n    const radioMarcador = document.createElement('input');\r\n    radioMarcador.type = 'radio';\r\n    radioMarcador.name = 'escudosFuente';\r\n    radioMarcador.value = 'MARCADOR';\r\n    radioMarcador.checked = data.escudosFuente === 'MARCADOR';\r\n    radioMarcador.addEventListener('change', () => {\r\n      if (radioMarcador.checked) {\r\n        data.escudosFuente = 'MARCADOR';\r\n        if (onDirty) onDirty();\r\n        render();\r\n      }\r\n    });\r\n    radioMarcadorLabel.appendChild(radioMarcador);\r\n    radioMarcadorLabel.appendChild(document.createTextNode('MARCADOR'));\r\n\r\n    const radioCustomLabel = document.createElement('label');\r\n    radioCustomLabel.className = 'ze-radio-label';\r\n    const radioCustom = document.createElement('input');\r\n    radioCustom.type = 'radio';\r\n    radioCustom.name = 'escudosFuente';\r\n    radioCustom.value = 'PERSONALIZADO';\r\n    radioCustom.checked = data.escudosFuente === 'PERSONALIZADO';\r\n    radioCustom.addEventListener('change', () => {\r\n      if (radioCustom.checked) {\r\n        data.escudosFuente = 'PERSONALIZADO';\r\n        if (onDirty) onDirty();\r\n        render();\r\n      }\r\n    });\r\n    radioCustomLabel.appendChild(radioCustom);\r\n    radioCustomLabel.appendChild(document.createTextNode('PERSONALIZADO'));\r\n\r\n    sourceSelector.appendChild(radioMarcadorLabel);\r\n    sourceSelector.appendChild(radioCustomLabel);\r\n    root.appendChild(sourceSelector);\r\n\r\n    if (data.escudosFuente === 'PERSONALIZADO') {\r\n      const customWrap = document.createElement('div');\r\n      customWrap.className = 'ze-custom-teams';\r\n\r\n      const fieldA = document.createElement('div');\r\n      fieldA.className = 'ze-field';\r\n      const labelA = document.createElement('label');\r\n      labelA.textContent = 'IZQUIERDA (EQUIPO A)';\r\n      const selectA = document.createElement('select');\r\n      for (const opt of TEAM_OPTIONS) {\r\n        if (isHiddenGlaOption(opt, data.customTeamA)) continue;\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        selectA.appendChild(option);\r\n      }\r\n      selectA.value = data.customTeamA || '';\r\n      selectA.addEventListener('change', () => {\r\n        data.customTeamA = selectA.value;\r\n        if (onDirty) onDirty();\r\n      });\r\n      fieldA.appendChild(labelA);\r\n      fieldA.appendChild(selectA);\r\n\r\n      const fieldB = document.createElement('div');\r\n      fieldB.className = 'ze-field';\r\n      const labelB = document.createElement('label');\r\n      labelB.textContent = 'DERECHA (EQUIPO B)';\r\n      const selectB = document.createElement('select');\r\n      for (const opt of TEAM_OPTIONS) {\r\n        if (isHiddenGlaOption(opt, data.customTeamB)) continue;\r\n        const option = document.createElement('option');\r\n        option.value = opt.id;\r\n        option.textContent = opt.label;\r\n        selectB.appendChild(option);\r\n      }\r\n      selectB.value = data.customTeamB || '';\r\n      selectB.addEventListener('change', () => {\r\n        data.customTeamB = selectB.value;\r\n        if (onDirty) onDirty();\r\n      });\r\n      fieldB.appendChild(labelB);\r\n      fieldB.appendChild(selectB);\r\n\r\n      customWrap.appendChild(fieldA);\r\n      customWrap.appendChild(fieldB);\r\n      root.appendChild(customWrap);\r\n    }\r\n\r\n    // Presets de escudos\r\n    const presetsBox = document.createElement('div');\r\n    renderPresetsControl(presetsBox, data, {\r\n      presetKey: 'shieldPresets',\r\n      title: 'PRESETS DE ESCUDOS',\r\n      buttons: [\r\n        {\r\n          label: 'GUARDAR PRESET DE ESCUDOS',\r\n          type: 'shield',\r\n          getFields: () => ({\r\n            fuente: data.escudosFuente,\r\n            teamA: data.customTeamA,\r\n            teamB: data.customTeamB,\r\n          }),\r\n        },\r\n      ],\r\n      onApply: (fields) => {\r\n        if (fields.fuente) data.escudosFuente = fields.fuente;\r\n        if (fields.teamA !== undefined) data.customTeamA = fields.teamA;\r\n        if (fields.teamB !== undefined) data.customTeamB = fields.teamB;\r\n        render();\r\n      },\r\n      onDirty,\r\n    });\r\n    root.appendChild(presetsBox);\r\n  }\r\n\r\n  render();\r\n  container.appendChild(root);\r\n}\r\n","http://localhost:4430/master-control/js/penales-panel.js","// Panel a medida para Marcador de Penales: unico control extra que\r\n// necesita este modulo es el toggle de \"MUERTE S\u00DABITA\" (2026-08-15,\r\n// pedido explicito del usuario). No hay asset ni elemento nuevo del lado\r\n// de Program -- el renderer (program/js/renderers/marcadorPenales.js) le\r\n// agrega el texto al mismo titulo que ya existe cuando este flag esta\r\n// activo, asi que aca solo hace falta el boton.\r\nexport function renderPenalesPanel(container, data, onDirty) {\r\n  const box = document.createElement('div');\r\n  box.className = 'clock-box';\r\n\r\n  const title = document.createElement('div');\r\n  title.className = 'clock-box-title';\r\n  title.textContent = 'MUERTE S\u00DABITA';\r\n  box.appendChild(title);\r\n\r\n  const btn = document.createElement('button');\r\n  btn.type = 'button';\r\n  btn.className = data.suddenDeath ? 'btn-clock btn-clock-danger active' : 'btn-clock';\r\n  btn.textContent = data.suddenDeath ? 'MUERTE S\u00DABITA: ACTIVADA (tocar para desactivar)' : 'ACTIVAR MUERTE S\u00DABITA';\r\n  btn.addEventListener('click', () => {\r\n    data.suddenDeath = !data.suddenDeath;\r\n    btn.classList.toggle('active', data.suddenDeath);\r\n    btn.classList.toggle('btn-clock-danger', data.suddenDeath);\r\n    btn.textContent = data.suddenDeath ? 'MUERTE S\u00DABITA: ACTIVADA (tocar para desactivar)' : 'ACTIVAR MUERTE S\u00DABITA';\r\n    onDirty();\r\n  });\r\n  box.appendChild(btn);\r\n\r\n  container.appendChild(box);\r\n}\r\n","http://localhost:4430/master-control/js/actualizador-datos-panel.js","// ACTUALIZADOR DE DATOS (2026-10-21, pedido explicito del usuario, SOLO\r\n// GLA): modulo administrativo (no es una grafica: sin TAKE/OUT/PREVIEW,\r\n// mismo patron que EQUIPOS/PLANTELES). Elige de que edicion del TORNEO\r\n// toman datos los \"ACTUALIZAR DESDE WEB\" con FUENTE = TORNEO. Cambiar la\r\n// edicion solo guarda la preferencia: no actualiza ningun modulo (cada uno\r\n// se actualiza con su propio boton).\r\nimport {\r\n  getGlaTorneoEdicion, getGlaTorneoEdiciones, loadGlaTorneoEdicion, setGlaTorneoEdicion,\r\n} from './gla-torneo-source.js';\r\n\r\nconst CONSUMIDORES = 'Goleadores, Asistidores y Jugadores (con FUENTE = TORNEO), Posiciones Torneo, Grupos A/B, Resultados (fase de grupos y playoffs) y Estrellas (con FUENTE = TORNEO). Los m\u00F3dulos con FUENTE = LIGA no cambian.';\r\n\r\nexport function renderActualizadorDatosPanel(container) {\r\n  container.innerHTML = '';\r\n  const root = document.createElement('div');\r\n  root.className = 'performance-editor performance-editor--actualizador';\r\n  container.appendChild(root);\r\n\r\n  let status = null;\r\n  let verificacion = null;\r\n  let verificando = false;\r\n\r\n  async function guardar(key) {\r\n    try {\r\n      const res = await fetch('/api/gla/torneo-edicion', {\r\n        method: 'PUT',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({ key }),\r\n      });\r\n      const body = await res.json().catch(() => null);\r\n      if (!res.ok || !body?.ok) throw new Error(body?.error || `HTTP ${res.status}`);\r\n      setGlaTorneoEdicion(body.edicion);\r\n      status = { kind: 'success', text: `GUARDADO \u2014 los pr\u00F3ximos ACTUALIZAR DESDE WEB de TORNEO toman datos de ${body.edicion.label}. No se actualiz\u00F3 ning\u00FAn m\u00F3dulo todav\u00EDa.` };\r\n    } catch (error) {\r\n      status = { kind: 'error', text: `NO SE PUDO GUARDAR LA EDICI\u00D3N: ${error.message}` };\r\n    }\r\n    render();\r\n  }\r\n\r\n  async function verificar() {\r\n    verificando = true;\r\n    render();\r\n    try {\r\n      const res = await fetch('/api/gla/torneo-ediciones/verificar');\r\n      const body = await res.json().catch(() => null);\r\n      if (!res.ok || !body?.ok) throw new Error(body?.error || `HTTP ${res.status}`);\r\n      verificacion = body.ediciones;\r\n      status = null;\r\n    } catch (error) {\r\n      status = { kind: 'error', text: `NO SE PUDO CONSULTAR gla.futbol: ${error.message}` };\r\n    }\r\n    verificando = false;\r\n    render();\r\n  }\r\n\r\n  function render() {\r\n    root.innerHTML = '';\r\n    const actual = getGlaTorneoEdicion();\r\n\r\n    const desc = document.createElement('p');\r\n    desc.className = 'performance-note';\r\n    desc.textContent = `Edici\u00F3n del TORNEO de gla.futbol que usan los botones ACTUALIZAR DESDE WEB de: ${CONSUMIDORES} Cambiar la edici\u00F3n NO actualiza nada solo: despu\u00E9s actualiz\u00E1 cada m\u00F3dulo con su bot\u00F3n.`;\r\n    root.appendChild(desc);\r\n\r\n    const field = document.createElement('label');\r\n    field.className = 'field';\r\n    const label = document.createElement('span');\r\n    label.textContent = 'TORNEO / EDICI\u00D3N';\r\n    const select = document.createElement('select');\r\n    for (const edicion of getGlaTorneoEdiciones()) {\r\n      const option = document.createElement('option');\r\n      option.value = edicion.key;\r\n      option.textContent = edicion.label;\r\n      select.appendChild(option);\r\n    }\r\n    select.value = actual?.key || '';\r\n    select.disabled = !getGlaTorneoEdiciones().length;\r\n    select.addEventListener('change', () => guardar(select.value));\r\n    field.append(label, select);\r\n    root.appendChild(field);\r\n\r\n    const current = document.createElement('p');\r\n    current.className = 'performance-sync-updated-at';\r\n    current.textContent = actual ? `FUENTE ACTUAL: ${actual.label}` : 'Cargando edici\u00F3n...';\r\n    root.appendChild(current);\r\n\r\n    const row = document.createElement('div');\r\n    row.className = 'performance-sync';\r\n    const verifyBtn = document.createElement('button');\r\n    verifyBtn.type = 'button';\r\n    verifyBtn.className = 'performance-sync-btn';\r\n    verifyBtn.textContent = verificando ? 'CONSULTANDO gla.futbol...' : 'VERIFICAR EDICIONES EN LA WEB';\r\n    verifyBtn.disabled = verificando;\r\n    verifyBtn.addEventListener('click', verificar);\r\n    row.appendChild(verifyBtn);\r\n    if (status) {\r\n      const statusEl = document.createElement('span');\r\n      statusEl.className = `performance-sync-status ${status.kind}`;\r\n      statusEl.textContent = status.text;\r\n      row.appendChild(statusEl);\r\n    }\r\n    root.appendChild(row);\r\n\r\n    if (verificacion) {\r\n      const list = document.createElement('div');\r\n      list.className = 'performance-note';\r\n      for (const e of verificacion) {\r\n        const line = document.createElement('p');\r\n        line.style.margin = '4px 0';\r\n        if (!e.existe) {\r\n          line.textContent = `\u2717 ${e.label}: no existe en gla.futbol.`;\r\n        } else if (!e.publicado) {\r\n          line.textContent = `\u26A0 ${e.label} (\"${e.nombreWeb}\", estado: ${e.estado || '\u2014'}): existe pero todav\u00EDa no publica datos.`;\r\n        } else {\r\n          line.textContent = `\u2713 ${e.label} (\"${e.nombreWeb}\", estado: ${e.estado || '\u2014'}): ${e.equipos} equipos, ${e.grupos} grupos, ${e.posiciones} posiciones, ${e.goleadores} goleadores, ${e.asistidores} asistidores, ${e.partidosPlayoff} partidos de playoff.`;\r\n        }\r\n        if (e.key === actual?.key) line.style.fontWeight = '800';\r\n        list.appendChild(line);\r\n      }\r\n      root.appendChild(list);\r\n    }\r\n  }\r\n\r\n  render();\r\n  loadGlaTorneoEdicion().then(() => render());\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/zocalo-vs-panel.js","// Z\u00D3CALO VS (2026-10-09, pedido explicito del usuario, SOLO Argentina\r\n// Streamers) -- ver program/js/renderers/zocaloVs.js. Panel propio porque el\r\n// nombre de cada lado muestra en el mismo campo el nombre AUTOM\u00C1TICO del\r\n// Marcador y pasa a MANUAL apenas el operador lo edita (con un boton para\r\n// volver al automatico), algo que los campos genericos no expresan.\r\n// Equipos, escudos y goles NO se editan aca: se leen del MARCADOR PRINCIPAL.\r\nimport { crestFile, teamName } from '../../shared/teams.js';\r\n\r\nconst VARIANTES = [\r\n  { id: 'solo', label: 'SOLO (sin goles)' },\r\n  { id: 'goles', label: 'GOLES' },\r\n];\r\n\r\nconst SIDES = [\r\n  { key: 'Local', label: 'LOCAL', teamKey: 'teamA', scoreKey: 'scoreA' },\r\n  { key: 'Visitante', label: 'VISITANTE', teamKey: 'teamB', scoreKey: 'scoreB' },\r\n];\r\n\r\nexport function renderZocaloVsPanel(container, data, scoreboardData, onDirty, { onVarianteChange } = {}) {\r\n  if (data.variante !== 'goles') data.variante = 'solo';\r\n  const root = document.createElement('div');\r\n  root.className = 'performance-editor performance-editor--zocaloVs';\r\n  container.appendChild(root);\r\n\r\n  const varianteRow = document.createElement('div');\r\n  varianteRow.className = 'performance-source-tabs';\r\n  for (const { id, label } of VARIANTES) {\r\n    const btn = document.createElement('button');\r\n    btn.type = 'button';\r\n    btn.className = 'performance-sync-btn';\r\n    btn.classList.toggle('active', data.variante === id);\r\n    btn.textContent = `VARIANTE: ${label}`;\r\n    btn.addEventListener('click', () => {\r\n      if (data.variante === id) return;\r\n      data.variante = id;\r\n      onDirty();\r\n      onVarianteChange?.();\r\n    });\r\n    varianteRow.appendChild(btn);\r\n  }\r\n  root.appendChild(varianteRow);\r\n\r\n  const note = document.createElement('p');\r\n  note.className = 'performance-note';\r\n  const marcador = SIDES.map((s) => teamName(scoreboardData?.[s.teamKey]) || 'SIN EQUIPO').join(' vs ');\r\n  const goles = data.variante === 'goles' ? ` \u2014 goles ${scoreboardData?.scoreA ?? 0} - ${scoreboardData?.scoreB ?? 0}` : '';\r\n  note.textContent = `${data.variante === 'goles' ? 'Equipos, escudos y goles' : 'Equipos y escudos'} salen en vivo del MARCADOR PRINCIPAL: ${marcador}${goles}. El \"VS\" viene dibujado en el asset (se mueve con COMPOSICI\u00D3N COMPLETA).`;\r\n  root.appendChild(note);\r\n\r\n  for (const side of SIDES) {\r\n    const teamId = scoreboardData?.[side.teamKey] || '';\r\n    const autoName = teamName(teamId) || '';\r\n    const modeKey = `nombre${side.key}Mode`;\r\n    const manualKey = `nombre${side.key}Manual`;\r\n    const isManual = () => data[modeKey] === 'manual' && String(data[manualKey] || '').trim() !== '';\r\n\r\n    const field = document.createElement('div');\r\n    field.className = 'field';\r\n    const label = document.createElement('label');\r\n    const crest = crestFile(teamId);\r\n    label.textContent = `NOMBRE ${side.label} \u2014 ${teamId ? autoName : 'SIN EQUIPO EN EL MARCADOR'}`;\r\n    field.appendChild(label);\r\n\r\n    const row = document.createElement('div');\r\n    row.className = 'performance-sync';\r\n    if (crest) {\r\n      const img = document.createElement('img');\r\n      img.src = crest;\r\n      img.alt = autoName;\r\n      img.style.width = '32px';\r\n      img.style.height = '32px';\r\n      img.style.objectFit = 'contain';\r\n      row.appendChild(img);\r\n    }\r\n    const input = document.createElement('input');\r\n    input.type = 'text';\r\n    input.maxLength = 60;\r\n    input.placeholder = autoName;\r\n    input.value = isManual() ? data[manualKey] : autoName;\r\n    input.style.flex = '1';\r\n    const modeChip = document.createElement('span');\r\n    modeChip.className = 'performance-sync-status';\r\n    const autoBtn = document.createElement('button');\r\n    autoBtn.type = 'button';\r\n    autoBtn.className = 'performance-sync-btn';\r\n    autoBtn.textContent = 'USAR NOMBRE DEL MARCADOR';\r\n    const paintMode = () => {\r\n      const manual = isManual();\r\n      modeChip.textContent = manual ? 'MANUAL' : 'AUTOM\u00C1TICO';\r\n      modeChip.classList.toggle('info', !manual);\r\n      modeChip.classList.toggle('success', manual);\r\n      autoBtn.disabled = !manual;\r\n    };\r\n    // Editar el texto lo pasa a MANUAL; dejarlo igual al automatico (o\r\n    // vacio) vuelve a AUTOM\u00C1TICO, asi nunca queda \"manual\" sin querer.\r\n    input.addEventListener('input', () => {\r\n      const value = input.value;\r\n      const manual = value.trim() !== '' && value.trim() !== autoName;\r\n      data[modeKey] = manual ? 'manual' : 'auto';\r\n      data[manualKey] = manual ? value : '';\r\n      paintMode();\r\n      onDirty();\r\n    });\r\n    autoBtn.addEventListener('click', () => {\r\n      data[modeKey] = 'auto';\r\n      data[manualKey] = '';\r\n      input.value = autoName;\r\n      paintMode();\r\n      onDirty();\r\n    });\r\n    paintMode();\r\n    row.append(input, modeChip, autoBtn);\r\n    field.appendChild(row);\r\n    root.appendChild(field);\r\n  }\r\n\r\n  return () => {};\r\n}\r\n","http://localhost:4430/master-control/js/gla-torneo-source.js","// ACTUALIZADOR DE DATOS (2026-10-21, pedido explicito del usuario, SOLO\r\n// GLA): edicion central del TORNEO de la que toman datos los \"ACTUALIZAR\r\n// DESDE WEB\" con FUENTE = TORNEO (ver getTorneoEdicion en\r\n// server/glaFutbolClient.js). Este modulo solo guarda en el navegador la\r\n// edicion vigente (GET al abrir Master Control + broadcast\r\n// \"GLA_TORNEO_EDICION_UPDATE\" cuando cambia) para mostrarla en cada panel\r\n// -- la fuente de verdad es el servidor.\r\nlet current = null; // { key, label, numero }\r\nlet ediciones = [];\r\nconst listeners = new Set();\r\n\r\nexport function getGlaTorneoEdicion() {\r\n  return current;\r\n}\r\n\r\nexport function getGlaTorneoEdiciones() {\r\n  return ediciones;\r\n}\r\n\r\nexport function setGlaTorneoEdicion(edicion, list) {\r\n  if (edicion) current = edicion;\r\n  if (Array.isArray(list)) ediciones = list;\r\n  for (const listener of [...listeners]) listener(current);\r\n}\r\n\r\nexport async function loadGlaTorneoEdicion() {\r\n  try {\r\n    const res = await fetch('/api/gla/torneo-edicion');\r\n    const body = await res.json();\r\n    if (body?.ok) setGlaTorneoEdicion(body.edicion, body.ediciones);\r\n  } catch {\r\n    // Sin red: los paneles muestran \"cargando\" hasta el proximo intento.\r\n  }\r\n  return current;\r\n}\r\n\r\nexport function glaTorneoLabel() {\r\n  return current ? current.label : 'edici\u00F3n del torneo (cargando...)';\r\n}\r\n\r\n// Leyenda discreta \"FUENTE ACTUAL: GLA REL\u00C1MPAGO #N\" junto al boton de\r\n// actualizar; se repinta sola si otra pesta\u00F1a cambia la edicion.\r\nexport function createGlaTorneoSourceNote() {\r\n  const el = document.createElement('span');\r\n  el.className = 'performance-sync-updated-at gla-torneo-source';\r\n  const paint = () => { el.textContent = `FUENTE ACTUAL: ${glaTorneoLabel()}`; };\r\n  const listener = () => {\r\n    if (!el.isConnected) {\r\n      listeners.delete(listener);\r\n      return;\r\n    }\r\n    paint();\r\n  };\r\n  paint();\r\n  listeners.add(listener);\r\n  return el;\r\n}\r\n","http://localhost:4430/shared/teams.js","// Catalogo global de equipos \u2014 unica fuente de verdad para nombre\r\n// completo, abreviatura de 3 letras y escudo, compartida por Master\r\n// Control y Program. Se construye solo (GET /api/teams, ver\r\n// server/teams.js) a partir de assets/crests/: cada archivo de escudo ahi\r\n// adentro ES un equipo. Agregar uno nuevo = copiar el .png en esa carpeta;\r\n// no hay ninguna lista para mantener a mano en el codigo.\r\n//\r\n// El \"top-level await\" hace que cualquier modulo que importe de aca\r\n// (directo o indirecto, ej. shared/modules.js) espere a que el catalogo\r\n// este cargado antes de seguir evaluandose \u2014 asi el resto del sistema\r\n// puede usar TEAMS/TEAM_OPTIONS de forma sincronica, sin tener que\r\n// convertir cada renderer en async.\r\n// Este archivo lo importan tanto el navegador (Master Control/Program)\r\n// como, indirectamente, \"server/index.js\" (que importa shared/modules.js\r\n// para validar MODULE_IDS por WebSocket) \u2014 en Node no hay \"fetch\" a una\r\n// URL relativa ni servidor HTTP levantado todavia en este punto (se\r\n// romperia en un ciclo: el server necesita evaluar este modulo para\r\n// terminar de arrancar). Se detecta el entorno y en Node se lee el\r\n// catalogo directo del filesystem, reutilizando la misma logica que\r\n// expone GET /api/teams (server/teams.js) \u2014 una sola fuente de verdad\r\n// para la derivacion de nombre/abreviatura, sin duplicarla aca.\r\nlet teams = [];\r\nif (typeof window === 'undefined') {\r\n  try {\r\n    const { getTeamCatalog } = await import('../server/teams.js');\r\n    teams = getTeamCatalog();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo leer el catalogo de equipos (Node):', err);\r\n  }\r\n} else {\r\n  try {\r\n    const res = await fetch('/api/teams');\r\n    teams = await res.json();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo cargar el catalogo de equipos:', err);\r\n  }\r\n}\r\n\r\nexport const TEAMS = teams;\r\n\r\n// \"visible\" (2026-09-26, pedido explicito del usuario: MOSTRAR/OCULTAR\r\n// EQUIPOS del catalogo GLA sin borrarlos): pasa derecho el flag que ya\r\n// entrega server/teams.js -- \"Sin equipo\" nunca se oculta. Quien RENDERIZA\r\n// el <select> (ver field-editors.js) es responsable de saltear una opcion\r\n// con \"visible:false\", salvo que sea el valor YA seleccionado (para no\r\n// romper un estado guardado que eligio un equipo despues ocultado) -- este\r\n// archivo solo transporta el dato, no decide la UI.\r\nexport const TEAM_OPTIONS = [\r\n  { id: '', label: 'Sin equipo', visible: true },\r\n  ...teams.map((t) => ({ id: t.id, label: t.name, visible: t.visible !== false })),\r\n];\r\n\r\nexport function updateLocalTeamCatalog(newCatalog) {\r\n  if (!Array.isArray(newCatalog)) return;\r\n  teams.length = 0;\r\n  teams.push(...newCatalog);\r\n  TEAM_OPTIONS.length = 0;\r\n  TEAM_OPTIONS.push({ id: '', label: 'Sin equipo', visible: true });\r\n  for (const t of teams) {\r\n    TEAM_OPTIONS.push({ id: t.id, label: t.name, visible: t.visible !== false });\r\n  }\r\n}\r\n\r\nfunction findTeam(id) {\r\n  return teams.find((t) => t.id === id);\r\n}\r\n\r\n// Nombre \"crestFile\" a proposito igual al de shared/team-crests.js (que\r\n// este modulo reemplaza) \u2014 mismo signature, para que los renderers que ya\r\n// lo usaban solo tengan que cambiar el import, no la logica interna.\r\nexport function crestFile(id) {\r\n  return findTeam(id)?.file;\r\n}\r\n\r\nexport function teamAbbr(id) {\r\n  return findTeam(id)?.abbr || '';\r\n}\r\n\r\nexport function teamName(id) {\r\n  return findTeam(id)?.name || '';\r\n}\r\n\r\n","http://localhost:4430/shared/team-colors.js","// Catalogo de colores de uniforme disponibles para diferenciar equipos en el\r\n// Marcador (circulo de color junto al nombre). Compartido entre Master\r\n// Control (opciones del select) y Program (color real del circulo).\r\n\r\nexport const TEAM_COLORS = [\r\n  { id: 'rojo', label: 'Rojo', hex: '#E13A3A' },\r\n  { id: 'azul', label: 'Azul', hex: '#2159C7' },\r\n  { id: 'verde', label: 'Verde', hex: '#1FA24A' },\r\n  { id: 'amarillo', label: 'Amarillo', hex: '#F0C419' },\r\n  { id: 'negro', label: 'Negro', hex: '#141416' },\r\n  { id: 'blanco', label: 'Blanco', hex: '#F5F5F1' },\r\n  { id: 'dorado', label: 'Dorado', hex: '#E3B23C' },\r\n  { id: 'naranja', label: 'Naranja', hex: '#EF7D1A' },\r\n  { id: 'violeta', label: 'Violeta', hex: '#7B3FE4' },\r\n  { id: 'celeste', label: 'Celeste', hex: '#3FB6E8' },\r\n  { id: 'gris', label: 'Gris', hex: '#9A9A9A' },\r\n];\r\n\r\nexport function colorHex(id) {\r\n  const found = TEAM_COLORS.find((c) => c.id === id);\r\n  return found ? found.hex : '#6b6b68';\r\n}\r\n\r\n// COLOR PERSONALIZADO (2026-10-23, pedido explicito del usuario, GLA):\r\n// \"teamColorAssignments[teamId] = 'personalizado'\" + el HEX exacto en\r\n// \"teamColorCustomHex[teamId]\" (mismo dato del Marcador, ver\r\n// master-control/js/main.js). El HEX se conserva aunque el equipo vuelva a\r\n// un color predefinido, para recuperarlo al elegir PERSONALIZADO otra vez.\r\nexport const CUSTOM_COLOR_ID = 'personalizado';\r\n\r\n// \"#RGB\"/\"#RRGGBB\" (con o sin \"#\") -> \"#RRGGBB\" en mayusculas; null si no\r\n// es un hexadecimal valido.\r\nexport function normalizeHexColor(value) {\r\n  const raw = String(value ?? '').trim().replace(/^#/, '');\r\n  if (/^[0-9a-f]{3}$/i.test(raw)) return `#${raw.split('').map((c) => c + c).join('')}`.toUpperCase();\r\n  if (/^[0-9a-f]{6}$/i.test(raw)) return `#${raw}`.toUpperCase();\r\n  return null;\r\n}\r\n\r\n// Color real de un lado del Marcador ('A' local / 'B' visitante): el\r\n// predefinido por id, o el HEX personalizado de ese equipo. Un HEX\r\n// invalido o ausente cae al gris (nunca rompe el render).\r\nexport function teamColorHex(scoreboard, side) {\r\n  const colorId = side === 'B' ? scoreboard?.teamBColor : scoreboard?.teamAColor;\r\n  if (colorId !== CUSTOM_COLOR_ID) return colorHex(colorId);\r\n  const teamId = side === 'B' ? scoreboard?.teamB : scoreboard?.teamA;\r\n  return normalizeHexColor(scoreboard?.teamColorCustomHex?.[teamId]) || colorHex('gris');\r\n}\r\n","http://localhost:4430/shared/themes.js","// REGISTRO DE THEMES (2026-08-20, pedido expl\u00EDcito: \"preparar el proyecto\r\n// para que deje de estar atado exclusivamente a GLA\"). Este archivo es el\r\n// \u00DANICO lugar que sabe qu\u00E9 asset le corresponde a cada m\u00F3dulo seg\u00FAn el\r\n// theme activo -- la idea es que en vez de \"if GLA... if Argentina...\"\r\n// repartido en 25 renderers, cada renderer pueda preguntar\r\n// \"getThemeAsset(themeId, moduleId)\" y listo.\r\n//\r\n// 2026-08-21, ETAPA 2 (pedido expl\u00EDcito: \"no quiero solamente un\r\n// placeholder... quiero ARGENTINA STREAMERS OPERATIVO AHORA\"): los\r\n// renderers de Program YA consumen este manifest v\u00EDa\r\n// program/js/theme-assets.js -- para GLA siguen usando su constante\r\n// hardcodeada de siempre como fuente de verdad (nunca el manifest, ver\r\n// esa raz\u00F3n en theme-assets.js), as\u00ED que esto no cambia nada de lo que\r\n// ya se ve\u00EDa. Para cualquier theme que NO sea GLA, \"video\"/\"image\" en\r\n// null significa literalmente \"todav\u00EDa no hay archivo\" -- Program\r\n// entonces NO monta ninguna capa de video/imagen para ese m\u00F3dulo y\r\n// renderiza solo el contenido din\u00E1mico (texto/escudos/n\u00FAmeros) sobre\r\n// transparencia. Ver docs/THEMES.md para el detalle completo.\r\n//\r\n// LIVE GRAPHICS (el software) -> THEME seleccionado -> assets\r\n// correspondientes. \"GLA\" ac\u00E1 es pura y exclusivamente un THEME/\r\n// competencia (Gran Liga Rel\u00E1mpago) -- nada de esto reemplaza gla.futbol,\r\n// los m\u00F3dulos de datos GLA, ni ning\u00FAn identificador interno existente.\r\n\r\nexport const DEFAULT_THEME_ID = 'gla';\r\nexport const ARGENTINA_STREAMERS_THEME_ID = 'argentinaStreamers';\r\n\r\n// Cat\u00E1logo de m\u00F3dulos con asset gr\u00E1fico propio (pedido expl\u00EDcito, secci\u00F3n\r\n// 12) -- nombres DESCRIPTIVOS de referencia; la clave real que usa cada\r\n// entrada de \"assets\" abajo es el MODULE_ID real de shared/modules.js.\r\nexport const THEME_ASSET_MODULES = [\r\n  { key: 'scoreboard', label: 'Marcador' },\r\n  { key: 'marcadorTiempoAdicional', label: 'Tiempo adicional' },\r\n  { key: 'marcadorEntretiempo', label: 'Entretiempo' },\r\n  { key: 'marcadorPenales', label: 'Penales' },\r\n  { key: 'marcadorZocalo', label: 'Marcador Z\u00F3calo' },\r\n  { key: 'tarjeta', label: 'Tarjetas' },\r\n  { key: 'cambios', label: 'Cambios' },\r\n  { key: 'gol', label: 'Gol' },\r\n  { key: 'varCheck', label: 'VAR' },\r\n  { key: 'varCheckMotivo', label: 'VAR Motivo (z\u00F3calo corto)' },\r\n  { key: 'replay', label: 'Replay' },\r\n  { key: 'bug', label: 'Mosca' },\r\n  { key: 'longDouble', label: 'Z\u00F3calo largo doble' },\r\n  { key: 'shortSimple', label: 'Z\u00F3calo corto simple' },\r\n  { key: 'shortDouble', label: 'Z\u00F3calo corto doble' },\r\n  { key: 'zocaloCompuesto', label: 'Z\u00F3calo compuesto' },\r\n  { key: 'zocaloCompuestoEquipos', label: 'Z\u00F3calo compuesto con equipos' },\r\n  { key: 'zocaloCompuestoLogo', label: 'Z\u00F3calo compuesto con logo' },\r\n  { key: 'zocaloFinal', label: 'Z\u00F3calo final' },\r\n  { key: 'zocaloFinalDiv', label: 'Z\u00F3calo final con equipos' },\r\n  { key: 'vs', label: 'VS' },\r\n  { key: 'zocaloVs', label: 'Z\u00F3calo VS' },\r\n  { key: 'vsPrepartido', label: 'VS Prepartido' },\r\n  { key: 'vsResultado', label: 'VS con resultado' },\r\n  { key: 'formacionEquipos', label: 'Formaciones' },\r\n  { key: 'estrellas', label: 'Estrellas' },\r\n  { key: 'grupos', label: 'Grupos' },\r\n  { key: 'goleadores', label: 'Goleadores' },\r\n  { key: 'asistidores', label: 'Asistidores' },\r\n  { key: 'jugadores', label: 'Mejores jugadores' },\r\n  { key: 'fichaJugador', label: 'Ficha Jugador' },\r\n  // \"cronogramaHoy\"/\"resultadosParciales\"/\"historial\" (2026-09-02):\r\n  // modulos de BRACKETS entregados por un agente concurrente -- ver\r\n  // docs/PATCH_SHARED_CLAUDE.md (handoff recibido) y\r\n  // docs/BRACKETS_ARGENTINA_STREAMERS.md. Integrados tal cual pidio el\r\n  // patch, sin tocar su logica/renderer/panel.\r\n  { key: 'cronogramaHoy', label: 'Cronograma Hoy' },\r\n  { key: 'resultadosParciales', label: 'Resultados Parciales' },\r\n  { key: 'historial', label: 'Historial' },\r\n  { key: 'sitioWebPromoL', label: 'Sitio Web Promo L' },\r\n  { key: 'sideTable', label: 'Resultados' },\r\n  { key: 'posiciones', label: 'Posiciones' },\r\n  { key: 'posicionesTorneo', label: 'Posiciones (Torneo)' },\r\n  { key: 'sponsors', label: 'Sponsors' },\r\n];\r\n\r\nexport const THEMES = {\r\n  gla: {\r\n    id: 'gla',\r\n    name: 'GRAN LIGA REL\u00C1MPAGO',\r\n    shortName: 'GLA',\r\n    // \"ready: true\" -- este theme ya tiene TODOS sus assets reales\r\n    // (los mismos que el proyecto usa hoy, sin ning\u00FAn cambio).\r\n    ready: true,\r\n    // Fuente de datos externa asociada a este theme (secci\u00F3n 10):\r\n    // gla.futbol pertenece EXCLUSIVAMENTE a este theme.\r\n    dataSource: 'gla-futbol',\r\n    // SOFTX (2026-10-29): las rutas reales de GLA viven SOLO en el registro\r\n    // central shared/asset-registry.js (RECURSO GR\u00C1FICO) y los renderers las\r\n    // leen de ah\u00ED. Ac\u00E1 queda \u00FAnicamente el estado \"ready\" por m\u00F3dulo que usa\r\n    // el indicador de asset pendiente de Master Control (getModuleAssetStatus).\r\n    assets: Object.fromEntries([\r\n      'scoreboard', 'marcadorTiempoAdicional', 'marcadorEntretiempo', 'marcadorPenales', 'marcadorZocalo', 'tarjeta', 'cambios', 'gol', 'varCheck', 'replay', 'bug', 'longDouble', 'shortSimple', 'shortDouble', 'zocaloCompuesto', 'zocaloCompuestoEquipos', 'zocaloCompuestoLogo', 'zocaloFinal', 'zocaloFinalDiv', 'vs', 'vsPrepartido', 'vsResultado', 'formacionEquipos', 'estrellas', 'grupos', 'goleadores', 'asistidores', 'jugadores', 'sideTable', 'posiciones', 'posicionesTorneo', 'sponsors',\r\n    ].map((moduleId) => [moduleId, { status: 'ready' }])),\r\n  },\r\n\r\n  argentinaStreamers: {\r\n    id: 'argentinaStreamers',\r\n    name: 'ARGENTINA STREAMERS',\r\n    shortName: 'AR STREAMERS',\r\n    // \"ready: false\" -- ning\u00FAn m\u00F3dulo tiene TODAV\u00CDA su asset gr\u00E1fico\r\n    // definitivo (pedido expl\u00EDcito: \"NO inventes, copies ni reemplaces\r\n    // assets del nuevo theme\"). Esto ya NO bloquea nada -- ni TAKE, ni\r\n    // Program, ni la l\u00F3gica de ning\u00FAn m\u00F3dulo (pedido expl\u00EDcito, etapa 2)\r\n    // -- solo controla el banner informativo \"ASSETS PENDIENTES\" de\r\n    // Master Control. Cada m\u00F3dulo de \"assets\" abajo tiene adem\u00E1s su\r\n    // propio \"status\" individual para el indicador por-m\u00F3dulo.\r\n    // \"ready: true\" (2026-10-09, pedido explicito del usuario: \"Argentina\r\n    // Streamers ya est\u00E1 operativo, no quiero ver m\u00E1s el cartel THEME EN\r\n    // PREPARACI\u00D3N\") -- los avisos por-m\u00F3dulo (\"status\") no cambian.\r\n    ready: true,\r\n    // Sin integraci\u00F3n externa todav\u00EDa -- decisi\u00F3n futura (secci\u00F3n 10,\r\n    // pedido expl\u00EDcito: \"por ahora MANUAL\").\r\n    dataSource: 'manual',\r\n    // Paleta CELESTE + BLANCO (secci\u00F3n 1, pedido expl\u00EDcito) -- fuente de\r\n    // verdad \u00FAnica de los 3 colores pedidos; master-control/css/master.css\r\n    // los usa v\u00EDa \"data-theme\" + variables CSS, no duplica los hex.\r\n    palette: {\r\n      primary: '#6ECBF5',   // celeste principal\r\n      accent: '#209DDB',    // azul complementario\r\n      base: '#FFFFFF',      // blanco\r\n    },\r\n    // Equipos iniciales para este theme (secci\u00F3n 9 del pedido, ejemplo\r\n    // concreto dado: \"ARGENTINA STREAMERS vs PER\u00DA CREADORES\"). Escudos\r\n    // reales cargados 2026-08-31 (pedido expl\u00EDcito del usuario, \"carga de\r\n    // escudos\") en assets/themes/argentina-streamers/escudos/ -- los\r\n    // renderers ya sab\u00EDan mostrar un equipo sin escudo mientras \"file\" era\r\n    // null (ver \"setCrest()\" en program/js/renderers/scoreboard.js, sin\r\n    // cambios). Cat\u00E1logo SEPARADO del de GLA (server/teams.js lo resuelve\r\n    // por theme) -- agregar equipos ac\u00E1 nunca aparece en el selector de\r\n    // equipos de GLA ni al rev\u00E9s.\r\n    teams: [\r\n      { id: 'argentina-streamers', name: 'Argentina Streamers', abbr: 'ARG', file: '/assets/themes/argentina-streamers/escudos/argentina-streamers.png' },\r\n      { id: 'peru-creadores', name: 'Per\u00FA Creadores', abbr: 'PER', file: '/assets/themes/argentina-streamers/escudos/peru-creadores.png' },\r\n      // \"oxen\" y \"argentina-streamers-fem\": 2 equipos mas (pedido\r\n      // explicito, 2026-09-01) con sus escudos reales ya en\r\n      // assets/themes/argentina-streamers/escudos/. \"ARF\" (no \"ARG\") para\r\n      // que no choque con el abbr del equipo masculino de arriba -- misma\r\n      // convencion de 3 letras que server/teams.js, con override manual\r\n      // (igual que los \"overrides puntuales\" que ya usa ese archivo para\r\n      // los equipos de GLA) porque la derivacion automatica de las 2\r\n      // primeras palabras de \"Argentina Streamers FEM\" tambien da \"ARG\".\r\n      { id: 'oxen', name: 'OXEN', abbr: 'OXE', file: '/assets/themes/argentina-streamers/escudos/oxen.png' },\r\n      { id: 'argentina-streamers-fem', name: 'Argentina Streamers FEM', abbr: 'ARF', file: '/assets/themes/argentina-streamers/escudos/argentina-streamers-fem.png' },\r\n      // Argentina Senior (2026-09-04, pedido explicito del usuario): escudo\r\n      // extraido del PDF vectorial entregado en \"cosas sueltas/\" (nunca\r\n      // usado directo en runtime -- exportado una vez a PNG transparente,\r\n      // recorte ajustado al bounding box real del arte via analisis de\r\n      // canal alfa, misma carpeta que el resto de escudos AS). \"LSF\" es la\r\n      // abreviatura pedida explicitamente (no derivada del logo).\r\n      { id: 'argentina-senior', name: 'ARGENTINA SENIOR', abbr: 'LSF', file: '/assets/themes/argentina-streamers/escudos/argentina-senior.png' },\r\n    ],\r\n    // Un objeto por cada m\u00F3dulo de THEME_ASSET_MODULES, generado ac\u00E1 mismo\r\n    // (no a mano) para garantizar que NINGUNO quede afuera -- \"video\"/\r\n    // \"image\" en null = \"status: pending\". Los m\u00F3dulos que ya recibieron su\r\n    // asset real (2026-08-28, primera entrega del dise\u00F1ador -- carpeta\r\n    // \"ARGENTINA STREAMERS VS PERU CREADORES 5/9\") pisan ese default m\u00E1s\r\n    // abajo: sin \"status\" expl\u00EDcito, \"getModuleAssetStatus()\" infiere\r\n    // 'ready' solo con que haya un video/image real, mismo criterio que\r\n    // GLA. Cuando llegue el resto, el mismo patr\u00F3n (copiar archivo ac\u00E1 +\r\n    // agregar una l\u00EDnea abajo) alcanza -- nada de c\u00F3digo nuevo.\r\n    assets: {\r\n      ...Object.fromEntries(THEME_ASSET_MODULES.map(({ key }) => [\r\n        key,\r\n        { video: null, image: null, status: 'pending' },\r\n      ])),\r\n      scoreboard: { video: '/assets/themes/argentina-streamers/marcador/scoreboard-alpha.mp4' },\r\n      marcadorPenales: { video: '/assets/themes/argentina-streamers/marcador/marcador-penales-alpha.mp4' },\r\n      marcadorTiempoAdicional: { image: '/assets/themes/argentina-streamers/marcador/marcador-tiempo-adicional.png' },\r\n      // ACTUALIZADO (2026-09-04, pedido explicito del usuario): el PNG que\r\n      // vivia aca (\"marcador-entretiempo.png\", entregado 2026-09-01) en\r\n      // realidad no era el asset correcto de ESTE modulo -- el usuario\r\n      // aviso explicitamente \"no lo confundas con el asset que ya\r\n      // identificamos como de MARCADOR Z\u00D3CALO\" (ver esa entrada, unas\r\n      // lineas abajo, que sigue usando ese archivo viejo sin tocarse).\r\n      // Este es el PNG real de Entretiempo (\"ENTRETIEMPO_FINAL2.png\" en\r\n      // cosas sueltas/), archivo PROPIO (nunca compartido con Z\u00F3calo) para\r\n      // que un futuro cambio de uno no afecte al otro por accidente.\r\n      marcadorEntretiempo: { image: '/assets/themes/argentina-streamers/marcador/entretiempo.png' },\r\n      // \"marcadorZocalo\" (2026-09-04, correccion explicita del usuario: \"el\r\n      // error fue mio con el nombre\") no tenia entrada propia aca -- quedaba\r\n      // sin asset (solo texto/reloj flotando). Sigue usando el PNG viejo de\r\n      // arriba (el que en su momento se identifico, erroneamente, como\r\n      // \"ENTRETIEMPO\") -- ese dise\u00F1o SI es el correcto para Z\u00F3calo, no se\r\n      // toca.\r\n      marcadorZocalo: { image: '/assets/themes/argentina-streamers/marcador/marcador-entretiempo.png' },\r\n      gol: { video: '/assets/themes/argentina-streamers/incidencias/gol-alpha.mp4' },\r\n      cambios: { video: '/assets/themes/argentina-streamers/incidencias/cambios-alpha.mp4' },\r\n      tarjeta: {\r\n        video: '/assets/themes/argentina-streamers/incidencias/tarjeta-amarilla-alpha.mp4',\r\n        variants: {\r\n          amarilla: '/assets/themes/argentina-streamers/incidencias/tarjeta-amarilla-alpha.mp4',\r\n          roja: '/assets/themes/argentina-streamers/incidencias/tarjeta-roja-alpha.mp4',\r\n          azul: '/assets/themes/argentina-streamers/incidencias/tarjeta-azul-alpha.mp4',\r\n        },\r\n      },\r\n      varCheck: { video: '/assets/themes/argentina-streamers/var-replay/var-chequeo-alpha.mp4' },\r\n      varCheckMotivo: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-corto-doble-alpha.mp4' },\r\n      replay: { video: '/assets/themes/argentina-streamers/var-replay/replay-sponsor-alpha.mp4' },\r\n      bug: { video: '/assets/themes/argentina-streamers/mosca/mosca-localstrike-alpha.mp4' },\r\n      shortSimple: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-corto-simple-alpha.mp4' },\r\n      shortDouble: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-corto-doble-alpha.mp4' },\r\n      longDouble: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-largo-doble-alpha.mp4' },\r\n      // Zocalo Compuesto: UN solo modulo con 2 variantes por \"tipo\" (ver\r\n      // data.tipo en program/js/renderers/zocaloCompuesto.js, logica ya\r\n      // existente sin cambios) -- \"logo\" deja el area de logo vacia por\r\n      // ahora (llega despues), \"equipos\" hereda escudos LOCAL/VISITANTE en\r\n      // vivo del Marcador (mismo patron que tarjeta/cambios).\r\n      // CORRECCION (2026-09-01, mismo dia -- el usuario aviso que la\r\n      // primera entrega/asignacion estaba mal por una confusion suya): los\r\n      // assets REALES son \"ZOCALO_LARGO.mov\" (sin division, para \"logo\")\r\n      // y \"ZOCALO_LARGO_linea.mov\" (con la linea divisoria del lado\r\n      // izquierdo, para \"equipos\") -- confirmado por INSPECCION VISUAL\r\n      // real de un frame de cada uno (ffmpeg), no por nombre de archivo:\r\n      // \"_linea\" es, literamente, el unico de los dos con una linea\r\n      // blanca vertical separando la zona de escudos del resto del\r\n      // zocalo. Los .mov de la entrega anterior (derivados de\r\n      // ZOCALO_VS/ZOCALO_VS_V2) quedaron archivados en\r\n      // ai-gfx/argentina-streamers/unused/ -- ya NO son el asset activo.\r\n      // NOTA (2026-09-01): los .mov entregados eran ProRes 4444 (canal alfa\r\n      // real, \"yuva444p12le\") -- ningun navegador/Chromium (ni el Program\r\n      // real dentro de vMix) puede decodificar ese codec (confirmado en\r\n      // vivo: video.error.message = \"DEMUXER_ERROR_NO_SUPPORTED_STREAMS\").\r\n      // Transcodificados UNA vez a .mp4 H.264 apilado color+alfa (mismo\r\n      // formato que usa el resto del proyecto -- ver el comentario de\r\n      // cabecera de program/js/alpha-video.js, que documenta este mismo\r\n      // pipeline como el estandar ya usado en todo el proyecto). Mismo\r\n      // contenido visual, sin recortes ni ediciones -- solo cambia el\r\n      // contenedor/codec para que sea reproducible. Los .mov originales NO\r\n      // se borraron: quedan archivados en\r\n      // ai-gfx/argentina-streamers/prores-originals/ (fuera de git, ver\r\n      // .gitignore) por si hace falta re-transcodificar con otros ajustes.\r\n      zocaloCompuesto: {\r\n        variants: {\r\n          logo: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4',\r\n          equipos: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-equipos-alpha.mp4',\r\n        },\r\n      },\r\n      zocaloCompuestoEquipos: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-equipos-alpha.mp4' },\r\n      // Z\u00D3CALO VS (2026-10-09): \"cosas sueltas/zocalos_vs_solo.mov\" y\r\n      // \"zocalos_vs_goles.mov\" (ProRes 4444 con alfa, 1920x1080, 30fps, 6s),\r\n      // identificados por contenido (pastilla VS angosta / ancha con lugar\r\n      // para goles) y transcodificados con la receta de siempre (color +\r\n      // alfa apilados, H.264). \"video\" = variante por defecto.\r\n      zocaloVs: {\r\n        video: '/assets/themes/argentina-streamers/zocalos/zocalo-vs-solo-alpha.mp4',\r\n        variants: {\r\n          solo: '/assets/themes/argentina-streamers/zocalos/zocalo-vs-solo-alpha.mp4',\r\n          goles: '/assets/themes/argentina-streamers/zocalos/zocalo-vs-goles-alpha.mp4',\r\n        },\r\n      },\r\n      zocaloCompuestoLogo: {\r\n        video: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4',\r\n        image: '/assets/themes/argentina-streamers/zocalos/logo-localstrike.png'\r\n      },\r\n      // VS Prepartido/Resultado (2026-09-01): los 2 assets estaban\r\n      // CRUZADOS -- el que hoy vivia ac\u00E1 como \"vsPrepartido\" en realidad\r\n      // tenia el recuadro verde de resultado (confirmado por inspeccion\r\n      // real de frames con ffmpeg, no por nombre de archivo). Corregido:\r\n      // \"vs-prepartido-alpha.mov\" (sin recuadro verde, del ZIP) es el\r\n      // Prepartido real; el .mp4 que estaba mal puesto aca se movio a\r\n      // \"vsResultado\" (recuadro verde, contenido correcto para ese modulo).\r\n      vsPrepartido: { video: '/assets/themes/argentina-streamers/vs/vs-prepartido-alpha.mp4' },\r\n      // vsResultado (2026-09-02): PNG real (VS_RESULTADO entregado por el\r\n      // usuario) reemplaza al .mp4 anterior -- geometria vertical medida\r\n      // pixel a pixel, ver program/js/renderers/vsResultado.js. El video\r\n      // viejo (vs-resultado-alpha.mp4) queda sin referenciar; no se borro\r\n      // el archivo por las dudas, solo se dejo de usar.\r\n      // Revertido (2026-09-04, pedido explicito del usuario: \"se reemplazo\r\n      // accidentalmente por el asset que corresponde a RESULTADOS\r\n      // PARCIALES\") al video que este modulo usaba ANTES del cambio a PNG\r\n      // del 2026-09-02 (commit 83cf1fa) -- confirmado por git history, no\r\n      // inventado. El PNG \"vs-resultado.png\" y su geometria vertical\r\n      // quedan reservados exclusivamente para \"resultadosParciales\" (ver\r\n      // esa entrada mas abajo), que ya tiene su propio asset separado\r\n      // \"resultados-parciales.png\" -- no se vuelven a mezclar.\r\n      vsResultado: { video: '/assets/themes/argentina-streamers/vs/vs-resultado-alpha.mp4' },\r\n      // Estrellas (2026-09-01): asset real (\"ASSET ESTRELLAS\" del ZIP) --\r\n      // solo el asset visual, la logica de datos (jugadores/escudos/\r\n      // stats/PJ/editores/posiciones) sigue exactamente igual, sin tocar.\r\n      estrellas: { video: '/assets/themes/argentina-streamers/estrellas/estrellas-alpha.mp4' },\r\n      formacionEquipos: {\r\n        video: '/assets/themes/argentina-streamers/formaciones/formacion-alpha.mp4',\r\n        // Mapping por teamId estable. Argentina masculino y femenino\r\n        // comparten el PNG entregado; equipos con valor null quedan sin\r\n        // capa de camisetas hasta que el operador integre su asset real.\r\n        formationAssetsByTeam: {\r\n          'argentina-streamers': '/assets/themes/argentina-streamers/formaciones/kits/formacion-arg.png',\r\n          'argentina-streamers-fem': '/assets/themes/argentina-streamers/formaciones/kits/formacion-arg.png',\r\n          // Argentina Senior (2026-09-04, pedido explicito): misma camiseta\r\n          // FORMACION ARG que Argentina Streamers / FEM.\r\n          'argentina-senior': '/assets/themes/argentina-streamers/formaciones/kits/formacion-arg.png',\r\n          oxen: '/assets/themes/argentina-streamers/formaciones/kits/formacion-oxen.png',\r\n          'peru-creadores': '/assets/themes/argentina-streamers/formaciones/kits/formacion-peru.png',\r\n        },\r\n      },\r\n      // Historial (2026-09-02): PNG real entregado por el usuario --\r\n      // geometria medida pixel a pixel, ver program/js/renderers/historial.js.\r\n      historial: { image: '/assets/themes/argentina-streamers/tablas/historial.png' },\r\n      // Goleadores/Asistidores/Participaciones (2026-09-02): comparten UN\r\n      // unico PNG real (10 slots, sin escudo por fila -- ver\r\n      // program/js/renderers/performanceTable.js), mismo archivo en los 3,\r\n      // sin duplicarlo en disco.\r\n      goleadores: { image: '/assets/themes/argentina-streamers/tablas/tabla-estadisticas.png' },\r\n      asistidores: { image: '/assets/themes/argentina-streamers/tablas/tabla-estadisticas.png' },\r\n      jugadores: { image: '/assets/themes/argentina-streamers/tablas/tabla-estadisticas.png' },\r\n      // Ficha Jugador (BLOQUE 4, 2026-09-09): PNG real entregado en\r\n      // \"cosas sueltas/JUGADORES.png\" -- copiado a la carpeta permanente\r\n      // del theme (no referencia \"cosas sueltas\" en runtime). Geometria\r\n      // medida pixel a pixel en vivo, ver program/js/renderers/fichaJugador.js.\r\n      fichaJugador: { image: '/assets/themes/argentina-streamers/tablas/ficha-jugador.png' },\r\n      // Cronograma Hoy (2026-09-02): PNG real (VS_DEFAULT entregado por el\r\n      // usuario) -- reemplaza la tarjeta fabricada en CSS que habia antes.\r\n      cronogramaHoy: { image: '/assets/themes/argentina-streamers/brackets/cronograma-hoy.png' },\r\n      // Resultados Parciales (2026-09-03, correcci\u00F3n expl\u00EDcita del\r\n      // usuario): PNG real entregado en \"cosas sueltas/PSD/vs_resultado.psd\"\r\n      // (confirmado por inspecci\u00F3n -- mismos escudos con cuadrito blanco\r\n      // de resultado que VS_RESULTADO), exportado y copiado a la carpeta\r\n      // permanente de este theme (no referencia \"cosas sueltas\" en\r\n      // runtime) -- reemplaza la tarjeta fabricada en CSS que habia antes.\r\n      resultadosParciales: { image: '/assets/themes/argentina-streamers/brackets/resultados-parciales.png' },\r\n      // Sitio Web Promo L (2026-09-02): PNG real (ANUNCIO_AS entregado).\r\n      // \"variants\" (2026-09-14, RESTAURADO -- ver comentario en\r\n      // shared/modules.js \"sitioWebPromoL.fields\" para la causa raiz del\r\n      // desplegable perdido): \"argentina-streamers\" es el mismo PNG de\r\n      // siempre, sin cambios. \"punch\" queda en null A PROPOSITO -- busqu\u00E9\r\n      // en todo el repo (incluida \"cosas sueltas/\") y el UNICO archivo\r\n      // \"PUNCH.png\" que existe es un logo de sponsor de 297\u00D7109 (mismo\r\n      // tama\u00F1o que el resto de \"SPONSORS ZOCALO/\"), no una placa\r\n      // full-bleed 1920\u00D71080 -- no hay ningun \"ANUNCIO_PUNCH\" real\r\n      // entregado todavia. Usar ese logo chico estirado a pantalla completa\r\n      // se ver\u00EDa roto/pixelado -- se deja pendiente (mismo criterio que\r\n      // \"THEME EN PREPARACI\u00D3N\" en el resto del proyecto) hasta recibir el\r\n      // asset correcto, en vez de inventar un placeholder.\r\n      sitioWebPromoL: {\r\n        variants: {\r\n          'argentina-streamers': '/assets/themes/argentina-streamers/extras/anuncio-as.png',\r\n          punch: null,\r\n        },\r\n      },\r\n    },\r\n  },\r\n};\r\n\r\nexport function listThemes() {\r\n  return Object.values(THEMES);\r\n}\r\n\r\nexport function isValidThemeId(themeId) {\r\n  return Object.prototype.hasOwnProperty.call(THEMES, themeId);\r\n}\r\n\r\nexport function getTheme(themeId) {\r\n  return THEMES[themeId] || THEMES[DEFAULT_THEME_ID];\r\n}\r\n\r\nexport function isThemeReady(themeId) {\r\n  return Boolean(getTheme(themeId)?.ready);\r\n}\r\n\r\n// getThemeAsset(themeId, moduleId, kind?) -- el punto de entrada que\r\n// pidi\u00F3 el enunciado (\"Cada m\u00F3dulo deber\u00EDa poder preguntar qu\u00E9 asset\r\n// corresponde al theme activo\"). \"kind\" es opcional ('video'/'image'/\r\n// 'folder'/'variants'); sin \"kind\" devuelve el objeto de asset completo\r\n// del m\u00F3dulo para ese theme, o null si el theme no tiene ese m\u00F3dulo\r\n// todav\u00EDa preparado (ej. cualquier m\u00F3dulo de \"argentinaStreamers\" hoy).\r\nexport function getThemeAsset(themeId, moduleId, kind) {\r\n  const theme = getTheme(themeId);\r\n  const moduleAsset = theme.assets[moduleId];\r\n  if (!moduleAsset) return null;\r\n  return kind ? (moduleAsset[kind] ?? null) : moduleAsset;\r\n}\r\n\r\n// Estado por-m\u00F3dulo (secci\u00F3n 6 del pedido: \"Master puede mostrar\r\n// discretamente ASSET ARGENTINA STREAMERS: PENDIENTE dentro del m\u00F3dulo\r\n// correspondiente\"). Si la entrada trae \"status\" expl\u00EDcito (Argentina\r\n// Streamers, siempre) se usa tal cual; si no (GLA, que nunca lo declara\r\n// porque sus assets ya existen todos) se infiere 'ready' con solo\r\n// comprobar que el m\u00F3dulo tenga *alg\u00FAn* asset real cargado.\r\nexport function getModuleAssetStatus(themeId, moduleId) {\r\n  const asset = getThemeAsset(themeId, moduleId);\r\n  if (!asset) return 'pending';\r\n  if (asset.status) return asset.status;\r\n  return (asset.video || asset.image || asset.folder || asset.variants) ? 'ready' : 'pending';\r\n}\r\n\r\n// Cat\u00E1logo de equipos propio del theme (secci\u00F3n 9: \"Preparar tambi\u00E9n la\r\n// l\u00F3gica de equipos\"). GLA sigue resolviendo su cat\u00E1logo desde\r\n// assets/crests/ (ver server/teams.js) -- esto es exclusivamente para\r\n// themes que todav\u00EDa no tienen esa carpeta de escudos real.\r\nexport function getThemeTeams(themeId) {\r\n  return getTheme(themeId)?.teams || [];\r\n}\r\n","http://localhost:4430/shared/adjust-registry.js","// Registro declarativo de elementos editables por modulo (2026-08-31,\r\n// pedido explicito del usuario: \"que agregar un nuevo elemento editable\r\n// sea conceptualmente tan simple como definir id/label/xKey/yKey/\r\n// scaleKey/target\"). Fuente UNICA de verdad, importada tanto por\r\n// Master Control (arma el acordeon \"AJUSTE DE COMPOSICION\" -> ver\r\n// master-control/js/main.js \"renderModuleAdjustAccordion\") como por\r\n// Program (aplica los offsets -> ver program/js/main.js\r\n// \"applyElementAdjustRegistry\") -- evita mantener la misma lista de\r\n// ids/keys duplicada en dos lados.\r\n//\r\n// Cada entrada de \"elements\" es uno de dos tipos:\r\n//   - kind:'composition' -- para elementos NO textuales (escudos, logos,\r\n//     sponsors, guiones, iconos) o cualquier bloque que deba moverse/\r\n//     escalarse como unidad. Requiere:\r\n//       1. el renderer del modulo marca el nodo con data-adjust=\"<id>\"\r\n//          (sin logica nueva, solo el atributo en el template);\r\n//       2. shared/modules.js define <xKey>/<yKey>/<scaleKey> en los\r\n//          defaults del modulo (default 0/0/1, no-op);\r\n//       3. Program aplica el offset SOLO -- ver \"applyElementAdjustRegistry\"\r\n//          en program/js/main.js, corre junto a \"applyComposition\" para\r\n//          cualquier modulo con entradas de este tipo, sin codigo nuevo\r\n//          por elemento.\r\n//   - kind:'text' -- para texto que YA pasa por \"textAdjust\" (el mismo\r\n//     mecanismo de siempre, dx/dy/dSize, ver program/js/text-fit.js).\r\n//     No requiere nada nuevo en Program: el renderer ya llama\r\n//     readTextAdjust/applyPlainTextAdjust para ese campo. Solo declara\r\n//     que existe, para que el acordeon de Master Control lo muestre.\r\n//\r\n// \"COMPOSICION COMPLETA\" (compositionOffsetX/Y/Scale) NO se declara aca:\r\n// ya es universal para los 30 modulos via COMPOSITION_DEFAULTS\r\n// (shared/modules.js) y se agrega siempre, automaticamente, al\r\n// principio del acordeon -- ver renderModuleAdjustAccordion.\r\n//\r\n// \"crestTeam\" (2026-09-01, pedido explicito del usuario: \"la posicion de\r\n// un escudo tiene que guardarse POR equipo, no solo por slot\" -- los 4\r\n// equipos de Argentina Streamers tienen proporciones/pesos visuales muy\r\n// distintos). Marca, en una entrada \"kind:'composition'\" que es\r\n// especificamente un ESCUDO de equipo (nunca un logo/sponsor/guion), de\r\n// que lado sale el teamId que la identifica en runtime:\r\n//   'A'       -> siempre el equipo LOCAL del Marcador (scoreboard.teamA).\r\n//   'B'       -> siempre el equipo VISITANTE del Marcador (scoreboard.teamB).\r\n//   'dynamic' -> un unico slot que puede ser A o B segun otro campo del\r\n//                propio modulo (ej. tarjeta/cambios: data.equipo).\r\n// Master Control (renderModuleAdjustAccordion) y Program\r\n// (applyElementAdjustRegistry) son los DOS unicos lugares que leen este\r\n// campo -- ninguno de los renderers individuales necesita saber nada de\r\n// esto. Sin \"crestTeam\" (sponsors, logos, guiones, y los \"crest\" de\r\n// columna en tablas -- grupos/sideTable/posiciones/goleadores/etc., que\r\n// a proposito NO lo declaran) el elemento se comporta EXACTAMENTE igual\r\n// que siempre: una unica posicion/escala por slot, sin distincion de\r\n// equipo. Solo tiene efecto real cuando el theme activo es\r\n// argentinaStreamers -- GLA nunca puebla \"crestByTeam\" en su propio\r\n// arbol de datos, asi que esta logica cae siempre al camino de fallback\r\n// sin cambiar nada de su comportamiento.\r\n//\r\n// \"themeOnly\" (2026-09-01, pedido explicito del usuario: \"trabajar\r\n// unicamente sobre Argentina Streamers, no tocar GLA, no tocar otros\r\n// modulos\"). Marca una entrada como visible SOLO en el acordeon generico\r\n// de Master Control (renderModuleAdjustAccordion) cuando el theme activo\r\n// coincide -- Program (applyElementAdjustRegistry) la aplica igual para\r\n// cualquier theme, sin chequear \"themeOnly\" (es un concern de UI de\r\n// Master Control, no de renderizado): para GLA los campos que respalda\r\n// simplemente nunca se tocan/guardan, asi que quedan en su default\r\n// (0/0/1, no-op) para siempre. Usado por los 12 elementos nuevos de\r\n// \"marcadorPenales\" (10 circulos + 2 nombres) -- ninguna otra entrada del\r\n// registro lo necesita hoy.\r\nexport const ADJUST_REGISTRY = {\r\n  // MARCADOR (2026-08-31): migrado desde la funcion hecha a medida\r\n  // \"renderScoreboardAdjustAccordion\" -- mismo orden, mismas labels,\r\n  // mismo comportamiento, ahora descripto de forma declarativa.\r\n  scoreboard: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE / ABREVIATURA LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'scoreA', label: 'GOL LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      { id: 'separator', label: 'GUI\u00D3N', kind: 'composition', xKey: 'separatorOffsetX', yKey: 'separatorOffsetY', scaleKey: 'separatorScale' },\r\n      { id: 'scoreB', label: 'GOL VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      { id: 'nameB', label: 'NOMBRE / ABREVIATURA VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'clock', label: 'CONTADOR / RELOJ', kind: 'text', textKey: 'clock' },\r\n      { id: 'period', label: 'PER\u00CDODO', kind: 'text', textKey: 'period' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  // --- Tanda 1 ---\r\n  tarjeta: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale', crestTeam: 'dynamic' },\r\n      { id: 'jugador', label: 'JUGADOR', kind: 'text', textKey: 'jugador' },\r\n    ],\r\n  },\r\n  cambios: {\r\n    // \"titulo\" ELIMINADO (2026-09-01, pedido explicito del usuario) -- ver\r\n    // shared/modules.js y program/js/renderers/cambios.js.\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale', crestTeam: 'dynamic' },\r\n      { id: 'entra', label: 'JUGADOR ENTRA', kind: 'text', textKey: 'entra' },\r\n      { id: 'sale', label: 'JUGADOR SALE', kind: 'text', textKey: 'sale' },\r\n    ],\r\n  },\r\n  varCheck: {\r\n    elements: [\r\n      // \"varGroup\" (2026-08-31): bug pre-existente encontrado al probar\r\n      // esta tanda -- \".ov-var-group1\" leia directamente\r\n      // compositionOffsetX/Y/Scale (las mismas keys de \"COMPOSICI\u00D3N\r\n      // COMPLETA\"), y al ser hijo de \".content\" el offset quedaba\r\n      // compuesto DOS VECES solo para este grupo. Se separo en\r\n      // varGroupOffsetX/Y/Scale (ver shared/modules.js) -- ahora es un\r\n      // control legitimo e independiente (mueve SOLO el clip VAR +\r\n      // sponsor dentro del modulo), no redundante con \"COMPOSICI\u00D3N\r\n      // COMPLETA\".\r\n      { id: 'varGroup', label: 'GRUPO VAR (CLIP + SPONSOR)', kind: 'composition', xKey: 'varGroupOffsetX', yKey: 'varGroupOffsetY', scaleKey: 'varGroupScale' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n      // \"motivoGroup\" ya existe de antes (pre-fecha este registro, ver\r\n      // varCheck.js): el renderer YA lee motivoOffsetX/Y/Scale y mueve\r\n      // \".ov-var-motivo-group\" el solo en cada pasada -- no necesita\r\n      // data-adjust ni pasar por applyElementAdjustRegistry, se declara\r\n      // aca solo para que el acordeon de Master Control muestre su control.\r\n      { id: 'motivoGroup', label: 'MOTIVO COMPLETO', kind: 'composition', xKey: 'motivoOffsetX', yKey: 'motivoOffsetY', scaleKey: 'motivoScale' },\r\n      { id: 'motivo', label: 'TEXTO MOTIVO', kind: 'text', textKey: 'motivo' },\r\n    ],\r\n  },\r\n  replay: {\r\n    elements: [\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  bug: {\r\n    elements: [\r\n      { id: 'clock', label: 'RELOJ', kind: 'text', textKey: 'clock' },\r\n    ],\r\n  },\r\n  gol: {\r\n    // Sin panel propio en Master Control (HIDDEN_FROM_NAV_IDS, ver\r\n    // master-control/js/main.js): modulo oneShot disparado automaticamente\r\n    // por scoreGoal() al anotar un gol en el Marcador, sin datos propios\r\n    // que editar (fields: [] en shared/modules.js). Hereda\r\n    // compositionOffsetX/Y/Scale via COMPOSITION_DEFAULTS igual que\r\n    // cualquier otro modulo, pero no hay panel donde mostrar \"COMPOSICI\u00D3N\r\n    // COMPLETA\" -- excepcion documentada en el informe final, no una falta\r\n    // de cobertura.\r\n    elements: [],\r\n  },\r\n\r\n  // --- Resto de MARCADOR (2026-08-31) ---\r\n  marcadorTiempoAdicional: {\r\n    elements: [\r\n      { id: 'addedMinutes', label: 'MINUTOS AGREGADOS', kind: 'text', textKey: 'addedMinutes' },\r\n      { id: 'clock', label: 'RELOJ', kind: 'text', textKey: 'clock' },\r\n    ],\r\n  },\r\n  marcadorEntretiempo: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'ABREVIATURA LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'scoreA', label: 'GOL LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      // \"GUI\u00D3N / SEPARADOR\" (2026-09-04, pedido explicito del usuario):\r\n      // editor propio, independiente de los goles -- antes el \"-\" quedaba\r\n      // fijo/no editable en el HTML de buildStructure. \"themeOnly\" porque\r\n      // es un pedido exclusivo de Argentina Streamers (GLA no lo pidio, no\r\n      // se le agrega un control nuevo que no tenia).\r\n      { id: 'separador', label: 'GUI\u00D3N / SEPARADOR', kind: 'text', textKey: 'separador', themeOnly: 'argentinaStreamers' },\r\n      { id: 'scoreB', label: 'GOL VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      { id: 'nameB', label: 'ABREVIATURA VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  // Orden pedido explicitamente por el usuario (2026-08-31, correcci\u00F3n\r\n  // Marcador de Penales): COMPOSICI\u00D3N COMPLETA (universal, siempre\r\n  // primera) -> escudo local -> fila de penales local -> resultado local\r\n  // -> gui\u00F3n -> resultado visitante -> fila de penales visitante ->\r\n  // escudo visitante -> t\u00EDtulo -> sponsor. \"nameA\"/\"nameB\" (abreviatura)\r\n  // se mantienen al final: siguen existiendo para GLA (fila propia, sin\r\n  // relacion con el \"ARG PER\" que se retir\u00F3 del centro de Argentina\r\n  // Streamers -- ver overlay.css), no pedidos en la lista nueva pero\r\n  // tampoco a remover, mismo criterio que \"VIVO\" en bug.js (control\r\n  // universal, sin efecto visual donde el elemento esta oculto).\r\n  marcadorPenales: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'kicksLocal', label: 'FILA DE PENALES LOCAL', kind: 'composition', xKey: 'kicksLocalOffsetX', yKey: 'kicksLocalOffsetY', scaleKey: 'kicksLocalScale' },\r\n      { id: 'scoreA', label: 'RESULTADO LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      { id: 'separator', label: 'GUI\u00D3N DEL RESULTADO', kind: 'composition', xKey: 'separatorOffsetX', yKey: 'separatorOffsetY', scaleKey: 'separatorScale' },\r\n      { id: 'scoreB', label: 'RESULTADO VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      { id: 'kicksVisitante', label: 'FILA DE PENALES VISITANTE', kind: 'composition', xKey: 'kicksVisitanteOffsetX', yKey: 'kicksVisitanteOffsetY', scaleKey: 'kicksVisitanteScale' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'titulo', label: 'T\u00CDTULO \"PENALES\"', kind: 'text', textKey: 'titulo' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n      { id: 'nameA', label: 'ABREVIATURA LOCAL (solo GLA)', kind: 'text', textKey: 'nameA' },\r\n      { id: 'nameB', label: 'ABREVIATURA VISITANTE (solo GLA)', kind: 'text', textKey: 'nameB' },\r\n      // \"kickLocal{1-5}\"/\"kickVisitante{1-5}\" (2026-09-01, pedido explicito\r\n      // del usuario: control total por circulo desde Master Control, sin\r\n      // mas ajustes hardcodeados en CSS). \"themeOnly\" (ver docstring mas\r\n      // abajo) los mantiene invisibles para GLA en el acordeon generico;\r\n      // el panel dedicado de Argentina Streamers Penales\r\n      // (renderPenalesArgentinaAccordion en master-control/js/main.js) los\r\n      // agrupa en su propia seccion \"AJUSTE DE INTENTOS\" en vez de listarlos\r\n      // aca sueltos.\r\n      { id: 'kickLocal1', label: 'LOCAL 1', kind: 'composition', xKey: 'kickLocal1OffsetX', yKey: 'kickLocal1OffsetY', scaleKey: 'kickLocal1Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal2', label: 'LOCAL 2', kind: 'composition', xKey: 'kickLocal2OffsetX', yKey: 'kickLocal2OffsetY', scaleKey: 'kickLocal2Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal3', label: 'LOCAL 3', kind: 'composition', xKey: 'kickLocal3OffsetX', yKey: 'kickLocal3OffsetY', scaleKey: 'kickLocal3Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal4', label: 'LOCAL 4', kind: 'composition', xKey: 'kickLocal4OffsetX', yKey: 'kickLocal4OffsetY', scaleKey: 'kickLocal4Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal5', label: 'LOCAL 5', kind: 'composition', xKey: 'kickLocal5OffsetX', yKey: 'kickLocal5OffsetY', scaleKey: 'kickLocal5Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante1', label: 'VISITANTE 1', kind: 'composition', xKey: 'kickVisitante1OffsetX', yKey: 'kickVisitante1OffsetY', scaleKey: 'kickVisitante1Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante2', label: 'VISITANTE 2', kind: 'composition', xKey: 'kickVisitante2OffsetX', yKey: 'kickVisitante2OffsetY', scaleKey: 'kickVisitante2Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante3', label: 'VISITANTE 3', kind: 'composition', xKey: 'kickVisitante3OffsetX', yKey: 'kickVisitante3OffsetY', scaleKey: 'kickVisitante3Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante4', label: 'VISITANTE 4', kind: 'composition', xKey: 'kickVisitante4OffsetX', yKey: 'kickVisitante4OffsetY', scaleKey: 'kickVisitante4Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante5', label: 'VISITANTE 5', kind: 'composition', xKey: 'kickVisitante5OffsetX', yKey: 'kickVisitante5OffsetY', scaleKey: 'kickVisitante5Scale', themeOnly: 'argentinaStreamers' },\r\n      // \"nombreLocal\"/\"nombreVisitante\" (2026-09-01): nombre de broadcast\r\n      // en la franja azul arriba de cada fila de circulos -- ver\r\n      // shared/broadcast-names.js. Solo Argentina Streamers.\r\n      { id: 'nombreLocal', label: 'NOMBRE LOCAL', kind: 'text', textKey: 'nombreLocal', themeOnly: 'argentinaStreamers' },\r\n      { id: 'nombreVisitante', label: 'NOMBRE VISITANTE', kind: 'text', textKey: 'nombreVisitante', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  marcadorZocalo: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'clock', label: 'RELOJ', kind: 'text', textKey: 'clock' },\r\n    ],\r\n  },\r\n\r\n  // --- PLACAS ---\r\n  // \"formacionEquipos\" (2026-09-04, escudo con posicion propia POR EQUIPO\r\n  // en Argentina Streamers, pedido explicito del usuario -- \"no tocar GLA\"\r\n  // es regla absoluta de esta tarea). \"playerName\"/\"playerNumber\"/\r\n  // \"subsTitle\"/\"subsList\" ya tienen su propio control dentro de \"AJUSTE\r\n  // DE TEXTOS\" del panel dedicado (2026-08-31, ver\r\n  // master-control/js/formation-list-panel.js), no se declaran aca.\r\n  // \"crest\" (escudo) queda SOLO para GLA (\"themeOnly:'gla'\"): Argentina\r\n  // Streamers tiene su propia seccion dedicada en el panel (\"ESCUDO\",\r\n  // buildCrestSection) que guarda por teamId (data.crestByTeam[teamId],\r\n  // mismo criterio que \"formationKitByTeam\" un poco mas abajo en ese mismo\r\n  // panel) -- dejar tambien esta entrada generica plana visible para ese\r\n  // theme duplicaria el control de forma confusa. GLA sigue exactamente\r\n  // igual que antes de esta tarea: mismo id/label/xKey/yKey/scaleKey,\r\n  // mismo \"data-adjust=crest\" en el renderer (ver mas abajo, gateado por\r\n  // theme).\r\n  formacionEquipos: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO EQUIPO ACTIVO', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale', themeOnly: 'gla' },\r\n    ],\r\n  },\r\n\r\n  vsPrepartido: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE EQUIPO LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'nameB', label: 'NOMBRE EQUIPO VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  vsResultado: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE EQUIPO LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'scoreA', label: 'GOL LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      { id: 'scoreB', label: 'GOL VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      // \"scoreSep\" (2026-10-08): guion dinamico entre goles, SOLO Argentina\r\n      // Streamers (GLA usa el guion que ya trae su asset) -- control propio\r\n      // con GUARDAR POSICI\u00D3N, independiente de los dos goles.\r\n      { id: 'scoreSep', label: 'GUI\u00D3N ENTRE GOLES', kind: 'text', textKey: 'scoreSep', themeOnly: 'argentinaStreamers' },\r\n      { id: 'nameB', label: 'NOMBRE EQUIPO VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  // \"estrellas\": solo \"crest\" (composition) via el acordeon generico --\r\n  // \"titulo\"/\"localNombre\"/\"localG\"/etc. YA tienen su propio control (con\r\n  // GUARDAR POSICI\u00D3N) en la seccion \"AJUSTE DE TEXTOS\" del panel dedicado\r\n  // (2026-08-31, ver master-control/js/estrellas-panel.js) -- declararlos\r\n  // tambien aca duplicaria el control.\r\n  estrellas: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'visitanteCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'visitanteCrestOffsetX', yKey: 'visitanteCrestOffsetY', scaleKey: 'visitanteCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n\r\n  // --- EVENTOS / ZOCALOS ---\r\n  longDouble: {\r\n    elements: [\r\n      { id: 'line1', label: 'T\u00CDTULO PRINCIPAL', kind: 'text', textKey: 'line1' },\r\n      { id: 'line2', label: 'SUBT\u00CDTULO / BAJADA', kind: 'text', textKey: 'line2' },\r\n    ],\r\n  },\r\n  shortSimple: {\r\n    elements: [\r\n      { id: 'text', label: 'TEXTO', kind: 'text', textKey: 'text' },\r\n    ],\r\n  },\r\n  // \"shortDouble\": sin entradas -- \"name\"/\"role\"/\"double1.name\"/etc. YA\r\n  // tienen su propio control (con GUARDAR POSICI\u00D3N) en el panel dedicado\r\n  // (2026-08-31, ver master-control/js/short-double-panel.js), y el\r\n  // modulo no tiene ningun escudo/logo/sponsor sin ajuste. Solo\r\n  // \"COMPOSICI\u00D3N COMPLETA\" (universal) aplica aca.\r\n  shortDouble: {\r\n    elements: [],\r\n  },\r\n  vs: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE EQUIPO LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'goalA', label: 'GOL LOCAL', kind: 'text', textKey: 'goalA' },\r\n      // \"scorersLocal\"/\"scorersVisitante\" (2026-09-10, VS COMPACTO\r\n      // simplificado, pedido explicito del usuario: \"eliminar\r\n      // GOLEADORES LOCAL/VISITANTE\") -- eliminadas junto con los campos\r\n      // que ajustaban.\r\n      { id: 'statusTexto', label: 'CONTENIDO CENTRAL', kind: 'text', textKey: 'statusTexto' },\r\n      { id: 'goalB', label: 'GOL VISITANTE', kind: 'text', textKey: 'goalB' },\r\n      { id: 'nameB', label: 'NOMBRE EQUIPO VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  // Z\u00D3CALO VS (2026-10-09, solo Argentina Streamers). \"variant\": la entrada\r\n  // solo se muestra en el acordeon cuando \"data.variante\" coincide (cada\r\n  // variante tiene sus propias claves). \"crestSlot\": slot propio dentro de\r\n  // \"crestByTeam\" (en vez de local/away), asi cada escudo guarda su\r\n  // posicion por VARIANTE + SLOT + EQUIPO. El \"VS\" esta horneado en el\r\n  // asset: no tiene entrada propia (se mueve con COMPOSICI\u00D3N COMPLETA).\r\n  zocaloVs: {\r\n    elements: [\r\n      { id: 'soloLocalCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'soloLocalCrestOffsetX', yKey: 'soloLocalCrestOffsetY', scaleKey: 'soloLocalCrestScale', crestTeam: 'A', crestSlot: 'soloLocal', variant: 'solo' },\r\n      { id: 'soloNombreLocal', label: 'NOMBRE LOCAL', kind: 'text', textKey: 'soloNombreLocal', variant: 'solo' },\r\n      { id: 'soloNombreVisitante', label: 'NOMBRE VISITANTE', kind: 'text', textKey: 'soloNombreVisitante', variant: 'solo' },\r\n      { id: 'soloAwayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'soloAwayCrestOffsetX', yKey: 'soloAwayCrestOffsetY', scaleKey: 'soloAwayCrestScale', crestTeam: 'B', crestSlot: 'soloAway', variant: 'solo' },\r\n      { id: 'golesLocalCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'golesLocalCrestOffsetX', yKey: 'golesLocalCrestOffsetY', scaleKey: 'golesLocalCrestScale', crestTeam: 'A', crestSlot: 'golesLocal', variant: 'goles' },\r\n      { id: 'golesNombreLocal', label: 'NOMBRE LOCAL', kind: 'text', textKey: 'golesNombreLocal', variant: 'goles' },\r\n      { id: 'golesGolLocal', label: 'GOL LOCAL', kind: 'text', textKey: 'golesGolLocal', variant: 'goles' },\r\n      { id: 'golesGolVisitante', label: 'GOL VISITANTE', kind: 'text', textKey: 'golesGolVisitante', variant: 'goles' },\r\n      { id: 'golesNombreVisitante', label: 'NOMBRE VISITANTE', kind: 'text', textKey: 'golesNombreVisitante', variant: 'goles' },\r\n      { id: 'golesAwayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'golesAwayCrestOffsetX', yKey: 'golesAwayCrestOffsetY', scaleKey: 'golesAwayCrestScale', crestTeam: 'B', crestSlot: 'golesAway', variant: 'goles' },\r\n    ],\r\n  },\r\n  zocaloCompuesto: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'logo', label: 'LOGO GLA', kind: 'composition', xKey: 'logoOffsetX', yKey: 'logoOffsetY', scaleKey: 'logoScale' },\r\n      { id: 'texto1', label: 'TEXTO 1', kind: 'text', textKey: 'texto1' },\r\n      { id: 'texto2', label: 'TEXTO 2', kind: 'text', textKey: 'texto2' },\r\n      // \"sponsors\" (2026-09-24, pedido explicito: \"un unico ajuste de\r\n      // composicion para TODOS los sponsors del rotativo\", ver comentario\r\n      // completo en shared/modules.js) -- UNA sola entrada en vez de\r\n      // \"sponsor1\"/\"sponsor2\": aplicarModuleAdjustRegistry (program/js/\r\n      // main.js) ya soporta un mismo \"data-adjust\" marcando VARIOS nodos\r\n      // (mismo mecanismo que \"crest\" de columna en grupos/sideTable), asi\r\n      // que alcanza con que los 2 <img> del rotativo compartan este mismo\r\n      // id (ver program/js/renderers/zocaloCompuesto.js).\r\n      { id: 'sponsors', label: 'SPONSORS', kind: 'composition', xKey: 'sponsorsOffsetX', yKey: 'sponsorsOffsetY', scaleKey: 'sponsorsScale' },\r\n    ],\r\n  },\r\n  // Unica entrada de cada uno (2026-09-02, auditoria de wiring): habia una\r\n  // segunda entrada duplicada mas abajo en este objeto, sin \"sponsor\" -- en\r\n  // un literal de objeto JS la clave repetida MAS TARDE gana, asi que esa\r\n  // version incompleta (sin editor de posicion de sponsor en el acordeon\r\n  // generico) era la que realmente terminaba en ADJUST_REGISTRY, no esta.\r\n  // Se elimino el duplicado.\r\n  // Unificado con \"zocaloCompuestoLogo\" (2026-09-10, ver shared/modules.js)\r\n  // -- lleva las entradas de AMBOS tipos a la vez (escudos Y logo), asi el\r\n  // operador puede dejar las dos posiciones configuradas de antemano sin\r\n  // importar con cual \"tipo\" este trabajando en un momento dado.\r\n  zocaloCompuestoEquipos: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'logo', label: 'LOGO LOCALSTRIKE', kind: 'composition', xKey: 'logoOffsetX', yKey: 'logoOffsetY', scaleKey: 'logoScale' },\r\n      { id: 'texto1', label: 'TEXTO MAIN (TIRA AZUL)', kind: 'text', textKey: 'texto1' },\r\n      { id: 'texto2', label: 'SUBTEXTO (TIRA VERDE)', kind: 'text', textKey: 'texto2' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  // LEGACY -- ver \"zocaloCompuestoLogo\" en shared/modules.js. Sin entrada\r\n  // propia: modulo oculto de toda navegacion, ya no editable.\r\n  // \"zocaloFinal\"/\"zocaloFinalDiv\" (2026-08-31): sin entrada de registro.\r\n  // HIDDEN_FROM_NAV_IDS (ver master-control/js/main.js) -- reemplazados\r\n  // por \"zocaloCompuesto\" (2026-08-16), sin panel propio en Master Control\r\n  // donde mostrar ningun acordeon. Excepcion documentada en el informe\r\n  // final, no una falta de cobertura.\r\n\r\n  // --- GRUPOS / BRACKETS / TABLAS ---\r\n  // Las 6 entradas de abajo (grupos/sideTable/posiciones/posicionesTorneo/\r\n  // goleadores/asistidores/jugadores) declaran SOLO \"crest\" (composition):\r\n  // todos los demas campos (titulo/nombre/puntos/numero/equipo/pts/pj/g/\r\n  // gxp/pxp/p/gf/gc/dg/golLocal/golVisitante/estado/estadoFullscreen/\r\n  // tituloBracket/position/name/primaryStat/stat0/stat1/stat2) YA tienen\r\n  // su propio control por columna (con GUARDAR POSICI\u00D3N) dentro de la\r\n  // seccion \"AJUSTE DE TEXTOS\"/\"AJUSTE DE COMPOSICI\u00D3N\" de cada panel\r\n  // dedicado (2026-08-31, ver grupos-panel.js, resultados-panel.js,\r\n  // posiciones-panel.js, performance-table-panel.js) -- declararlos aca\r\n  // tambien duplicaria el control. \"crest\" es el unico elemento\r\n  // genuinamente nuevo (escudo por fila/columna, nunca tuvo ajuste propio).\r\n  grupos: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n    ],\r\n  },\r\n  sideTable: {\r\n    elements: [\r\n      { id: 'crestLocal', label: 'ESCUDO LOCAL (COLUMNA)', kind: 'composition', xKey: 'crestLocalOffsetX', yKey: 'crestLocalOffsetY', scaleKey: 'crestLocalScale' },\r\n      { id: 'crestVisitante', label: 'ESCUDO VISITANTE (COLUMNA)', kind: 'composition', xKey: 'crestVisitanteOffsetX', yKey: 'crestVisitanteOffsetY', scaleKey: 'crestVisitanteScale' },\r\n    ],\r\n  },\r\n  posiciones: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n    ],\r\n  },\r\n  posicionesTorneo: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n    ],\r\n  },\r\n  goleadores: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n      // \"ESCUDO T\u00CDTULO\" (2026-09-04, pedido explicito del usuario): escudo\r\n      // FIJO de Argentina Streamers masculino a la izquierda del titulo de\r\n      // la placa de 10 filas -- no depende del Marcador, por eso no lleva\r\n      // \"crestTeam\". Solo Argentina Streamers (GLA no tiene esa zona).\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  asistidores: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  jugadores: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  // \"fichaJugador\" (rehecho en BLOQUE 4, 2026-09-09, sobre el asset real\r\n  // -- ver assets/themes/argentina-streamers/tablas/ficha-jugador.png):\r\n  // el dise\u00F1o real NO tiene recuadro de escudo (solo z\u00F3calo con nombre +\r\n  // 4 recuadros de estad\u00EDstica), asi que no hay entrada \"kind:composition\"\r\n  // aca -- la unica composicion editable es la generica del modulo entero\r\n  // (\"COMPOSICI\u00D3N COMPLETA\", agregada automaticamente por\r\n  // renderModuleAdjustAccordion sin declararla aca). Los 5 textos (nombre\r\n  // + 4 stats) ya tienen su propio ajuste via \"textAdjust\" (ver\r\n  // shared/modules.js), mostrado por el mismo acordeon sin necesitar una\r\n  // entrada \"kind:text\" -- ese camino ya es generico para cualquier modulo\r\n  // con \"textAdjust\" no vacio via los campos ADJUST_ONLY/adjustable de\r\n  // \"fields\" en shared/modules.js; \"fichaJugador\" no usa \"fields\" (panel\r\n  // dedicado, ver ficha-jugador-panel.js), asi que sus ajustes de texto se\r\n  // muestran directo desde ese panel, no desde este registro.\r\n  fichaJugador: {\r\n    elements: [],\r\n  },\r\n  // \"historial\" (2026-09-02, reconstruido desde cero sobre el PNG real --\r\n  // ver informe): sin panel dedicado de composicion propio, el acordeon\r\n  // generico alcanza para las 4 columnas (2 escudos + 2 goles) mas\r\n  // \"COMPOSICI\u00D3N COMPLETA\" automatica -- mismo criterio \"column-level\" que\r\n  // goleadores/asistidores/jugadores arriba, un unico ajuste se aplica a\r\n  // las 5 filas por igual.\r\n  historial: {\r\n    // \"titulo\" (2026-09-04, pedido explicito del usuario: \"posicion/escala\r\n    // INDEPENDIENTE por categoria, no una unica posicion global\") ya NO\r\n    // vive aca -- el acordeon generico solo sabe escribir un unico\r\n    // \"textAdjust.titulo\" compartido por las 4 categorias, que es\r\n    // exactamente lo que el usuario no quiere. Su control propio (uno por\r\n    // categoria, sobre \"data.tituloByCategoria[tipoHistorial]\") vive\r\n    // directo en master-control/js/historial-panel.js, reusando el mismo\r\n    // componente generico (renderTextAdjustControl) por fuera de este\r\n    // registro. \"ESCUDO T\u00CDTULO\" (2026-09-04, mismo pedido, item 7: mismo\r\n    // escudo Argentina Streamers masculino que ya usan\r\n    // goleadores/asistidores/jugadores) SI sigue aca -- no depende del\r\n    // largo del texto, un unico ajuste alcanza para las 4 categorias.\r\n    // \"GOL LOCAL\"/\"GOL VISITANTE\"/\"PENALES LOCAL\"/\"PENALES VISITANTE\" como\r\n    // columnas independientes YA NO viven aca (2026-09-04, pedido explicito\r\n    // del usuario: \"eliminar la edicion independiente... los dos goles\r\n    // deben moverse juntos\", con geometria completamente separada segun si\r\n    // la fila tiene penales o no). Reemplazados por 3 controles propios\r\n    // (\"RESULTADO NORMAL\"/\"RESULTADO CON PENALES\"/\"PENALES\") que viven\r\n    // directo en master-control/js/historial-panel.js -- igual criterio\r\n    // que \"titulo\" arriba: el acordeon generico solo sabe escribir UN\r\n    // textAdjust por columna, aplicado sin condicion a las 5 filas, que es\r\n    // exactamente lo que este pedido prohibe (mover el bloque de penales\r\n    // NO puede tocar las filas sin penales). Ver\r\n    // program/js/renderers/historial.js para la logica de aplicacion\r\n    // condicional real.\r\n    elements: [\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale' },\r\n      { id: 'crestLocal', label: 'ESCUDO LOCAL (COLUMNA)', kind: 'composition', xKey: 'crestLocalOffsetX', yKey: 'crestLocalOffsetY', scaleKey: 'crestLocalScale' },\r\n      { id: 'crestVisitante', label: 'ESCUDO VISITANTE (COLUMNA)', kind: 'composition', xKey: 'crestVisitanteOffsetX', yKey: 'crestVisitanteOffsetY', scaleKey: 'crestVisitanteScale' },\r\n      // \"FASE / INSTANCIA\" (2026-09-04, pedido explicito del usuario, item\r\n      // 3: \"manejarlo como bloque/columna comun ya que todos los slots\r\n      // comparten geometria\") -- mismo criterio por columna, dato real\r\n      // (\"stage\" de la web) por fila, un unico ajuste para las 5.\r\n      { id: 'fase', label: 'FASE / INSTANCIA (COLUMNA)', kind: 'text', textKey: 'fase' },\r\n    ],\r\n  },\r\n  // \"cronogramaHoy\" (2026-09-02, reconstruido desde cero sobre el PNG real\r\n  // -- ver informe): escudos con \"crestTeam\" (posicion propia por teamId\r\n  // real del Marcador, mismo mecanismo ya probado en zocaloCompuestoEquipos/\r\n  // marcadorPenales) -- nunca un selector de equipo propio, pedido\r\n  // explicito del usuario.\r\n  cronogramaHoy: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'crestLocal', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'crestLocalOffsetX', yKey: 'crestLocalOffsetY', scaleKey: 'crestLocalScale', crestTeam: 'A' },\r\n      { id: 'crestVisitante', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'crestVisitanteOffsetX', yKey: 'crestVisitanteOffsetY', scaleKey: 'crestVisitanteScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  // \"resultadosParciales\" (2026-09-03, reconstruido desde cero sobre\r\n  // VS_RESULTADO.png real -- correcci\u00F3n expl\u00EDcita del usuario, confirmada\r\n  // por AskUserQuestion): un solo partido, escudos con \"crestTeam\" (mismo\r\n  // mecanismo que cronogramaHoy/vsResultado) + resultado LOCAL/VISITANTE\r\n  // como texto (heredado en vivo del Marcador, sin selector de equipo\r\n  // propio). \"titulo\" ya tiene panel dedicado (resultados-parciales-panel.js)\r\n  // pero se declara aca igual para que el acordeon lo muestre con GUARDAR\r\n  // POSICI\u00D3N, mismo criterio que el resto del proyecto.\r\n  resultadosParciales: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'scoreLocal', label: 'RESULTADO LOCAL', kind: 'text', textKey: 'scoreLocal' },\r\n      { id: 'scoreVisitante', label: 'RESULTADO VISITANTE', kind: 'text', textKey: 'scoreVisitante' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n};\r\n","http://localhost:4430/shared/sponsors.js","let sponsors = { scoreboard: [], var: [], vs_compact: [], zocalo: [] };\r\nif (typeof window === 'undefined') {\r\n  try {\r\n    const { getSponsorsCatalog } = await import('../server/sponsors.js');\r\n    sponsors = getSponsorsCatalog();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo leer el catalogo de sponsors (Node):', err);\r\n  }\r\n} else {\r\n  try {\r\n    const res = await fetch('/api/sponsors');\r\n    sponsors = await res.json();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo cargar el catalogo de sponsors:', err);\r\n  }\r\n}\r\n\r\nexport const SPONSORS = sponsors;\r\n\r\nexport const SPONSOR_OPTIONS = {\r\n  scoreboard: [\r\n    { id: '', label: 'SIN SPONSOR' },\r\n    ...sponsors.scoreboard.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n  ],\r\n  var: [\r\n    { id: '', label: 'SIN SPONSOR' },\r\n    ...sponsors.var.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n  ],\r\n  vs_compact: [\r\n    { id: '', label: 'SIN SPONSOR' },\r\n    ...sponsors.vs_compact.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n  ],\r\n  zocalo: sponsors.zocalo.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n};\r\n\r\nexport function sponsorFile(category, id) {\r\n  if (!id) return '';\r\n  const list = sponsors[category] || [];\r\n  return list.find((s) => s.name === id)?.file || '';\r\n}\r\n","http://localhost:4430/shared/clock.js","// Reloj de partido: el servidor solo guarda una referencia (corriendo o no,\r\n// tiempo acumulado, marca de tiempo de arranque). Cada cliente calcula el\r\n// tiempo transcurrido localmente con Date.now(), asi no hace falta que el\r\n// servidor emita un tick por segundo para mantenerlo sincronizado.\r\n\r\nexport function emptyClock() {\r\n  return { running: false, accumulatedMs: 0, startedAt: null };\r\n}\r\n\r\n// \"limitMs\" (2026-08-15, pedido explicito del usuario: contador con fin\r\n// configurable \u2014 Marcador principal y Marcador Zocalo). Parametro\r\n// OPCIONAL y aditivo: si no se pasa (undefined/null), el comportamiento\r\n// es exactamente el de siempre, sin clamping \u2014 ningun llamador existente\r\n// que no conozca este parametro cambia de comportamiento. Cuando se pasa,\r\n// el valor devuelto nunca supera el limite: una vez alcanzado, tanto\r\n// Program (que llama esto en cada tick de 500ms, ver program/js/main.js)\r\n// como los paneles de Master Control (que tambien usan esta misma funcion\r\n// para Play/Pause/Fijar) ven siempre el mismo valor trabado, sin importar\r\n// cuanto tiempo real siga \"corriendo\" el reloj por detras -- asi que\r\n// aunque el operador aprete Pausa recien despues de haberlo dejado\r\n// corriendo un buen rato pasado el limite, lo que se congela en\r\n// \"accumulatedMs\" es el valor YA topeado, nunca el tiempo real sin topear\r\n// (ver mkBtn('Pause'...) en master-control/js/scoreboard-clock-panel.js).\r\nexport function elapsedMs(clock, limitMs) {\r\n  if (!clock) return 0;\r\n  const base = clock.accumulatedMs || 0;\r\n  const raw = clock.running && clock.startedAt ? base + (Date.now() - clock.startedAt) : base;\r\n  if (limitMs != null && raw >= limitMs) return limitMs;\r\n  return raw;\r\n}\r\n\r\nexport function formatClock(ms) {\r\n  const totalSeconds = Math.max(0, Math.floor(ms / 1000));\r\n  const minutes = Math.floor(totalSeconds / 60);\r\n  const seconds = totalSeconds % 60;\r\n  return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;\r\n}\r\n\r\n// Parsea un texto \"MM:SS\" tipeado por el operador (campo \"FIN DEL\r\n// CONTADOR\") a milisegundos. Tolerante: minutos de 1 a 3 digitos,\r\n// segundos de 0 a 59 -- si no matchea el formato devuelve el fallback tal\r\n// cual (nunca null/NaN, para que un texto invalido no rompa el reloj,\r\n// simplemente se ignora el limite hasta que el operador lo corrija).\r\nexport function parseClockLimit(text, fallbackMs) {\r\n  if (typeof text !== 'string') return fallbackMs;\r\n  const match = text.trim().match(/^(\\d{1,3}):([0-5]?\\d)$/);\r\n  if (!match) return fallbackMs;\r\n  const minutes = parseInt(match[1], 10);\r\n  const seconds = parseInt(match[2], 10);\r\n  return (minutes * 60 + seconds) * 1000;\r\n}\r\n","http://localhost:4430/master-control/js/text-adjust-control.js","// Control compacto de edicion manual de posicion/tama\u00F1o para UN campo de\r\n// texto puntual (2026-08-14, pedido explicito del usuario: \"herramienta\r\n// general de edicion/ajuste manual para los textos de los zocalos\").\r\n//\r\n// Componente UNICO reusado desde dos lugares para no repetir la misma\r\n// logica de botones en cada modulo:\r\n//   - field-editors.js: campos TEXT genericos del schema marcados con\r\n//     \"adjustable: true\" (ver shared/modules.js) lo muestran solos, sin\r\n//     que cada renderer de Master Control tenga que saber nada de esto.\r\n//   - short-double-panel.js: panel dedicado de Zocalo corto doble (no usa\r\n//     el editor generico de campos), lo importa y lo monta directo sobre\r\n//     sus propios objetos de ajuste (\"name\"/\"role\"/\"double1.name\"/etc).\r\n//\r\n// \"adjust\" es el objeto { dx, dy, dSize } YA ubicado en su lugar dentro\r\n// del draft del operador (ver \"textAdjust\" en shared/modules.js) -- este\r\n// componente lo MUTA in-place con cada click y llama a \"onDirty()\" (mismo\r\n// callback que ya dispara el guardado/UPDATE en vivo en todos los otros\r\n// paneles de esta sesion), nunca crea su propia copia ni su propio envio\r\n// de red: la persistencia y el \"reflejarse inmediatamente si esta al\r\n// aire\" ya los resuelve el mismo pipeline de auto-guardado que usa\r\n// cualquier otro campo de texto (scheduleAutoSave -> UPDATE).\r\nimport { renderSavePositionControl } from './save-position-control.js';\r\n\r\nconst STEP_PX = 2;\r\n// Intensidad \"0.5\" (BLOQUE 1, 2026-09-09, pedido explicito del usuario):\r\n// exactamente la mitad del paso normal (\"1.0\" = STEP_PX), respetando la\r\n// unidad que ya use el modulo -- NO un valor fijo de 1px. Si algun dia\r\n// STEP_PX cambia, HALF_STEP_PX se recalcula solo.\r\nconst HALF_STEP_PX = STEP_PX / 2;\r\nconst STEP_SIZE = 1;\r\nconst REPEAT_DELAY_MS = 400;\r\nconst REPEAT_INTERVAL_MS = 80;\r\n\r\nfunction ensureShape(adjust) {\r\n  if (typeof adjust.dx !== 'number') adjust.dx = 0;\r\n  if (typeof adjust.dy !== 'number') adjust.dy = 0;\r\n  if (typeof adjust.dSize !== 'number') adjust.dSize = 0;\r\n}\r\n\r\n// Boton con soporte de \"mantener apretado\" (2026-08-14, pedido explicito\r\n// del usuario: \"si mantengo apretado un bot\u00F3n... puede repetir\r\n// progresivamente\"). Solo listeners sobre el propio boton (mousedown/\r\n// mouseup/mouseleave) -- nada a nivel \"window\", para no acumular\r\n// listeners globales huerfanos cada vez que un panel se vuelve a pintar\r\n// (varios paneles de esta sesion reconstruyen su DOM entero en cada\r\n// edicion, ver formation-list-panel.js/grupos-panel.js). \"mouseleave\" ya\r\n// alcanza para cortar el repetido si el mouse se va del boton antes de\r\n// soltar el click, asi que no hace falta escuchar mouseup fuera de el.\r\nfunction repeatButton(label, title, onFire) {\r\n  const btn = document.createElement('button');\r\n  btn.type = 'button';\r\n  btn.className = 'text-adjust-btn';\r\n  btn.textContent = label;\r\n  btn.title = title;\r\n  btn.setAttribute('aria-label', title);\r\n\r\n  let delayTimer = null;\r\n  let repeatTimer = null;\r\n  function stop() {\r\n    clearTimeout(delayTimer);\r\n    clearInterval(repeatTimer);\r\n    delayTimer = null;\r\n    repeatTimer = null;\r\n  }\r\n  btn.addEventListener('mousedown', (e) => {\r\n    e.preventDefault();\r\n    // Guardia: un \"mousedown\" sin su \"mouseup\" pareja (posible con clicks\r\n    // sinteticos/eventos de prueba, o un mouseup perdido por el browser)\r\n    // dejaria los timers de la vez anterior corriendo para siempre --\r\n    // \"stop()\" primero limpia cualquier resto antes de arrancar de nuevo,\r\n    // asi nunca queda mas de un temporizador activo por boton.\r\n    stop();\r\n    onFire();\r\n    delayTimer = setTimeout(() => {\r\n      repeatTimer = setInterval(onFire, REPEAT_INTERVAL_MS);\r\n    }, REPEAT_DELAY_MS);\r\n  });\r\n  btn.addEventListener('mouseup', stop);\r\n  btn.addEventListener('mouseleave', stop);\r\n  return btn;\r\n}\r\n\r\n// Monta el control dentro de \"container\". \"adjust\" se muta in-place;\r\n// \"onDirty\" se llama en cada cambio (guardado/UPDATE); \"onReset\" es\r\n// opcional y, si se pasa, se llama ADEMAS de limpiar \"adjust\" (por si el\r\n// caller necesita re-pintar algo propio, ver short-double-panel.js).\r\nexport function renderTextAdjustControl(container, adjust, onDirty, { label, onReset, onSave, isPendingSave, isConnected, elementSpec, initialBaseline } = {}) {\r\n  ensureShape(adjust);\r\n\r\n  const root = document.createElement('div');\r\n  root.className = 'text-adjust';\r\n\r\n  // \"baseline\" (2026-09-01, layout base versionado; corregido 2026-09-10,\r\n  // auditoria de GUARDAR POSICI\u00D3N pedida por el usuario, mismo criterio que\r\n  // composition-control.js): referencia LOCAL de \"ya confirmado\". ANTES\r\n  // arrancaba en {0,0,0} salvo que el caller pasara \"initialBaseline\" a\r\n  // mano (solo historial-panel.js lo hacia) -- cualquier otro campo, al\r\n  // remontarse (cambiar de tab, refresh, restart), mostraba como pendiente\r\n  // un ajuste que en realidad ya era la base confirmada, y RESET lo hubiera\r\n  // borrado por completo. Ahora arranca en el valor ABSOLUTO actual de\r\n  // \"adjust.dx/dy/dSize\" (ya resuelto: GUARDAR POSICI\u00D3N/theme-layout/perfil\r\n  // antes de llegar aca) -- \"initialBaseline\" se conserva como override\r\n  // explicito opcional para el caso de historial-panel.js (varios objetos\r\n  // \"adjust\" distintos comparten un unico control reconstruido), pero deja\r\n  // de ser necesario para el resto de los llamadores.\r\n  const baseline = initialBaseline ? { ...initialBaseline } : { dx: adjust.dx, dy: adjust.dy, dSize: adjust.dSize };\r\n\r\n  if (label) {\r\n    const labelEl = document.createElement('span');\r\n    labelEl.className = 'text-adjust-label';\r\n    labelEl.textContent = label;\r\n    root.appendChild(labelEl);\r\n  }\r\n\r\n  // Lectura numerica chica, de solo referencia -- no es un input editable\r\n  // (pedido explicito del usuario: \"no necesito inputs complicados\"),\r\n  // solo para que el operador vea que hay un ajuste guardado sin tener\r\n  // que adivinar por cuantos clicks paso, sobre todo despues de un\r\n  // refresh del panel.\r\n  const readout = document.createElement('span');\r\n  readout.className = 'text-adjust-readout';\r\n  function refreshReadout() {\r\n    const relDx = adjust.dx - baseline.dx;\r\n    const relDy = adjust.dy - baseline.dy;\r\n    const relDSize = adjust.dSize - baseline.dSize;\r\n    readout.textContent = `X:${relDx} Y:${relDy} T:${relDSize >= 0 ? '+' : ''}${relDSize}`;\r\n    readout.classList.toggle('is-zero', relDx === 0 && relDy === 0 && relDSize === 0);\r\n  }\r\n  refreshReadout();\r\n\r\n  const row = document.createElement('div');\r\n  row.className = 'text-adjust-row';\r\n  let saveControl = null;\r\n\r\n  function bump(prop, delta) {\r\n    adjust[prop] += delta;\r\n    refreshReadout();\r\n    onDirty();\r\n    saveControl?.markDirty();\r\n  }\r\n\r\n  row.appendChild(repeatButton('\u2190', `Mover izquierda (${STEP_PX}px)`, () => bump('dx', -STEP_PX)));\r\n  row.appendChild(repeatButton('\u2191', `Subir (${STEP_PX}px)`, () => bump('dy', -STEP_PX)));\r\n  row.appendChild(repeatButton('\u2193', `Bajar (${STEP_PX}px)`, () => bump('dy', STEP_PX)));\r\n  row.appendChild(repeatButton('\u2192', `Mover derecha (${STEP_PX}px)`, () => bump('dx', STEP_PX)));\r\n  row.appendChild(repeatButton('\u2212', 'Achicar', () => bump('dSize', -STEP_SIZE)));\r\n  row.appendChild(repeatButton('+', 'Agrandar', () => bump('dSize', STEP_SIZE)));\r\n\r\n  // Segunda fila: intensidad \"0.5\" (BLOQUE 1, pedido explicito del\r\n  // usuario) -- mismas 4 direcciones, exactamente la mitad del paso de\r\n  // arriba. Mismo boton con auto-repeat, misma mutacion in-place de\r\n  // \"adjust\", mismo \"onDirty\"/\"markDirty\" -- ningun mecanismo nuevo,\r\n  // solo un delta mas chico.\r\n  const halfRow = document.createElement('div');\r\n  halfRow.className = 'text-adjust-row text-adjust-row-half';\r\n  halfRow.appendChild(repeatButton('\u2190\u00BD', `Mover izquierda (${HALF_STEP_PX}px)`, () => bump('dx', -HALF_STEP_PX)));\r\n  halfRow.appendChild(repeatButton('\u2191\u00BD', `Subir (${HALF_STEP_PX}px)`, () => bump('dy', -HALF_STEP_PX)));\r\n  halfRow.appendChild(repeatButton('\u2193\u00BD', `Bajar (${HALF_STEP_PX}px)`, () => bump('dy', HALF_STEP_PX)));\r\n  halfRow.appendChild(repeatButton('\u2192\u00BD', `Mover derecha (${HALF_STEP_PX}px)`, () => bump('dx', HALF_STEP_PX)));\r\n\r\n  const resetBtn = document.createElement('button');\r\n  resetBtn.type = 'button';\r\n  resetBtn.className = 'text-adjust-reset';\r\n  resetBtn.textContent = 'RESET';\r\n  resetBtn.title = 'Volver este texto a la posici\u00F3n/tama\u00F1o de dise\u00F1o original';\r\n  resetBtn.addEventListener('click', () => {\r\n    // \"baseline\" (no {0,0,0} directo): mismo criterio que\r\n    // composition-control.js -- una vez confirmada una base nueva, RESET\r\n    // vuelve A ESA base, no al dise\u00F1o original de antes de confirmarla.\r\n    adjust.dx = baseline.dx;\r\n    adjust.dy = baseline.dy;\r\n    adjust.dSize = baseline.dSize;\r\n    refreshReadout();\r\n    onDirty();\r\n    onReset?.();\r\n    saveControl?.markDirty();\r\n  });\r\n  row.appendChild(resetBtn);\r\n  row.appendChild(readout);\r\n\r\n  root.appendChild(row);\r\n  root.appendChild(halfRow);\r\n\r\n  // Fila propia (no adentro de \"row\", que es un grid de columnas fijas\r\n  // pensado para los 8 controles de siempre) -- as\u00ED no desalinea ni\r\n  // desborda ning\u00FAn caller existente.\r\n  const saveRow = document.createElement('div');\r\n  saveRow.className = 'text-adjust-save-row';\r\n  // \"elementSpec\" (2026-09-01, layout base versionado): igual criterio que\r\n  // composition-control.js -- consolida el valor absoluto actual y\r\n  // actualiza \"baseline\" al toque, sin esperar confirmacion del servidor.\r\n  const wrappedOnSave = (onSave && elementSpec)\r\n    ? () => {\r\n      onSave(elementSpec);\r\n      baseline.dx = adjust.dx;\r\n      baseline.dy = adjust.dy;\r\n      baseline.dSize = adjust.dSize;\r\n      refreshReadout();\r\n    }\r\n    : undefined;\r\n  saveControl = renderSavePositionControl(saveRow, { onSave: wrappedOnSave, isPendingSave, isConnected });\r\n  if (saveControl) root.appendChild(saveRow);\r\n\r\n  container.appendChild(root);\r\n  return root;\r\n}\r\n","http://localhost:4430/shared/adjust-path.js","// Helpers puros para leer/escribir valores anidados en los arboles de\n// datos de \"textAdjust\" y offsets de composicion (2026-09-01, sistema de\n// LAYOUT BASE VERSIONADO -- pedido explicito del usuario: \"GUARDAR\n// POSICI\u00D3N\" debe consolidar el ajuste en vivo dentro de un archivo\n// versionado por Git, no en el estado runtime gitignorado). Sin\n// dependencias -- lo importan tanto server/ (Node) como master-control/js\n// (navegador) via el mismo modulo ES, igual que el resto de shared/.\n\n// Camina \"path\" (arreglo de claves) sobre \"root\", devolviendo undefined en\n// cuanto encuentra un nivel inexistente en vez de tirar.\nexport function getAtPath(root, path) {\n  let node = root;\n  for (const key of path) {\n    if (node == null) return undefined;\n    node = node[key];\n  }\n  return node;\n}\n\n// Crea/reutiliza los objetos intermedios de \"path\" dentro de \"root\" y\n// mezcla \"patch\" (shallow) en el nodo final -- usado para escribir la\n// nueva base de UN elemento sin pisar el resto del archivo de layout.\nexport function setDeepMerge(root, path, patch) {\n  let node = root;\n  for (const key of path) {\n    if (typeof node[key] !== 'object' || node[key] === null || Array.isArray(node[key])) {\n      node[key] = {};\n    }\n    node = node[key];\n  }\n  Object.assign(node, patch);\n}\n\n// Mezcla recursiva \"override\" encima de \"target\": objetos planos se\n// combinan clave por clave (recursivo), cualquier otro tipo (numero,\n// string, array) pisa directo. Usado por \"cloneDefaults\" (shared/modules.js)\n// para aplicar el layout base versionado sobre los defaults estructurales\n// de cada modulo, y por el script de migracion para el mismo fin.\nexport function deepMergeAdjustFields(target, override) {\n  if (!override || typeof override !== 'object') return target;\n  for (const [key, value] of Object.entries(override)) {\n    if (value && typeof value === 'object' && !Array.isArray(value)\n      && target[key] && typeof target[key] === 'object' && !Array.isArray(target[key])) {\n      deepMergeAdjustFields(target[key], value);\n    } else {\n      target[key] = value;\n    }\n  }\n  return target;\n}\n","http://localhost:4430/shared/player-lists.js","// Formato compartido entre Master Control y Program para las listas de\r\n// Formaci\u00F3n. El estado persiste objetos { number, name, jugadorId }; esta\r\n// capa acepta adem\u00E1s strings viejos o pegados por el operador para\r\n// mantener compatibilidad.\r\n//\r\n// \"jugadorId\" (2026-09-10, pedido explicito del usuario, FORMACI\u00D3N item 13:\r\n// \"la validaci\u00F3n debe usar el identificador estable del jugador si existe,\r\n// no solamente el texto visible\") -- id del plantel central\r\n// (server/playerRosters.js) cuando el jugador vino del desplegable de\r\n// roster; string vac\u00EDo para un nombre tipeado a mano (sin match posible\r\n// contra duplicados por id, solo por texto -- ver\r\n// formation-list-panel.js). Program NUNCA lo lee (no aporta nada visual,\r\n// ver program/js/renderers/formacionEquipos.js) pero viaja igual dentro de\r\n// \"data.starters/substitutes\" porque son el MISMO array -- no vale la pena\r\n// mantener una estructura paralela solo para no persistir 3 caracteres.\r\n\r\nexport function parsePlayer(value) {\r\n  if (value && typeof value === 'object') {\r\n    return {\r\n      number: String(value.number ?? '').trim(),\r\n      name: String(value.name ?? '').trim(),\r\n      jugadorId: String(value.jugadorId ?? '').trim(),\r\n    };\r\n  }\r\n\r\n  const text = String(value ?? '').trim();\r\n  const match = text.match(/^(\\d+)\\s*[.\\-)]\\s*(.*)$/);\r\n  if (match) {\r\n    return { number: match[1], name: match[2].trim(), jugadorId: '' };\r\n  }\r\n  return { number: '', name: text, jugadorId: '' };\r\n}\r\n\r\nexport function normalizePlayers(value) {\r\n  const source = Array.isArray(value)\r\n    ? value\r\n    : String(value ?? '').split(/\\r?\\n/);\r\n\r\n  return source\r\n    .map(parsePlayer)\r\n    .filter((player) => player.number || player.name);\r\n}\r\n\r\nexport function formatPlayer(player) {\r\n  const normalized = parsePlayer(player);\r\n  if (normalized.number && normalized.name) return `${normalized.number}. ${normalized.name}`;\r\n  if (normalized.number) return `${normalized.number}.`;\r\n  return normalized.name;\r\n}\r\n","http://localhost:4430/shared/grupos-orden.js","// ORDEN VISIBLE DE GRUPOS (2026-10-23, pedido explicito del usuario, GLA).\r\n//\r\n// Dos cosas distintas, a proposito:\r\n//   - SLOT DEL SORTEO: el indice de cada fila dentro de \"grupoN.filas\"\r\n//     (fila 0/1/2 = A1/A2/A3 en grupo1, B1/B2/B3 en grupo2). Es estable:\r\n//     nada de aca reordena el array, y PARTIDOS > SABADO arma sus cruces\r\n//     con ese indice (ver syncBracketCrestsFromGrupos en server/state.js).\r\n//   - POSICION EN LA TABLA: una vista calculada solo para mostrar\r\n//     (Program, Preview y Master Control): mas puntos arriba; entre\r\n//     empatados, el orden oficial de gla.futbol si hay un VALIDAR WEB\r\n//     vigente para exactamente estos datos; si no, el orden de los slots.\r\n//\r\n// Compartido por program/js/renderers/grupos.js y\r\n// master-control/js/grupos-panel.js para que los dos calculen lo mismo.\r\n\r\nexport const GRUPOS_SLOT_LETRA = { grupo1: 'A', grupo2: 'B' };\r\n\r\nexport function slotLabel(grupoKey, index) {\r\n  return `${GRUPOS_SLOT_LETRA[grupoKey] || '?'}${index + 1}`;\r\n}\r\n\r\n// \"-\" o vacio cuentan como 0 (asi se cargan antes de jugar).\r\nexport function puntosValue(puntos) {\r\n  const n = parseFloat(String(puntos ?? '').replace(',', '.'));\r\n  return Number.isFinite(n) ? n : 0;\r\n}\r\n\r\n// Huella de los datos del grupo que importan para el orden: equipos,\r\n// puntos y slots. Si cambia cualquiera, un VALIDAR WEB anterior deja de\r\n// valer (queda \"desactualizado\", nunca se sigue usando en silencio).\r\nexport function firmaGrupo(filas) {\r\n  return JSON.stringify((Array.isArray(filas) ? filas : []).map((f) => [f?.teamId || '', String(f?.puntos ?? '').trim()]));\r\n}\r\n\r\nexport function desempateVigente(data, grupoKey) {\r\n  const desempate = data?.desempateWeb?.[grupoKey];\r\n  if (!desempate || !Array.isArray(desempate.orden)) return null;\r\n  return desempate.firma === firmaGrupo(data?.[grupoKey]?.filas) ? desempate : null;\r\n}\r\n\r\n// true si dos o mas equipos cargados del grupo tienen los mismos puntos.\r\nexport function hayEmpate(filas) {\r\n  const vistos = new Set();\r\n  for (const fila of Array.isArray(filas) ? filas : []) {\r\n    if (!fila?.teamId) continue;\r\n    const pts = puntosValue(fila.puntos);\r\n    if (vistos.has(pts)) return true;\r\n    vistos.add(pts);\r\n  }\r\n  return false;\r\n}\r\n\r\n// Vista ordenada: [{ fila, slot }] (slot = indice original, intacto).\r\nexport function ordenarGrupo(filas, desempate = null) {\r\n  const rank = new Map((desempate?.orden || []).map((teamId, index) => [teamId, index]));\r\n  return (Array.isArray(filas) ? filas : [])\r\n    .map((fila, slot) => ({ fila, slot }))\r\n    .sort((a, b) => {\r\n      const diff = puntosValue(b.fila.puntos) - puntosValue(a.fila.puntos);\r\n      if (diff !== 0) return diff;\r\n      const ra = rank.has(a.fila.teamId) ? rank.get(a.fila.teamId) : Infinity;\r\n      const rb = rank.has(b.fila.teamId) ? rank.get(b.fila.teamId) : Infinity;\r\n      if (ra !== rb) return ra - rb;\r\n      return a.slot - b.slot;\r\n    });\r\n}\r\n","http://localhost:4430/shared/player-name-format.js","export const PLAYER_NAME_FORMAT = Object.freeze({\r\n  NUMBER_NICKNAME: 'numero_apodo',\r\n  NUMBER_INITIAL_LASTNAME: 'numero_inicial_apellido',\r\n});\r\n\r\nfunction clean(value) {\r\n  return String(value ?? '').trim();\r\n}\r\n\r\nfunction initialAndLastName(player) {\r\n  const firstName = clean(player?.nombre);\r\n  const lastName = clean(player?.apellido);\r\n  if (firstName || lastName) {\r\n    const initial = firstName ? `${firstName.charAt(0).toUpperCase()}.` : '';\r\n    return `${initial} ${lastName}`.trim().toUpperCase();\r\n  }\r\n\r\n  const fullName = clean(player?.nombreCompleto || player?.nombreOriginal).replace(/\"[^\"]+\"/g, ' ');\r\n  const words = fullName.split(/\\s+/).filter(Boolean);\r\n  if (words.length <= 1) return fullName.toUpperCase();\r\n  return `${words[0].charAt(0).toUpperCase()}. ${words[words.length - 1]}`.toUpperCase();\r\n}\r\n\r\nexport function formatPlayerName(player, format = PLAYER_NAME_FORMAT.NUMBER_NICKNAME) {\r\n  if (!player) return '';\r\n  const dorsal = clean(player.dorsal);\r\n  const nickname = clean(player.apodo);\r\n  const baseName = format === PLAYER_NAME_FORMAT.NUMBER_NICKNAME && nickname\r\n    ? nickname.toUpperCase()\r\n    : initialAndLastName(player);\r\n  if (!baseName) return dorsal;\r\n  return dorsal ? `${dorsal}. ${baseName}` : baseName;\r\n}\r\n","http://localhost:4430/shared/dom-utils.js","// Utilidades minimas de escape/formato para renderear texto operado en vivo\r\n// sin abrir la puerta a HTML injection desde el Master Control.\r\n\r\nexport function escapeHtml(str) {\r\n  return String(str ?? '').replace(/[&<>\"']/g, (c) => ({\r\n    '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;',\r\n  }[c]));\r\n}\r\n\r\nexport function nl2br(str) {\r\n  return escapeHtml(str)\r\n    .split('\\n')\r\n    .map((line) => line.trim())\r\n    .filter(Boolean)\r\n    .map((line) => `<div>${line}</div>`)\r\n    .join('');\r\n}\r\n","http://localhost:4430/master-control/js/save-position-control.js","// \"GUARDAR POSICI\u00D3N\" \u2014 pieza compartida por composition-control.js y\r\n// text-adjust-control.js (2026-08-31, pedido explicito del usuario: \"no\r\n// quiero implementar esto manualmente 50 veces... us\u00E1 el helper\r\n// compartido\"). Deliberadamente NO cambia como se persiste nada: el\r\n// auto-guardado que ya usa TODO el proyecto (scheduleAutoSave, 80ms\r\n// debounce -> UPDATE -> server/state.js persiste siempre) sigue siendo la\r\n// unica fuente de verdad de que \"nunca se pierde un ajuste\" -- este\r\n// archivo es pura confirmacion/feedback, sin protocolo nuevo de\r\n// WebSocket ni de servidor (decision explicita del usuario: \"prioridad\r\n// absoluta: estabilidad, no modificar la arquitectura WebSocket\r\n// innecesariamente\").\r\n//\r\n// \"onSave\" (requerido si se usa este control): fuerza el flush INMEDIATO\r\n// del auto-guardado pendiente para el modulo (ver \"flushModuleNow\" en\r\n// main.js) en vez de esperar los 80ms del debounce.\r\n// \"isPendingSave\"/\"isConnected\" (opcionales): funciones sin argumentos\r\n// que devuelven el estado REAL del auto-guardado (si todavia hay un\r\n// timer sin disparar) y de la conexion WS -- el indicador \"SIN GUARDAR\"\r\n// se basa en estas se\u00F1ales reales, no en un estado inventado.\r\nconst SAVED_FEEDBACK_MS = 1500;\r\nconst DIRTY_CHECK_INTERVAL_MS = 300;\r\n// Un poco mas que el debounce de scheduleAutoSave (80ms, ver main.js) para\r\n// no marcar \"guardado\" antes de que el envio realmente haya salido.\r\nconst AUTO_SAVE_GRACE_MS = 250;\r\n\r\nexport function renderSavePositionControl(row, { onSave, isPendingSave, isConnected } = {}) {\r\n  if (!onSave) return null;\r\n\r\n  const saveBtn = document.createElement('button');\r\n  saveBtn.type = 'button';\r\n  saveBtn.className = 'text-adjust-save';\r\n  saveBtn.textContent = 'GUARDAR POSICI\u00D3N';\r\n\r\n  const status = document.createElement('span');\r\n  status.className = 'text-adjust-save-status';\r\n\r\n  let dirtySince = null;\r\n  let dirtyPollTimer = null;\r\n  let feedbackTimer = null;\r\n\r\n  function renderStatus() {\r\n    clearTimeout(feedbackTimer);\r\n    if (status.classList.contains('is-saved-flash')) return;\r\n    if (dirtySince !== null && Date.now() - dirtySince > AUTO_SAVE_GRACE_MS) {\r\n      status.textContent = 'SIN GUARDAR';\r\n      status.className = 'text-adjust-save-status is-dirty';\r\n    } else {\r\n      status.textContent = '';\r\n      status.className = 'text-adjust-save-status';\r\n    }\r\n  }\r\n\r\n  function stopDirtyPoll() {\r\n    clearInterval(dirtyPollTimer);\r\n    dirtyPollTimer = null;\r\n  }\r\n\r\n  // Sondea las se\u00F1ales REALES (timer de auto-guardado / conexion WS) en\r\n  // vez de asumir que 80ms alcanzan siempre -- si el WS esta lento o\r\n  // caido, \"SIN GUARDAR\" se queda prendido hasta que de verdad se mande.\r\n  function startDirtyPoll() {\r\n    if (dirtyPollTimer) return;\r\n    dirtyPollTimer = setInterval(() => {\r\n      const stillPending = isPendingSave ? isPendingSave() : false;\r\n      const connected = isConnected ? isConnected() : true;\r\n      if (!stillPending && connected) {\r\n        markClean();\r\n      } else {\r\n        renderStatus();\r\n      }\r\n    }, DIRTY_CHECK_INTERVAL_MS);\r\n  }\r\n\r\n  function markClean() {\r\n    dirtySince = null;\r\n    stopDirtyPoll();\r\n    renderStatus();\r\n  }\r\n\r\n  function markDirty() {\r\n    if (dirtySince === null) dirtySince = Date.now();\r\n    renderStatus();\r\n    startDirtyPoll();\r\n  }\r\n\r\n  saveBtn.addEventListener('click', () => {\r\n    onSave();\r\n    markClean();\r\n    stopDirtyPoll();\r\n    status.textContent = 'POSICI\u00D3N GUARDADA \u2713';\r\n    status.className = 'text-adjust-save-status is-saved-flash';\r\n    feedbackTimer = setTimeout(() => {\r\n      status.className = 'text-adjust-save-status';\r\n      status.textContent = '';\r\n    }, SAVED_FEEDBACK_MS);\r\n  });\r\n\r\n  row.appendChild(saveBtn);\r\n  row.appendChild(status);\r\n\r\n  return { markDirty };\r\n}\r\n","localhost:4430","http://localhost:4430","{\"type\":\"ASSET_VERSIONS\",\"versions\":{\"/assets/marcador/marcador-principal-alpha.mp4\":\"mvtl5va21dic\",\"/assets/eventos/gol-alpha.mp4\":\"mueyjkqk47e6\",\"/assets/marcador/marcador-tiempo-adicional.png\":\"mtiyqsyi951\",\"/assets/marcador/marcador-entretiempo-alpha.mp4\":\"mvtl5vav12ls\",\"/assets/marcador/marcador-penales-alpha.mp4\":\"mtiyquzm18ys\",\"/assets/marcador/marcador-zocalo.png\":\"mtiyqsyi8ga\",\"/assets/eventos/tarjeta-amarilla-alpha.mp4\":\"mueyjkrh193o\",\"/assets/eventos/tarjeta-roja-alpha.mp4\":\"muewqhhd1a2d\",\"/assets/eventos/tarjeta-azul-alpha.mp4\":\"muewqhip1a7z\",\"/assets/eventos/cambios-alpha.mp4\":\"mueyjksp18wt\",\"/assets/var/var-chequeo-alpha.mp4\":\"mtiyqumc22dp\",\"/assets/var/zocalo-cortito-brackets.png\":\"mtiyqt0ka5t\",\"/assets/replay/replay-sponsor-alpha.mp4\":\"mtiyqunm1z3y\",\"/assets/mosca/mosca-localstrike-alpha.mp4\":\"mueyjktz13g0\",\"/assets/zocalos/zocalo-largo-doble-alpha.mp4\":\"mueyjkuw1i6j\",\"/assets/zocalos/zocalo-corto-simple-alpha.mp4\":\"mueww4mg19ax\",\"/assets/zocalos/zocalo-corto-doble-alpha.mp4\":\"mueww4n71kwa\",\"/","{\"type\":\"STATE_SNAPSHOT\",\"state\":{\"scoreboard\":{\"status\":\"OUT\",\"data\":{\"compositionOffsetX\":0,\"compositionOffsetY\":0,\"compositionScale\":1,\"teamA\":\"\",\"teamB\":\"la-32\",\"teamAColor\":\"gris\",\"teamBColor\":\"gris\",\"scoreA\":\"4\",\"scoreB\":\"0\",\"period\":\"1T\",\"clock\":{\"running\":false,\"accumulatedMs\":0,\"startedAt\":null},\"clockEndText\":\"15:00\",\"sponsor\":\"\",\"teamColorAssignments\":{},\"textAdjust\":{\"scoreA\":{\"dx\":0,\"dy\":0,\"dSize\":0},\"scoreB\":{\"dx\":0,\"dy\":0,\"dSize\":0},\"period\":{\"dx\":0,\"dy\":0,\"dSize\":0},\"nameA\":{\"dx\":0,\"dy\":0,\"dSize\":0},\"nameB\":{\"dx\":0,\"dy\":0,\"dSize\":0},\"clock\":{\"dx\":0,\"dy\":0,\"dSize\":0}},\"localCrestOffsetX\":0,\"localCrestOffsetY\":0,\"localCrestScale\":1,\"awayCrestOffsetX\":0,\"awayCrestOffsetY\":0,\"awayCrestScale\":1,\"separatorOffsetX\":0,\"separatorOffsetY\":0,\"separatorScale\":1,\"sponsorOffsetX\":0,\"sponsorOffsetY\":0,\"sponsorScale\":1,\"tipo\":\"amarilla\",\"renglon\":\"normal\"}},\"marcadorTiempoAdicional\":{\"status\":\"OUT\",\"data\":{\"compositionOffsetX\":0,\"compositionOffsetY\":0,\"compositionScale\":1,\"addedMinutes\":\"5\",\"clock\":{\"running\"","{\"type\":\"TEAM_CATALOG_UPDATE\",\"catalog\":[{\"id\":\"ACTRICES\",\"name\":\"Actrices\",\"baseName\":\"Actrices\",\"baseAbbr\":\"ACT\",\"abbr\":\"ACT\",\"isCustom\":false,\"file\":\"/assets/crests/ACTRICES.png\",\"ownFile\":\"ACTRICES.png\",\"crestFile\":\"ACTRICES.png\",\"visible\":true,\"pending\":false},{\"id\":\"argentina-streamers\",\"name\":\"Argentina Streamers\",\"baseName\":\"Argentina Streamers\",\"baseAbbr\":\"ARG\",\"abbr\":\"ARG\",\"isCustom\":false,\"file\":\"/assets/crests/argentina-streamers.png\",\"ownFile\":\"argentina-streamers.png\",\"crestFile\":\"argentina-streamers.png\",\"visible\":true,\"pending\":false},{\"id\":\"argentina-streamers-fem\",\"name\":\"ARGENTINA STREAMERS FEM\",\"baseName\":\"ARGENTINA STREAMERS FEM\",\"baseAbbr\":\"ASF\",\"abbr\":\"ASF\",\"isCustom\":false,\"file\":\"/assets/crests/argentina-streamers-fem.png\",\"ownFile\":\"argentina-streamers-fem.png\",\"crestFile\":\"argentina-streamers-fem.png\",\"visible\":true,\"pending\":false},{\"id\":\"barche\",\"name\":\"Barche\",\"baseName\":\"Barche\",\"baseAbbr\":\"BAR\",\"abbr\":\"BAR\",\"isCustom\":false,\"file\":\"/assets/crests/barche.png\",\"ownFile\":\"barche.p","{\"type\":\"ACTIVE_MATCH_PROFILE_UPDATE\",\"slug\":null,\"name\":null}","http://localhost:4430/program/js/main.js?v=10","import { MODULES, MODULE_IDS } from '../../shared/modules.js';\r\nimport { WS_MSG, MODULE_STATUS } from '../../shared/constants.js';\r\nimport { connect } from '../../shared/ws-client.js';\r\nimport { renderers } from './renderers/index.js';\r\nimport { updateLocalTeamCatalog } from '../../shared/teams.js';\r\nimport { initStageScale } from './stage-scale.js';\r\nimport { waitForProgramFonts } from './program-fonts.js';\r\nimport { setActiveThemeId as setRendererActiveThemeId, getActiveThemeId as getRendererActiveThemeId } from './theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../shared/themes.js';\r\nimport { applyComposition, applyElementAdjustRegistry } from './visual-compose.js';\r\nimport { setAssetVersions } from './asset-versions.js';\r\nimport { modulesUsingPath } from '../../shared/asset-registry.js';\r\nimport {\r\n  HOT_MODULE_IDS, HOT_VARIANT_FIELD, isHotModule, MAX_WARM_SLOTS,\r\n  trackWarm, markPlaying, markWarm, untrack, listEvictable, snapshot as hotPoolSnapshot,\r\n} from './hot-pool.js';\r\nimport {\r\n  TAKE_BURST_WINDOW_MS, TAKE_STAGGER_MS, TAKE_MAX_STAGGER_MS,\r\n  HIGH_STAGGER_MS, HIGH_MAX_STAGGER_MS, HIGH_PRIORITY_IDS, CRITICAL_MODULE_IDS,\r\n  setSchedulerDebug, configureScheduler, getSchedulerConfig,\r\n} from './take-scheduler.js';\r\n\r\n// THEME ACTIVO (2026-08-20/21, sistema multi-theme, pedido expl\u00EDcito): se\r\n// recibe por WS igual que cualquier otro estado global (secci\u00F3n 8, \"no\r\n// quiero tener que refrescar Browser Source\"). \"theme-client.js\" es la\r\n// fuente de verdad real que consultan los renderers (program/js/\r\n// theme-assets.js) para resolver su asset -- ac\u00E1 solo se la mantiene\r\n// actualizada en cada mensaje.\r\n\r\ninitStageScale(document.getElementById('stage'));\r\nawait waitForProgramFonts();\r\n\r\nif (new URLSearchParams(window.location.search).get('debug') === '1') {\r\n  import('./debug-diagnostics.js')\r\n    .then(({ initProgramDiagnostics }) => initProgramDiagnostics(document.getElementById('stage')))\r\n    .catch((error) => console.error('[GLA DEBUG] No se pudo iniciar el diagnostico:', error));\r\n}\r\n\r\nconst els = {};\r\nconst tickers = {};\r\nconst latestData = {};\r\n// \"confirmedData\" (2026-08-19, auditor\u00EDa completa pedida por el usuario:\r\n// \"cuando toco flechitas/+/\u2212 el cambio tiene que verse EN VIVO INMEDIATO,\r\n// sin apretar ACTUALIZAR -- pero el CONTENIDO sigue esperando ACTUALIZAR\").\r\n// Guarda, por m\u00F3dulo, el \u00DALTIMO \"data\" que realmente se pint\u00F3 en pantalla\r\n// (por Take o por ACTUALIZAR expl\u00EDcito) -- es la base \"congelada\" de\r\n// contenido sobre la que se superponen los ajustes visuales en vivo, ver\r\n// \"mergeVisualFields\" m\u00E1s abajo.\r\nconst confirmedData = {};\r\nconst lastStatus = {};\r\nconst exitCleanupTimers = {};\r\n// Estado del secuenciado asset -> contenido de los modulos \"sequencedReveal\"\r\n// (ver shared/modules.js): contentRevealed guarda si \".gfx-overlay\" deberia\r\n// estar visible ahora mismo (independiente de si ya se aplico la clase),\r\n// contentRevealTimers el timer pendiente que la va a revelar tras Tomar al\r\n// aire, y contentExitTimers el timer que espera a que el contenido termine\r\n// de ocultarse antes de recien ahi sacar el asset.\r\nconst contentRevealed = {};\r\nconst contentRevealTimers = {};\r\nconst contentExitTimers = {};\r\n\r\n// Desmontaje compartido de cualquier renderer. Los renderers guardan sus\r\n// handles sobre el nodo \".content\" para no reconstruir video/canvas en cada\r\n// UPDATE o tick. Si se vacia solo el innerHTML, esos handles quedan vivos y\r\n// el siguiente TAKE cree que la estructura todavia existe aunque ya no haya\r\n// nodos para actualizar. El teardown elimina ambas partes juntas: recursos y\r\n// marca de montaje. Asi cada ciclo OUT deja el modulo listo para un TAKE nuevo.\r\n// \"moduleId\" + \"{ force }\" (2026-09-23, Hot Pool -- ver program/js/\r\n// hot-pool.js): para un modulo de la lista Hot Pool, sacarlo del aire NO\r\n// debe destruir video/canvas/contexto -- eso es exactamente el costo que\r\n// la auditoria de performance identifico como el causante del hitch en\r\n// cada TAKE (video recien creado + play() = 100-500ms perdidos; video ya\r\n// montado/cargado + play() = ~0ms). En vez de \"destroy()\" se llama\r\n// \"holdWarm()\" (pausa, sin liberar nada) y se sale ANTES de tocar\r\n// intervals/dataset/innerHTML -- el modulo queda WARM, listo para el\r\n// proximo Take. \"force:true\" salta este atajo (usado al cambiar de theme,\r\n// donde el asset del theme viejo ya no sirve y hay que reconstruir de\r\n// cero para el nuevo) y en la expulsion del Resource Manager\r\n// (enforceWarmBudget) cuando hay que liberar un slot de verdad.\r\n// Devuelve la Promise de \"destroy()\" (ver program/js/alpha-video.js) --\r\n// resuelve cuando el contexto WebGL/video del modulo YA se liberaron de\r\n// verdad, no un numero de ms supuesto. \"undefined\" en cualquier otro caso\r\n// (modulo hot preservado en WARM, o modulo sin \"_alphaVideo\") -- el\r\n// llamador la usa con Promise.all(), que trata \"undefined\" como un valor\r\n// ya resuelto, asi que no hace falta distinguir el caso en cada call site.\r\nfunction teardownContent(content, moduleId, { force = false } = {}) {\r\n  if (!force && isHotModule(moduleId) && content._gfxBuilt) {\r\n    content._alphaVideo?.holdWarm?.();\r\n    content._plainVideo?.holdWarm?.();\r\n    if (moduleId) markWarm(moduleId);\r\n    return undefined;\r\n  }\r\n\r\n  if (content._clockInterval) {\r\n    clearInterval(content._clockInterval);\r\n    delete content._clockInterval;\r\n  }\r\n\r\n  if (content._sponsorRotationInterval) {\r\n    clearInterval(content._sponsorRotationInterval);\r\n    delete content._sponsorRotationInterval;\r\n  }\r\n\r\n  let releasedPromise;\r\n  if (content._alphaVideo) {\r\n    releasedPromise = content._alphaVideo.destroy?.();\r\n    delete content._alphaVideo;\r\n  }\r\n\r\n  if (content._plainVideo) {\r\n    content._plainVideo.destroy?.();\r\n    delete content._plainVideo;\r\n  }\r\n\r\n  // \"_gfxBuilt\" (2026-08-21, sistema multi-theme): marca \"ya arm\u00E9 la\r\n  // estructura\" que usan los renderers migrados a theme-assets.js en vez\r\n  // de \"_alphaVideo\" (que ahora puede ser leg\u00EDtimamente null cuando el\r\n  // theme activo no tiene ese asset todav\u00EDa). Si no se borra ac\u00E1, un\r\n  // renderer creer\u00EDa que el DOM ya est\u00E1 armado despu\u00E9s de un teardown y\r\n  // se saltear\u00EDa \"buildStructure()\" sobre un innerHTML vac\u00EDo.\r\n  delete content._gfxBuilt;\r\n\r\n  for (const key of Object.keys(content.dataset)) {\r\n    delete content.dataset[key];\r\n  }\r\n\r\n  content.innerHTML = '';\r\n  if (moduleId) untrack(moduleId);\r\n  return releasedPromise;\r\n}\r\n\r\nfunction cancelExitCleanup(id) {\r\n  if (exitCleanupTimers[id]) {\r\n    clearTimeout(exitCleanupTimers[id]);\r\n    delete exitCleanupTimers[id];\r\n  }\r\n}\r\n\r\nfunction timeToMs(value) {\r\n  const trimmed = value.trim();\r\n  if (trimmed.endsWith('ms')) return parseFloat(trimmed) || 0;\r\n  if (trimmed.endsWith('s')) return (parseFloat(trimmed) || 0) * 1000;\r\n  return 0;\r\n}\r\n\r\n// Duraciones compartidas del secuenciado asset -> contenido (ver\r\n// --dur-content-delay/--dur-content en program/css/theme.css y\r\n// program/css/overlay.css): se leen del CSS en vez de hardcodear los\r\n// mismos numeros aca, para que tocar el CSS siga siendo la unica fuente de\r\n// verdad de estos tiempos. --dur-content-delay se lee POR MODULO (no una\r\n// sola vez de \":root\"): cada asset con movimiento horneado se asienta en un\r\n// tiempo real distinto (medido con diff de frames reales, ver CHANGELOG.md),\r\n// asi que cada \"#mod-<id>\" en overlay.css define su propio valor \u2014 un\r\n// zocalo rapido no tiene por que esperar lo mismo que una placa grande. Si\r\n// un modulo \"sequencedReveal\" no define el suyo, hereda el default de\r\n// \":root\" (fallback conservador). --dur-content (velocidad del propio\r\n// fundido del contenido, entrada y salida) si es un unico valor compartido:\r\n// no hay evidencia de que necesite variar por modulo.\r\nconst rootStyle = getComputedStyle(document.documentElement);\r\nconst CONTENT_FADE_MS = timeToMs(rootStyle.getPropertyValue('--dur-content'));\r\n\r\nfunction isSequenced(id) {\r\n  return !!MODULES[id].sequencedReveal;\r\n}\r\n\r\n// AJUSTES VISUALES EN VIVO (2026-08-19, auditor\u00EDa completa pedida por el\r\n// usuario: \"cuando toco flechitas/+/\u2212 el cambio tiene que verse EN VIVO\r\n// INMEDIATO... ACTUALIZAR sigue existiendo para contenido/datos, pero los\r\n// AJUSTES VISUALES deben ser live... No mezclar ambas cosas\").\r\n//\r\n// Causa real de que esto NO fuera live: cualquier UPDATE mientras el\r\n// m\u00F3dulo est\u00E1 al aire y NO es \"isExplicitUpdate\" (Take real o clic en\r\n// ACTUALIZAR) se ignora por completo m\u00E1s abajo -- ver el \"if (isOn &&\r\n// msg.isAutoSave...)\" del handler de mensajes -- para no mostrar tipeo a\r\n// medio escribir. Eso es correcto para CONTENIDO, pero de paso tambi\u00E9n\r\n// bloqueaba composici\u00F3n/textAdjust, que es lo que arreglan estas dos\r\n// funciones: \"isVisualKey\" identifica, por NOMBRE de campo (la misma\r\n// convenci\u00F3n que ya usa todo el proyecto: \"compositionOffsetX/Y/Scale\",\r\n// \"motivoOffsetX/Y/Scale\" en VAR, \"offsetX/Y/scale\" por z\u00F3calo en Placa L\r\n// Info, y \"textAdjust\" en cualquier m\u00F3dulo), qu\u00E9 campos son ajuste visual\r\n// puro. \"mergeVisualFields\" arma un objeto que combina el \u00DALTIMO contenido\r\n// realmente confirmado (congelado) con los valores visuales M\u00C1S RECIENTES\r\n// del draft -- as\u00ED se puede volver a invocar el mismo renderer del m\u00F3dulo\r\n// sin repintar ning\u00FAn texto todav\u00EDa no confirmado por ACTUALIZAR, solo su\r\n// posici\u00F3n/tama\u00F1o. Centralizado ac\u00E1 (no en cada renderer ni en cada panel\r\n// de Master Control) porque es el \u00FAnico punto por el que pasan todos los\r\n// m\u00F3dulos por igual.\r\nfunction isVisualKey(key) {\r\n  return key === 'textAdjust' || /OffsetX$/i.test(key) || /OffsetY$/i.test(key) || /Scale$/i.test(key);\r\n}\r\n\r\nfunction mergeVisualFields(confirmed, incoming) {\r\n  if (!incoming || typeof incoming !== 'object' || Array.isArray(incoming)) return confirmed;\r\n  const base = (confirmed && typeof confirmed === 'object') ? confirmed : {};\r\n  const out = { ...base };\r\n  for (const [key, value] of Object.entries(incoming)) {\r\n    if (isVisualKey(key)) {\r\n      out[key] = value;\r\n    } else if (value && typeof value === 'object' && !Array.isArray(value)) {\r\n      out[key] = mergeVisualFields(base[key], value);\r\n    }\r\n    // cualquier otro campo (contenido) se queda con el valor de \"confirmed\"\r\n    // que ya trae \"{ ...base }\" -- nunca se pisa con lo que hay en el draft.\r\n  }\r\n  return out;\r\n}\r\n\r\n// Repinta SOLO composici\u00F3n + textAdjust de un m\u00F3dulo ya al aire, con el\r\n// contenido congelado en su \u00FAltimo valor confirmado -- se llama en cada\r\n// UPDATE en vivo mientras el m\u00F3dulo est\u00E1 ON y todav\u00EDa no lleg\u00F3 su\r\n// ACTUALIZAR expl\u00EDcito (ver handler de mensajes m\u00E1s abajo). No pasa por\r\n// \"applyModuleState\" a prop\u00F3sito: eso re-disparar\u00EDa animaciones de\r\n// entrada/revelado de secuenciado, que no corresponden ac\u00E1 (no es un Take).\r\nfunction applyVisualLive(id, data) {\r\n  const target = els[id];\r\n  if (!target) return;\r\n  applyComposition(target, data, id, latestData);\r\n  applyElementAdjustRegistry(id, target, data, latestData);\r\n  const merged = mergeVisualFields(confirmedData[id], data);\r\n  renderers[id](target.content, merged, false, () => handleOneShotEnded(id), latestData);\r\n}\r\n\r\nfunction cancelContentReveal(id) {\r\n  if (contentRevealTimers[id]) {\r\n    clearTimeout(contentRevealTimers[id]);\r\n    delete contentRevealTimers[id];\r\n  }\r\n}\r\n\r\nfunction cancelContentExit(id) {\r\n  if (contentExitTimers[id]) {\r\n    clearTimeout(contentExitTimers[id]);\r\n    delete contentExitTimers[id];\r\n  }\r\n}\r\n\r\n// querySelectorAll (no querySelector): la mayoria de los modulos tiene un\r\n// unico \".gfx-overlay\", pero algunos (ej. Marcador de Penales, que ademas\r\n// tiene una capa de indicadores de penales por DETRAS del video) tienen mas\r\n// de uno \u2014 los dos tienen que revelarse/ocultarse juntos, o el segundo\r\n// quedaria con opacity:0 para siempre.\r\nfunction setContentVisible(target, visible) {\r\n  const overlays = target.content.querySelectorAll('.gfx-overlay');\r\n  overlays.forEach((overlay) => overlay.classList.toggle('content-in', visible));\r\n}\r\n\r\nfunction exitTransitionMs(root) {\r\n  const style = getComputedStyle(root);\r\n  const durations = style.transitionDuration.split(',').map(timeToMs);\r\n  const delays = style.transitionDelay.split(',').map(timeToMs);\r\n  const count = Math.max(durations.length, delays.length);\r\n  let max = 0;\r\n  for (let i = 0; i < count; i++) {\r\n    max = Math.max(max, durations[i % durations.length] + delays[i % delays.length]);\r\n  }\r\n  return max;\r\n}\r\n\r\nfunction finishOut(id) {\r\n  const target = els[id];\r\n  if (!target || target.root.classList.contains('is-in')) return;\r\n  cancelExitCleanup(id);\r\n  target.root.classList.add('is-hidden');\r\n  teardownContent(target.content, id);\r\n  if (pendingAssetReload.delete(id)) rebuildModuleAssets(id);\r\n}\r\n\r\n// RECURSO GR\u00C1FICO / RECARGAR (SOFTX): un archivo reemplazado se vuelve a\r\n// montar con su URL nueva sin mandar nada al aire. Si el m\u00F3dulo est\u00E1 al aire\r\n// (o saliendo), se espera a que termine de salir: el pr\u00F3ximo TAKE ya usa el\r\n// recurso nuevo y la salida en curso nunca se corta.\r\nconst pendingAssetReload = new Set();\r\n\r\nfunction rebuildModuleAssets(id) {\r\n  const target = els[id];\r\n  if (!target) return;\r\n  const content = target.content;\r\n  const wasWarm = isHotModule(id) && content._gfxBuilt;\r\n  teardownContent(content, id, { force: true });\r\n  if (!wasWarm) return;\r\n  const data = latestData[id] || {};\r\n  renderers[id](content, data, false, () => handleOneShotEnded(id), latestData);\r\n  const field = HOT_VARIANT_FIELD[id];\r\n  trackWarm(id, id, field ? data[field] : undefined);\r\n}\r\n\r\nfunction reloadAssetsForPaths(paths) {\r\n  const systemId = getRendererActiveThemeId();\r\n  const ids = new Set(paths.flatMap((assetPath) => modulesUsingPath(systemId, assetPath)));\r\n  for (const id of ids) {\r\n    const target = els[id];\r\n    if (!target) continue;\r\n    const busy = lastStatus[id] === MODULE_STATUS.ON || !target.root.classList.contains('is-hidden');\r\n    if (busy) pendingAssetReload.add(id);\r\n    else rebuildModuleAssets(id);\r\n  }\r\n}\r\n\r\n// transitionend no esta garantizado si una transicion se interrumpe muchas\r\n// veces con comandos IN/OUT consecutivos. Se conserva como camino normal y\r\n// se agrega un fallback apenas despues de la duracion CSS real. Un TAKE nuevo\r\n// cancela este timer antes de volver a montar/mostrar el modulo.\r\nfunction scheduleExitCleanup(id) {\r\n  cancelExitCleanup(id);\r\n  const target = els[id];\r\n  if (target.root.classList.contains('is-hidden')) {\r\n    finishOut(id);\r\n    return;\r\n  }\r\n  exitCleanupTimers[id] = setTimeout(() => {\r\n    finishOut(id);\r\n  }, exitTransitionMs(target.root) + 100);\r\n}\r\n\r\nfor (const id of MODULE_IDS) {\r\n  const root = document.getElementById(`mod-${id}`);\r\n  if (!root) {\r\n    console.warn(`[GLA] Contenedor DOM para el m\u00F3dulo no encontrado en index.html: mod-${id}. Ignorado.`);\r\n    continue;\r\n  }\r\n  const content = root.querySelector('.content');\r\n  els[id] = { root, content };\r\n\r\n  // Marca, al arrancar, que clase CSS (\"sequenced\" en overlay.css) tiene\r\n  // que secuenciar su contenido -- asi program/index.html y cada renderer\r\n  // no necesitan saber nada de este mecanismo. El delay puntual\r\n  // (--dur-content-delay) YA NO se lee aca: para \"marcadorPenales\" (unico\r\n  // modulo con un valor DISTINTO por theme, ver overlay.css) leerlo en\r\n  // este punto devolvia el valor de GLA -- en el arranque de la pagina\r\n  // \"document.body.dataset.theme\" todavia no existe (el WS ni siquiera\r\n  // conecto), asi que \"body[data-theme='argentinaStreamers'] #mod-...\"\r\n  // nunca podia matchear y el override quedaba cacheado como si nunca\r\n  // hubiera existido (bug real, encontrado 2026-09-01 con un\r\n  // MutationObserver midiendo el timing en vivo: revelaba a ~300ms en vez\r\n  // de los 700ms configurados). Se lee fresco en cada Take en vez -- ver\r\n  // \"getComputedStyle(target.root)...\" mas abajo.\r\n  if (MODULES[id].sequencedReveal) {\r\n    root.classList.add('sequenced');\r\n  }\r\n\r\n  // Al terminar la transicion de salida (opacity llega a 0), recien ahi\r\n  // ocultamos el nodo del todo y limpiamos el contenido.\r\n  root.addEventListener('transitionend', (event) => {\r\n    if (event.propertyName !== 'opacity') return;\r\n    if (!root.classList.contains('is-in')) {\r\n      finishOut(id);\r\n    }\r\n  });\r\n}\r\n\r\n// \"mergeVisualFields(confirmedData[id], latestData[id])\" en vez de\r\n// \"latestData[id]\" a secas (2026-09-02, causa real de que texto1/texto2 de\r\n// Z\u00F3calo Compuesto con Equipos/Logo se vieran al aire ANTES de apretar\r\n// ACTUALIZAR): este ticker existe para que un m\u00F3dulo \"live:true\" (ej.\r\n// escudos/nombres que dependen de \"scoreboard\") se repinte solo cuando\r\n// cambia esa data EXTERNA -- que llega siempre por el 5to argumento\r\n// (\"latestData\", sin tocar ac\u00E1), nunca por el 2do (\"data\", el propio\r\n// estado del m\u00F3dulo). Pasarle \"latestData[id]\" crudo como 2do argumento\r\n// respond\u00EDa bien a eso, pero de paso tambi\u00E9n volv\u00EDa a pintar CUALQUIER\r\n// autosave de contenido sin confirmar (isAutoSave, ver el handler de\r\n// WS_MSG.MODULE_UPDATE m\u00E1s abajo) cada 500ms, pisando por completo la\r\n// protecci\u00F3n de \"applyVisualLive\"/\"isVisualKey\" que ya exist\u00EDa para el\r\n// mensaje en s\u00ED. Con el merge, el 2do argumento vuelve a ser\r\n// \"contenido congelado + visual m\u00E1s reciente\" -- exactamente lo mismo que\r\n// ya usa \"applyVisualLive\" -- as\u00ED que ning\u00FAn m\u00F3dulo \"live\" pierde su\r\n// reactividad a \"scoreboard\" (sigue viniendo del 5to argumento), solo se\r\n// deja de repintar contenido todav\u00EDa no confirmado.\r\nfunction startTicker(id) {\r\n  if (tickers[id]) return;\r\n  tickers[id] = setInterval(() => {\r\n    const data = mergeVisualFields(confirmedData[id], latestData[id]);\r\n    renderers[id](els[id].content, data, false, undefined, latestData);\r\n    // ESCUDO POR EQUIPO (2026-10-09, bug real corregido, SOLO Argentina\r\n    // Streamers): si el equipo cambia en el Marcador con este modulo al\r\n    // aire, el repintado de arriba cambia el escudo pero la posicion/escala\r\n    // propia de ese equipo (\"crestByTeam\") recien se aplicaba con el\r\n    // proximo cambio del modulo -- quedaba la geometria del equipo\r\n    // anterior. Se reaplica en el mismo tick que el escudo.\r\n    if (getRendererActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID) {\r\n      applyElementAdjustRegistry(id, els[id], data, latestData);\r\n    }\r\n  }, 500);\r\n}\r\n\r\nfunction stopTicker(id) {\r\n  if (tickers[id]) {\r\n    clearInterval(tickers[id]);\r\n    tickers[id] = null;\r\n  }\r\n}\r\n\r\n// Los modulos \"oneShot\" (ver shared/modules.js) traen su propia animacion de\r\n// entrada Y salida adentro del video (ej. un festejo de gol, una transicion).\r\n// Cuando el video termina, el renderer llama a esta funcion para avisarle al\r\n// servidor que el modulo tiene que volver a OUT solo \u2014 asi el estado que ve\r\n// el Master Control (EN AIRE / FUERA) siempre coincide con lo que se ve\r\n// realmente en el render, sin que el operador tenga que apretar Sacar.\r\nlet ws;\r\nfunction handleOneShotEnded(id) {\r\n  ws.send({ type: WS_MSG.OUT, moduleId: id });\r\n}\r\n\r\n// GOL SIGUE AL MARCADOR (2026-10-21, SOLO GLA -- ver\r\n// composedCompositionData en program/js/visual-compose.js): cada vez que\r\n// cambia el Marcador se recalcula la composicion de GOL, este al aire o no\r\n// (queda lista para el proximo disparo y, si se esta reproduciendo, lo\r\n// acompa\u00F1a en vivo). Solo cambia el transform: no toca el video.\r\nfunction syncGolComposition() {\r\n  if (!els.gol || !latestData.gol) return;\r\n  applyComposition(els.gol, latestData.gol, 'gol', latestData);\r\n}\r\n\r\nfunction applyModuleState(id, moduleState) {\r\n  const target = els[id];\r\n  if (!target || !moduleState) return;\r\n\r\n  latestData[id] = moduleState.data;\r\n  confirmedData[id] = moduleState.data;\r\n  applyComposition(target, moduleState.data, id, latestData);\r\n  const sequenced = isSequenced(id);\r\n\r\n  if (moduleState.status === MODULE_STATUS.ON) {\r\n    cancelExitCleanup(id);\r\n    // \"justTaken\": recien paso de OUT a ON en esta misma actualizacion (un\r\n    // Take real, no un tick de reloj ni una Actualizacion en caliente). Solo\r\n    // en ese caso algunos renderers (ej. el Marcador) reproducen su animacion\r\n    // de entrada desde el principio.\r\n    const justTaken = lastStatus[id] !== MODULE_STATUS.ON;\r\n\r\n    // Hot Pool: marca el slot como PLAYING (nunca se expulsa mientras lo\r\n    // est\u00E9, ver listEvictable en hot-pool.js) apenas el m\u00F3dulo pasa a ON,\r\n    // sea porque ya estaba WARM (el caso com\u00FAn) o porque nunca pas\u00F3 por el\r\n    // pool -- trackWarm()/markPlaying() con la misma key (\"id\") no rompen\r\n    // nada si la key todav\u00EDa no exist\u00EDa en el registro.\r\n    if (isHotModule(id)) markPlaying(id);\r\n\r\n    if (sequenced && justTaken) {\r\n      // Ciclo nuevo: cancela cualquier revelado/salida pendiente de un\r\n      // ciclo anterior y arranca oculto otra vez \u2014 el contenido no debe\r\n      // verse hasta que el asset termine de asentarse.\r\n      cancelContentReveal(id);\r\n      cancelContentExit(id);\r\n      contentRevealed[id] = false;\r\n    }\r\n\r\n    // 5to argumento: snapshot de datos de TODOS los modulos (misma\r\n    // referencia que latestData). Solo lo usa marcadorEntretiempo hoy,\r\n    // para leer en vivo los datos de \"scoreboard\" sin duplicarlos.\r\n    renderers[id](target.content, moduleState.data, justTaken, () => handleOneShotEnded(id), latestData);\r\n    // Despues de \"renderers[id]\" a proposito (no junto a \"applyComposition\"\r\n    // mas arriba): en un TAKE recien ahi existen los nodos \"[data-adjust]\"\r\n    // que el renderer acaba de construir -- ver applyVisualLive() mas\r\n    // arriba para el caso \"modulo ya al aire\", donde el orden inverso es\r\n    // correcto porque la estructura ya existia de antes.\r\n    applyElementAdjustRegistry(id, target, moduleState.data, latestData);\r\n\r\n    if (sequenced) {\r\n      // Autocurativo: algunos renderers reconstruyen \".gfx-overlay\" en un\r\n      // UPDATE que cambia de variante (ej. Tarjeta cambia de color, VS\r\n      // cambia de renglon) sin que sea un Take nuevo \u2014 si el contenido ya\r\n      // estaba revelado, el nodo reconstruido tiene que heredar ese estado\r\n      // en vez de quedar oculto esperando un Take que no va a llegar.\r\n      setContentVisible(target, contentRevealed[id] === true);\r\n      if (justTaken) {\r\n        // Leido FRESCO en cada Take (no cacheado al arrancar la pagina,\r\n        // ver comentario en el \"for\" de mas arriba) -- para\r\n        // \"marcadorPenales\" esto resuelve el valor correcto segun el\r\n        // theme activo EN ESTE MOMENTO (\"body[data-theme='...']\" ya esta\r\n        // seteado para cualquier Take real, a diferencia del arranque).\r\n        const delayMs = timeToMs(getComputedStyle(target.root).getPropertyValue('--dur-content-delay'));\r\n        contentRevealTimers[id] = setTimeout(() => {\r\n          delete contentRevealTimers[id];\r\n          contentRevealed[id] = true;\r\n          setContentVisible(target, true);\r\n        }, delayMs);\r\n      }\r\n    }\r\n\r\n    target.root.classList.remove('is-hidden');\r\n    void target.root.offsetWidth; // fuerza reflow: registra el estado \"afuera\" antes de animar\r\n    target.root.classList.add('is-in');\r\n    if (MODULES[id].live) startTicker(id);\r\n  } else {\r\n    // Burst/Take Scheduler (2026-09-25, seccion 7 del pedido -- ver\r\n    // program/js/take-scheduler.js): cancela YA MISMO un Take que\r\n    // todavia estuviera esperando su turno escalonado, sin esperar a que\r\n    // termine la animacion de salida (--dur-content/--dur-out, mas abajo\r\n    // en esta misma rama, pueden tardar mucho mas que un stagger corto).\r\n    // No toca reproduccion ya en curso -- ver \"cancelPendingTake()\" en\r\n    // alpha-video.js.\r\n    target.content._alphaVideo?.cancelPendingTake?.();\r\n    stopTicker(id);\r\n    if (sequenced) {\r\n      // Orden inverso pedido: primero se apaga el contenido, y solo\r\n      // despues de que termina su propio fundido (--dur-content) se saca\r\n      // el asset \u2014 asi nunca queda texto/escudo flotando sin fondo.\r\n      cancelContentReveal(id);\r\n      cancelContentExit(id);\r\n      contentRevealed[id] = false;\r\n      setContentVisible(target, false);\r\n      contentExitTimers[id] = setTimeout(() => {\r\n        delete contentExitTimers[id];\r\n        target.root.classList.remove('is-in');\r\n        scheduleExitCleanup(id);\r\n      }, CONTENT_FADE_MS);\r\n    } else {\r\n      target.root.classList.remove('is-in');\r\n      scheduleExitCleanup(id);\r\n    }\r\n  }\r\n\r\n  lastStatus[id] = moduleState.status;\r\n}\r\n\r\nlet lastKnownThemeId = null;\r\n\r\n// HOT POOL: precalienta (COLD -> WARM) los modulos de HOT_MODULE_IDS que\r\n// esten apagados y todavia sin construir -- ver program/js/hot-pool.js\r\n// para el contrato completo. Llamar al renderer normal del modulo con\r\n// \"justTaken=false\" alcanza: el mismo guard \"if (!contentEl._gfxBuilt)\r\n// buildStructure(...)\" que YA tiene cada renderer arma video/canvas/\r\n// contexto (el <video> con preload=\"auto\" empieza a cargar solo) y NUNCA\r\n// llama a \"playFromStart()\" salvo que justTaken sea true o cambie la\r\n// variante (ver el fix de \"*Changed\" en program/js/renderers/{tarjeta,vs,\r\n// shortDouble,formacionEquipos}.js) -- ninguno de los dos pasa aca, asi\r\n// que el video queda cargado y PAUSADO: WARM, no PLAYING. Se llama\r\n// despues de procesar un STATE_SNAPSHOT completo (arranque de Program, o\r\n// tras un cambio de theme que ya forz\u00F3 el teardown de todo, ver mas\r\n// abajo), nunca antes: necesita \"latestData\"/\"els\" ya poblados.\r\nfunction warmHotModules() {\r\n  for (const id of HOT_MODULE_IDS) {\r\n    const target = els[id];\r\n    if (!target) continue;\r\n    if (lastStatus[id] === MODULE_STATUS.ON) continue; // ya esta PLAYING, nada que precargar\r\n    const content = target.content;\r\n    if (content._gfxBuilt) continue; // ya WARM (idempotente: boot + cada cambio de theme llaman esto)\r\n    const data = latestData[id] || {};\r\n    renderers[id](content, data, false, () => handleOneShotEnded(id), latestData);\r\n    const field = HOT_VARIANT_FIELD[id];\r\n    trackWarm(id, id, field ? data[field] : undefined);\r\n  }\r\n  enforceWarmBudget();\r\n}\r\n\r\n// RESOURCE MANAGER (2026-09-23, pedido explicito del usuario: \"no quiero\r\n// que esta optimizacion termine cargando ilimitadamente VRAM\"): si hay mas\r\n// slots WARM que MAX_WARM_SLOTS, expulsa (destruye de verdad, vuelve a\r\n// COLD) los MENOS usados recientemente -- listEvictable() ya excluye\r\n// cualquier modulo \"playing\" (al aire) y \"gol\" (maxima prioridad, ver\r\n// PROTECTED_MODULE_IDS en hot-pool.js). Con la lista de fabrica esto no\r\n// expulsa nada en operacion normal (el presupuesto ya la cubre entera);\r\n// existe como techo de seguridad real ante una lista mal configurada, y se\r\n// ejercita a proposito en las pruebas de estres del informe.\r\nfunction enforceWarmBudget() {\r\n  for (const id of listEvictable(MAX_WARM_SLOTS)) {\r\n    const target = els[id];\r\n    if (!target) { untrack(id); continue; }\r\n    teardownContent(target.content, id, { force: true });\r\n  }\r\n}\r\n\r\n// HOT POOL + VARIANTES (2026-09-23, pedido explicito del usuario, secci\u00F3n\r\n// 9 -- \"reemplazo seguro cuando cambia variante\"): si el operador cambia\r\n// la variante de un m\u00F3dulo del Hot Pool (ej. el color de Tarjeta) ANTES de\r\n// mandarlo al aire, se reconstruye el WARM con la variante nueva de\r\n// inmediato -- para cuando llegue el Take real ya est\u00E1 lista. Sin esto el\r\n// Take seguir\u00EDa siendo correcto (el fix de \"*Changed\" en el renderer ya lo\r\n// garantiza) pero pagar\u00EDa el hitch de arranque en fr\u00EDo para esa variante\r\n// puntual. No pinta contenido din\u00E1mico (crests/texto): eso lo hace el\r\n// pr\u00F3ximo Take real con los datos vigentes en ese momento.\r\nfunction maybeRewarmOffAirVariant(id, data) {\r\n  const field = HOT_VARIANT_FIELD[id];\r\n  if (!field || !isHotModule(id)) return;\r\n  const target = els[id];\r\n  if (!target) return;\r\n  const content = target.content;\r\n  if (!content._gfxBuilt) return; // todavia no esta WARM -- lo arma warmHotModules() en su momento\r\n  const newVariant = data ? data[field] : undefined;\r\n  if (content.dataset[field] === newVariant) return;\r\n  teardownContent(content, id, { force: true });\r\n  renderers[id](content, data || {}, false, () => handleOneShotEnded(id), latestData);\r\n  trackWarm(id, id, newVariant);\r\n}\r\n\r\n// \"handleStateSnapshot\" (2026-09-26, WebGL context management -- pedido\r\n// explicito: \"1. cancelar Takes pendientes; 2. detener reproducci\u00F3n del\r\n// theme viejo; 3. liberar recursos/contextos del theme viejo; 4. confirmar\r\n// que baj\u00F3 la cantidad de contextos vivos; 5. reci\u00E9n entonces comenzar el\r\n// warm-up del theme nuevo... no crear primero los nuevos y destruir los\r\n// viejos 200ms despu\u00E9s\"). Antes, \"warmHotModules()\" corr\u00EDa en la MISMA\r\n// vuelta sincr\u00F3nica que el teardown forzado -- pero la liberaci\u00F3n real del\r\n// contexto WebGL de \"destroy()\" est\u00E1 deliberadamente diferida (2 rAF o\r\n// 200ms, ver program/js/alpha-video.js, fix del parpadeo blanco) para NO\r\n// tocar el decodificador/contexto hasta que el navegador asent\u00F3 el cambio\r\n// visual. Con Hot Pool (~9-10 contextos siempre vivos) eso significaba que\r\n// \"warmHotModules()\" creaba los ~9 contextos del theme NUEVO ANTES de que\r\n// los ~9 del theme VIEJO llegaran a liberarse -- pico real de hasta ~18,\r\n// justo el warning \"Too many active WebGL contexts\" confirmado en la\r\n// auditor\u00EDa anterior. Ahora se espera la Promise real de cada\r\n// \"destroy()\" (resuelve exactamente cuando ese release ya ocurri\u00F3, no un\r\n// n\u00FAmero de ms supuesto -- ver \"releasedPromise\" en alpha-video.js) antes\r\n// de tocar nada del theme nuevo: determinista, sin adivinar un timeout.\r\n//\r\n// \"async\" es seguro ac\u00E1 porque el propio \"pendingSnapshotChain\" (ver mas\r\n// abajo, en el listener real) serializa las llamadas -- si dos\r\n// STATE_SNAPSHOT llegaran muy seguidos (dos cambios de theme r\u00E1pidos), el\r\n// segundo espera a que el primero termine su propio await antes de\r\n// empezar, en vez de interlazarse.\r\nasync function handleStateSnapshot(msg) {\r\n  // El theme se fija ANTES de recorrer los m\u00F3dulos: cada renderer\r\n  // resuelve su asset (program/js/theme-assets.js) leyendo el theme\r\n  // activo en el momento exacto en que se lo vuelve a invocar ac\u00E1.\r\n  const themeChanged = msg.theme && lastKnownThemeId !== null && msg.theme !== lastKnownThemeId;\r\n  if (msg.theme) {\r\n    setRendererActiveThemeId(msg.theme);\r\n    lastKnownThemeId = msg.theme;\r\n  }\r\n  if (themeChanged) {\r\n    // Cambio de theme real (no la conexi\u00F3n inicial): un m\u00F3dulo que YA\r\n    // est\u00E1 montado (\".av-target\"/\"._alphaVideo\" construidos con el\r\n    // asset del theme ANTERIOR) no se reconstruye solo -- cada\r\n    // renderer solo arma su estructura una vez (\"if (!contentEl.\r\n    // _alphaVideo) buildStructure(...)\"). Se fuerza un teardown+\r\n    // rebuild ac\u00E1, centralizado, para que el asset (o su ausencia) del\r\n    // theme NUEVO se vuelva a resolver -- sin tocar la l\u00F3gica interna\r\n    // de ning\u00FAn renderer.\r\n    const releasePromises = [];\r\n    for (const id of MODULE_IDS) {\r\n      // \"force:true\": un cambio de theme real invalida el asset\r\n      // montado (pertenece al theme VIEJO) incluso para los modulos\r\n      // del Hot Pool -- se destruyen de verdad aca, \"warmHotModules()\"\r\n      // los vuelve a precalentar mas abajo ya con el theme nuevo.\r\n      if (els[id]) {\r\n        const p = teardownContent(els[id].content, id, { force: true });\r\n        if (p) releasePromises.push(p);\r\n      }\r\n    }\r\n    // Punto 3+4 del pedido: esperar el release REAL de todos los contextos\r\n    // viejos (nunca un timeout adivinado) antes de seguir. Con la pesta\u00F1a\r\n    // visible esto resuelve en 1-2 frames (~16-33ms); en el peor caso\r\n    // (pesta\u00F1a oculta, rAF suspendido) tarda hasta 200ms, el mismo techo\r\n    // que ya exist\u00EDa -- ver comentario del fallback en alpha-video.js.\r\n    await Promise.all(releasePromises);\r\n  }\r\n  // Punto 5: reci\u00E9n ahora se pinta el estado real y se calienta el theme\r\n  // nuevo -- los contextos viejos ya estan liberados (o el modulo nunca\r\n  // tuvo uno, ej. sin cambio de theme).\r\n  for (const id of MODULE_IDS) applyModuleState(id, msg.state[id]);\r\n  syncGolComposition();\r\n  warmHotModules();\r\n}\r\n\r\n// Serializa los STATE_SNAPSHOT entre si (ver comentario de\r\n// \"handleStateSnapshot\" arriba) -- sin esto, dos cambios de theme muy\r\n// seguidos podr\u00EDan interlazar sus propios \"await\" y pisarse el teardown/\r\n// warm-up entre ellos. \".catch\" evita que un error en uno deje la cadena\r\n// rota para siempre (los STATE_SNAPSHOT futuros seguir\u00EDan llegando).\r\nlet pendingSnapshotChain = Promise.resolve();\r\n\r\nws = connect({\r\n  onMessage(msg) {\r\n    if (msg.type === 'TEAM_CATALOG_UPDATE') {\r\n      updateLocalTeamCatalog(msg.catalog);\r\n      for (const id of MODULE_IDS) {\r\n        if (lastStatus[id] === MODULE_STATUS.ON && els[id]) {\r\n          renderers[id](els[id].content, latestData[id] || {}, false, () => handleOneShotEnded(id), latestData);\r\n        }\r\n      }\r\n    } else if (msg.type === WS_MSG.ASSET_VERSIONS) {\r\n      setAssetVersions(msg.versions);\r\n      if (msg.changedPaths?.length) reloadAssetsForPaths(msg.changedPaths);\r\n    } else if (msg.type === WS_MSG.THEME_UPDATE) {\r\n      setRendererActiveThemeId(msg.themeId);\r\n    } else if (msg.type === WS_MSG.STATE_SNAPSHOT) {\r\n      pendingSnapshotChain = pendingSnapshotChain\r\n        .then(() => handleStateSnapshot(msg))\r\n        .catch((err) => console.error('[GLA] Error procesando STATE_SNAPSHOT:', err));\r\n    } else if (msg.type === WS_MSG.MODULE_UPDATE) {\r\n      const isOn = msg.moduleState && msg.moduleState.status === MODULE_STATUS.ON;\r\n      if (isOn && msg.isAutoSave && !msg.isExplicitUpdate) {\r\n        // Ignorar CONTENIDO en directo mientras la gr\u00E1fica est\u00E1 al aire (no\r\n        // repintar tipeo a medio escribir) -- pero los AJUSTES VISUALES\r\n        // (composici\u00F3n + textAdjust) s\u00ED tienen que verse ya, sin esperar a\r\n        // ACTUALIZAR (ver \"applyVisualLive\" m\u00E1s arriba).\r\n        latestData[msg.moduleId] = msg.moduleState.data;\r\n        applyVisualLive(msg.moduleId, msg.moduleState.data);\r\n        if (msg.moduleId === 'scoreboard') syncGolComposition();\r\n        return;\r\n      }\r\n      if (!isOn) maybeRewarmOffAirVariant(msg.moduleId, msg.moduleState && msg.moduleState.data);\r\n      applyModuleState(msg.moduleId, msg.moduleState, msg.isExplicitUpdate);\r\n      if (msg.moduleId === 'scoreboard') syncGolComposition();\r\n    }\r\n  },\r\n});\r\n\r\n// Introspecci\u00F3n de solo lectura del Hot Pool (2026-09-23) -- diagn\u00F3stico\r\n// operativo y las mediciones del informe de auditor\u00EDa, sin herramientas\r\n// adicionales: abrir devtools en Program y llamar\r\n// \"window.__glaHotPool.snapshot()\" muestra cada m\u00F3dulo del pool con su\r\n// estado (warm/playing), variante y \u00FAltimo uso.\r\nwindow.__glaHotPool = {\r\n  HOT_MODULE_IDS,\r\n  MAX_WARM_SLOTS,\r\n  snapshot: hotPoolSnapshot,\r\n};\r\n\r\n// Introspecci\u00F3n + debug del Burst/Take Scheduler (2026-09-25, ver\r\n// program/js/take-scheduler.js) -- \"setDebug(true)\" logea cada decisi\u00F3n de\r\n// timing en consola (\"[TAKE-SCHEDULER] ...\") sin ensuciar producci\u00F3n por\r\n// default (arranca apagado). Mismos par\u00E1metros que usa el scheduler\r\n// (config centralizada, ver take-scheduler.js) expuestos de solo lectura.\r\nwindow.__glaTakeScheduler = {\r\n  TAKE_BURST_WINDOW_MS,\r\n  TAKE_STAGGER_MS,\r\n  TAKE_MAX_STAGGER_MS,\r\n  HIGH_STAGGER_MS,\r\n  HIGH_MAX_STAGGER_MS,\r\n  CRITICAL_MODULE_IDS: [...CRITICAL_MODULE_IDS],\r\n  HIGH_PRIORITY_IDS: [...HIGH_PRIORITY_IDS],\r\n  setDebug: setSchedulerDebug,\r\n  configure: configureScheduler,\r\n  getConfig: getSchedulerConfig,\r\n};\r\n\r\n// Introspecci\u00F3n de contextos WebGL (2026-09-26, WebGL context management --\r\n// pedido explicito seccion 8: \"medir cantidad de contextos WebGL activos...\r\n// durante cambio de theme... pico maximo\"). Recorre los <canvas> realmente\r\n// montados en el DOM ahora mismo -- no hay ningun registro paralelo que\r\n// mantener, un canvas \".alpha-video-canvas\" solo existe mientras su modulo\r\n// esta WARM o PLAYING (ver program/js/alpha-video.js/hot-pool.js), asi que\r\n// contarlos ES contar contextos vivos.\r\nwindow.__glaWebGL = {\r\n  countLive() {\r\n    return document.querySelectorAll('canvas').length;\r\n  },\r\n  list() {\r\n    return [...document.querySelectorAll('canvas')].map((c) => {\r\n      const gl = c.getContext('webgl');\r\n      return { moduleId: c.closest('[id^=\"mod-\"]')?.id?.replace('mod-', '') || null, contextLost: gl ? gl.isContextLost() : null };\r\n    });\r\n  },\r\n};\r\n","http://localhost:4430/program/js/renderers/index.js","import vs from './vs.js';\r\nimport scoreboard from './scoreboard.js';\r\nimport marcadorTiempoAdicional from './marcadorTiempoAdicional.js';\r\nimport marcadorEntretiempo from './marcadorEntretiempo.js';\r\nimport marcadorPenales from './marcadorPenales.js';\r\nimport marcadorZocalo from './marcadorZocalo.js';\r\nimport sideTable from './sideTable.js';\r\n// DESACTIVADO TEMPORALMENTE junto con su entrada en shared/modules.js (ver\r\n// ese archivo) \u2014 descomentar esta linea y la del registro mas abajo para\r\n// reactivar. El archivo longSimple.js no se toco.\r\n// import longSimple from './longSimple.js';\r\nimport longDouble from './longDouble.js';\r\nimport shortSimple from './shortSimple.js';\r\nimport shortDouble from './shortDouble.js';\r\nimport varCheck from './varCheck.js';\r\nimport replay from './replay.js';\r\nimport bug from './bug.js';\r\nimport formacionEquipos from './formacionEquipos.js';\r\nimport vsPrepartido from './vsPrepartido.js';\r\nimport vsResultado from './vsResultado.js';\r\nimport tarjeta from './tarjeta.js';\r\nimport cambios from './cambios.js';\r\nimport gol from './gol.js';\r\nimport grupos from './grupos.js';\r\nimport estrellas from './estrellas.js';\r\nimport posiciones from './posiciones.js';\r\nimport { goleadores, asistidores, jugadores } from './performanceTable.js';\r\nimport fichaJugador from './fichaJugador.js';\r\n// BRACKETS (2026-09-02, handoff de un agente concurrente -- ver\r\n// docs/PATCH_SHARED_CLAUDE.md). Su patch pedia registrarlos en un objeto\r\n// \"RENDERERS\" dentro de program/js/main.js, pero ese archivo no tiene tal\r\n// objeto -- el registro real de renderers es este archivo (program/js/main.js\r\n// importa \"renderers\" desde aca). Se registran aca para que su intencion\r\n// (renderer real, sin tocar su codigo) funcione con la arquitectura vigente.\r\nimport cronogramaHoy from './cronogramaHoy.js';\r\nimport resultadosParciales from './resultadosParciales.js';\r\nimport historial from './historial.js';\r\nimport zocaloFinalDiv from './zocaloFinalDiv.js';\r\nimport zocaloFinal from './zocaloFinal.js';\r\nimport zocaloCompuesto from './zocaloCompuesto.js';\r\nimport zocaloCompuestoEquipos from './zocaloCompuestoEquipos.js';\r\nimport zocaloCompuestoLogo from './zocaloCompuestoLogo.js';\r\nimport sitioWebPromoL from './sitioWebPromoL.js';\r\nimport zocaloVs from './zocaloVs.js';\r\n\r\n// Registro de funciones de render: id de modulo -> (contentEl, data, justTaken, onOneShotEnded) => void\r\nexport const renderers = {\r\n  vs,\r\n  scoreboard,\r\n  marcadorTiempoAdicional,\r\n  marcadorEntretiempo,\r\n  marcadorPenales,\r\n  marcadorZocalo,\r\n  sideTable,\r\n  // longSimple, // DESACTIVADO TEMPORALMENTE \u2014 ver comentario junto al import mas arriba.\r\n  longDouble,\r\n  shortSimple,\r\n  shortDouble,\r\n  varCheck,\r\n  replay,\r\n  bug,\r\n  formacionEquipos,\r\n  vsPrepartido,\r\n  vsResultado,\r\n  tarjeta,\r\n  cambios,\r\n  gol,\r\n  grupos,\r\n  estrellas,\r\n  posiciones,\r\n  posicionesTorneo: posiciones,\r\n  goleadores,\r\n  asistidores,\r\n  jugadores,\r\n  fichaJugador,\r\n  cronogramaHoy,\r\n  resultadosParciales,\r\n  historial,\r\n  zocaloFinalDiv,\r\n  zocaloFinal,\r\n  zocaloCompuesto,\r\n  zocaloCompuestoEquipos,\r\n  zocaloCompuestoLogo,\r\n  sitioWebPromoL,\r\n  zocaloVs,\r\n};\r\n","http://localhost:4430/program/js/stage-scale.js","// Escala \"#stage\" (composicion logica fija de 1920x1080, ver overlay.css)\r\n// como una unica unidad al tama\u00F1o real del viewport -- nunca recalcula\r\n// fuentes/assets/posiciones por separado, un solo factor de escala para\r\n// todo el stage. Corrige la causa raiz reportada por el usuario\r\n// (2026-08-13): \"document.documentElement\" (viewport real) y\r\n// \"document.body\" (antes fijado a 1920x1080px) quedaban desincronizados en\r\n// cualquier PC cuya ventana no midiera exactamente 1920x1080 fisicos --\r\n// el stage se recortaba en vez de escalarse.\r\nconst STAGE_WIDTH = 1920;\r\nconst STAGE_HEIGHT = 1080;\r\n\r\nexport function initStageScale(stage) {\r\n  function applyScale() {\r\n    const vw = window.innerWidth;\r\n    const vh = window.innerHeight;\r\n    // Guardia (2026-08-31, causa raiz real de \"Program se ve distinto en\r\n    // vMix/Chrome/Preview\" reportado por el usuario): en ciertos hosts que\r\n    // EMBEBEN Program (vMix Browser Source via CEF es el caso confirmado;\r\n    // tambien reproducible a mano con cualquier resize del propio\r\n    // navegador que llegue ANTES de que el viewport termine de asentar su\r\n    // tama\u00F1o final) el primer calculo -- o alguno posterior -- puede\r\n    // correr con innerWidth/innerHeight todavia en 0. Sin esta guardia\r\n    // \"scale\" quedaba literalmente en 0 (stage colapsado/invisible) y\r\n    // JAMAS se recalculaba si ese host no llega a disparar un evento\r\n    // 'resize' de verdad al asentar su tama\u00F1o real -- exactamente el\r\n    // sintoma reportado (Preview, cuyo tama\u00F1o de iframe es estable desde\r\n    // el primer render, nunca lo sufre; vMix/Chrome, cuya ventana puede\r\n    // asentarse en mas de un paso, si). No commitear un scale invalido:\r\n    // reintentar en el siguiente frame en vez de dejar el stage roto.\r\n    if (!vw || !vh) {\r\n      // \"setTimeout\", no \"requestAnimationFrame\": rAF puede quedar en\r\n      // pausa indefinida en una pesta\u00F1a/frame que el navegador considera\r\n      // no-visible o sin composicion activa (confirmado en pruebas) --\r\n      // \"scale\" quedaba entonces sin commitear NUNCA. setTimeout sigue\r\n      // disparando igual en ese caso, asi el reintento no puede quedar\r\n      // colgado para siempre.\r\n      setTimeout(applyScale, 50);\r\n      return;\r\n    }\r\n    const scale = Math.min(vw / STAGE_WIDTH, vh / STAGE_HEIGHT);\r\n    const offsetX = (vw - STAGE_WIDTH * scale) / 2;\r\n    const offsetY = (vh - STAGE_HEIGHT * scale) / 2;\r\n    stage.style.left = `${offsetX}px`;\r\n    stage.style.top = `${offsetY}px`;\r\n    stage.style.transform = `scale(${scale})`;\r\n  }\r\n\r\n  applyScale();\r\n  window.addEventListener('resize', applyScale);\r\n  // ResizeObserver sobre <html> (2026-08-31, causa raiz real): mas\r\n  // confiable que el 'resize' de arriba en embeddings donde el host\r\n  // cambia el tama\u00F1o de la ventana/frame SIN que el navegador llegue a\r\n  // disparar ese evento (confirmado: vMix Browser Source via CEF) --\r\n  // observa el tama\u00F1o real del viewport en si mismo, sin importar la\r\n  // causa del cambio. No reemplaza al listener de 'resize', lo\r\n  // complementa: cubre exactamente los casos donde ese evento se pierde.\r\n  if (typeof ResizeObserver !== 'undefined') {\r\n    const ro = new ResizeObserver(() => applyScale());\r\n    ro.observe(document.documentElement);\r\n  }\r\n  // Red de seguridad final (2026-08-31, verificado en pruebas: ni\r\n  // 'resize' ni ResizeObserver dispararon de forma confiable en al menos\r\n  // un entorno real de prueba tras un cambio de tama\u00F1o -- no se pudo\r\n  // confirmar la causa exacta, pero el resultado observado es el mismo\r\n  // sintoma reportado: el stage queda con la escala vieja). Un poll\r\n  // liviano (1x/segundo, dos comparaciones numericas) que solo actua si\r\n  // el tama\u00F1o realmente cambio desde el ultimo calculo aplicado --\r\n  // garantiza que Program se autocorrija en como maximo ~1s en CUALQUIER\r\n  // host, sin importar si dispara algun evento de resize o no. Costo\r\n  // insignificante frente a la garantia de \"nunca se queda mal escalado\".\r\n  let lastVw = window.innerWidth;\r\n  let lastVh = window.innerHeight;\r\n  setInterval(() => {\r\n    if (window.innerWidth !== lastVw || window.innerHeight !== lastVh) {\r\n      lastVw = window.innerWidth;\r\n      lastVh = window.innerHeight;\r\n      applyScale();\r\n    }\r\n  }, 1000);\r\n}\r\n","http://localhost:4430/program/js/program-fonts.js","import { getActiveThemeId } from './theme-client.js';\r\n\r\nconst FONT_PROBE = 'GLA AaBb 0123456789 \u00C1\u00C9\u00CD\u00D3\u00DA\u00D1';\r\n\r\n// Una entrada por theme: \"family\" es el nombre interno que declara el\r\n// @font-face correspondiente en program/css/theme.css (nunca depende de\r\n// que esa fuente este instalada en el sistema operativo). \"weights\" son\r\n// los pesos que el resto del codigo pide via ctx.font/document.fonts.load\r\n// -- igual que ya pasaba con GLA Anton (un unico archivo real, pedido a\r\n// varios pesos), el navegador resuelve todos ellos a la unica cara\r\n// declarada sin sintetizar un trazo mas grueso.\r\nconst THEME_FONTS = {\r\n  gla: { family: '\"GLA Anton\"', weights: [400, 600, 700, 800, 900] },\r\n  argentinaStreamers: { family: '\"LIVE Segoe Bold\"', weights: [400, 600, 700, 800, 900] },\r\n};\r\n\r\nconst DEFAULT_FONT = THEME_FONTS.gla;\r\n\r\n// \"GLA_SEGOE_BOLD\" (2026-09-24, pedido explicito del usuario: \"Zocalo\r\n// Largo Simple/Corto Simple/Corto Doble/Compuesto deben usar Segoe UI\r\n// Bold, exclusivamente en GLA\"). Reutiliza el MISMO archivo .ttf ya\r\n// cargado para Argentina Streamers (assets/themes/argentina-streamers/\r\n// fonts/Segoe-UI-Bold.ttf, ver @font-face en program/css/theme.css) bajo\r\n// un nombre interno DISTINTO -- no se duplica el archivo (pedido\r\n// explicito: \"no cambiar assets\"), solo se declara una segunda vez con un\r\n// nombre propio para que este cambio quede conceptualmente separado de\r\n// \"la fuente de Argentina Streamers\" (que sigue siendo 100% independiente,\r\n// puede cambiar sin afectar esto y viceversa) aunque el byte a byte sea\r\n// igual hoy. \"GLA_SEGOE_BOLD_FACE\" es el nombre pelado (para precargar\r\n// con document.fonts.load, ver waitForProgramFonts) y\r\n// \"GLA_SEGOE_BOLD_FAMILY\" el stack completo pedido por el usuario (con\r\n// fallback a la Segoe UI del sistema operativo y despues Arial/sans-serif)\r\n// para usar en CSS/medicion de texto.\r\nexport const GLA_SEGOE_BOLD_FACE = '\"GLA Segoe Bold\"';\r\nexport const GLA_SEGOE_BOLD_FAMILY = `${GLA_SEGOE_BOLD_FACE}, \"Segoe UI\", Arial, sans-serif`;\r\n\r\n// \"GLA Segoe Regular\" (2026-10-22, pedido explicito del usuario: todo el\r\n// texto dinamico de Marcador, Entretiempo, Tiempo Adicional, Marcador\r\n// Zocalo, motivo de VAR, zocalos, Tarjeta, Cambios, titulo de Partidos,\r\n// tablas y posiciones de GLA en Segoe UI Regular 400; ver @font-face y\r\n// \"--gla-font-ui\" en program/css/theme.css). Envuelve las opciones de\r\n// medicion de esos modulos para que lo que se MIDE (ancho y correccion\r\n// vertical) coincida con lo que se pinta: en GLA fuerza la familia del\r\n// token CSS \"--gla-font-ui\" (la misma declaracion que pinta, no una copia)\r\n// y peso 400; en cualquier otro theme devuelve las opciones intactas\r\n// (Argentina Streamers sin cambios). GLA_SEGOE_REGULAR_FAMILY es solo el\r\n// respaldo si el token no se pudiera leer.\r\nexport const GLA_SEGOE_REGULAR_FACE = '\"GLA Segoe Regular\"';\r\nexport const GLA_SEGOE_REGULAR_FAMILY = `${GLA_SEGOE_REGULAR_FACE}, \"Segoe UI\", Arial, sans-serif`;\r\n\r\nfunction glaUiFontFamily() {\r\n  const token = getComputedStyle(document.body).getPropertyValue('--gla-font-ui').trim();\r\n  return token || GLA_SEGOE_REGULAR_FAMILY;\r\n}\r\n\r\nexport function withGlaSegoeRegular(opts) {\r\n  if (getActiveThemeId() !== 'gla') return opts;\r\n  return { ...opts, family: glaUiFontFamily(), weight: 400 };\r\n}\r\n\r\n// Reemplaza al viejo export estatico \"PROGRAM_FONT_FAMILY\" (2026-09-01,\r\n// integracion de fuente propia para Argentina Streamers): Program puede\r\n// cambiar de theme en caliente (WS THEME_UPDATE/STATE_SNAPSHOT, sin\r\n// recargar la pagina -- ver program/js/main.js), asi que la familia de\r\n// fuente para medir/pintar texto tiene que leerse en el momento de cada\r\n// uso, no fijarse una sola vez al cargar el modulo.\r\nexport function getProgramFontFamily() {\r\n  const themeId = getActiveThemeId();\r\n  return (THEME_FONTS[themeId] || DEFAULT_FONT).family;\r\n}\r\n\r\n// Precarga TODAS las fuentes de TODOS los themes (no solo la del theme\r\n// activo): esta funcion corre en program/js/main.js antes de que el WS\r\n// entregue el theme activo real (ver comentario ahi), y ademas el theme\r\n// puede cambiar despues sin recargar -- precargar todo de entrada es la\r\n// unica forma de garantizar que un cambio de theme en caliente nunca\r\n// muestre un flash con fuente de reemplazo.\r\nexport async function waitForProgramFonts() {\r\n  const specs = Object.entries(THEME_FONTS).flatMap(([themeId, { family, weights }]) =>\r\n    weights.map((weight) => ({ themeId, family, weight }))\r\n  );\r\n  // \"GLA Segoe Bold\" (ver mas arriba) no es la fuente de NINGUN theme\r\n  // completo -- se precarga aparte, una sola vez, al unico peso real que\r\n  // declara su @font-face (700), mismo criterio que ya vale para \"GLA\r\n  // Anton\"/\"LIVE Segoe Bold\" (un unico archivo real detras).\r\n  specs.push({ themeId: 'gla (modulos Segoe Bold)', family: GLA_SEGOE_BOLD_FACE, weight: 700 });\r\n  const loadedFaces = await Promise.all(\r\n    specs.map(({ family, weight }) => document.fonts.load(`${weight} 32px ${family}`, FONT_PROBE))\r\n  );\r\n  await document.fonts.ready;\r\n\r\n  const failed = specs.filter((_, i) => loadedFaces[i].length === 0 || loadedFaces[i].some((face) => face.status !== 'loaded'));\r\n  if (failed.length > 0) {\r\n    const names = [...new Set(failed.map((f) => `${f.family} (theme ${f.themeId})`))].join(', ');\r\n    throw new Error(`No se pudieron cargar las fuentes locales de PROGRAM: ${names}.`);\r\n  }\r\n\r\n  document.documentElement.classList.add('program-fonts-ready');\r\n}\r\n","http://localhost:4430/program/js/visual-compose.js","import { ADJUST_REGISTRY } from '../../shared/adjust-registry.js';\r\nimport { DEFAULT_THEME_ID } from '../../shared/themes.js';\r\nimport { applyElementAdjust } from './text-fit.js';\r\nimport { getActiveThemeId } from './theme-client.js';\r\n\r\n// FUENTE UNICA DE VERDAD para \"AJUSTE DE COMPOSICI\u00D3N\" (2026-09-26, pedido\r\n// explicito del usuario: \"Preview y Program deben renderizar EXACTAMENTE\r\n// la misma composici\u00F3n... no quiero dos sistemas de render\"). Extraido de\r\n// program/js/main.js (donde vivia hasta ahora, unico consumidor real) para\r\n// que program/js/preview-main.js pueda aplicar la MISMA logica en vez de\r\n// una copia -- cualquier fix futuro a como se interpreta un offset/scale\r\n// se escribe una sola vez y beneficia a los dos buses (Program real y\r\n// Preview) por igual.\r\n//\r\n// \"AJUSTE DE COMPOSICI\u00D3N\": posicion X/Y + escala de TODO un modulo como\r\n// una unidad rigida, capa ADICIONAL sobre el dise\u00F1o base (\"posicion final\r\n// = base + offset\", \"escala final = base \u00D7 ajuste\") -- ver shared/\r\n// modules.js (compositionOffsetX/Y/Scale, mezclados en cloneDefaults()\r\n// para cualquier modulo) y master-control/js/composition-control.js (UI).\r\n//\r\n// Se aplica sobre \".content\" (NO sobre \"#mod-<id>\"), a proposito: varios\r\n// modulos ya tienen su PROPIO \"transform\" declarado en CSS sobre\r\n// \"#mod-<id>\" para su posicion de dise\u00F1o (ej. \"#mod-marcadorZocalo\",\r\n// \"#mod-shortDouble\") -- pisarlo con estilo inline desde aca borraria esa\r\n// posicion base. \".content\" es el nodo que cada renderer llena via\r\n// \"contentEl.innerHTML\" (ver program/js/renderers/*.js): ningun renderer\r\n// toca jamas \"contentEl.style\" directamente, asi que este es el UNICO\r\n// punto de la cadena que puede reclamar esa propiedad sin colisionar con\r\n// nada existente.\r\n//\r\n// GOL SIGUE AL MARCADOR (2026-10-21, pedido explicito del usuario, SOLO\r\n// GLA): la animacion de GOL acompa\u00F1a cualquier ajuste de composicion del\r\n// MARCADOR PRINCIPAL. Su propio \"compositionOffsetX/Y/Scale\" pasa a ser el\r\n// AJUSTE FINO RELATIVO al Marcador:\r\n//   posicion final = desplazamiento del Marcador + ajuste propio de GOL\r\n//   escala final   = escala del Marcador \u00D7 ajuste propio de GOL\r\n// Los dos modulos son \"full stage\" con el mismo transform-origin\r\n// (960,540, ver \".content\" en overlay.css), asi que sumar el mismo\r\n// desplazamiento/escala conserva exactamente su relacion visual. Se usan\r\n// los valores VIGENTES del Marcador (los mismos que pinta Program), nunca\r\n// su base guardada: GUARDAR POSICI\u00D3N del Marcador no mueve nada. Argentina\r\n// Streamers conserva su GOL independiente, sin cambios.\r\nexport function composedCompositionData(moduleId, data, allData) {\r\n  if (moduleId !== 'gol' || getActiveThemeId() !== DEFAULT_THEME_ID) return data;\r\n  const sb = allData?.scoreboard;\r\n  if (!sb) return data;\r\n  return {\r\n    compositionOffsetX: (sb.compositionOffsetX || 0) + (data.compositionOffsetX || 0),\r\n    compositionOffsetY: (sb.compositionOffsetY || 0) + (data.compositionOffsetY || 0),\r\n    compositionScale: (sb.compositionScale || 1) * (data.compositionScale || 1),\r\n  };\r\n}\r\n\r\nexport function applyComposition(target, data, moduleId, allData) {\r\n  const source = moduleId ? composedCompositionData(moduleId, data, allData) : data;\r\n  const dx = source.compositionOffsetX || 0;\r\n  const dy = source.compositionOffsetY || 0;\r\n  const scale = source.compositionScale || 1;\r\n  target.content.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;\r\n}\r\n\r\n// Registro declarativo de ajuste individual (ver shared/adjust-registry.js\r\n// para el contrato completo). Corre SIEMPRE junto a \"applyComposition\" para\r\n// cualquier modulo con entradas \"kind:'composition'\" en su registro.\r\n// Resuelve, para un elemento \"crestTeam\", el override POR EQUIPO guardado\r\n// en \"data.crestByTeam\" -- null si no hay equipo resuelto o si ese equipo\r\n// todavia no tiene una posicion propia guardada. El teamId sale SIEMPRE\r\n// del Marcador (\"allData.scoreboard.teamA/teamB\", el mismo criterio que ya\r\n// usan estos renderers para el escudo en si). \"allData\" es la misma\r\n// referencia que Program llama \"latestData\" (snapshot de todos los\r\n// modulos) y Preview arma desde el \"draft\" completo de Master Control --\r\n// ambos exponen \"allData.scoreboard\" con la misma forma.\r\nfunction resolveCrestTeamOverride(entry, data, allData) {\r\n  const sb = allData?.scoreboard;\r\n  if (!sb) return null;\r\n  let slot;\r\n  let teamId;\r\n  if (entry.crestTeam === 'dynamic') {\r\n    const isVisitante = data.equipo === 'visitante';\r\n    slot = isVisitante ? 'away' : 'local';\r\n    teamId = isVisitante ? sb.teamB : sb.teamA;\r\n  } else if (entry.crestTeam === 'B') {\r\n    slot = 'away';\r\n    teamId = sb.teamB;\r\n  } else {\r\n    slot = 'local';\r\n    teamId = sb.teamA;\r\n  }\r\n  // \"crestSlot\" (Z\u00D3CALO VS, 2026-10-09): slot propio por variante en vez de\r\n  // local/away -- el equipo sigue saliendo del mismo lado del Marcador.\r\n  if (entry.crestSlot) slot = entry.crestSlot;\r\n  return (teamId && data.crestByTeam?.[slot]?.[teamId]) || null;\r\n}\r\n\r\nexport function applyElementAdjustRegistry(id, target, data, allData) {\r\n  const entries = ADJUST_REGISTRY[id]?.elements;\r\n  if (!entries || !entries.length) return;\r\n  for (const entry of entries) {\r\n    if (entry.kind !== 'composition') continue;\r\n    // \"querySelectorAll\" (no \"querySelector\"): cubre tanto el caso de un\r\n    // unico elemento (escudo/logo/sponsor puntual) como el de tablas con\r\n    // filas repetidas -- un mismo id \"data-adjust\" puede marcar VARIOS\r\n    // nodos (una fila cada uno), y el mismo offset de columna se les\r\n    // aplica a todos por igual.\r\n    const els = target.content.querySelectorAll(`[data-adjust=\"${entry.id}\"]`);\r\n    if (!els.length) continue;\r\n    const override = entry.crestTeam ? resolveCrestTeamOverride(entry, data, allData) : null;\r\n    const source = override || data;\r\n    const adjustValue = {\r\n      offsetX: source[entry.xKey],\r\n      offsetY: source[entry.yKey],\r\n      scale: source[entry.scaleKey],\r\n    };\r\n    els.forEach((el) => applyElementAdjust(el, adjustValue));\r\n  }\r\n}\r\n","http://localhost:4430/program/js/theme-client.js","// THEME ACTIVO del lado de Program (2026-08-21, sistema multi-theme etapa\r\n// 2). \u00DAnica fuente de verdad del theme activo para los renderers -- se\r\n// actualiza desde program/js/main.js (THEME_UPDATE / STATE_SNAPSHOT) y lo\r\n// consulta program/js/theme-assets.js para resolver qu\u00E9 asset le\r\n// corresponde a cada m\u00F3dulo. Separado en su propio archivo (no una\r\n// variable local de main.js) porque los 25 renderers de\r\n// program/js/renderers/*.js son m\u00F3dulos ES independientes que necesitan\r\n// leer este valor sin importar main.js entero.\r\nimport { DEFAULT_THEME_ID } from '../../shared/themes.js';\r\n\r\nlet activeThemeId = DEFAULT_THEME_ID;\r\n\r\nexport function getActiveThemeId() {\r\n  return activeThemeId;\r\n}\r\n\r\nexport function setActiveThemeId(themeId) {\r\n  activeThemeId = themeId || DEFAULT_THEME_ID;\r\n  // Espejo en el DOM del theme activo (mismo patr\u00F3n que ya usa\r\n  // master-control/css/master.css con \"body[data-theme='...']\") para que\r\n  // program/css/overlay.css pueda tener reglas de geometr\u00EDa espec\u00EDficas de\r\n  // un theme sin tocar las reglas (theme-agn\u00F3sticas) que ya usa GLA.\r\n  if (typeof document !== 'undefined' && document.body) {\r\n    document.body.dataset.theme = activeThemeId;\r\n  }\r\n}\r\n","http://localhost:4430/shared/asset-registry.js","// REGISTRO CENTRAL DE RECURSOS GR\u00C1FICOS (SOFTX, 2026-10-29).\r\n// Una entrada por sistema -> m\u00F3dulo -> recurso. ID p\u00FAblico de cada recurso:\r\n// \"<sistema>.<moduleId>.<recurso>\" (ej. \"gla.scoreboard.principal\",\r\n// \"gla.tarjeta.amarilla\"). Master Control y el servidor solo intercambian\r\n// ese ID: la ruta real se resuelve siempre ac\u00E1 (nunca llega del navegador).\r\n//\r\n// GLA REL\u00C1MPAGO: las rutas viven SOLO en GLA_ASSETS (abajo); los renderers\r\n// de program/js/renderers/*.js las leen con glaAssetPath().\r\n// ARGENTINA STREAMERS: se derivan del manifest que ya exist\u00EDa en\r\n// shared/themes.js (THEMES.argentinaStreamers.assets) -- mismo archivo que\r\n// consumen sus renderers, sin copiar ninguna ruta.\r\nimport { THEMES, DEFAULT_THEME_ID, ARGENTINA_STREAMERS_THEME_ID } from './themes.js';\r\n\r\nexport const ASSET_KIND = {\r\n  ALPHA_VIDEO: 'alpha-video',\r\n  IMAGE: 'image',\r\n};\r\n\r\n// Formato que el runtime actual necesita (no se convierte nada solo).\r\nexport const ASSET_KIND_INFO = {\r\n  [ASSET_KIND.ALPHA_VIDEO]: {\r\n    label: 'VIDEO CON ALFA',\r\n    expected: 'MP4 H.264 con alfa apilado (color arriba, m\u00E1scara abajo)',\r\n  },\r\n  [ASSET_KIND.IMAGE]: {\r\n    label: 'IMAGEN',\r\n    expected: 'PNG (con transparencia si la pieza la necesita)',\r\n  },\r\n};\r\n\r\nconst V = ASSET_KIND.ALPHA_VIDEO;\r\nconst I = ASSET_KIND.IMAGE;\r\n\r\n// \"cssVar\": el recurso se usa desde program/css/overlay.css; Program fija\r\n// esa variable con la URL versionada (ver program/js/asset-versions.js).\r\nconst GLA_ASSETS = {\r\n  scoreboard: [{ slot: 'principal', label: 'Principal', path: '/assets/marcador/marcador-principal-alpha.mp4', kind: V }],\r\n  gol: [{ slot: 'principal', label: 'Gol', path: '/assets/eventos/gol-alpha.mp4', kind: V }],\r\n  marcadorTiempoAdicional: [{ slot: 'principal', label: 'Tiempo adicional', path: '/assets/marcador/marcador-tiempo-adicional.png', kind: I }],\r\n  marcadorEntretiempo: [{ slot: 'principal', label: 'Entretiempo', path: '/assets/marcador/marcador-entretiempo-alpha.mp4', kind: V }],\r\n  marcadorPenales: [{ slot: 'principal', label: 'Penales', path: '/assets/marcador/marcador-penales-alpha.mp4', kind: V }],\r\n  marcadorZocalo: [{ slot: 'principal', label: 'Marcador z\u00F3calo', path: '/assets/marcador/marcador-zocalo.png', kind: I }],\r\n  tarjeta: [\r\n    { slot: 'amarilla', label: 'Amarilla', path: '/assets/eventos/tarjeta-amarilla-alpha.mp4', kind: V },\r\n    { slot: 'roja', label: 'Roja', path: '/assets/eventos/tarjeta-roja-alpha.mp4', kind: V },\r\n    { slot: 'azul', label: 'Azul', path: '/assets/eventos/tarjeta-azul-alpha.mp4', kind: V },\r\n  ],\r\n  cambios: [{ slot: 'principal', label: 'Cambios', path: '/assets/eventos/cambios-alpha.mp4', kind: V }],\r\n  varCheck: [\r\n    { slot: 'principal', label: 'VAR chequeo', path: '/assets/var/var-chequeo-alpha.mp4', kind: V },\r\n    { slot: 'motivo', label: 'Motivo (z\u00F3calo)', path: '/assets/var/zocalo-cortito-brackets.png', kind: I },\r\n  ],\r\n  replay: [{ slot: 'principal', label: 'Replay', path: '/assets/replay/replay-sponsor-alpha.mp4', kind: V }],\r\n  bug: [{ slot: 'principal', label: 'Mosca', path: '/assets/mosca/mosca-localstrike-alpha.mp4', kind: V }],\r\n  longDouble: [{ slot: 'principal', label: 'Z\u00F3calo largo doble', path: '/assets/zocalos/zocalo-largo-doble-alpha.mp4', kind: V }],\r\n  shortSimple: [{ slot: 'principal', label: 'Z\u00F3calo corto simple', path: '/assets/zocalos/zocalo-corto-simple-alpha.mp4', kind: V }],\r\n  shortDouble: [{ slot: 'principal', label: 'Z\u00F3calo corto doble', path: '/assets/zocalos/zocalo-corto-doble-alpha.mp4', kind: V }],\r\n  vs: [\r\n    { slot: 'normal', label: 'Normal', path: '/assets/zocalos/zocalo-vs-alpha.mp4', kind: V },\r\n    { slot: 'alto', label: 'Rengl\u00F3n alto', path: '/assets/zocalos/zocalo-vs-renglon-alto-alpha.mp4', kind: V },\r\n    { slot: 'medio', label: 'Rengl\u00F3n medio', path: '/assets/zocalos/zocalo-vs-renglon-medio-alpha.mp4', kind: V },\r\n    { slot: 'fino', label: 'Rengl\u00F3n fino', path: '/assets/zocalos/zocalo-vs-renglon-fino-alpha.mp4', kind: V },\r\n  ],\r\n  zocaloCompuesto: [\r\n    { slot: 'equipos', label: 'Tipo equipos', path: '/assets/zocalos/zocalo-final-div-alpha.mp4', kind: V },\r\n    { slot: 'logo', label: 'Tipo logo', path: '/assets/zocalos/zocalo-final-alpha.mp4', kind: V },\r\n    { slot: 'logoImagen', label: 'Logo GLA', path: '/assets/images/gla-logo.png', kind: I },\r\n  ],\r\n  zocaloFinal: [\r\n    { slot: 'principal', label: 'Z\u00F3calo final', path: '/assets/zocalos/zocalo-final-alpha.mp4', kind: V },\r\n    { slot: 'logoImagen', label: 'Logo GLA', path: '/assets/images/gla-logo.png', kind: I },\r\n  ],\r\n  zocaloFinalDiv: [{ slot: 'principal', label: 'Z\u00F3calo final con equipos', path: '/assets/zocalos/zocalo-final-div-alpha.mp4', kind: V }],\r\n  vsPrepartido: [{ slot: 'principal', label: 'VS prepartido', path: '/assets/placas/vs-prepartido-alpha.mp4', kind: V }],\r\n  vsResultado: [{ slot: 'principal', label: 'VS con resultado', path: '/assets/placas/vs-resultado-alpha.mp4', kind: V }],\r\n  estrellas: [{ slot: 'principal', label: 'Estrellas', path: '/assets/placas/estrellas-alpha.mp4', kind: V }],\r\n  formacionEquipos: [\r\n    { slot: 'principal', label: 'Placa', path: '/assets/placas/formacion-equipos.mp4', kind: V },\r\n    { slot: 'camisetas', label: 'Camisetas', path: '/assets/placas/formacion-camisetas.png', kind: I },\r\n    { slot: 'camisetasBlancas', label: 'Camisetas (m\u00E1scara de color)', path: '/assets/placas/formacion-camisetas-blancas.png', kind: I, cssVar: '--softx-asset-formacion-camisetas-blancas' },\r\n  ],\r\n  grupos: [\r\n    { slot: 'grupo1', label: 'Grupo 1', path: '/assets/grupos/grupo-1.png', kind: I },\r\n    { slot: 'grupo2', label: 'Grupo 2', path: '/assets/grupos/grupo-2.png', kind: I },\r\n  ],\r\n  sideTable: [{ slot: 'fondo', label: 'Fondo', path: '/assets/tablas/resultados-sin-vs.png', kind: I, cssVar: '--softx-asset-resultados-fondo' }],\r\n  // posiciones/posicionesTorneo comparten renderer y archivos: las p\u00E1ginas\r\n  // 2 y 3 usan el mismo video.\r\n  posiciones: [\r\n    { slot: 'pagina1', label: 'P\u00E1gina 1', path: '/assets/tablas/posiciones-alpha.mp4', kind: V },\r\n    { slot: 'pagina2', label: 'P\u00E1ginas 2 y 3', path: '/assets/tablas/posiciones-5-alpha.mp4', kind: V },\r\n  ],\r\n  posicionesTorneo: [\r\n    { slot: 'pagina1', label: 'P\u00E1gina 1', path: '/assets/tablas/posiciones-alpha.mp4', kind: V },\r\n    { slot: 'pagina2', label: 'P\u00E1ginas 2 y 3', path: '/assets/tablas/posiciones-5-alpha.mp4', kind: V },\r\n  ],\r\n  goleadores: [{ slot: 'principal', label: 'Tabla goleadores', path: '/assets/tablas/tabla-goleadores.png', kind: I }],\r\n  asistidores: [{ slot: 'principal', label: 'Tabla asistidores', path: '/assets/tablas/tabla-asistidores.png', kind: I }],\r\n  jugadores: [{ slot: 'principal', label: 'Tabla jugadores', path: '/assets/tablas/mejores-jugadores.png', kind: I }],\r\n};\r\n\r\n// M\u00F3dulos sin pesta\u00F1a propia cuyos recursos se muestran dentro de otro\r\n// panel (GOL se dispara desde MARCADOR; el motivo del VAR y el logo del\r\n// z\u00F3calo compuesto AS viven en entradas propias del manifest).\r\nconst PANEL_LINKS = {\r\n  scoreboard: ['gol'],\r\n  varCheck: ['varCheckMotivo'],\r\n  zocaloCompuestoEquipos: ['zocaloCompuestoLogo'],\r\n};\r\n\r\nconst AS_LABELS = {\r\n  gol: { principal: 'Gol' },\r\n  varCheckMotivo: { principal: 'Motivo (z\u00F3calo)' },\r\n  zocaloCompuestoEquipos: { principal: 'Tipo equipos' },\r\n  zocaloCompuestoLogo: { principal: 'Tipo logo', imagen: 'Logo' },\r\n};\r\n\r\nfunction kindForPath(path) {\r\n  return /\\.(mp4|webm|mov)$/i.test(path) ? V : I;\r\n}\r\n\r\nfunction prettyKey(key) {\r\n  return key.replace(/[-_]+/g, ' ').replace(/^\\w/, (c) => c.toUpperCase());\r\n}\r\n\r\nfunction deriveFromThemeManifest(themeId) {\r\n  const out = {};\r\n  for (const [moduleId, asset] of Object.entries(THEMES[themeId]?.assets || {})) {\r\n    if (!asset || typeof asset !== 'object') continue;\r\n    const slots = [];\r\n    const seen = new Set();\r\n    const labels = AS_LABELS[moduleId] || {};\r\n    const push = (slot, label, path) => {\r\n      if (typeof path !== 'string' || !path.startsWith('/assets/') || seen.has(path)) return;\r\n      seen.add(path);\r\n      slots.push({ slot, label: labels[slot] || label, path, kind: kindForPath(path) });\r\n    };\r\n    for (const [key, path] of Object.entries(asset.variants || {})) push(key, prettyKey(key), path);\r\n    push('principal', 'Principal', asset.video);\r\n    push('imagen', 'Imagen', asset.image);\r\n    for (const path of Object.values(asset.formationAssetsByTeam || {})) {\r\n      const file = path.split('/').pop().replace(/\\.[^.]+$/, '');\r\n      push(`kit-${file}`, `Camisetas ${file.replace(/^formacion-/, '').toUpperCase()}`, path);\r\n    }\r\n    if (slots.length) out[moduleId] = slots;\r\n  }\r\n  return out;\r\n}\r\n\r\nconst REGISTRY = {\r\n  [DEFAULT_THEME_ID]: GLA_ASSETS,\r\n  [ARGENTINA_STREAMERS_THEME_ID]: deriveFromThemeManifest(ARGENTINA_STREAMERS_THEME_ID),\r\n};\r\n\r\nfunction withId(systemId, moduleId, entry) {\r\n  return { ...entry, id: `${systemId}.${moduleId}.${entry.slot}`, systemId, moduleId };\r\n}\r\n\r\n// Ruta GLA de un recurso puntual -- la usan los renderers en vez de una\r\n// constante propia. Un ID inexistente es un error de programaci\u00F3n (falla\r\n// fuerte en vez de dejar el m\u00F3dulo sin gr\u00E1fica en silencio).\r\nexport function glaAssetPath(moduleId, slot) {\r\n  const entry = GLA_ASSETS[moduleId]?.find((e) => e.slot === slot);\r\n  if (!entry) throw new Error(`[SOFTX] Recurso GLA no registrado: ${moduleId}.${slot}`);\r\n  return entry.path;\r\n}\r\n\r\nexport function getModuleAssets(systemId, moduleId) {\r\n  return (REGISTRY[systemId]?.[moduleId] || []).map((entry) => withId(systemId, moduleId, entry));\r\n}\r\n\r\n// Recursos que muestra el panel RECURSO GR\u00C1FICO de un m\u00F3dulo (propios +\r\n// m\u00F3dulos vinculados sin pesta\u00F1a).\r\nexport function getPanelAssets(systemId, moduleId) {\r\n  const own = getModuleAssets(systemId, moduleId);\r\n  const linked = (PANEL_LINKS[moduleId] || []).flatMap((linkedId) => getModuleAssets(systemId, linkedId));\r\n  return [...own, ...linked];\r\n}\r\n\r\nexport function listSystemAssets(systemId) {\r\n  return Object.keys(REGISTRY[systemId] || {}).flatMap((moduleId) => getModuleAssets(systemId, moduleId));\r\n}\r\n\r\nexport function getAssetById(assetId) {\r\n  const [systemId, moduleId, slot] = String(assetId || '').split('.');\r\n  if (!systemId || !moduleId || !slot) return null;\r\n  const entry = REGISTRY[systemId]?.[moduleId]?.find((e) => e.slot === slot);\r\n  return entry ? withId(systemId, moduleId, entry) : null;\r\n}\r\n\r\n// M\u00F3dulos (de un sistema) que usan una ruta dada -- Program los recarga\r\n// cuando ese archivo cambia, aunque lo compartan varios m\u00F3dulos.\r\nexport function modulesUsingPath(systemId, path) {\r\n  const out = [];\r\n  for (const [moduleId, slots] of Object.entries(REGISTRY[systemId] || {})) {\r\n    if (slots.some((e) => e.path === path)) out.push(moduleId);\r\n  }\r\n  return out;\r\n}\r\n\r\nexport function listCssVarAssets() {\r\n  return Object.entries(REGISTRY).flatMap(([systemId, modules]) => Object.entries(modules)\r\n    .flatMap(([moduleId, slots]) => slots.filter((e) => e.cssVar).map((e) => withId(systemId, moduleId, e))));\r\n}\r\n","http://localhost:4430/program/js/take-scheduler.js","// BURST / TAKE SCHEDULER (2026-09-25, siguiente etapa de la optimizacion de\n// performance -- ver informe de auditoria 2026-09-21/23). El Hot Pool (ver\n// program/js/hot-pool.js) ya elimina el costo de CREAR/CARGAR un video en\n// cada Take; el cuello de botella que quedaba, medido con evidencia real,\n// es distinto: cuando VARIOS modulos de video hacen Take casi al mismo\n// instante, cada uno abre su PROPIA sesion de decodificacion de hardware\n// -- eso satura algo a nivel driver/GPU independientemente de si el\n// archivo ya estaba cargado (6 modulos WARM simultaneos: ~285ms de frame\n// maximo). Escalonar esos \"video.play()\" unos pocos milisegundos entre si\n// (sin tocar nada del resto del pipeline: estado, DOM, contenido dinamico\n// siguen siendo 100% inmediatos) bajo ese pico en la prueba exploratoria\n// de 285ms a ~97ms con 60ms de paso.\n//\n// Este modulo NO decide \"si\" reproducir -- eso lo sigue decidiendo cada\n// renderer/alpha-video.js exactamente igual que siempre. Solo decide\n// \"cu\u00E1ndo\" (0ms si no hay r\u00E1faga, un peque\u00F1o delay creciente si la hay), y\n// deja en manos del LLAMADOR (createAlphaVideo en program/js/alpha-video.js)\n// la validez de ese callback diferido -- ver \"token\" mas abajo: este modulo\n// no sabe nada de OUT/destroy/theme cambiado, esa invalidacion vive donde\n// corresponde (alpha-video.js), sin acoplar ambos mecanismos.\n\n// CONFIGURACION CENTRAL (2026-09-25, pedido explicito: \"no distribuir\n// numeros magicos por renderers\"). Valores elegidos por benchmark real\n// (ver informe) -- ver TAKE_STAGGER_MS/HIGH_STAGGER_MS para la\n// justificacion de cada numero. Son los DEFAULT de fabrica; la logica real\n// usa las variables \"current*\" de mas abajo (mismo valor salvo que alguien\n// llame a configureScheduler(), ver esa funcion) para poder ajustarlos en\n// caliente sin reiniciar Program -- util tanto para el benchmark de esta\n// tarea como para afinar en la PC de produccion sin editar codigo.\nexport const TAKE_BURST_WINDOW_MS = 120;\nexport const TAKE_STAGGER_MS = 40;\n// Techo defensivo (seccion 14 del pedido original: \"no quiero resolver\n// esto haciendo 6 modulos x 200ms = 1 segundo de entrada escalonada\"). Con\n// TAKE_STAGGER_MS=40 y este techo, el peor caso (muchisimos modulos NORMAL\n// en la misma rafaga) nunca demora mas de este valor total.\nexport const TAKE_MAX_STAGGER_MS = 160;\n\n// MICRO-STAGGER HIGH (2026-09-26, siguiente etapa -- pedido explicito:\n// \"estos modulos [tarjeta/cambios/replay/varCheck] no deberian arrancar\n// TODOS sus decoders exactamente en el mismo instante\"). Mismo mecanismo\n// que TAKE_STAGGER_MS pero con paso propio, mucho mas chico -- valor\n// elegido por benchmark real, ver informe de esta etapa. El techo propio\n// (HIGH_MAX_STAGGER_MS) mantiene el espiritu de \"practicamente inmediato\"\n// para HIGH aunque hubiera muchos en la misma rafaga.\nexport const HIGH_STAGGER_MS = 10;\nexport const HIGH_MAX_STAGGER_MS = 50;\n\nlet currentBurstWindowMs = TAKE_BURST_WINDOW_MS;\nlet currentStaggerMs = TAKE_STAGGER_MS;\nlet currentMaxStaggerMs = TAKE_MAX_STAGGER_MS;\nlet currentHighStaggerMs = HIGH_STAGGER_MS;\nlet currentHighMaxStaggerMs = HIGH_MAX_STAGGER_MS;\n\n// Override en caliente (2026-09-25, seccion 17 del pedido original +\n// benchmark de esta tarea): \"null\"/\"undefined\" en cualquier campo deja ese\n// parametro como esta. Sin llamar a esto nunca, el scheduler usa\n// exactamente los DEFAULT de arriba -- este mecanismo no cambia el\n// comportamiento de fabrica por si mismo.\nexport function configureScheduler({\n  burstWindowMs, staggerMs, maxStaggerMs, highStaggerMs, highMaxStaggerMs, highPriorityIds, criticalIds,\n} = {}) {\n  if (burstWindowMs != null) currentBurstWindowMs = burstWindowMs;\n  if (staggerMs != null) currentStaggerMs = staggerMs;\n  if (maxStaggerMs != null) currentMaxStaggerMs = maxStaggerMs;\n  if (highStaggerMs != null) currentHighStaggerMs = highStaggerMs;\n  if (highMaxStaggerMs != null) currentHighMaxStaggerMs = highMaxStaggerMs;\n  if (highPriorityIds != null) currentHighPriorityIds = highPriorityIds;\n  if (criticalIds != null) currentCriticalIds = criticalIds;\n}\n\nexport function getSchedulerConfig() {\n  return {\n    burstWindowMs: currentBurstWindowMs,\n    staggerMs: currentStaggerMs,\n    maxStaggerMs: currentMaxStaggerMs,\n    highStaggerMs: currentHighStaggerMs,\n    highMaxStaggerMs: currentHighMaxStaggerMs,\n  };\n}\n\n// PRIORIDAD EN TRES NIVELES (2026-09-26, siguiente etapa -- pedido\n// explicito: \"prioridad significa orden, no simultaneidad\"). Reusa el\n// MISMO moduleId que ya usa todo el proyecto (shared/modules.js) -- no es\n// una lista paralela, es la unica fuente de \"que modulo es cual\" para\n// esta decision puntual de prioridad/timing.\n//\n// CRITICAL (\"gol\"): el unico -- pedido explicito \"GOL sigue siendo\n// CRITICAL... no debe pagar delay artificial\". Nunca entra a NINGUN\n// escalonado, ni siquiera el micro-stagger de HIGH: corre siempre\n// sincronico, sin importar cuantos Takes mas haya en la misma rafaga.\nexport const CRITICAL_MODULE_IDS = new Set(['gol']);\nlet currentCriticalIds = CRITICAL_MODULE_IDS;\n\n// HIGH: gr\u00E1ficas de evento (anuncian algo que ya pas\u00F3 en la cancha, la\n// demora se nota mas que en un z\u00F3calo/VS) -- YA NO son 100% inmediatas\n// como en la etapa anterior: si dos o mas HIGH caen en la misma rafaga,\n// reciben un micro-stagger propio (HIGH_STAGGER_MS) en vez de arrancar\n// todas su decoder exactamente en el mismo frame. La PRIMERA de la rafaga\n// (sea HIGH o NORMAL) sigue siendo siempre inmediata -- ver\n// scheduleTakePlay: eso es lo que preserva \"Take individual no se toca\".\nexport const HIGH_PRIORITY_IDS = new Set(['tarjeta', 'cambios', 'replay', 'varCheck']);\nlet currentHighPriorityIds = HIGH_PRIORITY_IDS;\n\nfunction tierOf(moduleId) {\n  if (currentCriticalIds.has(moduleId)) return 'critical';\n  if (currentHighPriorityIds.has(moduleId)) return 'high';\n  return 'normal';\n}\n\n// DEBUG (2026-09-25, seccion 17 del pedido): activable sin ensuciar\n// produccion -- \"?debug=1\" ya es la convencion existente del proyecto (ver\n// program/js/main.js, initProgramDiagnostics). Nunca loguea nada si no\n// esta activo.\nlet debugEnabled = false;\nexport function setSchedulerDebug(enabled) {\n  debugEnabled = !!enabled;\n}\nfunction log(...args) {\n  if (debugEnabled) console.log('[TAKE-SCHEDULER]', ...args);\n}\n\n// Estado del detector de rafaga -- unico, compartido por TODOS los modulos\n// de video de la pagina (tiene que serlo: una rafaga es, por definicion,\n// \"varios modulos DISTINTOS casi al mismo tiempo\"). \"lastArrivalAt\" se\n// resetea sola apenas pasa TAKE_BURST_WINDOW_MS sin ningun pedido nuevo --\n// no hace falta ningun timer de limpieza aparte. \"burstSlot\" cuenta TODOS\n// los arrivals no-CRITICAL de la rafaga actual (HIGH + NORMAL juntos, un\n// unico contador) -- es lo que garantiza \"una sola linea temporal de\n// decoder starts\" (pedido explicito, seccion 2 de esta etapa) en vez de\n// dos schedulers independientes que pudieran coincidir en el mismo t=0.\nlet lastArrivalAt = -Infinity;\nlet burstSlot = 0;\nlet highCount = 0;\nlet normalCount = 0;\nlet claimedDelays = null; // Set<number> de delays ya asignados en la rafaga actual\nlet burstSeq = 0; // solo para los logs de debug, identifica cada rafaga\n\nfunction resetBurst() {\n  burstSeq += 1;\n  burstSlot = 0;\n  highCount = 0;\n  normalCount = 0;\n  claimedDelays = new Set();\n}\n\n// Asegura que \"preferred\" no colisione con un delay ya entregado a OTRO\n// modulo de esta MISMA rafaga (posible si, ej., el 4to HIGH -- 4*10=40ms --\n// cae justo sobre el 1er NORMAL -- 1*40=40ms). Nudge de 1ms en vez de\n// recalcular todo: con pasos de 10-40ms la probabilidad de choque ya es\n// baja, y esto lo vuelve IMPOSIBLE sin ningun redise\u00F1o mayor.\nfunction claimDelay(preferred, cap) {\n  let d = Math.min(preferred, cap);\n  while (claimedDelays.has(d)) d += 1;\n  claimedDelays.add(d);\n  return d;\n}\n\n// Pide un turno para reproducir. \"run()\" se llama exactamente una vez,\n// sincr\u00F3nico si delay=0 o via setTimeout si no -- el propio llamador es\n// responsable de chequear que la accion siga siendo valida en ese momento\n// (ver \"takeToken\" en program/js/alpha-video.js): este scheduler no\n// cancela nada por si mismo, solo decide el timing. Devuelve una funcion\n// \"cancelTimer()\" para que el llamador pueda limpiar el setTimeout\n// pendiente si el modulo se destruye/pausa antes de que le toque el turno\n// (evita timers huerfanos, aunque \"run\" ya es un no-op seguro si el token\n// no matchea).\nexport function scheduleTakePlay(moduleId, run) {\n  const now = performance.now();\n  const tier = tierOf(moduleId);\n\n  if (tier === 'critical') {\n    // \"gol\": nunca entra a ningun escalonado, ni siquiera al micro-stagger\n    // de HIGH -- seccion 1 de esta etapa, \"GOL sigue siendo CRITICAL\".\n    log(moduleId, '-> CRITICAL, inmediato');\n    run();\n    return () => {};\n  }\n\n  const withinBurst = (now - lastArrivalAt) <= currentBurstWindowMs;\n  if (!withinBurst) resetBurst();\n  lastArrivalAt = now;\n\n  const mySlot = burstSlot;\n  burstSlot += 1;\n\n  if (mySlot === 0) {\n    // Primer Take no-CRITICAL de la rafaga (o un Take individual suelto):\n    // SIEMPRE inmediato, sin importar el tier -- seccion 4 de esta etapa,\n    // \"Take individual no se toca\". El escalonado solo tiene sentido para\n    // los que llegan DESPUES de este primero.\n    log(moduleId, `-> ${tier}, slot 0, inmediato`);\n    run();\n    return () => {};\n  }\n\n  const step = tier === 'high' ? currentHighStaggerMs : currentStaggerMs;\n  const cap = tier === 'high' ? currentHighMaxStaggerMs : currentMaxStaggerMs;\n  const slotInTier = tier === 'high' ? ++highCount : ++normalCount;\n  const delay = claimDelay(slotInTier * step, cap);\n\n  log(moduleId, `-> ${tier}, slot ${mySlot} (${slotInTier}\u00B0 de su tier), delay ${delay}ms (rafaga #${burstSeq})`);\n  const timer = setTimeout(run, delay);\n  return () => clearTimeout(timer);\n}\n","http://localhost:4430/program/js/renderers/scoreboard.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { elapsedMs, formatClock, parseClockLimit } from '../../../shared/clock.js';\r\n\r\n// \"FIN DEL CONTADOR\" (2026-08-15, pedido explicito del usuario): default\r\n// 15:00 -- una vez alcanzado el reloj queda trabado ahi (ver\r\n// shared/clock.js, elapsedMs con limitMs). \"clockEndText\" es un campo de\r\n// texto libre editado desde master-control/js/scoreboard-clock-panel.js;\r\n// si esta vacio o mal formado se usa este default, nunca se rompe el reloj.\r\nconst DEFAULT_CLOCK_END_MS = 15 * 60 * 1000;\r\nimport { teamColorHex } from '../../../shared/team-colors.js';\r\nimport { crestFile, teamAbbr } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('scoreboard', 'principal');\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-team-a\">\r\n        <img class=\"ov-crest\" data-adjust=\"localCrest\" />\r\n        <span class=\"ov-dot\"></span>\r\n        <span class=\"ov-name\"></span>\r\n      </div>\r\n      <div class=\"ov-score\"><span class=\"ov-score-a\"></span><span class=\"ov-score-sep\" data-adjust=\"separator\"> - </span><span class=\"ov-score-b\"></span></div>\r\n      <div class=\"ov-team-b\">\r\n        <span class=\"ov-name\"></span>\r\n        <span class=\"ov-dot\"></span>\r\n        <img class=\"ov-crest\" data-adjust=\"awayCrest\" />\r\n      </div>\r\n      <div class=\"ov-period\"></div>\r\n      <div class=\"ov-clock\"></div>\r\n      <img class=\"ov-scoreboard-sponsor\" data-adjust=\"sponsor\" />\r\n    </div>\r\n  `;\r\n  // \"mountThemedAlphaVideo\" (2026-08-21, sistema multi-theme): para GLA\r\n  // usa SIEMPRE este VIDEO_SRC de ac\u00E1 arriba (nunca el manifest -- cero\r\n  // riesgo de regresi\u00F3n). Para cualquier otro theme sin este asset\r\n  // todav\u00EDa, devuelve null a prop\u00F3sito -- el \".gfx-overlay\" de arriba\r\n  // (escudos/nombres/goles/reloj/per\u00EDodo) sigue funcionando igual sobre\r\n  // transparencia, sin ning\u00FAn video de fondo. \"_gfxBuilt\" (no\r\n  // \"_alphaVideo\", que puede ser leg\u00EDtimamente null) es el marcador real\r\n  // de \"ya arm\u00E9 la estructura\" -- si fuera \"_alphaVideo\" un theme sin\r\n  // asset reconstruir\u00EDa el DOM en cada actualizaci\u00F3n, sin necesidad.\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'scoreboard', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction updateOverlay(el, data) {\r\n  const {\r\n    teamA, teamB, scoreA, scoreB, clock, period, sponsor,\r\n  } = data;\r\n\r\n  const ta = data.textAdjust;\r\n  const teamAEl = el.querySelector('.ov-team-a');\r\n  applyPlainTextAdjust(teamAEl.querySelector('.ov-name'), teamA ? teamAbbr(teamA) : 'LOCAL', readTextAdjust(ta, 'nameA'));\r\n  teamAEl.querySelector('.ov-dot').style.background = teamColorHex(data, 'A');\r\n  setCrest(teamAEl.querySelector('.ov-crest'), teamA);\r\n\r\n  const teamBEl = el.querySelector('.ov-team-b');\r\n  applyPlainTextAdjust(teamBEl.querySelector('.ov-name'), teamB ? teamAbbr(teamB) : 'VISITANTE', readTextAdjust(ta, 'nameB'));\r\n  teamBEl.querySelector('.ov-dot').style.background = teamColorHex(data, 'B');\r\n  setCrest(teamBEl.querySelector('.ov-crest'), teamB);\r\n\r\n  // \"scoreA\"/\"scoreB\" (2026-08-15, auditoria completa): antes un unico\r\n  // elemento pintaba \"scoreA - scoreB\" como un solo texto, sin poder mover\r\n  // un gol independiente del otro -- ahora son dos spans propios dentro\r\n  // del mismo contenedor centrado (\".ov-score\" conserva su transform de\r\n  // dise\u00F1o existente, translate se compone encima sin pisarlo).\r\n  applyPlainTextAdjust(el.querySelector('.ov-score-a'), String(scoreA ?? ''), readTextAdjust(ta, 'scoreA'));\r\n  applyPlainTextAdjust(el.querySelector('.ov-score-b'), String(scoreB ?? ''), readTextAdjust(ta, 'scoreB'));\r\n  applyPlainTextAdjust(el.querySelector('.ov-period'), period || '', readTextAdjust(ta, 'period'));\r\n  const clockLimitMs = parseClockLimit(data.clockEndText, DEFAULT_CLOCK_END_MS);\r\n  applyPlainTextAdjust(el.querySelector('.ov-clock'), formatClock(elapsedMs(clock, clockLimitMs)), readTextAdjust(ta, 'clock'));\r\n\r\n  const sponsorEl = el.querySelector('.ov-scoreboard-sponsor');\r\n  const file = sponsorFile('scoreboard', sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n}\r\n\r\nexport default function renderScoreboard(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  updateOverlay(contentEl, data);\r\n}\r\n","http://localhost:4430/program/js/renderers/marcadorTiempoAdicional.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { elapsedMs, formatClock } from '../../../shared/clock.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// Asset nuevo: imagen estatica (reemplazo del .mp4 con alfa compuesto que\r\n// usaba antes) \u2014 ver program/css/overlay.css para las coordenadas medidas\r\n// con lectura de alfa real sobre el PNG. Logica de datos sin cambios:\r\n// mismo campo \"addedMinutes\" y mismo reloj compartido (shared/clock.js).\r\nconst IMG_SRC = glaAssetPath('marcadorTiempoAdicional', 'principal');\r\n\r\n// Chip de \"+minutos\" mas angosto que en el asset anterior (34px reales);\r\n// mismo criterio de auto-ajuste que el resto de los textos variables.\r\nconst LABEL_MAX_FONT = 18;\r\nconst LABEL_MIN_FONT = 11;\r\nconst LABEL_MAX_WIDTH = 28;\r\n\r\nfunction buildStructure(el) {\r\n  const imgSrc = resolveImageSrc('marcadorTiempoAdicional', IMG_SRC);\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-added-label\"></div>\r\n      <div class=\"ov-added-clock\"></div>\r\n    </div>\r\n  `;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\n// \"+300ms\" (2026-09-10, pedido explicito del usuario): el numero de\r\n// MINUTOS AGREGADOS y el RELOJ deben aparecer 300ms mas tarde que antes,\r\n// sin tocar la animacion del asset (el fondo/PNG no pasa por aca, ver\r\n// program/js/main.js -- esto solo retrasa CUANDO este renderer pinta su\r\n// propio contenido dinamico). Antes se pintaba sincronico en cada llamada\r\n// (0ms de demora); ahora, solo en el momento del TAKE (\"justTaken\"), se\r\n// demora el primer pintado 300ms -- llamadas posteriores (tick del reloj\r\n// cada 500ms, ajustes en vivo) siguen pintando al instante, como siempre,\r\n// para no introducir un lag continuo en el reloj corriendo.\r\nconst CONTENT_REVEAL_DELAY_MS = 300;\r\n\r\nfunction paintContent(contentEl, data) {\r\n  const rawAdded = (data.addedMinutes || '').trim();\r\n  const labelText = rawAdded ? (rawAdded.startsWith('+') ? rawAdded : `+${rawAdded}`) : '';\r\n  applyFittedText(contentEl.querySelector('.ov-added-label'), labelText, withGlaSegoeRegular({\r\n    maxFont: LABEL_MAX_FONT, minFont: LABEL_MIN_FONT, maxWidth: LABEL_MAX_WIDTH, weight: 800,\r\n  }), readTextAdjust(data.textAdjust, 'addedMinutes'));\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-added-clock'), formatClock(elapsedMs(data.clock)), readTextAdjust(data.textAdjust, 'clock'));\r\n}\r\n\r\nexport default function renderMarcadorTiempoAdicional(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    clearTimeout(contentEl._contentRevealTimer);\r\n    // Vacia el contenido YA (evita un flash del numero/reloj de la vez\r\n    // anterior mientras se espera el delay) -- el pintado real llega en\r\n    // el timeout de abajo.\r\n    contentEl.querySelector('.ov-added-label').textContent = '';\r\n    contentEl.querySelector('.ov-added-clock').textContent = '';\r\n    contentEl._contentRevealTimer = setTimeout(() => paintContent(contentEl, data), CONTENT_REVEAL_DELAY_MS);\r\n    return;\r\n  }\r\n  paintContent(contentEl, data);\r\n}\r\n","http://localhost:4430/program/js/renderers/marcadorZocalo.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { elapsedMs, formatClock, parseClockLimit } from '../../../shared/clock.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// \"FIN DEL CONTADOR\" (2026-08-15, pedido explicito del usuario): default\r\n// 06:00 para Marcador Zocalo -- misma mecanica que el Marcador principal\r\n// (ver program/js/renderers/scoreboard.js), limite editable desde\r\n// master-control/js/live-clock-display.js.\r\nconst DEFAULT_CLOCK_END_MS = 6 * 60 * 1000;\r\n\r\n// Reemplaza al ex Shootout: asset propio nuevo, imagen estatica (sin video,\r\n// sin canal alfa compuesto en canvas) \u2014 ver program/css/overlay.css para las\r\n// coordenadas medidas con lectura de alfa real sobre el PNG.\r\n// La query identifica el binario vigente del PNG. No aplica ningun efecto\r\n// visual: evita que una sesion larga de Program conserve decodificada una\r\n// revision anterior del mismo path, que tenia alfa parcial en la pieza.\r\nconst IMG_SRC = glaAssetPath('marcadorZocalo', 'principal');\r\n\r\n// Zona util real de \".ov-zocalo-titulo\" (323px) menos margen de seguridad,\r\n// mismo criterio que el titulo de Marcador de Penales (marcadorPenales.js).\r\nconst TITULO_MAX_FONT = 20;\r\nconst TITULO_MIN_FONT = 12;\r\nconst TITULO_MAX_WIDTH = 300;\r\n\r\nfunction buildStructure(el) {\r\n  const imgSrc = resolveImageSrc('marcadorZocalo', IMG_SRC);\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-zocalo-titulo\"></div>\r\n      <div class=\"ov-zocalo-clock\"></div>\r\n    </div>\r\n  `;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderMarcadorZocalo(contentEl, data) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  applyFittedText(contentEl.querySelector('.ov-zocalo-titulo'), data.titulo || '', withGlaSegoeRegular({\r\n    maxFont: TITULO_MAX_FONT, minFont: TITULO_MIN_FONT, maxWidth: TITULO_MAX_WIDTH, weight: 800,\r\n  }), readTextAdjust(data.textAdjust, 'titulo'));\r\n  const clockLimitMs = parseClockLimit(data.clockEndText, DEFAULT_CLOCK_END_MS);\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-zocalo-clock'), formatClock(elapsedMs(data.clock, clockLimitMs)), readTextAdjust(data.textAdjust, 'clock'));\r\n}\r\n","http://localhost:4430/program/js/renderers/longDouble.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('longDouble', 'principal');\r\n\r\nconst LINE1_MAX_FONT = 40;\r\n// MIN_FONT bajado de 22 a 18 (2026-09-10, pedido explicito del usuario:\r\n// \"escribo mucho y se me hace dos renglones, no me gusta\") -- el bbox real\r\n// del asset (ver overlay.css, \"Zocalo largo doble: bbox real x568-1408\")\r\n// deja poco margen real para ensanchar la caja sin que el texto se salga\r\n// del zocalo impreso, asi que la otra mitad del arreglo es dejar que un\r\n// titulo muy largo se achique mas antes de necesitar wrap.\r\nconst LINE1_MIN_FONT = 18;\r\nconst LINE2_MAX_FONT = 26;\r\nconst LINE2_MIN_FONT = 16;\r\n// LINE_BOX_WIDTH ensanchado de 760 a 790 (2026-09-10, mismo pedido): el\r\n// bbox real del asset termina en x1408 y la caja arranca en x610, asi que\r\n// 790 (610-1400) deja ~8px de margen real contra el borde del zocalo --\r\n// el maximo razonable sin arriesgar que el texto pise el borde impreso.\r\nconst LINE_BOX_WIDTH = 790;\r\nconst LINE_SAFETY_MARGIN = 20;\r\nconst LINE_MAX_WIDTH = LINE_BOX_WIDTH - LINE_SAFETY_MARGIN;\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-long-double-line1\"></div>\r\n      <div class=\"ov-long-double-line2\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'longDouble', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderLongDouble(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  const adjust = data.textAdjust;\r\n  const line1El = contentEl.querySelector('.ov-long-double-line1');\r\n  const line2El = contentEl.querySelector('.ov-long-double-line2');\r\n  const sb = allData && allData.scoreboard;\r\n\r\n  const newL1 = resolveTeamTokens(data.line1 || '', sb);\r\n  const newL2 = resolveTeamTokens(data.line2 || '', sb);\r\n  const oldL1 = contentEl._prevLine1;\r\n  const oldL2 = contentEl._prevLine2;\r\n\r\n  updateFittedTextWithTransition(line1El, newL1, oldL1, withGlaSegoeRegular({\r\n    maxFont: LINE1_MAX_FONT, minFont: LINE1_MIN_FONT, maxWidth: LINE_MAX_WIDTH, weight: 800,\r\n  }), readTextAdjust(adjust, 'line1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(line2El, newL2, oldL2, withGlaSegoeRegular({\r\n    maxFont: LINE2_MAX_FONT, minFont: LINE2_MIN_FONT, maxWidth: LINE_MAX_WIDTH, weight: 600,\r\n  }), readTextAdjust(adjust, 'line2'), !justTaken);\r\n\r\n  contentEl._prevLine1 = newL1;\r\n  contentEl._prevLine2 = newL2;\r\n}\r\n","http://localhost:4430/program/js/renderers/marcadorPenales.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getProgramFontFamily } from '../program-fonts.js';\r\nimport { crestFile, teamAbbr, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\nimport { applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('marcadorPenales', 'principal');\r\n\r\nconst TITLE_MAX_FONT = 22; // limite real: zocalo semi-transparente del asset mide 27px de alto (y900-927 nativos)\r\nconst TITLE_MIN_FONT = 14;\r\nconst TITLE_BOX_WIDTH = 356; // ancho real de .ov-pen-title\r\nconst TITLE_SAFETY_MARGIN = 6; // colchon para que nunca quede pegado al borde del zocalo\r\nconst TITLE_MAX_WIDTH = TITLE_BOX_WIDTH - TITLE_SAFETY_MARGIN;\r\n\r\nlet measureCtx = null;\r\nfunction measureWidth(text, fontSize) {\r\n  measureCtx.font = `800 ${fontSize}px ${getProgramFontFamily()}`;\r\n  // El CSS de .ov-pen-title tiene letter-spacing:0.5px \u2014 measureText no lo\r\n  // aplica solo, hay que igualarlo en el contexto o el ancho medido queda\r\n  // sistematicamente mas angosto que el texto realmente renderizado (con\r\n  // titulos largos de muchos caracteres la diferencia se nota bastante:\r\n  // ~0.5px * cantidad de caracteres).\r\n  measureCtx.letterSpacing = '0.5px';\r\n  return measureCtx.measureText(text).width;\r\n}\r\n\r\n// Reduccion moderada: primero calcula una estimacion proporcional (rapida),\r\n// despues la ajusta con medicion real a ese tama\u00F1o \u2014 escalar el ancho de\r\n// forma lineal es solo una aproximacion (el propio font hinting/kerning no\r\n// escala perfectamente lineal), asi que para titulos muy largos una sola\r\n// pasada proporcional podia quedar unos px mas ancha que el zocalo.\r\n// Async: hay que esperar a que Anton este realmente cargada antes de medir\r\n// \u2014 si se mide antes de que el navegador la tenga lista, measureText usa\r\n// metricas de una fuente de reemplazo (mas angosta) y el calculo queda mal,\r\n// aunque el texto renderizado despues si use Anton (mas ancha).\r\nasync function fitTitleFontSize(text) {\r\n  if (!measureCtx) measureCtx = document.createElement('canvas').getContext('2d');\r\n  await document.fonts.load(`800 ${TITLE_MAX_FONT}px ${getProgramFontFamily()}`);\r\n  const widthAtMax = measureWidth(text, TITLE_MAX_FONT);\r\n  if (widthAtMax <= TITLE_MAX_WIDTH) return TITLE_MAX_FONT;\r\n  let size = Math.floor(TITLE_MAX_FONT * (TITLE_MAX_WIDTH / widthAtMax));\r\n  size = Math.max(TITLE_MIN_FONT, size);\r\n  while (size > TITLE_MIN_FONT && measureWidth(text, size) > TITLE_MAX_WIDTH) {\r\n    size -= 1;\r\n  }\r\n  return size;\r\n}\r\n\r\n// \"adjustPrefix\" (2026-09-01, pedido explicito del usuario: \"control\r\n// total desde Master Control\" sobre cada circulo individual, sin mas\r\n// ajustes hardcodeados en CSS) -- cada circulo se marca con su propio\r\n// \"data-adjust\" (kickLocal1..5 / kickVisitante1..5, ver\r\n// shared/adjust-registry.js), independiente del grupo \"kicksLocal\"/\r\n// \"kicksVisitante\" que ya movia la fila entera. Solo tiene efecto real\r\n// cuando Argentina Streamers guarda un valor propio (los defaults son\r\n// 0/0/1, no-op) -- GLA (3 circulos, mismo \"kickDotsHtml\") nunca los toca.\r\nfunction kickDotsHtml(count, adjustPrefix) {\r\n  let html = '';\r\n  for (let i = 0; i < count; i++) {\r\n    html += `<span class=\"ov-pen-kick\" data-kick=\"${i}\" data-adjust=\"${adjustPrefix}${i + 1}\"></span>`;\r\n  }\r\n  return html;\r\n}\r\n\r\n// Orden de capas (de atras hacia adelante), preparado para cuando el\r\n// asset se reemplace por la version con los 6 casilleros transparentes:\r\n// 1. Fondo transparente del Program (stage).\r\n// 2. Indicadores dinamicos de los 6 penales (\".ov-pen-kicks-layer\") \u2014 van\r\n//    ANTES que \".av-target\" en el DOM a proposito, para quedar por\r\n//    DETRAS del video (los elementos position:absolute sin z-index\r\n//    apilan en orden de aparicion en el DOM).\r\n// 3. Asset de video (\".av-target\") por encima.\r\n// 4. Textos/escudos/nombres/resultado (\".gfx-overlay\") arriba de todo \u2014\r\n//    sin cambios de capa, sigue tal cual estaba.\r\n// Con el asset actual (circulos blancos opacos) los indicadores quedan\r\n// tapados y no se ven \u2014 es esperado, ver CHANGELOG. El dia que el asset\r\n// tenga los 6 casilleros recortados (transparentes), los colores van a\r\n// aparecer solos por detras sin tocar esta logica.\r\nfunction buildStructure(el, kicksPerTeam) {\r\n  el.innerHTML = `\r\n    <div class=\"gfx-overlay ov-pen-kicks-layer\">\r\n      <div class=\"ov-pen-kicks ov-pen-kicksA\" data-adjust=\"kicksLocal\">${kickDotsHtml(kicksPerTeam, 'kickLocal')}</div>\r\n      <div class=\"ov-pen-kicks ov-pen-kicksB\" data-adjust=\"kicksVisitante\">${kickDotsHtml(kicksPerTeam, 'kickVisitante')}</div>\r\n    </div>\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-pen-title\"></div>\r\n      <div class=\"ov-pen-nombre ov-pen-nombre-local\"></div>\r\n      <div class=\"ov-pen-nombre ov-pen-nombre-visitante\"></div>\r\n      <div class=\"ov-pen-team ov-pen-teamA\">\r\n        <img class=\"ov-pen-crest\" data-adjust=\"localCrest\" />\r\n        <div class=\"ov-pen-name\"></div>\r\n      </div>\r\n      <div class=\"ov-pen-score ov-pen-scoreA\"></div>\r\n      <div class=\"ov-pen-score-sep\" data-adjust=\"separator\">-</div>\r\n      <div class=\"ov-pen-score ov-pen-scoreB\"></div>\r\n      <div class=\"ov-pen-team ov-pen-teamB\">\r\n        <img class=\"ov-pen-crest\" data-adjust=\"awayCrest\" />\r\n        <div class=\"ov-pen-name\"></div>\r\n      </div>\r\n      <img class=\"ov-pen-sponsor\" data-adjust=\"sponsor\" />\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'marcadorPenales', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction paintKicks(containerEl, kicks) {\r\n  const dots = containerEl.querySelectorAll('.ov-pen-kick');\r\n  kicks.forEach((kick, i) => {\r\n    dots[i].className = `ov-pen-kick ov-pen-kick--${kick.status}`;\r\n  });\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Sin nombre/escudo propios (se leen en vivo de \"scoreboard\", 5to\r\n// argumento, ver program/js/main.js, igual que marcadorEntretiempo). Ya\r\n// no muestra color de camiseta (eso queda unicamente en el marcador\r\n// principal). El resultado (\".ov-pen-scoreA/B\") es el resultado REGLAMENTARIO\r\n// del partido (2026-09-27, pedido explicito del usuario: \"los penales son\r\n// visualmente independientes del resultado del partido... el score principal\r\n// debe seguir mostrando 2-2, no sumar los goles de la tanda\" -- reemplaza\r\n// una decision anterior, 2026-08-31, que hacia lo contrario) -- se lee en\r\n// vivo de \"sb.scoreA/scoreB\" (scoreboard), NUNCA de \"kicksA/kicksB\". Los\r\n// circulos (\".ov-pen-kicks\") siguen siendo la unica fuente de verdad del\r\n// desarrollo de la tanda en si, sin cambios.\r\nexport default function renderMarcadorPenales(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl, data.kicksA.length);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  const ta = data.textAdjust;\r\n  const titleAdjust = readTextAdjust(ta, 'titulo');\r\n  const titleEl = contentEl.querySelector('.ov-pen-title');\r\n  // \"suddenDeath\" (2026-08-15, pedido explicito del usuario): sin asset\r\n  // nuevo ni elemento aparte -- reusa el mismo zocalo/auto-ajuste de\r\n  // fuente del titulo (ver shared/modules.js), asi que si la tanda esta\r\n  // marcada como MUERTE SUBITA eso se ve en el mismo lugar donde siempre\r\n  // se mira el titulo, visible pero sin invadir el resto de la pieza.\r\n  const titleText = toBroadcastUpper(data.suddenDeath\r\n    ? `${(data.titulo || 'PENALES').trim()} \u2014 MUERTE S\u00DABITA`\r\n    : (data.titulo || ''));\r\n  titleEl.textContent = titleText;\r\n  titleEl.style.translate = `${titleAdjust.dx || 0}px ${titleAdjust.dy || 0}px`;\r\n  fitTitleFontSize(titleText).then((size) => {\r\n    if (titleEl.textContent !== titleText) return;\r\n    titleEl.style.fontSize = `${Math.max(1, size + (titleAdjust.dSize || 0))}px`;\r\n  });\r\n\r\n  // \"NOMBRE LOCAL/VISITANTE\" (2026-09-01, pedido explicito del usuario,\r\n  // franja azul arriba de cada fila de circulos) -- SOLO Argentina\r\n  // Streamers: GLA nunca escribe en \"nombreLocalMode/Manual\" (el campo\r\n  // existe en sus defaults pero nunca se toca, ver shared/modules.js),\r\n  // asi que dejarle texto vacio ahi es simplemente preservar \"sin\r\n  // contenido\" en un elemento que su propio asset/dise\u00F1o no contempla.\r\n  if (getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID) {\r\n    const nombreLocal = resolveVsDisplayName({ mode: data.nombreLocalMode, manualText: data.nombreLocalManual, teamId: sb.teamA, fallbackName: teamName(sb.teamA) });\r\n    const nombreVisitante = resolveVsDisplayName({ mode: data.nombreVisitanteMode, manualText: data.nombreVisitanteManual, teamId: sb.teamB, fallbackName: teamName(sb.teamB) });\r\n    applyPlainTextAdjust(contentEl.querySelector('.ov-pen-nombre-local'), nombreLocal, readTextAdjust(ta, 'nombreLocal'));\r\n    applyPlainTextAdjust(contentEl.querySelector('.ov-pen-nombre-visitante'), nombreVisitante, readTextAdjust(ta, 'nombreVisitante'));\r\n  }\r\n\r\n  const teamAEl = contentEl.querySelector('.ov-pen-teamA');\r\n  applyPlainTextAdjust(teamAEl.querySelector('.ov-pen-name'), teamAbbr(sb.teamA), readTextAdjust(ta, 'nameA'));\r\n  setCrest(teamAEl.querySelector('.ov-pen-crest'), sb.teamA);\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-pen-scoreA'), String(sb.scoreA ?? '0'), readTextAdjust(ta, 'scoreA'));\r\n  paintKicks(contentEl.querySelector('.ov-pen-kicksA'), data.kicksA);\r\n\r\n  const teamBEl = contentEl.querySelector('.ov-pen-teamB');\r\n  applyPlainTextAdjust(teamBEl.querySelector('.ov-pen-name'), teamAbbr(sb.teamB), readTextAdjust(ta, 'nameB'));\r\n  setCrest(teamBEl.querySelector('.ov-pen-crest'), sb.teamB);\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-pen-scoreB'), String(sb.scoreB ?? '0'), readTextAdjust(ta, 'scoreB'));\r\n  paintKicks(contentEl.querySelector('.ov-pen-kicksB'), data.kicksB);\r\n\r\n  // Sponsor: mismo fade-swap que Zocalo VS Compacto (ver\r\n  // program/js/renderers/vs.js) -- catalogo/logica reutilizados tal cual,\r\n  // sin inventar un mecanismo nuevo. Argentina Streamers no tiene sponsor\r\n  // dinamico en Penales (2026-10-09, pedido explicito del usuario): aunque\r\n  // \"data.sponsor\" conserve un valor viejo, nunca se pinta.\r\n  const sponsorEl = contentEl.querySelector('.ov-pen-sponsor');\r\n  const sponsorFileSrc = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID ? null : sponsorFile('vs_compact', data.sponsor);\r\n  if (sponsorFileSrc) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = sponsorFileSrc;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== sponsorFileSrc && currentSrc !== window.location.origin + sponsorFileSrc) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = sponsorFileSrc;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/shortSimple.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { GLA_SEGOE_BOLD_FAMILY, withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('shortSimple', 'principal');\r\n\r\nconst TEXT_MAX_FONT = 40;\r\nconst TEXT_MIN_FONT = 18;\r\nconst TEXT_BOX_WIDTH = 690;\r\nconst TEXT_SAFETY_MARGIN = 16;\r\nconst TEXT_MAX_WIDTH = TEXT_BOX_WIDTH - TEXT_SAFETY_MARGIN;\r\n\r\n// ARGENTINA STREAMERS (2026-09-04, pedido explicito del usuario: \"sobra\r\n// muchisimo espacio horizontal... quiero que el texto pueda usar mas\r\n// ancho\"). Medido pixel a pixel sobre zocalo-corto-simple-alpha.mp4 (frame\r\n// asentado, deteccion de la barra navy por canal): a la altura del centro\r\n// del texto (y=927 en adelante hasta y=952, pared inferior del box) la\r\n// barra mide x=442-1467 (1025px) -- mucho mas ancha que el box de GLA\r\n// (690px, medido sobre OTRO asset). Igual criterio de margen de seguridad\r\n// que el resto del archivo (16px). GLA no se toca: sigue con\r\n// TEXT_BOX_WIDTH/TEXT_MAX_WIDTH de arriba.\r\nconst TEXT_BOX_WIDTH_AS = 985;\r\nconst TEXT_MAX_WIDTH_AS = TEXT_BOX_WIDTH_AS - TEXT_SAFETY_MARGIN;\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-short-simple-text\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'shortSimple', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderShortSimple(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  const textEl = contentEl.querySelector('.ov-short-simple-text');\r\n  const sb = allData && allData.scoreboard;\r\n  const newText = resolveTeamTokens(data.text || '', sb);\r\n  const oldText = contentEl._prevText;\r\n  const isArgentinaStreamers = getActiveThemeId() !== DEFAULT_THEME_ID;\r\n  const maxWidth = isArgentinaStreamers ? TEXT_MAX_WIDTH_AS : TEXT_MAX_WIDTH;\r\n  // \"family\" (2026-09-24, pedido explicito: \"Segoe UI Bold\", SOLO GLA) --\r\n  // ver el mismo criterio en program/js/renderers/longSimple.js.\r\n  const family = isArgentinaStreamers ? undefined : GLA_SEGOE_BOLD_FAMILY;\r\n\r\n  updateFittedTextWithTransition(textEl, newText, oldText, withGlaSegoeRegular({\r\n    maxFont: TEXT_MAX_FONT, minFont: TEXT_MIN_FONT, maxWidth, weight: 800, family,\r\n  }), readTextAdjust(data.textAdjust, 'text'), !justTaken);\r\n\r\n  contentEl._prevText = newText;\r\n}\r\n","http://localhost:4430/program/js/renderers/varCheck.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, readTextAdjust } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('varCheck', 'principal');\r\nconst MOTIVO_IMAGE_SRC = glaAssetPath('varCheck', 'motivo');\r\n\r\nexport default function renderVarCheck(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    const motivoImageSrc = resolveImageSrc('varCheck', MOTIVO_IMAGE_SRC);\r\n    contentEl.innerHTML = `\r\n      <div class=\"ov-var-group1\">\r\n        <div class=\"av-target\"></div>\r\n        <div class=\"gfx-overlay\">\r\n          <img class=\"ov-var-replay-sponsor\" data-adjust=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n      <div class=\"ov-var-motivo-group\">\r\n        <div class=\"ov-var-motivo-container\">\r\n          <div class=\"ov-var-motivo-av-target av-target\"></div>\r\n          ${motivoImageSrc ? `<img class=\"ov-var-motivo-bg\" src=\"${motivoImageSrc}\" />` : ''}\r\n          <div class=\"gfx-overlay\">\r\n            <div class=\"ov-short-simple-text\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    `;\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.ov-var-group1 .av-target'), 'varCheck', VIDEO_SRC);\r\n    contentEl._motivoAlphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.ov-var-motivo-av-target'), 'varCheckMotivo', null);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n\r\n  // Grupo 1: VAR + SPONSOR\r\n  const group1 = contentEl.querySelector('.ov-var-group1');\r\n  if (group1) {\r\n    const x1 = data.varGroupOffsetX || 0;\r\n    const y1 = data.varGroupOffsetY || 0;\r\n    const s1 = data.varGroupScale !== undefined ? data.varGroupScale : 1;\r\n    group1.style.transform = `translate(${x1}px, ${y1}px) scale(${s1})`;\r\n  }\r\n\r\n  // Grupo 2: MOTIVO\r\n  const motivoGroup = contentEl.querySelector('.ov-var-motivo-group');\r\n  if (motivoGroup) {\r\n    const x2 = data.motivoOffsetX || 0;\r\n    const y2 = data.motivoOffsetY || 0;\r\n    const s2 = data.motivoScale !== undefined ? data.motivoScale : 1;\r\n    motivoGroup.style.transform = `translate(${x2}px, ${y2}px) scale(${s2})`;\r\n  }\r\n\r\n  const motivoEl = contentEl.querySelector('.ov-var-motivo-container');\r\n  const textEl = motivoEl.querySelector('.ov-short-simple-text');\r\n\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n    contentEl._hasMotivoPlayed = false;\r\n  }\r\n\r\n  const sponsorEl = contentEl.querySelector('.ov-var-replay-sponsor');\r\n  const file = sponsorFile('var', data.sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n\r\n  // Motivo text & asset timing logic\r\n  const motivoText = (data.motivo || '').trim();\r\n  const themeId = getActiveThemeId();\r\n  const isArgentinaStreamers = themeId === 'argentinaStreamers';\r\n\r\n  if (motivoText) {\r\n    const maxWidth = isArgentinaStreamers ? (500 - 40) : (368 - 24);\r\n    applyFittedText(textEl, motivoText, withGlaSegoeRegular({\r\n      maxFont: 40, minFont: 14, maxWidth, weight: 800,\r\n    }), readTextAdjust(data.textAdjust, 'motivo'));\r\n\r\n    if (!motivoEl.classList.contains('is-visible')) {\r\n      motivoEl.classList.add('is-visible');\r\n    }\r\n\r\n    if (justTaken || !contentEl._hasMotivoPlayed || contentEl._prevMotivoText !== motivoText) {\r\n      contentEl._motivoAlphaVideo?.playFromStart();\r\n      contentEl._hasMotivoPlayed = true;\r\n\r\n      if (contentEl._motivoTimer) clearTimeout(contentEl._motivoTimer);\r\n\r\n      const delayMs = isArgentinaStreamers ? 1900 : 0;\r\n      if (delayMs > 0) {\r\n        textEl.classList.remove('motivo-content-in');\r\n        contentEl._motivoTimer = setTimeout(() => {\r\n          textEl.classList.add('motivo-content-in');\r\n        }, delayMs);\r\n      } else {\r\n        textEl.classList.add('motivo-content-in');\r\n      }\r\n    }\r\n  } else {\r\n    if (contentEl._motivoTimer) clearTimeout(contentEl._motivoTimer);\r\n    textEl.classList.remove('motivo-content-in');\r\n    motivoEl.classList.remove('is-visible');\r\n    contentEl._hasMotivoPlayed = false;\r\n  }\r\n\r\n  contentEl._prevMotivoText = motivoText;\r\n}\r\n","http://localhost:4430/program/js/renderers/marcadorEntretiempo.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { teamColorHex } from '../../../shared/team-colors.js';\r\nimport { crestFile, teamAbbr } from '../../../shared/teams.js';\r\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('marcadorEntretiempo', 'principal');\r\n\r\nfunction buildStructure(el) {\r\n  // Argentina Streamers entrego este asset como imagen estatica (PNG), no\r\n  // como .mov -- \"mountThemedAlphaVideo\" solo resuelve \"asset.video\", asi\r\n  // que sin este fondo condicional el manifest quedaba sin efecto (el\r\n  // \".av-target\" se mostraba vacio). Mismo patron ya usado por\r\n  // marcadorTiempoAdicional.js/\".gfx-bg-image\" (ver overlay.css) -- GLA\r\n  // sigue exactamente igual, su propio VIDEO_SRC via mountThemedAlphaVideo.\r\n  const imgSrc = resolveImageSrc('marcadorEntretiempo');\r\n  // \"isGla\" (2026-09-04, pedido explicito del usuario: \"en el modulo\r\n  // ENTRETIEMPO no quiero ningun circulito/color auxiliar... sacar el\r\n  // elemento/logica de Argentina Streamers\", \"SOLO ARGENTINA STREAMERS,\r\n  // no tocar GLA\") -- se decide UNA vez, al construir la estructura (este\r\n  // \"buildStructure\" corre una sola vez por instancia, memoizado via\r\n  // \"_gfxBuilt\"). GLA sigue con el \".ov-dot\" de siempre, byte a byte;\r\n  // Argentina Streamers nunca lo agrega al DOM (no es un \"opacity:0\" --\r\n  // el elemento ni existe, pedido explicito: \"no ocultarlo, sacarlo\").\r\n  const isGla = getActiveThemeId() !== ARGENTINA_STREAMERS_THEME_ID;\r\n  const dotA = isGla ? '<span class=\"ov-dot\"></span>' : '';\r\n  const dotB = isGla ? '<span class=\"ov-dot\"></span>' : '';\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-ent-team-a\">\r\n        <img class=\"ov-crest\" data-adjust=\"localCrest\" />\r\n        ${dotA}\r\n        <span class=\"ov-name\"></span>\r\n      </div>\r\n      <div class=\"ov-ent-score\"><span class=\"ov-ent-score-a\"></span><span class=\"ov-ent-score-sep\"></span><span class=\"ov-ent-score-b\"></span></div>\r\n      <div class=\"ov-ent-team-b\">\r\n        <span class=\"ov-name\"></span>\r\n        ${dotB}\r\n        <img class=\"ov-crest\" data-adjust=\"awayCrest\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'marcadorEntretiempo', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Sin datos propios: reutiliza en vivo lo que ya esta cargado en el\r\n// Marcador principal (5to argumento, ver program/js/main.js) para no\r\n// duplicar la carga de escudo/color/equipo/goles en dos paneles distintos.\r\nexport default function renderMarcadorEntretiempo(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const ta = data.textAdjust;\r\n\r\n  const teamAEl = contentEl.querySelector('.ov-ent-team-a');\r\n  applyPlainTextAdjust(teamAEl.querySelector('.ov-name'), teamAbbr(sb.teamA), readTextAdjust(ta, 'nameA'));\r\n  // \"ov-dot\" (2026-09-04, pedido explicito del usuario): eliminado del DOM\r\n  // para Argentina Streamers (ver buildStructure) -- querySelector da null\r\n  // ahi, nunca se intenta pintar un color que ya no existe. GLA sigue\r\n  // pintandolo exactamente igual que siempre.\r\n  const dotA = teamAEl.querySelector('.ov-dot');\r\n  if (dotA) dotA.style.background = teamColorHex(sb, 'A');\r\n  setCrest(teamAEl.querySelector('.ov-crest'), sb.teamA);\r\n\r\n  const teamBEl = contentEl.querySelector('.ov-ent-team-b');\r\n  applyPlainTextAdjust(teamBEl.querySelector('.ov-name'), teamAbbr(sb.teamB), readTextAdjust(ta, 'nameB'));\r\n  const dotB = teamBEl.querySelector('.ov-dot');\r\n  if (dotB) dotB.style.background = teamColorHex(sb, 'B');\r\n  setCrest(teamBEl.querySelector('.ov-crest'), sb.teamB);\r\n\r\n  // \"scoreA\"/\"scoreB\" divididos en dos spans (2026-08-15, auditoria\r\n  // completa) -- mismo criterio que el Marcador principal, ver\r\n  // program/js/renderers/scoreboard.js.\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-ent-score-a'), String(sb.scoreA ?? 0), readTextAdjust(ta, 'scoreA'));\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-ent-score-b'), String(sb.scoreB ?? 0), readTextAdjust(ta, 'scoreB'));\r\n  // \"separador\" (2026-09-04, pedido explicito del usuario: \"GUI\u00D3N/\r\n  // SEPARADOR\" editable de posicion, independiente de los goles) -- MISMO\r\n  // texto \" - \" que ya tenia horneado buildStructure (preserva el espaciado\r\n  // visual actual tal cual, item 10 del pedido: \"empezar visualmente\r\n  // igual\"), ahora con su propio textAdjust en vez de quedar fijo en el\r\n  // HTML.\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-ent-score-sep'), ' - ', readTextAdjust(ta, 'separador'));\r\n}\r\n","http://localhost:4430/program/js/renderers/shortDouble.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { GLA_SEGOE_BOLD_FAMILY, withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('shortDouble', 'principal');\r\n\r\nconst NAME_MAX_FONT = 41;\r\nconst NAME_MIN_FONT = 24;\r\nconst ROLE_MAX_FONT = 22;\r\nconst ROLE_MIN_FONT = 14;\r\nconst BOX_WIDTH = 500;\r\nconst SAFETY_MARGIN = 20;\r\nconst MAX_WIDTH = BOX_WIDTH - SAFETY_MARGIN;\r\n\r\nfunction pairMarkup() {\r\n  return `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-short-double-name\"></div>\r\n      <div class=\"ov-short-double-role\"></div>\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction buildSingleStructure(el) {\r\n  el.innerHTML = pairMarkup();\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'shortDouble', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction buildDoubleStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"ov-short-double-pair ov-short-double-pair-1\">${pairMarkup()}</div>\r\n    <div class=\"ov-short-double-pair ov-short-double-pair-2\">${pairMarkup()}</div>\r\n  `;\r\n  const video1 = mountThemedAlphaVideo(el.querySelector('.ov-short-double-pair-1 .av-target'), 'shortDouble', VIDEO_SRC);\r\n  const video2 = mountThemedAlphaVideo(el.querySelector('.ov-short-double-pair-2 .av-target'), 'shortDouble', VIDEO_SRC);\r\n  // Wrapper \"combinado\" (2026-08-21, sistema multi-theme): cualquiera de\r\n  // los dos puede ser null si el theme activo todav\u00EDa no tiene este\r\n  // asset -- cada m\u00E9todo solo llama a los handles que de verdad existen.\r\n  el._alphaVideo = (video1 || video2) ? {\r\n    playFromStart() { video1?.playFromStart(); video2?.playFromStart(); },\r\n    destroy() { video1?.destroy(); video2?.destroy(); },\r\n  } : null;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\n// \"family\" (2026-09-24, pedido explicito: \"Segoe UI Bold\", SOLO GLA) --\r\n// mismo criterio que longSimple.js/shortSimple.js.\r\nfunction fillPair(root, name, role, textAdjust, nameKey, roleKey, isExplicitUpdate, prevStore, sb) {\r\n  const nameEl = root.querySelector('.ov-short-double-name');\r\n  const roleEl = root.querySelector('.ov-short-double-role');\r\n  const newName = resolveTeamTokens(name || '', sb);\r\n  const newRole = resolveTeamTokens(role || '', sb);\r\n  const oldName = prevStore[nameKey];\r\n  const oldRole = prevStore[roleKey];\r\n  const family = getActiveThemeId() === DEFAULT_THEME_ID ? GLA_SEGOE_BOLD_FAMILY : undefined;\r\n\r\n  updateFittedTextWithTransition(nameEl, newName, oldName, withGlaSegoeRegular({\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: MAX_WIDTH, weight: 800, family,\r\n  }), readTextAdjust(textAdjust, nameKey), isExplicitUpdate);\r\n\r\n  updateFittedTextWithTransition(roleEl, newRole, oldRole, withGlaSegoeRegular({\r\n    maxFont: ROLE_MAX_FONT, minFont: ROLE_MIN_FONT, maxWidth: MAX_WIDTH, weight: 600, letterSpacing: 1, family,\r\n  }), readTextAdjust(textAdjust, roleKey), isExplicitUpdate);\r\n\r\n  prevStore[nameKey] = newName;\r\n  prevStore[roleKey] = newRole;\r\n}\r\n\r\nexport default function renderShortDouble(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const mode = data.airMode === 'double' ? 'double' : 'single';\r\n  const sb = allData && allData.scoreboard;\r\n  // \"modeChanged\" (2026-09-23, mismo bug/fix que tarjeta.js/vs.js -- ver\r\n  // comentario en tarjeta.js): pasar de individual a doble (o viceversa)\r\n  // CON LA GRAFICA AL AIRE armaba la estructura nueva sin destruir la\r\n  // vieja (huerfana) ni reproducir el/los video(s) nuevos.\r\n  const modeChanged = contentEl.dataset.airMode !== undefined && contentEl.dataset.airMode !== mode;\r\n\r\n  if (!contentEl._gfxBuilt || modeChanged) {\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    if (mode === 'double') buildDoubleStructure(contentEl); else buildSingleStructure(contentEl);\r\n    contentEl.dataset.airMode = mode;\r\n  }\r\n  if (justTaken || modeChanged) contentEl._alphaVideo?.playFromStart();\r\n\r\n  if (!contentEl._prevStore) contentEl._prevStore = {};\r\n  const isExplicitUpdate = !justTaken;\r\n\r\n  const adjust = data.textAdjust;\r\n  if (mode === 'single') {\r\n    // \"double1\" es LA fuente para el modo individual (2026-09-10, pedido\r\n    // explicito del usuario: \"que el z\u00F3calo doble 1 sea el z\u00F3calo\r\n    // individual\") -- ya no existe un \"data.name/role\" aparte, mandar un\r\n    // solo zocalo y mandar dos siempre leen del mismo lugar.\r\n    const double1 = data.double1 || {};\r\n    fillPair(contentEl, double1.name, double1.role, adjust, 'double1.name', 'double1.role', isExplicitUpdate, contentEl._prevStore, sb);\r\n  } else {\r\n    const double1 = data.double1 || {};\r\n    const double2 = data.double2 || {};\r\n    fillPair(contentEl.querySelector('.ov-short-double-pair-1'), double1.name, double1.role, adjust, 'double1.name', 'double1.role', isExplicitUpdate, contentEl._prevStore, sb);\r\n    fillPair(contentEl.querySelector('.ov-short-double-pair-2'), double2.name, double2.role, adjust, 'double2.name', 'double2.role', isExplicitUpdate, contentEl._prevStore, sb);\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/sideTable.js","import { applyFittedText, readTextAdjust } from '../text-fit.js';\r\nimport { crestFile } from '../../../shared/teams.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// Cada bracket mide 124px + 12px de gap = 136px de paso vertical. Como\r\n// maximo se ven 6: tanda1 muestra 1-6 y tanda2 desplaza la misma tira tres\r\n// filas para mostrar 4-9. Los encuentros 4/5/6 nunca se recrean al cambiar\r\n// de tanda: son los mismos nodos que suben dentro del viewport recortado.\r\nconst ROW_STEP = 136;\r\nconst ROW_HEIGHT = 124;\r\nconst ROW_GAP = 12;\r\nconst VISIBLE_ROWS = 6;\r\nconst TANDA2_OFFSET_ROWS = 3;\r\n\r\nfunction statusTextFor(enc) {\r\n  switch (enc.status) {\r\n    case 'hora': return enc.hora || '';\r\n    case 'proximo': return 'PR\u00D3XIMO';\r\n    case 'final': return 'FINAL';\r\n    case 'entretiempo': return 'ENTRETIEMPO';\r\n    case 'en_juego': return 'EN JUEGO';\r\n    case 'suspendido': return 'SUSPENDIDO';\r\n    default: return '';\r\n  }\r\n}\r\n\r\n// PARTIDOS SIN AUTO-AJUSTE (2026-10-22, pedido explicito del usuario, SOLO\r\n// GLA): cada texto queda en su tama\u00F1o base fijo (maxFont) aunque no entre;\r\n// el ajuste manual de tama\u00F1o (dSize) y su RESET siguen funcionando igual\r\n// (applyFittedText suma dSize sobre ese tama\u00F1o base). Con minFont = maxFont\r\n// fitFontSize devuelve siempre maxFont: nunca achica ni mueve nada solo.\r\nfunction fixedSize(opts) {\r\n  return getActiveThemeId() === DEFAULT_THEME_ID ? { ...opts, minFont: opts.maxFont } : opts;\r\n}\r\n\r\nfunction ocultaGolesFor(enc) {\r\n  return enc.status === 'proximo' || enc.status === 'hora' || enc.status === 'vs' || !enc.status;\r\n}\r\n\r\nfunction cardMarkup(index) {\r\n  return `\r\n    <div class=\"ov-resultados-encuentro\" data-encuentro-index=\"${index}\">\r\n      <div class=\"ov-resultados-bg\"></div>\r\n      <div class=\"gfx-overlay\">\r\n        <div class=\"ov-resultados-cuerpo\">\r\n          <div class=\"ov-resultados-escudo local\">\r\n            <img class=\"ov-resultados-crest\" data-adjust=\"crestLocal\" alt=\"local\">\r\n            <span class=\"ov-resultados-tbd\" hidden>TBD</span>\r\n          </div>\r\n          <div class=\"ov-resultados-bloque-central\">\r\n            <div class=\"ov-resultados-gol-local\">\r\n              <span class=\"ov-resultados-gol-num\"></span><span class=\"ov-resultados-gol-pen\"></span>\r\n            </div>\r\n            <div class=\"ov-resultados-titulo-encuentro\"></div>\r\n            <div class=\"ov-resultados-estado\"></div>\r\n            <div class=\"ov-resultados-gol-visitante\">\r\n              <span class=\"ov-resultados-gol-num\"></span><span class=\"ov-resultados-gol-pen\"></span>\r\n            </div>\r\n            <div class=\"ov-resultados-titulo-encuentro-fullscreen\"></div>\r\n            <div class=\"ov-resultados-estado-fullscreen\"></div>\r\n          </div>\r\n          <div class=\"ov-resultados-escudo visitante\">\r\n            <img class=\"ov-resultados-crest\" data-adjust=\"crestVisitante\" alt=\"visitante\">\r\n            <span class=\"ov-resultados-tbd\" hidden>TBD</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  `;\r\n}\r\n\r\n// Penales opcionales (2026-08-16, pedido explicito del usuario:\r\n// \"6(3) - 6(1)\"): mismo criterio de translate/dSize que \"applyPlainTextAdjust\"\r\n// (ver program/js/text-fit.js) pero targeteando el span del NUMERO\r\n// principal (\".ov-resultados-gol-num\") -- el parentesis de penales\r\n// (\".ov-resultados-gol-pen\") usa un tama\u00F1o fijo mas chico por CSS, no es\r\n// parte del ajuste individual (mantiene el layout simple, sin agregar un\r\n// segundo control de tama\u00F1o solo para eso). \"translate\" se aplica al\r\n// CONTENEDOR completo (mismo elemento que antes tenia el texto directo),\r\n// asi que mover con las flechas mueve el bloque numero+parentesis junto.\r\nfunction paintGolConPenales(containerEl, score, penales, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  const numEl = containerEl.querySelector('.ov-resultados-gol-num');\r\n  const penEl = containerEl.querySelector('.ov-resultados-gol-pen');\r\n  const penText = String(penales ?? '').trim();\r\n  const hasPenales = penText.length > 0;\r\n  numEl.textContent = String(score ?? '0');\r\n  penEl.textContent = hasPenales ? `(${penText})` : '';\r\n  containerEl.classList.toggle('has-penales', hasPenales);\r\n  containerEl.style.translate = `${dx}px ${dy}px`;\r\n  if (dSize) {\r\n    if (!numEl.dataset.baseFontSize) {\r\n      numEl.dataset.baseFontSize = parseFloat(getComputedStyle(numEl).fontSize) || 0;\r\n    }\r\n    const base = parseFloat(numEl.dataset.baseFontSize) || 0;\r\n    numEl.style.fontSize = `${Math.max(1, base + dSize)}px`;\r\n  } else if (numEl.style.fontSize) {\r\n    numEl.style.removeProperty('font-size');\r\n  }\r\n}\r\n\r\n// \"TBD\" (2026-09-27, pedido explicito del usuario: \"si una posicion del\r\n// bracket todavia no tiene equipo definido, NO dejarla vacia, mostrar\r\n// TBD\"). Mismo criterio que ya usa este renderer para el escudo (oculto\r\n// sin equipo): el span hermano \".ov-resultados-tbd\" ocupa el mismo cuadro\r\n// de 108px, se muestra exactamente cuando el escudo no se muestra, sin\r\n// tocar tama\u00F1o/posicion del cuadro en si.\r\nfunction setCrest(escudoEl, teamId) {\r\n  const imgEl = escudoEl.querySelector('.ov-resultados-crest');\r\n  const tbdEl = escudoEl.querySelector('.ov-resultados-tbd');\r\n  const src = crestFile(teamId) || '';\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.hidden = false;\r\n    if (tbdEl) tbdEl.hidden = true;\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.hidden = true;\r\n    if (tbdEl) tbdEl.hidden = false;\r\n  }\r\n}\r\n\r\nfunction paintCard(cardEl, enc, ta) {\r\n  setCrest(cardEl.querySelector('.ov-resultados-escudo.local'), enc.teamA);\r\n  setCrest(cardEl.querySelector('.ov-resultados-escudo.visitante'), enc.teamB);\r\n\r\n  const statusText = statusTextFor(enc);\r\n  const ocultaGoles = ocultaGolesFor(enc);\r\n  const golLocal = cardEl.querySelector('.ov-resultados-gol-local');\r\n  const golVisitante = cardEl.querySelector('.ov-resultados-gol-visitante');\r\n  const estado = cardEl.querySelector('.ov-resultados-estado');\r\n  const estadoFullscreen = cardEl.querySelector('.ov-resultados-estado-fullscreen');\r\n  const bloqueCentral = cardEl.querySelector('.ov-resultados-bloque-central');\r\n  const tituloEnc = cardEl.querySelector('.ov-resultados-titulo-encuentro');\r\n  const tituloEncFullscreen = cardEl.querySelector('.ov-resultados-titulo-encuentro-fullscreen');\r\n\r\n  paintGolConPenales(golLocal, enc.scoreA ?? '0', enc.penalesA, readTextAdjust(ta, 'golLocal'));\r\n  paintGolConPenales(golVisitante, enc.scoreB ?? '0', enc.penalesB, readTextAdjust(ta, 'golVisitante'));\r\n\r\n  golLocal.style.display = ocultaGoles ? 'none' : 'flex';\r\n  golVisitante.style.display = ocultaGoles ? 'none' : 'flex';\r\n  estado.style.display = ocultaGoles ? 'none' : 'flex';\r\n  estadoFullscreen.style.display = ocultaGoles ? 'flex' : 'none';\r\n\r\n  // Titulo individual por encuentro (2026-08-15): solo ocupa espacio y\r\n  // desplaza el estado/hora hacia abajo (\".has-titulo\", ver overlay.css)\r\n  // cuando el encuentro tiene texto cargado -- vacio, el dise\u00F1o base no\r\n  // cambia un pixel.\r\n  const tituloText = (enc.titulo || '').trim();\r\n  const hasTitulo = tituloText.length > 0;\r\n  bloqueCentral.classList.toggle('has-titulo', hasTitulo);\r\n  tituloEnc.style.display = hasTitulo && !ocultaGoles ? 'flex' : 'none';\r\n  tituloEncFullscreen.style.display = hasTitulo && ocultaGoles ? 'flex' : 'none';\r\n\r\n  if (ocultaGoles) {\r\n    applyFittedText(estadoFullscreen, statusText, fixedSize({\r\n      maxFont: 42, minFont: 22, maxWidth: 150, weight: 900,\r\n    }), readTextAdjust(ta, 'estadoFullscreen'));\r\n    if (hasTitulo) {\r\n      applyFittedText(tituloEncFullscreen, tituloText, fixedSize({\r\n        maxFont: 20, minFont: 11, maxWidth: 150, weight: 900,\r\n      }), readTextAdjust(ta, 'tituloBracket'));\r\n    }\r\n  } else {\r\n    applyFittedText(estado, statusText, fixedSize({\r\n      maxFont: 24, minFont: 14, maxWidth: 83, weight: 900,\r\n    }), readTextAdjust(ta, 'estado'));\r\n    if (hasTitulo) {\r\n      applyFittedText(tituloEnc, tituloText, fixedSize({\r\n        maxFont: 13, minFont: 9, maxWidth: 72, weight: 900,\r\n      }), readTextAdjust(ta, 'tituloBracket'));\r\n    }\r\n  }\r\n}\r\n\r\n// SABADO (2026-10-23): hasta 10 partidos (manual 11:00 + P1..P9). Con 10,\r\n// la segunda tanda muestra 5-10 (desplaza 4 filas); con 7-9 todo sigue\r\n// igual que siempre (4 en adelante).\r\nfunction tanda2OffsetRows(count) {\r\n  return Math.max(TANDA2_OFFSET_ROWS, count - VISIBLE_ROWS);\r\n}\r\n\r\nexport default function renderSideTable(contentEl, data) {\r\n  const encuentros = Array.isArray(data.encuentros) ? data.encuentros.slice(0, 10) : [];\r\n  const posicion = data.posicion || 'placaL';\r\n  const titulo = data.titulo || 'RESULTADOS';\r\n\r\n  if (encuentros.length === 0) {\r\n    contentEl.innerHTML = '';\r\n    delete contentEl.dataset.cardCount;\r\n    return;\r\n  }\r\n\r\n  const count = encuentros.length;\r\n  const paginado = count > VISIBLE_ROWS;\r\n  const tanda = paginado && data.tanda === 'tanda2' ? 'tanda2' : 'tanda1';\r\n  const needsRebuild = !contentEl.querySelector('.ov-resultados-wrapper')\r\n    || Number(contentEl.dataset.cardCount) !== count;\r\n\r\n  // Solo cambia la estructura si cambia la cantidad. Tanda, titulo,\r\n  // posicion, equipos, goles y estado se actualizan sobre los mismos nodos,\r\n  // evitando cortes durante un UPDATE en vivo.\r\n  if (needsRebuild) {\r\n    const cardsHtml = encuentros.map((_, index) => cardMarkup(index)).join('');\r\n    contentEl.innerHTML = `\r\n      <div class=\"ov-resultados-wrapper\">\r\n        <div class=\"ov-resultados-titulo-row\">\r\n          <div class=\"ov-resultados-bg\"></div>\r\n          <div class=\"gfx-overlay\">\r\n            <div class=\"ov-resultados-titulo-wrap\">\r\n              <div class=\"ov-resultados-titulo\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"ov-resultados-viewport\">\r\n          <div class=\"ov-resultados-track\">${cardsHtml}</div>\r\n        </div>\r\n      </div>\r\n    `;\r\n    contentEl.dataset.cardCount = String(count);\r\n  }\r\n\r\n  const wrapper = contentEl.querySelector('.ov-resultados-wrapper');\r\n  let posClass = 'placaL';\r\n  if (posicion === 'fullscreenDerecha') posClass = 'fs-derecha';\r\n  else if (posicion === 'fullscreenIzquierda') posClass = 'fs-izquierda';\r\n  wrapper.className = `ov-resultados-wrapper ov-resultados-wrapper--${posClass}`;\r\n\r\n  // Titulo general: Segoe UI Regular del Marcador en GLA (2026-10-22).\r\n  applyFittedText(contentEl.querySelector('.ov-resultados-titulo'), titulo, fixedSize(withGlaSegoeRegular({\r\n    maxFont: 30, minFont: 16, maxWidth: 350, weight: 'bold',\r\n  })), readTextAdjust(data.textAdjust, 'titulo'));\r\n\r\n  contentEl.querySelectorAll('.ov-resultados-encuentro').forEach((cardEl, index) => {\r\n    paintCard(cardEl, encuentros[index], data.textAdjust);\r\n  });\r\n\r\n  // No fabrica filas vacias: en segunda tanda, 7/8/9 encuentros muestran\r\n  // exactamente 4/5/6 brackets.\r\n  const visibleRows = tanda === 'tanda2'\r\n    ? Math.min(Math.max(count - tanda2OffsetRows(count), 0), VISIBLE_ROWS)\r\n    : Math.min(count, VISIBLE_ROWS);\r\n  const viewport = contentEl.querySelector('.ov-resultados-viewport');\r\n  viewport.style.height = `${visibleRows * ROW_HEIGHT + Math.max(visibleRows - 1, 0) * ROW_GAP}px`;\r\n\r\n  // Al cambiar tanda, el mismo track anima: 1/2/3 salen por arriba,\r\n  // 4/5/6 suben y 7/8/9 entran desde abajo. Volver invierte el movimiento.\r\n  const track = contentEl.querySelector('.ov-resultados-track');\r\n  const offsetPx = tanda === 'tanda2' ? tanda2OffsetRows(count) * ROW_STEP : 0;\r\n  track.style.transform = `translateY(-${offsetPx}px)`;\r\n\r\n  // Fondo compartido (2026-08-21, sistema multi-theme): GLA nunca toca este\r\n  // bloque (el background-image fijo por CSS sigue mandando, cero riesgo);\r\n  // para cualquier otro theme se resuelve del manifest -- sin asset\r\n  // todavia, se deja transparente y el contenido dinamico (escudos/goles/\r\n  // estado) sigue pintandose igual sobre el \".gfx-overlay\".\r\n  if (getActiveThemeId() !== DEFAULT_THEME_ID) {\r\n    const bgSrc = resolveImageSrc('sideTable', null);\r\n    contentEl.querySelectorAll('.ov-resultados-bg').forEach((bgEl) => {\r\n      bgEl.style.backgroundImage = bgSrc ? `url('${bgSrc}')` : 'none';\r\n    });\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/replay.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('replay', 'principal');\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-var-replay-sponsor\" data-adjust=\"sponsor\" />\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'replay', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderReplay(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  \r\n  const sponsorEl = contentEl.querySelector('.ov-var-replay-sponsor');\r\n  const file = sponsorFile('var', data.sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/bug.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('bug', 'principal');\r\n\r\nfunction pad2(n) {\r\n  return String(n).padStart(2, '0');\r\n}\r\n\r\n// HH:MM en hora local del sistema que corre el server/navegador \u2014 sin\r\n// segundos, a pedido. No depende de ningun campo del modulo (no hay\r\n// \"data\" que leer aca): se recalcula sola cada tick.\r\nfunction currentClock() {\r\n  const now = new Date();\r\n  return `${pad2(now.getHours())}:${pad2(now.getMinutes())}`;\r\n}\r\n\r\n// El video ya trae horneados el escudo GLA, el logo LocalStrike y el\r\n// indicador \"VIVO\" (ver overlay.css, \".ov-mosca-vivo\" queda oculto porque\r\n// duplicaria ese \"VIVO\"). La unica pieza dinamica es la hora del sistema,\r\n// que ocupa la franja dorada donde antes iba el texto editable de\r\n// sponsor (campo eliminado, ver shared/modules.js) \u2014 se arranca UNA sola\r\n// vez por montaje (no en cada render) para no acumular intervalos.\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-mosca-vivo\"><span class=\"ov-mosca-dot\"></span>VIVO</div>\r\n      <div class=\"ov-mosca-clock\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'bug', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n\r\n  // \"clock\" (2026-08-15, auditoria completa): el ajuste vivo se guarda en\r\n  // el propio nodo (el._clockAdjust) porque este tick corre en un\r\n  // setInterval propio, fuera del ciclo normal de render -- renderBug lo\r\n  // actualiza en cada llamada (ver mas abajo) para que un cambio de\r\n  // posicion/tama\u00F1o hecho en caliente se vea en el siguiente tick, sin\r\n  // esperar a que el modulo se saque y se vuelva a tomar al aire.\r\n  const clockEl = el.querySelector('.ov-mosca-clock');\r\n  const tick = () => { applyPlainTextAdjust(clockEl, currentClock(), el._clockAdjust || {}); };\r\n  tick();\r\n  el._clockInterval = setInterval(tick, 1000);\r\n}\r\n\r\nexport default function renderBug(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  contentEl._clockAdjust = readTextAdjust(data.textAdjust, 'clock');\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-mosca-clock'), currentClock(), contentEl._clockAdjust);\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n}\r\n","http://localhost:4430/program/js/asset-versions.js","// CACHE BUSTING DE RECURSOS GR\u00C1FICOS (SOFTX, 2026-10-29). El servidor manda\r\n// la versi\u00F3n de cada archivo registrado (WS ASSET_VERSIONS, derivada de su\r\n// fecha/tama\u00F1o real -- ver server/asset-resources.js). Toda URL de asset que\r\n// monta Program/Preview pasa por versionedAssetUrl(): si el operador\r\n// reemplaza el archivo con el MISMO nombre y aprieta RECARGAR, cambia la\r\n// versi\u00F3n, cambia la URL y el navegador no puede reutilizar la copia vieja\r\n// (ni del cach\u00E9 HTTP ni de la lista de im\u00E1genes ya decodificadas).\r\nimport { listCssVarAssets } from '../../shared/asset-registry.js';\r\n\r\nconst versions = new Map();\r\n\r\nexport function versionedAssetUrl(src) {\r\n  if (typeof src !== 'string' || !src) return src;\r\n  const queryAt = src.indexOf('?');\r\n  const base = queryAt === -1 ? src : src.slice(0, queryAt);\r\n  const version = versions.get(base);\r\n  return version ? `${base}?v=${version}` : src;\r\n}\r\n\r\nfunction applyCssVars() {\r\n  const rootStyle = document.documentElement.style;\r\n  for (const asset of listCssVarAssets()) {\r\n    if (versions.has(asset.path)) rootStyle.setProperty(asset.cssVar, `url(\"${versionedAssetUrl(asset.path)}\")`);\r\n  }\r\n}\r\n\r\nexport function setAssetVersions(next) {\r\n  for (const [path, version] of Object.entries(next || {})) versions.set(path, version);\r\n  applyCssVars();\r\n}\r\n","http://localhost:4430/program/js/renderers/vs.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, fitFontSize, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\n\r\nconst VIDEO_BY_RENGLON = {\r\n  normal: glaAssetPath('vs', 'normal'),\r\n  alto: glaAssetPath('vs', 'alto'),\r\n  medio: glaAssetPath('vs', 'medio'),\r\n  fino: glaAssetPath('vs', 'fino'),\r\n};\r\n\r\n// Anchos reales de \".ov-vs-teamA/B\", \".ov-vs-goalA/B\" y \".ov-vs-status\"\r\n// (ver overlay.css) \u2014 mismo criterio de auto-ajuste que Tarjeta/Cambios.\r\n// Nombre COMPLETO (no abreviatura): box de 250px, compartido con el\r\n// escudo dentro de la misma zona negra del asset (ver overlay.css).\r\n// Fuentes de nombre/gol/estado subidas levemente (2026-08-03, pedido\r\n// explicito del usuario: \"aument\u00E1 levemente el tama\u00F1o\" / \"aumente\r\n// claramente de tama\u00F1o\" para el estado) \u2014 solo estas constantes de\r\n// auto-ajuste, sin tocar boxes horizontales ni logica de datos.\r\nconst TEAM_MAX_FONT = 30;\r\nconst TEAM_MIN_FONT = 14;\r\nconst TEAM_BOX_WIDTH = 250;\r\nconst TEAM_SAFETY_MARGIN = 14;\r\nconst TEAM_MAX_WIDTH = TEAM_BOX_WIDTH - TEAM_SAFETY_MARGIN;\r\n// Unico ajuste vertical para ambos equipos. Antes applyFittedText calculaba\r\n// un translateY distinto segun los glifos de cada nombre (por ejemplo,\r\n// \"Brarg\" -2px y \"Dou FC\" +0.5px), aunque las dos cajas CSS fueran\r\n// identicas. El auto-ajuste conserva la logica compartida de font-size,\r\n// pero la longitud/contenido ya no puede cambiar la posicion vertical.\r\nconst TEAM_VERTICAL_OFFSET = 0.5;\r\n\r\n// Gol de cada equipo: recuadro amarillo lateral propio (74-75px, ver\r\n// overlay.css), separado del estado real (bloque central angosto,\r\n// 80px, marcado por la cintura de las muescas del asset).\r\nconst GOAL_MAX_FONT = 40;\r\nconst GOAL_MIN_FONT = 16;\r\nconst GOAL_BOX_WIDTH = 74;\r\nconst GOAL_SAFETY_MARGIN = 10;\r\nconst GOAL_MAX_WIDTH = GOAL_BOX_WIDTH - GOAL_SAFETY_MARGIN;\r\n\r\nconst STATUS_MAX_FONT = 28;\r\nconst STATUS_MIN_FONT = 11;\r\nconst STATUS_BOX_WIDTH = 80;\r\nconst STATUS_SAFETY_MARGIN = 4;\r\nconst STATUS_MAX_WIDTH = STATUS_BOX_WIDTH - STATUS_SAFETY_MARGIN;\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nasync function applyTeamName(el, rawText, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  const text = toBroadcastUpper(rawText);\r\n  el.textContent = text;\r\n  el.style.transform = `translate(${dx}px, ${TEAM_VERTICAL_OFFSET + dy}px)`;\r\n  const size = await fitFontSize(text, {\r\n    maxFont: TEAM_MAX_FONT,\r\n    minFont: TEAM_MIN_FONT,\r\n    maxWidth: TEAM_MAX_WIDTH,\r\n    weight: 800,\r\n  });\r\n  // Evita que una medicion asincronica anterior pise una actualizacion mas\r\n  // reciente si el operador cambia de equipo rapidamente.\r\n  if (el.textContent === text) el.style.fontSize = `${Math.max(1, size + dSize)}px`;\r\n}\r\n\r\n// Sin campos de equipo propios: equipo A/B (nombre completo, abreviatura\r\n// de 3 letras y escudo) se leen en vivo de \"scoreboard\" (5to argumento,\r\n// mismo patron que marcadorPenales/marcadorEntretiempo/tarjeta/cambios) \u2014\r\n// el VS siempre anuncia el mismo partido cargado en el marcador\r\n// principal, no se vuelve a elegir equipo aca.\r\nexport default function renderVs(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const src = VIDEO_BY_RENGLON[data.renglon] || VIDEO_BY_RENGLON.normal;\r\n  // \"renglonChanged\" (2026-09-23, mismo bug/fix que tarjeta.js -- ver\r\n  // comentario ahi): cambiar el renglon CON LA GRAFICA AL AIRE montaba un\r\n  // video nuevo sin destruir el anterior ni reproducirlo.\r\n  const renglonChanged = contentEl.dataset.renglon !== undefined && contentEl.dataset.renglon !== data.renglon;\r\n\r\n  if (!contentEl._gfxBuilt || renglonChanged) {\r\n    contentEl.dataset.renglon = data.renglon;\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    contentEl.innerHTML = `\r\n      <div class=\"av-target\"></div>\r\n      <div class=\"gfx-overlay\">\r\n        <img class=\"ov-vs-crestA\" data-adjust=\"localCrest\" />\r\n        <div class=\"ov-vs-teamA\"></div>\r\n        <div class=\"ov-vs-goalA\"></div>\r\n        <div class=\"ov-vs-status\"></div>\r\n        <div class=\"ov-vs-goalB\"></div>\r\n        <div class=\"ov-vs-teamB\"></div>\r\n        <img class=\"ov-vs-crestB\" data-adjust=\"awayCrest\" />\r\n        <img class=\"ov-vs-sponsor\" data-adjust=\"sponsor\" />\r\n      </div>\r\n    `;\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.av-target'), 'vs', src, undefined, data.renglon);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n\r\n  if (justTaken || renglonChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const scoreA = sb.scoreA;\r\n  const scoreB = sb.scoreB;\r\n  // CONTENIDO CENTRAL (2026-09-10, pedido explicito del usuario: \"lo que\r\n  // escriba ah\u00ED debe ser exactamente lo que se renderiza en el centro... no\r\n  // forzar un valor si est\u00E1 vac\u00EDo\") -- reemplaza al viejo mecanismo de\r\n  // \"Estado del encuentro\" preseleccionado + texto libre opcional que lo\r\n  // pisaba: ahora es 100% manual, sin ningun preset de respaldo.\r\n  const statusLabel = (data.statusTexto || '').trim();\r\n\r\n  setCrest(contentEl.querySelector('.ov-vs-crestA'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-vs-crestB'), sb.teamB);\r\n\r\n  applyTeamName(contentEl.querySelector('.ov-vs-teamA'), teamName(sb.teamA), readTextAdjust(data.textAdjust, 'nameA'));\r\n  applyTeamName(contentEl.querySelector('.ov-vs-teamB'), teamName(sb.teamB), readTextAdjust(data.textAdjust, 'nameB'));\r\n\r\n  // Gol de cada equipo en su propio recuadro amarillo lateral (independiente\r\n  // uno del otro, ninguno invade el bloque central del estado).\r\n  // \"MOSTRAR GOLES: SIN GOLES\" (2026-10-22, SOLO GLA): oculta unicamente\r\n  // los dos goles; nombres, escudos, estado central y sponsor sin cambios.\r\n  const hideGoals = getActiveThemeId() === 'gla' && data.mostrarGoles === 'sin';\r\n  const goalAEl = contentEl.querySelector('.ov-vs-goalA');\r\n  const showGoalA = !hideGoals && String(scoreA).trim() !== '';\r\n  goalAEl.style.display = showGoalA ? 'flex' : 'none';\r\n  if (showGoalA) {\r\n    applyFittedText(goalAEl, String(scoreA), {\r\n      maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 700,\r\n    }, readTextAdjust(data.textAdjust, 'goalA'));\r\n  }\r\n\r\n  const goalBEl = contentEl.querySelector('.ov-vs-goalB');\r\n  const showGoalB = !hideGoals && String(scoreB).trim() !== '';\r\n  goalBEl.style.display = showGoalB ? 'flex' : 'none';\r\n  if (showGoalB) {\r\n    applyFittedText(goalBEl, String(scoreB), {\r\n      maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 700,\r\n    }, readTextAdjust(data.textAdjust, 'goalB'));\r\n  }\r\n\r\n  // Bloque central: unicamente el estado del partido, nunca el resultado.\r\n  const statusEl = contentEl.querySelector('.ov-vs-status');\r\n  const showStatus = !!statusLabel;\r\n  statusEl.style.display = showStatus ? 'flex' : 'none';\r\n  if (showStatus) {\r\n    applyFittedText(statusEl, statusLabel, {\r\n      maxFont: STATUS_MAX_FONT, minFont: STATUS_MIN_FONT, maxWidth: STATUS_MAX_WIDTH, weight: 800, letterSpacing: 1,\r\n    }, readTextAdjust(data.textAdjust, 'statusTexto'));\r\n  }\r\n\r\n  // Sponsor\r\n  const sponsorEl = contentEl.querySelector('.ov-vs-sponsor');\r\n  const file = sponsorFile('vs_compact', data.sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n\r\n}\r\n","http://localhost:4430/program/js/hot-pool.js","// HOT POOL / PRELOAD SELECTIVO + RESOURCE MANAGER (2026-09-23, etapa 1-4 de\n// la optimizacion de performance -- ver informe de auditoria 2026-09-21).\n//\n// La auditoria demostro, con medicion real en Program (no una suposicion):\n// video recien creado + play() = 100-500ms de frames perdidos en el TAKE\n// (el arranque del decodificador de video por hardware); el MISMO video ya\n// montado/cargado + play() = ~0ms. Este modulo NO toca el compositor\n// (program/js/alpha-video.js, mas alla del metodo \"holdWarm\" agregado ahi)\n// ni los renderers -- solo declara CUALES modulos se mantienen\n// precalentados y ofrece un registro liviano (lifecycle + limite) que\n// program/js/main.js consulta para decidir cuando reusar en vez de\n// destruir.\n//\n// Lifecycle conceptual (ver program/js/main.js para donde se aplica cada\n// transicion):\n//   COLD    -> no montado, sin _gfxBuilt, sin recursos.\n//   WARM    -> montado (video+canvas+contexto WebGL creados, <video> con\n//              preload=\"auto\" cargando/cargado), PAUSADO, sin animar.\n//   PLAYING -> al aire, reproduciendose.\n//\n// COLD->WARM: se logra llamando al renderer normal del modulo con\n// \"justTaken=false\" sobre un contentEl todavia sin \"_gfxBuilt\" -- el mismo\n// guard \"if (!contentEl._gfxBuilt) buildStructure(...)\" que YA tiene cada\n// renderer arma video/canvas/contexto y jamas llama a \"playFromStart()\"\n// (eso solo pasa si justTaken, o si cambio la variante -- ver el fix de\n// las 4 secciones \"*Changed\" en program/js/renderers/{tarjeta,vs,\n// shortDouble,formacionEquipos}.js). No hizo falta agregar ningun modo\n// especial \"warm\" a los renderers: el guard que ya existia en TODOS ellos\n// alcanza.\n// WARM->PLAYING: un TAKE real llama al renderer con \"justTaken=true\" -- el\n// guard ve \"_gfxBuilt=true\" y NO reconstruye nada, solo llama\n// \"playFromStart()\" sobre el video ya cargado. Tampoco hizo falta tocar\n// nada nuevo aca: es el mismo camino de siempre, simplemente ya no parte\n// de cero.\n// PLAYING->WARM: en vez de \"teardownContent()\" (que destruye todo) al\n// sacar del aire un modulo del Hot Pool, program/js/main.js llama a\n// \"content._alphaVideo.holdWarm()\" y conserva el DOM/\"_gfxBuilt\" intactos.\n\n// IDs REALES del proyecto (confirmados contra shared/modules.js, no\n// adivinados) para la lista pedida por el usuario:\n//   MARCADOR        -> scoreboard\n//   MOSCA           -> bug\n//   ZOCALO LARGO    -> longDouble (\"Zocalo largo doble\")\n//   ZOCALO CORTO    -> shortSimple + shortDouble (\"Zocalo corto simple\" /\n//                       \"Zocalo corto doble\" -- son DOS modulos distintos,\n//                       se precalientan los dos)\n//   TARJETA         -> tarjeta\n//   CAMBIOS         -> cambios\n//   GOL             -> gol (maxima prioridad, ver PROTECTED_MODULE_IDS)\n//   VS              -> vs (\"Zocalo VS compacto\"; vsPrepartido/vsResultado\n//                       son placas fullscreen mucho menos frecuentes, no\n//                       entran en la lista inicial)\n//   TIEMPO ADICIONAL -> marcadorTiempoAdicional (asset PNG estatico, sin\n//                       video/decodificador -- se incluye igual porque no\n//                       cuesta nada real, pero no aporta ningun ahorro de\n//                       hitch por si mismo)\n//\n// Lista extensible a proposito (un array plano, sin logica escondida en\n// otro lado) -- agregar/quitar un modulo del Hot Pool es agregar/quitar su\n// id aca. Subir MAX_WARM_SLOTS si se agregan mas modulos de los que entren\n// hoy (ver comentario de la constante).\n// \"zocaloCompuesto\"/\"posiciones\" (2026-09-24, bug real de GLA: sus\n// animaciones de entrada se veian trabadas). Causa real: NO estaban en\n// esta lista -- cada TAKE creaba video+canvas+contexto WebGL desde cero\n// (el costo de arranque en frio del decodificador de hardware, ~100-500ms\n// de frames perdidos, ya documentado en la auditoria de performance\n// 2026-09-21) en vez de reusar uno ya precalentado como el resto. Se\n// agregan aca con el mismo mecanismo que ya usan los demas -- ver tambien\n// HOT_VARIANT_FIELD/MAX_WARM_SLOTS mas abajo (+2 slots reales por esto).\nexport const HOT_MODULE_IDS = [\n  'scoreboard',\n  'bug',\n  'longDouble',\n  'shortSimple',\n  'shortDouble',\n  'tarjeta',\n  'cambios',\n  'gol',\n  'vs',\n  'marcadorTiempoAdicional',\n  'zocaloCompuesto',\n  'posiciones',\n];\n\nconst HOT_MODULE_ID_SET = new Set(HOT_MODULE_IDS);\n\nexport function isHotModule(id) {\n  return HOT_MODULE_ID_SET.has(id);\n}\n\n// GOL nunca se expulsa del pool aunque el presupuesto este al limite (2026-\n// 09-23, pedido explicito del usuario: \"GOL es especialmente sensible...\n// quiero que GOL sea uno de los recursos de mayor prioridad del pool\").\nexport const PROTECTED_MODULE_IDS = new Set(['gol']);\n\n// Campo de \"data\" que decide la VARIANTE (que .mp4 se monta) de cada\n// modulo del Hot Pool que tiene mas de un asset posible -- mismo campo que\n// cada renderer ya usa en su propio \"contentEl.dataset.X !== data.X\" (ver\n// program/js/renderers/{tarjeta,vs,shortDouble}.js). Un modulo sin entrada\n// aca tiene un unico asset fijo, no hay nada que variar.\nexport const HOT_VARIANT_FIELD = {\n  tarjeta: 'tipo',\n  vs: 'renglon',\n  shortDouble: 'airMode',\n  zocaloCompuesto: 'tipo',\n  posiciones: 'pagina',\n};\n\n// PRESUPUESTO (2026-09-23, \"Resource Manager\", pedido explicito del\n// usuario: \"no quiero que esta optimizacion termine cargando ilimitadamente\n// VRAM\"). Medido en la auditoria: ~163MB de VRAM por video WARM (montado y\n// cargado, sin reproducir) en la maquina de referencia (RTX 3090) -- los 9\n// modulos de la lista de arriba que SI llevan video (todos salvo\n// \"marcadorTiempoAdicional\", que es un PNG) rondarian ~1.5GB si estuvieran\n// los 9 WARM a la vez. 10 deja margen para un swap de variante en vuelo\n// (destruir la vieja + montar la nueva) sin pisar el limite por casualidad,\n// sin ser un numero \"infinito\". Bajarlo en una GPU mas modesta (vMix real)\n// si la medicion de esa maquina (ver seccion 19 del pedido) muestra\n// problema; el mecanismo de expulsion (ver listEvictable) es real y se\n// ejercita en el benchmark de estres, no es decorativo.\n// Subido de 10 a 12 (2026-09-24, fix de arranque en frio de \"zocaloCompuesto\"/\n// \"posiciones\" arriba): 11 modulos con video WARM a la vez ahora (antes 9),\n// ~1.8GB en la misma maquina de referencia -- 12 conserva el mismo margen\n// de 1 slot extra para un swap de variante en vuelo que ya tenia el numero\n// anterior, sin dejar el presupuesto \"infinito\".\nexport const MAX_WARM_SLOTS = 12;\n\n// Registro { key -> { moduleId, variant, state: 'warm'|'playing', lastUsed } }.\n// \"key\" es \"moduleId\" a secas para los modulos de esta lista (un unico\n// slot WARM por modulo -- ver seccion 9 del pedido: \"variante actual WARM\"\n// en vez de precargar todas las variantes de todos los modulos, decision\n// documentada aca). Vive en memoria del propio Program (una pesta\u00F1a); no\n// necesita persistir entre recargas.\nconst registry = new Map();\n\nexport function trackWarm(key, moduleId, variant) {\n  registry.set(key, { moduleId, variant, state: 'warm', lastUsed: Date.now() });\n}\n\n// \"markPlaying\"/\"markWarm\" crean la entrada si todavia no existia (ej. un\n// modulo del Hot Pool que se tomo al aire ANTES de que \"warmHotModules()\"\n// llegara a precalentarlo -- primer Take justo despues del arranque de\n// Program) en vez de ignorar la transicion en silencio; asi el registro\n// nunca queda desincronizado del estado real por una carrera de timing.\nexport function markPlaying(key, moduleId = key) {\n  const entry = registry.get(key);\n  if (entry) { entry.state = 'playing'; entry.lastUsed = Date.now(); }\n  else registry.set(key, { moduleId, variant: undefined, state: 'playing', lastUsed: Date.now() });\n}\n\nexport function markWarm(key, moduleId = key) {\n  const entry = registry.get(key);\n  if (entry) { entry.state = 'warm'; entry.lastUsed = Date.now(); }\n  else registry.set(key, { moduleId, variant: undefined, state: 'warm', lastUsed: Date.now() });\n}\n\nexport function untrack(key) {\n  registry.delete(key);\n}\n\nexport function touch(key) {\n  const entry = registry.get(key);\n  if (entry) entry.lastUsed = Date.now();\n}\n\n// Candidatos a expulsar cuando la cantidad de slots WARM supera el\n// presupuesto: los MENOS usados recientemente primero, nunca uno\n// \"playing\" (al aire) ni uno protegido (ver PROTECTED_MODULE_IDS). Devuelve\n// solo las keys que hay que bajar a COLD para volver a estar dentro del\n// limite -- quien llama es responsable de hacer el \"destroy()\" real.\nexport function listEvictable(limit = MAX_WARM_SLOTS) {\n  const warm = [...registry.entries()]\n    .filter(([key, entry]) => entry.state === 'warm' && !PROTECTED_MODULE_IDS.has(entry.moduleId))\n    .sort((a, b) => a[1].lastUsed - b[1].lastUsed);\n  const over = warm.length - limit;\n  if (over <= 0) return [];\n  return warm.slice(0, over).map(([key]) => key);\n}\n\n// Introspeccion de solo lectura -- usada para el benchmark/QA y expuesta\n// en program/js/main.js como \"window.__glaHotPool\" para poder inspeccionar\n// el estado del pool desde la consola del navegador durante una\n// transmision real, sin herramientas adicionales.\nexport function snapshot() {\n  return [...registry.entries()].map(([key, entry]) => ({ key, ...entry }));\n}\n","http://localhost:4430/program/js/renderers/vsPrepartido.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('vsPrepartido', 'principal');\r\nconst DEFAULT_TITULO = 'PR\u00D3XIMO PARTIDO';\r\n\r\nconst NAME_MAX_FONT = 42;\r\nconst NAME_MIN_FONT = 20;\r\nconst NAME_SAFETY_MARGIN = 24;\r\nconst NAME_MAX_WIDTH_A = 362 - NAME_SAFETY_MARGIN;\r\nconst NAME_MAX_WIDTH_B = 366 - NAME_SAFETY_MARGIN;\r\n\r\nconst TITULO_MAX_FONT = 38;\r\nconst TITULO_MIN_FONT = 20;\r\nconst TITULO_MAX_WIDTH = 905 - 40;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-vsfull-titulo\"></div>\r\n      <div class=\"ov-vsfull-teamA\"><img class=\"ov-vsfull-crest\" data-adjust=\"localCrest\" /></div>\r\n      <div class=\"ov-vsfull-teamB\"><img class=\"ov-vsfull-crest\" data-adjust=\"awayCrest\" /></div>\r\n      <div class=\"ov-vsfull-separator\"></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameA\"></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameB\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'vsPrepartido', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderVsPrepartido(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamA .ov-vsfull-crest'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamB .ov-vsfull-crest'), sb.teamB);\r\n\r\n  const nameA = resolveVsDisplayName({ mode: data.nameAMode, manualText: data.nameAManual, teamId: sb.teamA, fallbackName: teamName(sb.teamA) });\r\n  const nameB = resolveVsDisplayName({ mode: data.nameBMode, manualText: data.nameBManual, teamId: sb.teamB, fallbackName: teamName(sb.teamB) });\r\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\r\n  // usuario: fade en vez de corte duro en ACTUALIZAR -- \"vsPrepartido\" no\r\n  // es un modulo LIVE, su contenido solo cambia via TAKE/ACTUALIZAR).\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameA'), nameA, contentEl._prevNameA, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_A, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameA'), !justTaken);\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameB'), nameB, contentEl._prevNameB, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_B, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameB'), !justTaken);\r\n  contentEl._prevNameA = nameA;\r\n  contentEl._prevNameB = nameB;\r\n\r\n  const tituloEl = contentEl.querySelector('.ov-vsfull-titulo');\r\n  const newTitulo = (data.titulo || '').trim() || DEFAULT_TITULO;\r\n  const oldTitulo = contentEl._prevTitulo;\r\n\r\n  updateFittedTextWithTransition(tituloEl, newTitulo, oldTitulo, {\r\n    maxFont: TITULO_MAX_FONT, minFont: TITULO_MIN_FONT, maxWidth: TITULO_MAX_WIDTH, weight: 800, letterSpacing: 1,\r\n  }, readTextAdjust(data.textAdjust, 'titulo'), !justTaken);\r\n\r\n  contentEl._prevTitulo = newTitulo;\r\n}\r\n","http://localhost:4430/program/js/renderers/formacionEquipos.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { versionedAssetUrl } from '../asset-versions.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { DEFAULT_THEME_ID, getThemeAsset } from '../../../shared/themes.js';\r\nimport { normalizePlayers } from '../../../shared/player-lists.js';\r\nimport { teamColorHex } from '../../../shared/team-colors.js';\r\nimport { applyElementAdjust, applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('formacionEquipos', 'principal');\r\nconst SHIRTS_BASE_SRC = glaAssetPath('formacionEquipos', 'camisetas');\r\nconst SHIRTS_WHITE_SRC = glaAssetPath('formacionEquipos', 'camisetasBlancas');\r\n// GLA conserva su asset original (6 camisetas, sin arquero dibujado) tal\r\n// cual estaba. Argentina Streamers pasa a 11 (2026-09-03, pedido explicito\r\n// del usuario: \"una formacion de futbol tiene que permitir 11 titulares\")\r\n// porque \"formacion-arg/oxen/peru.png\" YA tienen las 11 posiciones dibujadas\r\n// -- medidas pixel a pixel (ver overlay.css), el sistema solo las tapaba con\r\n// un clip-path. No hay variante por asset/equipo: los 3 PNG miden igual\r\n// (centros de camiseta iguales +/-3px en los 3, ver informe de medicion).\r\nconst STARTER_LIMIT_GLA = 6;\r\nconst STARTER_LIMIT_ARGENTINA = 11;\r\nconst ARGENTINA_CONTENT_DELAY = '700ms';\r\n\r\nfunction getStarterLimit() {\r\n  return getActiveThemeId() === DEFAULT_THEME_ID ? STARTER_LIMIT_GLA : STARTER_LIMIT_ARGENTINA;\r\n}\r\n\r\nfunction resolveFormationShirts(teamId) {\r\n  const themeId = getActiveThemeId();\r\n  if (themeId === DEFAULT_THEME_ID) return versionedAssetUrl(SHIRTS_BASE_SRC);\r\n  return versionedAssetUrl(getThemeAsset(themeId, 'formacionEquipos')?.formationAssetsByTeam?.[teamId] || null);\r\n}\r\n\r\nfunction setCrest(img, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    img.src = src;\r\n    img.alt = teamName(teamId);\r\n    img.style.visibility = 'visible';\r\n  } else {\r\n    img.removeAttribute('src');\r\n    img.alt = '';\r\n    img.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el, starterLimit, isGla) {\r\n  const slots = Array.from({ length: starterLimit }, (_, index) => `\r\n    <div class=\"ov-formacion-slot ov-formacion-slot-${index}\">\r\n      <div class=\"ov-formacion-number\"></div>\r\n      <div class=\"ov-formacion-player-name\"></div>\r\n    </div>\r\n  `).join('');\r\n\r\n  // \"data-adjust=crest\" (2026-09-04): SOLO GLA -- dispara el mecanismo\r\n  // generico de Program (applyElementAdjustRegistry) que lee el registro\r\n  // de shared/adjust-registry.js (entrada \"crest\", ahora \"themeOnly:'gla'\",\r\n  // exactamente como funcionaba antes de esta tarea). Argentina Streamers\r\n  // NO lo lleva: su posicion por equipo se resuelve 100% a mano mas abajo\r\n  // (crestByTeam) -- si tambien llevara el atributo, el mecanismo generico\r\n  // pisaria ese calculo con el valor plano de siempre, rompiendo el\r\n  // guardado por equipo en cuanto hubiera una posicion especifica guardada.\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-formacion-shirts\" src=\"${versionedAssetUrl(SHIRTS_BASE_SRC)}\" alt=\"\" />\r\n      <div class=\"ov-formacion-shirts-wrap\">\r\n        <img class=\"ov-formacion-shirts-white\" src=\"${versionedAssetUrl(SHIRTS_WHITE_SRC)}\" alt=\"\" />\r\n        <div class=\"ov-formacion-shirts-tint\"></div>\r\n      </div>\r\n      ${slots}\r\n      <img class=\"ov-formacion-crest\" alt=\"\" ${isGla ? 'data-adjust=\"crest\"' : ''} />\r\n      <div class=\"ov-formacion-subs-title\">SUPLENTES</div>\r\n      <div class=\"ov-formacion-subs-viewport\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'formacionEquipos', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\n// Sin campo de color propio: el equipo (y por lo tanto el color real de la\r\n// camiseta) se leen en vivo de \"scoreboard\" (5to argumento, allData) segun\r\n// \"teamSide\" -- mismo patron que el escudo, ver mas abajo. No se duplica el\r\n// catalogo de colores (shared/team-colors.js, mismo helper que usa el\r\n// Marcador principal).\r\nexport default function renderFormacionEquipos(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const starterLimit = getStarterLimit();\r\n  const isGla = getActiveThemeId() === DEFAULT_THEME_ID;\r\n  // Reconstruye si cambia el theme en caliente (6 titulares GLA <-> 11\r\n  // Argentina Streamers, con o sin \"data-adjust=crest\" -- ver\r\n  // buildStructure): mismo criterio que \"signature\" en\r\n  // performanceTable.js -- sin esto, un cambio de theme sin recargar la\r\n  // pagina dejaba el DOM viejo (6 u 11 slots fijos desde el primer render).\r\n  const signature = String(starterLimit);\r\n  // \"signatureChanged\" (2026-09-23, mismo bug/fix que tarjeta.js/vs.js/\r\n  // shortDouble.js -- ver comentario en tarjeta.js): marcar\r\n  // \"_gfxBuilt = false\" sin destruir el \"_alphaVideo\" antes de reconstruir\r\n  // dejaba el contexto/video anterior huerfano, y como \"justTaken\" es\r\n  // false en un cambio de theme en caliente, el video nuevo tampoco se\r\n  // reproducia. En la practica el cambio de theme YA fuerza un teardown\r\n  // completo de todos los modulos antes (ver program/js/main.js), asi que\r\n  // esta rama rara vez llega a ejecutarse con un \"_alphaVideo\" previo real\r\n  // -- se corrige de todos modos por prolijidad/consistencia con el resto.\r\n  const signatureChanged = contentEl.dataset.signature !== undefined && contentEl.dataset.signature !== signature;\r\n  if (contentEl.dataset.signature !== signature) {\r\n    contentEl.dataset.signature = signature;\r\n    if (signatureChanged && contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    contentEl._gfxBuilt = false;\r\n  }\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl, starterLimit, isGla);\r\n  if (justTaken || signatureChanged) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const isVisitor = data.teamSide === 'visitor';\r\n  const teamId = isVisitor ? sb.teamB : sb.teamA;\r\n  const shirts = contentEl.querySelector('.ov-formacion-shirts');\r\n  const shirtsSrc = resolveFormationShirts(teamId);\r\n  if (shirtsSrc) {\r\n    shirts.src = shirtsSrc;\r\n    shirts.style.visibility = 'visible';\r\n  } else {\r\n    shirts.removeAttribute('src');\r\n    shirts.style.visibility = 'hidden';\r\n  }\r\n  contentEl.querySelector('.ov-formacion-shirts-wrap').style.display = isGla ? '' : 'none';\r\n  const shirtsAdjust = data.formationKitByTeam?.[teamId] || {};\r\n  applyElementAdjust(shirts, {\r\n    offsetX: shirtsAdjust.offsetX || 0,\r\n    offsetY: shirtsAdjust.offsetY || 0,\r\n    scale: shirtsAdjust.scale || 1,\r\n  });\r\n\r\n  // La entrada nueva queda estructuralmente armada a ~0,67 s. El brillo\r\n  // posterior es decorativo y no debe demorar los datos. GLA conserva sus\r\n  // 1200 ms definidos en overlay.css.\r\n  const moduleRoot = contentEl.closest('.gfx');\r\n  if (moduleRoot) {\r\n    if (isGla) moduleRoot.style.removeProperty('--dur-content-delay');\r\n    else moduleRoot.style.setProperty('--dur-content-delay', ARGENTINA_CONTENT_DELAY);\r\n  }\r\n  const crestEl = contentEl.querySelector('.ov-formacion-crest');\r\n  setCrest(crestEl, teamId);\r\n  // Posicion del escudo POR EQUIPO (2026-09-04, pedido explicito del\r\n  // usuario, SOLO Argentina Streamers): mismo patron ya probado arriba\r\n  // para \"formationKitByTeam\" (sin \"data-adjust\" en AS -- se removio del\r\n  // <img> a proposito para este theme, se resuelve 100% aca para no\r\n  // duplicar aplicacion). Si todavia no existe una posicion guardada para\r\n  // este teamId puntual, usa el valor plano \"crestOffsetX/Y/Scale\" (el\r\n  // mismo que ya existia antes de este cambio) como fallback -- asi la\r\n  // posicion actual, ya acomodada por el usuario, NO se mueve para ningun\r\n  // equipo hasta que el operador guarde una especifica desde el nuevo\r\n  // control del panel. GLA NO entra aca: su <img> SI lleva\r\n  // \"data-adjust=crest\" (ver buildStructure), el mecanismo generico de\r\n  // Program ya se lo aplica solo -- llamarlo tambien aca lo pisaria con el\r\n  // mismo valor (inofensivo hoy, pero redundante y innecesario).\r\n  if (!isGla) {\r\n    const crestAdjust = data.crestByTeam?.[teamId] || {};\r\n    applyElementAdjust(crestEl, {\r\n      offsetX: crestAdjust.crestOffsetX ?? data.crestOffsetX ?? 0,\r\n      offsetY: crestAdjust.crestOffsetY ?? data.crestOffsetY ?? 0,\r\n      scale: crestAdjust.crestScale ?? data.crestScale ?? 1,\r\n    });\r\n  }\r\n\r\n  if (isGla) contentEl.querySelector('.ov-formacion-shirts-tint').style.backgroundColor = teamColorHex(sb, isVisitor ? 'B' : 'A');\r\n\r\n  // \"playerName\"/\"playerNumber\" (2026-08-15, auditoria completa): ajuste\r\n  // compartido por las 6 posiciones (mismo criterio \"column-level\" que las\r\n  // tablas dinamicas de este sistema, ver Posiciones/Resultados) -- se lee\r\n  // una sola vez fuera del loop, mismo objeto aplicado a las 6.\r\n  const ta = data.textAdjust;\r\n  const nameAdjust = readTextAdjust(ta, 'playerName');\r\n  const numberAdjust = readTextAdjust(ta, 'playerNumber');\r\n  // Orden de carga (2026-09-10, pedido explicito del usuario, item 11):\r\n  // \"starters[0]\" es SIEMPRE el arquero, seguido de la defensa (derecha a\r\n  // izquierda), el mediocampo (derecha a izquierda) y el ataque (derecha a\r\n  // izquierda) -- \"de abajo hacia arriba y de derecha a izquierda dentro de\r\n  // cada linea\". El asset de 11 posiciones (Argentina Streamers) dibuja\r\n  // exactamente esa formacion en el orden INVERSO de indice de slot (medido\r\n  // por coordenadas reales en overlay.css: slot-10 es el unico solo/abajo\r\n  // = arquero; slots 6-9 = linea de defensa; slots 2-5 = mediocampo; slots\r\n  // 0-1 = ataque, arriba) -- por eso \"slotIndex = (starterLimit-1)-index\"\r\n  // hace exactamente ese mapeo sin tocar el dato ni el CSS existente. GLA\r\n  // (6 posiciones, sin arquero dibujado en el asset, ver comentario de\r\n  // \"STARTER_LIMIT_GLA\" arriba) conserva el orden directo de siempre.\r\n  const starters = normalizePlayers(data.starters).slice(0, starterLimit);\r\n  for (let index = 0; index < starterLimit; index++) {\r\n    const slotIndex = isGla ? index : (starterLimit - 1 - index);\r\n    const slot = contentEl.querySelector(`.ov-formacion-slot-${slotIndex}`);\r\n    const player = starters[index] || { number: '', name: '' };\r\n    applyPlainTextAdjust(slot.querySelector('.ov-formacion-number'), player.number, numberAdjust);\r\n    applyPlainTextAdjust(slot.querySelector('.ov-formacion-player-name'), player.name, nameAdjust);\r\n    slot.style.visibility = player.number || player.name ? 'visible' : 'hidden';\r\n  }\r\n\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-formacion-subs-title'), 'SUPLENTES', readTextAdjust(ta, 'subsTitle'));\r\n\r\n  const subsViewport = contentEl.querySelector('.ov-formacion-subs-viewport');\r\n  renderSubstitutes(subsViewport, normalizePlayers(data.substitutes));\r\n  applySubstitutesAdjust(subsViewport, readTextAdjust(ta, 'subsList'));\r\n}\r\n\r\n// Ajuste de posicion/tama\u00F1o del bloque completo de suplentes (2026-08-15,\r\n// auditoria completa): aparte de \"renderSubstitutes\" (que solo reconstruye\r\n// cuando cambia la lista o el alto visible, ver signature/measuredHeight\r\n// mas abajo) porque tiene que aplicarse en TODOS los renders, incluidos los\r\n// que no reconstruyen nada. \"dx\"/\"dy\" van sobre el viewport (translate, no\r\n// interfiere con el recorte por overflow que ya tiene esa caja); \"dSize\" se\r\n// suma sobre el tama\u00F1o BASE que ya calculo renderSubstitutes segun la\r\n// cantidad de suplentes (guardado en dataset.baseFontSize, ver mas abajo)\r\n// -- nunca sobre un tama\u00F1o ya ajustado de una vuelta anterior, para que\r\n// cambiar la cantidad de suplentes seguya recalculando bien el tama\u00F1o base.\r\nfunction applySubstitutesAdjust(viewport, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  viewport.style.translate = `${dx}px ${dy}px`;\r\n  viewport.querySelectorAll('.ov-formacion-subs-list').forEach((list) => {\r\n    const base = parseFloat(list.dataset.baseFontSize) || 0;\r\n    if (base) list.style.fontSize = `${Math.max(1, base + dSize)}px`;\r\n  });\r\n}\r\n\r\nfunction renderSubstitutes(viewport, players) {\r\n  const signature = JSON.stringify(players);\r\n  const visibleHeight = viewport.clientHeight;\r\n  if (\r\n    visibleHeight > 0\r\n    && viewport.dataset.signature === signature\r\n    && viewport.dataset.measuredHeight === String(visibleHeight)\r\n  ) return;\r\n  viewport.dataset.signature = signature;\r\n  viewport.dataset.measuredHeight = String(visibleHeight);\r\n  viewport.classList.remove('is-scrolling');\r\n  viewport.innerHTML = '';\r\n\r\n  const list = document.createElement('div');\r\n  list.className = 'ov-formacion-subs-list';\r\n  const baseFontSize = players.length > 12 ? 16\r\n    : players.length > 10 ? 18\r\n    : players.length > 8 ? 22\r\n    : players.length > 6 ? 26\r\n    : 30;\r\n  list.style.fontSize = `${baseFontSize}px`;\r\n  // Base sin ajuste (2026-08-15, auditoria completa): \"applySubstitutesAdjust\"\r\n  // lo lee para sumarle \"dSize\" sin perder de donde partir -- cloneNode(true)\r\n  // mas abajo copia tambien este dataset, asi que el clon de la marquesina\r\n  // (si el contenido no entra y hay que animar el scroll) lo hereda solo.\r\n  list.dataset.baseFontSize = String(baseFontSize);\r\n  for (const player of players) {\r\n    const row = document.createElement('div');\r\n    row.className = 'ov-formacion-sub';\r\n    row.textContent = toBroadcastUpper(player.number ? `${player.number} - ${player.name}` : player.name);\r\n    list.appendChild(row);\r\n  }\r\n  viewport.appendChild(list);\r\n\r\n  if (visibleHeight === 0 || list.scrollHeight <= visibleHeight) return;\r\n\r\n  const track = document.createElement('div');\r\n  track.className = 'ov-formacion-subs-track';\r\n  const clone = list.cloneNode(true);\r\n  track.append(list, clone);\r\n  viewport.replaceChildren(track);\r\n  const distance = list.scrollHeight + 22;\r\n  track.style.setProperty('--subs-distance', `${distance}px`);\r\n  track.style.setProperty('--subs-duration', `${Math.max(12, distance / 18)}s`);\r\n  viewport.classList.add('is-scrolling');\r\n}\r\n","http://localhost:4430/program/js/renderers/tarjeta.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { getProgramFontFamily, withGlaSegoeRegular } from '../program-fonts.js';\r\nimport { crestFile } from '../../../shared/teams.js';\r\nimport { readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\n\r\nconst VIDEO_BY_TIPO = {\r\n  amarilla: glaAssetPath('tarjeta', 'amarilla'),\r\n  roja: glaAssetPath('tarjeta', 'roja'),\r\n  azul: glaAssetPath('tarjeta', 'azul'),\r\n};\r\n\r\n// Ancho real de \".ov-tarjeta-jugador\" (ver overlay.css): recorrido a\r\n// left:150/width:292 (mas separado de la linea divisoria x135, y con\r\n// mas margen antes del icono de color de la tarjeta en x452).\r\n// NAME_SAFETY_MARGIN es un colchon adicional (mismo criterio que el\r\n// titulo de Penales) para que la tinta real (actualBoundingBox) nunca\r\n// quede mas ancha que la medicion de avance (measureText().width) por\r\n// algun caracter puntual.\r\n// MAX_FONT subido de 34 a 42 (referencia de imagen: \"mucha mas\r\n// presencia, sin exagerar como en intentos anteriores\" \u2014 56 y 49 se\r\n// habian visto demasiado grandes, 34 se vio bien de tama\u00F1o pero \"todavia\r\n// chico\" frente a la referencia; 42 es el punto medio entre ambos\r\n// feedbacks). NAME_MIN_FONT sube proporcional (14->18).\r\nconst NAME_MAX_FONT = 42;\r\nconst NAME_MIN_FONT = 18;\r\nconst NAME_BOX_WIDTH = 292; // ancho real de .ov-tarjeta-jugador\r\nconst NAME_SAFETY_MARGIN = 6;\r\nconst NAME_MAX_WIDTH = NAME_BOX_WIDTH - NAME_SAFETY_MARGIN;\r\n\r\nlet measureCtx = null;\r\n// Fuente de medicion (2026-10-22): en GLA la misma Segoe UI Regular 400 del\r\n// Marcador (withGlaSegoeRegular); en Argentina Streamers, la de siempre.\r\nfunction nameFont(fontSize) {\r\n  const { weight, family } = withGlaSegoeRegular({ weight: 700, family: getProgramFontFamily() });\r\n  return `${weight} ${fontSize}px ${family}`;\r\n}\r\nfunction measureWidth(text, fontSize) {\r\n  measureCtx.font = nameFont(fontSize);\r\n  return measureCtx.measureText(text).width;\r\n}\r\n\r\n// Mismo criterio que el titulo de Marcador de Penales (ver\r\n// program/js/renderers/marcadorPenales.js): estimacion proporcional\r\n// rapida + ajuste fino con medicion real, para que nombres largos nunca\r\n// invadan el icono de la tarjeta, y nombres cortos se vean grandes (nunca\r\n// un tama\u00F1o fijo chico).\r\nasync function fitNameFontSize(text) {\r\n  if (!measureCtx) measureCtx = document.createElement('canvas').getContext('2d');\r\n  await document.fonts.load(nameFont(NAME_MAX_FONT));\r\n  const widthAtMax = measureWidth(text, NAME_MAX_FONT);\r\n  if (widthAtMax <= NAME_MAX_WIDTH) return NAME_MAX_FONT;\r\n  let size = Math.floor(NAME_MAX_FONT * (NAME_MAX_WIDTH / widthAtMax));\r\n  size = Math.max(NAME_MIN_FONT, size);\r\n  while (size > NAME_MIN_FONT && measureWidth(text, size) > NAME_MAX_WIDTH) {\r\n    size -= 1;\r\n  }\r\n  return size;\r\n}\r\n\r\n// Corrige el centrado vertical dentro de \".ov-tarjeta-jugador\".\r\n// \"align-items:center\" centra la CAJA DE LINEA del texto (alto =\r\n// fontBoundingBoxAscent + fontBoundingBoxDescent), no la tinta real \u2014\r\n// Anton declara un descenso de fuente mucho mas grande que el que usa de\r\n// verdad este texto en mayusculas (fontBoundingBoxDescent >>\r\n// actualBoundingBoxDescent, reservado para caracteres que nunca se\r\n// dibujan aca), lo que puede correr la tinta hacia arriba dentro de la\r\n// caja. El desbalance exacto depende del hinting de fuente de cada\r\n// sistema/navegador \u2014 no es un numero fijo que se pueda hardcodear con\r\n// garantia, por eso se mide en vivo (mismo canvas 2D que ya se usa para\r\n// el ancho) y se aplica como una correccion vertical explicita.\r\nfunction measureVerticalCorrection(text, fontSize) {\r\n  measureCtx.font = nameFont(fontSize);\r\n  const m = measureCtx.measureText(text);\r\n  const lineBoxAscent = m.fontBoundingBoxAscent;\r\n  const lineBoxDescent = m.fontBoundingBoxDescent;\r\n  const inkAscent = m.actualBoundingBoxAscent;\r\n  const inkDescent = m.actualBoundingBoxDescent;\r\n  // Con align-items:center, el centro de la tinta real queda desplazado\r\n  // del centro de la caja en (lineBoxAscent-lineBoxDescent)/2 +\r\n  // (inkDescent-inkAscent)/2; se corrige con un translateY que cancela\r\n  // exactamente ese desplazamiento.\r\n  return -((lineBoxAscent - lineBoxDescent) / 2 + (inkDescent - inkAscent) / 2);\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Sin campo de equipo/escudo propio: \"equipo\" (local/visitante) solo elige\r\n// de que lado leer el escudo, en vivo, del Marcador principal (5to\r\n// argumento, mismo patron que marcadorPenales/marcadorEntretiempo) \u2014 no se\r\n// vuelve a cargar el escudo a mano en este panel.\r\nexport default function renderTarjeta(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const src = VIDEO_BY_TIPO[data.tipo] || VIDEO_BY_TIPO.amarilla;\r\n  // \"tipoChanged\" (2026-09-23, bug real encontrado en la auditoria de\r\n  // performance: cambiar el color de tarjeta CON LA GRAFICA AL AIRE\r\n  // montaba un video nuevo pero nunca lo destruia ni lo reproducia --\r\n  // quedaba pausado en el frame 0, la grafica se veia sin asset hasta el\r\n  // proximo Take). \"!== undefined\" (mismo criterio que zocaloCompuesto.js,\r\n  // la unica variante que ya andaba bien): en el PRIMER build (incluido un\r\n  // pre-montaje en frio del hot pool, ver program/js/main.js) todavia no\r\n  // hay \"dataset.tipo\" previo, asi que esto da false a proposito -- ese\r\n  // primer build nunca debe autoreproducirse solo por existir.\r\n  const tipoChanged = contentEl.dataset.tipo !== undefined && contentEl.dataset.tipo !== data.tipo;\r\n\r\n  if (!contentEl._gfxBuilt || tipoChanged) {\r\n    contentEl.dataset.tipo = data.tipo;\r\n    // Destruye la instancia vieja ANTES de crear la nueva (mismo orden que\r\n    // zocaloCompuesto.js): sin esto, el contexto WebGL/video anterior queda\r\n    // huerfano (nunca se libera hasta que el modulo completo se saca del\r\n    // aire), y con el Hot Pool activo ese contexto viejo ni siquiera se\r\n    // liberaria nunca solo (el modulo puede quedar WARM indefinidamente).\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    contentEl.innerHTML = `\r\n      <div class=\"av-target\"></div>\r\n      <div class=\"gfx-overlay\">\r\n        <div class=\"ov-tarjeta-team\"><img class=\"ov-tarjeta-crest\" data-adjust=\"crest\" /></div>\r\n        <div class=\"ov-tarjeta-jugador\"></div>\r\n      </div>\r\n    `;\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.av-target'), 'tarjeta', src, undefined, data.tipo);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n\r\n  if (justTaken || tipoChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const crestId = data.equipo === 'visitante' ? sb.teamB : sb.teamA;\r\n  setCrest(contentEl.querySelector('.ov-tarjeta-crest'), crestId);\r\n\r\n  const jugadorEl = contentEl.querySelector('.ov-tarjeta-jugador');\r\n  const jugadorText = toBroadcastUpper(data.jugador || '');\r\n  const adjust = readTextAdjust(data.textAdjust, 'jugador');\r\n  jugadorEl.textContent = jugadorText;\r\n  jugadorEl.style.translate = `${adjust.dx || 0}px ${adjust.dy || 0}px`;\r\n  fitNameFontSize(jugadorText).then((size) => {\r\n    if (jugadorEl.textContent !== jugadorText) return;\r\n    const finalSize = Math.max(1, size + (adjust.dSize || 0));\r\n    jugadorEl.style.fontSize = `${finalSize}px`;\r\n    const correction = measureVerticalCorrection(jugadorText, finalSize);\r\n    jugadorEl.style.transform = `translateY(${correction}px)`;\r\n  });\r\n}\r\n","http://localhost:4430/program/js/renderers/cambios.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile } from '../../../shared/teams.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('cambios', 'principal');\r\n\r\nconst TEXT_MAX_FONT = 34;\r\nconst TEXT_MIN_FONT = 18;\r\nconst TEXT_BOX_WIDTH = 220; \r\nconst TEXT_SAFETY_MARGIN = 6;\r\nconst TEXT_MAX_WIDTH = TEXT_BOX_WIDTH - TEXT_SAFETY_MARGIN;\r\n\r\nfunction setCrest(imgEl, crestId, adjust = {}) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n    const dx = adjust.dx || 0;\r\n    const dy = adjust.dy || 0;\r\n    const sc = adjust.sc !== undefined ? adjust.sc : 1;\r\n    imgEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-cambio-team\"><img class=\"ov-cambio-crest\" data-adjust=\"crest\" /></div>\r\n      <div class=\"ov-cambio-entra\"></div>\r\n      <div class=\"ov-cambio-sale\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'cambios', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderCambios(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const isVisitante = data.equipo === 'visitante' || data.equipo === 'away';\r\n  const activeTeam = isVisitante ? (sb.teamB || 'oxen') : (sb.teamA || 'argentina-streamers');\r\n\r\n  const teamAdjust = isVisitante\r\n    ? (data.crestByTeam?.away?.[activeTeam] || {})\r\n    : (data.crestByTeam?.local?.[activeTeam] || {});\r\n\r\n  const dx = (teamAdjust.awayCrestOffsetX ?? teamAdjust.localCrestOffsetX ?? data.crestOffsetX) || 0;\r\n  const dy = (teamAdjust.awayCrestOffsetY ?? teamAdjust.localCrestOffsetY ?? data.crestOffsetY) || 0;\r\n  const sc = teamAdjust.awayCrestScale ?? teamAdjust.localCrestScale ?? data.crestScale ?? 1;\r\n\r\n  const crestEl = contentEl.querySelector('.ov-cambio-crest');\r\n  setCrest(crestEl, activeTeam, { dx, dy, sc });\r\n\r\n  const ta = data.textAdjust;\r\n  const entraEl = contentEl.querySelector('.ov-cambio-entra');\r\n  const saleEl = contentEl.querySelector('.ov-cambio-sale');\r\n\r\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\r\n  // usuario: fade en vez de corte duro en ACTUALIZAR) -- Cambios no es un\r\n  // modulo LIVE, su contenido solo cambia via TAKE/ACTUALIZAR.\r\n  const entra = data.entra || '';\r\n  const sale = data.sale || '';\r\n  updateFittedTextWithTransition(entraEl, entra, contentEl._prevEntra, withGlaSegoeRegular({\r\n    maxFont: TEXT_MAX_FONT, minFont: TEXT_MIN_FONT, maxWidth: TEXT_MAX_WIDTH, weight: 700,\r\n  }), readTextAdjust(ta, 'entra'), !justTaken);\r\n  updateFittedTextWithTransition(saleEl, sale, contentEl._prevSale, withGlaSegoeRegular({\r\n    maxFont: TEXT_MAX_FONT, minFont: TEXT_MIN_FONT, maxWidth: TEXT_MAX_WIDTH, weight: 700,\r\n  }), readTextAdjust(ta, 'sale'), !justTaken);\r\n  contentEl._prevEntra = entra;\r\n  contentEl._prevSale = sale;\r\n}\r\n","http://localhost:4430/program/js/renderers/gol.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('gol', 'principal');\r\n\r\n// oneShot: el video tiene su propia animacion de entrada Y salida adentro\r\n// (el festejo \"GOOOL\" aparece y se retira solo). Cuando termina, avisa via\r\n// onOneShotEnded para que el modulo vuelva a OUT sin que el operador tenga\r\n// que apretar Sacar. Este modulo ES el video (no tiene \".gfx-overlay\" con\r\n// contenido dinamico propio) -- si el theme activo todavia no tiene este\r\n// asset, no hay nada que animar: se avisa \"terminado\" enseguida para que\r\n// el modulo no quede trabado en ON esperando un \"onEnded\" que nunca va a\r\n// llegar (2026-08-21, sistema multi-theme).\r\nexport default function renderGol(contentEl, data, justTaken, onOneShotEnded) {\r\n  if (!contentEl._gfxBuilt) {\r\n    contentEl.innerHTML = '<div class=\"av-target\"></div>';\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(\r\n      contentEl.querySelector('.av-target'),\r\n      'gol',\r\n      VIDEO_SRC,\r\n      { onEnded: onOneShotEnded },\r\n    );\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n  if (justTaken) {\r\n    if (contentEl._alphaVideo) {\r\n      contentEl._alphaVideo.playFromStart();\r\n    } else {\r\n      setTimeout(() => onOneShotEnded?.(), 0);\r\n    }\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/vsResultado.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { updateFittedTextWithTransition, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('vsResultado', 'principal');\r\nconst DEFAULT_TITULO = 'RESULTADO';\r\n\r\nconst NAME_MAX_FONT = 42;\r\nconst NAME_MIN_FONT = 20;\r\nconst NAME_SAFETY_MARGIN = 24;\r\nconst NAME_MAX_WIDTH_A = 282 - NAME_SAFETY_MARGIN;\r\nconst NAME_MAX_WIDTH_B = 286 - NAME_SAFETY_MARGIN;\r\n\r\nconst GOAL_MAX_FONT = 58;\r\nconst GOAL_MIN_FONT = 30;\r\nconst GOAL_MAX_WIDTH = 136 - 36;\r\n\r\nconst TITULO_MAX_FONT = 38;\r\nconst TITULO_MIN_FONT = 20;\r\nconst TITULO_MAX_WIDTH = 905 - 40;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  // Argentina Streamers entrego este asset como PNG (VS_RESULTADO), no\r\n  // como video -- \"mountThemedAlphaVideo\" solo resuelve \"asset.video\",\r\n  // mismo patron ya usado por marcadorEntretiempo.js/marcadorTiempoAdicional.js\r\n  // para no dejar \".av-target\" vacio. GLA sigue exactamente igual, su\r\n  // propio VIDEO_SRC via mountThemedAlphaVideo (su manifest no tiene\r\n  // \"image\" para este modulo).\r\n  const imgSrc = resolveImageSrc('vsResultado');\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-vsfull-titulo\"></div>\r\n      <div class=\"ov-vsfull-teamA\"><img class=\"ov-vsfull-crest\" data-adjust=\"localCrest\" /></div>\r\n      <div class=\"ov-vsfull-teamB\"><img class=\"ov-vsfull-crest\" data-adjust=\"awayCrest\" /></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameA\"></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameB\"></div>\r\n      <div class=\"ov-vsfull-score ov-vsfull-scoreA\"></div>\r\n      <div class=\"ov-vsfull-score-dash\">-</div>\r\n      <div class=\"ov-vsfull-score ov-vsfull-scoreB\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'vsResultado', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderVsResultado(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamA .ov-vsfull-crest'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamB .ov-vsfull-crest'), sb.teamB);\r\n\r\n  const nameA = resolveVsDisplayName({ mode: data.nameAMode, manualText: data.nameAManual, teamId: sb.teamA, fallbackName: teamName(sb.teamA) });\r\n  const nameB = resolveVsDisplayName({ mode: data.nameBMode, manualText: data.nameBManual, teamId: sb.teamB, fallbackName: teamName(sb.teamB) });\r\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\r\n  // usuario: \"todos los textos que se cambien cuando aprieto ACTUALIZAR\r\n  // que sean con animaci\u00F3n... queda muy feo el cut\"). \"vsResultado\" no es\r\n  // un modulo LIVE (no esta en MARCADOR_SUBSECTION_IDS/ALWAYS_LIVE_MODULE_IDS,\r\n  // ver master-control/js/main.js) -- su contenido solo cambia via\r\n  // TAKE/ACTUALIZAR, nunca tecla a tecla, asi que el fade nunca parpadea\r\n  // en pleno tipeo (a diferencia de un modulo LIVE, donde SI convendria\r\n  // evitarlo).\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameA'), nameA, contentEl._prevNameA, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_A, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameA'), !justTaken);\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameB'), nameB, contentEl._prevNameB, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_B, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameB'), !justTaken);\r\n  contentEl._prevNameA = nameA;\r\n  contentEl._prevNameB = nameB;\r\n\r\n  const scoreA = String(sb.scoreA ?? '');\r\n  const scoreB = String(sb.scoreB ?? '');\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-scoreA'), scoreA, contentEl._prevScoreA, {\r\n    maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(data.textAdjust, 'scoreA'), !justTaken);\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-scoreB'), scoreB, contentEl._prevScoreB, {\r\n    maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(data.textAdjust, 'scoreB'), !justTaken);\r\n  contentEl._prevScoreA = scoreA;\r\n  contentEl._prevScoreB = scoreB;\r\n\r\n  // Guion entre goles (2026-10-08, SOLO Argentina Streamers -- en GLA el\r\n  // nodo queda oculto por CSS, su asset ya trae el guion). Texto fijo con\r\n  // su propio ajuste \"scoreSep\" (dx/dy/dSize), independiente de los goles:\r\n  // moverlo nunca mueve los numeros.\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-vsfull-score-dash'), '-', readTextAdjust(data.textAdjust, 'scoreSep'));\r\n\r\n  const tituloEl = contentEl.querySelector('.ov-vsfull-titulo');\r\n  const newTitulo = (data.titulo || '').trim() || DEFAULT_TITULO;\r\n  const oldTitulo = contentEl._prevTitulo;\r\n\r\n  updateFittedTextWithTransition(tituloEl, newTitulo, oldTitulo, {\r\n    maxFont: TITULO_MAX_FONT, minFont: TITULO_MIN_FONT, maxWidth: TITULO_MAX_WIDTH, weight: 800, letterSpacing: 1,\r\n  }, readTextAdjust(data.textAdjust, 'titulo'), !justTaken);\r\n\r\n  contentEl._prevTitulo = newTitulo;\r\n}\r\n","http://localhost:4430/program/js/renderers/grupos.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { ordenarGrupo, desempateVigente } from '../../../shared/grupos-orden.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\n\r\n// PNG estaticos (sin video, ya preparados y escalados a 1920x1080 por el\r\n// usuario) \u2014 mismo criterio que marcadorZocalo.js/marcadorTiempoAdicional.js:\r\n// <img class=\"gfx-bg-image\"> a resolucion nativa, sin transform ni recorte.\r\nconst IMG_SRC = {\r\n  grupo1: glaAssetPath('grupos', 'grupo1'),\r\n  grupo2: glaAssetPath('grupos', 'grupo2'),\r\n};\r\n\r\n// Cantidad y posicion de filas medidas directamente sobre el canal alfa/color\r\n// real de ambos PNG (identicas en los dos, ver overlay.css para el detalle\r\n// completo): 3 casilleros de equipo, mismo alto y mismo paso vertical.\r\nconst ROW_COUNT = 3;\r\n\r\n// Modos de posicion (ver overlay.css para los transforms medidos de cada\r\n// uno). \"placaL\" muestra Grupo 1 y Grupo 2 juntos (apilados); los modos\r\n// fullscreen muestran un unico grupo, elegido con \"variante\".\r\nfunction normalizePosicion(posicion) {\r\n  return posicion === 'fullscreenDerecha' || posicion === 'fullscreenIzquierda' ? posicion : 'placaL';\r\n}\r\n\r\n// Orden de exhibicion: se calcula siempre a partir de \"puntos\" (mayor a\r\n// menor), nunca se guarda como dato aparte ni reordena \"filas\" (el indice\r\n// de cada fila es su SLOT del sorteo, A1..B3, que usa PARTIDOS > SABADO).\r\n// 2026-10-23 (pedido explicito del usuario): ordena por los puntos cargados\r\n// aunque las filas vengan de la web (\"ordenOficial\" ya no pisa los puntos);\r\n// entre empatados manda un VALIDAR WEB vigente para estos mismos datos, y\r\n// si no hay, el orden de los slots. Ver shared/grupos-orden.js.\r\nfunction sortedFilas(filas, desempate) {\r\n  return ordenarGrupo(filas, desempate).map((entry) => entry.fila);\r\n}\r\n\r\n// MODO WEB (2026-10-23, SOLO GLA): el snapshot WEB (\"gruposWeb\", Fase de\r\n// Grupos de Rel\u00E1mpago #4) se muestra en el ORDEN OFICIAL que publica\r\n// gla.futbol (\"posicion\"), sin recalcular nada; el MANUAL sigue con la\r\n// logica de arriba. Cada modo tiene sus propios datos, nunca se mezclan.\r\nfunction officialFilas(filas) {\r\n  return (Array.isArray(filas) ? filas : [])\r\n    .map((fila, index) => ({ fila, index }))\r\n    .sort((a, b) => (Number(a.fila.posicion) || a.index + 1) - (Number(b.fila.posicion) || b.index + 1))\r\n    .map((entry) => entry.fila);\r\n}\r\n\r\nfunction cardMarkup() {\r\n  const rows = Array.from({ length: ROW_COUNT }, (_, i) => `\r\n    <img class=\"ov-grupos-crest\" data-row=\"${i}\" data-adjust=\"crest\" />\r\n    <div class=\"ov-grupos-name\" data-row=\"${i}\"></div>\r\n    <div class=\"ov-grupos-puntos\" data-row=\"${i}\"></div>\r\n  `).join('');\r\n  return `\r\n    <img class=\"gfx-bg-image\" data-card-bg />\r\n    <div class=\"gfx-overlay\">${rows}</div>\r\n  `;\r\n}\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const file = crestFile(teamId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Pinta una tarjeta completa (imagen de fondo + 3 filas) para un grupo\r\n// puntual dentro del nodo contenedor \".ov-grupos-card\" que le corresponda.\r\n// Sin campos de equipo propios: cada fila guarda unicamente el ID del\r\n// equipo (mismo catalogo global que Marcador principal, ver\r\n// shared/teams.js) \u2014 escudo y nombre completo se derivan siempre de ese\r\n// ID, nunca se cargan ni se escriben a mano.\r\nfunction paintCard(cardEl, grupoKey, filas, textAdjust, desempate, web = false) {\r\n  const bgEl = cardEl.querySelector('[data-card-bg]');\r\n  const bgSrc = resolveImageSrc('grupos', IMG_SRC[grupoKey], grupoKey);\r\n  if (bgSrc) {\r\n    bgEl.src = bgSrc;\r\n    bgEl.style.visibility = 'visible';\r\n  } else {\r\n    bgEl.removeAttribute('src');\r\n    bgEl.style.visibility = 'hidden';\r\n  }\r\n  const ordered = web ? officialFilas(filas) : sortedFilas(filas || [], desempate);\r\n  const nombreAdjust = readTextAdjust(textAdjust, 'nombre');\r\n  const puntosAdjust = readTextAdjust(textAdjust, 'puntos');\r\n  for (let i = 0; i < ROW_COUNT; i++) {\r\n    const fila = ordered[i] || { teamId: '', puntos: '' };\r\n    setCrest(cardEl.querySelector(`.ov-grupos-crest[data-row=\"${i}\"]`), fila.teamId);\r\n    applyFittedText(\r\n      cardEl.querySelector(`.ov-grupos-name[data-row=\"${i}\"]`),\r\n      // WEB: un equipo que no se pudo asociar al catalogo se muestra con\r\n      // el nombre de la web (sin escudo), nunca con otro equipo.\r\n      fila.teamId ? teamName(fila.teamId) : (web ? fila.nombreWeb || '' : ''),\r\n      // Agrandado levemente de 28/14 (2026-08-06, pedido explicito del usuario).\r\n      { maxFont: 31, minFont: 16, maxWidth: 145, weight: 400 },\r\n      nombreAdjust,\r\n    );\r\n    applyPlainTextAdjust(cardEl.querySelector(`.ov-grupos-puntos[data-row=\"${i}\"]`), String(fila.puntos ?? ''), puntosAdjust);\r\n  }\r\n}\r\n\r\nexport default function renderGrupos(contentEl, data) {\r\n  const posicion = normalizePosicion(data.posicion);\r\n  const web = getActiveThemeId() === DEFAULT_THEME_ID && data.modoGrupos === 'web';\r\n  const fuente = web ? (data.gruposWeb || {}) : data;\r\n  const grupoVisible = data.variante === 'grupo2' ? 'grupo2' : 'grupo1';\r\n  // Firma de la estructura DOM actual: solo cambia si cambia el modo o (en\r\n  // fullscreen) el grupo elegido \u2014 nunca por un simple cambio de puntos o\r\n  // equipo, que se pinta sin reconstruir nada. Reconstruir por completo\r\n  // ante un cambio real evita que quede una tarjeta anterior flotando\r\n  // (ej. al pasar de Placa L a fullscreen, o de un grupo a otro).\r\n  const signature = posicion === 'placaL' ? 'placaL' : `${posicion}:${grupoVisible}`;\r\n\r\n  if (contentEl.dataset.signature !== signature) {\r\n    contentEl.dataset.signature = signature;\r\n    if (posicion === 'placaL') {\r\n      contentEl.innerHTML = `\r\n        <div class=\"ov-grupos-card ov-grupos-card--placaL-top\" data-slot=\"grupo1\">${cardMarkup()}</div>\r\n        <div class=\"ov-grupos-card ov-grupos-card--placaL-bottom\" data-slot=\"grupo2\">${cardMarkup()}</div>\r\n      `;\r\n    } else {\r\n      const modifier = posicion === 'fullscreenDerecha' ? 'ov-grupos-card--fs-derecha' : 'ov-grupos-card--fs-izquierda';\r\n      contentEl.innerHTML = `<div class=\"ov-grupos-card ${modifier}\" data-slot=\"${grupoVisible}\">${cardMarkup()}</div>`;\r\n    }\r\n  }\r\n\r\n  if (posicion === 'placaL') {\r\n    paintCard(contentEl.querySelector('[data-slot=\"grupo1\"]'), 'grupo1', fuente.grupo1?.filas, data.textAdjust, desempateVigente(data, 'grupo1'), web);\r\n    paintCard(contentEl.querySelector('[data-slot=\"grupo2\"]'), 'grupo2', fuente.grupo2?.filas, data.textAdjust, desempateVigente(data, 'grupo2'), web);\r\n  } else {\r\n    const card = contentEl.querySelector(`[data-slot=\"${grupoVisible}\"]`);\r\n    paintCard(card, grupoVisible, fuente[grupoVisible]?.filas, data.textAdjust, desempateVigente(data, grupoVisible), web);\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/posiciones.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, fitFontSize, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// La liga tiene 11 equipos: \"filas\" (shared/modules.js) guarda las 11 con\r\n// su posicion real (1-11, nunca renumerada). El asset solo tiene\r\n// casilleros para una mitad de la tabla a la vez, asi que \"pagina\"\r\n// decide cual video/subset se compone -- pagina1 (posiciones 1-6,\r\n// posiciones-alpha.mp4, 6 filas) o pagina2 (posiciones 7-11,\r\n// posiciones-5-alpha.mp4, 5 filas). Filas 0-4 de ambos assets miden\r\n// pixel a pixel identico (confirmado por diff de columna sobre los dos\r\n// videos reales): la unica diferencia es que el de pagina2 no tiene un\r\n// sexto casillero, por eso ambas paginas reutilizan las mismas reglas\r\n// CSS .ov-pos-row[data-row=\"0..4\"] y solo pagina1 usa tambien la fila 5.\r\n// \"pagina3\" (2026-10-22, la liga ya tiene 16 equipos): mismo asset y\r\n// mismas 5 filas que pagina2, para las posiciones 12-16.\r\nconst PAGINAS = {\r\n  pagina1: { src: glaAssetPath('posiciones', 'pagina1'), rows: 6, desde: 1, hasta: 6 },\r\n  pagina2: { src: glaAssetPath('posiciones', 'pagina2'), rows: 5, desde: 7, hasta: 11 },\r\n  pagina3: { src: glaAssetPath('posiciones', 'pagina2'), rows: 5, desde: 12, hasta: 16 },\r\n};\r\n\r\nfunction paginaConfig(data) {\r\n  return PAGINAS[data.pagina] || PAGINAS.pagina1;\r\n}\r\n\r\n// Columnas numericas reales impresas en el asset (medidas por lectura de\r\n// alfa/color, ver overlay.css) -- PTS, PJ, G, GXP, PXP, P, GF, GC, DG -- en\r\n// ese orden, sin agregar ni recortar ninguna.\r\nconst STAT_COLS = ['pts', 'pj', 'g', 'gxp', 'pxp', 'p', 'gf', 'gc', 'dg'];\r\n\r\nconst NUM_MAX_FONT = 28;\r\nconst NUM_MIN_FONT = 16;\r\nconst NUM_MAX_WIDTH = 77.5 - 24;\r\n\r\nconst EQUIPO_MAX_FONT = 32;\r\nconst EQUIPO_MIN_FONT = 16;\r\nconst EQUIPO_MAX_WIDTH = 460 - 40;\r\n\r\nconst PTS_MAX_FONT = 40;\r\nconst PTS_MIN_FONT = 22;\r\nconst PTS_MAX_WIDTH = 89 - 24;\r\n\r\n// Agrandado de 30/16 (2026-08-06, pedido explicito del usuario: \"agrandar\r\n// los numeros de todas las estadisticas\") \u2014 PTS, # y equipo sin cambios.\r\nconst STAT_MAX_FONT = 34;\r\nconst STAT_MIN_FONT = 18;\r\n// Ancho util minimo entre las 8 columnas restantes (89px, GXP/DG son un\r\n// poco mas anchas pero se usa el mismo criterio para las 9 por igual).\r\nconst STAT_MAX_WIDTH = 89 - 24;\r\n\r\n// Zocalo superior de titulo: caja real 1361px de ancho (ver overlay.css,\r\n// interior del zocalo medido por alfa/color, con inset de seguridad para\r\n// no tocar el marco dorado).\r\nconst TITULO_MAX_FONT = 44;\r\nconst TITULO_MIN_FONT = 22;\r\nconst TITULO_MAX_WIDTH = 1361 - 40;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction rowMarkup(index) {\r\n  const statCells = STAT_COLS.map((col) => `<div class=\"ov-pos-cell ov-pos-stat\" data-col=\"${col}\"></div>`).join('');\r\n  return `\r\n    <div class=\"ov-pos-row\" data-row=\"${index}\">\r\n      <div class=\"ov-pos-cell ov-pos-num\"></div>\r\n      <div class=\"ov-pos-cell ov-pos-escudo\"><img class=\"ov-pos-crest\" data-adjust=\"crest\" alt=\"\" /></div>\r\n      <div class=\"ov-pos-cell ov-pos-equipo\"></div>\r\n      ${statCells}\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction buildStructure(el, pagina, paginaId) {\r\n  const rows = Array.from({ length: pagina.rows }, (_, i) => rowMarkup(i)).join('');\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-posiciones-titulo\"></div>\r\n      ${rows}\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'posiciones', pagina.src, undefined, paginaId);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nasync function applyCenteredTitle(el, rawText, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  const text = toBroadcastUpper(rawText);\r\n  el.textContent = text;\r\n  // \"dx\"/\"dy\" via \"translate\" (2026-08-15, auditoria completa), no\r\n  // \"transform\": esta funcion depende de que \"transform\" quede SIEMPRE\r\n  // removido (ver comentario mas abajo, fix historico contra el drift de\r\n  // tinta variable) -- translate es una propiedad CSS independiente, se\r\n  // compone sin reabrir ese problema.\r\n  el.style.translate = `${dx}px ${dy}px`;\r\n  const size = await fitFontSize(text, withGlaSegoeRegular({\r\n    maxFont: TITULO_MAX_FONT,\r\n    minFont: TITULO_MIN_FONT,\r\n    maxWidth: TITULO_MAX_WIDTH,\r\n    weight: 800,\r\n    letterSpacing: 1,\r\n  }));\r\n  if (el.textContent !== text) return;\r\n  el.style.fontSize = `${Math.max(1, size + dSize)}px`;\r\n  // El flex del contenedor mantiene un unico centro vertical para todos\r\n  // los largos. No se aplica la correccion variable de tinta de\r\n  // applyFittedText, que era la que desplazaba el titulo al reducirse.\r\n  el.style.removeProperty('transform');\r\n}\r\n\r\n// Subset de la pagina actual, en el orden oficial que ya trae \"filas\"\r\n// (de la sincronizacion web o cargado a mano) -- se filtra por rango de\r\n// posicion real y se ordena por ese mismo campo, sin recalcular ningun\r\n// ranking propio (pedido explicito del usuario: el torneo puede tener\r\n// criterios de desempate que este sistema no replica). El \"#\" que se\r\n// dibuja en pantalla es siempre \"fila.posicion\" tal cual esta guardado\r\n// -- pagina2 nunca renumera 7-11 como si fueran 1-5.\r\nfunction filasParaPagina(filas, pagina) {\r\n  return (Array.isArray(filas) ? filas : [])\r\n    .filter((fila) => {\r\n      const pos = Number(fila?.posicion);\r\n      return Number.isFinite(pos) && pos >= pagina.desde && pos <= pagina.hasta;\r\n    })\r\n    .sort((a, b) => Number(a.posicion) - Number(b.posicion));\r\n}\r\n\r\nexport default function renderPosiciones(contentEl, data, justTaken) {\r\n  const pagina = paginaConfig(data);\r\n  const paginaId = PAGINAS[data.pagina] ? data.pagina : 'pagina1';\r\n  // Cambio de pagina mientras el modulo sigue montado (mismo contentEl):\r\n  // el asset es distinto (video diferente), asi que hay que destruir el\r\n  // compositor viejo y crear uno nuevo apuntando al video correcto -- no\r\n  // alcanza con re-pintar los datos. El flujo esperado por el usuario es\r\n  // OUT -> cambiar pagina -> TAKE (justTaken ya fuerza playFromStart), pero\r\n  // esto tambien deja el renderer correcto si en algun momento \"pagina\"\r\n  // cambia sin pasar por ese ciclo.\r\n  const needsRebuild = !contentEl._gfxBuilt || contentEl.dataset.paginaId !== paginaId;\r\n  if (needsRebuild) {\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    buildStructure(contentEl, pagina, paginaId);\r\n    contentEl.dataset.paginaId = paginaId;\r\n  }\r\n  if (justTaken || needsRebuild) contentEl._alphaVideo?.playFromStart();\r\n\r\n  // Titulo del zocalo superior: valor inicial 'POSICIONES' (ver defaults en\r\n  // shared/modules.js) hasta que el operador lo cambie; completamente\r\n  // editable, sin invadir filas ni columnas (posicionado solo dentro del\r\n  // zocalo de arriba, ver overlay.css).\r\n  const ta = data.textAdjust;\r\n  const tituloEl = contentEl.querySelector('.ov-posiciones-titulo');\r\n  applyCenteredTitle(tituloEl, data.titulo || '', readTextAdjust(ta, 'titulo'));\r\n\r\n  // Ajuste column-level (2026-08-15, auditoria completa): un unico control\r\n  // por columna (ver master-control/js/posiciones-panel.js) se lee UNA vez\r\n  // fuera del loop de filas y se aplica por igual a todas las filas\r\n  // visibles de esa columna -- mismo criterio que Resultados/Goleadores.\r\n  const numAdjust = readTextAdjust(ta, 'numero');\r\n  const equipoAdjust = readTextAdjust(ta, 'equipo');\r\n\r\n  const ordered = filasParaPagina(data.filas, pagina);\r\n  for (let i = 0; i < pagina.rows; i++) {\r\n    const row = contentEl.querySelector(`.ov-pos-row[data-row=\"${i}\"]`);\r\n    const fila = ordered[i] || {};\r\n\r\n    applyFittedText(row.querySelector('.ov-pos-num'), fila.posicion != null ? String(fila.posicion) : '', withGlaSegoeRegular({\r\n      maxFont: NUM_MAX_FONT, minFont: NUM_MIN_FONT, maxWidth: NUM_MAX_WIDTH, weight: 900,\r\n    }), numAdjust);\r\n\r\n    setCrest(row.querySelector('.ov-pos-crest'), fila.teamId);\r\n\r\n    applyFittedText(row.querySelector('.ov-pos-equipo'), fila.teamId ? teamName(fila.teamId) : '', withGlaSegoeRegular({\r\n      maxFont: EQUIPO_MAX_FONT, minFont: EQUIPO_MIN_FONT, maxWidth: EQUIPO_MAX_WIDTH, weight: 800,\r\n    }), equipoAdjust);\r\n\r\n    for (const col of STAT_COLS) {\r\n      const cell = row.querySelector(`.ov-pos-stat[data-col=\"${col}\"]`);\r\n      const value = col === 'pts' ? (fila.puntos ?? 0) : (fila[col] ?? 0);\r\n      const colAdjust = readTextAdjust(ta, col);\r\n      if (col === 'pts') {\r\n        applyFittedText(cell, String(value), withGlaSegoeRegular({\r\n          maxFont: PTS_MAX_FONT, minFont: PTS_MIN_FONT, maxWidth: PTS_MAX_WIDTH, weight: 900,\r\n        }), colAdjust);\r\n      } else {\r\n        applyFittedText(cell, String(value), withGlaSegoeRegular({\r\n          maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n        }), colAdjust);\r\n      }\r\n    }\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/estrellas.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust, measureTextWidth, toBroadcastUpper } from '../text-fit.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('estrellas', 'principal');\r\n\r\n// Dimensiones de los textos medidos de forma real\r\n// NAME agrandado de 28/14 (2026-08-06, pedido explicito del usuario:\r\n// \"agrandar el nombre de los jugadores\") \u2014 STAT y TITULO sin cambios.\r\nconst NAME_MAX_FONT = 32;\r\nconst NAME_MIN_FONT = 16;\r\nconst NAME_MAX_WIDTH = 384 - 24; // 360px \u00FAtil\r\n\r\nconst STAT_MAX_FONT = 36;\r\nconst STAT_MIN_FONT = 18;\r\nconst STAT_MAX_WIDTH = 60 - 12; // 48px \u00FAtil\r\n\r\nconst TITLE_TEXT = 'LOS MEJORES DE CADA EQUIPO';\r\n// Banda del titulo: 490px de ancho (ver \".ov-estrellas-titulo\" en\r\n// overlay.css) -- un titulo manual mas largo se achica para entrar.\r\nconst TITLE_MAX_WIDTH = 490 - 20;\r\nconst TITLE_MIN_FONT = 12;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-estrellas-titulo\"></div>\r\n      \r\n      <!-- Fila Jugador Local -->\r\n      <div class=\"ov-estrellas-row ov-estrellas-row--local\">\r\n        <div class=\"ov-estrellas-escudo\">\r\n          <img class=\"ov-estrellas-crest\" data-adjust=\"localCrest\" />\r\n        </div>\r\n        <div class=\"ov-estrellas-name\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--g\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--a\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--pj\"></div>\r\n      </div>\r\n\r\n      <!-- Fila Jugador Visitante -->\r\n      <div class=\"ov-estrellas-row ov-estrellas-row--visitante\">\r\n        <div class=\"ov-estrellas-escudo\">\r\n          <img class=\"ov-estrellas-crest\" data-adjust=\"visitanteCrest\" />\r\n        </div>\r\n        <div class=\"ov-estrellas-name\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--g\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--a\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--pj\"></div>\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'estrellas', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderEstrellas(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const ta = data.textAdjust;\r\n\r\n  // T\u00EDtulo fijo: no depende de data ni ejecuta medici\u00F3n din\u00E1mica, pero\r\n  // sigue siendo texto visible en Program -> ajustable (2026-08-15,\r\n  // auditoria completa). T\u00CDTULO MANUAL (2026-10-09, pedido explicito, SOLO\r\n  // Argentina Streamers): \"data.titulo\" (vacio = el titulo de siempre).\r\n  // GLA sigue con su titulo fijo, sin cambios.\r\n  const tituloEl = contentEl.querySelector('.ov-estrellas-titulo');\r\n  const isArgentina = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID;\r\n  const tituloText = isArgentina ? (String(data.titulo || '').trim() || TITLE_TEXT) : TITLE_TEXT;\r\n  // Sin el achique del render anterior, para que el tama\u00F1o base medido sea el del CSS.\r\n  if (isArgentina) tituloEl.style.removeProperty('font-size');\r\n  applyPlainTextAdjust(tituloEl, tituloText, readTextAdjust(ta, 'titulo'));\r\n  if (isArgentina && tituloText !== TITLE_TEXT) {\r\n    const fontPx = parseFloat(tituloEl.style.fontSize || getComputedStyle(tituloEl).fontSize) || 28;\r\n    const width = measureTextWidth(toBroadcastUpper(tituloText), fontPx, { weight: 800 });\r\n    if (width > TITLE_MAX_WIDTH) {\r\n      tituloEl.style.fontSize = `${Math.max(TITLE_MIN_FONT, Math.floor(fontPx * (TITLE_MAX_WIDTH / width)))}px`;\r\n    }\r\n  }\r\n\r\n  // Escudos din\u00E1micos heredados del Marcador\r\n  const crestLocalEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-crest');\r\n  const crestVisitanteEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-crest');\r\n  setCrest(crestLocalEl, sb.teamA);\r\n  setCrest(crestVisitanteEl, sb.teamB);\r\n\r\n  // Nombre Jugador Local\r\n  const nameLocalEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-name');\r\n  applyFittedText(nameLocalEl, data.localNombre || '', {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(ta, 'localNombre'));\r\n\r\n  // Estad\u00EDsticas Jugador Local\r\n  const localGEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-stat--g');\r\n  const localAEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-stat--a');\r\n  const localPJEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-stat--pj');\r\n  applyFittedText(localGEl, String(data.localG ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'localG'));\r\n  applyFittedText(localAEl, String(data.localA ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'localA'));\r\n  applyFittedText(localPJEl, String(data.localPJ ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'localPJ'));\r\n\r\n  // Nombre Jugador Visitante\r\n  const nameVisitanteEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-name');\r\n  applyFittedText(nameVisitanteEl, data.visitanteNombre || '', {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(ta, 'visitanteNombre'));\r\n\r\n  // Estad\u00EDsticas Jugador Visitante\r\n  const visitanteGEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-stat--g');\r\n  const visitanteAEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-stat--a');\r\n  const visitantePJEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-stat--pj');\r\n  applyFittedText(visitanteGEl, String(data.visitanteG ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'visitanteG'));\r\n  applyFittedText(visitanteAEl, String(data.visitanteA ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'visitanteA'));\r\n  applyFittedText(visitantePJEl, String(data.visitantePJ ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'visitantePJ'));\r\n}\r\n","http://localhost:4430/program/js/renderers/cronogramaHoy.js","import { resolveImageSrc } from '../theme-assets.js';\nimport { crestFile, teamName } from '../../../shared/teams.js';\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\n\n// Geometria real medida pixel a pixel (2026-09-02, ver informe) sobre\n// assets/themes/argentina-streamers/brackets/cronograma-hoy.png (VS_DEFAULT\n// entregado por el usuario, nativo 962x541, escalado ~x1.9958/x1.9963 para\n// proyectarlo sobre el stage logico 1920x1080). Reemplaza por completo la\n// tarjeta fabricada en CSS que habia antes (pedido explicito: \"descartes\n// la geometr\u00EDa/propuesta anterior\"). Mismo header que Historial/Tabla\n// Estadisticas (mismo template de PNG).\nconst HEADER_LEFT = 1487;\nconst HEADER_TOP = 28;\nconst HEADER_WIDTH = 415;\nconst HEADER_HEIGHT = 64;\n\nconst CREST_CENTER_X = 1696;\nconst CREST_LOCAL_CENTER_Y = 276;\nconst CREST_VISITANTE_CENTER_Y = 771;\nconst CREST_SIZE = 140;\n\nfunction setCrest(imgEl, teamId, adjust) {\n  if (!imgEl) return;\n  const src = crestFile(teamId);\n  if (src) {\n    imgEl.src = src;\n    imgEl.alt = teamName(teamId) || teamId;\n    imgEl.style.visibility = 'visible';\n  } else {\n    imgEl.removeAttribute('src');\n    imgEl.alt = '';\n    imgEl.style.visibility = 'hidden';\n  }\n  const dx = adjust?.offsetX || 0;\n  const dy = adjust?.offsetY || 0;\n  const sc = adjust?.scale !== undefined ? adjust.scale : 1;\n  imgEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\n}\n\nfunction buildStructure(el) {\n  el.innerHTML = `\n    <img class=\"ov-crono-bg\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px;\" />\n    <div class=\"gfx-overlay\">\n      <div class=\"ov-crono-titulo\"\n        style=\"position:absolute; left:${HEADER_LEFT}px; top:${HEADER_TOP}px; width:${HEADER_WIDTH}px; height:${HEADER_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:1px; color:#ffffff; font-size:24px;\"></div>\n      <img class=\"ov-crono-crest ov-crono-crest-local\"\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_LOCAL_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n      <img class=\"ov-crono-crest ov-crono-crest-visitante\"\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_VISITANTE_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n    </div>\n  `;\n  el._gfxBuilt = true;\n}\n\n// Seleccion MANUAL de equipo (2026-09-04, cambio explicito del usuario:\n// \"quiero poder armar manualmente un enfrentamiento\" -- reemplaza la\n// herencia automatica del Marcador que tenia antes). \"data.teamLocal\"/\n// \"data.teamVisitante\" los elige el operador en el panel dedicado\n// (master-control/js/cronograma-hoy-panel.js), catalogo Argentina\n// Streamers -- ya no se lee \"allData.scoreboard\" aca.\nexport default function renderCronogramaHoy(contentEl, data, justTaken, onOneShotEnded, allData) {\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\n\n  const bgImg = contentEl.querySelector('.ov-crono-bg');\n  if (!bgImg) return; // OUT/TAKE muy rapidos: mismo guard que resultadosParciales.js/historial.js (ver ahi el porque)\n  const imageSrc = resolveImageSrc('cronogramaHoy', null);\n  if (imageSrc) {\n    bgImg.src = imageSrc;\n    bgImg.style.display = 'block';\n  } else {\n    bgImg.removeAttribute('src');\n    bgImg.style.display = 'none';\n  }\n\n  applyPlainTextAdjust(contentEl.querySelector('.ov-crono-titulo'), data.titulo || '', readTextAdjust(data.textAdjust, 'titulo'));\n\n  const teamA = data.teamLocal || '';\n  const teamB = data.teamVisitante || '';\n\n  const localAdjust = data.crestByTeam?.local?.[teamA] || {};\n  const awayAdjust = data.crestByTeam?.away?.[teamB] || {};\n\n  setCrest(contentEl.querySelector('.ov-crono-crest-local'), teamA, {\n    offsetX: localAdjust.crestLocalOffsetX || 0,\n    offsetY: localAdjust.crestLocalOffsetY || 0,\n    scale: localAdjust.crestLocalScale,\n  });\n  setCrest(contentEl.querySelector('.ov-crono-crest-visitante'), teamB, {\n    offsetX: awayAdjust.crestVisitanteOffsetX || 0,\n    offsetY: awayAdjust.crestVisitanteOffsetY || 0,\n    scale: awayAdjust.crestVisitanteScale,\n  });\n}\n","http://localhost:4430/program/js/renderers/resultadosParciales.js","import { resolveImageSrc } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\n\r\n// Reconstruido desde cero (2026-09-03, correcci\u00F3n expl\u00EDcita del usuario):\r\n// la version anterior (tarjeta fabricada en CSS, sin PNG real, 2\r\n// encuentros manuales) se descarto por completo. PNG real entregado en\r\n// \"cosas sueltas/PSD/vs_resultado.psd\" -- geometria medida pixel a pixel\r\n// (canvas + scan de color, nativo 962x541, escalado x1.99584/x1.99630\r\n// para proyectarlo sobre el stage logico 1920x1080). Mismo template de\r\n// header que Historial/Cronograma Hoy/Tabla Estadisticas.\r\n//\r\n// Confirmado explicitamente con el usuario (AskUserQuestion): un solo\r\n// partido -- escudo local/visitante + resultado, heredados en vivo del\r\n// Marcador (allData.scoreboard), mismo criterio que \"cronogramaHoy\"\r\n// (sin selector de equipo propio) y \"vsResultado\" (mismo asset, mismos\r\n// cuadritos blancos de resultado). \"data.encuentros\" (2 partidos\r\n// manuales) NO se borra del schema (shared/modules.js) pero este\r\n// renderer ya no lo usa.\r\nconst HEADER_LEFT = 1487;\r\nconst HEADER_TOP = 28;\r\nconst HEADER_WIDTH = 415;\r\nconst HEADER_HEIGHT = 64;\r\n\r\n// Escudo: centro X compartido por local/visitante (misma columna),\r\n// centro Y propio de cada uno -- medido sobre la porcion de escudo SIN\r\n// superponer el cuadrito de resultado (que ocupa la parte inferior del\r\n// escudo local / superior del escudo visitante). Tama\u00F1o 140px, mismo\r\n// criterio ya validado visualmente en Program para vsResultado/\r\n// cronogramaHoy (comparten esta columna/geometria de escudo).\r\nconst CREST_CENTER_X = 1696;\r\nconst CREST_LOCAL_CENTER_Y = 276;\r\nconst CREST_VISITANTE_CENTER_Y = 771;\r\nconst CREST_SIZE = 140;\r\n\r\n// Cuadrito blanco de resultado: nativo x819-879 (60px), y170-229 (local,\r\n// parte inferior del escudo de arriba) / y289-348 (visitante, parte\r\n// superior del escudo de abajo) -- medido con scan de color real sobre\r\n// el PNG (longest-run de pixeles gris/blanco neutros, sin contaminacion\r\n// del borde blanco decorativo del escudo). Caja de texto con margen de\r\n// seguridad hacia adentro del cuadrito real (mismo criterio que el resto\r\n// del proyecto: nunca tocar el borde), igual a la ya validada en\r\n// vsResultado (mismo asset).\r\nconst SCORE_LEFT = 1646;\r\nconst SCORE_WIDTH = 100;\r\nconst SCORE_HEIGHT = 80;\r\nconst SCORE_LOCAL_TOP = 357;\r\nconst SCORE_VISITANTE_TOP = 595;\r\n\r\nconst SCORE_MAX_FONT = 58;\r\nconst SCORE_MIN_FONT = 30;\r\nconst SCORE_MAX_WIDTH = SCORE_WIDTH - 36;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  if (!imgEl) return;\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId) || teamId;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <img class=\"ov-resparc-bg\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px;\" />\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-resparc-titulo\"\r\n        style=\"position:absolute; left:${HEADER_LEFT}px; top:${HEADER_TOP}px; width:${HEADER_WIDTH}px; height:${HEADER_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:1px; color:#ffffff; font-size:24px;\"></div>\r\n      <img class=\"ov-resparc-crest ov-resparc-crest-local\" data-adjust=\"localCrest\"\r\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_LOCAL_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\r\n      <img class=\"ov-resparc-crest ov-resparc-crest-visitante\" data-adjust=\"awayCrest\"\r\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_VISITANTE_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\r\n      <div class=\"ov-resparc-score ov-resparc-score-local\"\r\n        style=\"position:absolute; left:${SCORE_LEFT}px; top:${SCORE_LOCAL_TOP}px; width:${SCORE_WIDTH}px; height:${SCORE_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#0a0a0c;\"></div>\r\n      <div class=\"ov-resparc-score ov-resparc-score-visitante\"\r\n        style=\"position:absolute; left:${SCORE_LEFT}px; top:${SCORE_VISITANTE_TOP}px; width:${SCORE_WIDTH}px; height:${SCORE_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#0a0a0c;\"></div>\r\n    </div>\r\n  `;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderResultadosParciales(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n\r\n  const bgImg = contentEl.querySelector('.ov-resparc-bg');\r\n  if (!bgImg) return; // OUT/TAKE muy rapidos: un tick tardio del ticker (setInterval de 500ms, program/js/main.js) puede llegar a correr contra un contentEl recien vaciado por teardownContent -- ver mismo guard en cronogramaHoy.js/historial.js\r\n  const imageSrc = resolveImageSrc('resultadosParciales', null);\r\n  if (imageSrc) {\r\n    bgImg.src = imageSrc;\r\n    bgImg.style.display = 'block';\r\n  } else {\r\n    bgImg.removeAttribute('src');\r\n    bgImg.style.display = 'none';\r\n  }\r\n\r\n  const ta = data.textAdjust;\r\n  applyPlainTextAdjust(\r\n    contentEl.querySelector('.ov-resparc-titulo'),\r\n    toBroadcastUpper((data.titulo || '').trim() || 'RESULTADOS PARCIALES'),\r\n    readTextAdjust(ta, 'titulo'),\r\n  );\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  setCrest(contentEl.querySelector('.ov-resparc-crest-local'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-resparc-crest-visitante'), sb.teamB);\r\n\r\n  applyFittedText(contentEl.querySelector('.ov-resparc-score-local'), String(sb.scoreA ?? ''), {\r\n    maxFont: SCORE_MAX_FONT, minFont: SCORE_MIN_FONT, maxWidth: SCORE_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'scoreLocal'));\r\n  applyFittedText(contentEl.querySelector('.ov-resparc-score-visitante'), String(sb.scoreB ?? ''), {\r\n    maxFont: SCORE_MAX_FONT, minFont: SCORE_MIN_FONT, maxWidth: SCORE_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'scoreVisitante'));\r\n}\r\n","http://localhost:4430/program/js/renderers/fichaJugador.js","// FICHA JUGADOR (BLOQUE 4, 2026-09-09, reconstruido sobre el PNG real --\n// ver assets/themes/argentina-streamers/tablas/ficha-jugador.png). El\n// modulo ya no mantiene su propia lista de jugadores (ver shared/modules.js):\n// lee directo \"data.nombre/goles/asistencias/presencias/mvps\" -- una copia\n// sincronizada del jugador elegido en el plantel central (server/\n// playerRosters.js), escrita por master-control/js/ficha-jugador-panel.js\n// al elegir jugador o al sincronizar desde la web. Program NUNCA consulta\n// la web ni el plantel central directo: solo pinta lo que ya le llego por\n// WebSocket, igual criterio que el resto del proyecto (Estrellas,\n// Goleadores, etc.).\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\nimport { resolveImageSrc } from '../theme-assets.js';\n\n// Coordenadas medidas en vivo (canvas 2D, scan real de pixeles del PNG a\n// 1920x1080 -- ver informe entregado al usuario, BLOQUE 4 secci\u00F3n 2): el\n// dise\u00F1o real NO tiene recuadro de escudo, solo z\u00F3calo superior (nombre) +\n// 4 recuadros de estad\u00EDstica en una columna vertical derecha. Los labels\n// (\"GOLES\"/\"ASISTENCIAS\"/\"PRESENCIAS\"/\"MVPS\") ya est\u00E1n horneados en el\n// PNG -- estos 4 recuadros son SOLO para el valor numerico.\nconst NOMBRE_BOX = { left: 1501, top: 37, width: 317, height: 75 };\nconst STAT_BOXES = {\n  goles: { left: 1618, top: 179, width: 169, height: 141 },\n  asistencias: { left: 1618, top: 378, width: 169, height: 142 },\n  presencias: { left: 1618, top: 578, width: 169, height: 142 },\n  mvps: { left: 1618, top: 778, width: 169, height: 163 },\n};\n\nfunction boxStyle(box) {\n  return `position:absolute; left:${box.left}px; top:${box.top}px; width:${box.width}px; height:${box.height}px; display:flex; align-items:center; justify-content:center;`;\n}\n\nfunction buildStructure(contentEl) {\n  const imgSrc = resolveImageSrc('fichaJugador');\n  contentEl.innerHTML = `\n    <div class=\"ov-ficha-card\">\n      ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\n      <div class=\"gfx-overlay\">\n        <div class=\"ov-ficha-nombre\" style=\"${boxStyle(NOMBRE_BOX)}\"></div>\n        ${Object.entries(STAT_BOXES).map(([key, box]) => `\n          <div class=\"ov-ficha-stat-value\" data-stat=\"${key}\" style=\"${boxStyle(box)}\"></div>\n        `).join('')}\n      </div>\n    </div>\n  `;\n  contentEl._gfxBuilt = true;\n}\n\n// \"xDisponible === false\" (pedido explicito, secci\u00F3n 7: \"nunca inventar\n// una estad\u00EDstica... mostrar claramente que no est\u00E1 disponible\") se\n// muestra como \"\u2014\" en vez de \"0\": un cero real (la web confirm\u00F3 0) y un\n// dato nunca informado por la web son cosas distintas, no se pueden pintar\n// igual.\nfunction statText(data, key, disponibleKey) {\n  if (data[disponibleKey] === false) return '\u2014';\n  const value = Number(data[key]);\n  return Number.isFinite(value) ? String(value) : '0';\n}\n\nexport default function renderFichaJugador(contentEl, data, justTaken) {\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\n\n  const ta = data.textAdjust;\n\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\n  // usuario: fade en vez de corte duro en ACTUALIZAR) -- Ficha Jugador no\n  // es un modulo LIVE, su contenido solo cambia via TAKE/ACTUALIZAR (elegir\n  // jugador o sincronizar datos de la web).\n  const nombre = data.nombre || '';\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-ficha-nombre'), nombre, contentEl._prevNombre, {\n    maxFont: 30, minFont: 14, maxWidth: NOMBRE_BOX.width - 24, weight: 800,\n  }, readTextAdjust(ta, 'nombre'), !justTaken);\n  contentEl._prevNombre = nombre;\n\n  const statMap = {\n    goles: 'golesDisponible',\n    asistencias: 'asistenciasDisponible',\n    presencias: 'presenciasDisponible',\n    mvps: 'mvpsDisponible',\n  };\n  if (!contentEl._prevStats) contentEl._prevStats = {};\n  for (const [key, disponibleKey] of Object.entries(statMap)) {\n    const el = contentEl.querySelector(`.ov-ficha-stat-value[data-stat=\"${key}\"]`);\n    const box = STAT_BOXES[key];\n    const text = statText(data, key, disponibleKey);\n    updateFittedTextWithTransition(el, text, contentEl._prevStats[key], {\n      maxFont: 44, minFont: 18, maxWidth: box.width - 20, weight: 900,\n    }, readTextAdjust(ta, key), !justTaken);\n    contentEl._prevStats[key] = text;\n  }\n}\n","http://localhost:4430/program/js/renderers/performanceTable.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyElementAdjust, applyFittedText, applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// Titulo por default segun modulo (2026-09-02, pedido explicito del\r\n// usuario: \"T\u00CDTULO configurable\" sobre TABLA_ESTADISTICAS.png -- el\r\n// operador puede escribir el suyo, esto es solo el fallback cuando el\r\n// campo esta vacio).\r\nconst DEFAULT_TITLE = {\r\n  goleadores: 'GOLEADORES',\r\n  asistidores: 'ASISTIDORES',\r\n  jugadores: 'PARTICIPACIONES',\r\n};\r\n\r\n// GLA: siempre 6 filas, sin cambios (mismo asset/geometria de siempre).\r\n// Argentina Streamers (2026-09-02, pedido explicito del usuario: \"modo\r\n// cantidad\" 5/10 SLOTS): 5 filas cuando la placa comparte la zona\r\n// vertical con otra (\"placaL-top\"/\"placaL-bottom\"), 10 cuando ocupa toda\r\n// la zona ella sola (\"placaL-solo\"). Sin asset real todavia -- ver\r\n// ROW_COUNT_ARGENTINA abajo y el comentario de \"buildStructure\": el\r\n// contenido dinamico funciona igual sobre transparencia, el banner\r\n// \"ASSET PENDIENTE\" de Master Control indica que falta el grafico.\r\nconst ROW_COUNT_GLA = 6;\r\nconst ROW_COUNT_ARGENTINA = { 'placaL-top': 5, 'placaL-bottom': 5, 'placaL-solo': 10 };\r\n\r\nfunction rowCountFor(position) {\r\n  if (getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID && ROW_COUNT_ARGENTINA[position]) {\r\n    return ROW_COUNT_ARGENTINA[position];\r\n  }\r\n  return ROW_COUNT_GLA;\r\n}\r\n\r\nconst CONFIG = {\r\n  goleadores: {\r\n    image: glaAssetPath('goleadores', 'principal'),\r\n    ranking: true,\r\n    value: (player) => number(player.g),\r\n    compare: (a, b) => {\r\n      const goals = number(b.player.g) - number(a.player.g);\r\n      return goals !== 0 ? goals : a.index - b.index;\r\n    },\r\n  },\r\n  asistidores: {\r\n    image: glaAssetPath('asistidores', 'principal'),\r\n    ranking: true,\r\n    value: (player) => number(player.a),\r\n    compare: (a, b) => {\r\n      const assists = number(b.player.a) - number(a.player.a);\r\n      return assists !== 0 ? assists : a.index - b.index;\r\n    },\r\n  },\r\n  jugadores: {\r\n    image: glaAssetPath('jugadores', 'principal'),\r\n    values: (player) => [number(player.g), number(player.a), number(player.pj)],\r\n    // \"value\" (2026-09-02, SOLO se usa en modo ranking -- ver\r\n    // \"isRankingMode\" mas abajo, exclusivo de Argentina Streamers): la\r\n    // unica estadistica visible en el layout de 3 columnas\r\n    // (posicion+jugador+estadistica) sobre TABLA_ESTADISTICAS.png es \"PJ\"\r\n    // (partidos jugados) -- la metrica que ya maneja este modulo y que\r\n    // literalmente significa \"participaciones\", el nombre de broadcast de\r\n    // este modulo. GLA nunca lee esto (sigue con \"values\", G/A/PJ).\r\n    value: (player) => number(player.pj),\r\n    compare: (a, b) => {\r\n      const scoreA = average(a.player.g + a.player.a, a.player.pj);\r\n      const scoreB = average(b.player.g + b.player.a, b.player.pj);\r\n      const score = scoreB - scoreA;\r\n      return score !== 0 ? score : a.index - b.index;\r\n    },\r\n  },\r\n};\r\n\r\n// \"ranking\" en CONFIG es estatico (goleadores/asistidores siempre lo son,\r\n// GLA y Argentina Streamers por igual). \"jugadores\" es la excepcion: GLA\r\n// mantiene su layout propio de 3 columnas (G/A/PJ, sin cambios); Argentina\r\n// Streamers pasa a modo ranking (posicion+jugador+PJ) porque comparte\r\n// TABLA_ESTADISTICAS.png con los otros dos -- mismo asset, mismo layout de\r\n// fila, para los 3 modulos.\r\nfunction isRankingMode(moduleId) {\r\n  if (CONFIG[moduleId].ranking) return true;\r\n  return moduleId === 'jugadores' && getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID;\r\n}\r\n\r\nfunction number(value) {\r\n  const parsed = Number(value);\r\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;\r\n}\r\n\r\nfunction average(numerator, pj) {\r\n  const matches = number(pj);\r\n  return matches === 0 ? 0 : number(numerator) / matches;\r\n}\r\n\r\n// \"placaL-top\"/\"placaL-bottom\"/\"placaL-solo\" (2026-09-02): valores NUEVOS,\r\n// exclusivos del selector de Argentina Streamers (ver\r\n// master-control/js/performance-table-panel.js) -- GLA nunca los escribe,\r\n// asi que para GLA esta funcion sigue devolviendo exactamente lo mismo de\r\n// siempre.\r\nconst ARGENTINA_POSITIONS = new Set(['placaL-top', 'placaL-bottom', 'placaL-solo']);\r\n\r\n// Fallback de Argentina Streamers (2026-09-04, correccion PERMANENTE\r\n// pedida explicitamente por el usuario: \"no quiero depender de seleccionar\r\n// manualmente Placa unica\" / \"no quiero que placaL haga fallback al layout\r\n// viejo de GLA para estos modulos dentro de Argentina Streamers\"). Un\r\n// modulo de esta familia (goleadores/asistidores/jugadores) sin posicion\r\n// valida todavia -- server recien reiniciado, estado nuevo, \"posicion\"\r\n// nunca seleccionado a mano via \"MODO CANTIDAD\" -- caia en el 'placaL'\r\n// generico compartido con GLA (6 filas, tipografia y composicion\r\n// distintas: la causa real del desencuadre de Asistidores/Participaciones\r\n// reportado). GLA SI sigue usando 'placaL' como valor real (su propio\r\n// \"Placa L Info\"), asi que el fallback theme-gated de abajo es\r\n// EXCLUSIVAMENTE para Argentina Streamers -- cero cambio de\r\n// comportamiento para GLA (misma guarda de siempre).\r\nfunction normalizePosition(position) {\r\n  if (position === 'fullscreenDerecha' || position === 'fullscreenIzquierda') return position;\r\n  if (getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID) {\r\n    if (ARGENTINA_POSITIONS.has(position)) return position;\r\n    return 'placaL-solo';\r\n  }\r\n  return 'placaL';\r\n}\r\n\r\nfunction positionClass(position) {\r\n  if (position === 'fullscreenDerecha') return 'fs-derecha';\r\n  if (position === 'fullscreenIzquierda') return 'fs-izquierda';\r\n  if (ARGENTINA_POSITIONS.has(position)) return position;\r\n  return 'placaL';\r\n}\r\n\r\nfunction sortedPlayers(players, compare, rowCount) {\r\n  return (Array.isArray(players) ? players : [])\r\n    .map((player, index) => ({ player, index }))\r\n    .sort(compare)\r\n    .map((entry) => entry.player)\r\n    .slice(0, rowCount);\r\n}\r\n\r\nfunction setCrest(img, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    img.src = src;\r\n    img.alt = teamName(teamId);\r\n    img.style.visibility = 'visible';\r\n  } else {\r\n    img.removeAttribute('src');\r\n    img.alt = '';\r\n    img.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction rowMarkup(index, ranking) {\r\n  if (ranking) {\r\n    return `\r\n      <div class=\"ov-performance-row ov-performance-row--ranking\" data-row=\"${index}\">\r\n        <div class=\"ov-performance-position\"></div>\r\n        <div class=\"ov-performance-crest-cell\"><img class=\"ov-performance-crest\" data-adjust=\"crest\" alt=\"\" /></div>\r\n        <div class=\"ov-performance-name\"></div>\r\n        <div class=\"ov-performance-primary-stat\"></div>\r\n      </div>\r\n    `;\r\n  }\r\n  return `\r\n    <div class=\"ov-performance-row\" data-row=\"${index}\">\r\n      <div class=\"ov-performance-crest-cell\"><img class=\"ov-performance-crest\" data-adjust=\"crest\" alt=\"\" /></div>\r\n      <div class=\"ov-performance-name\"></div>\r\n      <div class=\"ov-performance-stat\" data-stat=\"0\"></div>\r\n      <div class=\"ov-performance-stat\" data-stat=\"1\"></div>\r\n      <div class=\"ov-performance-stat\" data-stat=\"2\"></div>\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction buildStructure(contentEl, moduleId, position, rowCount) {\r\n  const config = CONFIG[moduleId];\r\n  const imgSrc = resolveImageSrc(moduleId, config.image);\r\n  const ranking = isRankingMode(moduleId);\r\n  contentEl.innerHTML = `\r\n    <div class=\"ov-performance-card ov-performance-card--${moduleId} ov-performance-card--${positionClass(position)}\">\r\n      ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n      <div class=\"gfx-overlay\">\r\n        <div class=\"ov-performance-titulo\"></div>\r\n        <img class=\"ov-performance-titulo-crest\" data-adjust=\"tituloCrest\" alt=\"\" />\r\n        ${Array.from({ length: rowCount }, (_, index) => rowMarkup(index, ranking)).join('')}\r\n      </div>\r\n    </div>\r\n  `;\r\n}\r\n\r\nexport function renderPerformanceTable(moduleId, contentEl, data) {\r\n  const config = CONFIG[moduleId];\r\n  if (!config) throw new Error(`Tabla de rendimiento desconocida: ${moduleId}`);\r\n\r\n  const position = normalizePosition(data.posicion);\r\n  const rowCount = rowCountFor(position);\r\n  // \"isRankingMode(moduleId)\" en la firma (2026-09-02): \"jugadores\" cambia\r\n  // de layout (3 columnas <-> ranking) segun theme -- sin esto, un cambio\r\n  // de theme en caliente con el mismo \"position\"/\"rowCount\" no reconstruia\r\n  // la estructura.\r\n  const signature = `${moduleId}:${position}:${rowCount}:${isRankingMode(moduleId)}`;\r\n  if (contentEl.dataset.signature !== signature) {\r\n    contentEl.dataset.signature = signature;\r\n    buildStructure(contentEl, moduleId, position, rowCount);\r\n  }\r\n\r\n  const ta = data.textAdjust;\r\n  const ranking = isRankingMode(moduleId);\r\n  const nameAdjust = readTextAdjust(ta, 'name');\r\n  const players = sortedPlayers(data.jugadores, config.compare, rowCount);\r\n\r\n  // T\u00CDTULO (2026-09-02, pedido explicito del usuario): configurable por\r\n  // modulo, cae al nombre de broadcast si el operador no escribio nada.\r\n  const tituloEl = contentEl.querySelector('.ov-performance-titulo');\r\n  if (tituloEl) {\r\n    applyPlainTextAdjust(tituloEl, toBroadcastUpper((data.titulo || '').trim() || DEFAULT_TITLE[moduleId] || ''), readTextAdjust(ta, 'titulo'));\r\n  }\r\n\r\n  // ESCUDO T\u00CDTULO (2026-09-04, pedido explicito del usuario): siempre\r\n  // Argentina Streamers MASCULINO, fijo -- no depende del Marcador. Solo\r\n  // Argentina Streamers (GLA nunca muestra esta placa de 10 filas, la caja\r\n  // del titulo queda oculta por CSS para ese theme). Posicion/escala via\r\n  // \"data-adjust=tituloCrest\" + shared/adjust-registry.js (mecanismo\r\n  // generico, mismo patron que el resto de los \"data-adjust\" del archivo).\r\n  const tituloCrestEl = contentEl.querySelector('.ov-performance-titulo-crest');\r\n  if (tituloCrestEl) {\r\n    const src = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID ? crestFile('argentina-streamers') : null;\r\n    if (src) {\r\n      tituloCrestEl.src = src;\r\n      tituloCrestEl.style.visibility = 'visible';\r\n    } else {\r\n      tituloCrestEl.removeAttribute('src');\r\n      tituloCrestEl.style.visibility = 'hidden';\r\n    }\r\n  }\r\n\r\n  // \"placaL-solo\" (2026-09-02, Argentina Streamers, geometria real medida\r\n  // pixel a pixel sobre TABLA_ESTADISTICAS.png -- ver overlay.css): la\r\n  // columna JUGADOR es mucho mas ancha que en el layout viejo de GLA\r\n  // (313px reales contra 154px), asi que el fitted text necesita su\r\n  // propio maxWidth aca. GLA sigue exactamente con los valores de siempre.\r\n  const isArgentinaSolo = ranking && position === 'placaL-solo';\r\n\r\n  for (let index = 0; index < rowCount; index += 1) {\r\n    const row = contentEl.querySelector(`.ov-performance-row[data-row=\"${index}\"]`);\r\n    const player = players[index];\r\n    row.classList.toggle('is-empty', !player);\r\n\r\n    setCrest(row.querySelector('.ov-performance-crest'), player?.teamId);\r\n    applyFittedText(row.querySelector('.ov-performance-name'), player?.nombre || '', withGlaSegoeRegular({\r\n      maxFont: isArgentinaSolo ? 26 : (ranking ? 23 : 24),\r\n      minFont: isArgentinaSolo ? 13 : (ranking ? 11 : 10),\r\n      maxWidth: isArgentinaSolo ? 300 : (ranking ? 154 : 145),\r\n      weight: 800,\r\n    }), nameAdjust);\r\n\r\n    if (ranking) {\r\n      applyPlainTextAdjust(row.querySelector('.ov-performance-position'), player ? String(index + 1) : '', readTextAdjust(ta, 'position'));\r\n      // \"placaL\"/\"placaL-top\"/\"placaL-bottom\" (5-6 filas en media zona\r\n      // vertical): fuente grande, igual que siempre.\r\n      const isHalfColumn = position === 'placaL' || position === 'placaL-top' || position === 'placaL-bottom';\r\n      applyFittedText(row.querySelector('.ov-performance-primary-stat'), player ? String(config.value(player)) : '', withGlaSegoeRegular({\r\n        maxFont: isArgentinaSolo ? 28 : (isHalfColumn ? 30 : 25),\r\n        minFont: isArgentinaSolo ? 15 : (isHalfColumn ? 17 : 14),\r\n        maxWidth: isArgentinaSolo ? 44 : 44,\r\n        weight: 900,\r\n      }), readTextAdjust(ta, 'primaryStat'));\r\n      continue;\r\n    }\r\n\r\n    const values = player ? config.values(player) : ['', '', ''];\r\n    for (let statIndex = 0; statIndex < 3; statIndex += 1) {\r\n      applyFittedText(row.querySelector(`.ov-performance-stat[data-stat=\"${statIndex}\"]`), String(values[statIndex]), withGlaSegoeRegular({\r\n        maxFont: 23, minFont: 12, maxWidth: statIndex === 2 ? 35 : 29, weight: 900,\r\n      }), readTextAdjust(ta, `stat${statIndex}`));\r\n    }\r\n  }\r\n}\r\n\r\nexport const goleadores = (contentEl, data) => renderPerformanceTable('goleadores', contentEl, data);\r\nexport const asistidores = (contentEl, data) => renderPerformanceTable('asistidores', contentEl, data);\r\nexport const jugadores = (contentEl, data) => renderPerformanceTable('jugadores', contentEl, data);\r\n","http://localhost:4430/program/js/renderers/zocaloFinalDiv.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('zocaloFinalDiv', 'principal');\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\nconst TEXTO2_LETTER_SPACING = 0.5;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-local\" alt=\"\" />\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-visitante\" alt=\"\" />\r\n      <div class=\"ov-zfd-texto ov-zfd-texto1\"></div>\r\n      <div class=\"ov-zfd-texto ov-zfd-texto2\"></div>\r\n      <div class=\"ov-zfd-sponsor-box\">\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-1\" alt=\"\" />\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-2\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloFinalDiv', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloFinalDiv(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  const fuente = data.escudosFuente || 'MARCADOR';\r\n  const teamA = fuente === 'PERSONALIZADO' ? (data.customTeamA || '') : (sb.teamA || '');\r\n  const teamB = fuente === 'PERSONALIZADO' ? (data.customTeamB || '') : (sb.teamB || '');\r\n\r\n  setCrest(contentEl.querySelector('.ov-zfd-crest-local'), teamA);\r\n  setCrest(contentEl.querySelector('.ov-zfd-crest-visitante'), teamB);\r\n\r\n  const texto1El = contentEl.querySelector('.ov-zfd-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zfd-texto2');\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n  const oldT1 = contentEl._prevTexto1;\r\n  const oldT2 = contentEl._prevTexto2;\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, oldT1, {\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, oldT2, {\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH,\r\n    weight: 400, letterSpacing: TEXTO2_LETTER_SPACING,\r\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Rotation logic for sponsors in the empty right black box\r\n  const img1 = contentEl.querySelector('.ov-zfd-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zfd-sponsor-2');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      img1.className = 'ov-zfd-sponsor-img';\r\n      img2.className = 'ov-zfd-sponsor-img';\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      img1.className = 'ov-zfd-sponsor-img active';\r\n      img2.className = 'ov-zfd-sponsor-img';\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    activeImg.className = 'ov-zfd-sponsor-img exit';\r\n    inactiveImg.className = 'ov-zfd-sponsor-img active';\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.className.includes('exit')) {\r\n        prevImg.className = 'ov-zfd-sponsor-img';\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || contentEl._lastSponsorsSignature !== listSignature) {\r\n    // Clear previous timer if exists\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/zocaloFinal.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('zocaloFinal', 'principal');\r\nconst LOGO_SRC = glaAssetPath('zocaloFinal', 'logoImagen');\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\nconst TEXTO2_LETTER_SPACING = 0.5;\r\n\r\nfunction buildStructure(el) {\r\n  // Logo: resuelto por theme (2026-08-21) -- GLA sigue mostrando SIEMPRE\r\n  // su propio logo (fallback, nunca el manifest); otro theme sin imagen\r\n  // propia todav\u00EDa simplemente no muestra ning\u00FAn <img> (sin src roto).\r\n  const logoSrc = resolveImageSrc('zocaloFinal', LOGO_SRC);\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      ${logoSrc ? `<img class=\"ov-zf-logo\" src=\"${logoSrc}\" alt=\"logo\" />` : ''}\r\n      <div class=\"ov-zf-texto ov-zf-texto1\"></div>\r\n      <div class=\"ov-zf-texto ov-zf-texto2\"></div>\r\n      <div class=\"ov-zf-sponsor-box\">\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-1\" alt=\"\" />\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-2\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloFinal', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloFinal(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = allData && allData.scoreboard;\r\n  const texto1El = contentEl.querySelector('.ov-zf-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zf-texto2');\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n  const oldT1 = contentEl._prevTexto1;\r\n  const oldT2 = contentEl._prevTexto2;\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, oldT1, {\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, oldT2, {\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH,\r\n    weight: 400, letterSpacing: TEXTO2_LETTER_SPACING,\r\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Rotation logic for sponsors in the empty right black box\r\n  const img1 = contentEl.querySelector('.ov-zf-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zf-sponsor-2');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      img1.className = 'ov-zf-sponsor-img';\r\n      img2.className = 'ov-zf-sponsor-img';\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      img1.className = 'ov-zf-sponsor-img active';\r\n      img2.className = 'ov-zf-sponsor-img';\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    activeImg.className = 'ov-zf-sponsor-img exit';\r\n    inactiveImg.className = 'ov-zf-sponsor-img active';\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.className.includes('exit')) {\r\n        prevImg.className = 'ov-zf-sponsor-img';\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || contentEl._lastSponsorsSignature !== listSignature) {\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/historial.js","import { resolveImageSrc } from '../theme-assets.js';\nimport { crestFile, teamName } from '../../../shared/teams.js';\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\nimport { getActiveThemeId } from '../theme-client.js';\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\n\n// Geometria real medida pixel a pixel (2026-09-02, ver informe) sobre\n// assets/themes/argentina-streamers/tablas/historial.png (nativo 962x541,\n// escalado x1.9958/x1.9963 -- muy cerca de 2x, redondeado a enteros -- para\n// proyectarlo sobre el stage logico 1920x1080). \"No adivinar geometria por\n// el nombre\" -- el PNG tiene un header + 5 filas identicas, cada una\n// [escudo local][caja VS][escudo visitante], separadas 163.7px entre si.\nconst ROW_COUNT = 5;\nconst ROW_CENTERS_Y = [174.7, 338.4, 502.1, 665.8, 829.5];\nconst CREST_L_CENTER_X = 1548;\nconst CREST_R_CENTER_X = 1843;\nconst CREST_SIZE = 80;\nconst GOL_LOCAL_LEFT = 1607;\nconst GOL_VISITANTE_LEFT = 1707;\nconst GOL_WIDTH = 80;\nconst GOL_HEIGHT = 70;\n// Penales (2026-09-04, pedido explicito del usuario): \"no quiero que el\n// score principal se mueva de lugar\" -- bloque NUEVO e independiente,\n// mismo left/width que su gol (centrado respecto al numero principal),\n// pegado justo debajo. Chico a proposito (\"no construir un bloque\n// enorme\"): PEN_HEIGHT/tama\u00F1o de fuente bien menores que el gol (70px alto\n// / 40px fuente arriba).\nconst PEN_WIDTH = GOL_WIDTH;\nconst PEN_HEIGHT = 24;\nconst PEN_TOP_OFFSET = 22; // desde el centro de fila (cy), no desde el gol\nconst HEADER_LEFT = 1487;\nconst HEADER_TOP = 28;\nconst HEADER_WIDTH = 415;\nconst HEADER_HEIGHT = 64;\n// Escudo del titulo (2026-09-04, pedido explicito del usuario, item 7):\n// nunca habia existido para este modulo -- mismo criterio \"a la\n// izquierda del titulo\" que goleadores/asistidores/jugadores, tama\u00F1o\n// chico por default, 100% ajustable via GUARDAR POSICI\u00D3N.\nconst TITULO_CREST_LEFT = HEADER_LEFT - 50;\nconst TITULO_CREST_TOP = HEADER_TOP + (HEADER_HEIGHT - 40) / 2;\nconst TITULO_CREST_SIZE = 40;\n// FASE/INSTANCIA (2026-09-04, pedido explicito del usuario, item 2-3):\n// rotulo chico por fila, arriba de la caja del partido, ancho = escudo\n// local a escudo visitante -- \"no modificar la geometria actual ni\n// desacomodar escudos/goles/penales\" (bloque nuevo e independiente, igual\n// criterio que penales).\nconst FASE_LEFT = CREST_L_CENTER_X - CREST_SIZE / 2;\nconst FASE_WIDTH = (CREST_R_CENTER_X + CREST_SIZE / 2) - FASE_LEFT;\nconst FASE_HEIGHT = 18;\nconst FASE_TOP_OFFSET = -58; // desde el centro de fila (cy)\n\n// RESULTADO NORMAL / CON PENALES / PENALES fino (2026-09-04, pedido\n// explicito del usuario: \"eliminar la edicion independiente GOL LOCAL/GOL\n// VISITANTE... los dos goles deben moverse juntos\", con geometria\n// COMPLETAMENTE separada segun si la fila tiene penales o no -- mover\n// \"RESULTADO CON PENALES\" nunca puede tocar una fila sin penales, y\n// viceversa). \"BASE_ADJUST\" (item 10: \"preservar las posiciones actuales\n// como baseline, la nueva arquitectura tiene que empezar visualmente\n// igual\") hornea los offsets que YA estaban guardados en las columnas\n// viejas (\"textAdjust.golLocal/golVisitante/penalLocal/penalVisitante\",\n// commiteados en shared/theme-layouts/argentinaStreamers.json antes de\n// este cambio) como base FIJA por elemento -- los 3 campos nuevos\n// (data.resultadoNormal/resultadoConPenales/penalesFino) arrancan en\n// 0/0/0 y se SUMAN encima, asi el resultado total es identico a como\n// estaba, sin perder el trabajo de ajuste fino ya hecho.\nconst GOL_LOCAL_BASE_ADJUST = { dx: -6, dy: 0, dSize: 14 };\nconst GOL_VISITANTE_BASE_ADJUST = { dx: -2, dy: 0, dSize: 14 };\nconst PEN_LOCAL_BASE_ADJUST = { dx: -4, dy: -8, dSize: 0 };\nconst PEN_VISITANTE_BASE_ADJUST = { dx: 0, dy: -8, dSize: 0 };\n\nfunction sumAdjust(...adjusts) {\n  return adjusts.reduce((acc, a) => ({\n    dx: acc.dx + (a?.dx || 0),\n    dy: acc.dy + (a?.dy || 0),\n    dSize: acc.dSize + (a?.dSize || 0),\n  }), { dx: 0, dy: 0, dSize: 0 });\n}\n\n// Sin ajuste manual aca a proposito: \"data-adjust=crestLocal/crestVisitante\"\n// (ver buildStructure) ya lo resuelve el mecanismo generico\n// (applyElementAdjustRegistry en program/js/main.js, corre para CUALQUIER\n// modulo con entradas kind:'composition' en su registro) -- mismo criterio\n// que \".ov-pen-crest\" en marcadorPenales.js, sin duplicar la logica aca.\n// \"fallbackSrc\" (2026-09-04, pedido explicito del usuario): escudo de un\n// RIVAL HISTORICO sin equipo en el catalogo local (Colombia/Malasia/etc --\n// ver server/argentinaStreamersClient.js), resuelto por la sincro web y\n// guardado en \"partido.teamBCrestUrl\". Un teamId real del catalogo local\n// SIEMPRE tiene prioridad (elegido a mano por el operador o coincidencia\n// real con el catalogo) -- el fallback solo se usa cuando \"teamId\" no\n// resuelve ningun escudo.\nfunction setCrest(imgEl, teamId, fallbackSrc) {\n  if (!imgEl) return;\n  const src = crestFile(teamId) || fallbackSrc || null;\n  if (src) {\n    imgEl.src = src;\n    imgEl.alt = teamName(teamId) || teamId || '';\n    imgEl.style.visibility = 'visible';\n  } else {\n    imgEl.removeAttribute('src');\n    imgEl.alt = '';\n    imgEl.style.visibility = 'hidden';\n  }\n}\n\nfunction buildStructure(el) {\n  let rowsHtml = '';\n  for (let i = 0; i < ROW_COUNT; i++) {\n    const cy = ROW_CENTERS_Y[i];\n    rowsHtml += `\n      <img class=\"ov-historial-crest ov-historial-crest-local\" data-adjust=\"crestLocal\"\n        style=\"position:absolute; left:${CREST_L_CENTER_X - CREST_SIZE / 2}px; top:${cy - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n      <div class=\"ov-historial-gol ov-historial-gol-local\"\n        style=\"position:absolute; left:${GOL_LOCAL_LEFT}px; top:${cy - GOL_HEIGHT / 2}px; width:${GOL_WIDTH}px; height:${GOL_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#ffffff; line-height:1;\"></div>\n      <div class=\"ov-historial-gol ov-historial-gol-visitante\"\n        style=\"position:absolute; left:${GOL_VISITANTE_LEFT}px; top:${cy - GOL_HEIGHT / 2}px; width:${GOL_WIDTH}px; height:${GOL_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#ffffff; line-height:1;\"></div>\n      <div class=\"ov-historial-pen ov-historial-pen-local\"\n        style=\"position:absolute; left:${GOL_LOCAL_LEFT}px; top:${cy + PEN_TOP_OFFSET}px; width:${PEN_WIDTH}px; height:${PEN_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.78); line-height:1; white-space:nowrap;\"></div>\n      <div class=\"ov-historial-pen ov-historial-pen-visitante\"\n        style=\"position:absolute; left:${GOL_VISITANTE_LEFT}px; top:${cy + PEN_TOP_OFFSET}px; width:${PEN_WIDTH}px; height:${PEN_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.78); line-height:1; white-space:nowrap;\"></div>\n      <img class=\"ov-historial-crest ov-historial-crest-visitante\" data-adjust=\"crestVisitante\"\n        style=\"position:absolute; left:${CREST_R_CENTER_X - CREST_SIZE / 2}px; top:${cy - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n      <div class=\"ov-historial-fase\"\n        style=\"position:absolute; left:${FASE_LEFT}px; top:${cy + FASE_TOP_OFFSET}px; width:${FASE_WIDTH}px; height:${FASE_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; letter-spacing:0.5px; color:rgba(255,255,255,0.6); line-height:1; white-space:nowrap; overflow:hidden;\"></div>\n    `;\n  }\n\n  el.innerHTML = `\n    <img class=\"ov-historial-bg\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px; display:none;\" />\n    <div class=\"gfx-overlay\">\n      <div class=\"ov-historial-titulo\"\n        style=\"position:absolute; left:${HEADER_LEFT}px; top:${HEADER_TOP}px; width:${HEADER_WIDTH}px; height:${HEADER_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:1px; color:#ffffff; font-size:26px;\"></div>\n      <img class=\"ov-historial-titulo-crest\" data-adjust=\"tituloCrest\" alt=\"\"\n        style=\"position:absolute; left:${TITULO_CREST_LEFT}px; top:${TITULO_CREST_TOP}px; width:${TITULO_CREST_SIZE}px; height:${TITULO_CREST_SIZE}px; object-fit:contain;\" />\n      ${rowsHtml}\n    </div>\n  `;\n  el._gfxBuilt = true;\n}\n\nexport default function renderHistorial(contentEl, data, justTaken) {\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\n\n  const bgImg = contentEl.querySelector('.ov-historial-bg');\n  if (!bgImg) return; // OUT/TAKE muy rapidos: mismo guard que resultadosParciales.js/cronogramaHoy.js (ver ahi el porque)\n  const imageSrc = resolveImageSrc('historial', null);\n  if (imageSrc) {\n    bgImg.src = imageSrc;\n    bgImg.style.display = 'block';\n  } else {\n    bgImg.removeAttribute('src');\n    bgImg.style.display = 'none';\n  }\n\n  const ta = data.textAdjust;\n  // \"titulo\" (2026-09-02/09-04, pedido explicito del usuario): el TEXTO\n  // sigue siendo manual (cae a \"HISTORIAL\" si el operador no escribio\n  // nada; master-control/js/historial-panel.js lo autocompleta con\n  // \"HISTORIAL - <CATEGORIA>\" al apretar ACTUALIZAR DATOS DE LA WEB). La\n  // POSICI\u00D3N/ESCALA ahora es INDEPENDIENTE por categoria (item 5 del\n  // pedido: \"HISTORIAL - IWC\" es mucho mas corto que \"HISTORIAL -\n  // AMISTOSOS OFICIALES\") -- \"data.tituloByCategoria[tipoHistorial]\" en\n  // vez del unico \"textAdjust.titulo\" de siempre; ver el control dedicado\n  // (mismo componente generico, renderTextAdjustControl) en\n  // historial-panel.js.\n  const tituloAdjust = (data.tituloByCategoria && data.tituloByCategoria[data.tipoHistorial]) || { dx: 0, dy: 0, dSize: 0 };\n  applyPlainTextAdjust(contentEl.querySelector('.ov-historial-titulo'), (data.titulo || '').trim() || 'HISTORIAL', tituloAdjust);\n\n  // ESCUDO T\u00CDTULO (2026-09-04, pedido explicito del usuario, item 7):\n  // siempre Argentina Streamers MASCULINO fijo -- mismo criterio que\n  // goleadores/asistidores/jugadores (program/js/renderers/\n  // performanceTable.js), no depende del Marcador. Solo Argentina\n  // Streamers.\n  const tituloCrestEl = contentEl.querySelector('.ov-historial-titulo-crest');\n  if (tituloCrestEl) {\n    const crestSrc = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID ? crestFile('argentina-streamers') : null;\n    if (crestSrc) {\n      tituloCrestEl.src = crestSrc;\n      tituloCrestEl.style.visibility = 'visible';\n    } else {\n      tituloCrestEl.removeAttribute('src');\n      tituloCrestEl.style.visibility = 'hidden';\n    }\n  }\n\n  const faseAdjust = readTextAdjust(ta, 'fase');\n  // Bloques (2026-09-04, pedido explicito): \"resultadoNormal\"/\n  // \"resultadoConPenales\"/\"penalesFino\" viven en el nivel superior de\n  // \"data\" (no en \"textAdjust\" -- no son un ajuste por columna, son un\n  // ajuste de BLOQUE que se aplica condicionalmente por fila, ver el loop\n  // de abajo). Control dedicado en master-control/js/historial-panel.js.\n  const zero = { dx: 0, dy: 0, dSize: 0 };\n  const resultadoNormal = data.resultadoNormal || zero;\n  const resultadoConPenales = data.resultadoConPenales || zero;\n  const penalesFino = data.penalesFino || zero;\n\n  const partidos = Array.isArray(data.partidos) ? data.partidos : [];\n  const crestsLocal = contentEl.querySelectorAll('.ov-historial-crest-local');\n  const crestsVisitante = contentEl.querySelectorAll('.ov-historial-crest-visitante');\n  const golesLocal = contentEl.querySelectorAll('.ov-historial-gol-local');\n  const golesVisitante = contentEl.querySelectorAll('.ov-historial-gol-visitante');\n  const penalesLocal = contentEl.querySelectorAll('.ov-historial-pen-local');\n  const penalesVisitante = contentEl.querySelectorAll('.ov-historial-pen-visitante');\n  const fases = contentEl.querySelectorAll('.ov-historial-fase');\n\n  for (let i = 0; i < ROW_COUNT; i++) {\n    const partido = partidos[i] || {};\n    setCrest(crestsLocal[i], partido.teamA);\n    setCrest(crestsVisitante[i], partido.teamB, partido.teamBCrestUrl);\n    // Tama\u00F1os CON/SIN penales (2026-09-04, pedido explicito del usuario):\n    // \"SIN penales, mantener EXACTAMENTE el tama\u00F1o actual\" -- la base real\n    // vive en CSS (\".ov-historial-gol\"/\".ov-historial-gol.has-penales\",\n    // ver overlay.css), esta funcion solo prende/apaga la clase. Se borra\n    // \"dataset.baseFontSize\" al tocar la clase para que, si el operador\n    // tiene un \"dSize\" propio guardado (GUARDAR POSICI\u00D3N de la columna\n    // GOL), \"applyPlainTextAdjust\" vuelva a leer el tama\u00F1o base REAL (el\n    // que corresponde ahora, no uno viejo cacheado de antes del cambio de\n    // clase -- ver su implementacion en program/js/text-fit.js).\n    const hasPenales = Boolean(partido.penalLocal || partido.penalVisitante);\n    for (const golEl of [golesLocal[i], golesVisitante[i]]) {\n      if (golEl.classList.contains('has-penales') !== hasPenales) {\n        golEl.classList.toggle('has-penales', hasPenales);\n        delete golEl.dataset.baseFontSize;\n      }\n    }\n    // \"RESULTADO NORMAL\" vs \"RESULTADO CON PENALES\" (2026-09-04, pedido\n    // explicito): geometria COMPLETAMENTE separada segun \"hasPenales\" de\n    // ESTA fila puntual -- una fila sin penales SIEMPRE usa\n    // \"resultadoNormal\" (nunca se mueve si el operador ajusta\n    // \"resultadoConPenales\", y viceversa). Cada gol ademas suma su propia\n    // base fija migrada (GOL_LOCAL_BASE_ADJUST/GOL_VISITANTE_BASE_ADJUST)\n    // para preservar el look actual sin tocarlo.\n    const scoreGroupAdjust = hasPenales ? resultadoConPenales : resultadoNormal;\n    applyPlainTextAdjust(golesLocal[i], partido.golLocal || '', sumAdjust(GOL_LOCAL_BASE_ADJUST, scoreGroupAdjust));\n    applyPlainTextAdjust(golesVisitante[i], partido.golVisitante || '', sumAdjust(GOL_VISITANTE_BASE_ADJUST, scoreGroupAdjust));\n    // Penales (2026-09-04, pedido explicito): SOLO si el partido se\n    // definio por penales de verdad (dato real de la web, nunca inferido\n    // por empate -- ver server/argentinaStreamersSync.js). Vacio = no\n    // dibuja nada, sin \"(0)\" ni placeholder. La segunda linea hereda el\n    // movimiento de \"resultadoConPenales\" (viaja PEGADA al bloque\n    // reglamentario) mas su propio ajuste fino \"penalesFino\" encima\n    // (mueve SOLO la segunda linea, relativa al score) -- en filas sin\n    // penales esto no importa, el texto queda vacio de cualquier forma.\n    const penGroupAdjust = sumAdjust(resultadoConPenales, penalesFino);\n    applyPlainTextAdjust(penalesLocal[i], partido.penalLocal ? `(${partido.penalLocal})` : '', sumAdjust(PEN_LOCAL_BASE_ADJUST, penGroupAdjust));\n    applyPlainTextAdjust(penalesVisitante[i], partido.penalVisitante ? `(${partido.penalVisitante})` : '', sumAdjust(PEN_VISITANTE_BASE_ADJUST, penGroupAdjust));\n    // Fase/instancia (2026-09-04, pedido explicito): dato real de la web\n    // (\"stage\" -- ver server/argentinaStreamersSync.js), vacio si la web\n    // no la publico para ese partido. Nunca inventado por posicion.\n    applyPlainTextAdjust(fases[i], partido.fase || '', faseAdjust);\n  }\n}\n","http://localhost:4430/program/js/renderers/zocaloCompuesto.js","// Z\u00F3calo Compuesto unificado (2026-08-16, pedido expl\u00EDcito del usuario:\r\n// \"no quiero duplicar dos m\u00F3dulos casi id\u00E9nticos\"). Reemplaza en la\r\n// navegaci\u00F3n a zocaloFinal (Logo GLA) / zocaloFinalDiv (Equipos), que\r\n// quedan registrados sin cambios (ver shared/modules.js) solo para no\r\n// perder datos/presets ya persistidos -- este renderer es el \u00FAnico que\r\n// se usa desde ahora.\r\n//\r\n// \"tipo\" ('equipos' | 'logo') decide qu\u00E9 asset .mov reproducir y si se\r\n// pintan escudos (en vivo, del Marcador) o el logo GLA fijo -- el resto\r\n// (texto1/texto2/sponsor) es UNA sola copia de datos compartida, misma\r\n// geometr\u00EDa exacta que los dos m\u00F3dulos originales (reusa sus clases CSS\r\n// \".ov-zfd-*\"/\".ov-zf-*\" tal cual, ver program/css/overlay.css).\r\n//\r\n// Transici\u00F3n segura al cambiar TIPO estando al aire (pedido expl\u00EDcito):\r\n// createAlphaVideo crea un <video>+<canvas> atado a UN asset fijo, as\u00ED\r\n// que cambiar de tipo requiere destruir la instancia vieja y crear una\r\n// nueva con el otro .mov -- se hace de forma SINCR\u00D3NICA (destroy() antes\r\n// de crear la nueva) para que nunca queden dos videos/canvas superpuestos\r\n// en el DOM, y se relanza playFromStart() aunque no sea un TAKE nuevo\r\n// (justTaken=false) para que el cambio de tipo se vea como una entrada\r\n// real, no como un frame congelado en negro.\r\nimport { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { GLA_SEGOE_BOLD_FAMILY, withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = {\r\n  equipos: glaAssetPath('zocaloCompuesto', 'equipos'),\r\n  logo: glaAssetPath('zocaloCompuesto', 'logo'),\r\n};\r\nconst LOGO_SRC = glaAssetPath('zocaloCompuesto', 'logoImagen');\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\nconst TEXTO2_LETTER_SPACING = 0.5;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el, tipo) {\r\n  const logoSrc = resolveImageSrc('zocaloCompuesto', LOGO_SRC);\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-local\" data-adjust=\"localCrest\" alt=\"\" />\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-visitante\" data-adjust=\"awayCrest\" alt=\"\" />\r\n      ${logoSrc ? `<img class=\"ov-zf-logo\" data-adjust=\"logo\" src=\"${logoSrc}\" alt=\"logo\" />` : ''}\r\n      <div class=\"ov-zfd-texto ov-zfd-texto1\"></div>\r\n      <div class=\"ov-zfd-texto ov-zfd-texto2\"></div>\r\n      <!-- Los 2 <img> del crossfade interno (ver updateSponsorImage mas\r\n           abajo -- SIEMPRE hay uno \"active\" y como maximo uno \"exit\" mas\r\n           viejo saliendo) comparten el MISMO \"data-adjust\" a proposito\r\n           (2026-09-24, pedido explicito: \"un unico ajuste para TODOS los\r\n           sponsors del rotativo\") -- applyElementAdjustRegistry (program/js/\r\n           main.js) ya aplica un mismo ajuste a TODOS los nodos que\r\n           coincidan, asi que cualquiera de los dos que le toque mostrar un\r\n           sponsor sale en la misma posicion/escala. Las clases\r\n           \".ov-zfd-sponsor-1\"/\"-2\" siguen siendo distintas -- esas las usa\r\n           SOLO la logica de rotacion (querySelector mas abajo) para saber\r\n           cual esta activo/inactivo, no tienen relacion con el ajuste. -->\r\n      <div class=\"ov-zfd-sponsor-box\">\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-1\" data-adjust=\"sponsors\" alt=\"\" />\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-2\" data-adjust=\"sponsors\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el.dataset.tipo = tipo;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloCompuesto', VIDEO_SRC[tipo], undefined, tipo);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloCompuesto(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const tipo = data.tipo === 'logo' ? 'logo' : 'equipos';\r\n  const tipoChanged = contentEl.dataset.tipo !== undefined && contentEl.dataset.tipo !== tipo;\r\n\r\n  if (!contentEl._gfxBuilt || tipoChanged) {\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    buildStructure(contentEl, tipo);\r\n    // Fuerza que el texto se pinte de una sin fundido (el \"oldText\" de la\r\n    // variante anterior no aplica a esta estructura nueva).\r\n    contentEl._prevTexto1 = undefined;\r\n    contentEl._prevTexto2 = undefined;\r\n  }\r\n\r\n  if (justTaken || tipoChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  // Sector izquierdo: escudos en vivo (tipo EQUIPOS) o logo fijo (tipo LOGO).\r\n  const crestLocalEl = contentEl.querySelector('.ov-zfd-crest-local');\r\n  const crestVisitanteEl = contentEl.querySelector('.ov-zfd-crest-visitante');\r\n  const logoEl = contentEl.querySelector('.ov-zf-logo');\r\n  if (tipo === 'equipos') {\r\n    const fuente = data.escudosFuente || 'MARCADOR';\r\n    const teamA = fuente === 'PERSONALIZADO' ? (data.customTeamA || '') : (sb.teamA || '');\r\n    const teamB = fuente === 'PERSONALIZADO' ? (data.customTeamB || '') : (sb.teamB || '');\r\n    setCrest(crestLocalEl, teamA);\r\n    setCrest(crestVisitanteEl, teamB);\r\n    crestLocalEl.style.display = '';\r\n    crestVisitanteEl.style.display = '';\r\n    if (logoEl) logoEl.style.display = 'none';\r\n  } else {\r\n    crestLocalEl.style.display = 'none';\r\n    crestVisitanteEl.style.display = 'none';\r\n    if (logoEl) logoEl.style.display = '';\r\n  }\r\n\r\n  const texto1El = contentEl.querySelector('.ov-zfd-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zfd-texto2');\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n  const oldT1 = contentEl._prevTexto1;\r\n  const oldT2 = contentEl._prevTexto2;\r\n  // \"family\" (2026-09-24, pedido explicito: \"Segoe UI Bold\", SOLO GLA) --\r\n  // mismo criterio que longSimple.js/shortSimple.js/shortDouble.js.\r\n  const family = getActiveThemeId() === DEFAULT_THEME_ID ? GLA_SEGOE_BOLD_FAMILY : undefined;\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, oldT1, withGlaSegoeRegular({\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800, family,\r\n  }), readTextAdjust(data.textAdjust, 'texto1'), !justTaken && !tipoChanged);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, oldT2, withGlaSegoeRegular({\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH,\r\n    weight: 400, letterSpacing: TEXTO2_LETTER_SPACING, family,\r\n  }), readTextAdjust(data.textAdjust, 'texto2'), !justTaken && !tipoChanged);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Rotaci\u00F3n de sponsors en el recuadro derecho (misma l\u00F3gica que\r\n  // zocaloFinal.js/zocaloFinalDiv.js, sin cambios).\r\n  const img1 = contentEl.querySelector('.ov-zfd-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zfd-sponsor-2');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  // \"classList\" en vez de pisar \"className\" entero (2026-09-24, bug real\r\n  // reproducido en GLA con Hot Pool activo -- ver comentario de\r\n  // HOT_MODULE_IDS en program/js/hot-pool.js): \"img1\"/\"img2\" se ubican por\r\n  // sus clases IDENTIFICADORAS propias (\".ov-zfd-sponsor-1\"/\"-2\", ver\r\n  // \"querySelector\" mas abajo) -- pisar \"className\" completo con solo\r\n  // \"ov-zfd-sponsor-img\" (rama sin sponsors) las borraba para siempre, asi\r\n  // que el PROXIMO render (ya con el modulo WARM, mismo contentEl) no\r\n  // volvia a encontrar esos nodos -- \"img1\"/\"img2\" quedaban null y\r\n  // \"img1.src = ...\" tiraba \"Cannot set properties of null\". Con un\r\n  // \"className\" fijo (nunca destroy) esto pasaba desapercibido antes de\r\n  // Hot Pool porque CADA Take reconstruia el DOM de cero (clases frescas);\r\n  // con el modulo WARM persistente el bug se vuelve real. \"classList.add/\r\n  // remove\" solo toca los modificadores \"active\"/\"exit\", nunca las clases\r\n  // base -- mismo resultado visual/CSS, ya no se pierde la identidad del\r\n  // nodo entre renders.\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      img1.classList.remove('active', 'exit');\r\n      img2.classList.remove('active', 'exit');\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      img1.classList.remove('exit');\r\n      img1.classList.add('active');\r\n      img2.classList.remove('active', 'exit');\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    activeImg.classList.remove('active');\r\n    activeImg.classList.add('exit');\r\n    inactiveImg.classList.remove('exit');\r\n    inactiveImg.classList.add('active');\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.classList.contains('exit')) {\r\n        prevImg.classList.remove('exit');\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || tipoChanged || contentEl._lastSponsorsSignature !== listSignature) {\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken || tipoChanged);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/zocaloCompuestoEquipos.js","// Z\u00F3calo Compuesto (Argentina Streamers) unificado (2026-09-10, pedido\n// explicito del usuario: \"es todo lo mismo, solo cambia el asset... un\n// solo m\u00F3dulo, con la opci\u00F3n de men\u00FA desplegable CON LOGO LOCALSTRIKE |\n// CON EQUIPOS\"). Reemplaza en la navegaci\u00F3n a \"zocaloCompuestoLogo\", que\n// queda registrado sin cambios (ver shared/modules.js) solo para no perder\n// datos/presets ya persistidos -- este renderer es el \u00FAnico que se usa\n// desde ahora para ambos tipos.\n//\n// \"tipo\" ('equipos' | 'logo') decide qu\u00E9 asset .mov reproducir y si se\n// pintan escudos en vivo (con l\u00EDnea separadora, ya horneada en ESE asset)\n// o el logo LocalStrike fijo (sin l\u00EDnea, horneada distinto en el otro\n// asset) -- el resto (texto1/texto2/subColor/sponsor) es UNA sola copia de\n// datos compartida. Transici\u00F3n segura al cambiar TIPO estando al aire:\n// mismo patr\u00F3n que program/js/renderers/zocaloCompuesto.js (el m\u00F3dulo de\n// GLA, sin relaci\u00F3n con este -- assets completamente distintos): destruye\n// el video viejo y crea uno nuevo de forma SINCR\u00D3NICA antes de seguir, y\n// relanza playFromStart() aunque no sea un TAKE nuevo para que el cambio\n// de tipo se vea como una entrada real.\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\nimport { crestFile, teamName } from '../../../shared/teams.js';\nimport { sponsorFile } from '../../../shared/sponsors.js';\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\nimport { getActiveThemeId } from '../theme-client.js';\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\n\nconst VIDEO_SRC = {\n  equipos: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-equipos-alpha.mp4',\n  logo: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4',\n};\nconst LOGO_SRC = '/assets/themes/argentina-streamers/zocalos/logo-localstrike.png';\n\nconst TEXTO1_MAX_FONT = 50;\nconst TEXTO1_MIN_FONT = 22;\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\n\nconst TEXTO2_MAX_FONT = 30;\nconst TEXTO2_MIN_FONT = 16;\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\n\nfunction setCrest(imgEl, teamId, adjustObj) {\n  if (!imgEl) return;\n  const src = crestFile(teamId);\n  if (src) {\n    imgEl.src = src;\n    imgEl.alt = teamName(teamId) || teamId;\n    imgEl.style.visibility = 'visible';\n    imgEl.style.display = 'block';\n    imgEl.style.opacity = '1';\n    imgEl.style.zIndex = '10';\n\n    const dx = adjustObj?.offsetX || 0;\n    const dy = adjustObj?.offsetY || 0;\n    const sc = adjustObj?.scale !== undefined ? adjustObj.scale : 1;\n    imgEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\n  } else {\n    imgEl.removeAttribute('src');\n    imgEl.alt = '';\n    imgEl.style.visibility = 'hidden';\n    imgEl.style.display = 'none';\n  }\n}\n\n// \"videoModuleId\" (2026-09-14, causa raiz REAL encontrada y corregida --\n// pedido explicito del usuario: \"no importa si elijo CON EQUIPOS o CON\n// LOGO, el asset gr\u00E1fico no aparece\"). \"mountThemedAlphaVideo\"/\n// \"resolveImageSrc\" (ver program/js/theme-assets.js) resuelven un 5to\n// parametro \"variant\" como \"asset.variants?.[variant]\" -- pero el manifest\n// real de Argentina Streamers (shared/themes.js) NUNCA tuvo un objeto\n// \"variants\" para este modulo: tiene DOS ENTRADAS PLANAS separadas,\n// \"zocaloCompuestoEquipos: {video:...}\" y \"zocaloCompuestoLogo:\n// {video:..., image:...}\" (asi vivian ANTES de unificar el panel en un\n// solo modulo con selector \"tipo\", ver historial). Al unificar el\n// renderer se paso \"tipo\" como variant (`mountThemedAlphaVideo(..., 'zocaloCompuestoEquipos', ..., tipo)`)\n// asumiendo una estructura \"variants\" que jamas se creo en el manifest --\n// \"asset.variants\" siempre daba \"undefined\", asi que SIEMPRE resolvia a\n// null sin importar el tipo elegido (nunca se vio ningun asset, ni\n// EQUIPOS ni LOGO). Fix: en vez de inventar una estructura \"variants\"\n// nueva en el manifest (mas riesgo, toca datos ya persistidos), se\n// consulta CADA \"tipo\" por su PROPIO moduleId real ya existente en el\n// manifest -- sin pasar \"variant\" nunca.\nfunction resolveVideoModuleId(tipo) {\n  return tipo === 'logo' ? 'zocaloCompuestoLogo' : 'zocaloCompuestoEquipos';\n}\n\nfunction buildStructure(el, tipo) {\n  // Mismo criterio: el logo real vive en el manifest bajo la entrada\n  // \"zocaloCompuestoLogo\" (unica que declara \"image\"), no bajo\n  // \"zocaloCompuestoEquipos\" (que nunca tuvo \"image\" propio).\n  const logoSrc = resolveImageSrc('zocaloCompuestoLogo', LOGO_SRC) || LOGO_SRC;\n  el.innerHTML = `\n    <div class=\"av-target\"></div>\n    <div class=\"gfx-overlay\">\n      <img class=\"ov-zfd-crest ov-zfd-crest-local\" alt=\"local crest\" />\n      <img class=\"ov-zfd-crest ov-zfd-crest-visitante\" alt=\"visitante crest\" />\n      <img class=\"ov-zf-logo\" src=\"${logoSrc}\" alt=\"logo\" style=\"position: absolute; left: 100px; top: 951.5px; width: 110px; height: 110px; object-fit: contain; z-index: 10;\" />\n      <div class=\"ov-zfd-texto ov-zfd-texto1\" style=\"color: #ffffff !important;\"></div>\n      <div class=\"ov-zfd-texto ov-zfd-texto2\"></div>\n      <div class=\"ov-zfd-sponsor-box\">\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-1\" alt=\"\" />\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-2\" alt=\"\" />\n      </div>\n    </div>\n  `;\n  el.dataset.tipo = tipo;\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), resolveVideoModuleId(tipo), VIDEO_SRC[tipo]);\n  el._gfxBuilt = true;\n}\n\nexport default function renderZocaloCompuestoEquipos(contentEl, data, justTaken, onOneShotEnded, allData) {\n  const tipo = data.tipo === 'logo' ? 'logo' : 'equipos';\n  const tipoChanged = contentEl.dataset.tipo !== undefined && contentEl.dataset.tipo !== tipo;\n\n  if (!contentEl._gfxBuilt || tipoChanged) {\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\n    buildStructure(contentEl, tipo);\n    // Fuerza que el texto se pinte de una sin fundido (el \"oldText\" de la\n    // variante anterior no aplica a esta estructura nueva).\n    contentEl._prevTexto1 = undefined;\n    contentEl._prevTexto2 = undefined;\n  }\n\n  if (justTaken || tipoChanged) {\n    contentEl._alphaVideo?.playFromStart();\n  }\n\n  const sb = (allData && allData.scoreboard) || {};\n  const teamA = sb.teamA || 'argentina-streamers';\n  const teamB = sb.teamB || 'oxen';\n\n  const crestLocalEl = contentEl.querySelector('.ov-zfd-crest-local');\n  const crestVisitanteEl = contentEl.querySelector('.ov-zfd-crest-visitante');\n  const logoEl = contentEl.querySelector('.ov-zf-logo');\n\n  if (tipo === 'equipos') {\n    const localAdjust = data.crestByTeam?.local?.[teamA] || {};\n    const awayAdjust = data.crestByTeam?.away?.[teamB] || {};\n    setCrest(crestLocalEl, teamA, {\n      offsetX: localAdjust.localCrestOffsetX || 0,\n      offsetY: localAdjust.localCrestOffsetY || 0,\n      scale: localAdjust.localCrestScale,\n    });\n    setCrest(crestVisitanteEl, teamB, {\n      offsetX: awayAdjust.awayCrestOffsetX || 0,\n      offsetY: awayAdjust.awayCrestOffsetY || 0,\n      scale: awayAdjust.awayCrestScale,\n    });\n    if (logoEl) logoEl.style.display = 'none';\n  } else {\n    crestLocalEl.style.display = 'none';\n    crestVisitanteEl.style.display = 'none';\n    if (logoEl) {\n      logoEl.style.display = 'block';\n      const dx = data.logoOffsetX || 0;\n      const dy = data.logoOffsetY || 0;\n      const sc = data.logoScale !== undefined ? data.logoScale : 1;\n      logoEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\n    }\n  }\n\n  const texto1El = contentEl.querySelector('.ov-zfd-texto1');\n  const texto2El = contentEl.querySelector('.ov-zfd-texto2');\n  texto1El.style.color = '#ffffff';\n  // \"subColor\" (2026-09-02, pedido explicito del usuario): MAIN siempre\n  // blanco fijo (arriba); SUBTEXTO configurable NEGRO/BLANCO desde Master\n  // Control, sin depender de ninguna clase/color heredado de GLA.\n  // BLOQUE 1 (2026-09-09, pedido explicito): en Argentina Streamers el\n  // SUBTEXTO pasa a AZUL DE REFERENCIA fijo (\"--as-navy\", ver theme.css),\n  // sin depender de \"subColor\" -- GLA conserva el toggle negro/blanco\n  // exactamente igual que antes (modulo distinto, ver zocaloCompuesto.js).\n  texto2El.style.color = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID\n    ? 'var(--as-navy)'\n    : (data.subColor === 'blanco' ? '#ffffff' : '#000000');\n\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\n\n  updateFittedTextWithTransition(texto1El, newT1, contentEl._prevTexto1, {\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken && !tipoChanged);\n\n  updateFittedTextWithTransition(texto2El, newT2, contentEl._prevTexto2, {\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH, weight: 700,\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken && !tipoChanged);\n\n  contentEl._prevTexto1 = newT1;\n  contentEl._prevTexto2 = newT2;\n\n  // Posicion del SLOT de sponsor (unica zona visual, no por marca -- pedido\n  // explicito del usuario). La rotacion en si va mas abajo.\n  const sponsorBox = contentEl.querySelector('.ov-zfd-sponsor-box');\n  const sponsorsList = data.sponsorsRotation || [];\n  if (sponsorBox) {\n    sponsorBox.style.display = sponsorsList.length ? 'block' : 'none';\n    const sx = data.sponsorOffsetX || 0;\n    const sy = data.sponsorOffsetY || 0;\n    const sc = data.sponsorScale !== undefined ? data.sponsorScale : 1;\n    sponsorBox.style.transform = `translate(${sx}px, ${sy}px) scale(${sc})`;\n  }\n\n  // Rotaci\u00F3n de sponsors (2026-09-02, pedido explicito del usuario: nada de\n  // dropdown unico -- misma logica ya usada por zocaloCompuesto.js, sin\n  // reinventar: dos <img> que hacen crossfade cada 10s, un sponsor visible\n  // a la vez).\n  const img1 = contentEl.querySelector('.ov-zfd-sponsor-1');\n  const img2 = contentEl.querySelector('.ov-zfd-sponsor-2');\n  const listSignature = JSON.stringify(sponsorsList);\n\n  // \"setSponsorState\" (2026-09-05, correccion de raiz del freeze reportado):\n  // nunca reemplazar el className entero (borraba la clase identificadora\n  // \".ov-zfd-sponsor-1\"/\"-2\", provocando querySelector->null->TypeError en\n  // el siguiente render y la rotacion muerta/logo pegado). Solo classList.\n  function setSponsorState(img, state) {\n    img.classList.remove('active', 'exit');\n    if (state) img.classList.add(state);\n  }\n\n  const updateSponsorImage = (isFirstShow = false) => {\n    if (sponsorsList.length === 0) {\n      setSponsorState(img1, null);\n      setSponsorState(img2, null);\n      img1.removeAttribute('src');\n      img2.removeAttribute('src');\n      return;\n    }\n\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\n    const file = sponsorFile('zocalo', currentName);\n\n    if (isFirstShow || sponsorsList.length === 1) {\n      img1.src = file || '';\n      setSponsorState(img1, 'active');\n      setSponsorState(img2, null);\n      img2.removeAttribute('src');\n      contentEl._activeImgIdx = 1;\n      return;\n    }\n\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\n\n    inactiveImg.src = file || '';\n    setSponsorState(activeImg, 'exit');\n    setSponsorState(inactiveImg, 'active');\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\n\n    const prevImg = activeImg;\n    setTimeout(() => {\n      if (prevImg.classList.contains('exit')) {\n        setSponsorState(prevImg, null);\n        prevImg.removeAttribute('src');\n      }\n    }, 600);\n  };\n\n  if (justTaken || tipoChanged || contentEl._lastSponsorsSignature !== listSignature) {\n    if (contentEl._sponsorRotationInterval) {\n      clearInterval(contentEl._sponsorRotationInterval);\n      contentEl._sponsorRotationInterval = null;\n    }\n\n    contentEl._currentSponsorIndex = 0;\n    contentEl._lastSponsorsSignature = listSignature;\n\n    updateSponsorImage(justTaken || tipoChanged);\n\n    if (sponsorsList.length > 1) {\n      contentEl._sponsorRotationInterval = setInterval(() => {\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\n        updateSponsorImage(false);\n      }, 10000);\n    }\n  }\n}\n","http://localhost:4430/program/js/renderers/sitioWebPromoL.js","import { resolveImageSrc } from '../theme-assets.js';\n\n// \"Sitio Web Promo L\" (2026-09-02, pedido explicito del usuario): placa\n// full-bleed estatica, sin texto dinamico -- el PNG real (ANUNCIO_AS) ya\n// trae su contenido horneado (captura del sitio + boton \"INGRES\u00C1\"). No\n// hay zonas evidentemente destinadas a contenido dinamico en el asset\n// (confirmado visualmente: es una composicion fija de foto+mockup de\n// telefono+boton, sin recuadros vacios ni placeholders) -- primera\n// version es solo asset + \"COMPOSICI\u00D3N COMPLETA\", tal como se pidio.\n//\n// \"asset\" (2026-09-14, RESTAURADO -- ver shared/modules.js para la causa\n// raiz del desplegable perdido): selector ARGENTINA STREAMERS | PUNCH,\n// resuelto via \"variant\" contra shared/themes.js. Se reconstruye el <img>\n// cada vez que cambia \"data.asset\" (antes esta funcion ni siquiera recibia\n// \"data\" -- solo existia una imagen fija, nunca reaccionaba a nada).\nfunction buildStructure(el, asset) {\n  const imgSrc = resolveImageSrc('sitioWebPromoL', undefined, asset);\n  el.innerHTML = `\n    <div class=\"gfx-overlay\">\n      ${imgSrc ? `<img class=\"ov-promo-l-bg\" src=\"${imgSrc}\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px;\" />` : ''}\n    </div>\n  `;\n  el.dataset.asset = asset;\n  el._gfxBuilt = true;\n}\n\nexport default function renderSitioWebPromoL(contentEl, data) {\n  const asset = data?.asset === 'punch' ? 'punch' : 'argentina-streamers';\n  if (!contentEl._gfxBuilt || contentEl.dataset.asset !== asset) {\n    buildStructure(contentEl, asset);\n  }\n}\n","http://localhost:4430/program/js/renderers/zocaloVs.js","// Z\u00D3CALO VS (2026-10-09, pedido explicito del usuario, SOLO Argentina\r\n// Streamers). Dos variantes de asset (shared/themes.js \"zocaloVs.variants\"):\r\n//   solo  -> [ESCUDO] NOMBRE LOCAL  VS  NOMBRE VISITANTE [ESCUDO]\r\n//   goles -> [ESCUDO] NOMBRE LOCAL GOL  VS  GOL NOMBRE VISITANTE [ESCUDO]\r\n// Equipos, escudos y goles se leen SIEMPRE en vivo del Marcador principal\r\n// (\"allData.scoreboard\", 5to argumento -- modulo \"live\", mismo patron que\r\n// marcadorPenales/vs): no hay estado propio de equipo ni de goles. El nombre\r\n// es el NOMBRE COMPLETO del catalogo de EQUIPOS (no la abreviatura) salvo\r\n// que el operador lo pase a MANUAL (shared/broadcast-names.js).\r\n//\r\n// Geometria medida sobre el frame asentado de los .mov originales (alfa\r\n// real, 1920x1080, ver overlay.css \"#mod-zocaloVs\"): barra x335-1575,\r\n// y971-1034 en ambas variantes; pastilla verde SOLO x905-999, GOLES\r\n// x825-1082; \"VS\" horneado x929-974, y993-1017 (no es texto dinamico).\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { applyFittedText, readTextAdjust } from '../text-fit.js';\r\n\r\n// Ancho util de cada caja (ancho CSS menos aire contra los bordes).\r\nconst NAME_FIT = {\r\n  solo: { maxFont: 34, minFont: 16, maxWidth: 461 - 8, weight: 800 },\r\n  goles: { maxFont: 34, minFont: 16, maxWidth: 381 - 8, weight: 800 },\r\n};\r\nconst GOL_FIT = { maxFont: 46, minFont: 24, maxWidth: 72 - 8, weight: 800 };\r\n\r\nfunction normalizeVariante(value) {\r\n  return value === 'goles' ? 'goles' : 'solo';\r\n}\r\n\r\n// \"data-adjust\" con el id de la entrada de la variante (shared/\r\n// adjust-registry.js) -- asi applyElementAdjustRegistry solo encuentra los\r\n// escudos de la variante que esta construida.\r\nfunction buildStructure(el, variante) {\r\n  const goles = variante === 'goles'\r\n    ? `<div class=\"ov-zvs-gol ov-zvs-gol-local\"></div>\r\n       <div class=\"ov-zvs-gol ov-zvs-gol-visitante\"></div>`\r\n    : '';\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay ov-zvs ov-zvs--${variante}\">\r\n      <img class=\"ov-zvs-crest ov-zvs-crest-local\" data-adjust=\"${variante}LocalCrest\" alt=\"\" />\r\n      <div class=\"ov-zvs-name ov-zvs-name-local\"></div>\r\n      ${goles}\r\n      <div class=\"ov-zvs-name ov-zvs-name-visitante\"></div>\r\n      <img class=\"ov-zvs-crest ov-zvs-crest-visitante\" data-adjust=\"${variante}AwayCrest\" alt=\"\" />\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    if (imgEl.getAttribute('src') !== src) imgEl.src = src;\r\n    imgEl.alt = teamName(teamId) || teamId;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nexport default function renderZocaloVs(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const variante = normalizeVariante(data.variante);\r\n  // Mismo criterio que tarjeta.js: el primer build (incluido el pre-montaje\r\n  // en frio) no tiene \"dataset.variante\" previo y nunca se autoreproduce.\r\n  const varianteChanged = contentEl.dataset.variante !== undefined && contentEl.dataset.variante !== variante;\r\n  if (!contentEl._gfxBuilt || varianteChanged) {\r\n    contentEl.dataset.variante = variante;\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    buildStructure(contentEl, variante);\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.av-target'), 'zocaloVs', null, undefined, variante);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n  if (justTaken || varianteChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const ta = data.textAdjust;\r\n  setCrest(contentEl.querySelector('.ov-zvs-crest-local'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-zvs-crest-visitante'), sb.teamB);\r\n\r\n  // AUTOM\u00C1TICO = nombre completo del catalogo (sin el mapping de nombres\r\n  // cortos de broadcast: \"teamId: null\" a proposito). MANUAL con texto gana.\r\n  const nombreLocal = resolveVsDisplayName({ mode: data.nombreLocalMode, manualText: data.nombreLocalManual, teamId: null, fallbackName: teamName(sb.teamA) });\r\n  const nombreVisitante = resolveVsDisplayName({ mode: data.nombreVisitanteMode, manualText: data.nombreVisitanteManual, teamId: null, fallbackName: teamName(sb.teamB) });\r\n  applyFittedText(contentEl.querySelector('.ov-zvs-name-local'), nombreLocal, NAME_FIT[variante], readTextAdjust(ta, `${variante}NombreLocal`));\r\n  applyFittedText(contentEl.querySelector('.ov-zvs-name-visitante'), nombreVisitante, NAME_FIT[variante], readTextAdjust(ta, `${variante}NombreVisitante`));\r\n\r\n  if (variante === 'goles') {\r\n    applyFittedText(contentEl.querySelector('.ov-zvs-gol-local'), String(sb.scoreA ?? '0'), GOL_FIT, readTextAdjust(ta, 'golesGolLocal'));\r\n    applyFittedText(contentEl.querySelector('.ov-zvs-gol-visitante'), String(sb.scoreB ?? '0'), GOL_FIT, readTextAdjust(ta, 'golesGolVisitante'));\r\n  }\r\n}\r\n","http://localhost:4430/program/js/renderers/zocaloCompuestoLogo.js","import { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\n\r\nconst VIDEO_SRC = '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4';\r\nconst LOGO_SRC = '/assets/themes/argentina-streamers/zocalos/logo-localstrike.png';\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\n\r\nfunction buildStructure(el) {\r\n  const logoSrc = resolveImageSrc('zocaloCompuestoLogo', LOGO_SRC) || LOGO_SRC;\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-zf-logo\" src=\"${logoSrc}\" alt=\"logo\" style=\"position: absolute; left: 100px; top: 951.5px; width: 110px; height: 110px; object-fit: contain; z-index: 10; visibility: visible; display: block;\" />\r\n      <div class=\"ov-zf-texto ov-zf-texto1\" style=\"color: #ffffff !important;\"></div>\r\n      <div class=\"ov-zf-texto ov-zf-texto2\"></div>\r\n      <div class=\"ov-zf-sponsor-box\">\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-1\" alt=\"\" />\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-2\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloCompuestoLogo', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloCompuestoLogo(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const logoEl = contentEl.querySelector('.ov-zf-logo');\r\n  if (logoEl) {\r\n    const dx = data.logoOffsetX || 0;\r\n    const dy = data.logoOffsetY || 0;\r\n    const sc = data.logoScale !== undefined ? data.logoScale : 1;\r\n    logoEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const texto1El = contentEl.querySelector('.ov-zf-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zf-texto2');\r\n  texto1El.style.color = '#ffffff';\r\n  // \"subColor\" (2026-09-02, pedido explicito del usuario): MAIN siempre\r\n  // blanco fijo (arriba); SUBTEXTO configurable NEGRO/BLANCO desde Master\r\n  // Control, sin depender de ninguna clase/color heredado de GLA.\r\n  // BLOQUE 1 (2026-09-09, pedido explicito): en Argentina Streamers el\r\n  // SUBTEXTO pasa a AZUL DE REFERENCIA fijo (\"--as-navy\", ver theme.css),\r\n  // sin depender de \"subColor\" -- GLA conserva el toggle negro/blanco\r\n  // exactamente igual que antes.\r\n  texto2El.style.color = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID\r\n    ? 'var(--as-navy)'\r\n    : (data.subColor === 'blanco' ? '#ffffff' : '#000000');\r\n\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, contentEl._prevTexto1, {\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, contentEl._prevTexto2, {\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH, weight: 700,\r\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Posicion del SLOT de sponsor (unica zona visual, no por marca -- pedido\r\n  // explicito del usuario). La rotacion en si va mas abajo.\r\n  const sponsorBox = contentEl.querySelector('.ov-zf-sponsor-box');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  if (sponsorBox) {\r\n    sponsorBox.style.display = sponsorsList.length ? 'block' : 'none';\r\n    const sx = data.sponsorOffsetX || 0;\r\n    const sy = data.sponsorOffsetY || 0;\r\n    const sc = data.sponsorScale !== undefined ? data.sponsorScale : 1;\r\n    sponsorBox.style.transform = `translate(${sx}px, ${sy}px) scale(${sc})`;\r\n  }\r\n\r\n  // Rotaci\u00F3n de sponsors (2026-09-02, pedido explicito del usuario: nada de\r\n  // dropdown unico -- misma logica ya usada por zocaloCompuesto.js, sin\r\n  // reinventar: dos <img> que hacen crossfade cada 10s, un sponsor visible\r\n  // a la vez).\r\n  const img1 = contentEl.querySelector('.ov-zf-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zf-sponsor-2');\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  // Mismo fix de raiz que zocaloCompuestoEquipos.js (2026-09-05): nunca\r\n  // reemplazar el className entero (borraba la clase identificadora\r\n  // \".ov-zf-sponsor-1\"/\"-2\", provocando querySelector->null->TypeError en el\r\n  // siguiente render y la rotacion muerta/logo pegado). Solo classList.\r\n  function setSponsorState(img, state) {\r\n    img.classList.remove('active', 'exit');\r\n    if (state) img.classList.add(state);\r\n  }\r\n\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      setSponsorState(img1, null);\r\n      setSponsorState(img2, null);\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      setSponsorState(img1, 'active');\r\n      setSponsorState(img2, null);\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    setSponsorState(activeImg, 'exit');\r\n    setSponsorState(inactiveImg, 'active');\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.classList.contains('exit')) {\r\n        setSponsorState(prevImg, null);\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || contentEl._lastSponsorsSignature !== listSignature) {\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://localhost:4430/program/js/text-fit.js","// Ajuste de tama\u00F1o de fuente responsivo + correccion de centrado vertical,\r\n// mismo criterio ya validado en Tarjeta/Cambios/Marcador de Penales\r\n// (ver program/js/renderers/tarjeta.js): estimacion proporcional rapida +\r\n// ajuste fino con canvas.measureText, para que textos cortos se vean\r\n// grandes y textos largos se achiquen solo lo necesario para entrar en el\r\n// ancho disponible, mas una correccion de centrado vertical que compensa\r\n// que \"align-items:center\" centra la caja de linea de la fuente (no la\r\n// tinta real). Se centraliza aca en vez de reescribir esta logica en cada\r\n// renderer nuevo \u2014 no reemplaza la ya existente en tarjeta.js/cambios.js\r\n// (que sigue funcionando igual, sin tocar).\r\n\r\nimport { getProgramFontFamily } from './program-fonts.js';\r\n\r\n// \"TODO texto en Program debe ir en MAY\u00DASCULA\" (2026-08-16, pedido\r\n// explicito del usuario): transformacion en la CAPA DE RENDER unicamente\r\n// -- nunca toca lo que Master Control guarda/envia (\"Gran Final\" se sigue\r\n// guardando y editando tal cual), solo lo que termina pintado en pantalla.\r\n// Centralizada aca porque \"applyFittedText\"/\"applyPlainTextAdjust\"/\r\n// \"applyFittedLines\" son el punto de paso casi universal de texto visible\r\n// del proyecto -- un solo lugar en vez de tocar cada renderer. Solo\r\n// mayuscula strings (numeros/otros tipos pasan sin cambios); las pocas\r\n// piezas con logica de texto duplicada localmente (no pasan por estas\r\n// funciones, ver grep de \"textContent =\" en program/js/renderers) usan\r\n// este mismo helper importado explicitamente.\r\nexport function toBroadcastUpper(text) {\r\n  return typeof text === 'string' ? text.toUpperCase() : text;\r\n}\r\n\r\nlet measureCtx = null;\r\nfunction getCtx() {\r\n  if (!measureCtx) measureCtx = document.createElement('canvas').getContext('2d');\r\n  return measureCtx;\r\n}\r\n\r\n// \"family\" (2026-09-24, pedido explicito del usuario: \"Segoe UI Bold\" en\r\n// 4 modulos puntuales, NO en el resto de GLA): override OPCIONAL de la\r\n// familia a usar para ESTA medicion puntual -- sin pasarlo (la inmensa\r\n// mayoria de los ~25 call sites del proyecto), sigue resolviendo\r\n// exactamente igual que siempre via getProgramFontFamily() (la fuente del\r\n// theme activo completo), cero cambio de comportamiento. Los 4 renderers\r\n// afectados (longSimple/shortSimple/shortDouble/zocaloCompuesto) pasan\r\n// GLA_SEGOE_BOLD_FAMILY (program/js/program-fonts.js) aca para que lo que\r\n// se MIDE coincida con lo que el CSS de esos modulos pinta de verdad (ver\r\n// override de \"--font-display\" en program/css/theme.css) -- si no\r\n// coincidieran, el auto-ajuste de tama\u00F1o calcularia anchos con la fuente\r\n// equivocada.\r\nfunction setFont(fontPx, weight, letterSpacing, family) {\r\n  const ctx = getCtx();\r\n  ctx.font = `${weight} ${fontPx}px ${family || getProgramFontFamily()}`;\r\n  ctx.letterSpacing = `${letterSpacing || 0}px`;\r\n  return ctx;\r\n}\r\n\r\nexport function measureTextWidth(text, fontPx, { weight = 700, letterSpacing = 0, family } = {}) {\r\n  const ctx = setFont(fontPx, weight, letterSpacing, family);\r\n  return ctx.measureText(text).width;\r\n}\r\n\r\n// maxFont/minFont/maxWidth en px; weight/letterSpacing deben coincidir con\r\n// el CSS real del elemento o la medicion queda mal.\r\nexport async function fitFontSize(text, { maxFont, minFont, maxWidth, weight = 700, letterSpacing = 0, family }) {\r\n  await document.fonts.load(`${weight} ${maxFont}px ${family || getProgramFontFamily()}`);\r\n  const widthAtMax = measureTextWidth(text, maxFont, { weight, letterSpacing, family });\r\n  if (widthAtMax <= maxWidth) return maxFont;\r\n  let size = Math.floor(maxFont * (maxWidth / widthAtMax));\r\n  size = Math.max(minFont, size);\r\n  while (size > minFont && measureTextWidth(text, size, { weight, letterSpacing, family }) > maxWidth) {\r\n    size -= 1;\r\n  }\r\n  return size;\r\n}\r\n\r\n// Referencia FIJA para la mitad \"de tinta\" de la correccion (2026-08-06,\r\n// causa real de un bug reportado por el usuario: textos largos en los\r\n// zocalos se desplazaban en Y al reducirse automaticamente de tama\u00F1o).\r\n// Esta funcion antes media \"actualBoundingBoxAscent/Descent\" del TEXTO\r\n// REAL que se le pasaba -- esos dos valores describen la tinta especifica\r\n// de las letras presentes en ESE string puntual, no una propiedad del\r\n// font en si. Mientras el texto no tuviera ninguna letra con trazo por\r\n// debajo de la linea de base, el resultado era estable (~0 en la practica,\r\n// verificado en vivo); apenas aparecia una letra con ese trazo en la\r\n// fuente real (ej. la \"Q\" de \"EQUIPO\", tambien J/G segun la fuente) la\r\n// correccion saltaba a un valor distinto SOLO para ese texto puntual --\r\n// coincidia con textos largos en las pruebas porque un texto mas largo\r\n// tiene mas chances de incluir alguna de esas letras, pero la causa real\r\n// no era la longitud ni el tama\u00F1o reducido: era que letra especifica\r\n// aparecia en el string.\r\n// Fix estructural: la mitad de tinta se mide SIEMPRE contra esta\r\n// referencia fija (mayusculas representativas sin descendentes, mas los\r\n// acentos/\u00D1 que en esta fuente son el caso de mayor ascendente) en vez de\r\n// contra el texto real -- asi el resultado es identico sin importar que\r\n// letras, cuantos caracteres o que tama\u00F1o resulte del auto-ajuste. Para\r\n// cualquier texto tipico de este sistema (mayusculas, sin descendentes)\r\n// el valor coincide con el que ya daba el calculo anterior -- por eso los\r\n// modulos que ya se veian bien centrados no deberian moverse -- y para los\r\n// que antes tenian una letra \"rara\" ahora dan el mismo resultado que el\r\n// resto en vez de un offset propio.\r\nconst VCORRECTION_REFERENCE = 'HOX\u00C1\u00C9\u00CD\u00D3\u00DA\u00D1';\r\n\r\nexport function verticalCorrection(text, fontPx, { weight = 700, letterSpacing = 0, family } = {}) {\r\n  const ctx = setFont(fontPx, weight, letterSpacing, family);\r\n  const m = ctx.measureText(VCORRECTION_REFERENCE);\r\n  const lineBoxAscent = m.fontBoundingBoxAscent;\r\n  const lineBoxDescent = m.fontBoundingBoxDescent;\r\n  const inkAscent = m.actualBoundingBoxAscent;\r\n  const inkDescent = m.actualBoundingBoxDescent;\r\n  return -((lineBoxAscent - lineBoxDescent) / 2 + (inkDescent - inkAscent) / 2);\r\n}\r\n\r\n// Aplica fitFontSize + verticalCorrection sobre un elemento de una sola\r\n// linea en un solo paso (el caso comun: textContent + font-size +\r\n// transform, los tres juntos).\r\n//\r\n// \"adjust\" (2026-08-14, pedido explicito del usuario: herramienta de\r\n// edicion manual de posicion/tama\u00F1o por campo de texto, sin tocar codigo)\r\n// -- offsets OPCIONALES del operador, guardados junto al preset del\r\n// modulo (ver \"textAdjust\" en shared/modules.js) y aplicados ACA, como\r\n// una capa mas encima de lo que esta funcion ya calculaba, nunca en\r\n// lugar de eso: \"posicion final = posicion dise\u00F1o + ajuste operador\".\r\n// Parametro con default {} para que cualquier llamado existente sin este\r\n// 4to argumento (la inmensa mayoria del proyecto) seguya funcionando\r\n// IDENTICO a antes -- con dx=dy=dSize=0 el resultado es exactamente el\r\n// mismo que \"translateY(verticalCorrection(...))\" de siempre (translate(0,Y)\r\n// es lo mismo que translateY(Y)), cero cambio visual donde no se pida.\r\n// Se aplica en el MISMO estilo inline que ya pisa esta funcion (fontSize/\r\n// transform) en vez de agregar una capa CSS aparte, porque son\r\n// precisamente esos dos estilos los que closures previos de este archivo\r\n// (ver comentario de \".ov-estrellas-titulo\" en overlay.css, y varios mas)\r\n// identificaron como los que SIEMPRE gana esta funcion sobre cualquier\r\n// regla puesta en CSS -- centralizar el ajuste aca evita reabrir ese\r\n// mismo problema con una tercera fuente de verdad sobre la posicion.\r\nexport async function applyFittedText(el, text, opts, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  // Mayuscula ANTES de medir (no solo al pintar): si se midiera el texto\r\n  // original y se mostrara en mayuscula, el ancho real (mas ancho en\r\n  // mayuscula) podria desbordar la caja -- fitFontSize tiene que ver\r\n  // exactamente el mismo string que termina en pantalla.\r\n  const upperText = toBroadcastUpper(text);\r\n  el.textContent = upperText;\r\n  const baseSize = await fitFontSize(upperText, opts);\r\n  const size = Math.max(1, baseSize + dSize);\r\n  el.style.fontSize = `${size}px`;\r\n  el.style.transform = `translate(${dx}px, ${verticalCorrection(upperText, size, opts) + dy}px)`;\r\n  return size;\r\n}\r\n\r\nexport async function updateFittedTextWithTransition(el, newText, oldText, opts, adjust = {}, isExplicitUpdate = false) {\r\n  if (isExplicitUpdate && oldText !== undefined && oldText !== newText) {\r\n    el.style.transition = 'opacity 0.18s ease-out';\r\n    el.style.opacity = '0';\r\n    setTimeout(async () => {\r\n      await applyFittedText(el, newText, opts, adjust);\r\n      el.style.opacity = '1';\r\n    }, 180);\r\n  } else {\r\n    await applyFittedText(el, newText, opts, adjust);\r\n  }\r\n}\r\n\r\n// Lee el ajuste guardado de un campo puntual dentro de \"data.textAdjust\"\r\n// (ver shared/modules.js) sin romper si el modulo todavia no lo tiene\r\n// (estado viejo persistido de antes de este cambio) -- siempre devuelve\r\n// un objeto valido para pasarle directo a \"applyFittedText\" como 4to\r\n// argumento. \"key\" admits rutas planas tipo \"double1.name\" (asi se\r\n// guardan, no como objetos anidados: ver shortDouble en shared/modules.js).\r\nexport function readTextAdjust(textAdjust, key) {\r\n  return (textAdjust && textAdjust[key]) || {};\r\n}\r\n\r\n// Ajuste manual (2026-08-15, auditoria completa pedida por el usuario:\r\n// \"TODO texto visible en Program debe poder ajustarse individualmente\")\r\n// para textos que NO pasan por fitFontSize/applyFittedText -- abreviaturas\r\n// de equipo, goles, reloj/contador, numeros de camiseta, etc., que hoy se\r\n// pintan con \"el.textContent = valor\" directo y tama\u00F1o FIJO por CSS (sin\r\n// auto-reduccion, no hace falta volver a implementar eso aca).\r\n//\r\n// Usa \"el.style.translate\" (propiedad CSS independiente de \"transform\",\r\n// no el shorthand \"transform: translate(...)\") para el offset de\r\n// posicion: varios de estos elementos YA tienen su propio \"transform\"\r\n// declarado en CSS (ej. \".ov-score\", ajustado en una vuelta anterior) o\r\n// podrian sumar uno en el futuro -- \"translate\" se COMPONE con cualquier\r\n// \"transform\" existente sin pisarlo (verificado en vivo: un elemento con\r\n// \"transform: translateY(-1px)\" en CSS + \"el.style.translate = '6px -4px'\"\r\n// via JS termina desplazado (+6,-5) en pantalla, la suma exacta de\r\n// ambos), asi que dx=dy=0 nunca cambia nada sin importar que transform de\r\n// dise\u00F1o ya tenga el elemento, sin necesidad de leerlo/duplicarlo aca.\r\n//\r\n// El tama\u00F1o BASE (para poder sumarle \"dSize\") se toma la PRIMERA vez de\r\n// \"getComputedStyle\" (el valor real que ya definio el CSS) y se cachea en\r\n// el dataset del propio nodo -- no hay que duplicar el font-size de cada\r\n// clase en JS, y sigue funcionando aunque ese valor cambie de dise\u00F1o en\r\n// el futuro (la proxima vez que el nodo se recree desde cero, se vuelve a\r\n// leer fresco).\r\nexport function applyPlainTextAdjust(el, text, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  el.textContent = toBroadcastUpper(text);\r\n  el.style.translate = `${dx}px ${dy}px`;\r\n  if (dSize) {\r\n    if (!el.dataset.baseFontSize) {\r\n      el.dataset.baseFontSize = parseFloat(getComputedStyle(el).fontSize) || 0;\r\n    }\r\n    const base = parseFloat(el.dataset.baseFontSize) || 0;\r\n    el.style.fontSize = `${Math.max(1, base + dSize)}px`;\r\n  } else if (el.style.fontSize) {\r\n    el.style.removeProperty('font-size');\r\n  }\r\n}\r\n\r\n// Ajuste manual para elementos NO textuales (escudos <img>, el guion\r\n// estatico del marcador, etc. -- 2026-08-31, pedido explicito del\r\n// usuario: \"cada elemento visual debe poder moverse Y ESCALARSE por\r\n// separado\"). Deliberadamente separado de \"applyPlainTextAdjust\": no\r\n// toca \"textContent\" (romper\u00EDa una <img> o un separador con texto fijo\r\n// ya puesto en el HTML) y la escala es proporcional (multiplicador),\r\n// no una resta de tama\u00F1o de fuente en px como \"dSize\".\r\n//\r\n// Misma tecnica que arriba: \"el.style.translate\"/\"el.style.scale\" son\r\n// propiedades CSS independientes de \"transform\" (no su shorthand) y se\r\n// COMPONEN con cualquier \"transform\" que el elemento ya tenga declarado\r\n// por CSS (ej. \".ov-crest\" de Argentina Streamers usa\r\n// \"transform: translateY(-50%)\" para centrado vertical) -- offsetX=\r\n// offsetY=0/scale=1 nunca cambia nada sin importar que transform de\r\n// dise\u00F1o ya tenga el elemento.\r\nexport function applyElementAdjust(el, adjust = {}) {\r\n  const { offsetX = 0, offsetY = 0, scale = 1 } = adjust;\r\n  el.style.translate = `${offsetX}px ${offsetY}px`;\r\n  el.style.scale = String(scale);\r\n}\r\n\r\n// Variante multilinea de fitFontSize (ej. listas de goleadores en Zocalo\r\n// VS compacto): recibe varias lineas de texto libre y les busca un unico\r\n// tama\u00F1o de fuente que entre a la vez en ancho (la linea mas larga) y en\r\n// alto (todas las lineas juntas, con su interlineado) dentro de la caja\r\n// real. Si ni siquiera al tama\u00F1o minimo entran todas, prioriza reducir el\r\n// tama\u00F1o (como cualquier otro texto del sistema) antes que recortar\r\n// contenido \u2014 y si aun asi no entran, recorta a las que entren y agrega\r\n// un renglon \"+N mas\" en vez de ocultar informacion en silencio.\r\nexport async function fitLinesFontSize(lines, {\r\n  maxFont, minFont, maxWidth, maxHeight, weight = 600, letterSpacing = 0, lineGapRatio = 0.25,\r\n}) {\r\n  await document.fonts.load(`${weight} ${maxFont}px ${getProgramFontFamily()}`);\r\n\r\n  function widestAt(fontPx) {\r\n    let widest = 0;\r\n    for (const line of lines) {\r\n      const w = measureTextWidth(line, fontPx, { weight, letterSpacing });\r\n      if (w > widest) widest = w;\r\n    }\r\n    return widest;\r\n  }\r\n  function lineHeightAt(fontPx) {\r\n    return fontPx * (1 + lineGapRatio);\r\n  }\r\n  function fits(fontPx, count) {\r\n    return widestAt(fontPx) <= maxWidth && count * lineHeightAt(fontPx) <= maxHeight;\r\n  }\r\n\r\n  let fontSize = maxFont;\r\n  while (fontSize > minFont && !fits(fontSize, lines.length)) {\r\n    fontSize -= 1;\r\n  }\r\n\r\n  let shown = lines.length;\r\n  let truncated = false;\r\n  if (!fits(fontSize, lines.length)) {\r\n    const maxLines = Math.max(0, Math.floor(maxHeight / lineHeightAt(fontSize)));\r\n    shown = Math.max(0, maxLines - 1); // reserva un renglon para el indicador \"+N mas\"\r\n    truncated = shown < lines.length;\r\n  }\r\n\r\n  return { fontSize, shown, truncated, lineHeight: lineHeightAt(fontSize) };\r\n}\r\n\r\n// Renderiza una lista de lineas (ej. goleadores) dentro de \"el\", ya\r\n// recortada/ajustada por fitLinesFontSize: una linea de texto libre por\r\n// fila (sin parsear nombre/minuto, es texto tal cual lo tipeo el\r\n// operador), mas un renglon final \"+N mas\" si no entraron todas. No hace\r\n// falta un helper de centrado vertical por fila (a diferencia del texto\r\n// de una sola linea): el bloque completo ya se centra con flexbox contra\r\n// la caja real (ver \".ov-vs-scorersA/B\" en overlay.css), y el peque\u00F1o\r\n// desbalance de linea-de-fuente vs. tinta real de Anton es imperceptible\r\n// a estos tama\u00F1os chicos (11-16px) frente al del resto del sistema.\r\nexport async function applyFittedLines(el, rawLines, opts) {\r\n  const lines = rawLines.map((l) => toBroadcastUpper(l.trim())).filter(Boolean);\r\n  el.innerHTML = '';\r\n  if (lines.length === 0 || opts.maxHeight <= 0) {\r\n    return { fontSize: 0, shown: 0, total: lines.length, truncated: lines.length > 0 };\r\n  }\r\n\r\n  const { fontSize, shown, truncated } = await fitLinesFontSize(lines, opts);\r\n  el.style.fontSize = `${fontSize}px`;\r\n  el.style.lineHeight = `${1 + (opts.lineGapRatio ?? 0.25)}`;\r\n\r\n  for (const line of lines.slice(0, shown)) {\r\n    const row = document.createElement('div');\r\n    row.className = 'fitted-line';\r\n    row.textContent = line;\r\n    el.appendChild(row);\r\n  }\r\n  if (truncated) {\r\n    const more = document.createElement('div');\r\n    more.className = 'fitted-line fitted-line-more';\r\n    more.textContent = `+${lines.length - shown} M\u00C1S`;\r\n    el.appendChild(more);\r\n  }\r\n\r\n  return { fontSize, shown, total: lines.length, truncated };\r\n}\r\n","http://localhost:4430/shared/text-tokens.js","import { teamName } from './teams.js';\r\n\r\n// Reemplaza tokens din\u00E1micos de equipo en textos editables de Z\u00D3CALOS.\r\n// EQ1 / {EQ1} -> Nombre completo del equipo Local actual del Marcador.\r\n// EQ2 / {EQ2} -> Nombre completo del equipo Visitante actual del Marcador.\r\n// Utiliza l\u00EDmites de palabra (\\b) para no reemplazar secuencias accidentales dentro de otras palabras.\r\nexport function resolveTeamTokens(text, scoreboardData) {\r\n  if (!text || typeof text !== 'string') return text || '';\r\n  const sb = scoreboardData || {};\r\n  const nameA = teamName(sb.teamA) || 'LOCAL';\r\n  const nameB = teamName(sb.teamB) || 'VISITANTE';\r\n\r\n  return text\r\n    .replace(/\\{EQ1\\}/gi, nameA)\r\n    .replace(/\\{EQ2\\}/gi, nameB)\r\n    .replace(/\\bEQ1\\b/gi, nameA)\r\n    .replace(/\\bEQ2\\b/gi, nameB);\r\n}\r\n","http://localhost:4430/program/js/theme-assets.js","// RESOLUCI\u00D3N DE ASSETS POR THEME (2026-08-21, sistema multi-theme etapa 2,\r\n// pedido expl\u00EDcito: \"ARGENTINA STREAMERS OPERATIVO AHORA, solamente sin\r\n// sus assets gr\u00E1ficos definitivos\"). Punto \u00FAnico que consultan los\r\n// renderers de program/js/renderers/*.js para saber si tienen que montar\r\n// un video/imagen de fondo, o directamente omitirlo y dejar el contenido\r\n// din\u00E1mico (texto/escudos/n\u00FAmeros) solo, sobre transparencia.\r\n//\r\n// REGLA DE ORO para GLA (nunca romperlo): cuando el theme activo es GLA,\r\n// estas funciones devuelven SIEMPRE el \"fallback\" que le pasa el propio\r\n// renderer -- la misma constante VIDEO_SRC/IMG_SRC hardcodeada de\r\n// siempre -- y NUNCA consultan el manifest. As\u00ED, aunque el manifest de\r\n// shared/themes.js tuviera alg\u00FAn d\u00EDa un typo, GLA sigue funcionando\r\n// exactamente igual que antes de que existiera el sistema de themes.\r\n// Para cualquier OTRO theme s\u00ED se consulta el manifest real; si ese\r\n// theme todav\u00EDa no tiene el asset (null/pendiente), se devuelve null a\r\n// prop\u00F3sito -- eso es lo que le indica al renderer que no monte nada.\r\nimport { DEFAULT_THEME_ID, getThemeAsset } from '../../shared/themes.js';\r\nimport { getActiveThemeId } from './theme-client.js';\r\nimport { createAlphaVideo } from './alpha-video.js';\r\nimport { versionedAssetUrl } from './asset-versions.js';\r\n\r\nfunction resolveVideoPath(moduleId, fallbackForGla, variant) {\r\n  const themeId = getActiveThemeId();\r\n  if (themeId === DEFAULT_THEME_ID) return fallbackForGla || null;\r\n  const asset = getThemeAsset(themeId, moduleId);\r\n  if (!asset) return null;\r\n  if (variant) return asset.variants?.[variant] || null;\r\n  return asset.video || null;\r\n}\r\n\r\n// SOFTX (2026-10-29): toda ruta resuelta sale versionada (cache busting de\r\n// RECURSO GR\u00C1FICO, ver program/js/asset-versions.js).\r\nexport function resolveVideoSrc(moduleId, fallbackForGla, variant) {\r\n  return versionedAssetUrl(resolveVideoPath(moduleId, fallbackForGla, variant));\r\n}\r\n\r\nexport function resolveImageSrc(moduleId, fallbackForGla, variant) {\r\n  const themeId = getActiveThemeId();\r\n  if (themeId === DEFAULT_THEME_ID) return versionedAssetUrl(fallbackForGla || null);\r\n  const asset = getThemeAsset(themeId, moduleId);\r\n  if (!asset) return null;\r\n  if (variant) return versionedAssetUrl(asset.variants?.[variant] || null);\r\n  return versionedAssetUrl(asset.image || null);\r\n}\r\n\r\n// Monta un alpha-video SOLO si hay una fuente real resuelta para el\r\n// theme activo. Sin asset (theme no-GLA todav\u00EDa pendiente): devuelve\r\n// null -- el caller simplemente no guarda ning\u00FAn handle de video, el\r\n// \".gfx-overlay\" (contenido din\u00E1mico) sigue funcionando exactamente\r\n// igual porque nunca dependi\u00F3 del video para nada. \"variant\" es para\r\n// m\u00F3dulos con m\u00E1s de un asset posible (ej. tarjeta amarilla/roja/azul,\r\n// zocaloCompuesto equipos/logo) -- mismo criterio: GLA nunca lo consulta\r\n// en el manifest, solo el fallback que le pasa el propio renderer.\r\nexport function mountThemedAlphaVideo(targetEl, moduleId, fallbackForGla, opts, variant) {\r\n  const src = resolveVideoSrc(moduleId, fallbackForGla, variant);\r\n  if (!src) return null;\r\n  // \"moduleId\" (2026-09-25, Burst/Take Scheduler -- ver program/js/\r\n  // take-scheduler.js): createAlphaVideo lo necesita para decidir\r\n  // prioridad/escalonado de su propio \"play()\" sin que cada renderer\r\n  // tenga que saber nada de esto -- todos ya llaman a esta funcion con su\r\n  // moduleId real, asi que alcanza con reenviarlo dentro de \"opts\".\r\n  return createAlphaVideo(targetEl, src, { ...opts, moduleId });\r\n}\r\n","http://localhost:4430/shared/broadcast-names.js","// NOMBRES DE BROADCAST para gr\u00E1ficas VS (2026-09-01, pedido expl\u00EDcito del\n// usuario: \"los nombres actuales quedan mal visualmente... quiero una\n// soluci\u00F3n c\u00F3moda\" -- ver VS Prepartido/VS Con Resultado). Un mapping fijo\n// SOLO para mostrar en pantalla -- nunca toca el nombre real del equipo\n// (team.name en shared/themes.js) ni su cat\u00E1logo. Cualquier teamId sin\n// entrada ac\u00E1 (todos los equipos de GLA, o un equipo nuevo de Argentina\n// Streamers todav\u00EDa sin mapear) cae al nombre real de siempre\n// (fallbackName, que el llamador ya resuelve con teamName() de\n// shared/teams.js) -- cero cambio de comportamiento para quien no est\u00E1 en\n// este mapping.\nconst BROADCAST_NAME_MAP = {\n  'oxen': 'OXEN',\n  'argentina-streamers-fem': 'AR STREAMERS FEM',\n  'argentina-streamers': 'AR STREAMERS',\n  'peru-creadores': 'PER\u00DA CREADORES',\n  'argentina-senior': 'ARGENTINA SENIOR',\n};\n\nexport function getBroadcastName(teamId) {\n  return teamId ? (BROADCAST_NAME_MAP[teamId] || null) : null;\n}\n\n// Resuelve el nombre final para una gr\u00E1fica VS, dado el modo elegido por\n// el operador (\"auto\" | \"manual\") -- ver \"nameAMode\"/\"nameAManual\" en\n// shared/modules.js (vsPrepartido/vsResultado). MANUAL gana siempre que\n// haya texto tipeado (el nombre manual es solo para ESA gr\u00E1fica, nunca\n// renombra el equipo globalmente); AUTOM\u00C1TICO usa el mapping de arriba;\n// sin mapping, cae a \"fallbackName\" (el nombre real del equipo).\nexport function resolveVsDisplayName({ mode, manualText, teamId, fallbackName }) {\n  if (mode === 'manual') {\n    const manual = (manualText || '').trim();\n    if (manual) return manual;\n  }\n  return getBroadcastName(teamId) || fallbackName || '';\n}\n","http://localhost:4430/program/js/alpha-video.js","import { scheduleTakePlay } from './take-scheduler.js';\r\nimport { versionedAssetUrl } from './asset-versions.js';\r\n\r\n// Compositor reutilizable de video con canal alfa real para el Program.\r\n//\r\n// Los .mov originales (ProRes 4444, canal alfa) no los puede decodificar\r\n// ningun navegador, y <video> HTML nunca compone transparencia real en\r\n// ningun formato. Por eso cada asset se transcodifica una sola vez (ver\r\n// scripts de transcodificacion en el historial / CHANGELOG) a un .mp4 H.264\r\n// que apila verticalmente el color (mitad de arriba) y el canal alfa como\r\n// una mascara en escala de grises (mitad de abajo, mismo ancho). Esta\r\n// funcion reproduce ese .mp4 oculto y compone color+alfa real, frame a\r\n// frame, sobre un <canvas> visible.\r\n//\r\n// Usan este helper todos los renderers de program/js/renderers/ que\r\n// necesitan mostrar un asset .mov real (que es la mayoria) \u2014 asi la logica\r\n// de composicion no se duplica en cada uno.\r\n//\r\n// Composicion en GPU (WebGL), no en CPU: la version anterior usaba\r\n// ctx.drawImage + ctx.getImageData (lee ~16.6MB del frame 1920x2160 de\r\n// vuelta a la CPU) + un loop manual por cada uno de los 2.073.600 pixeles +\r\n// ctx.putImageData, TODO en el hilo principal, en cada frame de cada video\r\n// reproduciendose. Medido en Program real (PerformanceObserver longtask +\r\n// muestreo de rAF): un unico modulo tomando al aire bajaba el frame rate de\r\n// ~144fps idle a ~11fps (90ms/frame, 41 long tasks en 3.5s) durante toda la\r\n// duracion del clip, y 3 modulos simultaneos (escenario normal: marcador +\r\n// mosca + un zocalo) a ~4fps (246ms/frame, main thread bloqueado casi sin\r\n// huecos). Ver CHANGELOG.md para la evidencia completa antes/despues. La\r\n// version WebGL sube el frame del <video> directo como textura (ruta\r\n// acelerada por el navegador, sin readback sincrono a CPU) y hace la\r\n// mezcla color+alfa en un fragment shader \u2014 el trabajo por frame en el\r\n// hilo principal pasa a ser esencialmente cero.\r\nconst FRAME_W = 1920;\r\nconst FRAME_H = 1080;\r\n\r\nconst VERTEX_SRC = `\r\nattribute vec2 aPos;\r\nvoid main() {\r\n  gl_Position = vec4(aPos, 0.0, 1.0);\r\n}\r\n`;\r\n\r\n// El frame fuente apila color (fila 0..FRAME_H-1) y mascara de alfa en\r\n// escala de grises (fila FRAME_H..2*FRAME_H-1), fila a fila, de arriba\r\n// hacia abajo \u2014 mismo layout que consumia el compositor CPU anterior. En\r\n// vez de razonar sobre la orientacion interna de la textura en WebGL (que\r\n// depende de UNPACK_FLIP_Y_WEBGL y es una fuente clasica de errores), se\r\n// parte de gl_FragCoord: coordenadas de pixel del propio canvas de salida,\r\n// con .y creciendo de abajo hacia arriba (convencion WebGL). Restando de\r\n// la altura del canvas se obtiene la fila medida desde ARRIBA del frame de\r\n// salida (misma convencion que el resto del proyecto, ej. los bounding\r\n// box documentados en overlay.css), y desde ahi se ubica la fila\r\n// equivalente en cada mitad de la textura fuente.\r\nconst FRAGMENT_SRC = `\r\nprecision highp float;\r\nuniform sampler2D uTex;\r\nuniform vec2 uResolution;\r\nvoid main() {\r\n  float rowFromTop = uResolution.y - gl_FragCoord.y;\r\n  float u = gl_FragCoord.x / uResolution.x;\r\n  float colorV = rowFromTop / (uResolution.y * 2.0);\r\n  float alphaV = (uResolution.y + rowFromTop) / (uResolution.y * 2.0);\r\n  vec3 color = texture2D(uTex, vec2(u, colorV)).rgb;\r\n  float a = texture2D(uTex, vec2(u, alphaV)).r;\r\n  gl_FragColor = vec4(color, a);\r\n}\r\n`;\r\n\r\nfunction compileShader(gl, type, source) {\r\n  const shader = gl.createShader(type);\r\n  gl.shaderSource(shader, source);\r\n  gl.compileShader(shader);\r\n  if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {\r\n    const info = gl.getShaderInfoLog(shader);\r\n    gl.deleteShader(shader);\r\n    throw new Error(`Shader compile error: ${info}`);\r\n  }\r\n  return shader;\r\n}\r\n\r\n// Intenta preparar el compositor WebGL sobre `canvas`. Devuelve null si el\r\n// navegador no puede darnos un contexto WebGL utilizable \u2014 el llamador cae\r\n// al compositor CPU anterior en ese caso, para no dejar un modulo en\r\n// blanco en una maquina sin GPU/driver funcional.\r\nfunction setupGl(canvas) {\r\n  const gl = canvas.getContext('webgl', {\r\n    // false: el shader escribe RGB sin premultiplicar (igual que el\r\n    // ImageData sin premultiplicar que escribia putImageData antes), asi\r\n    // los pixeles semitransparentes del asset (ej. la banda de titulo de\r\n    // Penales, alfa~174/255) componen contra el fondo igual que antes.\r\n    premultipliedAlpha: false,\r\n    alpha: true,\r\n    antialias: false,\r\n    depth: false,\r\n    stencil: false,\r\n    // true: sin esto el navegador puede limpiar el buffer de dibujo del\r\n    // canvas despues de presentar un frame en el que no se volvio a\r\n    // dibujar. El loop de composicion se detiene apenas el video termina\r\n    // (tick() deja de pedir el proximo rAF) para no gastar CPU/GPU de mas\r\n    // \u2014 el modulo tiene que seguir mostrando ese ultimo frame compuesto de\r\n    // forma estatica el resto del tiempo que quede al aire, igual que\r\n    // hacia el <canvas> 2D anterior (que nunca se autolimpia).\r\n    preserveDrawingBuffer: true,\r\n  });\r\n  if (!gl) return null;\r\n\r\n  let program;\r\n  try {\r\n    const vs = compileShader(gl, gl.VERTEX_SHADER, VERTEX_SRC);\r\n    const fs = compileShader(gl, gl.FRAGMENT_SHADER, FRAGMENT_SRC);\r\n    program = gl.createProgram();\r\n    gl.attachShader(program, vs);\r\n    gl.attachShader(program, fs);\r\n    gl.linkProgram(program);\r\n    gl.deleteShader(vs);\r\n    gl.deleteShader(fs);\r\n    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {\r\n      throw new Error(`Program link error: ${gl.getProgramInfoLog(program)}`);\r\n    }\r\n  } catch {\r\n    return null;\r\n  }\r\n\r\n  gl.useProgram(program);\r\n\r\n  // Triangulo unico que cubre todo el clip space (-1..1 en X e Y) \u2014 evita\r\n  // el vertice de mas de un quad de 2 triangulos, sin ningun costo real:\r\n  // el fragment shader ya descarta lo que cae fuera del canvas.\r\n  const posBuffer = gl.createBuffer();\r\n  gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);\r\n  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);\r\n  const aPos = gl.getAttribLocation(program, 'aPos');\r\n  gl.enableVertexAttribArray(aPos);\r\n  gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);\r\n\r\n  const texture = gl.createTexture();\r\n  gl.bindTexture(gl.TEXTURE_2D, texture);\r\n  // El frame fuente (1920x2160) no es potencia de 2: WebGL1 exige\r\n  // CLAMP_TO_EDGE + filtros sin mipmap para texturas NPOT.\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);\r\n\r\n  const uResolution = gl.getUniformLocation(program, 'uResolution');\r\n  gl.uniform2f(uResolution, FRAME_W, FRAME_H);\r\n\r\n  gl.viewport(0, 0, FRAME_W, FRAME_H);\r\n\r\n  return { gl, program, texture };\r\n}\r\n\r\n// Crea el <video> oculto + <canvas> visible dentro de `el` y arranca el loop\r\n// de composicion mientras el video esta reproduciendose. Devuelve un handle\r\n// con `canvas` (por si el renderer necesita referenciarlo) y\r\n// `playFromStart()` para disparar la animacion de entrada una sola vez.\r\n//\r\n// `onEnded` (opcional) se llama cuando el video termina de reproducirse sin\r\n// loop \u2014 lo usan los modulos \"oneShot\" (ver shared/modules.js) para avisarle\r\n// a program/js/main.js que tiene que sacarse solo del aire.\r\nexport function createAlphaVideo(el, src, { onEnded, moduleId } = {}) {\r\n  el.innerHTML = `\r\n    <video class=\"alpha-video-src\" src=\"${versionedAssetUrl(src)}\" muted playsinline preload=\"auto\"></video>\r\n    <canvas class=\"alpha-video-canvas\" width=\"${FRAME_W}\" height=\"${FRAME_H}\"></canvas>\r\n  `;\r\n\r\n  const video = el.querySelector('.alpha-video-src');\r\n  video.muted = true;\r\n\r\n  const canvas = el.querySelector('.alpha-video-canvas');\r\n  const glCtx = setupGl(canvas);\r\n\r\n  // Fallback: sin WebGL utilizable, se compone en CPU exactamente como\r\n  // antes (mismo resultado visual, mas lento) en vez de dejar el modulo\r\n  // sin imagen.\r\n  let ctx2d = null;\r\n  let offCanvas = null;\r\n  let offCtx = null;\r\n  if (!glCtx) {\r\n    ctx2d = canvas.getContext('2d');\r\n    offCanvas = document.createElement('canvas');\r\n    offCanvas.width = FRAME_W;\r\n    offCanvas.height = FRAME_H * 2;\r\n    offCtx = offCanvas.getContext('2d', { willReadFrequently: true });\r\n  }\r\n\r\n  let rafId = null;\r\n  let vfcId = null;\r\n  let destroyed = false;\r\n  // \"seekPending\" (2026-09-24, bug real reproducido en GLA -- Zocalo\r\n  // Compuesto/Largo Doble/Corto Simple/Corto Doble/Tabla Global: \"TAKE ->\r\n  // aparece el asset vacio/estatico -> desaparece -> recien ahi empieza la\r\n  // animacion correcta\"). Causa real: \"playFromStart()\" hace\r\n  // \"video.currentTime = 0\" (un seek ASINCRONICO) seguido de \"video.play()\"\r\n  // -- el evento 'play' dispara casi de inmediato, pero el decodificador\r\n  // todavia no proceso el seek, asi que el <video> sigue mostrando el\r\n  // frame VIEJO (el ultimo frame del play anterior, retenido tal cual por\r\n  // \"holdWarm()\", que nunca resetea currentTime). \"handlePlay()\" pintaba\r\n  // ESE frame viejo de inmediato (a proposito, para no perder latencia) --\r\n  // para un modulo cuyo ultimo frame se parece al primero (Marcador,\r\n  // Tarjeta, Cambios, Gol) el parpadeo pasa desapercibido; para un zocalo\r\n  // cuyo ultimo frame es la pieza ya asentada y el primero es la pieza\r\n  // arrancando su animacion de entrada, el mismo parpadeo se ve como\r\n  // \"aparece armado, desaparece, recien ahi entra\". Con \"seekPending\" se\r\n  // suprime ESE primer dibujo sincronico unicamente cuando de verdad hay\r\n  // un frame viejo que ocultar (currentTime>0 al momento de reproducir de\r\n  // nuevo) -- el primer play de un modulo recien precalentado (currentTime\r\n  // ya en 0, nada que ocultar) sigue pintando de inmediato, cero latencia\r\n  // extra agregada ahi. El primer frame real (ya posterior al seek) se\r\n  // pinta apenas llega, via el evento nativo 'seeked' o el primer\r\n  // requestVideoFrameCallback -- lo que ocurra primero -- nunca via un\r\n  // delay arbitrario.\r\n  let seekPending = false;\r\n  // \"releasedPromise\" (2026-09-26, WebGL context management -- pedido\r\n  // explicito: \"preferir callback/promesa de teardown... no simplemente\r\n  // setTimeout(250, warmTheme) sin una razon tecnica\"). destroy() sigue\r\n  // liberando el contexto/video en el MISMO momento diferido de siempre\r\n  // (ver destroy() mas abajo, sin cambios de timing) -- esto solo agrega\r\n  // una forma de ENTERARSE, de manera determinista, de cuando esa\r\n  // liberacion ya ocurrio de verdad, para que quien haga un cambio de\r\n  // theme (program/js/main.js) pueda esperar el release real de los\r\n  // contextos VIEJOS antes de crear los NUEVOS, en vez de asumir un numero\r\n  // fijo de ms. Ningun llamador existente esta obligado a usar este valor\r\n  // de retorno -- todos los que ya llaman \"destroy()\" en fire-and-forget\r\n  // siguen funcionando identico.\r\n  let releasedPromise = null;\r\n\r\n  // BURST/TAKE SCHEDULER (2026-09-25 -- ver program/js/take-scheduler.js\r\n  // para el mecanismo completo). \"takeToken\" es la vigencia de un pedido\r\n  // de \"reproducir desde el principio\": cada \"playFromStart()\" lo\r\n  // incrementa y captura su propio numero; si para cuando le toca el turno\r\n  // (delay>0, ver mas abajo) el numero YA NO coincide -- porque el modulo\r\n  // se pauso (holdWarm), se destruyo, o se pidio OTRO playFromStart() mas\r\n  // nuevo mientras tanto -- el callback diferido simplemente no hace nada.\r\n  // Sin este chequeo, un Take viejo podria terminar reproduciendo un video\r\n  // que ya no deberia (ej: Take -> Out casi inmediato mientras el Take\r\n  // todavia esperaba su turno escalonado).\r\n  let takeToken = 0;\r\n  let cancelPendingPlay = null;\r\n  function invalidatePendingPlay() {\r\n    takeToken += 1;\r\n    if (cancelPendingPlay) {\r\n      cancelPendingPlay();\r\n      cancelPendingPlay = null;\r\n    }\r\n  }\r\n\r\n  function compositeFrameGl() {\r\n    // Guarda agregada (2026-09-04, auditoria de performance pre-transmision):\r\n    // justo al reproducir, el evento \"play\" puede disparar el primer tick()\r\n    // antes de que el <video> tenga un frame real decodificado todavia\r\n    // (readyState < HAVE_CURRENT_DATA) -- texImage2D con un <video> asi tira\r\n    // \"WebGL: INVALID_VALUE: texImage2D: no video\" en consola en CADA TAKE\r\n    // de CADA modulo con alpha-video, siempre inofensivo (el propio rAF\r\n    // vuelve a intentarlo el frame siguiente) pero genera ruido repetitivo\r\n    // que puede tapar un error real durante la operacion. Un solo chequeo\r\n    // de estado, sin tocar el resto del pipeline/lifecycle/timing.\r\n    if (video.readyState < video.HAVE_CURRENT_DATA) return;\r\n    const { gl, texture } = glCtx;\r\n    gl.bindTexture(gl.TEXTURE_2D, texture);\r\n    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, video);\r\n    gl.drawArrays(gl.TRIANGLES, 0, 3);\r\n  }\r\n\r\n  function compositeFrameCpu() {\r\n    offCtx.drawImage(video, 0, 0, FRAME_W, FRAME_H * 2);\r\n    const full = offCtx.getImageData(0, 0, FRAME_W, FRAME_H * 2);\r\n    const out = ctx2d.createImageData(FRAME_W, FRAME_H);\r\n    const src2 = full.data;\r\n    const dst = out.data;\r\n    const pixelCount = FRAME_W * FRAME_H;\r\n    const matteOffset = pixelCount * 4;\r\n    for (let p = 0; p < pixelCount; p++) {\r\n      const i = p * 4;\r\n      dst[i] = src2[i];\r\n      dst[i + 1] = src2[i + 1];\r\n      dst[i + 2] = src2[i + 2];\r\n      dst[i + 3] = src2[i + matteOffset]; // canal R de la mascara = alfa real\r\n    }\r\n    ctx2d.putImageData(out, 0, 0);\r\n  }\r\n\r\n  const compositeFrame = glCtx ? compositeFrameGl : compositeFrameCpu;\r\n\r\n  // \"requestVideoFrameCallback\" en vez de \"requestAnimationFrame\" puro\r\n  // (2026-09-14, investigacion de fluidez pedida por el usuario: \"varios\r\n  // se ven trabados/con reproduccion entrecortada... con multiples modulos\r\n  // simultaneos\"). Causa real encontrada: el \"tick()\" de siempre redibuja\r\n  // en CADA refresco de pantalla (rAF, tipicamente 60Hz) sin importar el\r\n  // framerate real del .mp4 fuente (25-30fps segun el asset) -- cada\r\n  // redibujo hace un texImage2D de un frame de 1920x2160 (16.6MB) + un\r\n  // draw call sobre SU PROPIO contexto WebGL. Con un unico modulo al aire\r\n  // esto ya es trabajo de sobra (redibuja el MISMO frame decodificado 2-3\r\n  // veces antes de que el video avance al siguiente); con 3+ modulos\r\n  // simultaneos (el escenario que reporta el usuario) esto se MULTIPLICA:\r\n  // 3-5 uploads+draws redundantes por refresco, sobre 3-5 contextos WebGL\r\n  // distintos que la GPU tiene que alternar en cada uno -- carga de sobra\r\n  // que compite por el mismo hilo de composicion del navegador/CEF y puede\r\n  // manifestarse como el entrecortado/perdida de frames reportado.\r\n  // \"requestVideoFrameCallback\" (soportado en cualquier Chromium reciente,\r\n  // confirmado en este entorno) solo dispara el callback cuando el\r\n  // DECODIFICADOR de video efectivamente presento un frame NUEVO -- ni un\r\n  // redibujo mas de lo que el archivo fuente realmente necesita, sin bajar\r\n  // resolucion/calidad/framerate del asset en si (el archivo se sigue\r\n  // decodificando y presentando a su framerate real, esto solo evita\r\n  // redibujar el mismo frame de mas). Con fallback a \"requestAnimationFrame\"\r\n  // si el navegador no lo soporta (nunca deja de reproducirse en ese caso,\r\n  // solo pierde esta optimizacion puntual).\r\n  const useVideoFrameCallback = glCtx && typeof video.requestVideoFrameCallback === 'function';\r\n\r\n  function tick() {\r\n    if (destroyed) return;\r\n    if (!seekPending) compositeFrame();\r\n    if (!video.paused && !video.ended) {\r\n      rafId = requestAnimationFrame(tick);\r\n    }\r\n  }\r\n\r\n  function tickOnNewFrame() {\r\n    if (destroyed) return;\r\n    if (!seekPending) compositeFrame();\r\n    if (!video.paused && !video.ended) {\r\n      vfcId = video.requestVideoFrameCallback(tickOnNewFrame);\r\n    }\r\n  }\r\n\r\n  // Pinta el primer frame REAL (ya posterior al seek a 0) apenas el propio\r\n  // <video> confirma que termino de buscarlo -- ver \"seekPending\" arriba.\r\n  // Puede llegar antes o despues del evento 'play' segun el navegador; el\r\n  // guard \"seekPending\" en ambos lados hace que quien llegue primero pinte\r\n  // y el otro no repita de mas por error, sin depender del orden.\r\n  function handleSeeked() {\r\n    if (destroyed || !seekPending) return;\r\n    seekPending = false;\r\n    compositeFrame();\r\n  }\r\n  video.addEventListener('seeked', handleSeeked);\r\n\r\n  function handlePlay() {\r\n    if (destroyed) return;\r\n    if (rafId) cancelAnimationFrame(rafId);\r\n    if (vfcId && video.cancelVideoFrameCallback) video.cancelVideoFrameCallback(vfcId);\r\n    if (useVideoFrameCallback) {\r\n      // Primer frame pintado de inmediato via rAF (mismo criterio de\r\n      // siempre: no esperar al primer \"nuevo frame\" del decodificador para\r\n      // que la entrada se vea sin demora), la cadencia real la toma\r\n      // \"tickOnNewFrame\" desde el segundo frame en adelante -- PERO solo\r\n      // cuando no hay un seek pendiente (ver \"seekPending\"): si lo hay, el\r\n      // frame que el <video> tiene ahora mismo es el VIEJO (antes del seek\r\n      // a 0), pintarlo ya mismo es exactamente el bug de \"aparece armado y\r\n      // desaparece\". \"handleSeeked\" (o el primer \"tickOnNewFrame\") pinta\r\n      // el correcto apenas este disponible.\r\n      if (!seekPending) compositeFrame();\r\n      vfcId = video.requestVideoFrameCallback(tickOnNewFrame);\r\n    } else {\r\n      tick();\r\n    }\r\n  }\r\n\r\n  video.addEventListener('play', handlePlay);\r\n\r\n  if (onEnded) {\r\n    video.addEventListener('ended', onEnded);\r\n  }\r\n\r\n  // \"clearStaleFrame\" (2026-09-26, BUG real reproducido en vivo en GLA --\r\n  // Zocalo Compuesto/Largo Doble/Corto Simple/Corto Doble/Tabla Global:\r\n  // \"TAKE -> aparece la grafica completa/asentada un instante -> desaparece\r\n  // -> recien ahi arranca la animacion de entrada correcta\"). Causa real:\r\n  // el Burst/Take Scheduler (2026-09-25, ver program/js/take-scheduler.js)\r\n  // puede diferir \"video.currentTime=0; video.play()\" hasta 160ms (o 50ms\r\n  // para HIGH) cuando 2+ modulos hacen Take casi juntos -- pero\r\n  // \"target.root.classList.add('is-in')\" en program/js/main.js sigue\r\n  // siendo 100% SINCRONICO en el mismo Take, sin esperar a ese turno\r\n  // escalonado (a proposito, el scheduler no acopla nada del pipeline\r\n  // visual). Con \"preserveDrawingBuffer:true\" el canvas WebGL retiene el\r\n  // ULTIMO frame compuesto (tipicamente el asset ya asentado, quieto desde\r\n  // que \"holdWarm()\" lo dejo en pausa) hasta el proximo dibujo real -- ese\r\n  // es exactamente el frame que se ve durante la espera del turno\r\n  // escalonado. \"seekPending\" (2026-09-24) ya evitaba pisar ese frame viejo\r\n  // con uno tambien viejo durante el seek asincronico, pero nunca borraba\r\n  // lo que YA estaba pintado antes de que existiera ningun escalonado que\r\n  // esperar. Limpiar el canvas a transparente SINCRONICAMENTE, en el mismo\r\n  // instante en que se PIDE el Take (antes de llamar al scheduler, nunca\r\n  // despues) cierra la ventana completa: para un Take inmediato (slot 0,\r\n  // el caso de siempre) el limpiado y el primer dibujo real ocurren en el\r\n  // mismo tick antes de que el navegador pinte nada, cero cambio visible;\r\n  // para uno diferido, el modulo se revela ya transparente y permanece asi\r\n  // hasta que su turno real llega, en vez de mostrar el asset asentado.\r\n  function clearStaleFrame() {\r\n    if (glCtx) {\r\n      glCtx.gl.clear(glCtx.gl.COLOR_BUFFER_BIT);\r\n    } else if (ctx2d) {\r\n      ctx2d.clearRect(0, 0, FRAME_W, FRAME_H);\r\n    }\r\n  }\r\n\r\n  return {\r\n    canvas,\r\n    // Reproduce la animacion de entrada completa desde el frame 0. Al\r\n    // terminar (evento \"ended\", sin loop) el <video> queda pausado en el\r\n    // ultimo frame y el canvas conserva esa ultima composicion: el modulo\r\n    // queda estatico ahi hasta el proximo Take/Out.\r\n    playFromStart() {\r\n      if (destroyed) return;\r\n      invalidatePendingPlay(); // cualquier turno escalonado viejo deja de ser valido\r\n      const myToken = takeToken;\r\n      clearStaleFrame(); // ver \"clearStaleFrame\" arriba -- antes de pedir turno, no despues\r\n      // La prioridad/tier (CRITICAL/HIGH/NORMAL, ver program/js/\r\n      // take-scheduler.js) se resuelve DENTRO del scheduler a partir del\r\n      // mismo \"moduleId\" -- este archivo no necesita saber a que tier\r\n      // pertenece cada modulo.\r\n      cancelPendingPlay = scheduleTakePlay(moduleId, () => {\r\n        if (destroyed || myToken !== takeToken) return; // Out/Destroy/otro Take mas nuevo ya paso\r\n        // Solo hay un frame viejo que ocultar si el video ya habia avanzado\r\n        // (un WARM recien precalentado arranca en 0 -- nada que ocultar,\r\n        // pintar de inmediato como siempre, cero latencia extra).\r\n        seekPending = video.currentTime > 0.001;\r\n        video.currentTime = 0;\r\n        video.play().catch(() => {});\r\n      });\r\n    },\r\n    // \"cancelPendingTake\" (2026-09-25, Burst/Take Scheduler -- bug real\r\n    // encontrado probando la seccion 7 del pedido, \"cancelacion\"): un Out\r\n    // tiene que invalidar un Take todavia esperando su turno escalonado DE\r\n    // INMEDIATO, sin esperar a que termine la animacion de salida -- el\r\n    // teardown visual (\".gfx\" perdiendo \"is-in\", ver program/js/main.js)\r\n    // esta deliberadamente diferido varios cientos de ms (fade de salida),\r\n    // y ese delay es MAS LARGO que un stagger corto (20-60ms): si la\r\n    // cancelacion dependiera solo de \"holdWarm()\"/\"destroy()\" (que corren\r\n    // recien al final de ese fade), un Take en cola todavia podia ganarle\r\n    // la carrera y arrancar a reproducir brevemente antes de que el modulo\r\n    // terminara de salir. Separado de \"holdWarm()\" a proposito: esto NO\r\n    // toca el video/rAF/RVFC en curso (si ya estaba reproduciendo, sigue\r\n    // igual) -- solo invalida un turno que TODAVIA no arranco.\r\n    cancelPendingTake() {\r\n      invalidatePendingPlay();\r\n    },\r\n    // \"holdWarm\" (2026-09-23, Hot Pool / preload selectivo -- ver informe\r\n    // de auditoria de performance 2026-09-21 y program/js/hot-pool.js):\r\n    // pausa la reproduccion y el ciclo de composicion, IGUAL que la\r\n    // primera mitad de \"destroy()\" de aca abajo, pero sin liberar nada --\r\n    // el <video>, el <canvas>, el contexto WebGL y la textura quedan\r\n    // exactamente como estaban (con el frame ya cargado/decodificado). El\r\n    // llamador (program/js/main.js) usa esto en vez de \"destroy()\" para\r\n    // los modulos del Hot Pool cuando salen del aire: el modulo queda en\r\n    // estado WARM, listo para que el proximo \"playFromStart()\" arranque\r\n    // sin el costo de arranque del decodificador de hardware medido en la\r\n    // auditoria (video recien creado + play() = 100-500ms de frames\r\n    // perdidos; video ya montado/cargado + play() = 0ms). \"destroyed\"\r\n    // NUNCA se pone en true aca -- \"playFromStart()\" y un \"destroy()\"\r\n    // posterior (ej. al cambiar de theme) siguen funcionando normal.\r\n    holdWarm() {\r\n      if (destroyed) return;\r\n      // Invalida cualquier \"playFromStart()\" que todavia estuviera\r\n      // esperando su turno escalonado (seccion 7 del pedido: \"si un modulo\r\n      // esta esperando su slot y antes llega un Out, no debe reproducirse\r\n      // despues\"). Sin esto, un Take que perdio la carrera contra un Out\r\n      // casi inmediato podria disparar \"play()\" sobre un modulo que ya\r\n      // esta WARM/oculto otra vez.\r\n      invalidatePendingPlay();\r\n      if (rafId) {\r\n        cancelAnimationFrame(rafId);\r\n        rafId = null;\r\n      }\r\n      if (vfcId && video.cancelVideoFrameCallback) {\r\n        video.cancelVideoFrameCallback(vfcId);\r\n        vfcId = null;\r\n      }\r\n      video.pause();\r\n    },\r\n    // Libera el ciclo de composicion y el elemento multimedia cuando el\r\n    // modulo termina su salida. El siguiente TAKE crea una estructura y\r\n    // un handle nuevos; nunca reutiliza un video separado del DOM. El\r\n    // contexto WebGL se libera explicitamente (WEBGL_lose_context) en vez\r\n    // de esperar al garbage collector: el navegador limita la cantidad de\r\n    // contextos WebGL vivos por pagina, y este compositor crea uno nuevo\r\n    // en cada TAKE de cada modulo a lo largo de horas de transmision.\r\n    // Devuelve una Promise que resuelve cuando esa liberacion YA ocurrio de\r\n    // verdad (ver \"releasedPromise\" mas arriba) -- opcional de usar, todo\r\n    // llamador que ya invocaba esto en fire-and-forget sigue igual.\r\n    destroy() {\r\n      if (destroyed) return releasedPromise;\r\n      destroyed = true;\r\n      invalidatePendingPlay(); // idem holdWarm() -- ver comentario ahi\r\n      if (rafId) {\r\n        cancelAnimationFrame(rafId);\r\n        rafId = null;\r\n      }\r\n      if (vfcId && video.cancelVideoFrameCallback) {\r\n        video.cancelVideoFrameCallback(vfcId);\r\n        vfcId = null;\r\n      }\r\n      video.removeEventListener('play', handlePlay);\r\n      video.removeEventListener('seeked', handleSeeked);\r\n      if (onEnded) video.removeEventListener('ended', onEnded);\r\n\r\n      // \"video.pause()\" INMEDIATO (2026-09-14, causa real encontrada --\r\n      // pedido explicito del usuario: \"videos que siguen reproduci\u00E9ndose\r\n      // despu\u00E9s de OUT\"). Antes vivia adentro de \"releaseNow()\" mas abajo,\r\n      // diferido junto con la liberacion del contexto WebGL -- pero\r\n      // \"pause()\" (a diferencia de \"removeAttribute('src')\"/\"load()\", que\r\n      // SI necesitan el delay para evitar el parpadeo blanco documentado\r\n      // abajo) no toca el DOM/canvas para nada, es 100% seguro de llamar\r\n      // ya mismo: el canvas de este modulo ya dejo de redibujarse arriba\r\n      // (\"destroyed=true\" antes de esta linea corta \"tick()\"/\r\n      // \"tickOnNewFrame()\" en su proximo chequeo), asi que pausar el\r\n      // decodificador ahora no cambia ni un pixel de lo que se ve -- solo\r\n      // deja de gastar CPU/GPU decodificando un video que ya nadie\r\n      // compone. Sin este cambio, el <video> seguia decodificando cuadros\r\n      // reales hasta 200ms (o 2 frames) DESPUES de sacarse del aire --\r\n      // carga real y evitable, mas notoria cuantos mas modulos se sacan\r\n      // del aire seguido.\r\n      video.pause();\r\n\r\n      // Fix confirmado (2026-08-06, valida el parpadeo blanco global al\r\n      // sacar del aire piezas con MOV -- ver CHANGELOG/historial de la\r\n      // investigacion): la liberacion real del video/contexto WebGL se\r\n      // difiere dos frames (dos requestAnimationFrame anidados) para que\r\n      // corra recien despues de que el modulo ya quedo oculto por el flujo\r\n      // normal (\".gfx.is-hidden\", ver finishOut() en main.js, sin cambios) y\r\n      // de que el navegador haya tenido un par de frames para asentar ese\r\n      // cambio de composicion antes de tocar el decodificador/contexto.\r\n      // \"video\"/\"glCtx\" quedan capturados en el closure de ESTA llamada a\r\n      // createAlphaVideo() (no en una variable compartida del modulo), asi\r\n      // que si el usuario vuelve a hacer TAKE sobre el mismo contenedor\r\n      // antes de que este diferido corra, la instancia nueva crea su propio\r\n      // closure con sus propias referencias via otro createAlphaVideo() y no\r\n      // se pisan entre si.\r\n      //\r\n      // Respaldo con setTimeout: requestAnimationFrame no se ejecuta con\r\n      // pesta\u00F1a oculta/minimizada (throttling del navegador) -- sin esto,\r\n      // el video/contexto de un modulo sacado del aire con la pesta\u00F1a de\r\n      // Program no visible en ese instante quedarian sin liberar nunca. El\r\n      // setTimeout es independiente de rAF (corre igual este oculta o no la\r\n      // pesta\u00F1a) y usa la misma guarda \"released\", asi que cualquiera de\r\n      // los dos caminos que llegue primero libera una unica vez; el que\r\n      // llegue segundo no hace nada.\r\n      let released = false;\r\n      releasedPromise = new Promise((resolve) => {\r\n        function releaseNow() {\r\n          if (released) return;\r\n          released = true;\r\n          // \"video.pause()\" ya corrio arriba, inmediato -- no repetirlo aca.\r\n          video.removeAttribute('src');\r\n          video.load();\r\n          if (glCtx) {\r\n            glCtx.gl.deleteTexture(glCtx.texture);\r\n            glCtx.gl.deleteProgram(glCtx.program);\r\n            glCtx.gl.getExtension('WEBGL_lose_context')?.loseContext();\r\n          }\r\n          resolve();\r\n        }\r\n        requestAnimationFrame(() => requestAnimationFrame(releaseNow));\r\n        setTimeout(releaseNow, 200);\r\n      });\r\n      return releasedPromise;\r\n    },\r\n  };\r\n}\r\n\r\n// Version simple para assets que YA son opacos (sin canal alfa, ej. las\r\n// placas fullscreen o formacion-equipos): un <video> normal alcanza, no hace\r\n// falta el canvas de composicion.\r\n//\r\n// NO pasa por el Burst/Take Scheduler (2026-09-25, ver program/js/\r\n// take-scheduler.js): ningun modulo que use esto hoy forma parte de una\r\n// rafaga medida/probada (son placas fullscreen, casi nunca simultaneas\r\n// entre si) -- agregar el escalonado aca sin un caso real que lo necesite\r\n// y sin poder medirlo seria la complejidad sin beneficio que el pedido\r\n// explicitamente pide evitar. Si en el futuro un modulo de este tipo entra\r\n// a un escenario de rafaga real, aplicar el mismo patron que\r\n// \"createAlphaVideo\" de arriba (token + scheduleTakePlay).\r\nexport function createPlainVideo(el, src, { onEnded } = {}) {\r\n  el.innerHTML = `<video class=\"plain-video\" src=\"${versionedAssetUrl(src)}\" muted playsinline preload=\"auto\"></video>`;\r\n  const video = el.querySelector('.plain-video');\r\n  video.muted = true;\r\n  if (onEnded) video.addEventListener('ended', onEnded);\r\n  let destroyed = false;\r\n\r\n  return {\r\n    playFromStart() {\r\n      if (destroyed) return;\r\n      video.currentTime = 0;\r\n      video.play().catch(() => {});\r\n    },\r\n    // \"holdWarm\" (ver el mismo metodo en createAlphaVideo mas arriba, y\r\n    // program/js/hot-pool.js): ningun modulo del Hot Pool inicial usa\r\n    // \"createPlainVideo\" hoy, se agrega por consistencia/uso futuro.\r\n    holdWarm() {\r\n      if (destroyed) return;\r\n      video.pause();\r\n    },\r\n    destroy() {\r\n      if (destroyed) return;\r\n      destroyed = true;\r\n      if (onEnded) video.removeEventListener('ended', onEnded);\r\n      video.pause();\r\n      video.removeAttribute('src');\r\n      video.load();\r\n    },\r\n  };\r\n}\r\n","EN INSTANTES COMENZAMOS CON EL SORTEO DE EQUIPOS","JUGADOR PRUEBA","/assets/sponsors/SPONSORS%20ZOCALO/CARONE.png","/assets/sponsors/SPONSORS%20ZOCALO/COCACOLA.png","int","SHARED_SEQ_TWO_BYTE_STRING_TYPE","SeqTwoByteString","HOLEY_ELEMENTS","1023","104","SHARED_SEQ_ONE_BYTE_STRING_TYPE","SeqOneByteString","SEQ_TWO_BYTE_STRING_TYPE","SEQ_ONE_BYTE_STRING_TYPE","INTERNALIZED_TWO_BYTE_STRING_TYPE","INTERNALIZED_ONE_BYTE_STRING_TYPE","EXTERNAL_INTERNALIZED_TWO_BYTE_STRING_TYPE","ExternalString","EXTERNAL_INTERNALIZED_ONE_BYTE_STRING_TYPE","UNCACHED_EXTERNAL_INTERNALIZED_TWO_BYTE_STRIN