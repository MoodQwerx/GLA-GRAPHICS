te","innerWidth","set playbackRate","ResizeObserver","CF TEAM","set parentNode","align","scissor","set childNodes","kickLocal3OffsetY","rank","globalCompositeOperation","HTMLFormControlsCollection","get attributionSrc","get onprerenderingchange","AnimationTrigger","get menubar","CSSPseudoElement","alpha-video","gMasA","HTMLTableCellElement","IMG_SRC","snapshots","Set.prototype.forEach","set self","String.prototype.toString","BlobEvent","STATUS_MAX_FONT","get composed","MISSED","blink","__lookupSetter__","HTMLOutputElement","GamepadEvent","set autocapitalize","/assets/themes/argentina-streamers/mosca/mosca-localstrike-alpha.mp4","SVGFEImageElement","GPUDevice","get onbeforecopy","STENCIL_BACK_VALUE_MASK","onpointerrawupdate","STENCIL_BACK_REF","visitanteCrestScale","arrayBufferConstructor_DoNotInitialize","getModuleAssets","set classList","set onload","ariaPlaceholder","intersection","status","Segmenter String Iterator","socket","PromiseReject","NAME_MAX_WIDTH_B","filasParaPagina","set ariaValueText","SVGFEDistantLightElement","PaymentResponse","Torque assert 'value != PromiseHole' failed [src/builtins/promise-all-element-closure.tq:15]","encodeURI","bottom-center","get ondragend","toPrecision","oncontextrestored","set crypto","set bgColor","getFunction","golesAwayCrestOffsetY","accessKey","../../../shared/sponsors.js","Equipo","/assets/","WebSocketError","HTMLAudioElement","get currentTime","10:00","SVGPoint","confirm","../text-fit.js","AudioContext","SpeechRecognitionPhrase","get onresourcetimingbufferfull","lastVh","set sizeAdjust","set srcObject","onbeforeinput","get ariaControlsElements","Audio","set ariaActiveDescendantElement","get onpointerover","NETWORK_NO_SOURCE","set onanimationend","drawingBufferFormat","tick","scheduleExitCleanup","/assets/marcador/marcador-entretiempo-alpha.mp4","/assets/placas/estrellas-alpha.mp4","SourceBuffer","getElementsByTagNameNS","Array.prototype.findLastIndex","timer","VERTEX_ATTRIB_ARRAY_BUFFER_BINDING","AnimationEvent","exitPictureInPicture","BackgroundFetchManager","startsWith","./historial.js","String.prototype.toLowerCase","invoker","Boolean.prototype.valueOf","PressureObserver","entryType","estadoFullscreen","get autofocus","DurationFormat","WebGLTransformFeedback","TEAM_MAX_FONT","String.prototype.sup","SHADING_LANGUAGE_VERSION","get classList","./tarjeta.js","http://127.0.0.1:4430/program/js/main.js?v=10","import { MODULES, MODULE_IDS } from '../../shared/modules.js';\r\nimport { WS_MSG, MODULE_STATUS } from '../../shared/constants.js';\r\nimport { connect } from '../../shared/ws-client.js';\r\nimport { renderers } from './renderers/index.js';\r\nimport { updateLocalTeamCatalog } from '../../shared/teams.js';\r\nimport { initStageScale } from './stage-scale.js';\r\nimport { waitForProgramFonts } from './program-fonts.js';\r\nimport { setActiveThemeId as setRendererActiveThemeId, getActiveThemeId as getRendererActiveThemeId } from './theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../shared/themes.js';\r\nimport { applyComposition, applyElementAdjustRegistry } from './visual-compose.js';\r\nimport { setAssetVersions } from './asset-versions.js';\r\nimport { modulesUsingPath } from '../../shared/asset-registry.js';\r\nimport {\r\n  HOT_MODULE_IDS, HOT_VARIANT_FIELD, isHotModule, MAX_WARM_SLOTS,\r\n  trackWarm, markPlaying, markWarm, untrack, listEvictable, snapshot as hotPoolSnapshot,\r\n} from './hot-pool.js';\r\nimport {\r\n  TAKE_BURST_WINDOW_MS, TAKE_STAGGER_MS, TAKE_MAX_STAGGER_MS,\r\n  HIGH_STAGGER_MS, HIGH_MAX_STAGGER_MS, HIGH_PRIORITY_IDS, CRITICAL_MODULE_IDS,\r\n  setSchedulerDebug, configureScheduler, getSchedulerConfig,\r\n} from './take-scheduler.js';\r\n\r\n// THEME ACTIVO (2026-08-20/21, sistema multi-theme, pedido expl\u00EDcito): se\r\n// recibe por WS igual que cualquier otro estado global (secci\u00F3n 8, \"no\r\n// quiero tener que refrescar Browser Source\"). \"theme-client.js\" es la\r\n// fuente de verdad real que consultan los renderers (program/js/\r\n// theme-assets.js) para resolver su asset -- ac\u00E1 solo se la mantiene\r\n// actualizada en cada mensaje.\r\n\r\ninitStageScale(document.getElementById('stage'));\r\nawait waitForProgramFonts();\r\n\r\nif (new URLSearchParams(window.location.search).get('debug') === '1') {\r\n  import('./debug-diagnostics.js')\r\n    .then(({ initProgramDiagnostics }) => initProgramDiagnostics(document.getElementById('stage')))\r\n    .catch((error) => console.error('[GLA DEBUG] No se pudo iniciar el diagnostico:', error));\r\n}\r\n\r\nconst els = {};\r\nconst tickers = {};\r\nconst latestData = {};\r\n// \"confirmedData\" (2026-08-19, auditor\u00EDa completa pedida por el usuario:\r\n// \"cuando toco flechitas/+/\u2212 el cambio tiene que verse EN VIVO INMEDIATO,\r\n// sin apretar ACTUALIZAR -- pero el CONTENIDO sigue esperando ACTUALIZAR\").\r\n// Guarda, por m\u00F3dulo, el \u00DALTIMO \"data\" que realmente se pint\u00F3 en pantalla\r\n// (por Take o por ACTUALIZAR expl\u00EDcito) -- es la base \"congelada\" de\r\n// contenido sobre la que se superponen los ajustes visuales en vivo, ver\r\n// \"mergeVisualFields\" m\u00E1s abajo.\r\nconst confirmedData = {};\r\nconst lastStatus = {};\r\nconst exitCleanupTimers = {};\r\n// Estado del secuenciado asset -> contenido de los modulos \"sequencedReveal\"\r\n// (ver shared/modules.js): contentRevealed guarda si \".gfx-overlay\" deberia\r\n// estar visible ahora mismo (independiente de si ya se aplico la clase),\r\n// contentRevealTimers el timer pendiente que la va a revelar tras Tomar al\r\n// aire, y contentExitTimers el timer que espera a que el contenido termine\r\n// de ocultarse antes de recien ahi sacar el asset.\r\nconst contentRevealed = {};\r\nconst contentRevealTimers = {};\r\nconst contentExitTimers = {};\r\n\r\n// Desmontaje compartido de cualquier renderer. Los renderers guardan sus\r\n// handles sobre el nodo \".content\" para no reconstruir video/canvas en cada\r\n// UPDATE o tick. Si se vacia solo el innerHTML, esos handles quedan vivos y\r\n// el siguiente TAKE cree que la estructura todavia existe aunque ya no haya\r\n// nodos para actualizar. El teardown elimina ambas partes juntas: recursos y\r\n// marca de montaje. Asi cada ciclo OUT deja el modulo listo para un TAKE nuevo.\r\n// \"moduleId\" + \"{ force }\" (2026-09-23, Hot Pool -- ver program/js/\r\n// hot-pool.js): para un modulo de la lista Hot Pool, sacarlo del aire NO\r\n// debe destruir video/canvas/contexto -- eso es exactamente el costo que\r\n// la auditoria de performance identifico como el causante del hitch en\r\n// cada TAKE (video recien creado + play() = 100-500ms perdidos; video ya\r\n// montado/cargado + play() = ~0ms). En vez de \"destroy()\" se llama\r\n// \"holdWarm()\" (pausa, sin liberar nada) y se sale ANTES de tocar\r\n// intervals/dataset/innerHTML -- el modulo queda WARM, listo para el\r\n// proximo Take. \"force:true\" salta este atajo (usado al cambiar de theme,\r\n// donde el asset del theme viejo ya no sirve y hay que reconstruir de\r\n// cero para el nuevo) y en la expulsion del Resource Manager\r\n// (enforceWarmBudget) cuando hay que liberar un slot de verdad.\r\n// Devuelve la Promise de \"destroy()\" (ver program/js/alpha-video.js) --\r\n// resuelve cuando el contexto WebGL/video del modulo YA se liberaron de\r\n// verdad, no un numero de ms supuesto. \"undefined\" en cualquier otro caso\r\n// (modulo hot preservado en WARM, o modulo sin \"_alphaVideo\") -- el\r\n// llamador la usa con Promise.all(), que trata \"undefined\" como un valor\r\n// ya resuelto, asi que no hace falta distinguir el caso en cada call site.\r\nfunction teardownContent(content, moduleId, { force = false } = {}) {\r\n  if (!force && isHotModule(moduleId) && content._gfxBuilt) {\r\n    content._alphaVideo?.holdWarm?.();\r\n    content._plainVideo?.holdWarm?.();\r\n    if (moduleId) markWarm(moduleId);\r\n    return undefined;\r\n  }\r\n\r\n  if (content._clockInterval) {\r\n    clearInterval(content._clockInterval);\r\n    delete content._clockInterval;\r\n  }\r\n\r\n  if (content._sponsorRotationInterval) {\r\n    clearInterval(content._sponsorRotationInterval);\r\n    delete content._sponsorRotationInterval;\r\n  }\r\n\r\n  let releasedPromise;\r\n  if (content._alphaVideo) {\r\n    releasedPromise = content._alphaVideo.destroy?.();\r\n    delete content._alphaVideo;\r\n  }\r\n\r\n  if (content._plainVideo) {\r\n    content._plainVideo.destroy?.();\r\n    delete content._plainVideo;\r\n  }\r\n\r\n  // \"_gfxBuilt\" (2026-08-21, sistema multi-theme): marca \"ya arm\u00E9 la\r\n  // estructura\" que usan los renderers migrados a theme-assets.js en vez\r\n  // de \"_alphaVideo\" (que ahora puede ser leg\u00EDtimamente null cuando el\r\n  // theme activo no tiene ese asset todav\u00EDa). Si no se borra ac\u00E1, un\r\n  // renderer creer\u00EDa que el DOM ya est\u00E1 armado despu\u00E9s de un teardown y\r\n  // se saltear\u00EDa \"buildStructure()\" sobre un innerHTML vac\u00EDo.\r\n  delete content._gfxBuilt;\r\n\r\n  for (const key of Object.keys(content.dataset)) {\r\n    delete content.dataset[key];\r\n  }\r\n\r\n  content.innerHTML = '';\r\n  if (moduleId) untrack(moduleId);\r\n  return releasedPromise;\r\n}\r\n\r\nfunction cancelExitCleanup(id) {\r\n  if (exitCleanupTimers[id]) {\r\n    clearTimeout(exitCleanupTimers[id]);\r\n    delete exitCleanupTimers[id];\r\n  }\r\n}\r\n\r\nfunction timeToMs(value) {\r\n  const trimmed = value.trim();\r\n  if (trimmed.endsWith('ms')) return parseFloat(trimmed) || 0;\r\n  if (trimmed.endsWith('s')) return (parseFloat(trimmed) || 0) * 1000;\r\n  return 0;\r\n}\r\n\r\n// Duraciones compartidas del secuenciado asset -> contenido (ver\r\n// --dur-content-delay/--dur-content en program/css/theme.css y\r\n// program/css/overlay.css): se leen del CSS en vez de hardcodear los\r\n// mismos numeros aca, para que tocar el CSS siga siendo la unica fuente de\r\n// verdad de estos tiempos. --dur-content-delay se lee POR MODULO (no una\r\n// sola vez de \":root\"): cada asset con movimiento horneado se asienta en un\r\n// tiempo real distinto (medido con diff de frames reales, ver CHANGELOG.md),\r\n// asi que cada \"#mod-<id>\" en overlay.css define su propio valor \u2014 un\r\n// zocalo rapido no tiene por que esperar lo mismo que una placa grande. Si\r\n// un modulo \"sequencedReveal\" no define el suyo, hereda el default de\r\n// \":root\" (fallback conservador). --dur-content (velocidad del propio\r\n// fundido del contenido, entrada y salida) si es un unico valor compartido:\r\n// no hay evidencia de que necesite variar por modulo.\r\nconst rootStyle = getComputedStyle(document.documentElement);\r\nconst CONTENT_FADE_MS = timeToMs(rootStyle.getPropertyValue('--dur-content'));\r\n\r\nfunction isSequenced(id) {\r\n  return !!MODULES[id].sequencedReveal;\r\n}\r\n\r\n// AJUSTES VISUALES EN VIVO (2026-08-19, auditor\u00EDa completa pedida por el\r\n// usuario: \"cuando toco flechitas/+/\u2212 el cambio tiene que verse EN VIVO\r\n// INMEDIATO... ACTUALIZAR sigue existiendo para contenido/datos, pero los\r\n// AJUSTES VISUALES deben ser live... No mezclar ambas cosas\").\r\n//\r\n// Causa real de que esto NO fuera live: cualquier UPDATE mientras el\r\n// m\u00F3dulo est\u00E1 al aire y NO es \"isExplicitUpdate\" (Take real o clic en\r\n// ACTUALIZAR) se ignora por completo m\u00E1s abajo -- ver el \"if (isOn &&\r\n// msg.isAutoSave...)\" del handler de mensajes -- para no mostrar tipeo a\r\n// medio escribir. Eso es correcto para CONTENIDO, pero de paso tambi\u00E9n\r\n// bloqueaba composici\u00F3n/textAdjust, que es lo que arreglan estas dos\r\n// funciones: \"isVisualKey\" identifica, por NOMBRE de campo (la misma\r\n// convenci\u00F3n que ya usa todo el proyecto: \"compositionOffsetX/Y/Scale\",\r\n// \"motivoOffsetX/Y/Scale\" en VAR, \"offsetX/Y/scale\" por z\u00F3calo en Placa L\r\n// Info, y \"textAdjust\" en cualquier m\u00F3dulo), qu\u00E9 campos son ajuste visual\r\n// puro. \"mergeVisualFields\" arma un objeto que combina el \u00DALTIMO contenido\r\n// realmente confirmado (congelado) con los valores visuales M\u00C1S RECIENTES\r\n// del draft -- as\u00ED se puede volver a invocar el mismo renderer del m\u00F3dulo\r\n// sin repintar ning\u00FAn texto todav\u00EDa no confirmado por ACTUALIZAR, solo su\r\n// posici\u00F3n/tama\u00F1o. Centralizado ac\u00E1 (no en cada renderer ni en cada panel\r\n// de Master Control) porque es el \u00FAnico punto por el que pasan todos los\r\n// m\u00F3dulos por igual.\r\nfunction isVisualKey(key) {\r\n  return key === 'textAdjust' || /OffsetX$/i.test(key) || /OffsetY$/i.test(key) || /Scale$/i.test(key);\r\n}\r\n\r\nfunction mergeVisualFields(confirmed, incoming) {\r\n  if (!incoming || typeof incoming !== 'object' || Array.isArray(incoming)) return confirmed;\r\n  const base = (confirmed && typeof confirmed === 'object') ? confirmed : {};\r\n  const out = { ...base };\r\n  for (const [key, value] of Object.entries(incoming)) {\r\n    if (isVisualKey(key)) {\r\n      out[key] = value;\r\n    } else if (value && typeof value === 'object' && !Array.isArray(value)) {\r\n      out[key] = mergeVisualFields(base[key], value);\r\n    }\r\n    // cualquier otro campo (contenido) se queda con el valor de \"confirmed\"\r\n    // que ya trae \"{ ...base }\" -- nunca se pisa con lo que hay en el draft.\r\n  }\r\n  return out;\r\n}\r\n\r\n// Repinta SOLO composici\u00F3n + textAdjust de un m\u00F3dulo ya al aire, con el\r\n// contenido congelado en su \u00FAltimo valor confirmado -- se llama en cada\r\n// UPDATE en vivo mientras el m\u00F3dulo est\u00E1 ON y todav\u00EDa no lleg\u00F3 su\r\n// ACTUALIZAR expl\u00EDcito (ver handler de mensajes m\u00E1s abajo). No pasa por\r\n// \"applyModuleState\" a prop\u00F3sito: eso re-disparar\u00EDa animaciones de\r\n// entrada/revelado de secuenciado, que no corresponden ac\u00E1 (no es un Take).\r\nfunction applyVisualLive(id, data) {\r\n  const target = els[id];\r\n  if (!target) return;\r\n  applyComposition(target, data, id, latestData);\r\n  applyElementAdjustRegistry(id, target, data, latestData);\r\n  const merged = mergeVisualFields(confirmedData[id], data);\r\n  renderers[id](target.content, merged, false, () => handleOneShotEnded(id), latestData);\r\n}\r\n\r\nfunction cancelContentReveal(id) {\r\n  if (contentRevealTimers[id]) {\r\n    clearTimeout(contentRevealTimers[id]);\r\n    delete contentRevealTimers[id];\r\n  }\r\n}\r\n\r\nfunction cancelContentExit(id) {\r\n  if (contentExitTimers[id]) {\r\n    clearTimeout(contentExitTimers[id]);\r\n    delete contentExitTimers[id];\r\n  }\r\n}\r\n\r\n// querySelectorAll (no querySelector): la mayoria de los modulos tiene un\r\n// unico \".gfx-overlay\", pero algunos (ej. Marcador de Penales, que ademas\r\n// tiene una capa de indicadores de penales por DETRAS del video) tienen mas\r\n// de uno \u2014 los dos tienen que revelarse/ocultarse juntos, o el segundo\r\n// quedaria con opacity:0 para siempre.\r\nfunction setContentVisible(target, visible) {\r\n  const overlays = target.content.querySelectorAll('.gfx-overlay');\r\n  overlays.forEach((overlay) => overlay.classList.toggle('content-in', visible));\r\n}\r\n\r\nfunction exitTransitionMs(root) {\r\n  const style = getComputedStyle(root);\r\n  const durations = style.transitionDuration.split(',').map(timeToMs);\r\n  const delays = style.transitionDelay.split(',').map(timeToMs);\r\n  const count = Math.max(durations.length, delays.length);\r\n  let max = 0;\r\n  for (let i = 0; i < count; i++) {\r\n    max = Math.max(max, durations[i % durations.length] + delays[i % delays.length]);\r\n  }\r\n  return max;\r\n}\r\n\r\nfunction finishOut(id) {\r\n  const target = els[id];\r\n  if (!target || target.root.classList.contains('is-in')) return;\r\n  cancelExitCleanup(id);\r\n  target.root.classList.add('is-hidden');\r\n  teardownContent(target.content, id);\r\n  if (pendingAssetReload.delete(id)) rebuildModuleAssets(id);\r\n}\r\n\r\n// RECURSO GR\u00C1FICO / RECARGAR (SOFTX): un archivo reemplazado se vuelve a\r\n// montar con su URL nueva sin mandar nada al aire. Si el m\u00F3dulo est\u00E1 al aire\r\n// (o saliendo), se espera a que termine de salir: el pr\u00F3ximo TAKE ya usa el\r\n// recurso nuevo y la salida en curso nunca se corta.\r\nconst pendingAssetReload = new Set();\r\n\r\nfunction rebuildModuleAssets(id) {\r\n  const target = els[id];\r\n  if (!target) return;\r\n  const content = target.content;\r\n  const wasWarm = isHotModule(id) && content._gfxBuilt;\r\n  teardownContent(content, id, { force: true });\r\n  if (!wasWarm) return;\r\n  const data = latestData[id] || {};\r\n  renderers[id](content, data, false, () => handleOneShotEnded(id), latestData);\r\n  const field = HOT_VARIANT_FIELD[id];\r\n  trackWarm(id, id, field ? data[field] : undefined);\r\n}\r\n\r\nfunction reloadAssetsForPaths(paths) {\r\n  const systemId = getRendererActiveThemeId();\r\n  const ids = new Set(paths.flatMap((assetPath) => modulesUsingPath(systemId, assetPath)));\r\n  for (const id of ids) {\r\n    const target = els[id];\r\n    if (!target) continue;\r\n    const busy = lastStatus[id] === MODULE_STATUS.ON || !target.root.classList.contains('is-hidden');\r\n    if (busy) pendingAssetReload.add(id);\r\n    else rebuildModuleAssets(id);\r\n  }\r\n}\r\n\r\n// transitionend no esta garantizado si una transicion se interrumpe muchas\r\n// veces con comandos IN/OUT consecutivos. Se conserva como camino normal y\r\n// se agrega un fallback apenas despues de la duracion CSS real. Un TAKE nuevo\r\n// cancela este timer antes de volver a montar/mostrar el modulo.\r\nfunction scheduleExitCleanup(id) {\r\n  cancelExitCleanup(id);\r\n  const target = els[id];\r\n  if (target.root.classList.contains('is-hidden')) {\r\n    finishOut(id);\r\n    return;\r\n  }\r\n  exitCleanupTimers[id] = setTimeout(() => {\r\n    finishOut(id);\r\n  }, exitTransitionMs(target.root) + 100);\r\n}\r\n\r\nfor (const id of MODULE_IDS) {\r\n  const root = document.getElementById(`mod-${id}`);\r\n  if (!root) {\r\n    console.warn(`[GLA] Contenedor DOM para el m\u00F3dulo no encontrado en index.html: mod-${id}. Ignorado.`);\r\n    continue;\r\n  }\r\n  const content = root.querySelector('.content');\r\n  els[id] = { root, content };\r\n\r\n  // Marca, al arrancar, que clase CSS (\"sequenced\" en overlay.css) tiene\r\n  // que secuenciar su contenido -- asi program/index.html y cada renderer\r\n  // no necesitan saber nada de este mecanismo. El delay puntual\r\n  // (--dur-content-delay) YA NO se lee aca: para \"marcadorPenales\" (unico\r\n  // modulo con un valor DISTINTO por theme, ver overlay.css) leerlo en\r\n  // este punto devolvia el valor de GLA -- en el arranque de la pagina\r\n  // \"document.body.dataset.theme\" todavia no existe (el WS ni siquiera\r\n  // conecto), asi que \"body[data-theme='argentinaStreamers'] #mod-...\"\r\n  // nunca podia matchear y el override quedaba cacheado como si nunca\r\n  // hubiera existido (bug real, encontrado 2026-09-01 con un\r\n  // MutationObserver midiendo el timing en vivo: revelaba a ~300ms en vez\r\n  // de los 700ms configurados). Se lee fresco en cada Take en vez -- ver\r\n  // \"getComputedStyle(target.root)...\" mas abajo.\r\n  if (MODULES[id].sequencedReveal) {\r\n    root.classList.add('sequenced');\r\n  }\r\n\r\n  // Al terminar la transicion de salida (opacity llega a 0), recien ahi\r\n  // ocultamos el nodo del todo y limpiamos el contenido.\r\n  root.addEventListener('transitionend', (event) => {\r\n    if (event.propertyName !== 'opacity') return;\r\n    if (!root.classList.contains('is-in')) {\r\n      finishOut(id);\r\n    }\r\n  });\r\n}\r\n\r\n// \"mergeVisualFields(confirmedData[id], latestData[id])\" en vez de\r\n// \"latestData[id]\" a secas (2026-09-02, causa real de que texto1/texto2 de\r\n// Z\u00F3calo Compuesto con Equipos/Logo se vieran al aire ANTES de apretar\r\n// ACTUALIZAR): este ticker existe para que un m\u00F3dulo \"live:true\" (ej.\r\n// escudos/nombres que dependen de \"scoreboard\") se repinte solo cuando\r\n// cambia esa data EXTERNA -- que llega siempre por el 5to argumento\r\n// (\"latestData\", sin tocar ac\u00E1), nunca por el 2do (\"data\", el propio\r\n// estado del m\u00F3dulo). Pasarle \"latestData[id]\" crudo como 2do argumento\r\n// respond\u00EDa bien a eso, pero de paso tambi\u00E9n volv\u00EDa a pintar CUALQUIER\r\n// autosave de contenido sin confirmar (isAutoSave, ver el handler de\r\n// WS_MSG.MODULE_UPDATE m\u00E1s abajo) cada 500ms, pisando por completo la\r\n// protecci\u00F3n de \"applyVisualLive\"/\"isVisualKey\" que ya exist\u00EDa para el\r\n// mensaje en s\u00ED. Con el merge, el 2do argumento vuelve a ser\r\n// \"contenido congelado + visual m\u00E1s reciente\" -- exactamente lo mismo que\r\n// ya usa \"applyVisualLive\" -- as\u00ED que ning\u00FAn m\u00F3dulo \"live\" pierde su\r\n// reactividad a \"scoreboard\" (sigue viniendo del 5to argumento), solo se\r\n// deja de repintar contenido todav\u00EDa no confirmado.\r\nfunction startTicker(id) {\r\n  if (tickers[id]) return;\r\n  tickers[id] = setInterval(() => {\r\n    const data = mergeVisualFields(confirmedData[id], latestData[id]);\r\n    renderers[id](els[id].content, data, false, undefined, latestData);\r\n    // ESCUDO POR EQUIPO (2026-10-09, bug real corregido, SOLO Argentina\r\n    // Streamers): si el equipo cambia en el Marcador con este modulo al\r\n    // aire, el repintado de arriba cambia el escudo pero la posicion/escala\r\n    // propia de ese equipo (\"crestByTeam\") recien se aplicaba con el\r\n    // proximo cambio del modulo -- quedaba la geometria del equipo\r\n    // anterior. Se reaplica en el mismo tick que el escudo.\r\n    if (getRendererActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID) {\r\n      applyElementAdjustRegistry(id, els[id], data, latestData);\r\n    }\r\n  }, 500);\r\n}\r\n\r\nfunction stopTicker(id) {\r\n  if (tickers[id]) {\r\n    clearInterval(tickers[id]);\r\n    tickers[id] = null;\r\n  }\r\n}\r\n\r\n// Los modulos \"oneShot\" (ver shared/modules.js) traen su propia animacion de\r\n// entrada Y salida adentro del video (ej. un festejo de gol, una transicion).\r\n// Cuando el video termina, el renderer llama a esta funcion para avisarle al\r\n// servidor que el modulo tiene que volver a OUT solo \u2014 asi el estado que ve\r\n// el Master Control (EN AIRE / FUERA) siempre coincide con lo que se ve\r\n// realmente en el render, sin que el operador tenga que apretar Sacar.\r\nlet ws;\r\nfunction handleOneShotEnded(id) {\r\n  ws.send({ type: WS_MSG.OUT, moduleId: id });\r\n}\r\n\r\n// GOL SIGUE AL MARCADOR (2026-10-21, SOLO GLA -- ver\r\n// composedCompositionData en program/js/visual-compose.js): cada vez que\r\n// cambia el Marcador se recalcula la composicion de GOL, este al aire o no\r\n// (queda lista para el proximo disparo y, si se esta reproduciendo, lo\r\n// acompa\u00F1a en vivo). Solo cambia el transform: no toca el video.\r\nfunction syncGolComposition() {\r\n  if (!els.gol || !latestData.gol) return;\r\n  applyComposition(els.gol, latestData.gol, 'gol', latestData);\r\n}\r\n\r\nfunction applyModuleState(id, moduleState) {\r\n  const target = els[id];\r\n  if (!target || !moduleState) return;\r\n\r\n  latestData[id] = moduleState.data;\r\n  confirmedData[id] = moduleState.data;\r\n  applyComposition(target, moduleState.data, id, latestData);\r\n  const sequenced = isSequenced(id);\r\n\r\n  if (moduleState.status === MODULE_STATUS.ON) {\r\n    cancelExitCleanup(id);\r\n    // \"justTaken\": recien paso de OUT a ON en esta misma actualizacion (un\r\n    // Take real, no un tick de reloj ni una Actualizacion en caliente). Solo\r\n    // en ese caso algunos renderers (ej. el Marcador) reproducen su animacion\r\n    // de entrada desde el principio.\r\n    const justTaken = lastStatus[id] !== MODULE_STATUS.ON;\r\n\r\n    // Hot Pool: marca el slot como PLAYING (nunca se expulsa mientras lo\r\n    // est\u00E9, ver listEvictable en hot-pool.js) apenas el m\u00F3dulo pasa a ON,\r\n    // sea porque ya estaba WARM (el caso com\u00FAn) o porque nunca pas\u00F3 por el\r\n    // pool -- trackWarm()/markPlaying() con la misma key (\"id\") no rompen\r\n    // nada si la key todav\u00EDa no exist\u00EDa en el registro.\r\n    if (isHotModule(id)) markPlaying(id);\r\n\r\n    if (sequenced && justTaken) {\r\n      // Ciclo nuevo: cancela cualquier revelado/salida pendiente de un\r\n      // ciclo anterior y arranca oculto otra vez \u2014 el contenido no debe\r\n      // verse hasta que el asset termine de asentarse.\r\n      cancelContentReveal(id);\r\n      cancelContentExit(id);\r\n      contentRevealed[id] = false;\r\n    }\r\n\r\n    // 5to argumento: snapshot de datos de TODOS los modulos (misma\r\n    // referencia que latestData). Solo lo usa marcadorEntretiempo hoy,\r\n    // para leer en vivo los datos de \"scoreboard\" sin duplicarlos.\r\n    renderers[id](target.content, moduleState.data, justTaken, () => handleOneShotEnded(id), latestData);\r\n    // Despues de \"renderers[id]\" a proposito (no junto a \"applyComposition\"\r\n    // mas arriba): en un TAKE recien ahi existen los nodos \"[data-adjust]\"\r\n    // que el renderer acaba de construir -- ver applyVisualLive() mas\r\n    // arriba para el caso \"modulo ya al aire\", donde el orden inverso es\r\n    // correcto porque la estructura ya existia de antes.\r\n    applyElementAdjustRegistry(id, target, moduleState.data, latestData);\r\n\r\n    if (sequenced) {\r\n      // Autocurativo: algunos renderers reconstruyen \".gfx-overlay\" en un\r\n      // UPDATE que cambia de variante (ej. Tarjeta cambia de color, VS\r\n      // cambia de renglon) sin que sea un Take nuevo \u2014 si el contenido ya\r\n      // estaba revelado, el nodo reconstruido tiene que heredar ese estado\r\n      // en vez de quedar oculto esperando un Take que no va a llegar.\r\n      setContentVisible(target, contentRevealed[id] === true);\r\n      if (justTaken) {\r\n        // Leido FRESCO en cada Take (no cacheado al arrancar la pagina,\r\n        // ver comentario en el \"for\" de mas arriba) -- para\r\n        // \"marcadorPenales\" esto resuelve el valor correcto segun el\r\n        // theme activo EN ESTE MOMENTO (\"body[data-theme='...']\" ya esta\r\n        // seteado para cualquier Take real, a diferencia del arranque).\r\n        const delayMs = timeToMs(getComputedStyle(target.root).getPropertyValue('--dur-content-delay'));\r\n        contentRevealTimers[id] = setTimeout(() => {\r\n          delete contentRevealTimers[id];\r\n          contentRevealed[id] = true;\r\n          setContentVisible(target, true);\r\n        }, delayMs);\r\n      }\r\n    }\r\n\r\n    target.root.classList.remove('is-hidden');\r\n    void target.root.offsetWidth; // fuerza reflow: registra el estado \"afuera\" antes de animar\r\n    target.root.classList.add('is-in');\r\n    if (MODULES[id].live) startTicker(id);\r\n  } else {\r\n    // Burst/Take Scheduler (2026-09-25, seccion 7 del pedido -- ver\r\n    // program/js/take-scheduler.js): cancela YA MISMO un Take que\r\n    // todavia estuviera esperando su turno escalonado, sin esperar a que\r\n    // termine la animacion de salida (--dur-content/--dur-out, mas abajo\r\n    // en esta misma rama, pueden tardar mucho mas que un stagger corto).\r\n    // No toca reproduccion ya en curso -- ver \"cancelPendingTake()\" en\r\n    // alpha-video.js.\r\n    target.content._alphaVideo?.cancelPendingTake?.();\r\n    stopTicker(id);\r\n    if (sequenced) {\r\n      // Orden inverso pedido: primero se apaga el contenido, y solo\r\n      // despues de que termina su propio fundido (--dur-content) se saca\r\n      // el asset \u2014 asi nunca queda texto/escudo flotando sin fondo.\r\n      cancelContentReveal(id);\r\n      cancelContentExit(id);\r\n      contentRevealed[id] = false;\r\n      setContentVisible(target, false);\r\n      contentExitTimers[id] = setTimeout(() => {\r\n        delete contentExitTimers[id];\r\n        target.root.classList.remove('is-in');\r\n        scheduleExitCleanup(id);\r\n      }, CONTENT_FADE_MS);\r\n    } else {\r\n      target.root.classList.remove('is-in');\r\n      scheduleExitCleanup(id);\r\n    }\r\n  }\r\n\r\n  lastStatus[id] = moduleState.status;\r\n}\r\n\r\nlet lastKnownThemeId = null;\r\n\r\n// HOT POOL: precalienta (COLD -> WARM) los modulos de HOT_MODULE_IDS que\r\n// esten apagados y todavia sin construir -- ver program/js/hot-pool.js\r\n// para el contrato completo. Llamar al renderer normal del modulo con\r\n// \"justTaken=false\" alcanza: el mismo guard \"if (!contentEl._gfxBuilt)\r\n// buildStructure(...)\" que YA tiene cada renderer arma video/canvas/\r\n// contexto (el <video> con preload=\"auto\" empieza a cargar solo) y NUNCA\r\n// llama a \"playFromStart()\" salvo que justTaken sea true o cambie la\r\n// variante (ver el fix de \"*Changed\" en program/js/renderers/{tarjeta,vs,\r\n// shortDouble,formacionEquipos}.js) -- ninguno de los dos pasa aca, asi\r\n// que el video queda cargado y PAUSADO: WARM, no PLAYING. Se llama\r\n// despues de procesar un STATE_SNAPSHOT completo (arranque de Program, o\r\n// tras un cambio de theme que ya forz\u00F3 el teardown de todo, ver mas\r\n// abajo), nunca antes: necesita \"latestData\"/\"els\" ya poblados.\r\nfunction warmHotModules() {\r\n  for (const id of HOT_MODULE_IDS) {\r\n    const target = els[id];\r\n    if (!target) continue;\r\n    if (lastStatus[id] === MODULE_STATUS.ON) continue; // ya esta PLAYING, nada que precargar\r\n    const content = target.content;\r\n    if (content._gfxBuilt) continue; // ya WARM (idempotente: boot + cada cambio de theme llaman esto)\r\n    const data = latestData[id] || {};\r\n    renderers[id](content, data, false, () => handleOneShotEnded(id), latestData);\r\n    const field = HOT_VARIANT_FIELD[id];\r\n    trackWarm(id, id, field ? data[field] : undefined);\r\n  }\r\n  enforceWarmBudget();\r\n}\r\n\r\n// RESOURCE MANAGER (2026-09-23, pedido explicito del usuario: \"no quiero\r\n// que esta optimizacion termine cargando ilimitadamente VRAM\"): si hay mas\r\n// slots WARM que MAX_WARM_SLOTS, expulsa (destruye de verdad, vuelve a\r\n// COLD) los MENOS usados recientemente -- listEvictable() ya excluye\r\n// cualquier modulo \"playing\" (al aire) y \"gol\" (maxima prioridad, ver\r\n// PROTECTED_MODULE_IDS en hot-pool.js). Con la lista de fabrica esto no\r\n// expulsa nada en operacion normal (el presupuesto ya la cubre entera);\r\n// existe como techo de seguridad real ante una lista mal configurada, y se\r\n// ejercita a proposito en las pruebas de estres del informe.\r\nfunction enforceWarmBudget() {\r\n  for (const id of listEvictable(MAX_WARM_SLOTS)) {\r\n    const target = els[id];\r\n    if (!target) { untrack(id); continue; }\r\n    teardownContent(target.content, id, { force: true });\r\n  }\r\n}\r\n\r\n// HOT POOL + VARIANTES (2026-09-23, pedido explicito del usuario, secci\u00F3n\r\n// 9 -- \"reemplazo seguro cuando cambia variante\"): si el operador cambia\r\n// la variante de un m\u00F3dulo del Hot Pool (ej. el color de Tarjeta) ANTES de\r\n// mandarlo al aire, se reconstruye el WARM con la variante nueva de\r\n// inmediato -- para cuando llegue el Take real ya est\u00E1 lista. Sin esto el\r\n// Take seguir\u00EDa siendo correcto (el fix de \"*Changed\" en el renderer ya lo\r\n// garantiza) pero pagar\u00EDa el hitch de arranque en fr\u00EDo para esa variante\r\n// puntual. No pinta contenido din\u00E1mico (crests/texto): eso lo hace el\r\n// pr\u00F3ximo Take real con los datos vigentes en ese momento.\r\nfunction maybeRewarmOffAirVariant(id, data) {\r\n  const field = HOT_VARIANT_FIELD[id];\r\n  if (!field || !isHotModule(id)) return;\r\n  const target = els[id];\r\n  if (!target) return;\r\n  const content = target.content;\r\n  if (!content._gfxBuilt) return; // todavia no esta WARM -- lo arma warmHotModules() en su momento\r\n  const newVariant = data ? data[field] : undefined;\r\n  if (content.dataset[field] === newVariant) return;\r\n  teardownContent(content, id, { force: true });\r\n  renderers[id](content, data || {}, false, () => handleOneShotEnded(id), latestData);\r\n  trackWarm(id, id, newVariant);\r\n}\r\n\r\n// \"handleStateSnapshot\" (2026-09-26, WebGL context management -- pedido\r\n// explicito: \"1. cancelar Takes pendientes; 2. detener reproducci\u00F3n del\r\n// theme viejo; 3. liberar recursos/contextos del theme viejo; 4. confirmar\r\n// que baj\u00F3 la cantidad de contextos vivos; 5. reci\u00E9n entonces comenzar el\r\n// warm-up del theme nuevo... no crear primero los nuevos y destruir los\r\n// viejos 200ms despu\u00E9s\"). Antes, \"warmHotModules()\" corr\u00EDa en la MISMA\r\n// vuelta sincr\u00F3nica que el teardown forzado -- pero la liberaci\u00F3n real del\r\n// contexto WebGL de \"destroy()\" est\u00E1 deliberadamente diferida (2 rAF o\r\n// 200ms, ver program/js/alpha-video.js, fix del parpadeo blanco) para NO\r\n// tocar el decodificador/contexto hasta que el navegador asent\u00F3 el cambio\r\n// visual. Con Hot Pool (~9-10 contextos siempre vivos) eso significaba que\r\n// \"warmHotModules()\" creaba los ~9 contextos del theme NUEVO ANTES de que\r\n// los ~9 del theme VIEJO llegaran a liberarse -- pico real de hasta ~18,\r\n// justo el warning \"Too many active WebGL contexts\" confirmado en la\r\n// auditor\u00EDa anterior. Ahora se espera la Promise real de cada\r\n// \"destroy()\" (resuelve exactamente cuando ese release ya ocurri\u00F3, no un\r\n// n\u00FAmero de ms supuesto -- ver \"releasedPromise\" en alpha-video.js) antes\r\n// de tocar nada del theme nuevo: determinista, sin adivinar un timeout.\r\n//\r\n// \"async\" es seguro ac\u00E1 porque el propio \"pendingSnapshotChain\" (ver mas\r\n// abajo, en el listener real) serializa las llamadas -- si dos\r\n// STATE_SNAPSHOT llegaran muy seguidos (dos cambios de theme r\u00E1pidos), el\r\n// segundo espera a que el primero termine su propio await antes de\r\n// empezar, en vez de interlazarse.\r\nasync function handleStateSnapshot(msg) {\r\n  // El theme se fija ANTES de recorrer los m\u00F3dulos: cada renderer\r\n  // resuelve su asset (program/js/theme-assets.js) leyendo el theme\r\n  // activo en el momento exacto en que se lo vuelve a invocar ac\u00E1.\r\n  const themeChanged = msg.theme && lastKnownThemeId !== null && msg.theme !== lastKnownThemeId;\r\n  if (msg.theme) {\r\n    setRendererActiveThemeId(msg.theme);\r\n    lastKnownThemeId = msg.theme;\r\n  }\r\n  if (themeChanged) {\r\n    // Cambio de theme real (no la conexi\u00F3n inicial): un m\u00F3dulo que YA\r\n    // est\u00E1 montado (\".av-target\"/\"._alphaVideo\" construidos con el\r\n    // asset del theme ANTERIOR) no se reconstruye solo -- cada\r\n    // renderer solo arma su estructura una vez (\"if (!contentEl.\r\n    // _alphaVideo) buildStructure(...)\"). Se fuerza un teardown+\r\n    // rebuild ac\u00E1, centralizado, para que el asset (o su ausencia) del\r\n    // theme NUEVO se vuelva a resolver -- sin tocar la l\u00F3gica interna\r\n    // de ning\u00FAn renderer.\r\n    const releasePromises = [];\r\n    for (const id of MODULE_IDS) {\r\n      // \"force:true\": un cambio de theme real invalida el asset\r\n      // montado (pertenece al theme VIEJO) incluso para los modulos\r\n      // del Hot Pool -- se destruyen de verdad aca, \"warmHotModules()\"\r\n      // los vuelve a precalentar mas abajo ya con el theme nuevo.\r\n      if (els[id]) {\r\n        const p = teardownContent(els[id].content, id, { force: true });\r\n        if (p) releasePromises.push(p);\r\n      }\r\n    }\r\n    // Punto 3+4 del pedido: esperar el release REAL de todos los contextos\r\n    // viejos (nunca un timeout adivinado) antes de seguir. Con la pesta\u00F1a\r\n    // visible esto resuelve en 1-2 frames (~16-33ms); en el peor caso\r\n    // (pesta\u00F1a oculta, rAF suspendido) tarda hasta 200ms, el mismo techo\r\n    // que ya exist\u00EDa -- ver comentario del fallback en alpha-video.js.\r\n    await Promise.all(releasePromises);\r\n  }\r\n  // Punto 5: reci\u00E9n ahora se pinta el estado real y se calienta el theme\r\n  // nuevo -- los contextos viejos ya estan liberados (o el modulo nunca\r\n  // tuvo uno, ej. sin cambio de theme).\r\n  for (const id of MODULE_IDS) applyModuleState(id, msg.state[id]);\r\n  syncGolComposition();\r\n  warmHotModules();\r\n}\r\n\r\n// Serializa los STATE_SNAPSHOT entre si (ver comentario de\r\n// \"handleStateSnapshot\" arriba) -- sin esto, dos cambios de theme muy\r\n// seguidos podr\u00EDan interlazar sus propios \"await\" y pisarse el teardown/\r\n// warm-up entre ellos. \".catch\" evita que un error en uno deje la cadena\r\n// rota para siempre (los STATE_SNAPSHOT futuros seguir\u00EDan llegando).\r\nlet pendingSnapshotChain = Promise.resolve();\r\n\r\nws = connect({\r\n  onMessage(msg) {\r\n    if (msg.type === 'TEAM_CATALOG_UPDATE') {\r\n      updateLocalTeamCatalog(msg.catalog);\r\n      for (const id of MODULE_IDS) {\r\n        if (lastStatus[id] === MODULE_STATUS.ON && els[id]) {\r\n          renderers[id](els[id].content, latestData[id] || {}, false, () => handleOneShotEnded(id), latestData);\r\n        }\r\n      }\r\n    } else if (msg.type === WS_MSG.ASSET_VERSIONS) {\r\n      setAssetVersions(msg.versions);\r\n      if (msg.changedPaths?.length) reloadAssetsForPaths(msg.changedPaths);\r\n    } else if (msg.type === WS_MSG.THEME_UPDATE) {\r\n      setRendererActiveThemeId(msg.themeId);\r\n    } else if (msg.type === WS_MSG.STATE_SNAPSHOT) {\r\n      pendingSnapshotChain = pendingSnapshotChain\r\n        .then(() => handleStateSnapshot(msg))\r\n        .catch((err) => console.error('[GLA] Error procesando STATE_SNAPSHOT:', err));\r\n    } else if (msg.type === WS_MSG.MODULE_UPDATE) {\r\n      const isOn = msg.moduleState && msg.moduleState.status === MODULE_STATUS.ON;\r\n      if (isOn && msg.isAutoSave && !msg.isExplicitUpdate) {\r\n        // Ignorar CONTENIDO en directo mientras la gr\u00E1fica est\u00E1 al aire (no\r\n        // repintar tipeo a medio escribir) -- pero los AJUSTES VISUALES\r\n        // (composici\u00F3n + textAdjust) s\u00ED tienen que verse ya, sin esperar a\r\n        // ACTUALIZAR (ver \"applyVisualLive\" m\u00E1s arriba).\r\n        latestData[msg.moduleId] = msg.moduleState.data;\r\n        applyVisualLive(msg.moduleId, msg.moduleState.data);\r\n        if (msg.moduleId === 'scoreboard') syncGolComposition();\r\n        return;\r\n      }\r\n      if (!isOn) maybeRewarmOffAirVariant(msg.moduleId, msg.moduleState && msg.moduleState.data);\r\n      applyModuleState(msg.moduleId, msg.moduleState, msg.isExplicitUpdate);\r\n      if (msg.moduleId === 'scoreboard') syncGolComposition();\r\n    }\r\n  },\r\n});\r\n\r\n// Introspecci\u00F3n de solo lectura del Hot Pool (2026-09-23) -- diagn\u00F3stico\r\n// operativo y las mediciones del informe de auditor\u00EDa, sin herramientas\r\n// adicionales: abrir devtools en Program y llamar\r\n// \"window.__glaHotPool.snapshot()\" muestra cada m\u00F3dulo del pool con su\r\n// estado (warm/playing), variante y \u00FAltimo uso.\r\nwindow.__glaHotPool = {\r\n  HOT_MODULE_IDS,\r\n  MAX_WARM_SLOTS,\r\n  snapshot: hotPoolSnapshot,\r\n};\r\n\r\n// Introspecci\u00F3n + debug del Burst/Take Scheduler (2026-09-25, ver\r\n// program/js/take-scheduler.js) -- \"setDebug(true)\" logea cada decisi\u00F3n de\r\n// timing en consola (\"[TAKE-SCHEDULER] ...\") sin ensuciar producci\u00F3n por\r\n// default (arranca apagado). Mismos par\u00E1metros que usa el scheduler\r\n// (config centralizada, ver take-scheduler.js) expuestos de solo lectura.\r\nwindow.__glaTakeScheduler = {\r\n  TAKE_BURST_WINDOW_MS,\r\n  TAKE_STAGGER_MS,\r\n  TAKE_MAX_STAGGER_MS,\r\n  HIGH_STAGGER_MS,\r\n  HIGH_MAX_STAGGER_MS,\r\n  CRITICAL_MODULE_IDS: [...CRITICAL_MODULE_IDS],\r\n  HIGH_PRIORITY_IDS: [...HIGH_PRIORITY_IDS],\r\n  setDebug: setSchedulerDebug,\r\n  configure: configureScheduler,\r\n  getConfig: getSchedulerConfig,\r\n};\r\n\r\n// Introspecci\u00F3n de contextos WebGL (2026-09-26, WebGL context management --\r\n// pedido explicito seccion 8: \"medir cantidad de contextos WebGL activos...\r\n// durante cambio de theme... pico maximo\"). Recorre los <canvas> realmente\r\n// montados en el DOM ahora mismo -- no hay ningun registro paralelo que\r\n// mantener, un canvas \".alpha-video-canvas\" solo existe mientras su modulo\r\n// esta WARM o PLAYING (ver program/js/alpha-video.js/hot-pool.js), asi que\r\n// contarlos ES contar contextos vivos.\r\nwindow.__glaWebGL = {\r\n  countLive() {\r\n    return document.querySelectorAll('canvas').length;\r\n  },\r\n  list() {\r\n    return [...document.querySelectorAll('canvas')].map((c) => {\r\n      const gl = c.getContext('webgl');\r\n      return { moduleId: c.closest('[id^=\"mod-\"]')?.id?.replace('mod-', '') || null, contextLost: gl ? gl.isContextLost() : null };\r\n    });\r\n  },\r\n};\r\n","http://127.0.0.1:4430/shared/modules.js","// Registro central de modulos de graficas.\r\n// Agregar una grafica nueva = agregar una entrada aca (Master Control genera el\r\n// panel solo a partir de \"fields\"; Program necesita ademas un renderer en\r\n// program/js/renderers/<id>.js y su posicionamiento en program/css/overlay.css).\r\n//\r\n// Flags especiales que puede tener un modulo:\r\n// - live: true       -> Program vuelve a renderizar cada 500ms mientras esta ON\r\n//                        (para que un reloj se vea andar sin mensajes WS extra).\r\n// - oneShot: true     -> el asset tiene su propia animacion de entrada Y salida\r\n//                        adentro del archivo (ej. un festejo de gol, una\r\n//                        transicion). Program avisa solo cuando el video\r\n//                        termina y vuelve a OUT sin que el operador tenga que\r\n//                        apretar Sacar.\r\n// - autoRunClock: 'clock' -> al hacer Tomar al aire, Master Control arranca\r\n//                        automaticamente ese campo de reloj desde 00:00\r\n//                        (para piezas que son \"un cronometro que se prende\").\r\n// - sequencedReveal: true -> Program (program/js/main.js) secuencia la entrada\r\n//                        en dos tiempos: el asset entra solo, el contenido\r\n//                        dinamico (\".gfx-overlay\": escudos, texto, numeros)\r\n//                        se revela recien despues de que la animacion horneada\r\n//                        del asset termina de asentarse. Al Sacar del aire se\r\n//                        invierte: el contenido desaparece primero y recien\r\n//                        despues sale el asset. No requiere nada del lado del\r\n//                        renderer del modulo (ver program/css/overlay.css y\r\n//                        program/js/main.js) \u2014 es logica 100% compartida.\r\n\r\nimport { FIELD_TYPES, PENALTY_KICK_STATUS } from './constants.js';\r\nimport { TEAM_COLORS } from './team-colors.js';\r\nimport { TEAM_OPTIONS } from './teams.js';\r\nimport { SPONSOR_OPTIONS } from './sponsors.js';\r\nimport { emptyClock } from './clock.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from './themes.js';\r\nimport { deepMergeAdjustFields } from './adjust-path.js';\r\n\r\nfunction penaltyKicksDefault(count) {\r\n  return Array.from({ length: count }, () => ({ status: PENALTY_KICK_STATUS.PENDING }));\r\n}\r\n\r\n// \"textAdjust\" (2026-08-14, pedido explicito del usuario: herramienta de\r\n// edicion manual de posicion X/Y y tama\u00F1o por CADA campo de texto de los\r\n// zocalos, sin tocar codigo). Cada clave de este objeto es el mismo \"key\"\r\n// del campo (o una ruta \"grupo.campo\" para datos anidados, ver\r\n// \"shortDouble\" mas abajo) y guarda { dx, dy, dSize } en pixeles logicos\r\n// -- se persiste junto con el resto de \"data\" del modulo (mismo mecanismo\r\n// que ya existia, server/state.js no necesito ningun cambio) y Program lo\r\n// aplica como una capa ADICIONAL sobre la posicion/tama\u00F1o de dise\u00F1o (ver\r\n// applyFittedText en program/js/text-fit.js), nunca reemplazandola --\r\n// resetear un campo es simplemente volver su entrada a {dx:0,dy:0,dSize:0}.\r\nfunction textAdjustDefaults(...keys) {\r\n  return Object.fromEntries(keys.map((key) => [key, { dx: 0, dy: 0, dSize: 0 }]));\r\n}\r\n\r\nconst TEAM_COLOR_OPTIONS = TEAM_COLORS.map((c) => ({ id: c.id, label: c.label }));\r\n\r\nexport const MATCH_STATUS_OPTIONS = [\r\n  { id: '', label: 'Sin estado' },\r\n  { id: 'proximo', label: 'A CONTINUACION' },\r\n  { id: 'final', label: 'FINAL' },\r\n  { id: 'entretiempo', label: 'ENTRETIEMPO' },\r\n];\r\n\r\nexport const MODULES = {\r\n  // ---------------------------------------------------------------------\r\n  // MARCADOR\r\n  // ---------------------------------------------------------------------\r\n  // \"teamA\"/\"teamB\" guardan el ID del equipo (catalogo global, ver\r\n  // shared/teams.js) \u2014 no texto libre ni un escudo por separado. Escudo y\r\n  // abreviatura de 3 letras se resuelven SIEMPRE a partir de ese ID (ver\r\n  // program/js/renderers/scoreboard.js), nunca se vuelven a cargar a mano;\r\n  // todos los demas modulos que necesitan datos de equipo (Entretiempo,\r\n  // Penales, Tarjetas, Cambios, VS Compacto) leen este mismo ID en vivo\r\n  // desde \"scoreboard\" en vez de tener su propio campo de equipo.\r\n  scoreboard: {\r\n    id: 'scoreboard',\r\n    label: 'Marcador principal',\r\n    category: 'Marcador',\r\n    layer: 'top-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'teamA', label: 'Equipo local', type: FIELD_TYPES.SELECT, options: TEAM_OPTIONS },\r\n      { key: 'teamAColor', label: 'Color de camiseta - local', type: FIELD_TYPES.SELECT, options: TEAM_COLOR_OPTIONS },\r\n      { key: 'teamB', label: 'Equipo visitante', type: FIELD_TYPES.SELECT, options: TEAM_OPTIONS },\r\n      { key: 'teamBColor', label: 'Color de camiseta - visitante', type: FIELD_TYPES.SELECT, options: TEAM_COLOR_OPTIONS },\r\n      // \"scoreA\"/\"scoreB\" (BLOQUE 2, 2026-09-09, pedido explicito del\r\n      // usuario: \"eliminar los textbox/input num\u00E9ricos manuales actuales\r\n      // para goles\"): pasan de TEXT editable a ADJUST_ONLY -- mismo\r\n      // criterio que \"period\"/\"clock\"/\"nameA\"/\"nameB\" mas abajo, el VALOR\r\n      // ya no se tipea aca (ahora exclusivamente via los botones +/-/RESET\r\n      // del panel dedicado, ver scoreboard-clock-panel.js), pero la\r\n      // posicion/tama\u00F1o se sigue ajustando igual (arrows inline para GLA,\r\n      // acordeon AJUSTE DE COMPOSICI\u00D3N para Argentina Streamers -- ningun\r\n      // cambio en ADJUST_REGISTRY, sigue apuntando a \"scoreA\"/\"scoreB\").\r\n      { key: 'scoreA', label: 'Goles local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Goles visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'sponsor', label: 'Sponsor Marcador', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.scoreboard },\r\n      // \"nameA\"/\"nameB\"/\"clock\" (2026-08-15, auditoria completa): no se\r\n      // tipean aca (la abreviatura sale del equipo elegido arriba, el reloj\r\n      // corre solo) pero igual son texto visible en Program -> ADJUST_ONLY,\r\n      // mismo mecanismo que un campo TEXT adjustable, sin input de texto.\r\n      { key: 'nameA', label: 'Abreviatura equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Abreviatura equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'clock', label: 'Reloj (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      // \"period\" (2026-08-15, pedido explicito del usuario: botones 1T/2T/\r\n      // ET/PERSONALIZADO en vez de un input de texto suelto) -- el TEXTO\r\n      // libre se tipea ahora desde el panel a medida\r\n      // (master-control/js/scoreboard-clock-panel.js), pero el AJUSTE de\r\n      // posicion/tama\u00F1o sigue siendo generico -> ADJUST_ONLY, mismo criterio\r\n      // que \"clock\" arriba.\r\n      { key: 'period', label: 'Per\u00EDodo / tiempo (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    // El reloj (clock, arranque/pausa) y el periodo (botones 1T/2T/ET/\r\n    // personalizado) se controlan con un panel a medida en Master Control\r\n    // (ver master-control/js/scoreboard-clock-panel.js), no con \"fields\" --\r\n    // el AJUSTE de posicion/tama\u00F1o de sus textos si se resuelve con los\r\n    // campos ADJUST_ONLY de arriba, generico.\r\n    defaults: {\r\n      teamA: '', teamB: '', teamAColor: 'gris', teamBColor: 'gris', scoreA: '0', scoreB: '0', period: '',\r\n      clock: emptyClock(),\r\n      // \"clockEndText\" (2026-08-15, pedido explicito del usuario: \"FIN DEL\r\n      // CONTADOR\" configurable, default 15:00) -- ver shared/clock.js\r\n      // (parseClockLimit) y program/js/renderers/scoreboard.js.\r\n      clockEndText: '15:00',\r\n      sponsor: '',\r\n      // \"teamColorAssignments\" (2026-08-16, pedido explicito del usuario:\r\n      // \"ASIGNAR COLOR AL EQUIPO\"): mapa persistente { teamId: colorId }.\r\n      // Al elegir un equipo en \"teamA\"/\"teamB\", si existe una entrada aca\r\n      // se autocompleta \"teamAColor\"/\"teamBColor\" con ese color (ver\r\n      // master-control/js/main.js); el boton de asignar lo escribe/pisa\r\n      // (master-control/js/scoreboard-clock-panel.js). Cambiar el color\r\n      // sin apretar el boton es solo temporal, no toca este mapa.\r\n      teamColorAssignments: {},\r\n      textAdjust: textAdjustDefaults('scoreA', 'scoreB', 'period', 'nameA', 'nameB', 'clock'),\r\n      // \"localCrestOffset*/awayCrestOffset*/separatorOffset*\" (2026-08-31,\r\n      // pedido explicito del usuario: cada elemento del marcador debe\r\n      // poder moverse/escalarse por separado -- ver\r\n      // master-control/js/composition-control.js). Mismo criterio que\r\n      // \"compositionOffsetX/Y/Scale\" (COMPOSITION_DEFAULTS mas abajo):\r\n      // sufijo \"OffsetX\"/\"OffsetY\"/\"Scale\" para que program/js/main.js\r\n      // (\"isVisualKey\") los trate como ajuste visual en vivo sin cambios\r\n      // ahi. Default 0/0/1 = no-op -- GLA nunca los toca desde su panel\r\n      // (el acordeon nuevo es exclusivo de Argentina Streamers, ver\r\n      // master-control/js/main.js) pero quedan disponibles para cualquier\r\n      // theme sin romper nada.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      separatorOffsetX: 0, separatorOffsetY: 0, separatorScale: 1,\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31, auditoria completa de\r\n      // edicion individual): el logo de sponsor del Marcador nunca tuvo\r\n      // ajuste propio.\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n    },\r\n  },\r\n\r\n  marcadorTiempoAdicional: {\r\n    id: 'marcadorTiempoAdicional',\r\n    label: 'Tiempo adicional',\r\n    category: 'Marcador',\r\n    layer: 'top-left',\r\n    live: true,\r\n    autoRunClock: 'clock',\r\n    fields: [\r\n      { key: 'addedMinutes', label: 'Minutos agregados (ej. 5)', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      // \"autoTake\" (2026-09-27, pedido explicito del usuario): si el TAKE\r\n      // automatico al llegar a FIN DEL CONTADOR del Marcador principal\r\n      // esta habilitado. String 'si'/'no' (mismo criterio que cualquier\r\n      // otro campo SELECT del proyecto) -- persistido junto al resto de\r\n      // \"data\" de este modulo, sin mecanismo nuevo. Default 'si': mismo\r\n      // comportamiento de siempre para quien no lo toque.\r\n      { key: 'autoTake', label: 'AUTOM\u00C1TICO', type: FIELD_TYPES.SELECT, options: [{ id: 'si', label: 'S\u00CD' }, { id: 'no', label: 'NO' }] },\r\n      { key: 'clock', label: 'Reloj (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      addedMinutes: '5', clock: emptyClock(), autoTake: 'si',\r\n      textAdjust: textAdjustDefaults('addedMinutes', 'clock'),\r\n    },\r\n  },\r\n\r\n  marcadorEntretiempo: {\r\n    id: 'marcadorEntretiempo',\r\n    label: 'Marcador - Entretiempo',\r\n    category: 'Marcador',\r\n    layer: 'top-left',\r\n    // Sin fields propios: reutiliza en vivo los datos ya cargados en\r\n    // \"scoreboard\" (escudos, colores, codigo de equipo, goles) \u2014 el\r\n    // operador los edita una sola vez, desde el marcador principal. El\r\n    // renderer de Program lee ese estado directamente (ver\r\n    // program/js/renderers/marcadorEntretiempo.js). \"live\" hace que se\r\n    // vuelva a pintar cada 500ms mientras esta al aire, para reflejar\r\n    // cambios que el operador haga en el marcador principal sin tener\r\n    // que tocar este modulo.\r\n    live: true,\r\n    sequencedReveal: true,\r\n    // \"nameA\"/\"nameB\"/\"scoreA\"/\"scoreB\" (2026-08-15, auditoria completa):\r\n    // los 4 textos visibles se derivan en vivo de \"scoreboard\" (arriba) sin\r\n    // campo propio -- ADJUST_ONLY les da el editor de posicion/tama\u00F1o\r\n    // igual que a cualquier otro texto, sin agregar un input que duplicaria\r\n    // la carga de datos.\r\n    fields: [\r\n      { key: 'nameA', label: 'Abreviatura equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Abreviatura equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreA', label: 'Gol local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Gol visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      // \"separador\" (2026-09-04, pedido explicito del usuario, exclusivo\r\n      // Argentina Streamers -- ver shared/adjust-registry.js \"themeOnly\"):\r\n      // editor propio para el \"-\" entre los goles.\r\n      textAdjust: textAdjustDefaults('nameA', 'nameB', 'scoreA', 'scoreB', 'separador'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio, solo src-swap.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n    },\r\n  },\r\n\r\n  marcadorPenales: {\r\n    id: 'marcadorPenales',\r\n    label: 'Marcador de penales (mejor de 3)',\r\n    category: 'Marcador',\r\n    layer: 'bottom-left-secondary',\r\n    // Sin campos de equipo/color propios: se leen en vivo de \"scoreboard\"\r\n    // (mismo patron que marcadorEntretiempo, ver program/js/renderers/\r\n    // marcadorPenales.js) \u2014 el operador solo carga el estado de cada\r\n    // penal, no vuelve a tipear el equipo.\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00EDtulo', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'kicksA', label: 'Tandas equipo A', type: FIELD_TYPES.PENALTY_SERIES, count: 3 },\r\n      { key: 'kicksB', label: 'Tandas equipo B', type: FIELD_TYPES.PENALTY_SERIES, count: 3 },\r\n      { key: 'nameA', label: 'Abreviatura equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Abreviatura equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      // \"scoreA\"/\"scoreB\" (2026-08-31, correcci\u00F3n expl\u00EDcita del usuario):\r\n      // dejaron de mostrar el resultado del PARTIDO (sb.scoreA/scoreB) \u2014\r\n      // ahora Program calcula el resultado de la TANDA DE PENALES en vivo\r\n      // a partir de \"kicksA\"/\"kicksB\" (cuenta de intentos en 'scored'), ver\r\n      // program/js/renderers/marcadorPenales.js. Este campo sigue siendo\r\n      // solo de posici\u00F3n/tama\u00F1o (el numero no se tipea, se calcula solo).\r\n      { key: 'scoreA', label: 'Resultado de penales local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Resultado de penales visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      // \"sponsor\" (2026-08-31, pedido explicito del usuario): mismo\r\n      // catalogo/categoria que Zocalo VS Compacto (\"vs_compact\"), sin\r\n      // inventar un catalogo nuevo.\r\n      { key: 'sponsor', label: 'Sponsor Penales', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.vs_compact },\r\n    ],\r\n    defaults: {\r\n      titulo: 'PENALES',\r\n      kicksA: penaltyKicksDefault(3), kicksB: penaltyKicksDefault(3),\r\n      sponsor: '',\r\n      // \"suddenDeath\" (2026-08-15, pedido explicito del usuario: indicar\r\n      // MUERTE SUBITA sin inventar un asset nuevo) -- toggle desde un panel\r\n      // a medida (ver master-control/js/penales-panel.js). Cuando esta en\r\n      // true, el renderer (program/js/renderers/marcadorPenales.js) le\r\n      // agrega \" \u2014 MUERTE S\u00DABITA\" al mismo titulo de siempre, reusando la\r\n      // zona/auto-ajuste de fuente que ya existe para ese texto -- no es un\r\n      // campo de texto propio, no se persiste por separado del titulo.\r\n      suddenDeath: false,\r\n      textAdjust: textAdjustDefaults('titulo', 'nameA', 'nameB', 'scoreA', 'scoreB', 'nombreLocal', 'nombreVisitante'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio, solo src-swap.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      // \"kicksLocalOffset*/kicksVisitanteOffset*\" (2026-08-31, pedido\r\n      // explicito del usuario): cada fila de circulos de penales se mueve\r\n      // como grupo, independiente del escudo y del resultado.\r\n      kicksLocalOffsetX: 0, kicksLocalOffsetY: 0, kicksLocalScale: 1,\r\n      kicksVisitanteOffsetX: 0, kicksVisitanteOffsetY: 0, kicksVisitanteScale: 1,\r\n      // \"kickLocal{1-5}Offset*\"/\"kickVisitante{1-5}Offset*\" (2026-09-01,\r\n      // pedido explicito del usuario: \"no quiero seguir pidiendote mover\r\n      // circulos a mano en codigo... quiero CONTROL TOTAL desde Master\r\n      // Control\"). Capa ADITIVA por-circulo, encima de la posicion base ya\r\n      // definida en program/css/overlay.css (que sigue existiendo como\r\n      // default -- \"los defaults pueden existir\") y de \"kicksLocalOffset*\"\r\n      // (que sigue moviendo la FILA completa como grupo) -- 0/0/1 es un\r\n      // no-op, cada circulo queda exactamente donde esta hoy hasta que el\r\n      // operador lo ajuste y confirme con GUARDAR POSICI\u00D3N. Solo tiene\r\n      // panel propio para Argentina Streamers (ver \"themeOnly\" en\r\n      // shared/adjust-registry.js) -- GLA nunca los toca ni los ve.\r\n      kickLocal1OffsetX: 0, kickLocal1OffsetY: 0, kickLocal1Scale: 1,\r\n      kickLocal2OffsetX: 0, kickLocal2OffsetY: 0, kickLocal2Scale: 1,\r\n      kickLocal3OffsetX: 0, kickLocal3OffsetY: 0, kickLocal3Scale: 1,\r\n      kickLocal4OffsetX: 0, kickLocal4OffsetY: 0, kickLocal4Scale: 1,\r\n      kickLocal5OffsetX: 0, kickLocal5OffsetY: 0, kickLocal5Scale: 1,\r\n      kickVisitante1OffsetX: 0, kickVisitante1OffsetY: 0, kickVisitante1Scale: 1,\r\n      kickVisitante2OffsetX: 0, kickVisitante2OffsetY: 0, kickVisitante2Scale: 1,\r\n      kickVisitante3OffsetX: 0, kickVisitante3OffsetY: 0, kickVisitante3Scale: 1,\r\n      kickVisitante4OffsetX: 0, kickVisitante4OffsetY: 0, kickVisitante4Scale: 1,\r\n      kickVisitante5OffsetX: 0, kickVisitante5OffsetY: 0, kickVisitante5Scale: 1,\r\n      // \"separatorOffset*\" (2026-08-31): gui\u00F3n entre el resultado local y\r\n      // visitante de la tanda de penales -- mismo criterio que el gui\u00F3n\r\n      // del Marcador principal (scoreboard.separatorOffsetX/Y/Scale).\r\n      separatorOffsetX: 0, separatorOffsetY: 0, separatorScale: 1,\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31): unico elemento visual del\r\n      // sponsor, nunca tuvo ajuste propio.\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      // \"nombreLocal/VisitanteMode/Manual\" (2026-09-01, pedido explicito\r\n      // del usuario): mismo mecanismo que VS Prepartido/VS Resultado, ver\r\n      // shared/broadcast-names.js. Solo se muestra/usa para Argentina\r\n      // Streamers -- inocuo para GLA (nunca se lee ahi).\r\n      nombreLocalMode: 'auto', nombreLocalManual: '',\r\n      nombreVisitanteMode: 'auto', nombreVisitanteManual: '',\r\n    },\r\n  },\r\n\r\n  // Reemplaza al ex \"Shootout\" (penales 1 c/u): mismo lugar en la familia\r\n  // Marcador, logica completamente nueva y mas simple \u2014 asset propio\r\n  // (imagen estatica, sin video), un solo campo de texto libre y el mismo\r\n  // reloj automatico que ya usa \"marcadorTiempoAdicional\" (autoRunClock):\r\n  // arranca solo al Tomar al aire, sin panel de Play/Pause propio. Se\r\n  // renderiza DETRAS del marcador principal a proposito (ver orden de\r\n  // nodos en program/index.html): el operador lo usa para asomar un\r\n  // titulo por debajo de la barra del marcador ya al aire.\r\n  marcadorZocalo: {\r\n    id: 'marcadorZocalo',\r\n    label: 'Marcador Z\u00F3calo',\r\n    category: 'Marcador',\r\n    layer: 'top-left-secondary',\r\n    live: true,\r\n    autoRunClock: 'clock',\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00CDTULO', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'clock', label: 'Reloj (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      titulo: '', clock: emptyClock(),\r\n      // \"clockEndText\" (2026-08-15, pedido explicito del usuario: \"FIN DEL\r\n      // CONTADOR\" configurable, default 06:00 para Marcador Zocalo) -- ver\r\n      // shared/clock.js (parseClockLimit) y\r\n      // master-control/js/live-clock-display.js.\r\n      clockEndText: '06:00',\r\n      textAdjust: textAdjustDefaults('titulo', 'clock'),\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // PLACAS FULLSCREEN Y MID-FULL\r\n  // ---------------------------------------------------------------------\r\n  formacionEquipos: {\r\n    id: 'formacionEquipos',\r\n    label: 'Formacion',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    // Sin \"teamSide\" generico aca: el selector LOCAL/VISITANTE vive en el\r\n    // panel dedicado (master-control/js/formation-list-panel.js), que\r\n    // ademas de mostrar el toggle tiene que disparar la secuencia\r\n    // OUT->cargar preset->TAKE cuando el modulo esta al aire (ver ese\r\n    // archivo y master-control/js/main.js) -- el editor generico de\r\n    // campos (field-editors.js) no tiene forma de engancharse a eso.\r\n    fields: [],\r\n    defaults: {\r\n      teamSide: 'local',\r\n      // \"starters\"/\"substitutes\" son SIEMPRE el contenido activo (lo que\r\n      // lee program/js/renderers/formacionEquipos.js) -- el panel los\r\n      // mantiene sincronizados con \"presets[teamSide]\" en cada edicion.\r\n      // \"presets\" guarda titulares+suplentes de cada equipo por separado\r\n      // (2026-08-05, pedido explicito del usuario: preparar ambas\r\n      // formaciones con anticipacion sin que se mezclen entre si).\r\n      starters: [], substitutes: [],\r\n      presets: {\r\n        local: { starters: [], substitutes: [] },\r\n        visitor: { starters: [], substitutes: [] },\r\n      },\r\n      // \"playerName\"/\"playerNumber\" (2026-08-15, auditoria completa): un\r\n      // unico ajuste compartido por las 6 posiciones de titulares (misma\r\n      // clase visual en el asset, ver program/js/renderers/\r\n      // formacionEquipos.js) -- \"subsTitle\" es el rotulo fijo \"SUPLENTES\",\r\n      // \"subsList\" es el bloque completo de la lista de suplentes.\r\n      textAdjust: textAdjustDefaults('playerName', 'playerNumber', 'subsTitle', 'subsList'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): el escudo\r\n      // del equipo activo nunca tuvo ajuste propio, solo src-swap.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  vsPrepartido: {\r\n    id: 'vsPrepartido',\r\n    label: 'VS Prepartido',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00CDTULO', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'nameA', label: 'Nombre equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Nombre equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      titulo: 'PR\u00D3XIMO PARTIDO',\r\n      titlePresets: [],\r\n      textAdjust: textAdjustDefaults('titulo', 'nameA', 'nameB'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      // \"nameXMode\"/\"nameXManual\" (2026-09-01, pedido explicito del\r\n      // usuario: \"los nombres actuales quedan mal visualmente\" -- ver\r\n      // shared/broadcast-names.js). \"auto\" (default) resuelve un nombre\r\n      // de BROADCAST propio para los 4 equipos de Argentina Streamers sin\r\n      // tocar el nombre real del equipo; cualquier otro teamId (todos los\r\n      // de GLA) cae exactamente en \"teamName()\" de siempre, cero cambio\r\n      // visual ahi. El control en Master Control solo se muestra para\r\n      // Argentina Streamers (ver renderPanel() en main.js) -- estos\r\n      // defaults son inocuos para GLA aunque el campo exista en su arbol\r\n      // de datos.\r\n      nameAMode: 'auto', nameAManual: '',\r\n      nameBMode: 'auto', nameBManual: '',\r\n    },\r\n  },\r\n\r\n  vsResultado: {\r\n    id: 'vsResultado',\r\n    label: 'VS Con resultado',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'titulo', label: 'T\u00CDTULO', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'nameA', label: 'Nombre equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Nombre equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreA', label: 'Gol local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'scoreB', label: 'Gol visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      titulo: 'RESULTADO',\r\n      titlePresets: [],\r\n      // \"scoreSep\" (guion dinamico entre goles): RETIRADO para GLA\r\n      // (2026-09-27, su asset ya trae el guion) y VUELTO solo para\r\n      // ARGENTINA STREAMERS (2026-10-08, pedido explicito: \"agregar un guion\r\n      // dinamico entre GOL LOCAL y GOL VISITANTE\" con ajuste propio). El\r\n      // nodo existe siempre en el renderer pero solo se muestra con\r\n      // body[data-theme='argentinaStreamers'] (ver overlay.css); el control\r\n      // de ajuste es \"themeOnly\" en shared/adjust-registry.js.\r\n      textAdjust: textAdjustDefaults('titulo', 'nameA', 'nameB', 'scoreA', 'scoreB', 'scoreSep'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los escudos nunca tuvieron ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      // \"nameXMode\"/\"nameXManual\" (2026-09-01): mismo mecanismo que\r\n      // vsPrepartido, ver el comentario ahi y shared/broadcast-names.js.\r\n      nameAMode: 'auto', nameAManual: '',\r\n      nameBMode: 'auto', nameBManual: '',\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // EVENTOS DEL PARTIDO\r\n  // ---------------------------------------------------------------------\r\n  // Un solo modulo/solapa para las 3 tarjetas (amarilla/roja/azul) \u2014 el campo\r\n  // \"tipo\" elige la variante visual (que asset .mp4 se reproduce, ver\r\n  // program/js/renderers/tarjeta.js), no hay 3 modulos ni 3 solapas\r\n  // separadas. Sin campo de equipo/escudo propio: se lee en vivo de\r\n  // \"scoreboard\" (`live: true`, mismo patron que marcadorPenales/\r\n  // marcadorEntretiempo) segun lo que el operador elija en \"equipo\".\r\n  tarjeta: {\r\n    id: 'tarjeta',\r\n    label: 'Tarjetas',\r\n    category: 'Eventos',\r\n    layer: 'bottom-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'equipo',\r\n        label: 'Equipo',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'local', label: 'Local' },\r\n          { id: 'visitante', label: 'Visitante' },\r\n        ],\r\n      },\r\n      {\r\n        key: 'tipo',\r\n        label: 'Tipo de tarjeta',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'amarilla', label: 'Amarilla' },\r\n          { id: 'roja', label: 'Roja' },\r\n          { id: 'azul', label: 'Azul' },\r\n        ],\r\n      },\r\n      { key: 'jugador', label: 'Nombre del jugador', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      equipo: 'local', tipo: 'amarilla', jugador: '', textAdjust: textAdjustDefaults('jugador'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, pedido explicito del usuario:\r\n      // extender la edicion individual a todo el software) -- el escudo\r\n      // de este modulo nunca tuvo ajuste propio, solo src-swap (ver\r\n      // program/js/renderers/tarjeta.js). Default 0/0/1 = no-op, ver\r\n      // shared/adjust-registry.js.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // El asset tiene un unico casillero de escudo (una sustitucion es\r\n  // siempre del mismo equipo para \"entra\"/\"sale\") \u2014 se lee en vivo de\r\n  // \"scoreboard\" (`live: true`, mismo patron que `tarjeta`) segun el\r\n  // campo \"equipo\" elegido por el operador.\r\n  cambios: {\r\n    id: 'cambios',\r\n    label: 'Cambios',\r\n    category: 'Eventos',\r\n    layer: 'bottom-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'equipo',\r\n        label: 'Equipo',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'local', label: 'Local' },\r\n          { id: 'visitante', label: 'Visitante' },\r\n        ],\r\n      },\r\n      { key: 'entra', label: 'Entra', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'sale', label: 'Sale', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    // \"titulo\" ELIMINADO (2026-09-01, pedido explicito del usuario: \"NO\r\n    // QUIERO T\u00CDTULO... eliminar completamente de la l\u00F3gica operativa y del\r\n    // panel\"). Sin campo, sin default, sin textAdjust -- el modulo queda\r\n    // enfocado en equipo/escudo/entra/sale, ver program/js/renderers/\r\n    // cambios.js (ya no tiene ningun rastro de titulo tampoco).\r\n    defaults: {\r\n      equipo: 'local', entra: '', sale: '',\r\n      textAdjust: textAdjustDefaults('entra', 'sale'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, pedido explicito del usuario):\r\n      // mismo criterio que \"tarjeta\" -- el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  gol: {\r\n    id: 'gol',\r\n    label: 'Gol',\r\n    category: 'Eventos',\r\n    layer: 'top-left-secondary',\r\n    oneShot: true,\r\n    fields: [],\r\n    // \"golRelativoMarcador\" (2026-10-21, solo GLA lo usa): marca que su\r\n    // composicion ya es el ajuste fino RELATIVO al Marcador (ver la\r\n    // migracion unica en server/state.js). Inocuo para Argentina Streamers.\r\n    defaults: { golRelativoMarcador: true },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // VAR / REPLAY\r\n  // ---------------------------------------------------------------------\r\n  varCheck: {\r\n    id: 'varCheck',\r\n    label: 'VAR Chequeo',\r\n    category: 'VAR / Replay',\r\n    layer: 'bottom-left-secondary',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'sponsor', label: 'Sponsor VAR', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.var },\r\n      // \"motivoPreset\" (2026-08-15, pedido explicito del usuario): selector\r\n      // con 3 textos predefinidos + PERSONALIZADO. Elegir un preset\r\n      // autocompleta \"motivo\" (logica en master-control/js/main.js, mismo\r\n      // patron que el auto-completado de LOCAL/VISITANTE en Tarjetas/\r\n      // Cambios) -- \"motivo\" sigue siendo el mismo campo TEXT de siempre,\r\n      // con su editor de posicion/tama\u00F1o intacto (adjustable:true), asset\r\n      // cortito, animaciones y logica TAKE/UPDATE/OUT sin cambios.\r\n      {\r\n        key: 'motivoPreset',\r\n        label: 'Motivo',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'posible_penal', label: 'POSIBLE PENAL' },\r\n          { id: 'gol_no_valido', label: 'GOL NO V\u00C1LIDO' },\r\n          { id: 'posible_roja', label: 'POSIBLE ROJA' },\r\n          { id: 'personalizado', label: 'PERSONALIZADO' },\r\n        ],\r\n      },\r\n      { key: 'motivo', label: 'Texto Motivo', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      sponsor: '', motivoPreset: 'posible_penal', motivo: 'POSIBLE PENAL',\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n      motivoOffsetX: 0, motivoOffsetY: 0, motivoScale: 1,\r\n      textAdjust: textAdjustDefaults('motivo'),\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31, pedido explicito del\r\n      // usuario): el logo de sponsor nunca tuvo ajuste propio (solo\r\n      // fade-swap, ver program/js/renderers/varCheck.js).\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      // \"varGroupOffsetX/Y/Scale\" (2026-08-31): antes de este campo,\r\n      // \".ov-var-group1\" (clip VAR + sponsor) leia manualmente las MISMAS\r\n      // keys que \"compositionOffsetX/Y/Scale\" (COMPOSICION COMPLETA, ver\r\n      // COMPOSITION_DEFAULTS mas abajo) -- como ese grupo es hijo de\r\n      // \".content\" y \"COMPOSICION COMPLETA\" YA mueve \".content\" entero,\r\n      // el offset se aplicaba DOS VECES (compuesto) sobre group1 mientras\r\n      // que \".ov-var-motivo-group\" solo lo heredaba una vez de \".content\"\r\n      // -- rompia el requisito de que \"Composicion completa\" mueva TODO\r\n      // el modulo como una unidad rigida. Se separa en un campo propio\r\n      // para que group1 tenga su ajuste fino independiente sin volver a\r\n      // leer las keys universales.\r\n      varGroupOffsetX: 0, varGroupOffsetY: 0, varGroupScale: 1,\r\n    },\r\n  },\r\n\r\n  replay: {\r\n    id: 'replay',\r\n    label: 'Replay (con sponsor)',\r\n    category: 'VAR / Replay',\r\n    layer: 'bottom-left-secondary',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'sponsor', label: 'Sponsor REPLAY', type: FIELD_TYPES.SELECT, options: SPONSOR_OPTIONS.var },\r\n    ],\r\n    defaults: {\r\n      sponsor: '',\r\n      // \"sponsorOffsetX/Y/Scale\" (2026-08-31, pedido explicito del\r\n      // usuario): unico elemento visual de este modulo, nunca tuvo ajuste.\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // MOSCA\r\n  // ---------------------------------------------------------------------\r\n  // Sin campos: la franja que antes mostraba un texto editable a mano\r\n  // ahora muestra la hora actual del sistema, generada sola por el\r\n  // renderer (ver program/js/renderers/bug.js) \u2014 Master Control solo\r\n  // necesita Tomar/Sacar del aire, nada que tipear.\r\n  bug: {\r\n    id: 'bug',\r\n    label: 'Mosca LocalStrike',\r\n    category: 'Mosca',\r\n    layer: 'top-right',\r\n    sequencedReveal: true,\r\n    // \"clock\" (2026-08-15, auditoria completa): unico texto dinamico real\r\n    // de este modulo (hora del sistema, sin campo tipeable) -> ADJUST_ONLY.\r\n    // \".ov-mosca-vivo\" (\"VIVO\") NO se incluye a proposito: esta oculto por\r\n    // CSS (display:none, ver overlay.css) porque el \"VIVO\" real ya viene\r\n    // horneado en el video (ver program/js/renderers/bug.js) -- no es texto\r\n    // visible en Program, agregarle un editor no tendria ningun efecto.\r\n    fields: [\r\n      { key: 'clock', label: 'Hora (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: { textAdjust: textAdjustDefaults('clock') },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // ZOCALOS\r\n  // ---------------------------------------------------------------------\r\n  // DESACTIVADO TEMPORALMENTE a pedido explicito del usuario (2026-07-31):\r\n  // falta reemplazar el asset. Toda la logica (schema, renderer en\r\n  // program/js/renderers/longSimple.js, registro en\r\n  // program/js/renderers/index.js, nodo en program/index.html) se\r\n  // conserva intacta, solo comentada \u2014 al no estar en MODULES/MODULE_IDS\r\n  // el modulo desaparece solo del panel de Master Control (generado desde\r\n  // este schema) y del loop de program/js/main.js, sin tocar ningun otro\r\n  // archivo. Para reactivar cuando haya asset nuevo: descomentar este\r\n  // bloque, el import+entrada en program/js/renderers/index.js, y el\r\n  // <div id=\"mod-longSimple\"> en program/index.html (buscar \"DESACTIVADO\r\n  // TEMPORALMENTE\" en cada archivo).\r\n  // longSimple: {\r\n  //   id: 'longSimple',\r\n  //   label: 'Zocalo largo simple',\r\n  //   category: 'Zocalos',\r\n  //   layer: 'bottom-wide',\r\n  //   sequencedReveal: true,\r\n  //   fields: [\r\n  //     { key: 'text', label: 'Texto', type: FIELD_TYPES.TEXT },\r\n  //   ],\r\n  //   defaults: { text: '' },\r\n  // },\r\n\r\n  longDouble: {\r\n    id: 'longDouble',\r\n    label: 'Zocalo largo doble',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'line1', label: 'Titulo principal', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'line2', label: 'Subtitulo / bajada', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      line1: '', line2: '', textPresets: [],\r\n      textAdjust: textAdjustDefaults('line1', 'line2'),\r\n    },\r\n  },\r\n\r\n  shortSimple: {\r\n    id: 'shortSimple',\r\n    label: 'Zocalo corto simple',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'text', label: 'Texto', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      text: '', textPresets: [],\r\n      textAdjust: textAdjustDefaults('text'),\r\n    },\r\n  },\r\n\r\n  // \"airMode\" (2026-08-06, pedido explicito del usuario: poder mostrar uno\r\n  // o dos zocalos cortos dobles a la vez, ej. dos relatores juntos):\r\n  // 'single' reusa exactamente la logica/posicion de siempre (\"name\"/\r\n  // \"role\"); 'double' muestra dos instancias independientes del mismo\r\n  // renderer/asset lado a lado (\"double1\"/\"double2\"), ver\r\n  // program/js/renderers/shortDouble.js. Sin \"fields\" generico: el panel\r\n  // dedicado (master-control/js/short-double-panel.js) tiene que mostrar\r\n  // las tres secciones (individual + doble 1 + doble 2) y los controles de\r\n  // aire propios -- mismo criterio que Formacion (fields: []).\r\n  shortDouble: {\r\n    id: 'shortDouble',\r\n    label: 'Zocalo corto doble',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      // \"name\"/\"role\" a nivel raiz ELIMINADOS (2026-09-10, pedido explicito\r\n      // del usuario: \"que el z\u00F3calo doble 1 sea el z\u00F3calo individual...\r\n      // que en el panel no me muestre 3 opciones de z\u00F3calo\"). Antes existia\r\n      // un tercer slot de datos independiente (\"Z\u00D3CALO INDIVIDUAL\", sin\r\n      // relacion con \"double1\"/\"double2\") que el modo \"single\" del renderer\r\n      // leia aparte -- ahora el modo \"single\" reutiliza directamente\r\n      // \"double1\" (ver program/js/renderers/shortDouble.js), asi que mandar\r\n      // un solo zocalo o mandar dos es SIEMPRE la misma fuente de datos\r\n      // (double1, double1+double2), sin una tercera copia paralela.\r\n      airMode: 'single',\r\n      double1: { name: '', role: '' },\r\n      double2: { name: '', role: '' },\r\n      textPresets: [],\r\n      // Claves con ruta \"grupo.campo\" para los textos de los pares del\r\n      // modo doble -- distinguen el ajuste de \"double1.name\" del de\r\n      // \"double2.name\" aunque compartan las mismas clases CSS (ver\r\n      // program/js/renderers/shortDouble.js), porque son campos de datos\r\n      // independientes, no un unico elemento reutilizado. \"double1.role\"/\r\n      // \"double2.role\" quedan (el renderer los sigue leyendo -- el campo\r\n      // \"Sub texto\" solo se elimin\u00F3 del PANEL, ver short-double-panel.js)\r\n      // aunque ya no tengan textbox propio en Master Control.\r\n      textAdjust: textAdjustDefaults('double1.name', 'double1.role', 'double2.name', 'double2.role'),\r\n    },\r\n  },\r\n\r\n  // Sin campos de equipo propios: equipo A/B (nombre, abreviatura y\r\n  // escudo) se leen en vivo de \"scoreboard\" (`live: true`, mismo patron\r\n  // que \"vs\" mas arriba) \u2014 el VS\r\n  // siempre anuncia el mismo partido cargado en el marcador principal, no\r\n  // hace falta volver a elegir los equipos aca.\r\n  vs: {\r\n    id: 'vs',\r\n    label: 'Zocalo VS compacto',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-center',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'renglon',\r\n        label: 'Altura de renglon',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'normal', label: 'Normal' },\r\n          { id: 'alto', label: 'Alto' },\r\n          { id: 'medio', label: 'Medio' },\r\n          { id: 'fino', label: 'Fino' },\r\n        ],\r\n      },\r\n      {\r\n        // \"CONTENIDO CENTRAL\" (2026-09-10, pedido explicito del usuario:\r\n        // \"simplificar VS COMPACTO\" -- eliminados el selector \"Estado del\r\n        // encuentro\" y el selector \"Contenido central: Resultado/Estado vs\r\n        // Sponsor\", que en los hechos no controlaba nada real en el\r\n        // renderer, ver program/js/renderers/vs.js). Texto 100% manual: lo\r\n        // que el operador escribe es EXACTAMENTE lo que se renderiza en el\r\n        // renglon central, sin ningun preset de respaldo -- vacio renderiza\r\n        // vacio, nunca se fuerza un valor.\r\n        key: 'statusTexto',\r\n        label: 'Contenido central (texto libre \u2014 vac\u00EDo no muestra nada)',\r\n        type: FIELD_TYPES.TEXT,\r\n        adjustable: true,\r\n      },\r\n      {\r\n        key: 'sponsor',\r\n        label: 'Sponsor Zocalo Medio',\r\n        type: FIELD_TYPES.SELECT,\r\n        options: SPONSOR_OPTIONS.vs_compact,\r\n      },\r\n      // \"nameA\"/\"nameB\"/\"goalA\"/\"goalB\" (2026-08-15, auditoria completa):\r\n      // nombre y gol de cada equipo se derivan en vivo de \"scoreboard\" (sin\r\n      // campo propio), pero necesitan su propio ajuste de posicion/tama\u00F1o.\r\n      { key: 'nameA', label: 'Nombre equipo local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'nameB', label: 'Nombre equipo visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'goalA', label: 'Gol local (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n      { key: 'goalB', label: 'Gol visitante (posici\u00F3n/tama\u00F1o)', type: FIELD_TYPES.ADJUST_ONLY },\r\n    ],\r\n    defaults: {\r\n      renglon: 'normal', statusTexto: '', sponsor: '',\r\n      // \"MOSTRAR GOLES\" (2026-10-22, pedido explicito del usuario, SOLO GLA):\r\n      // 'con' = goles en vivo del Marcador (como siempre); 'sin' = oculta\r\n      // unicamente los dos goles. El control solo aparece en GLA (ver\r\n      // master-control/js/main.js) y el renderer solo lo lee en GLA.\r\n      mostrarGoles: 'con',\r\n      textAdjust: textAdjustDefaults('statusTexto', 'nameA', 'nameB', 'goalA', 'goalB'),\r\n      // \"localCrestOffset*/awayCrestOffset*/sponsorOffset*\" (2026-08-31,\r\n      // auditoria completa): ninguno de los 3 tenia ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n    },\r\n  },\r\n\r\n  // Z\u00D3CALO VS (2026-10-09, pedido explicito del usuario, SOLO Argentina\r\n  // Streamers -- GLA no lo ve en su navegacion): modulo independiente con 2\r\n  // variantes de asset (\"solo\" = escudo/nombre VS nombre/escudo; \"goles\" =\r\n  // ademas el gol de cada lado). Equipos, escudos y goles NO tienen estado\r\n  // propio: se leen en vivo de \"scoreboard\" (`live: true`, 5to argumento del\r\n  // renderer, mismo patron que \"vs\"/marcadorPenales). Solo guarda lo propio\r\n  // del modulo: variante, nombre AUTOM\u00C1TICO/MANUAL por lado (shared/\r\n  // broadcast-names.js) y ajustes de composicion. Los ajustes son POR\r\n  // VARIANTE (claves \"solo*\"/\"goles*\": las dos piezas tienen la pastilla\r\n  // central de distinto ancho, asi que nombres/goles no caen en el mismo\r\n  // lugar) y los escudos ademas POR EQUIPO (\"crestByTeam[soloLocal|\r\n  // soloAway|golesLocal|golesAway][teamId]\", ver \"crestSlot\" en\r\n  // shared/adjust-registry.js). El \"VS\" viene dibujado dentro del asset.\r\n  zocaloVs: {\r\n    id: 'zocaloVs',\r\n    label: 'Z\u00F3calo VS',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-center',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      variante: 'solo',\r\n      nombreLocalMode: 'auto', nombreLocalManual: '',\r\n      nombreVisitanteMode: 'auto', nombreVisitanteManual: '',\r\n      textAdjust: textAdjustDefaults(\r\n        'soloNombreLocal', 'soloNombreVisitante',\r\n        'golesNombreLocal', 'golesGolLocal', 'golesGolVisitante', 'golesNombreVisitante',\r\n      ),\r\n      soloLocalCrestOffsetX: 0, soloLocalCrestOffsetY: 0, soloLocalCrestScale: 1,\r\n      soloAwayCrestOffsetX: 0, soloAwayCrestOffsetY: 0, soloAwayCrestScale: 1,\r\n      golesLocalCrestOffsetX: 0, golesLocalCrestOffsetY: 0, golesLocalCrestScale: 1,\r\n      golesAwayCrestOffsetX: 0, golesAwayCrestOffsetY: 0, golesAwayCrestScale: 1,\r\n      crestByTeam: { soloLocal: {}, soloAway: {}, golesLocal: {}, golesAway: {} },\r\n    },\r\n  },\r\n\r\n  // Sin campo de equipo propio: escudo local/visitante se leen en vivo de\r\n  // \"scoreboard\" (`live: true`, mismo patron que \"vs\" mas arriba) \u2014 el\r\n  // separador ya horneado en el asset divide ambos escudos, no hace falta\r\n  // volver a elegir equipo aca. \"texto1\"/\"texto2\" son independientes, cada\r\n  // uno controla su propio zocalo central (mismo patron que \"line1\"/\r\n  // \"line2\" de longDouble). El sector derecho del asset queda sin usar a\r\n  // proposito (pedido explicito del usuario, preparado para el futuro).\r\n  zocaloFinalDiv: {\r\n    id: 'zocaloFinalDiv',\r\n    label: 'Zocalo Compuesto con Equipos',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'texto1', label: 'TEXTO 1', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'texto2', label: 'TEXTO 2', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      texto1: '', texto2: '', sponsorsRotation: [],\r\n      escudosFuente: 'MARCADOR', customTeamA: '', customTeamB: '',\r\n      shieldPresets: [], textPresets: [],\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2')\r\n    },\r\n  },\r\n\r\n  // Misma logica que \"zocaloFinalDiv\" de arriba, base tomada de ese modulo\r\n  // (mismo asset central/derecho, mismo comportamiento de texto1/texto2 y\r\n  // animaciones) -- unica diferencia real: el sector izquierdo no tiene\r\n  // escudos ni separador, en su lugar va un unico logo GLA estatico (sin\r\n  // datos del Marcador, no hay \"live\" por esa parte -- solo se mantiene\r\n  // por si en el futuro se agrega algo que dependa de scoreboard, hoy no\r\n  // se usa). Sin campo de logo en el panel: el logo es fijo, no elegible.\r\n  zocaloFinal: {\r\n    id: 'zocaloFinal',\r\n    label: 'Zocalo Compuesto Logo GLA',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    sequencedReveal: true,\r\n    fields: [\r\n      { key: 'texto1', label: 'TEXTO 1', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'texto2', label: 'TEXTO 2', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: { texto1: '', texto2: '', sponsorsRotation: [], textPresets: [], textAdjust: textAdjustDefaults('texto1', 'texto2') },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // Z\u00D3CALO COMPUESTO (unificado) -- 2026-08-16, pedido explicito del\r\n  // usuario: \"no quiero duplicar dos modulos casi id\u00E9nticos\". Reemplaza en\r\n  // la navegacion a \"zocaloFinal\"/\"zocaloFinalDiv\" (ambos arriba: quedan\r\n  // registrados y con su renderer intacto para no perder datos/presets\r\n  // viejos ya persistidos, pero ocultos de la lista de tabs -- ver\r\n  // HIDDEN_FROM_NAV_IDS en master-control/js/main.js, mismo patron que\r\n  // \"gol\"). \"tipo\" elige que sector izquierdo mostrar (EQUIPOS: escudos en\r\n  // vivo del Marcador, mismo campo/logica que zocaloFinalDiv; LOGO: logo\r\n  // GLA fijo, mismo criterio que zocaloFinal) -- texto1/texto2/sponsors/\r\n  // presets/ajustes de composicion y de texto son UNA sola copia\r\n  // compartida entre ambos tipos (program/js/renderers/zocaloCompuesto.js\r\n  // hace el swap de video+contenido, ver ese archivo para el detalle de\r\n  // \"transicion segura\" al cambiar tipo estando al aire).\r\n  zocaloCompuesto: {\r\n    id: 'zocaloCompuesto',\r\n    label: 'Z\u00F3calo Compuesto',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-wide',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    fields: [\r\n      {\r\n        key: 'tipo', label: 'Tipo', type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'equipos', label: 'EQUIPOS (escudos del Marcador)' },\r\n          { id: 'logo', label: 'LOGO GLA' },\r\n        ],\r\n      },\r\n      { key: 'texto1', label: 'TEXTO 1', type: FIELD_TYPES.TEXT, adjustable: true },\r\n      { key: 'texto2', label: 'TEXTO 2', type: FIELD_TYPES.TEXT, adjustable: true },\r\n    ],\r\n    defaults: {\r\n      tipo: 'equipos',\r\n      texto1: '', texto2: '', sponsorsRotation: [],\r\n      escudosFuente: 'MARCADOR', customTeamA: '', customTeamB: '',\r\n      shieldPresets: [], textPresets: [], completePresets: [],\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2'),\r\n      // \"localCrestOffset*/awayCrestOffset*/logoOffset*\" (2026-08-31,\r\n      // auditoria completa): ninguno tenia ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      logoOffsetX: 0, logoOffsetY: 0, logoScale: 1,\r\n      // \"sponsorsOffsetX/Y/Scale\" (2026-09-24, pedido explicito del\r\n      // usuario: \"TODOS los sponsors del rotativo deben compartir UN UNICO\r\n      // ajuste de composicion\"). Reemplaza \"sponsor1Offset*\"/\"sponsor2Offset*\"\r\n      // (uno por cada uno de los 2 <img> del crossfade interno, ver\r\n      // program/js/renderers/zocaloCompuesto.js) -- con dos ajustes\r\n      // independientes, el mismo sponsor \"saltaba\" de posicion/escala segun\r\n      // en cual de los 2 slots del rotativo le tocara aparecer. Ahora los 2\r\n      // <img> comparten el mismo \"data-adjust\" (ver ese renderer), asi que\r\n      // ESTE unico valor se aplica a cualquiera de los dos por igual --\r\n      // mismo mecanismo ya usado para columnas de tablas (grupos/sideTable/\r\n      // posiciones), que tambien aplican un unico ajuste a varios nodos con\r\n      // el mismo id. Base elegida: la posicion COMUN ya guardada del modulo\r\n      // (0/0/1, ver shared/theme-layouts/gla.json) -- ni sponsor1 ni\r\n      // sponsor2 tenian una posicion distinta CONFIRMADA con \"Guardar\r\n      // posici\u00F3n\" (solo ajustes en vivo sin guardar, y distintos entre si),\r\n      // asi que no habia ninguna base real que preservar sin inventarla.\r\n      sponsorsOffsetX: 0, sponsorsOffsetY: 0, sponsorsScale: 1,\r\n    },\r\n  },\r\n\r\n  // \"zocaloCompuestoEquipos\" (2026-09-10, UNIFICADO con \"zocaloCompuestoLogo\"\r\n  // -- pedido explicito del usuario: \"es todo lo mismo, solo cambia el\r\n  // asset... necesito que sean un solo m\u00F3dulo, con la opci\u00F3n de men\u00FA\r\n  // desplegable CON LOGO LOCALSTRIKE | CON EQUIPOS\"). \"tipo\" decide que\r\n  // sector izquierdo se manda: EQUIPOS (escudos en vivo del Marcador, con\r\n  // linea separadora) o LOGO (logo LocalStrike fijo, sin linea) -- resto\r\n  // (texto1/texto2/subColor/sponsor/presets/composicion) es UNA sola copia\r\n  // compartida entre ambos tipos, mismo criterio ya probado en\r\n  // \"zocaloCompuesto\" (el modulo de GLA, sin relacion con este -- assets\r\n  // completamente distintos, ver program/js/renderers/zocaloCompuesto.js\r\n  // para el patron de \"transicion segura al cambiar tipo\" que este\r\n  // renderer reusa). \"zocaloCompuestoLogo\" (mas abajo) queda registrado\r\n  // SOLO para no perder datos/presets ya persistidos de quien lo haya\r\n  // usado antes de esta unificacion -- oculto de toda navegacion (ver\r\n  // HIDDEN_FROM_NAV_IDS en master-control/js/main.js, mismo patron que\r\n  // \"zocaloFinal\"/\"zocaloFinalDiv\"/\"gol\"), nunca mas editable directo.\r\n  zocaloCompuestoEquipos: {\r\n    id: 'zocaloCompuestoEquipos',\r\n    label: 'Z\u00F3calo Compuesto',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    live: true,\r\n    sequencedReveal: true,\r\n    // \"fields: []\" (2026-09-02, auditoria de wiring): el CONTENIDO\r\n    // (texto1/texto2/sponsor) lo muestra el panel dedicado\r\n    // (master-control/js/zocalo-compuesto-panel.js) -- declararlos aca\r\n    // tambien los duplicaba (2 cajas \"TEXTO MAIN\" en pantalla, una\r\n    // generica sin ACTUALIZAR y otra del panel). Mismo criterio que\r\n    // \"formacionEquipos\" mas arriba.\r\n    fields: [],\r\n    defaults: {\r\n      tipo: 'equipos',\r\n      // \"subColor\" (2026-09-02, pedido explicito del usuario): SOLO afecta\r\n      // texto2/SUBTEXTO -- texto1/MAIN se mantiene siempre blanco fijo, sin\r\n      // campo propio, tal como ya estaba. \"sponsorsRotation\" reemplaza al\r\n      // dropdown unico \"sponsor\" (mismo campo/mismo shape que ya usa\r\n      // zocaloCompuesto/zocaloFinal/zocaloFinalDiv -- array de ids,\r\n      // reutiliza el panel/renderer de rotacion existentes en vez de\r\n      // inventar uno nuevo).\r\n      texto1: '', texto2: '', subColor: 'negro', sponsorsRotation: [], textPresets: [],\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n      // \"logoOffsetX/Y/Scale\" (2026-09-10, fusionado desde\r\n      // \"zocaloCompuestoLogo\"): posicion propia del logo LocalStrike,\r\n      // independiente de la posicion de los escudos.\r\n      logoOffsetX: 0, logoOffsetY: 0, logoScale: 1,\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2'),\r\n      crestByTeam: { local: {}, away: {} },\r\n    },\r\n  },\r\n\r\n  // LEGACY -- ver comentario en \"zocaloCompuestoEquipos\" arriba. No editable\r\n  // desde Master Control (oculto de toda navegacion), solo conserva datos\r\n  // ya persistidos de antes de la unificacion 2026-09-10.\r\n  zocaloCompuestoLogo: {\r\n    id: 'zocaloCompuestoLogo',\r\n    label: 'Z\u00F3calo Compuesto con Logo',\r\n    category: 'Zocalos',\r\n    layer: 'bottom-left',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      texto1: '', texto2: '', subColor: 'negro', sponsorsRotation: [], textPresets: [],\r\n      logoOffsetX: 0, logoOffsetY: 0, logoScale: 1,\r\n      sponsorOffsetX: 0, sponsorOffsetY: 0, sponsorScale: 1,\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n      textAdjust: textAdjustDefaults('texto1', 'texto2'),\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // GRUPOS\r\n  // ---------------------------------------------------------------------\r\n  // Un unico modulo con un selector de variante (\"variante\": que PNG\r\n  // mostrar, Grupo 1 o Grupo 2) en vez de dos modulos separados \u2014 mismo\r\n  // criterio que Tarjeta (un campo elige que asset/variante se usa). Sin\r\n  // \"fields\" genericos: el selector de variante y las filas (escudo +\r\n  // nombre automaticos desde el catalogo de equipos + puntos) viven en un\r\n  // panel dedicado (master-control/js/grupos-panel.js) porque la cantidad\r\n  // de filas y el desplegable de equipo por fila no entran en el editor\r\n  // generico de schema (FIELD_TYPES.LIST no soporta un SELECT por fila ni\r\n  // una cantidad fija sin agregar/quitar \u2014 ver docs/ARCHITECTURE.md).\r\n  // Cada variante guarda su propio arreglo de filas por separado (no\r\n  // comparten datos entre si): son grupos de equipos distintos, cambiar\r\n  // el selector no tiene por que pisar lo cargado en el otro grupo.\r\n  // Cantidad de filas medida directamente sobre cada PNG (alfa/color real,\r\n  // no a ojo): ambos assets traen exactamente 3 casilleros de equipo.\r\n  //\r\n  // \"posicion\" (agregado 2026-07-31, a pedido explicito del usuario):\r\n  // modo de salida \u2014 'placaL' (posicion aprobada original: Grupo 1 y\r\n  // Grupo 2 se muestran juntos, apilados) o 'fullscreenDerecha'/\r\n  // 'fullscreenIzquierda' (un unico grupo, elegido con \"variante\", en la\r\n  // esquina inferior correspondiente). \"variante\" pasa a ser relevante\r\n  // solo en los modos fullscreen (\"Grupo visible\" en el panel); en modo\r\n  // Placa L se ignora porque se muestran ambos grupos siempre. El orden\r\n  // de cada tabla (mayor a menor puntaje) NO se persiste por separado:\r\n  // se recalcula siempre en el renderer (program/js/renderers/grupos.js)\r\n  // a partir de \"puntos\", con un sort estable para que los empates\r\n  // conserven el orden de carga original sin inventar un criterio de\r\n  // desempate adicional.\r\n  grupos: {\r\n    id: 'grupos',\r\n    label: 'Grupos',\r\n    category: 'Grupos',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      posicion: 'placaL',\r\n      variante: 'grupo1',\r\n      grupo1: { filas: [{ teamId: '', puntos: '' }, { teamId: '', puntos: '' }, { teamId: '', puntos: '' }] },\r\n      grupo2: { filas: [{ teamId: '', puntos: '' }, { teamId: '', puntos: '' }, { teamId: '', puntos: '' }] },\r\n      ultimaActualizacionWeb: '',\r\n      // Ajuste column-level compartido entre Grupo 1 y Grupo 2 (2026-08-15,\r\n      // auditoria completa) -- ver master-control/js/grupos-panel.js.\r\n      textAdjust: textAdjustDefaults('nombre', 'puntos'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): mismo\r\n      // criterio column-level que \"nombre\"/\"puntos\" -- un unico ajuste\r\n      // mueve el escudo de TODAS las filas visibles (Grupo 1 y Grupo 2\r\n      // por igual), nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // ---------------------------------------------------------------------\r\n  // Sin asset nuevo todavia (se mantienen del sistema anterior)\r\n  // ---------------------------------------------------------------------\r\n  sideTable: {\r\n    id: 'sideTable',\r\n    label: 'Resultados',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'RESULTADOS',\r\n      posicion: 'placaL',\r\n      // PARTIDOS EVENTO / SORTEO (2026-10-22, SOLO GLA -- ver\r\n      // syncBracketCrestsFromGrupos en server/state.js): modo activo y la\r\n      // lista guardada del modo inactivo ({ encuentros, tanda } o null).\r\n      modoPartidos: 'evento',\r\n      partidosEvento: null,\r\n      partidosSorteo: null,\r\n      // Maximo 6 brackets visibles a la vez en Program; con mas de 6\r\n      // encuentros cargados, \"tanda\" elige que ventana de 6 se muestra\r\n      // ('tanda1' = partidos 1-6, 'tanda2' = partidos 4 en adelante) --\r\n      // ver program/js/renderers/sideTable.js.\r\n      tanda: 'tanda1',\r\n      encuentros: [\r\n        {\r\n          teamA: '',\r\n          teamB: '',\r\n          scoreA: '0',\r\n          scoreB: '0',\r\n          status: 'final',\r\n          hora: '',\r\n          // Titulo individual por encuentro (2026-08-15, pedido explicito\r\n          // del usuario: \"CUARTOS 1\", \"SEMIS 1\", \"GRAN FINAL\", etc.) --\r\n          // texto propio de CADA encuentro (a diferencia de golLocal/\r\n          // estado/etc., que son campos por-encuentro pero de tipo fijo),\r\n          // ver program/js/renderers/sideTable.js.\r\n          titulo: '',\r\n          // \"penalesA\"/\"penalesB\" (2026-08-16, pedido explicito del\r\n          // usuario: soportar \"6(3) - 6(1)\"): OPCIONALES, string vacio =\r\n          // sin definicion por penales -- Program muestra solo \"6 - 6\".\r\n          // Con ambos cargados, el numero de penales sale entre parentesis\r\n          // y mas chico junto al resultado (ver sideTable.js/overlay.css).\r\n          penalesA: '',\r\n          penalesB: ''\r\n        }\r\n      ],\r\n      faseWeb: 'grupos',\r\n      snapshotsWeb: {},\r\n      ultimaActualizacionWeb: '',\r\n      // Ajuste column-level (2026-08-15, auditoria completa): ver\r\n      // master-control/js/resultados-panel.js. \"tituloBracket\" es el\r\n      // ajuste de posicion/tama\u00F1o del titulo individual por encuentro\r\n      // (arriba del estado/hora); se llama distinto de \"titulo\" porque ese\r\n      // key ya lo usa el titulo GENERAL de todo el modulo (arriba de la\r\n      // tabla, ej. \"RESULTADOS\").\r\n      textAdjust: textAdjustDefaults('titulo', 'golLocal', 'golVisitante', 'estado', 'estadoFullscreen', 'tituloBracket'),\r\n      // \"crestLocalOffset*/crestVisitanteOffset*\" (2026-08-31, auditoria\r\n      // completa): ajuste column-level (mueve el escudo de TODOS los\r\n      // encuentros visibles) -- nunca tuvo ajuste propio.\r\n      crestLocalOffsetX: 0, crestLocalOffsetY: 0, crestLocalScale: 1,\r\n      crestVisitanteOffsetX: 0, crestVisitanteOffsetY: 0, crestVisitanteScale: 1,\r\n    },\r\n  },\r\n\r\n  estrellas: {\r\n    id: 'estrellas',\r\n    label: 'Estrellas',\r\n    category: 'Placas',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'LOS MEJORES DE CADA EQUIPO',\r\n      fuente: 'liga',\r\n      snapshots: {},\r\n      formatoJugador: 'numero_apodo',\r\n      localJugador: null,\r\n      localNombre: '',\r\n      localG: 0,\r\n      localA: 0,\r\n      localPJ: 0,\r\n      visitanteJugador: null,\r\n      visitanteNombre: '',\r\n      visitanteG: 0,\r\n      visitanteA: 0,\r\n      visitantePJ: 0,\r\n      ultimaActualizacionWeb: '',\r\n      // \"localJugadorId\"/\"visitanteJugadorId\" (2026-09-10, pedido explicito\r\n      // del usuario: \"Estrellas... tiene que hacer la misma l\u00F3gica de Ficha\r\n      // Jugador\" -- identidad ESTABLE del jugador del plantel central de\r\n      // Argentina Streamers, ver server/playerRosters.js), para poder\r\n      // sincronizar Goles/Asistencias/Partidos Jugados contra\r\n      // argentinastreamers.com reusando el mismo endpoint/logica que Ficha\r\n      // Jugador (server/argentinaStreamersPlayerStats.js) -- vacio para un\r\n      // jugador tipeado a mano o para GLA (que sigue con su propio sync de\r\n      // gla.futbol, sin tocar).\r\n      localJugadorId: '',\r\n      visitanteJugadorId: '',\r\n      localWebSyncStatus: '', localWebSyncError: '',\r\n      visitanteWebSyncStatus: '', visitanteWebSyncError: '',\r\n      // 9 ajustes individuales (2026-08-15, auditoria completa): estructura\r\n      // fija (2 jugadores), cada texto se ajusta por separado -- ver\r\n      // master-control/js/estrellas-panel.js.\r\n      textAdjust: textAdjustDefaults(\r\n        'titulo',\r\n        'localNombre', 'localG', 'localA', 'localPJ',\r\n        'visitanteNombre', 'visitanteG', 'visitanteA', 'visitantePJ',\r\n      ),\r\n      // \"localCrestOffset*/visitanteCrestOffset*\" (2026-08-31, auditoria\r\n      // completa): los 2 escudos nunca tuvieron ajuste propio.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      visitanteCrestOffsetX: 0, visitanteCrestOffsetY: 0, visitanteCrestScale: 1,\r\n    },\r\n  },\r\n\r\n  // Tabla de posiciones: la liga tiene 11 equipos, \"filas\" guarda los 11\r\n  // (posicion real 1-11, nunca renumerada) aunque el asset solo tenga\r\n  // casilleros para una pagina a la vez. \"pagina\" ('pagina1' = posiciones\r\n  // 1-6 con posiciones-alpha.mp4, 'pagina2' = posiciones 7-11 con\r\n  // posiciones-5-alpha.mp4, ver program/js/renderers/posiciones.js) decide\r\n  // que subset de \"filas\" se compone en Program -- una unica sincronizacion\r\n  // web (o carga manual) llena las 11, el selector solo elige que ventana\r\n  // mostrar, no dispara una segunda consulta. Columnas numericas reales\r\n  // impresas en el grafico -- PTS, PJ, G, GXP, PXP, P, GF, GC, DG -- sin\r\n  // inventar ni recortar siglas. \"equipo\" guarda solo el ID del catalogo\r\n  // global (shared/teams.js); escudo y nombre completo se derivan siempre\r\n  // de ahi, nunca se cargan a mano. El orden de \"filas\" es el oficial tal\r\n  // como llega (de la web o cargado a mano): Program ya no recalcula un\r\n  // ranking propio por PTS/DG, solo filtra por rango de posicion y ordena\r\n  // por el campo \"posicion\" (ver renderer).\r\n  posiciones: {\r\n    id: 'posiciones',\r\n    label: 'Tabla Global',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'POSICIONES',\r\n      pagina: 'pagina1',\r\n      filas: [\r\n        { posicion: 1, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 2, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 3, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 4, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 5, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 6, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 7, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 8, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 9, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 10, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n        { posicion: 11, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0, pxp: 0, p: 0, gf: 0, gc: 0, dg: 0 },\r\n      ],\r\n      // Ajuste column-level (2026-08-15, auditoria completa): un unico\r\n      // control por columna se aplica a todas las filas visibles -- ver\r\n      // master-control/js/posiciones-panel.js.\r\n      textAdjust: textAdjustDefaults('titulo', 'numero', 'equipo', 'pts', 'pj', 'g', 'gxp', 'pxp', 'p', 'gf', 'gc', 'dg'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): mismo\r\n      // criterio column-level -- el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  posicionesTorneo: {\r\n    id: 'posicionesTorneo',\r\n    label: 'Posiciones Torneo',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'POSICIONES TORNEO',\r\n      pagina: 'pagina1',\r\n      filas: Array.from({ length: 6 }, (_, index) => ({\r\n        posicion: index + 1, teamId: '', puntos: 0, pj: 0, g: 0, gxp: 0,\r\n        pxp: 0, p: 0, gf: 0, gc: 0, dg: 0,\r\n      })),\r\n      ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'numero', 'equipo', 'pts', 'pj', 'g', 'gxp', 'pxp', 'p', 'gf', 'gc', 'dg'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): mismo\r\n      // criterio column-level que \"posiciones\" -- el escudo nunca tuvo\r\n      // ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // \"cronogramaHoy\"/\"resultadosParciales\"/\"historial\" (2026-09-02):\r\n  // modulos de BRACKETS para Argentina Streamers, entregados por un\r\n  // agente concurrente -- integrados tal cual el handoff (ver\r\n  // docs/PATCH_SHARED_CLAUDE.md y docs/BRACKETS_ARGENTINA_STREAMERS.md),\r\n  // sin modificar su forma de datos/logica. Renderer y panel dedicados\r\n  // propios, sin tocar goleadores/asistidores/jugadores/fichaJugador.\r\n  cronogramaHoy: {\r\n    id: 'cronogramaHoy',\r\n    label: 'Cronograma Hoy',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    // \"encuentros\" (2026-09-02, reconstruido desde cero -- ver informe):\r\n    // la implementacion anterior (2 partidos manuales, tarjeta fabricada\r\n    // en CSS) se descarto por completo, pedido explicito del usuario (\"no\r\n    // reutilizar la placa vertical falsa anterior\", \"no quiero selector\r\n    // duplicado de equipos\"). Ahora hay un PNG real\r\n    // (cronograma-hoy.png, VS_DEFAULT entregado) con UN solo partido.\r\n    // \"teamLocal\"/\"teamVisitante\" (2026-09-04, cambio explicito del\r\n    // usuario: \"quiero poder armar manualmente un enfrentamiento\" --\r\n    // reemplaza la herencia automatica de scoreboard.teamA/teamB de\r\n    // arriba, que ya no se usa) -- seleccion manual desde el panel\r\n    // dedicado, catalogo Argentina Streamers. \"presets\" guarda\r\n    // combinaciones completas (titulo+local+visitante, NO posiciones,\r\n    // que siguen siendo layout) -- misma filosofia/helper que los presets\r\n    // de texto de zocalos (ver master-control/js/presets-helper.js).\r\n    // \"crestByTeam\" seedeado por teamId real (mismo patron que\r\n    // zocaloCompuestoEquipos), asi la posicion de cada escudo sobrevive a\r\n    // que cambie el equipo elegido.\r\n    defaults: {\r\n      titulo: 'PR\u00D3XIMO PARTIDO',\r\n      teamLocal: '',\r\n      teamVisitante: '',\r\n      presets: [],\r\n      textAdjust: textAdjustDefaults('titulo'),\r\n      crestByTeam: { local: {}, away: {} },\r\n    },\r\n  },\r\n\r\n  resultadosParciales: {\r\n    id: 'resultadosParciales',\r\n    label: 'Resultados Parciales',\r\n    category: 'Brackets',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      titulo: 'RESULTADOS PARCIALES',\r\n      // \"encuentros\" (2 partidos manuales con estado): NO se borra --\r\n      // pedido explicito del usuario (\"si ya tiene su propia l\u00F3gica de\r\n      // datos, no la destruyas\"). Queda sin uso por el renderer nuevo\r\n      // (2026-09-03, reconstruido sobre VS_RESULTADO.png real: un solo\r\n      // partido, escudos+resultado heredados en vivo del Marcador, mismo\r\n      // criterio que vsResultado/cronogramaHoy -- confirmado con el\r\n      // usuario). Se conserva por si se reactiva un uso futuro.\r\n      encuentros: [\r\n        { teamA: 'argentina-streamers', teamB: 'oxen', scoreA: '2', scoreB: '1', estado: 'FINAL' },\r\n        { teamA: 'peru-creadores', teamB: 'argentina-streamers-fem', scoreA: '0', scoreB: '0', estado: 'EN JUEGO' },\r\n      ],\r\n      textAdjust: textAdjustDefaults('titulo', 'teamA1', 'teamB1', 'scoreA1', 'scoreB1', 'estado1', 'teamA2', 'teamB2', 'scoreA2', 'scoreB2', 'estado2', 'scoreLocal', 'scoreVisitante'),\r\n      // \"localCrestOffset*/awayCrestOffset*\" + \"crestByTeam\" (2026-09-03):\r\n      // escudos heredados en vivo del Marcador (sb.teamA/teamB), mismo\r\n      // mecanismo \"crestTeam\" que ya usan vsResultado/cronogramaHoy (ver\r\n      // resolveCrestTeamOverride en program/js/main.js) -- el offset\r\n      // flat es el default/fallback, \"crestByTeam\" guarda la posicion\r\n      // propia por equipo una vez que el operador la ajusta y guarda.\r\n      localCrestOffsetX: 0, localCrestOffsetY: 0, localCrestScale: 1,\r\n      awayCrestOffsetX: 0, awayCrestOffsetY: 0, awayCrestScale: 1,\r\n      crestByTeam: { local: {}, away: {} },\r\n    },\r\n  },\r\n\r\n  // \"historial\" (2026-09-02, reconstruido desde cero -- ver informe): la\r\n  // version anterior de Antigravity (categorias + paginacion + tarjeta\r\n  // fabricada en CSS) se descarto por completo, pedido explicito del\r\n  // usuario (\"NO reutilices su dise\u00F1o CSS/provisorio... la geometria/render\r\n  // debe partir del NUEVO asset\"). Ahora hay un PNG real\r\n  // (assets/themes/argentina-streamers/tablas/historial.png, medido pixel\r\n  // a pixel: 5 filas fijas LOCAL/GOL LOCAL/GOL VISITANTE/VISITANTE, sin\r\n  // fecha/competencia/categoria -- esas columnas no existen en el asset\r\n  // real). Shape minimo pedido: 5 partidos fijos, cada uno con equipo\r\n  // local/visitante (teamId real, escudo automatico) + goles como texto\r\n  // libre (no siempre son numeros -- \"P\" de penales, etc., decision igual\r\n  // que el resto del proyecto: nunca forzar tipo numerico en un campo que\r\n  // el operador tipea).\r\n  historial: {\r\n    id: 'historial',\r\n    label: 'Historial',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    fields: [],\r\n    defaults: {\r\n      // \"titulo\"/\"tipoHistorial\" (2026-09-02, pedido explicito del\r\n      // usuario): titulo manual (aparece en la zona superior real del\r\n      // PNG, ver overlay.css/\".ov-performance-titulo\" que reutiliza este\r\n      // modulo) + categoria, valores internos estables para cuando se\r\n      // conecte la web mas adelante -- por ahora es solo un dato mas que\r\n      // el operador elige, sin logica de fetch.\r\n      titulo: '',\r\n      tipoHistorial: 'iwc',\r\n      // \"teamBCrestUrl\"/\"penalLocal\"/\"penalVisitante\" (2026-09-04, pedido\r\n      // explicito del usuario -- ver server/argentinaStreamersSync.js):\r\n      // \"teamBCrestUrl\" es el escudo de un RIVAL HISTORICO sin equipo en\r\n      // el catalogo local (Colombia/Malasia/etc, ver\r\n      // server/argentinaStreamersClient.js), solo lo llena la sincro web;\r\n      // el editor manual (teamB, select del catalogo local) siempre tiene\r\n      // prioridad en el renderer y lo limpia al elegir un equipo a mano.\r\n      // \"penalLocal/penalVisitante\" son SOLO texto (nunca inventados, ver\r\n      // \"wentToPenalties\" real de la web) -- vacios = el partido no se\r\n      // definio por penales, el renderer no dibuja nada debajo del gol.\r\n      // \"fase\" (2026-09-04, pedido explicito del usuario): campo REAL de la\r\n      // web (\"stage\" en product.matches[]/product.competitions.*[].matches,\r\n      // ver server/argentinaStreamersSync.js) -- \"FASE DE GRUPO IWC\",\r\n      // \"SEMIFINAL ICC\", \"Amistoso\", etc. Nunca inferido de la posicion del\r\n      // partido; vacio si la web no publico fase para ese encuentro.\r\n      partidos: [\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n        { teamA: '', golLocal: '', golVisitante: '', teamB: '', teamBCrestUrl: '', penalLocal: '', penalVisitante: '', fase: '' },\r\n      ],\r\n      // Ajuste POR COLUMNA (2026-09-02, pedido explicito del usuario:\r\n      // \"criterio por columna/bloque, no fila individual\") -- un unico\r\n      // offset se aplica a los 5 escudos locales por igual, otro a los 5\r\n      // visitantes, mismo patron que \"goleadores/asistidores\" mas abajo.\r\n      crestLocalOffsetX: 0, crestLocalOffsetY: 0, crestLocalScale: 1,\r\n      crestVisitanteOffsetX: 0, crestVisitanteOffsetY: 0, crestVisitanteScale: 1,\r\n      // \"tituloCrestOffsetX/Y/Scale\" (2026-09-04, pedido explicito del\r\n      // usuario, item 7: escudo Argentina Streamers masculino a la\r\n      // izquierda del titulo -- nunca existio para este modulo, se agrega\r\n      // ahora, mismo patron ya usado en goleadores/asistidores/jugadores).\r\n      tituloCrestOffsetX: 0, tituloCrestOffsetY: 0, tituloCrestScale: 1,\r\n      // \"tituloByCategoria\" (2026-09-04, pedido explicito del usuario:\r\n      // \"no quiero una unica posicion/escala global del titulo, quiero\r\n      // guardar ajustes INDEPENDIENTES por categoria\" -- HISTORIAL - IWC\r\n      // es mucho mas corto que HISTORIAL - AMISTOSOS OFICIALES). Un\r\n      // textAdjust {dx,dy,dSize} completo por categoria, misma llave que\r\n      // \"tipoHistorial\" -- el renderer/panel eligen cual usar segun la\r\n      // categoria activa en vez del \"textAdjust.titulo\" unico de siempre\r\n      // (que se mantiene igual para el ESCUDO del titulo, item 7 del\r\n      // pedido: \"no separar salvo que haga falta tecnicamente\" -- el\r\n      // escudo NO depende del largo del texto, sigue con un unico ajuste).\r\n      tituloByCategoria: {\r\n        iwc: { dx: 0, dy: 0, dSize: 0 },\r\n        'copa-america': { dx: 0, dy: 0, dSize: 0 },\r\n        'amistosos-oficiales': { dx: 0, dy: 0, dSize: 0 },\r\n        amistosos: { dx: 0, dy: 0, dSize: 0 },\r\n      },\r\n      // \"resultadoNormal\"/\"resultadoConPenales\"/\"penalesFino\" (2026-09-04,\r\n      // pedido explicito del usuario: \"GOL LOCAL\"/\"GOL VISITANTE\" como dos\r\n      // controles de columna INDEPENDIENTES quedan eliminados -- \"los dos\r\n      // goles deben moverse juntos\", y ademas con geometria propia segun\r\n      // si la fila tiene penales o no, porque compartian demasiado la\r\n      // misma logica de posicionamiento). Los 3 son bloques {dx,dy,dSize}\r\n      // UNICOS (no por columna individual):\r\n      //  - \"resultadoNormal\": mueve/escala JUNTOS gol local + gol\r\n      //    visitante, SOLO en filas sin penales.\r\n      //  - \"resultadoConPenales\": mueve/escala JUNTOS gol local + gol\r\n      //    visitante + penal local + penal visitante, SOLO en filas CON\r\n      //    penales (nunca toca las filas sin penales -- geometria\r\n      //    completamente separada).\r\n      //  - \"penalesFino\": ajuste ADICIONAL, encima de \"resultadoConPenales\",\r\n      //    exclusivo de penal local/penal visitante -- mueve la segunda\r\n      //    linea \"(N) (N)\" respecto del score reglamentario sin tocar\r\n      //    donde esta parado el bloque completo.\r\n      // Migracion de baseline (item 10 del pedido: \"preservar las\r\n      // posiciones actuales, no desacomodar todo de golpe\"): los offsets\r\n      // YA guardados en las columnas viejas (\"textAdjust.golLocal/\r\n      // golVisitante/penalLocal/penalVisitante\", ver\r\n      // shared/theme-layouts/argentinaStreamers.json) NO se descartan --\r\n      // se hornean como base FIJA por elemento en\r\n      // program/js/renderers/historial.js (GOL_LOCAL_BASE_ADJUST, etc.),\r\n      // asi el look actual queda identico y estos 3 campos nuevos arrancan\r\n      // en 0/0/0 (el punto de partida correcto para un ajuste ADICIONAL).\r\n      resultadoNormal: { dx: 0, dy: 0, dSize: 0 },\r\n      resultadoConPenales: { dx: 0, dy: 0, dSize: 0 },\r\n      penalesFino: { dx: 0, dy: 0, dSize: 0 },\r\n      textAdjust: textAdjustDefaults('fase'),\r\n    },\r\n  },\r\n\r\n  // \"Sitio Web Promo L\" (2026-09-02, pedido explicito del usuario): placa\r\n  // full-bleed estatica con el PNG real (ANUNCIO_AS entregado) -- sin\r\n  // texto dinamico, el asset ya trae su contenido horneado (captura del\r\n  // sitio web + boton \"INGRES\u00C1\"). Categoria nueva \"Extras\" (ninguna de las\r\n  // existentes encajaba con \"publicidad/promocion\"). SOLO Argentina\r\n  // Streamers -- GLA_HIDDEN_MODULES en master-control/js/main.js lo oculta\r\n  // de su navegacion, mismo criterio que fichaJugador/historial/etc.\r\n  sitioWebPromoL: {\r\n    id: 'sitioWebPromoL',\r\n    label: 'Sitio Web Promo L',\r\n    category: 'Extras',\r\n    layer: 'fullscreen',\r\n    sequencedReveal: true,\r\n    // \"asset\" (2026-09-14, RESTAURADO -- pedido explicito del usuario: \"se\r\n    // perdi\u00F3/regres\u00F3 el desplegable que ya hab\u00EDamos agregado\"). Investigado\r\n    // antes de recrear a ciegas: revis\u00E9 `git log` sobre este m\u00F3dulo -- el\r\n    // \u00FAnico commit que lo toca (\"83cf1fa\") nunca tuvo este campo, as\u00ED que\r\n    // nunca lleg\u00F3 a confirmarse en un commit; era trabajo sin guardar de\r\n    // una sesi\u00F3n anterior que se perdi\u00F3 sin dejar rastro en el historial\r\n    // (no hay ning\u00FAn diff/commit que lo haya \"roto\" -- simplemente nunca\r\n    // qued\u00F3 persistido). Campo SELECT gen\u00E9rico (sin panel dedicado, este\r\n    // m\u00F3dulo nunca tuvo uno) -- decide qu\u00E9 variante de imagen usa\r\n    // \"resolveImageSrc\" v\u00EDa \"asset.variants\" en shared/themes.js.\r\n    fields: [\r\n      {\r\n        key: 'asset', label: 'ASSET', type: FIELD_TYPES.SELECT,\r\n        options: [\r\n          { id: 'argentina-streamers', label: 'ARGENTINA STREAMERS' },\r\n          { id: 'punch', label: 'PUNCH' },\r\n        ],\r\n      },\r\n    ],\r\n    defaults: {\r\n      asset: 'argentina-streamers',\r\n      compositionOffsetX: 0, compositionOffsetY: 0, compositionScale: 1,\r\n    },\r\n  },\r\n\r\n  // Tablas de rendimiento: comparten panel y renderer, pero cada modulo\r\n  // conserva sus propios jugadores y posicion. El orden no se guarda como\r\n  // una segunda fuente de datos: se deriva de estas estadisticas con sort\r\n  // estable cada vez que Program renderiza. El estado visual sigue fuera\r\n  // de defaults, por lo que un reinicio siempre las deja OUT.\r\n  goleadores: {\r\n    id: 'goleadores',\r\n    label: 'Goleadores',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      // \"titulo\" (2026-09-02, pedido explicito del usuario: \"T\u00CDTULO\r\n      // configurable seg\u00FAn m\u00F3dulo\" sobre TABLA_ESTADISTICAS.png) -- vacio\r\n      // por default, el renderer cae al nombre de broadcast del modulo\r\n      // (\"GOLEADORES\") si el operador no escribio nada, nunca lo pisa.\r\n      titulo: '',\r\n      posicion: 'placaL', fuente: 'liga', jugadores: [], snapshots: {}, ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'position', 'name', 'primaryStat'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): ajuste\r\n      // column-level, el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  asistidores: {\r\n    id: 'asistidores',\r\n    label: 'Asistidores',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      titulo: '',\r\n      posicion: 'placaL', fuente: 'liga', jugadores: [], snapshots: {}, ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'position', 'name', 'primaryStat'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): ajuste\r\n      // column-level, el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  jugadores: {\r\n    id: 'jugadores',\r\n    label: 'Jugadores',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      // \"titulo\" (2026-09-02): en Argentina Streamers el renderer usa modo\r\n      // \"ranking\" (posicion+nombre+UN estadistica -- ver\r\n      // program/js/renderers/performanceTable.js) sobre el mismo PNG que\r\n      // goleadores/asistidores, con \"PARTICIPACIONES\" (PJ del jugador,\r\n      // metrica ya existente en el modulo) como estadistica -- GLA sigue\r\n      // exactamente con su layout de 3 columnas (G/A/PJ) de siempre, sin\r\n      // \"position\" ni \"titulo\" en su propio asset.\r\n      titulo: '',\r\n      posicion: 'placaL', fuente: 'liga', jugadores: [], snapshots: {}, ultimaActualizacionWeb: '',\r\n      textAdjust: textAdjustDefaults('titulo', 'position', 'name', 'primaryStat', 'stat0', 'stat1', 'stat2'),\r\n      // \"crestOffsetX/Y/Scale\" (2026-08-31, auditoria completa): ajuste\r\n      // column-level, el escudo nunca tuvo ajuste propio.\r\n      crestOffsetX: 0, crestOffsetY: 0, crestScale: 1,\r\n    },\r\n  },\r\n\r\n  // FICHA JUGADOR (2026-09-02, pedido explicito del usuario: placa\r\n  // vertical individual con los datos de UN jugador, para Argentina\r\n  // Streamers). Modulo NUEVO, registrado igual para los dos themes (mismo\r\n  // criterio que el resto del proyecto: la estructura existe siempre, el\r\n  // ASSET real es lo que falta -- ver \"getModuleAssetStatus\", que ya\r\n  // infiere 'pending' sin \"image\"/\"video\" reales, sin tener que declarar\r\n  // \"status\" a mano aca). GLA no tiene pedido ningun uso de este modulo\r\n  // -- queda disponible en su navegacion (mismo patron que cualquier otro\r\n  // modulo del registro) pero sin contenido/flujo pensado para GLA.\r\n  //\r\n  // REHECHO EN BLOQUE 4 (2026-09-09, pedido explicito del usuario: \"FICHA\r\n  // JUGADOR debe consumir el sistema central de JUGADORES implementado en\r\n  // el BLOQUE 3... no crear otra lista manual independiente\"). Antes de\r\n  // este bloque el modulo mantenia su PROPIA lista de jugadores\r\n  // (jugadores[]/snapshots/fuente, igual que Goleadores/Asistidores) --\r\n  // eso quedaba desconectado del plantel central (server/playerRosters.js)\r\n  // y obligaba a cargar cada jugador dos veces. Ahora el modulo solo\r\n  // guarda una SELECCION (\"equipo\"+\"jugadorId\", apuntando al plantel\r\n  // central) mas una COPIA sincronizada de lo ultimo confirmado (nombre +\r\n  // 4 stats) -- exactamente el mismo patron que ya usa Estrellas\r\n  // (\"localJugador\"/\"localNombre\"/\"localG\", ver mas arriba en este\r\n  // archivo) para que Program nunca dependa de golpear la red: la copia\r\n  // es lo que Program realmente lee, la sincronizacion real pasa por\r\n  // server/playerRosters.js + server/argentinaStreamersPlayerStats.js\r\n  // (persistida ahi, reusable por cualquier otro modulo que a futuro\r\n  // quiera los mismos datos). \"xDisponible\" distingue \"la web confirmo 0\"\r\n  // de \"la web nunca informo este dato\" (pedido explicito, seccion 7: \"no\r\n  // calcular una estadistica distinta y llamarla MVP\" si no esta\r\n  // disponible) -- el renderer nunca inventa un numero para un stat\r\n  // marcado como no disponible. Sin \"g+a\": el PNG real (ver\r\n  // assets/themes/argentina-streamers/tablas/ficha-jugador.png) NO tiene\r\n  // ese recuadro -- se elimina el campo inventado de la version anterior\r\n  // (creada antes de tener el asset real).\r\n  fichaJugador: {\r\n    id: 'fichaJugador',\r\n    label: 'Ficha Jugador',\r\n    category: 'Tablas',\r\n    layer: 'fullscreen',\r\n    fields: [],\r\n    defaults: {\r\n      equipo: 'local', // 'local' | 'visitante' -- mismo criterio que Tarjeta/Cambios\r\n      jugadorId: '', // id del jugador en el plantel central (server/playerRosters.js)\r\n      teamId: '',\r\n      nombre: '',\r\n      goles: 0, asistencias: 0, presencias: 0, mvps: 0,\r\n      golesDisponible: true, asistenciasDisponible: true, presenciasDisponible: true, mvpsDisponible: true,\r\n      ultimaActualizacionWeb: '',\r\n      webSyncStatus: '', // '' | 'ok' | 'error' | 'not-found' | 'ambiguous'\r\n      webSyncError: '',\r\n      textAdjust: textAdjustDefaults('nombre', 'goles', 'asistencias', 'presencias', 'mvps'),\r\n    },\r\n  },\r\n\r\n};\r\n\r\nexport const MODULE_IDS = Object.keys(MODULES);\r\n\r\n// \"AJUSTE DE COMPOSICI\u00D3N\" (2026-08-14, pedido explicito del usuario):\r\n// posicion X/Y + escala de TODO un modulo, aplicados como una capa\r\n// adicional sobre el dise\u00F1o base (\"posicion final = base + offset\",\r\n// \"escala final = base \u00D7 ajuste\") -- ver program/js/main.js\r\n// (applyModuleState) para donde se aplica el transform en Program, y\r\n// master-control/js/composition-control.js para el control de UI.\r\n// Mezclados aca, en el UNICO lugar por el que pasa CUALQUIER modulo al\r\n// inicializar su estado (server/state.js y master-control/js/main.js\r\n// llaman los dos a esta funcion), en vez de agregar estas 3 claves a mano\r\n// en los ~25 \"defaults\" de arriba -- asi un modulo nuevo que se registre\r\n// en el futuro hereda esta capa automaticamente, sin tocar este archivo\r\n// de nuevo ni el panel de Master Control.\r\nconst COMPOSITION_DEFAULTS = {\r\n  compositionOffsetX: 0,\r\n  compositionOffsetY: 0,\r\n  compositionScale: 1,\r\n};\r\n\r\n// \"layoutOverride\" (2026-09-01, LAYOUT BASE VERSIONADO -- pedido explicito\r\n// del usuario: \"GUARDAR POSICI\u00D3N\" tiene que producir un cambio que viaje\r\n// con Git, no solo con el estado runtime gitignorado). Opcional a\r\n// proposito: server/state.js es el UNICO caller que lo pasa (carga\r\n// shared/theme-layouts/<themeId>.json al arrancar, ver ese archivo) --\r\n// cualquier otro caller (ej. el placeholder que arma master-control/js/\r\n// main.js antes de recibir el snapshot real del servidor) sigue sin\r\n// pasarlo y obtiene exactamente el comportamiento de siempre (0/0/1\r\n// estructural). Es un subconjunto disperso del mismo arbol de \"defaults\"\r\n// (solo las claves de offset/escala/textAdjust que alguna vez se\r\n// confirmaron con GUARDAR POSICI\u00D3N) -- \"deepMergeAdjustFields\" lo aplica\r\n// ENCIMA de los defaults estructurales, nunca al reves, para que un modulo\r\n// nuevo o un campo nuevo sin base guardada todavia siga cayendo en su\r\n// default de dise\u00F1o de siempre.\r\nexport function cloneDefaults(moduleId, themeId, layoutOverride) {\r\n  const cloned = {\r\n    ...COMPOSITION_DEFAULTS,\r\n    ...JSON.parse(JSON.stringify(MODULES[moduleId].defaults)),\r\n  };\r\n  // Argentina Streamers usa un asset de penales con 5 espacios por equipo\r\n  // (GLA sigue en 3, sin cambios) -- pedido explicito del usuario, ver\r\n  // CHANGELOG.md. Unico chokepoint: ac\u00E1 se genera el array por defecto de\r\n  // \"kicksA\"/\"kicksB\"; el panel (buildPenaltyEditor) y el renderer de\r\n  // Program (buildStructure) ya son 100% length-driven, no necesitan tocarse.\r\n  if (moduleId === 'marcadorPenales' && themeId === ARGENTINA_STREAMERS_THEME_ID) {\r\n    cloned.kicksA = penaltyKicksDefault(5);\r\n    cloned.kicksB = penaltyKicksDefault(5);\r\n  }\r\n  if (layoutOverride) deepMergeAdjustFields(cloned, layoutOverride);\r\n  return cloned;\r\n}\r\n","http://127.0.0.1:4430/shared/constants.js","// Tipos de mensaje del protocolo WebSocket entre Master Control, Program y el servidor.\r\n// Compartido entre Node (server) y navegador (master-control / program) via ES modules.\r\n\r\nexport const WS_MSG = {\r\n  // Servidor -> clientes\r\n  STATE_SNAPSHOT: 'STATE_SNAPSHOT',\r\n  MODULE_UPDATE: 'MODULE_UPDATE',\r\n  // THEME_UPDATE (2026-08-20, sistema multi-theme): el theme activo es\r\n  // GLOBAL -- Master Control y Program tienen que enterarse del mismo\r\n  // cambio sin refrescar, mismo mecanismo de broadcast que ya usan\r\n  // TAKE/UPDATE/OUT (ver shared/themes.js, server/theme.js).\r\n  THEME_UPDATE: 'THEME_UPDATE',\r\n  // RECURSO GR\u00C1FICO (SOFTX): versi\u00F3n de cada archivo registrado (cache\r\n  // busting) + rutas cambiadas por un RECARGAR. Ver server/asset-resources.js.\r\n  ASSET_VERSIONS: 'ASSET_VERSIONS',\r\n  // Cliente (Master Control) -> servidor\r\n  TAKE: 'TAKE',\r\n  OUT: 'OUT',\r\n  UPDATE: 'UPDATE',\r\n  SET_THEME: 'SET_THEME',\r\n  // GUARDAR POSICI\u00D3N (2026-09-01, layout base versionado, pedido explicito\r\n  // del usuario): consolida el valor absoluto actual de UN elemento\r\n  // (moduleId + elementSpec, ver server/theme-layouts.js) dentro del\r\n  // archivo versionado del theme activo. No toca el estado runtime -- ver\r\n  // applyPositionCommit en server/state.js.\r\n  COMMIT_POSITION: 'COMMIT_POSITION',\r\n  // PERFILES DE PARTIDO (2026-09-05, ver server/match-profiles.js): global,\r\n  // Argentina Streamers unicamente. \"APPLY\" pisa el estado visual EN VIVO\r\n  // (mismo broadcast STATE_SNAPSHOT que SET_THEME, para que Program y\r\n  // Master Control se enteren sin refrescar); \"SAVE\"/\"SAVE_AS\"/\"DELETE\" son\r\n  // operaciones de archivo (ver server/match-profiles.js), el servidor\r\n  // responde con la lista actualizada via PROFILE_LIST_UPDATE.\r\n  PROFILE_LIST_UPDATE: 'PROFILE_LIST_UPDATE',\r\n  APPLY_MATCH_PROFILE: 'APPLY_MATCH_PROFILE',\r\n  SAVE_MATCH_PROFILE: 'SAVE_MATCH_PROFILE',\r\n  SAVE_AS_NEW_MATCH_PROFILE: 'SAVE_AS_NEW_MATCH_PROFILE',\r\n  DELETE_MATCH_PROFILE: 'DELETE_MATCH_PROFILE',\r\n  ACTIVE_MATCH_PROFILE_UPDATE: 'ACTIVE_MATCH_PROFILE_UPDATE',\r\n};\r\n\r\nexport const MODULE_STATUS = {\r\n  OUT: 'OUT',\r\n  ON: 'ON',\r\n};\r\n\r\nexport const FIELD_TYPES = {\r\n  TEXT: 'text',\r\n  TEXTAREA: 'textarea',\r\n  SELECT: 'select',\r\n  LIST: 'list',\r\n  PENALTY_SERIES: 'penaltySeries',\r\n  // Texto visible en Program que NO es editable a mano (viene del Marcador,\r\n  // de un reloj, o es un rotulo fijo del dise\u00F1o) pero igual necesita el\r\n  // editor de posicion/tama\u00F1o (2026-08-15, auditoria completa pedida por\r\n  // el usuario). Solo pinta la etiqueta + el control de ajuste, sin input\r\n  // de texto -- field-editors.js lo resuelve igual que \"adjustable:true\"\r\n  // en un campo TEXT, pero sin la parte de tipear.\r\n  ADJUST_ONLY: 'adjustOnly',\r\n};\r\n\r\nexport const PENALTY_KICK_STATUS = {\r\n  PENDING: 'pending',\r\n  SCORED: 'scored',\r\n  MISSED: 'missed',\r\n};\r\n\r\nexport const WS_PATH = '/ws';\r\n","http://127.0.0.1:4430/shared/ws-client.js","// Cliente WebSocket compartido por Master Control y Program.\r\n// Reconecta solo si se corta la conexion: en un stream en vivo no nos podemos\r\n// dar el lujo de perder el control por un hiccup de red momentaneo.\r\n\r\nimport { WS_PATH } from './constants.js';\r\n\r\n// Techo defensivo (2026-09-26, BUG real en vivo -- \"presiono OUT y no sale,\r\n// tengo que volver a hacer TAKE\" -- causa real: \"send()\" descartaba el\r\n// mensaje EN SILENCIO si el socket no estaba OPEN en ese instante exacto\r\n// -- ej. durante el hueco de reconexion de 1500ms tras un hiccup de red\r\n// momentaneo, o el reinicio del servidor -- sin cola ni feedback, el click\r\n// de OUT simplemente se perdia; el operador interpretaba que un TAKE\r\n// posterior \"lo arreglaba\", pero en realidad solo el intento QUE LLEGO\r\n// DESPUES de que el socket ya habia reconectado tenia efecto). Limite\r\n// generoso: una reconexion normal tarda 1500ms y el autosave manda cada\r\n// 80ms mientras se tipea, asi que un corte breve encola a lo sumo unas\r\n// pocas decenas de mensajes -- este techo es solo para no crecer sin\r\n// limite en un corte anormalmente largo (laptop en suspension, etc.),\r\n// descartando los mensajes MAS VIEJOS (los mas nuevos, mas cerca del\r\n// estado real actual, son los que importa conservar).\r\nconst MAX_QUEUED_MESSAGES = 500;\r\n\r\nexport function connect({ onMessage, onOpen, onClose } = {}) {\r\n  const protocol = location.protocol === 'https:' ? 'wss' : 'ws';\r\n  const url = `${protocol}://${location.host}${WS_PATH}`;\r\n  let socket = null;\r\n  // \"pendingQueue\" (2026-09-26): mensajes pedidos mientras el socket NO\r\n  // estaba OPEN -- se reenvian en orden apenas reconecta, en vez de\r\n  // perderse. TAKE/OUT explicitos y autosaves comparten la misma cola sin\r\n  // tratamiento especial: reenviar un autosave viejo de mas no rompe nada\r\n  // (el servidor solo aplica el ultimo Object.assign, idempotente), pero\r\n  // perder un TAKE/OUT explicito si rompe la confiabilidad pedida.\r\n  let pendingQueue = [];\r\n\r\n  function flushQueue() {\r\n    if (!pendingQueue.length) return;\r\n    const toSend = pendingQueue;\r\n    pendingQueue = [];\r\n    for (const msg of toSend) {\r\n      socket.send(JSON.stringify(msg));\r\n    }\r\n  }\r\n\r\n  function open() {\r\n    socket = new WebSocket(url);\r\n\r\n    socket.addEventListener('open', () => {\r\n      flushQueue();\r\n      if (onOpen) onOpen();\r\n    });\r\n\r\n    socket.addEventListener('message', (event) => {\r\n      let msg;\r\n      try {\r\n        msg = JSON.parse(event.data);\r\n      } catch {\r\n        return;\r\n      }\r\n      if (onMessage) onMessage(msg);\r\n    });\r\n\r\n    socket.addEventListener('close', () => {\r\n      if (onClose) onClose();\r\n      setTimeout(open, 1500);\r\n    });\r\n  }\r\n\r\n  open();\r\n\r\n  return {\r\n    send(msg) {\r\n      if (socket && socket.readyState === WebSocket.OPEN) {\r\n        socket.send(JSON.stringify(msg));\r\n        return;\r\n      }\r\n      pendingQueue.push(msg);\r\n      if (pendingQueue.length > MAX_QUEUED_MESSAGES) {\r\n        pendingQueue.splice(0, pendingQueue.length - MAX_QUEUED_MESSAGES);\r\n      }\r\n    },\r\n  };\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/index.js","import vs from './vs.js';\r\nimport scoreboard from './scoreboard.js';\r\nimport marcadorTiempoAdicional from './marcadorTiempoAdicional.js';\r\nimport marcadorEntretiempo from './marcadorEntretiempo.js';\r\nimport marcadorPenales from './marcadorPenales.js';\r\nimport marcadorZocalo from './marcadorZocalo.js';\r\nimport sideTable from './sideTable.js';\r\n// DESACTIVADO TEMPORALMENTE junto con su entrada en shared/modules.js (ver\r\n// ese archivo) \u2014 descomentar esta linea y la del registro mas abajo para\r\n// reactivar. El archivo longSimple.js no se toco.\r\n// import longSimple from './longSimple.js';\r\nimport longDouble from './longDouble.js';\r\nimport shortSimple from './shortSimple.js';\r\nimport shortDouble from './shortDouble.js';\r\nimport varCheck from './varCheck.js';\r\nimport replay from './replay.js';\r\nimport bug from './bug.js';\r\nimport formacionEquipos from './formacionEquipos.js';\r\nimport vsPrepartido from './vsPrepartido.js';\r\nimport vsResultado from './vsResultado.js';\r\nimport tarjeta from './tarjeta.js';\r\nimport cambios from './cambios.js';\r\nimport gol from './gol.js';\r\nimport grupos from './grupos.js';\r\nimport estrellas from './estrellas.js';\r\nimport posiciones from './posiciones.js';\r\nimport { goleadores, asistidores, jugadores } from './performanceTable.js';\r\nimport fichaJugador from './fichaJugador.js';\r\n// BRACKETS (2026-09-02, handoff de un agente concurrente -- ver\r\n// docs/PATCH_SHARED_CLAUDE.md). Su patch pedia registrarlos en un objeto\r\n// \"RENDERERS\" dentro de program/js/main.js, pero ese archivo no tiene tal\r\n// objeto -- el registro real de renderers es este archivo (program/js/main.js\r\n// importa \"renderers\" desde aca). Se registran aca para que su intencion\r\n// (renderer real, sin tocar su codigo) funcione con la arquitectura vigente.\r\nimport cronogramaHoy from './cronogramaHoy.js';\r\nimport resultadosParciales from './resultadosParciales.js';\r\nimport historial from './historial.js';\r\nimport zocaloFinalDiv from './zocaloFinalDiv.js';\r\nimport zocaloFinal from './zocaloFinal.js';\r\nimport zocaloCompuesto from './zocaloCompuesto.js';\r\nimport zocaloCompuestoEquipos from './zocaloCompuestoEquipos.js';\r\nimport zocaloCompuestoLogo from './zocaloCompuestoLogo.js';\r\nimport sitioWebPromoL from './sitioWebPromoL.js';\r\nimport zocaloVs from './zocaloVs.js';\r\n\r\n// Registro de funciones de render: id de modulo -> (contentEl, data, justTaken, onOneShotEnded) => void\r\nexport const renderers = {\r\n  vs,\r\n  scoreboard,\r\n  marcadorTiempoAdicional,\r\n  marcadorEntretiempo,\r\n  marcadorPenales,\r\n  marcadorZocalo,\r\n  sideTable,\r\n  // longSimple, // DESACTIVADO TEMPORALMENTE \u2014 ver comentario junto al import mas arriba.\r\n  longDouble,\r\n  shortSimple,\r\n  shortDouble,\r\n  varCheck,\r\n  replay,\r\n  bug,\r\n  formacionEquipos,\r\n  vsPrepartido,\r\n  vsResultado,\r\n  tarjeta,\r\n  cambios,\r\n  gol,\r\n  grupos,\r\n  estrellas,\r\n  posiciones,\r\n  posicionesTorneo: posiciones,\r\n  goleadores,\r\n  asistidores,\r\n  jugadores,\r\n  fichaJugador,\r\n  cronogramaHoy,\r\n  resultadosParciales,\r\n  historial,\r\n  zocaloFinalDiv,\r\n  zocaloFinal,\r\n  zocaloCompuesto,\r\n  zocaloCompuestoEquipos,\r\n  zocaloCompuestoLogo,\r\n  sitioWebPromoL,\r\n  zocaloVs,\r\n};\r\n","http://127.0.0.1:4430/shared/teams.js","// Catalogo global de equipos \u2014 unica fuente de verdad para nombre\r\n// completo, abreviatura de 3 letras y escudo, compartida por Master\r\n// Control y Program. Se construye solo (GET /api/teams, ver\r\n// server/teams.js) a partir de assets/crests/: cada archivo de escudo ahi\r\n// adentro ES un equipo. Agregar uno nuevo = copiar el .png en esa carpeta;\r\n// no hay ninguna lista para mantener a mano en el codigo.\r\n//\r\n// El \"top-level await\" hace que cualquier modulo que importe de aca\r\n// (directo o indirecto, ej. shared/modules.js) espere a que el catalogo\r\n// este cargado antes de seguir evaluandose \u2014 asi el resto del sistema\r\n// puede usar TEAMS/TEAM_OPTIONS de forma sincronica, sin tener que\r\n// convertir cada renderer en async.\r\n// Este archivo lo importan tanto el navegador (Master Control/Program)\r\n// como, indirectamente, \"server/index.js\" (que importa shared/modules.js\r\n// para validar MODULE_IDS por WebSocket) \u2014 en Node no hay \"fetch\" a una\r\n// URL relativa ni servidor HTTP levantado todavia en este punto (se\r\n// romperia en un ciclo: el server necesita evaluar este modulo para\r\n// terminar de arrancar). Se detecta el entorno y en Node se lee el\r\n// catalogo directo del filesystem, reutilizando la misma logica que\r\n// expone GET /api/teams (server/teams.js) \u2014 una sola fuente de verdad\r\n// para la derivacion de nombre/abreviatura, sin duplicarla aca.\r\nlet teams = [];\r\nif (typeof window === 'undefined') {\r\n  try {\r\n    const { getTeamCatalog } = await import('../server/teams.js');\r\n    teams = getTeamCatalog();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo leer el catalogo de equipos (Node):', err);\r\n  }\r\n} else {\r\n  try {\r\n    const res = await fetch('/api/teams');\r\n    teams = await res.json();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo cargar el catalogo de equipos:', err);\r\n  }\r\n}\r\n\r\nexport const TEAMS = teams;\r\n\r\n// \"visible\" (2026-09-26, pedido explicito del usuario: MOSTRAR/OCULTAR\r\n// EQUIPOS del catalogo GLA sin borrarlos): pasa derecho el flag que ya\r\n// entrega server/teams.js -- \"Sin equipo\" nunca se oculta. Quien RENDERIZA\r\n// el <select> (ver field-editors.js) es responsable de saltear una opcion\r\n// con \"visible:false\", salvo que sea el valor YA seleccionado (para no\r\n// romper un estado guardado que eligio un equipo despues ocultado) -- este\r\n// archivo solo transporta el dato, no decide la UI.\r\nexport const TEAM_OPTIONS = [\r\n  { id: '', label: 'Sin equipo', visible: true },\r\n  ...teams.map((t) => ({ id: t.id, label: t.name, visible: t.visible !== false })),\r\n];\r\n\r\nexport function updateLocalTeamCatalog(newCatalog) {\r\n  if (!Array.isArray(newCatalog)) return;\r\n  teams.length = 0;\r\n  teams.push(...newCatalog);\r\n  TEAM_OPTIONS.length = 0;\r\n  TEAM_OPTIONS.push({ id: '', label: 'Sin equipo', visible: true });\r\n  for (const t of teams) {\r\n    TEAM_OPTIONS.push({ id: t.id, label: t.name, visible: t.visible !== false });\r\n  }\r\n}\r\n\r\nfunction findTeam(id) {\r\n  return teams.find((t) => t.id === id);\r\n}\r\n\r\n// Nombre \"crestFile\" a proposito igual al de shared/team-crests.js (que\r\n// este modulo reemplaza) \u2014 mismo signature, para que los renderers que ya\r\n// lo usaban solo tengan que cambiar el import, no la logica interna.\r\nexport function crestFile(id) {\r\n  return findTeam(id)?.file;\r\n}\r\n\r\nexport function teamAbbr(id) {\r\n  return findTeam(id)?.abbr || '';\r\n}\r\n\r\nexport function teamName(id) {\r\n  return findTeam(id)?.name || '';\r\n}\r\n\r\n","http://127.0.0.1:4430/program/js/theme-client.js","// THEME ACTIVO del lado de Program (2026-08-21, sistema multi-theme etapa\r\n// 2). \u00DAnica fuente de verdad del theme activo para los renderers -- se\r\n// actualiza desde program/js/main.js (THEME_UPDATE / STATE_SNAPSHOT) y lo\r\n// consulta program/js/theme-assets.js para resolver qu\u00E9 asset le\r\n// corresponde a cada m\u00F3dulo. Separado en su propio archivo (no una\r\n// variable local de main.js) porque los 25 renderers de\r\n// program/js/renderers/*.js son m\u00F3dulos ES independientes que necesitan\r\n// leer este valor sin importar main.js entero.\r\nimport { DEFAULT_THEME_ID } from '../../shared/themes.js';\r\n\r\nlet activeThemeId = DEFAULT_THEME_ID;\r\n\r\nexport function getActiveThemeId() {\r\n  return activeThemeId;\r\n}\r\n\r\nexport function setActiveThemeId(themeId) {\r\n  activeThemeId = themeId || DEFAULT_THEME_ID;\r\n  // Espejo en el DOM del theme activo (mismo patr\u00F3n que ya usa\r\n  // master-control/css/master.css con \"body[data-theme='...']\") para que\r\n  // program/css/overlay.css pueda tener reglas de geometr\u00EDa espec\u00EDficas de\r\n  // un theme sin tocar las reglas (theme-agn\u00F3sticas) que ya usa GLA.\r\n  if (typeof document !== 'undefined' && document.body) {\r\n    document.body.dataset.theme = activeThemeId;\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/stage-scale.js","// Escala \"#stage\" (composicion logica fija de 1920x1080, ver overlay.css)\r\n// como una unica unidad al tama\u00F1o real del viewport -- nunca recalcula\r\n// fuentes/assets/posiciones por separado, un solo factor de escala para\r\n// todo el stage. Corrige la causa raiz reportada por el usuario\r\n// (2026-08-13): \"document.documentElement\" (viewport real) y\r\n// \"document.body\" (antes fijado a 1920x1080px) quedaban desincronizados en\r\n// cualquier PC cuya ventana no midiera exactamente 1920x1080 fisicos --\r\n// el stage se recortaba en vez de escalarse.\r\nconst STAGE_WIDTH = 1920;\r\nconst STAGE_HEIGHT = 1080;\r\n\r\nexport function initStageScale(stage) {\r\n  function applyScale() {\r\n    const vw = window.innerWidth;\r\n    const vh = window.innerHeight;\r\n    // Guardia (2026-08-31, causa raiz real de \"Program se ve distinto en\r\n    // vMix/Chrome/Preview\" reportado por el usuario): en ciertos hosts que\r\n    // EMBEBEN Program (vMix Browser Source via CEF es el caso confirmado;\r\n    // tambien reproducible a mano con cualquier resize del propio\r\n    // navegador que llegue ANTES de que el viewport termine de asentar su\r\n    // tama\u00F1o final) el primer calculo -- o alguno posterior -- puede\r\n    // correr con innerWidth/innerHeight todavia en 0. Sin esta guardia\r\n    // \"scale\" quedaba literalmente en 0 (stage colapsado/invisible) y\r\n    // JAMAS se recalculaba si ese host no llega a disparar un evento\r\n    // 'resize' de verdad al asentar su tama\u00F1o real -- exactamente el\r\n    // sintoma reportado (Preview, cuyo tama\u00F1o de iframe es estable desde\r\n    // el primer render, nunca lo sufre; vMix/Chrome, cuya ventana puede\r\n    // asentarse en mas de un paso, si). No commitear un scale invalido:\r\n    // reintentar en el siguiente frame en vez de dejar el stage roto.\r\n    if (!vw || !vh) {\r\n      // \"setTimeout\", no \"requestAnimationFrame\": rAF puede quedar en\r\n      // pausa indefinida en una pesta\u00F1a/frame que el navegador considera\r\n      // no-visible o sin composicion activa (confirmado en pruebas) --\r\n      // \"scale\" quedaba entonces sin commitear NUNCA. setTimeout sigue\r\n      // disparando igual en ese caso, asi el reintento no puede quedar\r\n      // colgado para siempre.\r\n      setTimeout(applyScale, 50);\r\n      return;\r\n    }\r\n    const scale = Math.min(vw / STAGE_WIDTH, vh / STAGE_HEIGHT);\r\n    const offsetX = (vw - STAGE_WIDTH * scale) / 2;\r\n    const offsetY = (vh - STAGE_HEIGHT * scale) / 2;\r\n    stage.style.left = `${offsetX}px`;\r\n    stage.style.top = `${offsetY}px`;\r\n    stage.style.transform = `scale(${scale})`;\r\n  }\r\n\r\n  applyScale();\r\n  window.addEventListener('resize', applyScale);\r\n  // ResizeObserver sobre <html> (2026-08-31, causa raiz real): mas\r\n  // confiable que el 'resize' de arriba en embeddings donde el host\r\n  // cambia el tama\u00F1o de la ventana/frame SIN que el navegador llegue a\r\n  // disparar ese evento (confirmado: vMix Browser Source via CEF) --\r\n  // observa el tama\u00F1o real del viewport en si mismo, sin importar la\r\n  // causa del cambio. No reemplaza al listener de 'resize', lo\r\n  // complementa: cubre exactamente los casos donde ese evento se pierde.\r\n  if (typeof ResizeObserver !== 'undefined') {\r\n    const ro = new ResizeObserver(() => applyScale());\r\n    ro.observe(document.documentElement);\r\n  }\r\n  // Red de seguridad final (2026-08-31, verificado en pruebas: ni\r\n  // 'resize' ni ResizeObserver dispararon de forma confiable en al menos\r\n  // un entorno real de prueba tras un cambio de tama\u00F1o -- no se pudo\r\n  // confirmar la causa exacta, pero el resultado observado es el mismo\r\n  // sintoma reportado: el stage queda con la escala vieja). Un poll\r\n  // liviano (1x/segundo, dos comparaciones numericas) que solo actua si\r\n  // el tama\u00F1o realmente cambio desde el ultimo calculo aplicado --\r\n  // garantiza que Program se autocorrija en como maximo ~1s en CUALQUIER\r\n  // host, sin importar si dispara algun evento de resize o no. Costo\r\n  // insignificante frente a la garantia de \"nunca se queda mal escalado\".\r\n  let lastVw = window.innerWidth;\r\n  let lastVh = window.innerHeight;\r\n  setInterval(() => {\r\n    if (window.innerWidth !== lastVw || window.innerHeight !== lastVh) {\r\n      lastVw = window.innerWidth;\r\n      lastVh = window.innerHeight;\r\n      applyScale();\r\n    }\r\n  }, 1000);\r\n}\r\n","http://127.0.0.1:4430/program/js/program-fonts.js","import { getActiveThemeId } from './theme-client.js';\r\n\r\nconst FONT_PROBE = 'GLA AaBb 0123456789 \u00C1\u00C9\u00CD\u00D3\u00DA\u00D1';\r\n\r\n// Una entrada por theme: \"family\" es el nombre interno que declara el\r\n// @font-face correspondiente en program/css/theme.css (nunca depende de\r\n// que esa fuente este instalada en el sistema operativo). \"weights\" son\r\n// los pesos que el resto del codigo pide via ctx.font/document.fonts.load\r\n// -- igual que ya pasaba con GLA Anton (un unico archivo real, pedido a\r\n// varios pesos), el navegador resuelve todos ellos a la unica cara\r\n// declarada sin sintetizar un trazo mas grueso.\r\nconst THEME_FONTS = {\r\n  gla: { family: '\"GLA Anton\"', weights: [400, 600, 700, 800, 900] },\r\n  argentinaStreamers: { family: '\"LIVE Segoe Bold\"', weights: [400, 600, 700, 800, 900] },\r\n};\r\n\r\nconst DEFAULT_FONT = THEME_FONTS.gla;\r\n\r\n// \"GLA_SEGOE_BOLD\" (2026-09-24, pedido explicito del usuario: \"Zocalo\r\n// Largo Simple/Corto Simple/Corto Doble/Compuesto deben usar Segoe UI\r\n// Bold, exclusivamente en GLA\"). Reutiliza el MISMO archivo .ttf ya\r\n// cargado para Argentina Streamers (assets/themes/argentina-streamers/\r\n// fonts/Segoe-UI-Bold.ttf, ver @font-face en program/css/theme.css) bajo\r\n// un nombre interno DISTINTO -- no se duplica el archivo (pedido\r\n// explicito: \"no cambiar assets\"), solo se declara una segunda vez con un\r\n// nombre propio para que este cambio quede conceptualmente separado de\r\n// \"la fuente de Argentina Streamers\" (que sigue siendo 100% independiente,\r\n// puede cambiar sin afectar esto y viceversa) aunque el byte a byte sea\r\n// igual hoy. \"GLA_SEGOE_BOLD_FACE\" es el nombre pelado (para precargar\r\n// con document.fonts.load, ver waitForProgramFonts) y\r\n// \"GLA_SEGOE_BOLD_FAMILY\" el stack completo pedido por el usuario (con\r\n// fallback a la Segoe UI del sistema operativo y despues Arial/sans-serif)\r\n// para usar en CSS/medicion de texto.\r\nexport const GLA_SEGOE_BOLD_FACE = '\"GLA Segoe Bold\"';\r\nexport const GLA_SEGOE_BOLD_FAMILY = `${GLA_SEGOE_BOLD_FACE}, \"Segoe UI\", Arial, sans-serif`;\r\n\r\n// \"GLA Segoe Regular\" (2026-10-22, pedido explicito del usuario: todo el\r\n// texto dinamico de Marcador, Entretiempo, Tiempo Adicional, Marcador\r\n// Zocalo, motivo de VAR, zocalos, Tarjeta, Cambios, titulo de Partidos,\r\n// tablas y posiciones de GLA en Segoe UI Regular 400; ver @font-face y\r\n// \"--gla-font-ui\" en program/css/theme.css). Envuelve las opciones de\r\n// medicion de esos modulos para que lo que se MIDE (ancho y correccion\r\n// vertical) coincida con lo que se pinta: en GLA fuerza la familia del\r\n// token CSS \"--gla-font-ui\" (la misma declaracion que pinta, no una copia)\r\n// y peso 400; en cualquier otro theme devuelve las opciones intactas\r\n// (Argentina Streamers sin cambios). GLA_SEGOE_REGULAR_FAMILY es solo el\r\n// respaldo si el token no se pudiera leer.\r\nexport const GLA_SEGOE_REGULAR_FACE = '\"GLA Segoe Regular\"';\r\nexport const GLA_SEGOE_REGULAR_FAMILY = `${GLA_SEGOE_REGULAR_FACE}, \"Segoe UI\", Arial, sans-serif`;\r\n\r\nfunction glaUiFontFamily() {\r\n  const token = getComputedStyle(document.body).getPropertyValue('--gla-font-ui').trim();\r\n  return token || GLA_SEGOE_REGULAR_FAMILY;\r\n}\r\n\r\nexport function withGlaSegoeRegular(opts) {\r\n  if (getActiveThemeId() !== 'gla') return opts;\r\n  return { ...opts, family: glaUiFontFamily(), weight: 400 };\r\n}\r\n\r\n// Reemplaza al viejo export estatico \"PROGRAM_FONT_FAMILY\" (2026-09-01,\r\n// integracion de fuente propia para Argentina Streamers): Program puede\r\n// cambiar de theme en caliente (WS THEME_UPDATE/STATE_SNAPSHOT, sin\r\n// recargar la pagina -- ver program/js/main.js), asi que la familia de\r\n// fuente para medir/pintar texto tiene que leerse en el momento de cada\r\n// uso, no fijarse una sola vez al cargar el modulo.\r\nexport function getProgramFontFamily() {\r\n  const themeId = getActiveThemeId();\r\n  return (THEME_FONTS[themeId] || DEFAULT_FONT).family;\r\n}\r\n\r\n// Precarga TODAS las fuentes de TODOS los themes (no solo la del theme\r\n// activo): esta funcion corre en program/js/main.js antes de que el WS\r\n// entregue el theme activo real (ver comentario ahi), y ademas el theme\r\n// puede cambiar despues sin recargar -- precargar todo de entrada es la\r\n// unica forma de garantizar que un cambio de theme en caliente nunca\r\n// muestre un flash con fuente de reemplazo.\r\nexport async function waitForProgramFonts() {\r\n  const specs = Object.entries(THEME_FONTS).flatMap(([themeId, { family, weights }]) =>\r\n    weights.map((weight) => ({ themeId, family, weight }))\r\n  );\r\n  // \"GLA Segoe Bold\" (ver mas arriba) no es la fuente de NINGUN theme\r\n  // completo -- se precarga aparte, una sola vez, al unico peso real que\r\n  // declara su @font-face (700), mismo criterio que ya vale para \"GLA\r\n  // Anton\"/\"LIVE Segoe Bold\" (un unico archivo real detras).\r\n  specs.push({ themeId: 'gla (modulos Segoe Bold)', family: GLA_SEGOE_BOLD_FACE, weight: 700 });\r\n  const loadedFaces = await Promise.all(\r\n    specs.map(({ family, weight }) => document.fonts.load(`${weight} 32px ${family}`, FONT_PROBE))\r\n  );\r\n  await document.fonts.ready;\r\n\r\n  const failed = specs.filter((_, i) => loadedFaces[i].length === 0 || loadedFaces[i].some((face) => face.status !== 'loaded'));\r\n  if (failed.length > 0) {\r\n    const names = [...new Set(failed.map((f) => `${f.family} (theme ${f.themeId})`))].join(', ');\r\n    throw new Error(`No se pudieron cargar las fuentes locales de PROGRAM: ${names}.`);\r\n  }\r\n\r\n  document.documentElement.classList.add('program-fonts-ready');\r\n}\r\n","http://127.0.0.1:4430/program/js/asset-versions.js","// CACHE BUSTING DE RECURSOS GR\u00C1FICOS (SOFTX, 2026-10-29). El servidor manda\r\n// la versi\u00F3n de cada archivo registrado (WS ASSET_VERSIONS, derivada de su\r\n// fecha/tama\u00F1o real -- ver server/asset-resources.js). Toda URL de asset que\r\n// monta Program/Preview pasa por versionedAssetUrl(): si el operador\r\n// reemplaza el archivo con el MISMO nombre y aprieta RECARGAR, cambia la\r\n// versi\u00F3n, cambia la URL y el navegador no puede reutilizar la copia vieja\r\n// (ni del cach\u00E9 HTTP ni de la lista de im\u00E1genes ya decodificadas).\r\nimport { listCssVarAssets } from '../../shared/asset-registry.js';\r\n\r\nconst versions = new Map();\r\n\r\nexport function versionedAssetUrl(src) {\r\n  if (typeof src !== 'string' || !src) return src;\r\n  const queryAt = src.indexOf('?');\r\n  const base = queryAt === -1 ? src : src.slice(0, queryAt);\r\n  const version = versions.get(base);\r\n  return version ? `${base}?v=${version}` : src;\r\n}\r\n\r\nfunction applyCssVars() {\r\n  const rootStyle = document.documentElement.style;\r\n  for (const asset of listCssVarAssets()) {\r\n    if (versions.has(asset.path)) rootStyle.setProperty(asset.cssVar, `url(\"${versionedAssetUrl(asset.path)}\")`);\r\n  }\r\n}\r\n\r\nexport function setAssetVersions(next) {\r\n  for (const [path, version] of Object.entries(next || {})) versions.set(path, version);\r\n  applyCssVars();\r\n}\r\n","http://127.0.0.1:4430/shared/themes.js","// REGISTRO DE THEMES (2026-08-20, pedido expl\u00EDcito: \"preparar el proyecto\r\n// para que deje de estar atado exclusivamente a GLA\"). Este archivo es el\r\n// \u00DANICO lugar que sabe qu\u00E9 asset le corresponde a cada m\u00F3dulo seg\u00FAn el\r\n// theme activo -- la idea es que en vez de \"if GLA... if Argentina...\"\r\n// repartido en 25 renderers, cada renderer pueda preguntar\r\n// \"getThemeAsset(themeId, moduleId)\" y listo.\r\n//\r\n// 2026-08-21, ETAPA 2 (pedido expl\u00EDcito: \"no quiero solamente un\r\n// placeholder... quiero ARGENTINA STREAMERS OPERATIVO AHORA\"): los\r\n// renderers de Program YA consumen este manifest v\u00EDa\r\n// program/js/theme-assets.js -- para GLA siguen usando su constante\r\n// hardcodeada de siempre como fuente de verdad (nunca el manifest, ver\r\n// esa raz\u00F3n en theme-assets.js), as\u00ED que esto no cambia nada de lo que\r\n// ya se ve\u00EDa. Para cualquier theme que NO sea GLA, \"video\"/\"image\" en\r\n// null significa literalmente \"todav\u00EDa no hay archivo\" -- Program\r\n// entonces NO monta ninguna capa de video/imagen para ese m\u00F3dulo y\r\n// renderiza solo el contenido din\u00E1mico (texto/escudos/n\u00FAmeros) sobre\r\n// transparencia. Ver docs/THEMES.md para el detalle completo.\r\n//\r\n// LIVE GRAPHICS (el software) -> THEME seleccionado -> assets\r\n// correspondientes. \"GLA\" ac\u00E1 es pura y exclusivamente un THEME/\r\n// competencia (Gran Liga Rel\u00E1mpago) -- nada de esto reemplaza gla.futbol,\r\n// los m\u00F3dulos de datos GLA, ni ning\u00FAn identificador interno existente.\r\n\r\nexport const DEFAULT_THEME_ID = 'gla';\r\nexport const ARGENTINA_STREAMERS_THEME_ID = 'argentinaStreamers';\r\n\r\n// Cat\u00E1logo de m\u00F3dulos con asset gr\u00E1fico propio (pedido expl\u00EDcito, secci\u00F3n\r\n// 12) -- nombres DESCRIPTIVOS de referencia; la clave real que usa cada\r\n// entrada de \"assets\" abajo es el MODULE_ID real de shared/modules.js.\r\nexport const THEME_ASSET_MODULES = [\r\n  { key: 'scoreboard', label: 'Marcador' },\r\n  { key: 'marcadorTiempoAdicional', label: 'Tiempo adicional' },\r\n  { key: 'marcadorEntretiempo', label: 'Entretiempo' },\r\n  { key: 'marcadorPenales', label: 'Penales' },\r\n  { key: 'marcadorZocalo', label: 'Marcador Z\u00F3calo' },\r\n  { key: 'tarjeta', label: 'Tarjetas' },\r\n  { key: 'cambios', label: 'Cambios' },\r\n  { key: 'gol', label: 'Gol' },\r\n  { key: 'varCheck', label: 'VAR' },\r\n  { key: 'varCheckMotivo', label: 'VAR Motivo (z\u00F3calo corto)' },\r\n  { key: 'replay', label: 'Replay' },\r\n  { key: 'bug', label: 'Mosca' },\r\n  { key: 'longDouble', label: 'Z\u00F3calo largo doble' },\r\n  { key: 'shortSimple', label: 'Z\u00F3calo corto simple' },\r\n  { key: 'shortDouble', label: 'Z\u00F3calo corto doble' },\r\n  { key: 'zocaloCompuesto', label: 'Z\u00F3calo compuesto' },\r\n  { key: 'zocaloCompuestoEquipos', label: 'Z\u00F3calo compuesto con equipos' },\r\n  { key: 'zocaloCompuestoLogo', label: 'Z\u00F3calo compuesto con logo' },\r\n  { key: 'zocaloFinal', label: 'Z\u00F3calo final' },\r\n  { key: 'zocaloFinalDiv', label: 'Z\u00F3calo final con equipos' },\r\n  { key: 'vs', label: 'VS' },\r\n  { key: 'zocaloVs', label: 'Z\u00F3calo VS' },\r\n  { key: 'vsPrepartido', label: 'VS Prepartido' },\r\n  { key: 'vsResultado', label: 'VS con resultado' },\r\n  { key: 'formacionEquipos', label: 'Formaciones' },\r\n  { key: 'estrellas', label: 'Estrellas' },\r\n  { key: 'grupos', label: 'Grupos' },\r\n  { key: 'goleadores', label: 'Goleadores' },\r\n  { key: 'asistidores', label: 'Asistidores' },\r\n  { key: 'jugadores', label: 'Mejores jugadores' },\r\n  { key: 'fichaJugador', label: 'Ficha Jugador' },\r\n  // \"cronogramaHoy\"/\"resultadosParciales\"/\"historial\" (2026-09-02):\r\n  // modulos de BRACKETS entregados por un agente concurrente -- ver\r\n  // docs/PATCH_SHARED_CLAUDE.md (handoff recibido) y\r\n  // docs/BRACKETS_ARGENTINA_STREAMERS.md. Integrados tal cual pidio el\r\n  // patch, sin tocar su logica/renderer/panel.\r\n  { key: 'cronogramaHoy', label: 'Cronograma Hoy' },\r\n  { key: 'resultadosParciales', label: 'Resultados Parciales' },\r\n  { key: 'historial', label: 'Historial' },\r\n  { key: 'sitioWebPromoL', label: 'Sitio Web Promo L' },\r\n  { key: 'sideTable', label: 'Resultados' },\r\n  { key: 'posiciones', label: 'Posiciones' },\r\n  { key: 'posicionesTorneo', label: 'Posiciones (Torneo)' },\r\n  { key: 'sponsors', label: 'Sponsors' },\r\n];\r\n\r\nexport const THEMES = {\r\n  gla: {\r\n    id: 'gla',\r\n    name: 'GRAN LIGA REL\u00C1MPAGO',\r\n    shortName: 'GLA',\r\n    // \"ready: true\" -- este theme ya tiene TODOS sus assets reales\r\n    // (los mismos que el proyecto usa hoy, sin ning\u00FAn cambio).\r\n    ready: true,\r\n    // Fuente de datos externa asociada a este theme (secci\u00F3n 10):\r\n    // gla.futbol pertenece EXCLUSIVAMENTE a este theme.\r\n    dataSource: 'gla-futbol',\r\n    // SOFTX (2026-10-29): las rutas reales de GLA viven SOLO en el registro\r\n    // central shared/asset-registry.js (RECURSO GR\u00C1FICO) y los renderers las\r\n    // leen de ah\u00ED. Ac\u00E1 queda \u00FAnicamente el estado \"ready\" por m\u00F3dulo que usa\r\n    // el indicador de asset pendiente de Master Control (getModuleAssetStatus).\r\n    assets: Object.fromEntries([\r\n      'scoreboard', 'marcadorTiempoAdicional', 'marcadorEntretiempo', 'marcadorPenales', 'marcadorZocalo', 'tarjeta', 'cambios', 'gol', 'varCheck', 'replay', 'bug', 'longDouble', 'shortSimple', 'shortDouble', 'zocaloCompuesto', 'zocaloCompuestoEquipos', 'zocaloCompuestoLogo', 'zocaloFinal', 'zocaloFinalDiv', 'vs', 'vsPrepartido', 'vsResultado', 'formacionEquipos', 'estrellas', 'grupos', 'goleadores', 'asistidores', 'jugadores', 'sideTable', 'posiciones', 'posicionesTorneo', 'sponsors',\r\n    ].map((moduleId) => [moduleId, { status: 'ready' }])),\r\n  },\r\n\r\n  argentinaStreamers: {\r\n    id: 'argentinaStreamers',\r\n    name: 'ARGENTINA STREAMERS',\r\n    shortName: 'AR STREAMERS',\r\n    // \"ready: false\" -- ning\u00FAn m\u00F3dulo tiene TODAV\u00CDA su asset gr\u00E1fico\r\n    // definitivo (pedido expl\u00EDcito: \"NO inventes, copies ni reemplaces\r\n    // assets del nuevo theme\"). Esto ya NO bloquea nada -- ni TAKE, ni\r\n    // Program, ni la l\u00F3gica de ning\u00FAn m\u00F3dulo (pedido expl\u00EDcito, etapa 2)\r\n    // -- solo controla el banner informativo \"ASSETS PENDIENTES\" de\r\n    // Master Control. Cada m\u00F3dulo de \"assets\" abajo tiene adem\u00E1s su\r\n    // propio \"status\" individual para el indicador por-m\u00F3dulo.\r\n    // \"ready: true\" (2026-10-09, pedido explicito del usuario: \"Argentina\r\n    // Streamers ya est\u00E1 operativo, no quiero ver m\u00E1s el cartel THEME EN\r\n    // PREPARACI\u00D3N\") -- los avisos por-m\u00F3dulo (\"status\") no cambian.\r\n    ready: true,\r\n    // Sin integraci\u00F3n externa todav\u00EDa -- decisi\u00F3n futura (secci\u00F3n 10,\r\n    // pedido expl\u00EDcito: \"por ahora MANUAL\").\r\n    dataSource: 'manual',\r\n    // Paleta CELESTE + BLANCO (secci\u00F3n 1, pedido expl\u00EDcito) -- fuente de\r\n    // verdad \u00FAnica de los 3 colores pedidos; master-control/css/master.css\r\n    // los usa v\u00EDa \"data-theme\" + variables CSS, no duplica los hex.\r\n    palette: {\r\n      primary: '#6ECBF5',   // celeste principal\r\n      accent: '#209DDB',    // azul complementario\r\n      base: '#FFFFFF',      // blanco\r\n    },\r\n    // Equipos iniciales para este theme (secci\u00F3n 9 del pedido, ejemplo\r\n    // concreto dado: \"ARGENTINA STREAMERS vs PER\u00DA CREADORES\"). Escudos\r\n    // reales cargados 2026-08-31 (pedido expl\u00EDcito del usuario, \"carga de\r\n    // escudos\") en assets/themes/argentina-streamers/escudos/ -- los\r\n    // renderers ya sab\u00EDan mostrar un equipo sin escudo mientras \"file\" era\r\n    // null (ver \"setCrest()\" en program/js/renderers/scoreboard.js, sin\r\n    // cambios). Cat\u00E1logo SEPARADO del de GLA (server/teams.js lo resuelve\r\n    // por theme) -- agregar equipos ac\u00E1 nunca aparece en el selector de\r\n    // equipos de GLA ni al rev\u00E9s.\r\n    teams: [\r\n      { id: 'argentina-streamers', name: 'Argentina Streamers', abbr: 'ARG', file: '/assets/themes/argentina-streamers/escudos/argentina-streamers.png' },\r\n      { id: 'peru-creadores', name: 'Per\u00FA Creadores', abbr: 'PER', file: '/assets/themes/argentina-streamers/escudos/peru-creadores.png' },\r\n      // \"oxen\" y \"argentina-streamers-fem\": 2 equipos mas (pedido\r\n      // explicito, 2026-09-01) con sus escudos reales ya en\r\n      // assets/themes/argentina-streamers/escudos/. \"ARF\" (no \"ARG\") para\r\n      // que no choque con el abbr del equipo masculino de arriba -- misma\r\n      // convencion de 3 letras que server/teams.js, con override manual\r\n      // (igual que los \"overrides puntuales\" que ya usa ese archivo para\r\n      // los equipos de GLA) porque la derivacion automatica de las 2\r\n      // primeras palabras de \"Argentina Streamers FEM\" tambien da \"ARG\".\r\n      { id: 'oxen', name: 'OXEN', abbr: 'OXE', file: '/assets/themes/argentina-streamers/escudos/oxen.png' },\r\n      { id: 'argentina-streamers-fem', name: 'Argentina Streamers FEM', abbr: 'ARF', file: '/assets/themes/argentina-streamers/escudos/argentina-streamers-fem.png' },\r\n      // Argentina Senior (2026-09-04, pedido explicito del usuario): escudo\r\n      // extraido del PDF vectorial entregado en \"cosas sueltas/\" (nunca\r\n      // usado directo en runtime -- exportado una vez a PNG transparente,\r\n      // recorte ajustado al bounding box real del arte via analisis de\r\n      // canal alfa, misma carpeta que el resto de escudos AS). \"LSF\" es la\r\n      // abreviatura pedida explicitamente (no derivada del logo).\r\n      { id: 'argentina-senior', name: 'ARGENTINA SENIOR', abbr: 'LSF', file: '/assets/themes/argentina-streamers/escudos/argentina-senior.png' },\r\n    ],\r\n    // Un objeto por cada m\u00F3dulo de THEME_ASSET_MODULES, generado ac\u00E1 mismo\r\n    // (no a mano) para garantizar que NINGUNO quede afuera -- \"video\"/\r\n    // \"image\" en null = \"status: pending\". Los m\u00F3dulos que ya recibieron su\r\n    // asset real (2026-08-28, primera entrega del dise\u00F1ador -- carpeta\r\n    // \"ARGENTINA STREAMERS VS PERU CREADORES 5/9\") pisan ese default m\u00E1s\r\n    // abajo: sin \"status\" expl\u00EDcito, \"getModuleAssetStatus()\" infiere\r\n    // 'ready' solo con que haya un video/image real, mismo criterio que\r\n    // GLA. Cuando llegue el resto, el mismo patr\u00F3n (copiar archivo ac\u00E1 +\r\n    // agregar una l\u00EDnea abajo) alcanza -- nada de c\u00F3digo nuevo.\r\n    assets: {\r\n      ...Object.fromEntries(THEME_ASSET_MODULES.map(({ key }) => [\r\n        key,\r\n        { video: null, image: null, status: 'pending' },\r\n      ])),\r\n      scoreboard: { video: '/assets/themes/argentina-streamers/marcador/scoreboard-alpha.mp4' },\r\n      marcadorPenales: { video: '/assets/themes/argentina-streamers/marcador/marcador-penales-alpha.mp4' },\r\n      marcadorTiempoAdicional: { image: '/assets/themes/argentina-streamers/marcador/marcador-tiempo-adicional.png' },\r\n      // ACTUALIZADO (2026-09-04, pedido explicito del usuario): el PNG que\r\n      // vivia aca (\"marcador-entretiempo.png\", entregado 2026-09-01) en\r\n      // realidad no era el asset correcto de ESTE modulo -- el usuario\r\n      // aviso explicitamente \"no lo confundas con el asset que ya\r\n      // identificamos como de MARCADOR Z\u00D3CALO\" (ver esa entrada, unas\r\n      // lineas abajo, que sigue usando ese archivo viejo sin tocarse).\r\n      // Este es el PNG real de Entretiempo (\"ENTRETIEMPO_FINAL2.png\" en\r\n      // cosas sueltas/), archivo PROPIO (nunca compartido con Z\u00F3calo) para\r\n      // que un futuro cambio de uno no afecte al otro por accidente.\r\n      marcadorEntretiempo: { image: '/assets/themes/argentina-streamers/marcador/entretiempo.png' },\r\n      // \"marcadorZocalo\" (2026-09-04, correccion explicita del usuario: \"el\r\n      // error fue mio con el nombre\") no tenia entrada propia aca -- quedaba\r\n      // sin asset (solo texto/reloj flotando). Sigue usando el PNG viejo de\r\n      // arriba (el que en su momento se identifico, erroneamente, como\r\n      // \"ENTRETIEMPO\") -- ese dise\u00F1o SI es el correcto para Z\u00F3calo, no se\r\n      // toca.\r\n      marcadorZocalo: { image: '/assets/themes/argentina-streamers/marcador/marcador-entretiempo.png' },\r\n      gol: { video: '/assets/themes/argentina-streamers/incidencias/gol-alpha.mp4' },\r\n      cambios: { video: '/assets/themes/argentina-streamers/incidencias/cambios-alpha.mp4' },\r\n      tarjeta: {\r\n        video: '/assets/themes/argentina-streamers/incidencias/tarjeta-amarilla-alpha.mp4',\r\n        variants: {\r\n          amarilla: '/assets/themes/argentina-streamers/incidencias/tarjeta-amarilla-alpha.mp4',\r\n          roja: '/assets/themes/argentina-streamers/incidencias/tarjeta-roja-alpha.mp4',\r\n          azul: '/assets/themes/argentina-streamers/incidencias/tarjeta-azul-alpha.mp4',\r\n        },\r\n      },\r\n      varCheck: { video: '/assets/themes/argentina-streamers/var-replay/var-chequeo-alpha.mp4' },\r\n      varCheckMotivo: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-corto-doble-alpha.mp4' },\r\n      replay: { video: '/assets/themes/argentina-streamers/var-replay/replay-sponsor-alpha.mp4' },\r\n      bug: { video: '/assets/themes/argentina-streamers/mosca/mosca-localstrike-alpha.mp4' },\r\n      shortSimple: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-corto-simple-alpha.mp4' },\r\n      shortDouble: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-corto-doble-alpha.mp4' },\r\n      longDouble: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-largo-doble-alpha.mp4' },\r\n      // Zocalo Compuesto: UN solo modulo con 2 variantes por \"tipo\" (ver\r\n      // data.tipo en program/js/renderers/zocaloCompuesto.js, logica ya\r\n      // existente sin cambios) -- \"logo\" deja el area de logo vacia por\r\n      // ahora (llega despues), \"equipos\" hereda escudos LOCAL/VISITANTE en\r\n      // vivo del Marcador (mismo patron que tarjeta/cambios).\r\n      // CORRECCION (2026-09-01, mismo dia -- el usuario aviso que la\r\n      // primera entrega/asignacion estaba mal por una confusion suya): los\r\n      // assets REALES son \"ZOCALO_LARGO.mov\" (sin division, para \"logo\")\r\n      // y \"ZOCALO_LARGO_linea.mov\" (con la linea divisoria del lado\r\n      // izquierdo, para \"equipos\") -- confirmado por INSPECCION VISUAL\r\n      // real de un frame de cada uno (ffmpeg), no por nombre de archivo:\r\n      // \"_linea\" es, literamente, el unico de los dos con una linea\r\n      // blanca vertical separando la zona de escudos del resto del\r\n      // zocalo. Los .mov de la entrega anterior (derivados de\r\n      // ZOCALO_VS/ZOCALO_VS_V2) quedaron archivados en\r\n      // ai-gfx/argentina-streamers/unused/ -- ya NO son el asset activo.\r\n      // NOTA (2026-09-01): los .mov entregados eran ProRes 4444 (canal alfa\r\n      // real, \"yuva444p12le\") -- ningun navegador/Chromium (ni el Program\r\n      // real dentro de vMix) puede decodificar ese codec (confirmado en\r\n      // vivo: video.error.message = \"DEMUXER_ERROR_NO_SUPPORTED_STREAMS\").\r\n      // Transcodificados UNA vez a .mp4 H.264 apilado color+alfa (mismo\r\n      // formato que usa el resto del proyecto -- ver el comentario de\r\n      // cabecera de program/js/alpha-video.js, que documenta este mismo\r\n      // pipeline como el estandar ya usado en todo el proyecto). Mismo\r\n      // contenido visual, sin recortes ni ediciones -- solo cambia el\r\n      // contenedor/codec para que sea reproducible. Los .mov originales NO\r\n      // se borraron: quedan archivados en\r\n      // ai-gfx/argentina-streamers/prores-originals/ (fuera de git, ver\r\n      // .gitignore) por si hace falta re-transcodificar con otros ajustes.\r\n      zocaloCompuesto: {\r\n        variants: {\r\n          logo: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4',\r\n          equipos: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-equipos-alpha.mp4',\r\n        },\r\n      },\r\n      zocaloCompuestoEquipos: { video: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-equipos-alpha.mp4' },\r\n      // Z\u00D3CALO VS (2026-10-09): \"cosas sueltas/zocalos_vs_solo.mov\" y\r\n      // \"zocalos_vs_goles.mov\" (ProRes 4444 con alfa, 1920x1080, 30fps, 6s),\r\n      // identificados por contenido (pastilla VS angosta / ancha con lugar\r\n      // para goles) y transcodificados con la receta de siempre (color +\r\n      // alfa apilados, H.264). \"video\" = variante por defecto.\r\n      zocaloVs: {\r\n        video: '/assets/themes/argentina-streamers/zocalos/zocalo-vs-solo-alpha.mp4',\r\n        variants: {\r\n          solo: '/assets/themes/argentina-streamers/zocalos/zocalo-vs-solo-alpha.mp4',\r\n          goles: '/assets/themes/argentina-streamers/zocalos/zocalo-vs-goles-alpha.mp4',\r\n        },\r\n      },\r\n      zocaloCompuestoLogo: {\r\n        video: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4',\r\n        image: '/assets/themes/argentina-streamers/zocalos/logo-localstrike.png'\r\n      },\r\n      // VS Prepartido/Resultado (2026-09-01): los 2 assets estaban\r\n      // CRUZADOS -- el que hoy vivia ac\u00E1 como \"vsPrepartido\" en realidad\r\n      // tenia el recuadro verde de resultado (confirmado por inspeccion\r\n      // real de frames con ffmpeg, no por nombre de archivo). Corregido:\r\n      // \"vs-prepartido-alpha.mov\" (sin recuadro verde, del ZIP) es el\r\n      // Prepartido real; el .mp4 que estaba mal puesto aca se movio a\r\n      // \"vsResultado\" (recuadro verde, contenido correcto para ese modulo).\r\n      vsPrepartido: { video: '/assets/themes/argentina-streamers/vs/vs-prepartido-alpha.mp4' },\r\n      // vsResultado (2026-09-02): PNG real (VS_RESULTADO entregado por el\r\n      // usuario) reemplaza al .mp4 anterior -- geometria vertical medida\r\n      // pixel a pixel, ver program/js/renderers/vsResultado.js. El video\r\n      // viejo (vs-resultado-alpha.mp4) queda sin referenciar; no se borro\r\n      // el archivo por las dudas, solo se dejo de usar.\r\n      // Revertido (2026-09-04, pedido explicito del usuario: \"se reemplazo\r\n      // accidentalmente por el asset que corresponde a RESULTADOS\r\n      // PARCIALES\") al video que este modulo usaba ANTES del cambio a PNG\r\n      // del 2026-09-02 (commit 83cf1fa) -- confirmado por git history, no\r\n      // inventado. El PNG \"vs-resultado.png\" y su geometria vertical\r\n      // quedan reservados exclusivamente para \"resultadosParciales\" (ver\r\n      // esa entrada mas abajo), que ya tiene su propio asset separado\r\n      // \"resultados-parciales.png\" -- no se vuelven a mezclar.\r\n      vsResultado: { video: '/assets/themes/argentina-streamers/vs/vs-resultado-alpha.mp4' },\r\n      // Estrellas (2026-09-01): asset real (\"ASSET ESTRELLAS\" del ZIP) --\r\n      // solo el asset visual, la logica de datos (jugadores/escudos/\r\n      // stats/PJ/editores/posiciones) sigue exactamente igual, sin tocar.\r\n      estrellas: { video: '/assets/themes/argentina-streamers/estrellas/estrellas-alpha.mp4' },\r\n      formacionEquipos: {\r\n        video: '/assets/themes/argentina-streamers/formaciones/formacion-alpha.mp4',\r\n        // Mapping por teamId estable. Argentina masculino y femenino\r\n        // comparten el PNG entregado; equipos con valor null quedan sin\r\n        // capa de camisetas hasta que el operador integre su asset real.\r\n        formationAssetsByTeam: {\r\n          'argentina-streamers': '/assets/themes/argentina-streamers/formaciones/kits/formacion-arg.png',\r\n          'argentina-streamers-fem': '/assets/themes/argentina-streamers/formaciones/kits/formacion-arg.png',\r\n          // Argentina Senior (2026-09-04, pedido explicito): misma camiseta\r\n          // FORMACION ARG que Argentina Streamers / FEM.\r\n          'argentina-senior': '/assets/themes/argentina-streamers/formaciones/kits/formacion-arg.png',\r\n          oxen: '/assets/themes/argentina-streamers/formaciones/kits/formacion-oxen.png',\r\n          'peru-creadores': '/assets/themes/argentina-streamers/formaciones/kits/formacion-peru.png',\r\n        },\r\n      },\r\n      // Historial (2026-09-02): PNG real entregado por el usuario --\r\n      // geometria medida pixel a pixel, ver program/js/renderers/historial.js.\r\n      historial: { image: '/assets/themes/argentina-streamers/tablas/historial.png' },\r\n      // Goleadores/Asistidores/Participaciones (2026-09-02): comparten UN\r\n      // unico PNG real (10 slots, sin escudo por fila -- ver\r\n      // program/js/renderers/performanceTable.js), mismo archivo en los 3,\r\n      // sin duplicarlo en disco.\r\n      goleadores: { image: '/assets/themes/argentina-streamers/tablas/tabla-estadisticas.png' },\r\n      asistidores: { image: '/assets/themes/argentina-streamers/tablas/tabla-estadisticas.png' },\r\n      jugadores: { image: '/assets/themes/argentina-streamers/tablas/tabla-estadisticas.png' },\r\n      // Ficha Jugador (BLOQUE 4, 2026-09-09): PNG real entregado en\r\n      // \"cosas sueltas/JUGADORES.png\" -- copiado a la carpeta permanente\r\n      // del theme (no referencia \"cosas sueltas\" en runtime). Geometria\r\n      // medida pixel a pixel en vivo, ver program/js/renderers/fichaJugador.js.\r\n      fichaJugador: { image: '/assets/themes/argentina-streamers/tablas/ficha-jugador.png' },\r\n      // Cronograma Hoy (2026-09-02): PNG real (VS_DEFAULT entregado por el\r\n      // usuario) -- reemplaza la tarjeta fabricada en CSS que habia antes.\r\n      cronogramaHoy: { image: '/assets/themes/argentina-streamers/brackets/cronograma-hoy.png' },\r\n      // Resultados Parciales (2026-09-03, correcci\u00F3n expl\u00EDcita del\r\n      // usuario): PNG real entregado en \"cosas sueltas/PSD/vs_resultado.psd\"\r\n      // (confirmado por inspecci\u00F3n -- mismos escudos con cuadrito blanco\r\n      // de resultado que VS_RESULTADO), exportado y copiado a la carpeta\r\n      // permanente de este theme (no referencia \"cosas sueltas\" en\r\n      // runtime) -- reemplaza la tarjeta fabricada en CSS que habia antes.\r\n      resultadosParciales: { image: '/assets/themes/argentina-streamers/brackets/resultados-parciales.png' },\r\n      // Sitio Web Promo L (2026-09-02): PNG real (ANUNCIO_AS entregado).\r\n      // \"variants\" (2026-09-14, RESTAURADO -- ver comentario en\r\n      // shared/modules.js \"sitioWebPromoL.fields\" para la causa raiz del\r\n      // desplegable perdido): \"argentina-streamers\" es el mismo PNG de\r\n      // siempre, sin cambios. \"punch\" queda en null A PROPOSITO -- busqu\u00E9\r\n      // en todo el repo (incluida \"cosas sueltas/\") y el UNICO archivo\r\n      // \"PUNCH.png\" que existe es un logo de sponsor de 297\u00D7109 (mismo\r\n      // tama\u00F1o que el resto de \"SPONSORS ZOCALO/\"), no una placa\r\n      // full-bleed 1920\u00D71080 -- no hay ningun \"ANUNCIO_PUNCH\" real\r\n      // entregado todavia. Usar ese logo chico estirado a pantalla completa\r\n      // se ver\u00EDa roto/pixelado -- se deja pendiente (mismo criterio que\r\n      // \"THEME EN PREPARACI\u00D3N\" en el resto del proyecto) hasta recibir el\r\n      // asset correcto, en vez de inventar un placeholder.\r\n      sitioWebPromoL: {\r\n        variants: {\r\n          'argentina-streamers': '/assets/themes/argentina-streamers/extras/anuncio-as.png',\r\n          punch: null,\r\n        },\r\n      },\r\n    },\r\n  },\r\n};\r\n\r\nexport function listThemes() {\r\n  return Object.values(THEMES);\r\n}\r\n\r\nexport function isValidThemeId(themeId) {\r\n  return Object.prototype.hasOwnProperty.call(THEMES, themeId);\r\n}\r\n\r\nexport function getTheme(themeId) {\r\n  return THEMES[themeId] || THEMES[DEFAULT_THEME_ID];\r\n}\r\n\r\nexport function isThemeReady(themeId) {\r\n  return Boolean(getTheme(themeId)?.ready);\r\n}\r\n\r\n// getThemeAsset(themeId, moduleId, kind?) -- el punto de entrada que\r\n// pidi\u00F3 el enunciado (\"Cada m\u00F3dulo deber\u00EDa poder preguntar qu\u00E9 asset\r\n// corresponde al theme activo\"). \"kind\" es opcional ('video'/'image'/\r\n// 'folder'/'variants'); sin \"kind\" devuelve el objeto de asset completo\r\n// del m\u00F3dulo para ese theme, o null si el theme no tiene ese m\u00F3dulo\r\n// todav\u00EDa preparado (ej. cualquier m\u00F3dulo de \"argentinaStreamers\" hoy).\r\nexport function getThemeAsset(themeId, moduleId, kind) {\r\n  const theme = getTheme(themeId);\r\n  const moduleAsset = theme.assets[moduleId];\r\n  if (!moduleAsset) return null;\r\n  return kind ? (moduleAsset[kind] ?? null) : moduleAsset;\r\n}\r\n\r\n// Estado por-m\u00F3dulo (secci\u00F3n 6 del pedido: \"Master puede mostrar\r\n// discretamente ASSET ARGENTINA STREAMERS: PENDIENTE dentro del m\u00F3dulo\r\n// correspondiente\"). Si la entrada trae \"status\" expl\u00EDcito (Argentina\r\n// Streamers, siempre) se usa tal cual; si no (GLA, que nunca lo declara\r\n// porque sus assets ya existen todos) se infiere 'ready' con solo\r\n// comprobar que el m\u00F3dulo tenga *alg\u00FAn* asset real cargado.\r\nexport function getModuleAssetStatus(themeId, moduleId) {\r\n  const asset = getThemeAsset(themeId, moduleId);\r\n  if (!asset) return 'pending';\r\n  if (asset.status) return asset.status;\r\n  return (asset.video || asset.image || asset.folder || asset.variants) ? 'ready' : 'pending';\r\n}\r\n\r\n// Cat\u00E1logo de equipos propio del theme (secci\u00F3n 9: \"Preparar tambi\u00E9n la\r\n// l\u00F3gica de equipos\"). GLA sigue resolviendo su cat\u00E1logo desde\r\n// assets/crests/ (ver server/teams.js) -- esto es exclusivamente para\r\n// themes que todav\u00EDa no tienen esa carpeta de escudos real.\r\nexport function getThemeTeams(themeId) {\r\n  return getTheme(themeId)?.teams || [];\r\n}\r\n","http://127.0.0.1:4430/program/js/visual-compose.js","import { ADJUST_REGISTRY } from '../../shared/adjust-registry.js';\r\nimport { DEFAULT_THEME_ID } from '../../shared/themes.js';\r\nimport { applyElementAdjust } from './text-fit.js';\r\nimport { getActiveThemeId } from './theme-client.js';\r\n\r\n// FUENTE UNICA DE VERDAD para \"AJUSTE DE COMPOSICI\u00D3N\" (2026-09-26, pedido\r\n// explicito del usuario: \"Preview y Program deben renderizar EXACTAMENTE\r\n// la misma composici\u00F3n... no quiero dos sistemas de render\"). Extraido de\r\n// program/js/main.js (donde vivia hasta ahora, unico consumidor real) para\r\n// que program/js/preview-main.js pueda aplicar la MISMA logica en vez de\r\n// una copia -- cualquier fix futuro a como se interpreta un offset/scale\r\n// se escribe una sola vez y beneficia a los dos buses (Program real y\r\n// Preview) por igual.\r\n//\r\n// \"AJUSTE DE COMPOSICI\u00D3N\": posicion X/Y + escala de TODO un modulo como\r\n// una unidad rigida, capa ADICIONAL sobre el dise\u00F1o base (\"posicion final\r\n// = base + offset\", \"escala final = base \u00D7 ajuste\") -- ver shared/\r\n// modules.js (compositionOffsetX/Y/Scale, mezclados en cloneDefaults()\r\n// para cualquier modulo) y master-control/js/composition-control.js (UI).\r\n//\r\n// Se aplica sobre \".content\" (NO sobre \"#mod-<id>\"), a proposito: varios\r\n// modulos ya tienen su PROPIO \"transform\" declarado en CSS sobre\r\n// \"#mod-<id>\" para su posicion de dise\u00F1o (ej. \"#mod-marcadorZocalo\",\r\n// \"#mod-shortDouble\") -- pisarlo con estilo inline desde aca borraria esa\r\n// posicion base. \".content\" es el nodo que cada renderer llena via\r\n// \"contentEl.innerHTML\" (ver program/js/renderers/*.js): ningun renderer\r\n// toca jamas \"contentEl.style\" directamente, asi que este es el UNICO\r\n// punto de la cadena que puede reclamar esa propiedad sin colisionar con\r\n// nada existente.\r\n//\r\n// GOL SIGUE AL MARCADOR (2026-10-21, pedido explicito del usuario, SOLO\r\n// GLA): la animacion de GOL acompa\u00F1a cualquier ajuste de composicion del\r\n// MARCADOR PRINCIPAL. Su propio \"compositionOffsetX/Y/Scale\" pasa a ser el\r\n// AJUSTE FINO RELATIVO al Marcador:\r\n//   posicion final = desplazamiento del Marcador + ajuste propio de GOL\r\n//   escala final   = escala del Marcador \u00D7 ajuste propio de GOL\r\n// Los dos modulos son \"full stage\" con el mismo transform-origin\r\n// (960,540, ver \".content\" en overlay.css), asi que sumar el mismo\r\n// desplazamiento/escala conserva exactamente su relacion visual. Se usan\r\n// los valores VIGENTES del Marcador (los mismos que pinta Program), nunca\r\n// su base guardada: GUARDAR POSICI\u00D3N del Marcador no mueve nada. Argentina\r\n// Streamers conserva su GOL independiente, sin cambios.\r\nexport function composedCompositionData(moduleId, data, allData) {\r\n  if (moduleId !== 'gol' || getActiveThemeId() !== DEFAULT_THEME_ID) return data;\r\n  const sb = allData?.scoreboard;\r\n  if (!sb) return data;\r\n  return {\r\n    compositionOffsetX: (sb.compositionOffsetX || 0) + (data.compositionOffsetX || 0),\r\n    compositionOffsetY: (sb.compositionOffsetY || 0) + (data.compositionOffsetY || 0),\r\n    compositionScale: (sb.compositionScale || 1) * (data.compositionScale || 1),\r\n  };\r\n}\r\n\r\nexport function applyComposition(target, data, moduleId, allData) {\r\n  const source = moduleId ? composedCompositionData(moduleId, data, allData) : data;\r\n  const dx = source.compositionOffsetX || 0;\r\n  const dy = source.compositionOffsetY || 0;\r\n  const scale = source.compositionScale || 1;\r\n  target.content.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;\r\n}\r\n\r\n// Registro declarativo de ajuste individual (ver shared/adjust-registry.js\r\n// para el contrato completo). Corre SIEMPRE junto a \"applyComposition\" para\r\n// cualquier modulo con entradas \"kind:'composition'\" en su registro.\r\n// Resuelve, para un elemento \"crestTeam\", el override POR EQUIPO guardado\r\n// en \"data.crestByTeam\" -- null si no hay equipo resuelto o si ese equipo\r\n// todavia no tiene una posicion propia guardada. El teamId sale SIEMPRE\r\n// del Marcador (\"allData.scoreboard.teamA/teamB\", el mismo criterio que ya\r\n// usan estos renderers para el escudo en si). \"allData\" es la misma\r\n// referencia que Program llama \"latestData\" (snapshot de todos los\r\n// modulos) y Preview arma desde el \"draft\" completo de Master Control --\r\n// ambos exponen \"allData.scoreboard\" con la misma forma.\r\nfunction resolveCrestTeamOverride(entry, data, allData) {\r\n  const sb = allData?.scoreboard;\r\n  if (!sb) return null;\r\n  let slot;\r\n  let teamId;\r\n  if (entry.crestTeam === 'dynamic') {\r\n    const isVisitante = data.equipo === 'visitante';\r\n    slot = isVisitante ? 'away' : 'local';\r\n    teamId = isVisitante ? sb.teamB : sb.teamA;\r\n  } else if (entry.crestTeam === 'B') {\r\n    slot = 'away';\r\n    teamId = sb.teamB;\r\n  } else {\r\n    slot = 'local';\r\n    teamId = sb.teamA;\r\n  }\r\n  // \"crestSlot\" (Z\u00D3CALO VS, 2026-10-09): slot propio por variante en vez de\r\n  // local/away -- el equipo sigue saliendo del mismo lado del Marcador.\r\n  if (entry.crestSlot) slot = entry.crestSlot;\r\n  return (teamId && data.crestByTeam?.[slot]?.[teamId]) || null;\r\n}\r\n\r\nexport function applyElementAdjustRegistry(id, target, data, allData) {\r\n  const entries = ADJUST_REGISTRY[id]?.elements;\r\n  if (!entries || !entries.length) return;\r\n  for (const entry of entries) {\r\n    if (entry.kind !== 'composition') continue;\r\n    // \"querySelectorAll\" (no \"querySelector\"): cubre tanto el caso de un\r\n    // unico elemento (escudo/logo/sponsor puntual) como el de tablas con\r\n    // filas repetidas -- un mismo id \"data-adjust\" puede marcar VARIOS\r\n    // nodos (una fila cada uno), y el mismo offset de columna se les\r\n    // aplica a todos por igual.\r\n    const els = target.content.querySelectorAll(`[data-adjust=\"${entry.id}\"]`);\r\n    if (!els.length) continue;\r\n    const override = entry.crestTeam ? resolveCrestTeamOverride(entry, data, allData) : null;\r\n    const source = override || data;\r\n    const adjustValue = {\r\n      offsetX: source[entry.xKey],\r\n      offsetY: source[entry.yKey],\r\n      scale: source[entry.scaleKey],\r\n    };\r\n    els.forEach((el) => applyElementAdjust(el, adjustValue));\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/hot-pool.js","// HOT POOL / PRELOAD SELECTIVO + RESOURCE MANAGER (2026-09-23, etapa 1-4 de\n// la optimizacion de performance -- ver informe de auditoria 2026-09-21).\n//\n// La auditoria demostro, con medicion real en Program (no una suposicion):\n// video recien creado + play() = 100-500ms de frames perdidos en el TAKE\n// (el arranque del decodificador de video por hardware); el MISMO video ya\n// montado/cargado + play() = ~0ms. Este modulo NO toca el compositor\n// (program/js/alpha-video.js, mas alla del metodo \"holdWarm\" agregado ahi)\n// ni los renderers -- solo declara CUALES modulos se mantienen\n// precalentados y ofrece un registro liviano (lifecycle + limite) que\n// program/js/main.js consulta para decidir cuando reusar en vez de\n// destruir.\n//\n// Lifecycle conceptual (ver program/js/main.js para donde se aplica cada\n// transicion):\n//   COLD    -> no montado, sin _gfxBuilt, sin recursos.\n//   WARM    -> montado (video+canvas+contexto WebGL creados, <video> con\n//              preload=\"auto\" cargando/cargado), PAUSADO, sin animar.\n//   PLAYING -> al aire, reproduciendose.\n//\n// COLD->WARM: se logra llamando al renderer normal del modulo con\n// \"justTaken=false\" sobre un contentEl todavia sin \"_gfxBuilt\" -- el mismo\n// guard \"if (!contentEl._gfxBuilt) buildStructure(...)\" que YA tiene cada\n// renderer arma video/canvas/contexto y jamas llama a \"playFromStart()\"\n// (eso solo pasa si justTaken, o si cambio la variante -- ver el fix de\n// las 4 secciones \"*Changed\" en program/js/renderers/{tarjeta,vs,\n// shortDouble,formacionEquipos}.js). No hizo falta agregar ningun modo\n// especial \"warm\" a los renderers: el guard que ya existia en TODOS ellos\n// alcanza.\n// WARM->PLAYING: un TAKE real llama al renderer con \"justTaken=true\" -- el\n// guard ve \"_gfxBuilt=true\" y NO reconstruye nada, solo llama\n// \"playFromStart()\" sobre el video ya cargado. Tampoco hizo falta tocar\n// nada nuevo aca: es el mismo camino de siempre, simplemente ya no parte\n// de cero.\n// PLAYING->WARM: en vez de \"teardownContent()\" (que destruye todo) al\n// sacar del aire un modulo del Hot Pool, program/js/main.js llama a\n// \"content._alphaVideo.holdWarm()\" y conserva el DOM/\"_gfxBuilt\" intactos.\n\n// IDs REALES del proyecto (confirmados contra shared/modules.js, no\n// adivinados) para la lista pedida por el usuario:\n//   MARCADOR        -> scoreboard\n//   MOSCA           -> bug\n//   ZOCALO LARGO    -> longDouble (\"Zocalo largo doble\")\n//   ZOCALO CORTO    -> shortSimple + shortDouble (\"Zocalo corto simple\" /\n//                       \"Zocalo corto doble\" -- son DOS modulos distintos,\n//                       se precalientan los dos)\n//   TARJETA         -> tarjeta\n//   CAMBIOS         -> cambios\n//   GOL             -> gol (maxima prioridad, ver PROTECTED_MODULE_IDS)\n//   VS              -> vs (\"Zocalo VS compacto\"; vsPrepartido/vsResultado\n//                       son placas fullscreen mucho menos frecuentes, no\n//                       entran en la lista inicial)\n//   TIEMPO ADICIONAL -> marcadorTiempoAdicional (asset PNG estatico, sin\n//                       video/decodificador -- se incluye igual porque no\n//                       cuesta nada real, pero no aporta ningun ahorro de\n//                       hitch por si mismo)\n//\n// Lista extensible a proposito (un array plano, sin logica escondida en\n// otro lado) -- agregar/quitar un modulo del Hot Pool es agregar/quitar su\n// id aca. Subir MAX_WARM_SLOTS si se agregan mas modulos de los que entren\n// hoy (ver comentario de la constante).\n// \"zocaloCompuesto\"/\"posiciones\" (2026-09-24, bug real de GLA: sus\n// animaciones de entrada se veian trabadas). Causa real: NO estaban en\n// esta lista -- cada TAKE creaba video+canvas+contexto WebGL desde cero\n// (el costo de arranque en frio del decodificador de hardware, ~100-500ms\n// de frames perdidos, ya documentado en la auditoria de performance\n// 2026-09-21) en vez de reusar uno ya precalentado como el resto. Se\n// agregan aca con el mismo mecanismo que ya usan los demas -- ver tambien\n// HOT_VARIANT_FIELD/MAX_WARM_SLOTS mas abajo (+2 slots reales por esto).\nexport const HOT_MODULE_IDS = [\n  'scoreboard',\n  'bug',\n  'longDouble',\n  'shortSimple',\n  'shortDouble',\n  'tarjeta',\n  'cambios',\n  'gol',\n  'vs',\n  'marcadorTiempoAdicional',\n  'zocaloCompuesto',\n  'posiciones',\n];\n\nconst HOT_MODULE_ID_SET = new Set(HOT_MODULE_IDS);\n\nexport function isHotModule(id) {\n  return HOT_MODULE_ID_SET.has(id);\n}\n\n// GOL nunca se expulsa del pool aunque el presupuesto este al limite (2026-\n// 09-23, pedido explicito del usuario: \"GOL es especialmente sensible...\n// quiero que GOL sea uno de los recursos de mayor prioridad del pool\").\nexport const PROTECTED_MODULE_IDS = new Set(['gol']);\n\n// Campo de \"data\" que decide la VARIANTE (que .mp4 se monta) de cada\n// modulo del Hot Pool que tiene mas de un asset posible -- mismo campo que\n// cada renderer ya usa en su propio \"contentEl.dataset.X !== data.X\" (ver\n// program/js/renderers/{tarjeta,vs,shortDouble}.js). Un modulo sin entrada\n// aca tiene un unico asset fijo, no hay nada que variar.\nexport const HOT_VARIANT_FIELD = {\n  tarjeta: 'tipo',\n  vs: 'renglon',\n  shortDouble: 'airMode',\n  zocaloCompuesto: 'tipo',\n  posiciones: 'pagina',\n};\n\n// PRESUPUESTO (2026-09-23, \"Resource Manager\", pedido explicito del\n// usuario: \"no quiero que esta optimizacion termine cargando ilimitadamente\n// VRAM\"). Medido en la auditoria: ~163MB de VRAM por video WARM (montado y\n// cargado, sin reproducir) en la maquina de referencia (RTX 3090) -- los 9\n// modulos de la lista de arriba que SI llevan video (todos salvo\n// \"marcadorTiempoAdicional\", que es un PNG) rondarian ~1.5GB si estuvieran\n// los 9 WARM a la vez. 10 deja margen para un swap de variante en vuelo\n// (destruir la vieja + montar la nueva) sin pisar el limite por casualidad,\n// sin ser un numero \"infinito\". Bajarlo en una GPU mas modesta (vMix real)\n// si la medicion de esa maquina (ver seccion 19 del pedido) muestra\n// problema; el mecanismo de expulsion (ver listEvictable) es real y se\n// ejercita en el benchmark de estres, no es decorativo.\n// Subido de 10 a 12 (2026-09-24, fix de arranque en frio de \"zocaloCompuesto\"/\n// \"posiciones\" arriba): 11 modulos con video WARM a la vez ahora (antes 9),\n// ~1.8GB en la misma maquina de referencia -- 12 conserva el mismo margen\n// de 1 slot extra para un swap de variante en vuelo que ya tenia el numero\n// anterior, sin dejar el presupuesto \"infinito\".\nexport const MAX_WARM_SLOTS = 12;\n\n// Registro { key -> { moduleId, variant, state: 'warm'|'playing', lastUsed } }.\n// \"key\" es \"moduleId\" a secas para los modulos de esta lista (un unico\n// slot WARM por modulo -- ver seccion 9 del pedido: \"variante actual WARM\"\n// en vez de precargar todas las variantes de todos los modulos, decision\n// documentada aca). Vive en memoria del propio Program (una pesta\u00F1a); no\n// necesita persistir entre recargas.\nconst registry = new Map();\n\nexport function trackWarm(key, moduleId, variant) {\n  registry.set(key, { moduleId, variant, state: 'warm', lastUsed: Date.now() });\n}\n\n// \"markPlaying\"/\"markWarm\" crean la entrada si todavia no existia (ej. un\n// modulo del Hot Pool que se tomo al aire ANTES de que \"warmHotModules()\"\n// llegara a precalentarlo -- primer Take justo despues del arranque de\n// Program) en vez de ignorar la transicion en silencio; asi el registro\n// nunca queda desincronizado del estado real por una carrera de timing.\nexport function markPlaying(key, moduleId = key) {\n  const entry = registry.get(key);\n  if (entry) { entry.state = 'playing'; entry.lastUsed = Date.now(); }\n  else registry.set(key, { moduleId, variant: undefined, state: 'playing', lastUsed: Date.now() });\n}\n\nexport function markWarm(key, moduleId = key) {\n  const entry = registry.get(key);\n  if (entry) { entry.state = 'warm'; entry.lastUsed = Date.now(); }\n  else registry.set(key, { moduleId, variant: undefined, state: 'warm', lastUsed: Date.now() });\n}\n\nexport function untrack(key) {\n  registry.delete(key);\n}\n\nexport function touch(key) {\n  const entry = registry.get(key);\n  if (entry) entry.lastUsed = Date.now();\n}\n\n// Candidatos a expulsar cuando la cantidad de slots WARM supera el\n// presupuesto: los MENOS usados recientemente primero, nunca uno\n// \"playing\" (al aire) ni uno protegido (ver PROTECTED_MODULE_IDS). Devuelve\n// solo las keys que hay que bajar a COLD para volver a estar dentro del\n// limite -- quien llama es responsable de hacer el \"destroy()\" real.\nexport function listEvictable(limit = MAX_WARM_SLOTS) {\n  const warm = [...registry.entries()]\n    .filter(([key, entry]) => entry.state === 'warm' && !PROTECTED_MODULE_IDS.has(entry.moduleId))\n    .sort((a, b) => a[1].lastUsed - b[1].lastUsed);\n  const over = warm.length - limit;\n  if (over <= 0) return [];\n  return warm.slice(0, over).map(([key]) => key);\n}\n\n// Introspeccion de solo lectura -- usada para el benchmark/QA y expuesta\n// en program/js/main.js como \"window.__glaHotPool\" para poder inspeccionar\n// el estado del pool desde la consola del navegador durante una\n// transmision real, sin herramientas adicionales.\nexport function snapshot() {\n  return [...registry.entries()].map(([key, entry]) => ({ key, ...entry }));\n}\n","http://127.0.0.1:4430/program/js/take-scheduler.js","// BURST / TAKE SCHEDULER (2026-09-25, siguiente etapa de la optimizacion de\n// performance -- ver informe de auditoria 2026-09-21/23). El Hot Pool (ver\n// program/js/hot-pool.js) ya elimina el costo de CREAR/CARGAR un video en\n// cada Take; el cuello de botella que quedaba, medido con evidencia real,\n// es distinto: cuando VARIOS modulos de video hacen Take casi al mismo\n// instante, cada uno abre su PROPIA sesion de decodificacion de hardware\n// -- eso satura algo a nivel driver/GPU independientemente de si el\n// archivo ya estaba cargado (6 modulos WARM simultaneos: ~285ms de frame\n// maximo). Escalonar esos \"video.play()\" unos pocos milisegundos entre si\n// (sin tocar nada del resto del pipeline: estado, DOM, contenido dinamico\n// siguen siendo 100% inmediatos) bajo ese pico en la prueba exploratoria\n// de 285ms a ~97ms con 60ms de paso.\n//\n// Este modulo NO decide \"si\" reproducir -- eso lo sigue decidiendo cada\n// renderer/alpha-video.js exactamente igual que siempre. Solo decide\n// \"cu\u00E1ndo\" (0ms si no hay r\u00E1faga, un peque\u00F1o delay creciente si la hay), y\n// deja en manos del LLAMADOR (createAlphaVideo en program/js/alpha-video.js)\n// la validez de ese callback diferido -- ver \"token\" mas abajo: este modulo\n// no sabe nada de OUT/destroy/theme cambiado, esa invalidacion vive donde\n// corresponde (alpha-video.js), sin acoplar ambos mecanismos.\n\n// CONFIGURACION CENTRAL (2026-09-25, pedido explicito: \"no distribuir\n// numeros magicos por renderers\"). Valores elegidos por benchmark real\n// (ver informe) -- ver TAKE_STAGGER_MS/HIGH_STAGGER_MS para la\n// justificacion de cada numero. Son los DEFAULT de fabrica; la logica real\n// usa las variables \"current*\" de mas abajo (mismo valor salvo que alguien\n// llame a configureScheduler(), ver esa funcion) para poder ajustarlos en\n// caliente sin reiniciar Program -- util tanto para el benchmark de esta\n// tarea como para afinar en la PC de produccion sin editar codigo.\nexport const TAKE_BURST_WINDOW_MS = 120;\nexport const TAKE_STAGGER_MS = 40;\n// Techo defensivo (seccion 14 del pedido original: \"no quiero resolver\n// esto haciendo 6 modulos x 200ms = 1 segundo de entrada escalonada\"). Con\n// TAKE_STAGGER_MS=40 y este techo, el peor caso (muchisimos modulos NORMAL\n// en la misma rafaga) nunca demora mas de este valor total.\nexport const TAKE_MAX_STAGGER_MS = 160;\n\n// MICRO-STAGGER HIGH (2026-09-26, siguiente etapa -- pedido explicito:\n// \"estos modulos [tarjeta/cambios/replay/varCheck] no deberian arrancar\n// TODOS sus decoders exactamente en el mismo instante\"). Mismo mecanismo\n// que TAKE_STAGGER_MS pero con paso propio, mucho mas chico -- valor\n// elegido por benchmark real, ver informe de esta etapa. El techo propio\n// (HIGH_MAX_STAGGER_MS) mantiene el espiritu de \"practicamente inmediato\"\n// para HIGH aunque hubiera muchos en la misma rafaga.\nexport const HIGH_STAGGER_MS = 10;\nexport const HIGH_MAX_STAGGER_MS = 50;\n\nlet currentBurstWindowMs = TAKE_BURST_WINDOW_MS;\nlet currentStaggerMs = TAKE_STAGGER_MS;\nlet currentMaxStaggerMs = TAKE_MAX_STAGGER_MS;\nlet currentHighStaggerMs = HIGH_STAGGER_MS;\nlet currentHighMaxStaggerMs = HIGH_MAX_STAGGER_MS;\n\n// Override en caliente (2026-09-25, seccion 17 del pedido original +\n// benchmark de esta tarea): \"null\"/\"undefined\" en cualquier campo deja ese\n// parametro como esta. Sin llamar a esto nunca, el scheduler usa\n// exactamente los DEFAULT de arriba -- este mecanismo no cambia el\n// comportamiento de fabrica por si mismo.\nexport function configureScheduler({\n  burstWindowMs, staggerMs, maxStaggerMs, highStaggerMs, highMaxStaggerMs, highPriorityIds, criticalIds,\n} = {}) {\n  if (burstWindowMs != null) currentBurstWindowMs = burstWindowMs;\n  if (staggerMs != null) currentStaggerMs = staggerMs;\n  if (maxStaggerMs != null) currentMaxStaggerMs = maxStaggerMs;\n  if (highStaggerMs != null) currentHighStaggerMs = highStaggerMs;\n  if (highMaxStaggerMs != null) currentHighMaxStaggerMs = highMaxStaggerMs;\n  if (highPriorityIds != null) currentHighPriorityIds = highPriorityIds;\n  if (criticalIds != null) currentCriticalIds = criticalIds;\n}\n\nexport function getSchedulerConfig() {\n  return {\n    burstWindowMs: currentBurstWindowMs,\n    staggerMs: currentStaggerMs,\n    maxStaggerMs: currentMaxStaggerMs,\n    highStaggerMs: currentHighStaggerMs,\n    highMaxStaggerMs: currentHighMaxStaggerMs,\n  };\n}\n\n// PRIORIDAD EN TRES NIVELES (2026-09-26, siguiente etapa -- pedido\n// explicito: \"prioridad significa orden, no simultaneidad\"). Reusa el\n// MISMO moduleId que ya usa todo el proyecto (shared/modules.js) -- no es\n// una lista paralela, es la unica fuente de \"que modulo es cual\" para\n// esta decision puntual de prioridad/timing.\n//\n// CRITICAL (\"gol\"): el unico -- pedido explicito \"GOL sigue siendo\n// CRITICAL... no debe pagar delay artificial\". Nunca entra a NINGUN\n// escalonado, ni siquiera el micro-stagger de HIGH: corre siempre\n// sincronico, sin importar cuantos Takes mas haya en la misma rafaga.\nexport const CRITICAL_MODULE_IDS = new Set(['gol']);\nlet currentCriticalIds = CRITICAL_MODULE_IDS;\n\n// HIGH: gr\u00E1ficas de evento (anuncian algo que ya pas\u00F3 en la cancha, la\n// demora se nota mas que en un z\u00F3calo/VS) -- YA NO son 100% inmediatas\n// como en la etapa anterior: si dos o mas HIGH caen en la misma rafaga,\n// reciben un micro-stagger propio (HIGH_STAGGER_MS) en vez de arrancar\n// todas su decoder exactamente en el mismo frame. La PRIMERA de la rafaga\n// (sea HIGH o NORMAL) sigue siendo siempre inmediata -- ver\n// scheduleTakePlay: eso es lo que preserva \"Take individual no se toca\".\nexport const HIGH_PRIORITY_IDS = new Set(['tarjeta', 'cambios', 'replay', 'varCheck']);\nlet currentHighPriorityIds = HIGH_PRIORITY_IDS;\n\nfunction tierOf(moduleId) {\n  if (currentCriticalIds.has(moduleId)) return 'critical';\n  if (currentHighPriorityIds.has(moduleId)) return 'high';\n  return 'normal';\n}\n\n// DEBUG (2026-09-25, seccion 17 del pedido): activable sin ensuciar\n// produccion -- \"?debug=1\" ya es la convencion existente del proyecto (ver\n// program/js/main.js, initProgramDiagnostics). Nunca loguea nada si no\n// esta activo.\nlet debugEnabled = false;\nexport function setSchedulerDebug(enabled) {\n  debugEnabled = !!enabled;\n}\nfunction log(...args) {\n  if (debugEnabled) console.log('[TAKE-SCHEDULER]', ...args);\n}\n\n// Estado del detector de rafaga -- unico, compartido por TODOS los modulos\n// de video de la pagina (tiene que serlo: una rafaga es, por definicion,\n// \"varios modulos DISTINTOS casi al mismo tiempo\"). \"lastArrivalAt\" se\n// resetea sola apenas pasa TAKE_BURST_WINDOW_MS sin ningun pedido nuevo --\n// no hace falta ningun timer de limpieza aparte. \"burstSlot\" cuenta TODOS\n// los arrivals no-CRITICAL de la rafaga actual (HIGH + NORMAL juntos, un\n// unico contador) -- es lo que garantiza \"una sola linea temporal de\n// decoder starts\" (pedido explicito, seccion 2 de esta etapa) en vez de\n// dos schedulers independientes que pudieran coincidir en el mismo t=0.\nlet lastArrivalAt = -Infinity;\nlet burstSlot = 0;\nlet highCount = 0;\nlet normalCount = 0;\nlet claimedDelays = null; // Set<number> de delays ya asignados en la rafaga actual\nlet burstSeq = 0; // solo para los logs de debug, identifica cada rafaga\n\nfunction resetBurst() {\n  burstSeq += 1;\n  burstSlot = 0;\n  highCount = 0;\n  normalCount = 0;\n  claimedDelays = new Set();\n}\n\n// Asegura que \"preferred\" no colisione con un delay ya entregado a OTRO\n// modulo de esta MISMA rafaga (posible si, ej., el 4to HIGH -- 4*10=40ms --\n// cae justo sobre el 1er NORMAL -- 1*40=40ms). Nudge de 1ms en vez de\n// recalcular todo: con pasos de 10-40ms la probabilidad de choque ya es\n// baja, y esto lo vuelve IMPOSIBLE sin ningun redise\u00F1o mayor.\nfunction claimDelay(preferred, cap) {\n  let d = Math.min(preferred, cap);\n  while (claimedDelays.has(d)) d += 1;\n  claimedDelays.add(d);\n  return d;\n}\n\n// Pide un turno para reproducir. \"run()\" se llama exactamente una vez,\n// sincr\u00F3nico si delay=0 o via setTimeout si no -- el propio llamador es\n// responsable de chequear que la accion siga siendo valida en ese momento\n// (ver \"takeToken\" en program/js/alpha-video.js): este scheduler no\n// cancela nada por si mismo, solo decide el timing. Devuelve una funcion\n// \"cancelTimer()\" para que el llamador pueda limpiar el setTimeout\n// pendiente si el modulo se destruye/pausa antes de que le toque el turno\n// (evita timers huerfanos, aunque \"run\" ya es un no-op seguro si el token\n// no matchea).\nexport function scheduleTakePlay(moduleId, run) {\n  const now = performance.now();\n  const tier = tierOf(moduleId);\n\n  if (tier === 'critical') {\n    // \"gol\": nunca entra a ningun escalonado, ni siquiera al micro-stagger\n    // de HIGH -- seccion 1 de esta etapa, \"GOL sigue siendo CRITICAL\".\n    log(moduleId, '-> CRITICAL, inmediato');\n    run();\n    return () => {};\n  }\n\n  const withinBurst = (now - lastArrivalAt) <= currentBurstWindowMs;\n  if (!withinBurst) resetBurst();\n  lastArrivalAt = now;\n\n  const mySlot = burstSlot;\n  burstSlot += 1;\n\n  if (mySlot === 0) {\n    // Primer Take no-CRITICAL de la rafaga (o un Take individual suelto):\n    // SIEMPRE inmediato, sin importar el tier -- seccion 4 de esta etapa,\n    // \"Take individual no se toca\". El escalonado solo tiene sentido para\n    // los que llegan DESPUES de este primero.\n    log(moduleId, `-> ${tier}, slot 0, inmediato`);\n    run();\n    return () => {};\n  }\n\n  const step = tier === 'high' ? currentHighStaggerMs : currentStaggerMs;\n  const cap = tier === 'high' ? currentHighMaxStaggerMs : currentMaxStaggerMs;\n  const slotInTier = tier === 'high' ? ++highCount : ++normalCount;\n  const delay = claimDelay(slotInTier * step, cap);\n\n  log(moduleId, `-> ${tier}, slot ${mySlot} (${slotInTier}\u00B0 de su tier), delay ${delay}ms (rafaga #${burstSeq})`);\n  const timer = setTimeout(run, delay);\n  return () => clearTimeout(timer);\n}\n","http://127.0.0.1:4430/shared/team-colors.js","// Catalogo de colores de uniforme disponibles para diferenciar equipos en el\r\n// Marcador (circulo de color junto al nombre). Compartido entre Master\r\n// Control (opciones del select) y Program (color real del circulo).\r\n\r\nexport const TEAM_COLORS = [\r\n  { id: 'rojo', label: 'Rojo', hex: '#E13A3A' },\r\n  { id: 'azul', label: 'Azul', hex: '#2159C7' },\r\n  { id: 'verde', label: 'Verde', hex: '#1FA24A' },\r\n  { id: 'amarillo', label: 'Amarillo', hex: '#F0C419' },\r\n  { id: 'negro', label: 'Negro', hex: '#141416' },\r\n  { id: 'blanco', label: 'Blanco', hex: '#F5F5F1' },\r\n  { id: 'dorado', label: 'Dorado', hex: '#E3B23C' },\r\n  { id: 'naranja', label: 'Naranja', hex: '#EF7D1A' },\r\n  { id: 'violeta', label: 'Violeta', hex: '#7B3FE4' },\r\n  { id: 'celeste', label: 'Celeste', hex: '#3FB6E8' },\r\n  { id: 'gris', label: 'Gris', hex: '#9A9A9A' },\r\n];\r\n\r\nexport function colorHex(id) {\r\n  const found = TEAM_COLORS.find((c) => c.id === id);\r\n  return found ? found.hex : '#6b6b68';\r\n}\r\n\r\n// COLOR PERSONALIZADO (2026-10-23, pedido explicito del usuario, GLA):\r\n// \"teamColorAssignments[teamId] = 'personalizado'\" + el HEX exacto en\r\n// \"teamColorCustomHex[teamId]\" (mismo dato del Marcador, ver\r\n// master-control/js/main.js). El HEX se conserva aunque el equipo vuelva a\r\n// un color predefinido, para recuperarlo al elegir PERSONALIZADO otra vez.\r\nexport const CUSTOM_COLOR_ID = 'personalizado';\r\n\r\n// \"#RGB\"/\"#RRGGBB\" (con o sin \"#\") -> \"#RRGGBB\" en mayusculas; null si no\r\n// es un hexadecimal valido.\r\nexport function normalizeHexColor(value) {\r\n  const raw = String(value ?? '').trim().replace(/^#/, '');\r\n  if (/^[0-9a-f]{3}$/i.test(raw)) return `#${raw.split('').map((c) => c + c).join('')}`.toUpperCase();\r\n  if (/^[0-9a-f]{6}$/i.test(raw)) return `#${raw}`.toUpperCase();\r\n  return null;\r\n}\r\n\r\n// Color real de un lado del Marcador ('A' local / 'B' visitante): el\r\n// predefinido por id, o el HEX personalizado de ese equipo. Un HEX\r\n// invalido o ausente cae al gris (nunca rompe el render).\r\nexport function teamColorHex(scoreboard, side) {\r\n  const colorId = side === 'B' ? scoreboard?.teamBColor : scoreboard?.teamAColor;\r\n  if (colorId !== CUSTOM_COLOR_ID) return colorHex(colorId);\r\n  const teamId = side === 'B' ? scoreboard?.teamB : scoreboard?.teamA;\r\n  return normalizeHexColor(scoreboard?.teamColorCustomHex?.[teamId]) || colorHex('gris');\r\n}\r\n","http://127.0.0.1:4430/shared/asset-registry.js","// REGISTRO CENTRAL DE RECURSOS GR\u00C1FICOS (SOFTX, 2026-10-29).\r\n// Una entrada por sistema -> m\u00F3dulo -> recurso. ID p\u00FAblico de cada recurso:\r\n// \"<sistema>.<moduleId>.<recurso>\" (ej. \"gla.scoreboard.principal\",\r\n// \"gla.tarjeta.amarilla\"). Master Control y el servidor solo intercambian\r\n// ese ID: la ruta real se resuelve siempre ac\u00E1 (nunca llega del navegador).\r\n//\r\n// GLA REL\u00C1MPAGO: las rutas viven SOLO en GLA_ASSETS (abajo); los renderers\r\n// de program/js/renderers/*.js las leen con glaAssetPath().\r\n// ARGENTINA STREAMERS: se derivan del manifest que ya exist\u00EDa en\r\n// shared/themes.js (THEMES.argentinaStreamers.assets) -- mismo archivo que\r\n// consumen sus renderers, sin copiar ninguna ruta.\r\nimport { THEMES, DEFAULT_THEME_ID, ARGENTINA_STREAMERS_THEME_ID } from './themes.js';\r\n\r\nexport const ASSET_KIND = {\r\n  ALPHA_VIDEO: 'alpha-video',\r\n  IMAGE: 'image',\r\n};\r\n\r\n// Formato que el runtime actual necesita (no se convierte nada solo).\r\nexport const ASSET_KIND_INFO = {\r\n  [ASSET_KIND.ALPHA_VIDEO]: {\r\n    label: 'VIDEO CON ALFA',\r\n    expected: 'MP4 H.264 con alfa apilado (color arriba, m\u00E1scara abajo)',\r\n  },\r\n  [ASSET_KIND.IMAGE]: {\r\n    label: 'IMAGEN',\r\n    expected: 'PNG (con transparencia si la pieza la necesita)',\r\n  },\r\n};\r\n\r\nconst V = ASSET_KIND.ALPHA_VIDEO;\r\nconst I = ASSET_KIND.IMAGE;\r\n\r\n// \"cssVar\": el recurso se usa desde program/css/overlay.css; Program fija\r\n// esa variable con la URL versionada (ver program/js/asset-versions.js).\r\nconst GLA_ASSETS = {\r\n  scoreboard: [{ slot: 'principal', label: 'Principal', path: '/assets/marcador/marcador-principal-alpha.mp4', kind: V }],\r\n  gol: [{ slot: 'principal', label: 'Gol', path: '/assets/eventos/gol-alpha.mp4', kind: V }],\r\n  marcadorTiempoAdicional: [{ slot: 'principal', label: 'Tiempo adicional', path: '/assets/marcador/marcador-tiempo-adicional.png', kind: I }],\r\n  marcadorEntretiempo: [{ slot: 'principal', label: 'Entretiempo', path: '/assets/marcador/marcador-entretiempo-alpha.mp4', kind: V }],\r\n  marcadorPenales: [{ slot: 'principal', label: 'Penales', path: '/assets/marcador/marcador-penales-alpha.mp4', kind: V }],\r\n  marcadorZocalo: [{ slot: 'principal', label: 'Marcador z\u00F3calo', path: '/assets/marcador/marcador-zocalo.png', kind: I }],\r\n  tarjeta: [\r\n    { slot: 'amarilla', label: 'Amarilla', path: '/assets/eventos/tarjeta-amarilla-alpha.mp4', kind: V },\r\n    { slot: 'roja', label: 'Roja', path: '/assets/eventos/tarjeta-roja-alpha.mp4', kind: V },\r\n    { slot: 'azul', label: 'Azul', path: '/assets/eventos/tarjeta-azul-alpha.mp4', kind: V },\r\n  ],\r\n  cambios: [{ slot: 'principal', label: 'Cambios', path: '/assets/eventos/cambios-alpha.mp4', kind: V }],\r\n  varCheck: [\r\n    { slot: 'principal', label: 'VAR chequeo', path: '/assets/var/var-chequeo-alpha.mp4', kind: V },\r\n    { slot: 'motivo', label: 'Motivo (z\u00F3calo)', path: '/assets/var/zocalo-cortito-brackets.png', kind: I },\r\n  ],\r\n  replay: [{ slot: 'principal', label: 'Replay', path: '/assets/replay/replay-sponsor-alpha.mp4', kind: V }],\r\n  bug: [{ slot: 'principal', label: 'Mosca', path: '/assets/mosca/mosca-localstrike-alpha.mp4', kind: V }],\r\n  longDouble: [{ slot: 'principal', label: 'Z\u00F3calo largo doble', path: '/assets/zocalos/zocalo-largo-doble-alpha.mp4', kind: V }],\r\n  shortSimple: [{ slot: 'principal', label: 'Z\u00F3calo corto simple', path: '/assets/zocalos/zocalo-corto-simple-alpha.mp4', kind: V }],\r\n  shortDouble: [{ slot: 'principal', label: 'Z\u00F3calo corto doble', path: '/assets/zocalos/zocalo-corto-doble-alpha.mp4', kind: V }],\r\n  vs: [\r\n    { slot: 'normal', label: 'Normal', path: '/assets/zocalos/zocalo-vs-alpha.mp4', kind: V },\r\n    { slot: 'alto', label: 'Rengl\u00F3n alto', path: '/assets/zocalos/zocalo-vs-renglon-alto-alpha.mp4', kind: V },\r\n    { slot: 'medio', label: 'Rengl\u00F3n medio', path: '/assets/zocalos/zocalo-vs-renglon-medio-alpha.mp4', kind: V },\r\n    { slot: 'fino', label: 'Rengl\u00F3n fino', path: '/assets/zocalos/zocalo-vs-renglon-fino-alpha.mp4', kind: V },\r\n  ],\r\n  zocaloCompuesto: [\r\n    { slot: 'equipos', label: 'Tipo equipos', path: '/assets/zocalos/zocalo-final-div-alpha.mp4', kind: V },\r\n    { slot: 'logo', label: 'Tipo logo', path: '/assets/zocalos/zocalo-final-alpha.mp4', kind: V },\r\n    { slot: 'logoImagen', label: 'Logo GLA', path: '/assets/images/gla-logo.png', kind: I },\r\n  ],\r\n  zocaloFinal: [\r\n    { slot: 'principal', label: 'Z\u00F3calo final', path: '/assets/zocalos/zocalo-final-alpha.mp4', kind: V },\r\n    { slot: 'logoImagen', label: 'Logo GLA', path: '/assets/images/gla-logo.png', kind: I },\r\n  ],\r\n  zocaloFinalDiv: [{ slot: 'principal', label: 'Z\u00F3calo final con equipos', path: '/assets/zocalos/zocalo-final-div-alpha.mp4', kind: V }],\r\n  vsPrepartido: [{ slot: 'principal', label: 'VS prepartido', path: '/assets/placas/vs-prepartido-alpha.mp4', kind: V }],\r\n  vsResultado: [{ slot: 'principal', label: 'VS con resultado', path: '/assets/placas/vs-resultado-alpha.mp4', kind: V }],\r\n  estrellas: [{ slot: 'principal', label: 'Estrellas', path: '/assets/placas/estrellas-alpha.mp4', kind: V }],\r\n  formacionEquipos: [\r\n    { slot: 'principal', label: 'Placa', path: '/assets/placas/formacion-equipos.mp4', kind: V },\r\n    { slot: 'camisetas', label: 'Camisetas', path: '/assets/placas/formacion-camisetas.png', kind: I },\r\n    { slot: 'camisetasBlancas', label: 'Camisetas (m\u00E1scara de color)', path: '/assets/placas/formacion-camisetas-blancas.png', kind: I, cssVar: '--softx-asset-formacion-camisetas-blancas' },\r\n  ],\r\n  grupos: [\r\n    { slot: 'grupo1', label: 'Grupo 1', path: '/assets/grupos/grupo-1.png', kind: I },\r\n    { slot: 'grupo2', label: 'Grupo 2', path: '/assets/grupos/grupo-2.png', kind: I },\r\n  ],\r\n  sideTable: [{ slot: 'fondo', label: 'Fondo', path: '/assets/tablas/resultados-sin-vs.png', kind: I, cssVar: '--softx-asset-resultados-fondo' }],\r\n  // posiciones/posicionesTorneo comparten renderer y archivos: las p\u00E1ginas\r\n  // 2 y 3 usan el mismo video.\r\n  posiciones: [\r\n    { slot: 'pagina1', label: 'P\u00E1gina 1', path: '/assets/tablas/posiciones-alpha.mp4', kind: V },\r\n    { slot: 'pagina2', label: 'P\u00E1ginas 2 y 3', path: '/assets/tablas/posiciones-5-alpha.mp4', kind: V },\r\n  ],\r\n  posicionesTorneo: [\r\n    { slot: 'pagina1', label: 'P\u00E1gina 1', path: '/assets/tablas/posiciones-alpha.mp4', kind: V },\r\n    { slot: 'pagina2', label: 'P\u00E1ginas 2 y 3', path: '/assets/tablas/posiciones-5-alpha.mp4', kind: V },\r\n  ],\r\n  goleadores: [{ slot: 'principal', label: 'Tabla goleadores', path: '/assets/tablas/tabla-goleadores.png', kind: I }],\r\n  asistidores: [{ slot: 'principal', label: 'Tabla asistidores', path: '/assets/tablas/tabla-asistidores.png', kind: I }],\r\n  jugadores: [{ slot: 'principal', label: 'Tabla jugadores', path: '/assets/tablas/mejores-jugadores.png', kind: I }],\r\n};\r\n\r\n// M\u00F3dulos sin pesta\u00F1a propia cuyos recursos se muestran dentro de otro\r\n// panel (GOL se dispara desde MARCADOR; el motivo del VAR y el logo del\r\n// z\u00F3calo compuesto AS viven en entradas propias del manifest).\r\nconst PANEL_LINKS = {\r\n  scoreboard: ['gol'],\r\n  varCheck: ['varCheckMotivo'],\r\n  zocaloCompuestoEquipos: ['zocaloCompuestoLogo'],\r\n};\r\n\r\nconst AS_LABELS = {\r\n  gol: { principal: 'Gol' },\r\n  varCheckMotivo: { principal: 'Motivo (z\u00F3calo)' },\r\n  zocaloCompuestoEquipos: { principal: 'Tipo equipos' },\r\n  zocaloCompuestoLogo: { principal: 'Tipo logo', imagen: 'Logo' },\r\n};\r\n\r\nfunction kindForPath(path) {\r\n  return /\\.(mp4|webm|mov)$/i.test(path) ? V : I;\r\n}\r\n\r\nfunction prettyKey(key) {\r\n  return key.replace(/[-_]+/g, ' ').replace(/^\\w/, (c) => c.toUpperCase());\r\n}\r\n\r\nfunction deriveFromThemeManifest(themeId) {\r\n  const out = {};\r\n  for (const [moduleId, asset] of Object.entries(THEMES[themeId]?.assets || {})) {\r\n    if (!asset || typeof asset !== 'object') continue;\r\n    const slots = [];\r\n    const seen = new Set();\r\n    const labels = AS_LABELS[moduleId] || {};\r\n    const push = (slot, label, path) => {\r\n      if (typeof path !== 'string' || !path.startsWith('/assets/') || seen.has(path)) return;\r\n      seen.add(path);\r\n      slots.push({ slot, label: labels[slot] || label, path, kind: kindForPath(path) });\r\n    };\r\n    for (const [key, path] of Object.entries(asset.variants || {})) push(key, prettyKey(key), path);\r\n    push('principal', 'Principal', asset.video);\r\n    push('imagen', 'Imagen', asset.image);\r\n    for (const path of Object.values(asset.formationAssetsByTeam || {})) {\r\n      const file = path.split('/').pop().replace(/\\.[^.]+$/, '');\r\n      push(`kit-${file}`, `Camisetas ${file.replace(/^formacion-/, '').toUpperCase()}`, path);\r\n    }\r\n    if (slots.length) out[moduleId] = slots;\r\n  }\r\n  return out;\r\n}\r\n\r\nconst REGISTRY = {\r\n  [DEFAULT_THEME_ID]: GLA_ASSETS,\r\n  [ARGENTINA_STREAMERS_THEME_ID]: deriveFromThemeManifest(ARGENTINA_STREAMERS_THEME_ID),\r\n};\r\n\r\nfunction withId(systemId, moduleId, entry) {\r\n  return { ...entry, id: `${systemId}.${moduleId}.${entry.slot}`, systemId, moduleId };\r\n}\r\n\r\n// Ruta GLA de un recurso puntual -- la usan los renderers en vez de una\r\n// constante propia. Un ID inexistente es un error de programaci\u00F3n (falla\r\n// fuerte en vez de dejar el m\u00F3dulo sin gr\u00E1fica en silencio).\r\nexport function glaAssetPath(moduleId, slot) {\r\n  const entry = GLA_ASSETS[moduleId]?.find((e) => e.slot === slot);\r\n  if (!entry) throw new Error(`[SOFTX] Recurso GLA no registrado: ${moduleId}.${slot}`);\r\n  return entry.path;\r\n}\r\n\r\nexport function getModuleAssets(systemId, moduleId) {\r\n  return (REGISTRY[systemId]?.[moduleId] || []).map((entry) => withId(systemId, moduleId, entry));\r\n}\r\n\r\n// Recursos que muestra el panel RECURSO GR\u00C1FICO de un m\u00F3dulo (propios +\r\n// m\u00F3dulos vinculados sin pesta\u00F1a).\r\nexport function getPanelAssets(systemId, moduleId) {\r\n  const own = getModuleAssets(systemId, moduleId);\r\n  const linked = (PANEL_LINKS[moduleId] || []).flatMap((linkedId) => getModuleAssets(systemId, linkedId));\r\n  return [...own, ...linked];\r\n}\r\n\r\nexport function listSystemAssets(systemId) {\r\n  return Object.keys(REGISTRY[systemId] || {}).flatMap((moduleId) => getModuleAssets(systemId, moduleId));\r\n}\r\n\r\nexport function getAssetById(assetId) {\r\n  const [systemId, moduleId, slot] = String(assetId || '').split('.');\r\n  if (!systemId || !moduleId || !slot) return null;\r\n  const entry = REGISTRY[systemId]?.[moduleId]?.find((e) => e.slot === slot);\r\n  return entry ? withId(systemId, moduleId, entry) : null;\r\n}\r\n\r\n// M\u00F3dulos (de un sistema) que usan una ruta dada -- Program los recarga\r\n// cuando ese archivo cambia, aunque lo compartan varios m\u00F3dulos.\r\nexport function modulesUsingPath(systemId, path) {\r\n  const out = [];\r\n  for (const [moduleId, slots] of Object.entries(REGISTRY[systemId] || {})) {\r\n    if (slots.some((e) => e.path === path)) out.push(moduleId);\r\n  }\r\n  return out;\r\n}\r\n\r\nexport function listCssVarAssets() {\r\n  return Object.entries(REGISTRY).flatMap(([systemId, modules]) => Object.entries(modules)\r\n    .flatMap(([moduleId, slots]) => slots.filter((e) => e.cssVar).map((e) => withId(systemId, moduleId, e))));\r\n}\r\n","http://127.0.0.1:4430/shared/sponsors.js","let sponsors = { scoreboard: [], var: [], vs_compact: [], zocalo: [] };\r\nif (typeof window === 'undefined') {\r\n  try {\r\n    const { getSponsorsCatalog } = await import('../server/sponsors.js');\r\n    sponsors = getSponsorsCatalog();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo leer el catalogo de sponsors (Node):', err);\r\n  }\r\n} else {\r\n  try {\r\n    const res = await fetch('/api/sponsors');\r\n    sponsors = await res.json();\r\n  } catch (err) {\r\n    console.error('[GLA] No se pudo cargar el catalogo de sponsors:', err);\r\n  }\r\n}\r\n\r\nexport const SPONSORS = sponsors;\r\n\r\nexport const SPONSOR_OPTIONS = {\r\n  scoreboard: [\r\n    { id: '', label: 'SIN SPONSOR' },\r\n    ...sponsors.scoreboard.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n  ],\r\n  var: [\r\n    { id: '', label: 'SIN SPONSOR' },\r\n    ...sponsors.var.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n  ],\r\n  vs_compact: [\r\n    { id: '', label: 'SIN SPONSOR' },\r\n    ...sponsors.vs_compact.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n  ],\r\n  zocalo: sponsors.zocalo.map((s) => ({ id: s.name, label: s.name, file: s.file })),\r\n};\r\n\r\nexport function sponsorFile(category, id) {\r\n  if (!id) return '';\r\n  const list = sponsors[category] || [];\r\n  return list.find((s) => s.name === id)?.file || '';\r\n}\r\n","http://127.0.0.1:4430/shared/clock.js","// Reloj de partido: el servidor solo guarda una referencia (corriendo o no,\r\n// tiempo acumulado, marca de tiempo de arranque). Cada cliente calcula el\r\n// tiempo transcurrido localmente con Date.now(), asi no hace falta que el\r\n// servidor emita un tick por segundo para mantenerlo sincronizado.\r\n\r\nexport function emptyClock() {\r\n  return { running: false, accumulatedMs: 0, startedAt: null };\r\n}\r\n\r\n// \"limitMs\" (2026-08-15, pedido explicito del usuario: contador con fin\r\n// configurable \u2014 Marcador principal y Marcador Zocalo). Parametro\r\n// OPCIONAL y aditivo: si no se pasa (undefined/null), el comportamiento\r\n// es exactamente el de siempre, sin clamping \u2014 ningun llamador existente\r\n// que no conozca este parametro cambia de comportamiento. Cuando se pasa,\r\n// el valor devuelto nunca supera el limite: una vez alcanzado, tanto\r\n// Program (que llama esto en cada tick de 500ms, ver program/js/main.js)\r\n// como los paneles de Master Control (que tambien usan esta misma funcion\r\n// para Play/Pause/Fijar) ven siempre el mismo valor trabado, sin importar\r\n// cuanto tiempo real siga \"corriendo\" el reloj por detras -- asi que\r\n// aunque el operador aprete Pausa recien despues de haberlo dejado\r\n// corriendo un buen rato pasado el limite, lo que se congela en\r\n// \"accumulatedMs\" es el valor YA topeado, nunca el tiempo real sin topear\r\n// (ver mkBtn('Pause'...) en master-control/js/scoreboard-clock-panel.js).\r\nexport function elapsedMs(clock, limitMs) {\r\n  if (!clock) return 0;\r\n  const base = clock.accumulatedMs || 0;\r\n  const raw = clock.running && clock.startedAt ? base + (Date.now() - clock.startedAt) : base;\r\n  if (limitMs != null && raw >= limitMs) return limitMs;\r\n  return raw;\r\n}\r\n\r\nexport function formatClock(ms) {\r\n  const totalSeconds = Math.max(0, Math.floor(ms / 1000));\r\n  const minutes = Math.floor(totalSeconds / 60);\r\n  const seconds = totalSeconds % 60;\r\n  return `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;\r\n}\r\n\r\n// Parsea un texto \"MM:SS\" tipeado por el operador (campo \"FIN DEL\r\n// CONTADOR\") a milisegundos. Tolerante: minutos de 1 a 3 digitos,\r\n// segundos de 0 a 59 -- si no matchea el formato devuelve el fallback tal\r\n// cual (nunca null/NaN, para que un texto invalido no rompa el reloj,\r\n// simplemente se ignora el limite hasta que el operador lo corrija).\r\nexport function parseClockLimit(text, fallbackMs) {\r\n  if (typeof text !== 'string') return fallbackMs;\r\n  const match = text.trim().match(/^(\\d{1,3}):([0-5]?\\d)$/);\r\n  if (!match) return fallbackMs;\r\n  const minutes = parseInt(match[1], 10);\r\n  const seconds = parseInt(match[2], 10);\r\n  return (minutes * 60 + seconds) * 1000;\r\n}\r\n","http://127.0.0.1:4430/shared/adjust-path.js","// Helpers puros para leer/escribir valores anidados en los arboles de\n// datos de \"textAdjust\" y offsets de composicion (2026-09-01, sistema de\n// LAYOUT BASE VERSIONADO -- pedido explicito del usuario: \"GUARDAR\n// POSICI\u00D3N\" debe consolidar el ajuste en vivo dentro de un archivo\n// versionado por Git, no en el estado runtime gitignorado). Sin\n// dependencias -- lo importan tanto server/ (Node) como master-control/js\n// (navegador) via el mismo modulo ES, igual que el resto de shared/.\n\n// Camina \"path\" (arreglo de claves) sobre \"root\", devolviendo undefined en\n// cuanto encuentra un nivel inexistente en vez de tirar.\nexport function getAtPath(root, path) {\n  let node = root;\n  for (const key of path) {\n    if (node == null) return undefined;\n    node = node[key];\n  }\n  return node;\n}\n\n// Crea/reutiliza los objetos intermedios de \"path\" dentro de \"root\" y\n// mezcla \"patch\" (shallow) en el nodo final -- usado para escribir la\n// nueva base de UN elemento sin pisar el resto del archivo de layout.\nexport function setDeepMerge(root, path, patch) {\n  let node = root;\n  for (const key of path) {\n    if (typeof node[key] !== 'object' || node[key] === null || Array.isArray(node[key])) {\n      node[key] = {};\n    }\n    node = node[key];\n  }\n  Object.assign(node, patch);\n}\n\n// Mezcla recursiva \"override\" encima de \"target\": objetos planos se\n// combinan clave por clave (recursivo), cualquier otro tipo (numero,\n// string, array) pisa directo. Usado por \"cloneDefaults\" (shared/modules.js)\n// para aplicar el layout base versionado sobre los defaults estructurales\n// de cada modulo, y por el script de migracion para el mismo fin.\nexport function deepMergeAdjustFields(target, override) {\n  if (!override || typeof override !== 'object') return target;\n  for (const [key, value] of Object.entries(override)) {\n    if (value && typeof value === 'object' && !Array.isArray(value)\n      && target[key] && typeof target[key] === 'object' && !Array.isArray(target[key])) {\n      deepMergeAdjustFields(target[key], value);\n    } else {\n      target[key] = value;\n    }\n  }\n  return target;\n}\n","http://127.0.0.1:4430/program/js/renderers/vs.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, fitFontSize, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\n\r\nconst VIDEO_BY_RENGLON = {\r\n  normal: glaAssetPath('vs', 'normal'),\r\n  alto: glaAssetPath('vs', 'alto'),\r\n  medio: glaAssetPath('vs', 'medio'),\r\n  fino: glaAssetPath('vs', 'fino'),\r\n};\r\n\r\n// Anchos reales de \".ov-vs-teamA/B\", \".ov-vs-goalA/B\" y \".ov-vs-status\"\r\n// (ver overlay.css) \u2014 mismo criterio de auto-ajuste que Tarjeta/Cambios.\r\n// Nombre COMPLETO (no abreviatura): box de 250px, compartido con el\r\n// escudo dentro de la misma zona negra del asset (ver overlay.css).\r\n// Fuentes de nombre/gol/estado subidas levemente (2026-08-03, pedido\r\n// explicito del usuario: \"aument\u00E1 levemente el tama\u00F1o\" / \"aumente\r\n// claramente de tama\u00F1o\" para el estado) \u2014 solo estas constantes de\r\n// auto-ajuste, sin tocar boxes horizontales ni logica de datos.\r\nconst TEAM_MAX_FONT = 30;\r\nconst TEAM_MIN_FONT = 14;\r\nconst TEAM_BOX_WIDTH = 250;\r\nconst TEAM_SAFETY_MARGIN = 14;\r\nconst TEAM_MAX_WIDTH = TEAM_BOX_WIDTH - TEAM_SAFETY_MARGIN;\r\n// Unico ajuste vertical para ambos equipos. Antes applyFittedText calculaba\r\n// un translateY distinto segun los glifos de cada nombre (por ejemplo,\r\n// \"Brarg\" -2px y \"Dou FC\" +0.5px), aunque las dos cajas CSS fueran\r\n// identicas. El auto-ajuste conserva la logica compartida de font-size,\r\n// pero la longitud/contenido ya no puede cambiar la posicion vertical.\r\nconst TEAM_VERTICAL_OFFSET = 0.5;\r\n\r\n// Gol de cada equipo: recuadro amarillo lateral propio (74-75px, ver\r\n// overlay.css), separado del estado real (bloque central angosto,\r\n// 80px, marcado por la cintura de las muescas del asset).\r\nconst GOAL_MAX_FONT = 40;\r\nconst GOAL_MIN_FONT = 16;\r\nconst GOAL_BOX_WIDTH = 74;\r\nconst GOAL_SAFETY_MARGIN = 10;\r\nconst GOAL_MAX_WIDTH = GOAL_BOX_WIDTH - GOAL_SAFETY_MARGIN;\r\n\r\nconst STATUS_MAX_FONT = 28;\r\nconst STATUS_MIN_FONT = 11;\r\nconst STATUS_BOX_WIDTH = 80;\r\nconst STATUS_SAFETY_MARGIN = 4;\r\nconst STATUS_MAX_WIDTH = STATUS_BOX_WIDTH - STATUS_SAFETY_MARGIN;\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nasync function applyTeamName(el, rawText, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  const text = toBroadcastUpper(rawText);\r\n  el.textContent = text;\r\n  el.style.transform = `translate(${dx}px, ${TEAM_VERTICAL_OFFSET + dy}px)`;\r\n  const size = await fitFontSize(text, {\r\n    maxFont: TEAM_MAX_FONT,\r\n    minFont: TEAM_MIN_FONT,\r\n    maxWidth: TEAM_MAX_WIDTH,\r\n    weight: 800,\r\n  });\r\n  // Evita que una medicion asincronica anterior pise una actualizacion mas\r\n  // reciente si el operador cambia de equipo rapidamente.\r\n  if (el.textContent === text) el.style.fontSize = `${Math.max(1, size + dSize)}px`;\r\n}\r\n\r\n// Sin campos de equipo propios: equipo A/B (nombre completo, abreviatura\r\n// de 3 letras y escudo) se leen en vivo de \"scoreboard\" (5to argumento,\r\n// mismo patron que marcadorPenales/marcadorEntretiempo/tarjeta/cambios) \u2014\r\n// el VS siempre anuncia el mismo partido cargado en el marcador\r\n// principal, no se vuelve a elegir equipo aca.\r\nexport default function renderVs(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const src = VIDEO_BY_RENGLON[data.renglon] || VIDEO_BY_RENGLON.normal;\r\n  // \"renglonChanged\" (2026-09-23, mismo bug/fix que tarjeta.js -- ver\r\n  // comentario ahi): cambiar el renglon CON LA GRAFICA AL AIRE montaba un\r\n  // video nuevo sin destruir el anterior ni reproducirlo.\r\n  const renglonChanged = contentEl.dataset.renglon !== undefined && contentEl.dataset.renglon !== data.renglon;\r\n\r\n  if (!contentEl._gfxBuilt || renglonChanged) {\r\n    contentEl.dataset.renglon = data.renglon;\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    contentEl.innerHTML = `\r\n      <div class=\"av-target\"></div>\r\n      <div class=\"gfx-overlay\">\r\n        <img class=\"ov-vs-crestA\" data-adjust=\"localCrest\" />\r\n        <div class=\"ov-vs-teamA\"></div>\r\n        <div class=\"ov-vs-goalA\"></div>\r\n        <div class=\"ov-vs-status\"></div>\r\n        <div class=\"ov-vs-goalB\"></div>\r\n        <div class=\"ov-vs-teamB\"></div>\r\n        <img class=\"ov-vs-crestB\" data-adjust=\"awayCrest\" />\r\n        <img class=\"ov-vs-sponsor\" data-adjust=\"sponsor\" />\r\n      </div>\r\n    `;\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.av-target'), 'vs', src, undefined, data.renglon);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n\r\n  if (justTaken || renglonChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const scoreA = sb.scoreA;\r\n  const scoreB = sb.scoreB;\r\n  // CONTENIDO CENTRAL (2026-09-10, pedido explicito del usuario: \"lo que\r\n  // escriba ah\u00ED debe ser exactamente lo que se renderiza en el centro... no\r\n  // forzar un valor si est\u00E1 vac\u00EDo\") -- reemplaza al viejo mecanismo de\r\n  // \"Estado del encuentro\" preseleccionado + texto libre opcional que lo\r\n  // pisaba: ahora es 100% manual, sin ningun preset de respaldo.\r\n  const statusLabel = (data.statusTexto || '').trim();\r\n\r\n  setCrest(contentEl.querySelector('.ov-vs-crestA'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-vs-crestB'), sb.teamB);\r\n\r\n  applyTeamName(contentEl.querySelector('.ov-vs-teamA'), teamName(sb.teamA), readTextAdjust(data.textAdjust, 'nameA'));\r\n  applyTeamName(contentEl.querySelector('.ov-vs-teamB'), teamName(sb.teamB), readTextAdjust(data.textAdjust, 'nameB'));\r\n\r\n  // Gol de cada equipo en su propio recuadro amarillo lateral (independiente\r\n  // uno del otro, ninguno invade el bloque central del estado).\r\n  // \"MOSTRAR GOLES: SIN GOLES\" (2026-10-22, SOLO GLA): oculta unicamente\r\n  // los dos goles; nombres, escudos, estado central y sponsor sin cambios.\r\n  const hideGoals = getActiveThemeId() === 'gla' && data.mostrarGoles === 'sin';\r\n  const goalAEl = contentEl.querySelector('.ov-vs-goalA');\r\n  const showGoalA = !hideGoals && String(scoreA).trim() !== '';\r\n  goalAEl.style.display = showGoalA ? 'flex' : 'none';\r\n  if (showGoalA) {\r\n    applyFittedText(goalAEl, String(scoreA), {\r\n      maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 700,\r\n    }, readTextAdjust(data.textAdjust, 'goalA'));\r\n  }\r\n\r\n  const goalBEl = contentEl.querySelector('.ov-vs-goalB');\r\n  const showGoalB = !hideGoals && String(scoreB).trim() !== '';\r\n  goalBEl.style.display = showGoalB ? 'flex' : 'none';\r\n  if (showGoalB) {\r\n    applyFittedText(goalBEl, String(scoreB), {\r\n      maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 700,\r\n    }, readTextAdjust(data.textAdjust, 'goalB'));\r\n  }\r\n\r\n  // Bloque central: unicamente el estado del partido, nunca el resultado.\r\n  const statusEl = contentEl.querySelector('.ov-vs-status');\r\n  const showStatus = !!statusLabel;\r\n  statusEl.style.display = showStatus ? 'flex' : 'none';\r\n  if (showStatus) {\r\n    applyFittedText(statusEl, statusLabel, {\r\n      maxFont: STATUS_MAX_FONT, minFont: STATUS_MIN_FONT, maxWidth: STATUS_MAX_WIDTH, weight: 800, letterSpacing: 1,\r\n    }, readTextAdjust(data.textAdjust, 'statusTexto'));\r\n  }\r\n\r\n  // Sponsor\r\n  const sponsorEl = contentEl.querySelector('.ov-vs-sponsor');\r\n  const file = sponsorFile('vs_compact', data.sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/scoreboard.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { elapsedMs, formatClock, parseClockLimit } from '../../../shared/clock.js';\r\n\r\n// \"FIN DEL CONTADOR\" (2026-08-15, pedido explicito del usuario): default\r\n// 15:00 -- una vez alcanzado el reloj queda trabado ahi (ver\r\n// shared/clock.js, elapsedMs con limitMs). \"clockEndText\" es un campo de\r\n// texto libre editado desde master-control/js/scoreboard-clock-panel.js;\r\n// si esta vacio o mal formado se usa este default, nunca se rompe el reloj.\r\nconst DEFAULT_CLOCK_END_MS = 15 * 60 * 1000;\r\nimport { teamColorHex } from '../../../shared/team-colors.js';\r\nimport { crestFile, teamAbbr } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('scoreboard', 'principal');\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-team-a\">\r\n        <img class=\"ov-crest\" data-adjust=\"localCrest\" />\r\n        <span class=\"ov-dot\"></span>\r\n        <span class=\"ov-name\"></span>\r\n      </div>\r\n      <div class=\"ov-score\"><span class=\"ov-score-a\"></span><span class=\"ov-score-sep\" data-adjust=\"separator\"> - </span><span class=\"ov-score-b\"></span></div>\r\n      <div class=\"ov-team-b\">\r\n        <span class=\"ov-name\"></span>\r\n        <span class=\"ov-dot\"></span>\r\n        <img class=\"ov-crest\" data-adjust=\"awayCrest\" />\r\n      </div>\r\n      <div class=\"ov-period\"></div>\r\n      <div class=\"ov-clock\"></div>\r\n      <img class=\"ov-scoreboard-sponsor\" data-adjust=\"sponsor\" />\r\n    </div>\r\n  `;\r\n  // \"mountThemedAlphaVideo\" (2026-08-21, sistema multi-theme): para GLA\r\n  // usa SIEMPRE este VIDEO_SRC de ac\u00E1 arriba (nunca el manifest -- cero\r\n  // riesgo de regresi\u00F3n). Para cualquier otro theme sin este asset\r\n  // todav\u00EDa, devuelve null a prop\u00F3sito -- el \".gfx-overlay\" de arriba\r\n  // (escudos/nombres/goles/reloj/per\u00EDodo) sigue funcionando igual sobre\r\n  // transparencia, sin ning\u00FAn video de fondo. \"_gfxBuilt\" (no\r\n  // \"_alphaVideo\", que puede ser leg\u00EDtimamente null) es el marcador real\r\n  // de \"ya arm\u00E9 la estructura\" -- si fuera \"_alphaVideo\" un theme sin\r\n  // asset reconstruir\u00EDa el DOM en cada actualizaci\u00F3n, sin necesidad.\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'scoreboard', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction updateOverlay(el, data) {\r\n  const {\r\n    teamA, teamB, scoreA, scoreB, clock, period, sponsor,\r\n  } = data;\r\n\r\n  const ta = data.textAdjust;\r\n  const teamAEl = el.querySelector('.ov-team-a');\r\n  applyPlainTextAdjust(teamAEl.querySelector('.ov-name'), teamA ? teamAbbr(teamA) : 'LOCAL', readTextAdjust(ta, 'nameA'));\r\n  teamAEl.querySelector('.ov-dot').style.background = teamColorHex(data, 'A');\r\n  setCrest(teamAEl.querySelector('.ov-crest'), teamA);\r\n\r\n  const teamBEl = el.querySelector('.ov-team-b');\r\n  applyPlainTextAdjust(teamBEl.querySelector('.ov-name'), teamB ? teamAbbr(teamB) : 'VISITANTE', readTextAdjust(ta, 'nameB'));\r\n  teamBEl.querySelector('.ov-dot').style.background = teamColorHex(data, 'B');\r\n  setCrest(teamBEl.querySelector('.ov-crest'), teamB);\r\n\r\n  // \"scoreA\"/\"scoreB\" (2026-08-15, auditoria completa): antes un unico\r\n  // elemento pintaba \"scoreA - scoreB\" como un solo texto, sin poder mover\r\n  // un gol independiente del otro -- ahora son dos spans propios dentro\r\n  // del mismo contenedor centrado (\".ov-score\" conserva su transform de\r\n  // dise\u00F1o existente, translate se compone encima sin pisarlo).\r\n  applyPlainTextAdjust(el.querySelector('.ov-score-a'), String(scoreA ?? ''), readTextAdjust(ta, 'scoreA'));\r\n  applyPlainTextAdjust(el.querySelector('.ov-score-b'), String(scoreB ?? ''), readTextAdjust(ta, 'scoreB'));\r\n  applyPlainTextAdjust(el.querySelector('.ov-period'), period || '', readTextAdjust(ta, 'period'));\r\n  const clockLimitMs = parseClockLimit(data.clockEndText, DEFAULT_CLOCK_END_MS);\r\n  applyPlainTextAdjust(el.querySelector('.ov-clock'), formatClock(elapsedMs(clock, clockLimitMs)), readTextAdjust(ta, 'clock'));\r\n\r\n  const sponsorEl = el.querySelector('.ov-scoreboard-sponsor');\r\n  const file = sponsorFile('scoreboard', sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n}\r\n\r\nexport default function renderScoreboard(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  updateOverlay(contentEl, data);\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/marcadorTiempoAdicional.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { elapsedMs, formatClock } from '../../../shared/clock.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// Asset nuevo: imagen estatica (reemplazo del .mp4 con alfa compuesto que\r\n// usaba antes) \u2014 ver program/css/overlay.css para las coordenadas medidas\r\n// con lectura de alfa real sobre el PNG. Logica de datos sin cambios:\r\n// mismo campo \"addedMinutes\" y mismo reloj compartido (shared/clock.js).\r\nconst IMG_SRC = glaAssetPath('marcadorTiempoAdicional', 'principal');\r\n\r\n// Chip de \"+minutos\" mas angosto que en el asset anterior (34px reales);\r\n// mismo criterio de auto-ajuste que el resto de los textos variables.\r\nconst LABEL_MAX_FONT = 18;\r\nconst LABEL_MIN_FONT = 11;\r\nconst LABEL_MAX_WIDTH = 28;\r\n\r\nfunction buildStructure(el) {\r\n  const imgSrc = resolveImageSrc('marcadorTiempoAdicional', IMG_SRC);\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-added-label\"></div>\r\n      <div class=\"ov-added-clock\"></div>\r\n    </div>\r\n  `;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\n// \"+300ms\" (2026-09-10, pedido explicito del usuario): el numero de\r\n// MINUTOS AGREGADOS y el RELOJ deben aparecer 300ms mas tarde que antes,\r\n// sin tocar la animacion del asset (el fondo/PNG no pasa por aca, ver\r\n// program/js/main.js -- esto solo retrasa CUANDO este renderer pinta su\r\n// propio contenido dinamico). Antes se pintaba sincronico en cada llamada\r\n// (0ms de demora); ahora, solo en el momento del TAKE (\"justTaken\"), se\r\n// demora el primer pintado 300ms -- llamadas posteriores (tick del reloj\r\n// cada 500ms, ajustes en vivo) siguen pintando al instante, como siempre,\r\n// para no introducir un lag continuo en el reloj corriendo.\r\nconst CONTENT_REVEAL_DELAY_MS = 300;\r\n\r\nfunction paintContent(contentEl, data) {\r\n  const rawAdded = (data.addedMinutes || '').trim();\r\n  const labelText = rawAdded ? (rawAdded.startsWith('+') ? rawAdded : `+${rawAdded}`) : '';\r\n  applyFittedText(contentEl.querySelector('.ov-added-label'), labelText, withGlaSegoeRegular({\r\n    maxFont: LABEL_MAX_FONT, minFont: LABEL_MIN_FONT, maxWidth: LABEL_MAX_WIDTH, weight: 800,\r\n  }), readTextAdjust(data.textAdjust, 'addedMinutes'));\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-added-clock'), formatClock(elapsedMs(data.clock)), readTextAdjust(data.textAdjust, 'clock'));\r\n}\r\n\r\nexport default function renderMarcadorTiempoAdicional(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    clearTimeout(contentEl._contentRevealTimer);\r\n    // Vacia el contenido YA (evita un flash del numero/reloj de la vez\r\n    // anterior mientras se espera el delay) -- el pintado real llega en\r\n    // el timeout de abajo.\r\n    contentEl.querySelector('.ov-added-label').textContent = '';\r\n    contentEl.querySelector('.ov-added-clock').textContent = '';\r\n    contentEl._contentRevealTimer = setTimeout(() => paintContent(contentEl, data), CONTENT_REVEAL_DELAY_MS);\r\n    return;\r\n  }\r\n  paintContent(contentEl, data);\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/marcadorEntretiempo.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { teamColorHex } from '../../../shared/team-colors.js';\r\nimport { crestFile, teamAbbr } from '../../../shared/teams.js';\r\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('marcadorEntretiempo', 'principal');\r\n\r\nfunction buildStructure(el) {\r\n  // Argentina Streamers entrego este asset como imagen estatica (PNG), no\r\n  // como .mov -- \"mountThemedAlphaVideo\" solo resuelve \"asset.video\", asi\r\n  // que sin este fondo condicional el manifest quedaba sin efecto (el\r\n  // \".av-target\" se mostraba vacio). Mismo patron ya usado por\r\n  // marcadorTiempoAdicional.js/\".gfx-bg-image\" (ver overlay.css) -- GLA\r\n  // sigue exactamente igual, su propio VIDEO_SRC via mountThemedAlphaVideo.\r\n  const imgSrc = resolveImageSrc('marcadorEntretiempo');\r\n  // \"isGla\" (2026-09-04, pedido explicito del usuario: \"en el modulo\r\n  // ENTRETIEMPO no quiero ningun circulito/color auxiliar... sacar el\r\n  // elemento/logica de Argentina Streamers\", \"SOLO ARGENTINA STREAMERS,\r\n  // no tocar GLA\") -- se decide UNA vez, al construir la estructura (este\r\n  // \"buildStructure\" corre una sola vez por instancia, memoizado via\r\n  // \"_gfxBuilt\"). GLA sigue con el \".ov-dot\" de siempre, byte a byte;\r\n  // Argentina Streamers nunca lo agrega al DOM (no es un \"opacity:0\" --\r\n  // el elemento ni existe, pedido explicito: \"no ocultarlo, sacarlo\").\r\n  const isGla = getActiveThemeId() !== ARGENTINA_STREAMERS_THEME_ID;\r\n  const dotA = isGla ? '<span class=\"ov-dot\"></span>' : '';\r\n  const dotB = isGla ? '<span class=\"ov-dot\"></span>' : '';\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-ent-team-a\">\r\n        <img class=\"ov-crest\" data-adjust=\"localCrest\" />\r\n        ${dotA}\r\n        <span class=\"ov-name\"></span>\r\n      </div>\r\n      <div class=\"ov-ent-score\"><span class=\"ov-ent-score-a\"></span><span class=\"ov-ent-score-sep\"></span><span class=\"ov-ent-score-b\"></span></div>\r\n      <div class=\"ov-ent-team-b\">\r\n        <span class=\"ov-name\"></span>\r\n        ${dotB}\r\n        <img class=\"ov-crest\" data-adjust=\"awayCrest\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'marcadorEntretiempo', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Sin datos propios: reutiliza en vivo lo que ya esta cargado en el\r\n// Marcador principal (5to argumento, ver program/js/main.js) para no\r\n// duplicar la carga de escudo/color/equipo/goles en dos paneles distintos.\r\nexport default function renderMarcadorEntretiempo(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const ta = data.textAdjust;\r\n\r\n  const teamAEl = contentEl.querySelector('.ov-ent-team-a');\r\n  applyPlainTextAdjust(teamAEl.querySelector('.ov-name'), teamAbbr(sb.teamA), readTextAdjust(ta, 'nameA'));\r\n  // \"ov-dot\" (2026-09-04, pedido explicito del usuario): eliminado del DOM\r\n  // para Argentina Streamers (ver buildStructure) -- querySelector da null\r\n  // ahi, nunca se intenta pintar un color que ya no existe. GLA sigue\r\n  // pintandolo exactamente igual que siempre.\r\n  const dotA = teamAEl.querySelector('.ov-dot');\r\n  if (dotA) dotA.style.background = teamColorHex(sb, 'A');\r\n  setCrest(teamAEl.querySelector('.ov-crest'), sb.teamA);\r\n\r\n  const teamBEl = contentEl.querySelector('.ov-ent-team-b');\r\n  applyPlainTextAdjust(teamBEl.querySelector('.ov-name'), teamAbbr(sb.teamB), readTextAdjust(ta, 'nameB'));\r\n  const dotB = teamBEl.querySelector('.ov-dot');\r\n  if (dotB) dotB.style.background = teamColorHex(sb, 'B');\r\n  setCrest(teamBEl.querySelector('.ov-crest'), sb.teamB);\r\n\r\n  // \"scoreA\"/\"scoreB\" divididos en dos spans (2026-08-15, auditoria\r\n  // completa) -- mismo criterio que el Marcador principal, ver\r\n  // program/js/renderers/scoreboard.js.\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-ent-score-a'), String(sb.scoreA ?? 0), readTextAdjust(ta, 'scoreA'));\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-ent-score-b'), String(sb.scoreB ?? 0), readTextAdjust(ta, 'scoreB'));\r\n  // \"separador\" (2026-09-04, pedido explicito del usuario: \"GUI\u00D3N/\r\n  // SEPARADOR\" editable de posicion, independiente de los goles) -- MISMO\r\n  // texto \" - \" que ya tenia horneado buildStructure (preserva el espaciado\r\n  // visual actual tal cual, item 10 del pedido: \"empezar visualmente\r\n  // igual\"), ahora con su propio textAdjust en vez de quedar fijo en el\r\n  // HTML.\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-ent-score-sep'), ' - ', readTextAdjust(ta, 'separador'));\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/marcadorPenales.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getProgramFontFamily } from '../program-fonts.js';\r\nimport { crestFile, teamAbbr, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\nimport { applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('marcadorPenales', 'principal');\r\n\r\nconst TITLE_MAX_FONT = 22; // limite real: zocalo semi-transparente del asset mide 27px de alto (y900-927 nativos)\r\nconst TITLE_MIN_FONT = 14;\r\nconst TITLE_BOX_WIDTH = 356; // ancho real de .ov-pen-title\r\nconst TITLE_SAFETY_MARGIN = 6; // colchon para que nunca quede pegado al borde del zocalo\r\nconst TITLE_MAX_WIDTH = TITLE_BOX_WIDTH - TITLE_SAFETY_MARGIN;\r\n\r\nlet measureCtx = null;\r\nfunction measureWidth(text, fontSize) {\r\n  measureCtx.font = `800 ${fontSize}px ${getProgramFontFamily()}`;\r\n  // El CSS de .ov-pen-title tiene letter-spacing:0.5px \u2014 measureText no lo\r\n  // aplica solo, hay que igualarlo en el contexto o el ancho medido queda\r\n  // sistematicamente mas angosto que el texto realmente renderizado (con\r\n  // titulos largos de muchos caracteres la diferencia se nota bastante:\r\n  // ~0.5px * cantidad de caracteres).\r\n  measureCtx.letterSpacing = '0.5px';\r\n  return measureCtx.measureText(text).width;\r\n}\r\n\r\n// Reduccion moderada: primero calcula una estimacion proporcional (rapida),\r\n// despues la ajusta con medicion real a ese tama\u00F1o \u2014 escalar el ancho de\r\n// forma lineal es solo una aproximacion (el propio font hinting/kerning no\r\n// escala perfectamente lineal), asi que para titulos muy largos una sola\r\n// pasada proporcional podia quedar unos px mas ancha que el zocalo.\r\n// Async: hay que esperar a que Anton este realmente cargada antes de medir\r\n// \u2014 si se mide antes de que el navegador la tenga lista, measureText usa\r\n// metricas de una fuente de reemplazo (mas angosta) y el calculo queda mal,\r\n// aunque el texto renderizado despues si use Anton (mas ancha).\r\nasync function fitTitleFontSize(text) {\r\n  if (!measureCtx) measureCtx = document.createElement('canvas').getContext('2d');\r\n  await document.fonts.load(`800 ${TITLE_MAX_FONT}px ${getProgramFontFamily()}`);\r\n  const widthAtMax = measureWidth(text, TITLE_MAX_FONT);\r\n  if (widthAtMax <= TITLE_MAX_WIDTH) return TITLE_MAX_FONT;\r\n  let size = Math.floor(TITLE_MAX_FONT * (TITLE_MAX_WIDTH / widthAtMax));\r\n  size = Math.max(TITLE_MIN_FONT, size);\r\n  while (size > TITLE_MIN_FONT && measureWidth(text, size) > TITLE_MAX_WIDTH) {\r\n    size -= 1;\r\n  }\r\n  return size;\r\n}\r\n\r\n// \"adjustPrefix\" (2026-09-01, pedido explicito del usuario: \"control\r\n// total desde Master Control\" sobre cada circulo individual, sin mas\r\n// ajustes hardcodeados en CSS) -- cada circulo se marca con su propio\r\n// \"data-adjust\" (kickLocal1..5 / kickVisitante1..5, ver\r\n// shared/adjust-registry.js), independiente del grupo \"kicksLocal\"/\r\n// \"kicksVisitante\" que ya movia la fila entera. Solo tiene efecto real\r\n// cuando Argentina Streamers guarda un valor propio (los defaults son\r\n// 0/0/1, no-op) -- GLA (3 circulos, mismo \"kickDotsHtml\") nunca los toca.\r\nfunction kickDotsHtml(count, adjustPrefix) {\r\n  let html = '';\r\n  for (let i = 0; i < count; i++) {\r\n    html += `<span class=\"ov-pen-kick\" data-kick=\"${i}\" data-adjust=\"${adjustPrefix}${i + 1}\"></span>`;\r\n  }\r\n  return html;\r\n}\r\n\r\n// Orden de capas (de atras hacia adelante), preparado para cuando el\r\n// asset se reemplace por la version con los 6 casilleros transparentes:\r\n// 1. Fondo transparente del Program (stage).\r\n// 2. Indicadores dinamicos de los 6 penales (\".ov-pen-kicks-layer\") \u2014 van\r\n//    ANTES que \".av-target\" en el DOM a proposito, para quedar por\r\n//    DETRAS del video (los elementos position:absolute sin z-index\r\n//    apilan en orden de aparicion en el DOM).\r\n// 3. Asset de video (\".av-target\") por encima.\r\n// 4. Textos/escudos/nombres/resultado (\".gfx-overlay\") arriba de todo \u2014\r\n//    sin cambios de capa, sigue tal cual estaba.\r\n// Con el asset actual (circulos blancos opacos) los indicadores quedan\r\n// tapados y no se ven \u2014 es esperado, ver CHANGELOG. El dia que el asset\r\n// tenga los 6 casilleros recortados (transparentes), los colores van a\r\n// aparecer solos por detras sin tocar esta logica.\r\nfunction buildStructure(el, kicksPerTeam) {\r\n  el.innerHTML = `\r\n    <div class=\"gfx-overlay ov-pen-kicks-layer\">\r\n      <div class=\"ov-pen-kicks ov-pen-kicksA\" data-adjust=\"kicksLocal\">${kickDotsHtml(kicksPerTeam, 'kickLocal')}</div>\r\n      <div class=\"ov-pen-kicks ov-pen-kicksB\" data-adjust=\"kicksVisitante\">${kickDotsHtml(kicksPerTeam, 'kickVisitante')}</div>\r\n    </div>\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-pen-title\"></div>\r\n      <div class=\"ov-pen-nombre ov-pen-nombre-local\"></div>\r\n      <div class=\"ov-pen-nombre ov-pen-nombre-visitante\"></div>\r\n      <div class=\"ov-pen-team ov-pen-teamA\">\r\n        <img class=\"ov-pen-crest\" data-adjust=\"localCrest\" />\r\n        <div class=\"ov-pen-name\"></div>\r\n      </div>\r\n      <div class=\"ov-pen-score ov-pen-scoreA\"></div>\r\n      <div class=\"ov-pen-score-sep\" data-adjust=\"separator\">-</div>\r\n      <div class=\"ov-pen-score ov-pen-scoreB\"></div>\r\n      <div class=\"ov-pen-team ov-pen-teamB\">\r\n        <img class=\"ov-pen-crest\" data-adjust=\"awayCrest\" />\r\n        <div class=\"ov-pen-name\"></div>\r\n      </div>\r\n      <img class=\"ov-pen-sponsor\" data-adjust=\"sponsor\" />\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'marcadorPenales', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction paintKicks(containerEl, kicks) {\r\n  const dots = containerEl.querySelectorAll('.ov-pen-kick');\r\n  kicks.forEach((kick, i) => {\r\n    dots[i].className = `ov-pen-kick ov-pen-kick--${kick.status}`;\r\n  });\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Sin nombre/escudo propios (se leen en vivo de \"scoreboard\", 5to\r\n// argumento, ver program/js/main.js, igual que marcadorEntretiempo). Ya\r\n// no muestra color de camiseta (eso queda unicamente en el marcador\r\n// principal). El resultado (\".ov-pen-scoreA/B\") es el resultado REGLAMENTARIO\r\n// del partido (2026-09-27, pedido explicito del usuario: \"los penales son\r\n// visualmente independientes del resultado del partido... el score principal\r\n// debe seguir mostrando 2-2, no sumar los goles de la tanda\" -- reemplaza\r\n// una decision anterior, 2026-08-31, que hacia lo contrario) -- se lee en\r\n// vivo de \"sb.scoreA/scoreB\" (scoreboard), NUNCA de \"kicksA/kicksB\". Los\r\n// circulos (\".ov-pen-kicks\") siguen siendo la unica fuente de verdad del\r\n// desarrollo de la tanda en si, sin cambios.\r\nexport default function renderMarcadorPenales(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl, data.kicksA.length);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  const ta = data.textAdjust;\r\n  const titleAdjust = readTextAdjust(ta, 'titulo');\r\n  const titleEl = contentEl.querySelector('.ov-pen-title');\r\n  // \"suddenDeath\" (2026-08-15, pedido explicito del usuario): sin asset\r\n  // nuevo ni elemento aparte -- reusa el mismo zocalo/auto-ajuste de\r\n  // fuente del titulo (ver shared/modules.js), asi que si la tanda esta\r\n  // marcada como MUERTE SUBITA eso se ve en el mismo lugar donde siempre\r\n  // se mira el titulo, visible pero sin invadir el resto de la pieza.\r\n  const titleText = toBroadcastUpper(data.suddenDeath\r\n    ? `${(data.titulo || 'PENALES').trim()} \u2014 MUERTE S\u00DABITA`\r\n    : (data.titulo || ''));\r\n  titleEl.textContent = titleText;\r\n  titleEl.style.translate = `${titleAdjust.dx || 0}px ${titleAdjust.dy || 0}px`;\r\n  fitTitleFontSize(titleText).then((size) => {\r\n    if (titleEl.textContent !== titleText) return;\r\n    titleEl.style.fontSize = `${Math.max(1, size + (titleAdjust.dSize || 0))}px`;\r\n  });\r\n\r\n  // \"NOMBRE LOCAL/VISITANTE\" (2026-09-01, pedido explicito del usuario,\r\n  // franja azul arriba de cada fila de circulos) -- SOLO Argentina\r\n  // Streamers: GLA nunca escribe en \"nombreLocalMode/Manual\" (el campo\r\n  // existe en sus defaults pero nunca se toca, ver shared/modules.js),\r\n  // asi que dejarle texto vacio ahi es simplemente preservar \"sin\r\n  // contenido\" en un elemento que su propio asset/dise\u00F1o no contempla.\r\n  if (getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID) {\r\n    const nombreLocal = resolveVsDisplayName({ mode: data.nombreLocalMode, manualText: data.nombreLocalManual, teamId: sb.teamA, fallbackName: teamName(sb.teamA) });\r\n    const nombreVisitante = resolveVsDisplayName({ mode: data.nombreVisitanteMode, manualText: data.nombreVisitanteManual, teamId: sb.teamB, fallbackName: teamName(sb.teamB) });\r\n    applyPlainTextAdjust(contentEl.querySelector('.ov-pen-nombre-local'), nombreLocal, readTextAdjust(ta, 'nombreLocal'));\r\n    applyPlainTextAdjust(contentEl.querySelector('.ov-pen-nombre-visitante'), nombreVisitante, readTextAdjust(ta, 'nombreVisitante'));\r\n  }\r\n\r\n  const teamAEl = contentEl.querySelector('.ov-pen-teamA');\r\n  applyPlainTextAdjust(teamAEl.querySelector('.ov-pen-name'), teamAbbr(sb.teamA), readTextAdjust(ta, 'nameA'));\r\n  setCrest(teamAEl.querySelector('.ov-pen-crest'), sb.teamA);\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-pen-scoreA'), String(sb.scoreA ?? '0'), readTextAdjust(ta, 'scoreA'));\r\n  paintKicks(contentEl.querySelector('.ov-pen-kicksA'), data.kicksA);\r\n\r\n  const teamBEl = contentEl.querySelector('.ov-pen-teamB');\r\n  applyPlainTextAdjust(teamBEl.querySelector('.ov-pen-name'), teamAbbr(sb.teamB), readTextAdjust(ta, 'nameB'));\r\n  setCrest(teamBEl.querySelector('.ov-pen-crest'), sb.teamB);\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-pen-scoreB'), String(sb.scoreB ?? '0'), readTextAdjust(ta, 'scoreB'));\r\n  paintKicks(contentEl.querySelector('.ov-pen-kicksB'), data.kicksB);\r\n\r\n  // Sponsor: mismo fade-swap que Zocalo VS Compacto (ver\r\n  // program/js/renderers/vs.js) -- catalogo/logica reutilizados tal cual,\r\n  // sin inventar un mecanismo nuevo. Argentina Streamers no tiene sponsor\r\n  // dinamico en Penales (2026-10-09, pedido explicito del usuario): aunque\r\n  // \"data.sponsor\" conserve un valor viejo, nunca se pinta.\r\n  const sponsorEl = contentEl.querySelector('.ov-pen-sponsor');\r\n  const sponsorFileSrc = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID ? null : sponsorFile('vs_compact', data.sponsor);\r\n  if (sponsorFileSrc) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = sponsorFileSrc;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== sponsorFileSrc && currentSrc !== window.location.origin + sponsorFileSrc) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = sponsorFileSrc;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/marcadorZocalo.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { elapsedMs, formatClock, parseClockLimit } from '../../../shared/clock.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// \"FIN DEL CONTADOR\" (2026-08-15, pedido explicito del usuario): default\r\n// 06:00 para Marcador Zocalo -- misma mecanica que el Marcador principal\r\n// (ver program/js/renderers/scoreboard.js), limite editable desde\r\n// master-control/js/live-clock-display.js.\r\nconst DEFAULT_CLOCK_END_MS = 6 * 60 * 1000;\r\n\r\n// Reemplaza al ex Shootout: asset propio nuevo, imagen estatica (sin video,\r\n// sin canal alfa compuesto en canvas) \u2014 ver program/css/overlay.css para las\r\n// coordenadas medidas con lectura de alfa real sobre el PNG.\r\n// La query identifica el binario vigente del PNG. No aplica ningun efecto\r\n// visual: evita que una sesion larga de Program conserve decodificada una\r\n// revision anterior del mismo path, que tenia alfa parcial en la pieza.\r\nconst IMG_SRC = glaAssetPath('marcadorZocalo', 'principal');\r\n\r\n// Zona util real de \".ov-zocalo-titulo\" (323px) menos margen de seguridad,\r\n// mismo criterio que el titulo de Marcador de Penales (marcadorPenales.js).\r\nconst TITULO_MAX_FONT = 20;\r\nconst TITULO_MIN_FONT = 12;\r\nconst TITULO_MAX_WIDTH = 300;\r\n\r\nfunction buildStructure(el) {\r\n  const imgSrc = resolveImageSrc('marcadorZocalo', IMG_SRC);\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-zocalo-titulo\"></div>\r\n      <div class=\"ov-zocalo-clock\"></div>\r\n    </div>\r\n  `;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderMarcadorZocalo(contentEl, data) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  applyFittedText(contentEl.querySelector('.ov-zocalo-titulo'), data.titulo || '', withGlaSegoeRegular({\r\n    maxFont: TITULO_MAX_FONT, minFont: TITULO_MIN_FONT, maxWidth: TITULO_MAX_WIDTH, weight: 800,\r\n  }), readTextAdjust(data.textAdjust, 'titulo'));\r\n  const clockLimitMs = parseClockLimit(data.clockEndText, DEFAULT_CLOCK_END_MS);\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-zocalo-clock'), formatClock(elapsedMs(data.clock, clockLimitMs)), readTextAdjust(data.textAdjust, 'clock'));\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/sideTable.js","import { applyFittedText, readTextAdjust } from '../text-fit.js';\r\nimport { crestFile } from '../../../shared/teams.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// Cada bracket mide 124px + 12px de gap = 136px de paso vertical. Como\r\n// maximo se ven 6: tanda1 muestra 1-6 y tanda2 desplaza la misma tira tres\r\n// filas para mostrar 4-9. Los encuentros 4/5/6 nunca se recrean al cambiar\r\n// de tanda: son los mismos nodos que suben dentro del viewport recortado.\r\nconst ROW_STEP = 136;\r\nconst ROW_HEIGHT = 124;\r\nconst ROW_GAP = 12;\r\nconst VISIBLE_ROWS = 6;\r\nconst TANDA2_OFFSET_ROWS = 3;\r\n\r\nfunction statusTextFor(enc) {\r\n  switch (enc.status) {\r\n    case 'hora': return enc.hora || '';\r\n    case 'proximo': return 'PR\u00D3XIMO';\r\n    case 'final': return 'FINAL';\r\n    case 'entretiempo': return 'ENTRETIEMPO';\r\n    case 'en_juego': return 'EN JUEGO';\r\n    case 'suspendido': return 'SUSPENDIDO';\r\n    default: return '';\r\n  }\r\n}\r\n\r\n// PARTIDOS SIN AUTO-AJUSTE (2026-10-22, pedido explicito del usuario, SOLO\r\n// GLA): cada texto queda en su tama\u00F1o base fijo (maxFont) aunque no entre;\r\n// el ajuste manual de tama\u00F1o (dSize) y su RESET siguen funcionando igual\r\n// (applyFittedText suma dSize sobre ese tama\u00F1o base). Con minFont = maxFont\r\n// fitFontSize devuelve siempre maxFont: nunca achica ni mueve nada solo.\r\nfunction fixedSize(opts) {\r\n  return getActiveThemeId() === DEFAULT_THEME_ID ? { ...opts, minFont: opts.maxFont } : opts;\r\n}\r\n\r\nfunction ocultaGolesFor(enc) {\r\n  return enc.status === 'proximo' || enc.status === 'hora' || enc.status === 'vs' || !enc.status;\r\n}\r\n\r\nfunction cardMarkup(index) {\r\n  return `\r\n    <div class=\"ov-resultados-encuentro\" data-encuentro-index=\"${index}\">\r\n      <div class=\"ov-resultados-bg\"></div>\r\n      <div class=\"gfx-overlay\">\r\n        <div class=\"ov-resultados-cuerpo\">\r\n          <div class=\"ov-resultados-escudo local\">\r\n            <img class=\"ov-resultados-crest\" data-adjust=\"crestLocal\" alt=\"local\">\r\n            <span class=\"ov-resultados-tbd\" hidden>TBD</span>\r\n          </div>\r\n          <div class=\"ov-resultados-bloque-central\">\r\n            <div class=\"ov-resultados-gol-local\">\r\n              <span class=\"ov-resultados-gol-num\"></span><span class=\"ov-resultados-gol-pen\"></span>\r\n            </div>\r\n            <div class=\"ov-resultados-titulo-encuentro\"></div>\r\n            <div class=\"ov-resultados-estado\"></div>\r\n            <div class=\"ov-resultados-gol-visitante\">\r\n              <span class=\"ov-resultados-gol-num\"></span><span class=\"ov-resultados-gol-pen\"></span>\r\n            </div>\r\n            <div class=\"ov-resultados-titulo-encuentro-fullscreen\"></div>\r\n            <div class=\"ov-resultados-estado-fullscreen\"></div>\r\n          </div>\r\n          <div class=\"ov-resultados-escudo visitante\">\r\n            <img class=\"ov-resultados-crest\" data-adjust=\"crestVisitante\" alt=\"visitante\">\r\n            <span class=\"ov-resultados-tbd\" hidden>TBD</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  `;\r\n}\r\n\r\n// Penales opcionales (2026-08-16, pedido explicito del usuario:\r\n// \"6(3) - 6(1)\"): mismo criterio de translate/dSize que \"applyPlainTextAdjust\"\r\n// (ver program/js/text-fit.js) pero targeteando el span del NUMERO\r\n// principal (\".ov-resultados-gol-num\") -- el parentesis de penales\r\n// (\".ov-resultados-gol-pen\") usa un tama\u00F1o fijo mas chico por CSS, no es\r\n// parte del ajuste individual (mantiene el layout simple, sin agregar un\r\n// segundo control de tama\u00F1o solo para eso). \"translate\" se aplica al\r\n// CONTENEDOR completo (mismo elemento que antes tenia el texto directo),\r\n// asi que mover con las flechas mueve el bloque numero+parentesis junto.\r\nfunction paintGolConPenales(containerEl, score, penales, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  const numEl = containerEl.querySelector('.ov-resultados-gol-num');\r\n  const penEl = containerEl.querySelector('.ov-resultados-gol-pen');\r\n  const penText = String(penales ?? '').trim();\r\n  const hasPenales = penText.length > 0;\r\n  numEl.textContent = String(score ?? '0');\r\n  penEl.textContent = hasPenales ? `(${penText})` : '';\r\n  containerEl.classList.toggle('has-penales', hasPenales);\r\n  containerEl.style.translate = `${dx}px ${dy}px`;\r\n  if (dSize) {\r\n    if (!numEl.dataset.baseFontSize) {\r\n      numEl.dataset.baseFontSize = parseFloat(getComputedStyle(numEl).fontSize) || 0;\r\n    }\r\n    const base = parseFloat(numEl.dataset.baseFontSize) || 0;\r\n    numEl.style.fontSize = `${Math.max(1, base + dSize)}px`;\r\n  } else if (numEl.style.fontSize) {\r\n    numEl.style.removeProperty('font-size');\r\n  }\r\n}\r\n\r\n// \"TBD\" (2026-09-27, pedido explicito del usuario: \"si una posicion del\r\n// bracket todavia no tiene equipo definido, NO dejarla vacia, mostrar\r\n// TBD\"). Mismo criterio que ya usa este renderer para el escudo (oculto\r\n// sin equipo): el span hermano \".ov-resultados-tbd\" ocupa el mismo cuadro\r\n// de 108px, se muestra exactamente cuando el escudo no se muestra, sin\r\n// tocar tama\u00F1o/posicion del cuadro en si.\r\nfunction setCrest(escudoEl, teamId) {\r\n  const imgEl = escudoEl.querySelector('.ov-resultados-crest');\r\n  const tbdEl = escudoEl.querySelector('.ov-resultados-tbd');\r\n  const src = crestFile(teamId) || '';\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.hidden = false;\r\n    if (tbdEl) tbdEl.hidden = true;\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.hidden = true;\r\n    if (tbdEl) tbdEl.hidden = false;\r\n  }\r\n}\r\n\r\nfunction paintCard(cardEl, enc, ta) {\r\n  setCrest(cardEl.querySelector('.ov-resultados-escudo.local'), enc.teamA);\r\n  setCrest(cardEl.querySelector('.ov-resultados-escudo.visitante'), enc.teamB);\r\n\r\n  const statusText = statusTextFor(enc);\r\n  const ocultaGoles = ocultaGolesFor(enc);\r\n  const golLocal = cardEl.querySelector('.ov-resultados-gol-local');\r\n  const golVisitante = cardEl.querySelector('.ov-resultados-gol-visitante');\r\n  const estado = cardEl.querySelector('.ov-resultados-estado');\r\n  const estadoFullscreen = cardEl.querySelector('.ov-resultados-estado-fullscreen');\r\n  const bloqueCentral = cardEl.querySelector('.ov-resultados-bloque-central');\r\n  const tituloEnc = cardEl.querySelector('.ov-resultados-titulo-encuentro');\r\n  const tituloEncFullscreen = cardEl.querySelector('.ov-resultados-titulo-encuentro-fullscreen');\r\n\r\n  paintGolConPenales(golLocal, enc.scoreA ?? '0', enc.penalesA, readTextAdjust(ta, 'golLocal'));\r\n  paintGolConPenales(golVisitante, enc.scoreB ?? '0', enc.penalesB, readTextAdjust(ta, 'golVisitante'));\r\n\r\n  golLocal.style.display = ocultaGoles ? 'none' : 'flex';\r\n  golVisitante.style.display = ocultaGoles ? 'none' : 'flex';\r\n  estado.style.display = ocultaGoles ? 'none' : 'flex';\r\n  estadoFullscreen.style.display = ocultaGoles ? 'flex' : 'none';\r\n\r\n  // Titulo individual por encuentro (2026-08-15): solo ocupa espacio y\r\n  // desplaza el estado/hora hacia abajo (\".has-titulo\", ver overlay.css)\r\n  // cuando el encuentro tiene texto cargado -- vacio, el dise\u00F1o base no\r\n  // cambia un pixel.\r\n  const tituloText = (enc.titulo || '').trim();\r\n  const hasTitulo = tituloText.length > 0;\r\n  bloqueCentral.classList.toggle('has-titulo', hasTitulo);\r\n  tituloEnc.style.display = hasTitulo && !ocultaGoles ? 'flex' : 'none';\r\n  tituloEncFullscreen.style.display = hasTitulo && ocultaGoles ? 'flex' : 'none';\r\n\r\n  if (ocultaGoles) {\r\n    applyFittedText(estadoFullscreen, statusText, fixedSize({\r\n      maxFont: 42, minFont: 22, maxWidth: 150, weight: 900,\r\n    }), readTextAdjust(ta, 'estadoFullscreen'));\r\n    if (hasTitulo) {\r\n      applyFittedText(tituloEncFullscreen, tituloText, fixedSize({\r\n        maxFont: 20, minFont: 11, maxWidth: 150, weight: 900,\r\n      }), readTextAdjust(ta, 'tituloBracket'));\r\n    }\r\n  } else {\r\n    applyFittedText(estado, statusText, fixedSize({\r\n      maxFont: 24, minFont: 14, maxWidth: 83, weight: 900,\r\n    }), readTextAdjust(ta, 'estado'));\r\n    if (hasTitulo) {\r\n      applyFittedText(tituloEnc, tituloText, fixedSize({\r\n        maxFont: 13, minFont: 9, maxWidth: 72, weight: 900,\r\n      }), readTextAdjust(ta, 'tituloBracket'));\r\n    }\r\n  }\r\n}\r\n\r\n// SABADO (2026-10-23): hasta 10 partidos (manual 11:00 + P1..P9). Con 10,\r\n// la segunda tanda muestra 5-10 (desplaza 4 filas); con 7-9 todo sigue\r\n// igual que siempre (4 en adelante).\r\nfunction tanda2OffsetRows(count) {\r\n  return Math.max(TANDA2_OFFSET_ROWS, count - VISIBLE_ROWS);\r\n}\r\n\r\nexport default function renderSideTable(contentEl, data) {\r\n  const encuentros = Array.isArray(data.encuentros) ? data.encuentros.slice(0, 10) : [];\r\n  const posicion = data.posicion || 'placaL';\r\n  const titulo = data.titulo || 'RESULTADOS';\r\n\r\n  if (encuentros.length === 0) {\r\n    contentEl.innerHTML = '';\r\n    delete contentEl.dataset.cardCount;\r\n    return;\r\n  }\r\n\r\n  const count = encuentros.length;\r\n  const paginado = count > VISIBLE_ROWS;\r\n  const tanda = paginado && data.tanda === 'tanda2' ? 'tanda2' : 'tanda1';\r\n  const needsRebuild = !contentEl.querySelector('.ov-resultados-wrapper')\r\n    || Number(contentEl.dataset.cardCount) !== count;\r\n\r\n  // Solo cambia la estructura si cambia la cantidad. Tanda, titulo,\r\n  // posicion, equipos, goles y estado se actualizan sobre los mismos nodos,\r\n  // evitando cortes durante un UPDATE en vivo.\r\n  if (needsRebuild) {\r\n    const cardsHtml = encuentros.map((_, index) => cardMarkup(index)).join('');\r\n    contentEl.innerHTML = `\r\n      <div class=\"ov-resultados-wrapper\">\r\n        <div class=\"ov-resultados-titulo-row\">\r\n          <div class=\"ov-resultados-bg\"></div>\r\n          <div class=\"gfx-overlay\">\r\n            <div class=\"ov-resultados-titulo-wrap\">\r\n              <div class=\"ov-resultados-titulo\"></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"ov-resultados-viewport\">\r\n          <div class=\"ov-resultados-track\">${cardsHtml}</div>\r\n        </div>\r\n      </div>\r\n    `;\r\n    contentEl.dataset.cardCount = String(count);\r\n  }\r\n\r\n  const wrapper = contentEl.querySelector('.ov-resultados-wrapper');\r\n  let posClass = 'placaL';\r\n  if (posicion === 'fullscreenDerecha') posClass = 'fs-derecha';\r\n  else if (posicion === 'fullscreenIzquierda') posClass = 'fs-izquierda';\r\n  wrapper.className = `ov-resultados-wrapper ov-resultados-wrapper--${posClass}`;\r\n\r\n  // Titulo general: Segoe UI Regular del Marcador en GLA (2026-10-22).\r\n  applyFittedText(contentEl.querySelector('.ov-resultados-titulo'), titulo, fixedSize(withGlaSegoeRegular({\r\n    maxFont: 30, minFont: 16, maxWidth: 350, weight: 'bold',\r\n  })), readTextAdjust(data.textAdjust, 'titulo'));\r\n\r\n  contentEl.querySelectorAll('.ov-resultados-encuentro').forEach((cardEl, index) => {\r\n    paintCard(cardEl, encuentros[index], data.textAdjust);\r\n  });\r\n\r\n  // No fabrica filas vacias: en segunda tanda, 7/8/9 encuentros muestran\r\n  // exactamente 4/5/6 brackets.\r\n  const visibleRows = tanda === 'tanda2'\r\n    ? Math.min(Math.max(count - tanda2OffsetRows(count), 0), VISIBLE_ROWS)\r\n    : Math.min(count, VISIBLE_ROWS);\r\n  const viewport = contentEl.querySelector('.ov-resultados-viewport');\r\n  viewport.style.height = `${visibleRows * ROW_HEIGHT + Math.max(visibleRows - 1, 0) * ROW_GAP}px`;\r\n\r\n  // Al cambiar tanda, el mismo track anima: 1/2/3 salen por arriba,\r\n  // 4/5/6 suben y 7/8/9 entran desde abajo. Volver invierte el movimiento.\r\n  const track = contentEl.querySelector('.ov-resultados-track');\r\n  const offsetPx = tanda === 'tanda2' ? tanda2OffsetRows(count) * ROW_STEP : 0;\r\n  track.style.transform = `translateY(-${offsetPx}px)`;\r\n\r\n  // Fondo compartido (2026-08-21, sistema multi-theme): GLA nunca toca este\r\n  // bloque (el background-image fijo por CSS sigue mandando, cero riesgo);\r\n  // para cualquier otro theme se resuelve del manifest -- sin asset\r\n  // todavia, se deja transparente y el contenido dinamico (escudos/goles/\r\n  // estado) sigue pintandose igual sobre el \".gfx-overlay\".\r\n  if (getActiveThemeId() !== DEFAULT_THEME_ID) {\r\n    const bgSrc = resolveImageSrc('sideTable', null);\r\n    contentEl.querySelectorAll('.ov-resultados-bg').forEach((bgEl) => {\r\n      bgEl.style.backgroundImage = bgSrc ? `url('${bgSrc}')` : 'none';\r\n    });\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/shortSimple.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { GLA_SEGOE_BOLD_FAMILY, withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('shortSimple', 'principal');\r\n\r\nconst TEXT_MAX_FONT = 40;\r\nconst TEXT_MIN_FONT = 18;\r\nconst TEXT_BOX_WIDTH = 690;\r\nconst TEXT_SAFETY_MARGIN = 16;\r\nconst TEXT_MAX_WIDTH = TEXT_BOX_WIDTH - TEXT_SAFETY_MARGIN;\r\n\r\n// ARGENTINA STREAMERS (2026-09-04, pedido explicito del usuario: \"sobra\r\n// muchisimo espacio horizontal... quiero que el texto pueda usar mas\r\n// ancho\"). Medido pixel a pixel sobre zocalo-corto-simple-alpha.mp4 (frame\r\n// asentado, deteccion de la barra navy por canal): a la altura del centro\r\n// del texto (y=927 en adelante hasta y=952, pared inferior del box) la\r\n// barra mide x=442-1467 (1025px) -- mucho mas ancha que el box de GLA\r\n// (690px, medido sobre OTRO asset). Igual criterio de margen de seguridad\r\n// que el resto del archivo (16px). GLA no se toca: sigue con\r\n// TEXT_BOX_WIDTH/TEXT_MAX_WIDTH de arriba.\r\nconst TEXT_BOX_WIDTH_AS = 985;\r\nconst TEXT_MAX_WIDTH_AS = TEXT_BOX_WIDTH_AS - TEXT_SAFETY_MARGIN;\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-short-simple-text\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'shortSimple', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderShortSimple(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  const textEl = contentEl.querySelector('.ov-short-simple-text');\r\n  const sb = allData && allData.scoreboard;\r\n  const newText = resolveTeamTokens(data.text || '', sb);\r\n  const oldText = contentEl._prevText;\r\n  const isArgentinaStreamers = getActiveThemeId() !== DEFAULT_THEME_ID;\r\n  const maxWidth = isArgentinaStreamers ? TEXT_MAX_WIDTH_AS : TEXT_MAX_WIDTH;\r\n  // \"family\" (2026-09-24, pedido explicito: \"Segoe UI Bold\", SOLO GLA) --\r\n  // ver el mismo criterio en program/js/renderers/longSimple.js.\r\n  const family = isArgentinaStreamers ? undefined : GLA_SEGOE_BOLD_FAMILY;\r\n\r\n  updateFittedTextWithTransition(textEl, newText, oldText, withGlaSegoeRegular({\r\n    maxFont: TEXT_MAX_FONT, minFont: TEXT_MIN_FONT, maxWidth, weight: 800, family,\r\n  }), readTextAdjust(data.textAdjust, 'text'), !justTaken);\r\n\r\n  contentEl._prevText = newText;\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/longDouble.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('longDouble', 'principal');\r\n\r\nconst LINE1_MAX_FONT = 40;\r\n// MIN_FONT bajado de 22 a 18 (2026-09-10, pedido explicito del usuario:\r\n// \"escribo mucho y se me hace dos renglones, no me gusta\") -- el bbox real\r\n// del asset (ver overlay.css, \"Zocalo largo doble: bbox real x568-1408\")\r\n// deja poco margen real para ensanchar la caja sin que el texto se salga\r\n// del zocalo impreso, asi que la otra mitad del arreglo es dejar que un\r\n// titulo muy largo se achique mas antes de necesitar wrap.\r\nconst LINE1_MIN_FONT = 18;\r\nconst LINE2_MAX_FONT = 26;\r\nconst LINE2_MIN_FONT = 16;\r\n// LINE_BOX_WIDTH ensanchado de 760 a 790 (2026-09-10, mismo pedido): el\r\n// bbox real del asset termina en x1408 y la caja arranca en x610, asi que\r\n// 790 (610-1400) deja ~8px de margen real contra el borde del zocalo --\r\n// el maximo razonable sin arriesgar que el texto pise el borde impreso.\r\nconst LINE_BOX_WIDTH = 790;\r\nconst LINE_SAFETY_MARGIN = 20;\r\nconst LINE_MAX_WIDTH = LINE_BOX_WIDTH - LINE_SAFETY_MARGIN;\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-long-double-line1\"></div>\r\n      <div class=\"ov-long-double-line2\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'longDouble', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderLongDouble(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  const adjust = data.textAdjust;\r\n  const line1El = contentEl.querySelector('.ov-long-double-line1');\r\n  const line2El = contentEl.querySelector('.ov-long-double-line2');\r\n  const sb = allData && allData.scoreboard;\r\n\r\n  const newL1 = resolveTeamTokens(data.line1 || '', sb);\r\n  const newL2 = resolveTeamTokens(data.line2 || '', sb);\r\n  const oldL1 = contentEl._prevLine1;\r\n  const oldL2 = contentEl._prevLine2;\r\n\r\n  updateFittedTextWithTransition(line1El, newL1, oldL1, withGlaSegoeRegular({\r\n    maxFont: LINE1_MAX_FONT, minFont: LINE1_MIN_FONT, maxWidth: LINE_MAX_WIDTH, weight: 800,\r\n  }), readTextAdjust(adjust, 'line1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(line2El, newL2, oldL2, withGlaSegoeRegular({\r\n    maxFont: LINE2_MAX_FONT, minFont: LINE2_MIN_FONT, maxWidth: LINE_MAX_WIDTH, weight: 600,\r\n  }), readTextAdjust(adjust, 'line2'), !justTaken);\r\n\r\n  contentEl._prevLine1 = newL1;\r\n  contentEl._prevLine2 = newL2;\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/shortDouble.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { GLA_SEGOE_BOLD_FAMILY, withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('shortDouble', 'principal');\r\n\r\nconst NAME_MAX_FONT = 41;\r\nconst NAME_MIN_FONT = 24;\r\nconst ROLE_MAX_FONT = 22;\r\nconst ROLE_MIN_FONT = 14;\r\nconst BOX_WIDTH = 500;\r\nconst SAFETY_MARGIN = 20;\r\nconst MAX_WIDTH = BOX_WIDTH - SAFETY_MARGIN;\r\n\r\nfunction pairMarkup() {\r\n  return `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-short-double-name\"></div>\r\n      <div class=\"ov-short-double-role\"></div>\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction buildSingleStructure(el) {\r\n  el.innerHTML = pairMarkup();\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'shortDouble', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nfunction buildDoubleStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"ov-short-double-pair ov-short-double-pair-1\">${pairMarkup()}</div>\r\n    <div class=\"ov-short-double-pair ov-short-double-pair-2\">${pairMarkup()}</div>\r\n  `;\r\n  const video1 = mountThemedAlphaVideo(el.querySelector('.ov-short-double-pair-1 .av-target'), 'shortDouble', VIDEO_SRC);\r\n  const video2 = mountThemedAlphaVideo(el.querySelector('.ov-short-double-pair-2 .av-target'), 'shortDouble', VIDEO_SRC);\r\n  // Wrapper \"combinado\" (2026-08-21, sistema multi-theme): cualquiera de\r\n  // los dos puede ser null si el theme activo todav\u00EDa no tiene este\r\n  // asset -- cada m\u00E9todo solo llama a los handles que de verdad existen.\r\n  el._alphaVideo = (video1 || video2) ? {\r\n    playFromStart() { video1?.playFromStart(); video2?.playFromStart(); },\r\n    destroy() { video1?.destroy(); video2?.destroy(); },\r\n  } : null;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\n// \"family\" (2026-09-24, pedido explicito: \"Segoe UI Bold\", SOLO GLA) --\r\n// mismo criterio que longSimple.js/shortSimple.js.\r\nfunction fillPair(root, name, role, textAdjust, nameKey, roleKey, isExplicitUpdate, prevStore, sb) {\r\n  const nameEl = root.querySelector('.ov-short-double-name');\r\n  const roleEl = root.querySelector('.ov-short-double-role');\r\n  const newName = resolveTeamTokens(name || '', sb);\r\n  const newRole = resolveTeamTokens(role || '', sb);\r\n  const oldName = prevStore[nameKey];\r\n  const oldRole = prevStore[roleKey];\r\n  const family = getActiveThemeId() === DEFAULT_THEME_ID ? GLA_SEGOE_BOLD_FAMILY : undefined;\r\n\r\n  updateFittedTextWithTransition(nameEl, newName, oldName, withGlaSegoeRegular({\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: MAX_WIDTH, weight: 800, family,\r\n  }), readTextAdjust(textAdjust, nameKey), isExplicitUpdate);\r\n\r\n  updateFittedTextWithTransition(roleEl, newRole, oldRole, withGlaSegoeRegular({\r\n    maxFont: ROLE_MAX_FONT, minFont: ROLE_MIN_FONT, maxWidth: MAX_WIDTH, weight: 600, letterSpacing: 1, family,\r\n  }), readTextAdjust(textAdjust, roleKey), isExplicitUpdate);\r\n\r\n  prevStore[nameKey] = newName;\r\n  prevStore[roleKey] = newRole;\r\n}\r\n\r\nexport default function renderShortDouble(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const mode = data.airMode === 'double' ? 'double' : 'single';\r\n  const sb = allData && allData.scoreboard;\r\n  // \"modeChanged\" (2026-09-23, mismo bug/fix que tarjeta.js/vs.js -- ver\r\n  // comentario en tarjeta.js): pasar de individual a doble (o viceversa)\r\n  // CON LA GRAFICA AL AIRE armaba la estructura nueva sin destruir la\r\n  // vieja (huerfana) ni reproducir el/los video(s) nuevos.\r\n  const modeChanged = contentEl.dataset.airMode !== undefined && contentEl.dataset.airMode !== mode;\r\n\r\n  if (!contentEl._gfxBuilt || modeChanged) {\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    if (mode === 'double') buildDoubleStructure(contentEl); else buildSingleStructure(contentEl);\r\n    contentEl.dataset.airMode = mode;\r\n  }\r\n  if (justTaken || modeChanged) contentEl._alphaVideo?.playFromStart();\r\n\r\n  if (!contentEl._prevStore) contentEl._prevStore = {};\r\n  const isExplicitUpdate = !justTaken;\r\n\r\n  const adjust = data.textAdjust;\r\n  if (mode === 'single') {\r\n    // \"double1\" es LA fuente para el modo individual (2026-09-10, pedido\r\n    // explicito del usuario: \"que el z\u00F3calo doble 1 sea el z\u00F3calo\r\n    // individual\") -- ya no existe un \"data.name/role\" aparte, mandar un\r\n    // solo zocalo y mandar dos siempre leen del mismo lugar.\r\n    const double1 = data.double1 || {};\r\n    fillPair(contentEl, double1.name, double1.role, adjust, 'double1.name', 'double1.role', isExplicitUpdate, contentEl._prevStore, sb);\r\n  } else {\r\n    const double1 = data.double1 || {};\r\n    const double2 = data.double2 || {};\r\n    fillPair(contentEl.querySelector('.ov-short-double-pair-1'), double1.name, double1.role, adjust, 'double1.name', 'double1.role', isExplicitUpdate, contentEl._prevStore, sb);\r\n    fillPair(contentEl.querySelector('.ov-short-double-pair-2'), double2.name, double2.role, adjust, 'double2.name', 'double2.role', isExplicitUpdate, contentEl._prevStore, sb);\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/varCheck.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, readTextAdjust } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('varCheck', 'principal');\r\nconst MOTIVO_IMAGE_SRC = glaAssetPath('varCheck', 'motivo');\r\n\r\nexport default function renderVarCheck(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    const motivoImageSrc = resolveImageSrc('varCheck', MOTIVO_IMAGE_SRC);\r\n    contentEl.innerHTML = `\r\n      <div class=\"ov-var-group1\">\r\n        <div class=\"av-target\"></div>\r\n        <div class=\"gfx-overlay\">\r\n          <img class=\"ov-var-replay-sponsor\" data-adjust=\"sponsor\" />\r\n        </div>\r\n      </div>\r\n      <div class=\"ov-var-motivo-group\">\r\n        <div class=\"ov-var-motivo-container\">\r\n          <div class=\"ov-var-motivo-av-target av-target\"></div>\r\n          ${motivoImageSrc ? `<img class=\"ov-var-motivo-bg\" src=\"${motivoImageSrc}\" />` : ''}\r\n          <div class=\"gfx-overlay\">\r\n            <div class=\"ov-short-simple-text\"></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    `;\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.ov-var-group1 .av-target'), 'varCheck', VIDEO_SRC);\r\n    contentEl._motivoAlphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.ov-var-motivo-av-target'), 'varCheckMotivo', null);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n\r\n  // Grupo 1: VAR + SPONSOR\r\n  const group1 = contentEl.querySelector('.ov-var-group1');\r\n  if (group1) {\r\n    const x1 = data.varGroupOffsetX || 0;\r\n    const y1 = data.varGroupOffsetY || 0;\r\n    const s1 = data.varGroupScale !== undefined ? data.varGroupScale : 1;\r\n    group1.style.transform = `translate(${x1}px, ${y1}px) scale(${s1})`;\r\n  }\r\n\r\n  // Grupo 2: MOTIVO\r\n  const motivoGroup = contentEl.querySelector('.ov-var-motivo-group');\r\n  if (motivoGroup) {\r\n    const x2 = data.motivoOffsetX || 0;\r\n    const y2 = data.motivoOffsetY || 0;\r\n    const s2 = data.motivoScale !== undefined ? data.motivoScale : 1;\r\n    motivoGroup.style.transform = `translate(${x2}px, ${y2}px) scale(${s2})`;\r\n  }\r\n\r\n  const motivoEl = contentEl.querySelector('.ov-var-motivo-container');\r\n  const textEl = motivoEl.querySelector('.ov-short-simple-text');\r\n\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n    contentEl._hasMotivoPlayed = false;\r\n  }\r\n\r\n  const sponsorEl = contentEl.querySelector('.ov-var-replay-sponsor');\r\n  const file = sponsorFile('var', data.sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n\r\n  // Motivo text & asset timing logic\r\n  const motivoText = (data.motivo || '').trim();\r\n  const themeId = getActiveThemeId();\r\n  const isArgentinaStreamers = themeId === 'argentinaStreamers';\r\n\r\n  if (motivoText) {\r\n    const maxWidth = isArgentinaStreamers ? (500 - 40) : (368 - 24);\r\n    applyFittedText(textEl, motivoText, withGlaSegoeRegular({\r\n      maxFont: 40, minFont: 14, maxWidth, weight: 800,\r\n    }), readTextAdjust(data.textAdjust, 'motivo'));\r\n\r\n    if (!motivoEl.classList.contains('is-visible')) {\r\n      motivoEl.classList.add('is-visible');\r\n    }\r\n\r\n    if (justTaken || !contentEl._hasMotivoPlayed || contentEl._prevMotivoText !== motivoText) {\r\n      contentEl._motivoAlphaVideo?.playFromStart();\r\n      contentEl._hasMotivoPlayed = true;\r\n\r\n      if (contentEl._motivoTimer) clearTimeout(contentEl._motivoTimer);\r\n\r\n      const delayMs = isArgentinaStreamers ? 1900 : 0;\r\n      if (delayMs > 0) {\r\n        textEl.classList.remove('motivo-content-in');\r\n        contentEl._motivoTimer = setTimeout(() => {\r\n          textEl.classList.add('motivo-content-in');\r\n        }, delayMs);\r\n      } else {\r\n        textEl.classList.add('motivo-content-in');\r\n      }\r\n    }\r\n  } else {\r\n    if (contentEl._motivoTimer) clearTimeout(contentEl._motivoTimer);\r\n    textEl.classList.remove('motivo-content-in');\r\n    motivoEl.classList.remove('is-visible');\r\n    contentEl._hasMotivoPlayed = false;\r\n  }\r\n\r\n  contentEl._prevMotivoText = motivoText;\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/replay.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('replay', 'principal');\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-var-replay-sponsor\" data-adjust=\"sponsor\" />\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'replay', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderReplay(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n  \r\n  const sponsorEl = contentEl.querySelector('.ov-var-replay-sponsor');\r\n  const file = sponsorFile('var', data.sponsor);\r\n  if (file) {\r\n    const currentSrc = sponsorEl.getAttribute('src');\r\n    if (!currentSrc) {\r\n      sponsorEl.src = file;\r\n      void sponsorEl.offsetWidth;\r\n      sponsorEl.classList.add('is-visible');\r\n    } else if (currentSrc !== file && currentSrc !== window.location.origin + file) {\r\n      sponsorEl.classList.remove('is-visible');\r\n      setTimeout(() => {\r\n        sponsorEl.src = file;\r\n        void sponsorEl.offsetWidth;\r\n        sponsorEl.classList.add('is-visible');\r\n      }, 320);\r\n    } else {\r\n      sponsorEl.classList.add('is-visible');\r\n    }\r\n  } else {\r\n    sponsorEl.classList.remove('is-visible');\r\n    setTimeout(() => {\r\n      if (!sponsorEl.classList.contains('is-visible')) {\r\n        sponsorEl.removeAttribute('src');\r\n      }\r\n    }, 320);\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/bug.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('bug', 'principal');\r\n\r\nfunction pad2(n) {\r\n  return String(n).padStart(2, '0');\r\n}\r\n\r\n// HH:MM en hora local del sistema que corre el server/navegador \u2014 sin\r\n// segundos, a pedido. No depende de ningun campo del modulo (no hay\r\n// \"data\" que leer aca): se recalcula sola cada tick.\r\nfunction currentClock() {\r\n  const now = new Date();\r\n  return `${pad2(now.getHours())}:${pad2(now.getMinutes())}`;\r\n}\r\n\r\n// El video ya trae horneados el escudo GLA, el logo LocalStrike y el\r\n// indicador \"VIVO\" (ver overlay.css, \".ov-mosca-vivo\" queda oculto porque\r\n// duplicaria ese \"VIVO\"). La unica pieza dinamica es la hora del sistema,\r\n// que ocupa la franja dorada donde antes iba el texto editable de\r\n// sponsor (campo eliminado, ver shared/modules.js) \u2014 se arranca UNA sola\r\n// vez por montaje (no en cada render) para no acumular intervalos.\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-mosca-vivo\"><span class=\"ov-mosca-dot\"></span>VIVO</div>\r\n      <div class=\"ov-mosca-clock\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'bug', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n\r\n  // \"clock\" (2026-08-15, auditoria completa): el ajuste vivo se guarda en\r\n  // el propio nodo (el._clockAdjust) porque este tick corre en un\r\n  // setInterval propio, fuera del ciclo normal de render -- renderBug lo\r\n  // actualiza en cada llamada (ver mas abajo) para que un cambio de\r\n  // posicion/tama\u00F1o hecho en caliente se vea en el siguiente tick, sin\r\n  // esperar a que el modulo se saque y se vuelva a tomar al aire.\r\n  const clockEl = el.querySelector('.ov-mosca-clock');\r\n  const tick = () => { applyPlainTextAdjust(clockEl, currentClock(), el._clockAdjust || {}); };\r\n  tick();\r\n  el._clockInterval = setInterval(tick, 1000);\r\n}\r\n\r\nexport default function renderBug(contentEl, data, justTaken) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  contentEl._clockAdjust = readTextAdjust(data.textAdjust, 'clock');\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-mosca-clock'), currentClock(), contentEl._clockAdjust);\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/vsPrepartido.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('vsPrepartido', 'principal');\r\nconst DEFAULT_TITULO = 'PR\u00D3XIMO PARTIDO';\r\n\r\nconst NAME_MAX_FONT = 42;\r\nconst NAME_MIN_FONT = 20;\r\nconst NAME_SAFETY_MARGIN = 24;\r\nconst NAME_MAX_WIDTH_A = 362 - NAME_SAFETY_MARGIN;\r\nconst NAME_MAX_WIDTH_B = 366 - NAME_SAFETY_MARGIN;\r\n\r\nconst TITULO_MAX_FONT = 38;\r\nconst TITULO_MIN_FONT = 20;\r\nconst TITULO_MAX_WIDTH = 905 - 40;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-vsfull-titulo\"></div>\r\n      <div class=\"ov-vsfull-teamA\"><img class=\"ov-vsfull-crest\" data-adjust=\"localCrest\" /></div>\r\n      <div class=\"ov-vsfull-teamB\"><img class=\"ov-vsfull-crest\" data-adjust=\"awayCrest\" /></div>\r\n      <div class=\"ov-vsfull-separator\"></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameA\"></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameB\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'vsPrepartido', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderVsPrepartido(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamA .ov-vsfull-crest'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamB .ov-vsfull-crest'), sb.teamB);\r\n\r\n  const nameA = resolveVsDisplayName({ mode: data.nameAMode, manualText: data.nameAManual, teamId: sb.teamA, fallbackName: teamName(sb.teamA) });\r\n  const nameB = resolveVsDisplayName({ mode: data.nameBMode, manualText: data.nameBManual, teamId: sb.teamB, fallbackName: teamName(sb.teamB) });\r\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\r\n  // usuario: fade en vez de corte duro en ACTUALIZAR -- \"vsPrepartido\" no\r\n  // es un modulo LIVE, su contenido solo cambia via TAKE/ACTUALIZAR).\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameA'), nameA, contentEl._prevNameA, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_A, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameA'), !justTaken);\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameB'), nameB, contentEl._prevNameB, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_B, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameB'), !justTaken);\r\n  contentEl._prevNameA = nameA;\r\n  contentEl._prevNameB = nameB;\r\n\r\n  const tituloEl = contentEl.querySelector('.ov-vsfull-titulo');\r\n  const newTitulo = (data.titulo || '').trim() || DEFAULT_TITULO;\r\n  const oldTitulo = contentEl._prevTitulo;\r\n\r\n  updateFittedTextWithTransition(tituloEl, newTitulo, oldTitulo, {\r\n    maxFont: TITULO_MAX_FONT, minFont: TITULO_MIN_FONT, maxWidth: TITULO_MAX_WIDTH, weight: 800, letterSpacing: 1,\r\n  }, readTextAdjust(data.textAdjust, 'titulo'), !justTaken);\r\n\r\n  contentEl._prevTitulo = newTitulo;\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/formacionEquipos.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { versionedAssetUrl } from '../asset-versions.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { DEFAULT_THEME_ID, getThemeAsset } from '../../../shared/themes.js';\r\nimport { normalizePlayers } from '../../../shared/player-lists.js';\r\nimport { teamColorHex } from '../../../shared/team-colors.js';\r\nimport { applyElementAdjust, applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('formacionEquipos', 'principal');\r\nconst SHIRTS_BASE_SRC = glaAssetPath('formacionEquipos', 'camisetas');\r\nconst SHIRTS_WHITE_SRC = glaAssetPath('formacionEquipos', 'camisetasBlancas');\r\n// GLA conserva su asset original (6 camisetas, sin arquero dibujado) tal\r\n// cual estaba. Argentina Streamers pasa a 11 (2026-09-03, pedido explicito\r\n// del usuario: \"una formacion de futbol tiene que permitir 11 titulares\")\r\n// porque \"formacion-arg/oxen/peru.png\" YA tienen las 11 posiciones dibujadas\r\n// -- medidas pixel a pixel (ver overlay.css), el sistema solo las tapaba con\r\n// un clip-path. No hay variante por asset/equipo: los 3 PNG miden igual\r\n// (centros de camiseta iguales +/-3px en los 3, ver informe de medicion).\r\nconst STARTER_LIMIT_GLA = 6;\r\nconst STARTER_LIMIT_ARGENTINA = 11;\r\nconst ARGENTINA_CONTENT_DELAY = '700ms';\r\n\r\nfunction getStarterLimit() {\r\n  return getActiveThemeId() === DEFAULT_THEME_ID ? STARTER_LIMIT_GLA : STARTER_LIMIT_ARGENTINA;\r\n}\r\n\r\nfunction resolveFormationShirts(teamId) {\r\n  const themeId = getActiveThemeId();\r\n  if (themeId === DEFAULT_THEME_ID) return versionedAssetUrl(SHIRTS_BASE_SRC);\r\n  return versionedAssetUrl(getThemeAsset(themeId, 'formacionEquipos')?.formationAssetsByTeam?.[teamId] || null);\r\n}\r\n\r\nfunction setCrest(img, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    img.src = src;\r\n    img.alt = teamName(teamId);\r\n    img.style.visibility = 'visible';\r\n  } else {\r\n    img.removeAttribute('src');\r\n    img.alt = '';\r\n    img.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el, starterLimit, isGla) {\r\n  const slots = Array.from({ length: starterLimit }, (_, index) => `\r\n    <div class=\"ov-formacion-slot ov-formacion-slot-${index}\">\r\n      <div class=\"ov-formacion-number\"></div>\r\n      <div class=\"ov-formacion-player-name\"></div>\r\n    </div>\r\n  `).join('');\r\n\r\n  // \"data-adjust=crest\" (2026-09-04): SOLO GLA -- dispara el mecanismo\r\n  // generico de Program (applyElementAdjustRegistry) que lee el registro\r\n  // de shared/adjust-registry.js (entrada \"crest\", ahora \"themeOnly:'gla'\",\r\n  // exactamente como funcionaba antes de esta tarea). Argentina Streamers\r\n  // NO lo lleva: su posicion por equipo se resuelve 100% a mano mas abajo\r\n  // (crestByTeam) -- si tambien llevara el atributo, el mecanismo generico\r\n  // pisaria ese calculo con el valor plano de siempre, rompiendo el\r\n  // guardado por equipo en cuanto hubiera una posicion especifica guardada.\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-formacion-shirts\" src=\"${versionedAssetUrl(SHIRTS_BASE_SRC)}\" alt=\"\" />\r\n      <div class=\"ov-formacion-shirts-wrap\">\r\n        <img class=\"ov-formacion-shirts-white\" src=\"${versionedAssetUrl(SHIRTS_WHITE_SRC)}\" alt=\"\" />\r\n        <div class=\"ov-formacion-shirts-tint\"></div>\r\n      </div>\r\n      ${slots}\r\n      <img class=\"ov-formacion-crest\" alt=\"\" ${isGla ? 'data-adjust=\"crest\"' : ''} />\r\n      <div class=\"ov-formacion-subs-title\">SUPLENTES</div>\r\n      <div class=\"ov-formacion-subs-viewport\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'formacionEquipos', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\n// Sin campo de color propio: el equipo (y por lo tanto el color real de la\r\n// camiseta) se leen en vivo de \"scoreboard\" (5to argumento, allData) segun\r\n// \"teamSide\" -- mismo patron que el escudo, ver mas abajo. No se duplica el\r\n// catalogo de colores (shared/team-colors.js, mismo helper que usa el\r\n// Marcador principal).\r\nexport default function renderFormacionEquipos(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const starterLimit = getStarterLimit();\r\n  const isGla = getActiveThemeId() === DEFAULT_THEME_ID;\r\n  // Reconstruye si cambia el theme en caliente (6 titulares GLA <-> 11\r\n  // Argentina Streamers, con o sin \"data-adjust=crest\" -- ver\r\n  // buildStructure): mismo criterio que \"signature\" en\r\n  // performanceTable.js -- sin esto, un cambio de theme sin recargar la\r\n  // pagina dejaba el DOM viejo (6 u 11 slots fijos desde el primer render).\r\n  const signature = String(starterLimit);\r\n  // \"signatureChanged\" (2026-09-23, mismo bug/fix que tarjeta.js/vs.js/\r\n  // shortDouble.js -- ver comentario en tarjeta.js): marcar\r\n  // \"_gfxBuilt = false\" sin destruir el \"_alphaVideo\" antes de reconstruir\r\n  // dejaba el contexto/video anterior huerfano, y como \"justTaken\" es\r\n  // false en un cambio de theme en caliente, el video nuevo tampoco se\r\n  // reproducia. En la practica el cambio de theme YA fuerza un teardown\r\n  // completo de todos los modulos antes (ver program/js/main.js), asi que\r\n  // esta rama rara vez llega a ejecutarse con un \"_alphaVideo\" previo real\r\n  // -- se corrige de todos modos por prolijidad/consistencia con el resto.\r\n  const signatureChanged = contentEl.dataset.signature !== undefined && contentEl.dataset.signature !== signature;\r\n  if (contentEl.dataset.signature !== signature) {\r\n    contentEl.dataset.signature = signature;\r\n    if (signatureChanged && contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    contentEl._gfxBuilt = false;\r\n  }\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl, starterLimit, isGla);\r\n  if (justTaken || signatureChanged) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const isVisitor = data.teamSide === 'visitor';\r\n  const teamId = isVisitor ? sb.teamB : sb.teamA;\r\n  const shirts = contentEl.querySelector('.ov-formacion-shirts');\r\n  const shirtsSrc = resolveFormationShirts(teamId);\r\n  if (shirtsSrc) {\r\n    shirts.src = shirtsSrc;\r\n    shirts.style.visibility = 'visible';\r\n  } else {\r\n    shirts.removeAttribute('src');\r\n    shirts.style.visibility = 'hidden';\r\n  }\r\n  contentEl.querySelector('.ov-formacion-shirts-wrap').style.display = isGla ? '' : 'none';\r\n  const shirtsAdjust = data.formationKitByTeam?.[teamId] || {};\r\n  applyElementAdjust(shirts, {\r\n    offsetX: shirtsAdjust.offsetX || 0,\r\n    offsetY: shirtsAdjust.offsetY || 0,\r\n    scale: shirtsAdjust.scale || 1,\r\n  });\r\n\r\n  // La entrada nueva queda estructuralmente armada a ~0,67 s. El brillo\r\n  // posterior es decorativo y no debe demorar los datos. GLA conserva sus\r\n  // 1200 ms definidos en overlay.css.\r\n  const moduleRoot = contentEl.closest('.gfx');\r\n  if (moduleRoot) {\r\n    if (isGla) moduleRoot.style.removeProperty('--dur-content-delay');\r\n    else moduleRoot.style.setProperty('--dur-content-delay', ARGENTINA_CONTENT_DELAY);\r\n  }\r\n  const crestEl = contentEl.querySelector('.ov-formacion-crest');\r\n  setCrest(crestEl, teamId);\r\n  // Posicion del escudo POR EQUIPO (2026-09-04, pedido explicito del\r\n  // usuario, SOLO Argentina Streamers): mismo patron ya probado arriba\r\n  // para \"formationKitByTeam\" (sin \"data-adjust\" en AS -- se removio del\r\n  // <img> a proposito para este theme, se resuelve 100% aca para no\r\n  // duplicar aplicacion). Si todavia no existe una posicion guardada para\r\n  // este teamId puntual, usa el valor plano \"crestOffsetX/Y/Scale\" (el\r\n  // mismo que ya existia antes de este cambio) como fallback -- asi la\r\n  // posicion actual, ya acomodada por el usuario, NO se mueve para ningun\r\n  // equipo hasta que el operador guarde una especifica desde el nuevo\r\n  // control del panel. GLA NO entra aca: su <img> SI lleva\r\n  // \"data-adjust=crest\" (ver buildStructure), el mecanismo generico de\r\n  // Program ya se lo aplica solo -- llamarlo tambien aca lo pisaria con el\r\n  // mismo valor (inofensivo hoy, pero redundante y innecesario).\r\n  if (!isGla) {\r\n    const crestAdjust = data.crestByTeam?.[teamId] || {};\r\n    applyElementAdjust(crestEl, {\r\n      offsetX: crestAdjust.crestOffsetX ?? data.crestOffsetX ?? 0,\r\n      offsetY: crestAdjust.crestOffsetY ?? data.crestOffsetY ?? 0,\r\n      scale: crestAdjust.crestScale ?? data.crestScale ?? 1,\r\n    });\r\n  }\r\n\r\n  if (isGla) contentEl.querySelector('.ov-formacion-shirts-tint').style.backgroundColor = teamColorHex(sb, isVisitor ? 'B' : 'A');\r\n\r\n  // \"playerName\"/\"playerNumber\" (2026-08-15, auditoria completa): ajuste\r\n  // compartido por las 6 posiciones (mismo criterio \"column-level\" que las\r\n  // tablas dinamicas de este sistema, ver Posiciones/Resultados) -- se lee\r\n  // una sola vez fuera del loop, mismo objeto aplicado a las 6.\r\n  const ta = data.textAdjust;\r\n  const nameAdjust = readTextAdjust(ta, 'playerName');\r\n  const numberAdjust = readTextAdjust(ta, 'playerNumber');\r\n  // Orden de carga (2026-09-10, pedido explicito del usuario, item 11):\r\n  // \"starters[0]\" es SIEMPRE el arquero, seguido de la defensa (derecha a\r\n  // izquierda), el mediocampo (derecha a izquierda) y el ataque (derecha a\r\n  // izquierda) -- \"de abajo hacia arriba y de derecha a izquierda dentro de\r\n  // cada linea\". El asset de 11 posiciones (Argentina Streamers) dibuja\r\n  // exactamente esa formacion en el orden INVERSO de indice de slot (medido\r\n  // por coordenadas reales en overlay.css: slot-10 es el unico solo/abajo\r\n  // = arquero; slots 6-9 = linea de defensa; slots 2-5 = mediocampo; slots\r\n  // 0-1 = ataque, arriba) -- por eso \"slotIndex = (starterLimit-1)-index\"\r\n  // hace exactamente ese mapeo sin tocar el dato ni el CSS existente. GLA\r\n  // (6 posiciones, sin arquero dibujado en el asset, ver comentario de\r\n  // \"STARTER_LIMIT_GLA\" arriba) conserva el orden directo de siempre.\r\n  const starters = normalizePlayers(data.starters).slice(0, starterLimit);\r\n  for (let index = 0; index < starterLimit; index++) {\r\n    const slotIndex = isGla ? index : (starterLimit - 1 - index);\r\n    const slot = contentEl.querySelector(`.ov-formacion-slot-${slotIndex}`);\r\n    const player = starters[index] || { number: '', name: '' };\r\n    applyPlainTextAdjust(slot.querySelector('.ov-formacion-number'), player.number, numberAdjust);\r\n    applyPlainTextAdjust(slot.querySelector('.ov-formacion-player-name'), player.name, nameAdjust);\r\n    slot.style.visibility = player.number || player.name ? 'visible' : 'hidden';\r\n  }\r\n\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-formacion-subs-title'), 'SUPLENTES', readTextAdjust(ta, 'subsTitle'));\r\n\r\n  const subsViewport = contentEl.querySelector('.ov-formacion-subs-viewport');\r\n  renderSubstitutes(subsViewport, normalizePlayers(data.substitutes));\r\n  applySubstitutesAdjust(subsViewport, readTextAdjust(ta, 'subsList'));\r\n}\r\n\r\n// Ajuste de posicion/tama\u00F1o del bloque completo de suplentes (2026-08-15,\r\n// auditoria completa): aparte de \"renderSubstitutes\" (que solo reconstruye\r\n// cuando cambia la lista o el alto visible, ver signature/measuredHeight\r\n// mas abajo) porque tiene que aplicarse en TODOS los renders, incluidos los\r\n// que no reconstruyen nada. \"dx\"/\"dy\" van sobre el viewport (translate, no\r\n// interfiere con el recorte por overflow que ya tiene esa caja); \"dSize\" se\r\n// suma sobre el tama\u00F1o BASE que ya calculo renderSubstitutes segun la\r\n// cantidad de suplentes (guardado en dataset.baseFontSize, ver mas abajo)\r\n// -- nunca sobre un tama\u00F1o ya ajustado de una vuelta anterior, para que\r\n// cambiar la cantidad de suplentes seguya recalculando bien el tama\u00F1o base.\r\nfunction applySubstitutesAdjust(viewport, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  viewport.style.translate = `${dx}px ${dy}px`;\r\n  viewport.querySelectorAll('.ov-formacion-subs-list').forEach((list) => {\r\n    const base = parseFloat(list.dataset.baseFontSize) || 0;\r\n    if (base) list.style.fontSize = `${Math.max(1, base + dSize)}px`;\r\n  });\r\n}\r\n\r\nfunction renderSubstitutes(viewport, players) {\r\n  const signature = JSON.stringify(players);\r\n  const visibleHeight = viewport.clientHeight;\r\n  if (\r\n    visibleHeight > 0\r\n    && viewport.dataset.signature === signature\r\n    && viewport.dataset.measuredHeight === String(visibleHeight)\r\n  ) return;\r\n  viewport.dataset.signature = signature;\r\n  viewport.dataset.measuredHeight = String(visibleHeight);\r\n  viewport.classList.remove('is-scrolling');\r\n  viewport.innerHTML = '';\r\n\r\n  const list = document.createElement('div');\r\n  list.className = 'ov-formacion-subs-list';\r\n  const baseFontSize = players.length > 12 ? 16\r\n    : players.length > 10 ? 18\r\n    : players.length > 8 ? 22\r\n    : players.length > 6 ? 26\r\n    : 30;\r\n  list.style.fontSize = `${baseFontSize}px`;\r\n  // Base sin ajuste (2026-08-15, auditoria completa): \"applySubstitutesAdjust\"\r\n  // lo lee para sumarle \"dSize\" sin perder de donde partir -- cloneNode(true)\r\n  // mas abajo copia tambien este dataset, asi que el clon de la marquesina\r\n  // (si el contenido no entra y hay que animar el scroll) lo hereda solo.\r\n  list.dataset.baseFontSize = String(baseFontSize);\r\n  for (const player of players) {\r\n    const row = document.createElement('div');\r\n    row.className = 'ov-formacion-sub';\r\n    row.textContent = toBroadcastUpper(player.number ? `${player.number} - ${player.name}` : player.name);\r\n    list.appendChild(row);\r\n  }\r\n  viewport.appendChild(list);\r\n\r\n  if (visibleHeight === 0 || list.scrollHeight <= visibleHeight) return;\r\n\r\n  const track = document.createElement('div');\r\n  track.className = 'ov-formacion-subs-track';\r\n  const clone = list.cloneNode(true);\r\n  track.append(list, clone);\r\n  viewport.replaceChildren(track);\r\n  const distance = list.scrollHeight + 22;\r\n  track.style.setProperty('--subs-distance', `${distance}px`);\r\n  track.style.setProperty('--subs-duration', `${Math.max(12, distance / 18)}s`);\r\n  viewport.classList.add('is-scrolling');\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/vsResultado.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { updateFittedTextWithTransition, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('vsResultado', 'principal');\r\nconst DEFAULT_TITULO = 'RESULTADO';\r\n\r\nconst NAME_MAX_FONT = 42;\r\nconst NAME_MIN_FONT = 20;\r\nconst NAME_SAFETY_MARGIN = 24;\r\nconst NAME_MAX_WIDTH_A = 282 - NAME_SAFETY_MARGIN;\r\nconst NAME_MAX_WIDTH_B = 286 - NAME_SAFETY_MARGIN;\r\n\r\nconst GOAL_MAX_FONT = 58;\r\nconst GOAL_MIN_FONT = 30;\r\nconst GOAL_MAX_WIDTH = 136 - 36;\r\n\r\nconst TITULO_MAX_FONT = 38;\r\nconst TITULO_MIN_FONT = 20;\r\nconst TITULO_MAX_WIDTH = 905 - 40;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  // Argentina Streamers entrego este asset como PNG (VS_RESULTADO), no\r\n  // como video -- \"mountThemedAlphaVideo\" solo resuelve \"asset.video\",\r\n  // mismo patron ya usado por marcadorEntretiempo.js/marcadorTiempoAdicional.js\r\n  // para no dejar \".av-target\" vacio. GLA sigue exactamente igual, su\r\n  // propio VIDEO_SRC via mountThemedAlphaVideo (su manifest no tiene\r\n  // \"image\" para este modulo).\r\n  const imgSrc = resolveImageSrc('vsResultado');\r\n  el.innerHTML = `\r\n    ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-vsfull-titulo\"></div>\r\n      <div class=\"ov-vsfull-teamA\"><img class=\"ov-vsfull-crest\" data-adjust=\"localCrest\" /></div>\r\n      <div class=\"ov-vsfull-teamB\"><img class=\"ov-vsfull-crest\" data-adjust=\"awayCrest\" /></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameA\"></div>\r\n      <div class=\"ov-vsfull-name ov-vsfull-nameB\"></div>\r\n      <div class=\"ov-vsfull-score ov-vsfull-scoreA\"></div>\r\n      <div class=\"ov-vsfull-score-dash\">-</div>\r\n      <div class=\"ov-vsfull-score ov-vsfull-scoreB\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'vsResultado', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderVsResultado(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamA .ov-vsfull-crest'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-vsfull-teamB .ov-vsfull-crest'), sb.teamB);\r\n\r\n  const nameA = resolveVsDisplayName({ mode: data.nameAMode, manualText: data.nameAManual, teamId: sb.teamA, fallbackName: teamName(sb.teamA) });\r\n  const nameB = resolveVsDisplayName({ mode: data.nameBMode, manualText: data.nameBManual, teamId: sb.teamB, fallbackName: teamName(sb.teamB) });\r\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\r\n  // usuario: \"todos los textos que se cambien cuando aprieto ACTUALIZAR\r\n  // que sean con animaci\u00F3n... queda muy feo el cut\"). \"vsResultado\" no es\r\n  // un modulo LIVE (no esta en MARCADOR_SUBSECTION_IDS/ALWAYS_LIVE_MODULE_IDS,\r\n  // ver master-control/js/main.js) -- su contenido solo cambia via\r\n  // TAKE/ACTUALIZAR, nunca tecla a tecla, asi que el fade nunca parpadea\r\n  // en pleno tipeo (a diferencia de un modulo LIVE, donde SI convendria\r\n  // evitarlo).\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameA'), nameA, contentEl._prevNameA, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_A, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameA'), !justTaken);\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-nameB'), nameB, contentEl._prevNameB, {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH_B, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'nameB'), !justTaken);\r\n  contentEl._prevNameA = nameA;\r\n  contentEl._prevNameB = nameB;\r\n\r\n  const scoreA = String(sb.scoreA ?? '');\r\n  const scoreB = String(sb.scoreB ?? '');\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-scoreA'), scoreA, contentEl._prevScoreA, {\r\n    maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(data.textAdjust, 'scoreA'), !justTaken);\r\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-vsfull-scoreB'), scoreB, contentEl._prevScoreB, {\r\n    maxFont: GOAL_MAX_FONT, minFont: GOAL_MIN_FONT, maxWidth: GOAL_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(data.textAdjust, 'scoreB'), !justTaken);\r\n  contentEl._prevScoreA = scoreA;\r\n  contentEl._prevScoreB = scoreB;\r\n\r\n  // Guion entre goles (2026-10-08, SOLO Argentina Streamers -- en GLA el\r\n  // nodo queda oculto por CSS, su asset ya trae el guion). Texto fijo con\r\n  // su propio ajuste \"scoreSep\" (dx/dy/dSize), independiente de los goles:\r\n  // moverlo nunca mueve los numeros.\r\n  applyPlainTextAdjust(contentEl.querySelector('.ov-vsfull-score-dash'), '-', readTextAdjust(data.textAdjust, 'scoreSep'));\r\n\r\n  const tituloEl = contentEl.querySelector('.ov-vsfull-titulo');\r\n  const newTitulo = (data.titulo || '').trim() || DEFAULT_TITULO;\r\n  const oldTitulo = contentEl._prevTitulo;\r\n\r\n  updateFittedTextWithTransition(tituloEl, newTitulo, oldTitulo, {\r\n    maxFont: TITULO_MAX_FONT, minFont: TITULO_MIN_FONT, maxWidth: TITULO_MAX_WIDTH, weight: 800, letterSpacing: 1,\r\n  }, readTextAdjust(data.textAdjust, 'titulo'), !justTaken);\r\n\r\n  contentEl._prevTitulo = newTitulo;\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/tarjeta.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { getProgramFontFamily, withGlaSegoeRegular } from '../program-fonts.js';\r\nimport { crestFile } from '../../../shared/teams.js';\r\nimport { readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\n\r\nconst VIDEO_BY_TIPO = {\r\n  amarilla: glaAssetPath('tarjeta', 'amarilla'),\r\n  roja: glaAssetPath('tarjeta', 'roja'),\r\n  azul: glaAssetPath('tarjeta', 'azul'),\r\n};\r\n\r\n// Ancho real de \".ov-tarjeta-jugador\" (ver overlay.css): recorrido a\r\n// left:150/width:292 (mas separado de la linea divisoria x135, y con\r\n// mas margen antes del icono de color de la tarjeta en x452).\r\n// NAME_SAFETY_MARGIN es un colchon adicional (mismo criterio que el\r\n// titulo de Penales) para que la tinta real (actualBoundingBox) nunca\r\n// quede mas ancha que la medicion de avance (measureText().width) por\r\n// algun caracter puntual.\r\n// MAX_FONT subido de 34 a 42 (referencia de imagen: \"mucha mas\r\n// presencia, sin exagerar como en intentos anteriores\" \u2014 56 y 49 se\r\n// habian visto demasiado grandes, 34 se vio bien de tama\u00F1o pero \"todavia\r\n// chico\" frente a la referencia; 42 es el punto medio entre ambos\r\n// feedbacks). NAME_MIN_FONT sube proporcional (14->18).\r\nconst NAME_MAX_FONT = 42;\r\nconst NAME_MIN_FONT = 18;\r\nconst NAME_BOX_WIDTH = 292; // ancho real de .ov-tarjeta-jugador\r\nconst NAME_SAFETY_MARGIN = 6;\r\nconst NAME_MAX_WIDTH = NAME_BOX_WIDTH - NAME_SAFETY_MARGIN;\r\n\r\nlet measureCtx = null;\r\n// Fuente de medicion (2026-10-22): en GLA la misma Segoe UI Regular 400 del\r\n// Marcador (withGlaSegoeRegular); en Argentina Streamers, la de siempre.\r\nfunction nameFont(fontSize) {\r\n  const { weight, family } = withGlaSegoeRegular({ weight: 700, family: getProgramFontFamily() });\r\n  return `${weight} ${fontSize}px ${family}`;\r\n}\r\nfunction measureWidth(text, fontSize) {\r\n  measureCtx.font = nameFont(fontSize);\r\n  return measureCtx.measureText(text).width;\r\n}\r\n\r\n// Mismo criterio que el titulo de Marcador de Penales (ver\r\n// program/js/renderers/marcadorPenales.js): estimacion proporcional\r\n// rapida + ajuste fino con medicion real, para que nombres largos nunca\r\n// invadan el icono de la tarjeta, y nombres cortos se vean grandes (nunca\r\n// un tama\u00F1o fijo chico).\r\nasync function fitNameFontSize(text) {\r\n  if (!measureCtx) measureCtx = document.createElement('canvas').getContext('2d');\r\n  await document.fonts.load(nameFont(NAME_MAX_FONT));\r\n  const widthAtMax = measureWidth(text, NAME_MAX_FONT);\r\n  if (widthAtMax <= NAME_MAX_WIDTH) return NAME_MAX_FONT;\r\n  let size = Math.floor(NAME_MAX_FONT * (NAME_MAX_WIDTH / widthAtMax));\r\n  size = Math.max(NAME_MIN_FONT, size);\r\n  while (size > NAME_MIN_FONT && measureWidth(text, size) > NAME_MAX_WIDTH) {\r\n    size -= 1;\r\n  }\r\n  return size;\r\n}\r\n\r\n// Corrige el centrado vertical dentro de \".ov-tarjeta-jugador\".\r\n// \"align-items:center\" centra la CAJA DE LINEA del texto (alto =\r\n// fontBoundingBoxAscent + fontBoundingBoxDescent), no la tinta real \u2014\r\n// Anton declara un descenso de fuente mucho mas grande que el que usa de\r\n// verdad este texto en mayusculas (fontBoundingBoxDescent >>\r\n// actualBoundingBoxDescent, reservado para caracteres que nunca se\r\n// dibujan aca), lo que puede correr la tinta hacia arriba dentro de la\r\n// caja. El desbalance exacto depende del hinting de fuente de cada\r\n// sistema/navegador \u2014 no es un numero fijo que se pueda hardcodear con\r\n// garantia, por eso se mide en vivo (mismo canvas 2D que ya se usa para\r\n// el ancho) y se aplica como una correccion vertical explicita.\r\nfunction measureVerticalCorrection(text, fontSize) {\r\n  measureCtx.font = nameFont(fontSize);\r\n  const m = measureCtx.measureText(text);\r\n  const lineBoxAscent = m.fontBoundingBoxAscent;\r\n  const lineBoxDescent = m.fontBoundingBoxDescent;\r\n  const inkAscent = m.actualBoundingBoxAscent;\r\n  const inkDescent = m.actualBoundingBoxDescent;\r\n  // Con align-items:center, el centro de la tinta real queda desplazado\r\n  // del centro de la caja en (lineBoxAscent-lineBoxDescent)/2 +\r\n  // (inkDescent-inkAscent)/2; se corrige con un translateY que cancela\r\n  // exactamente ese desplazamiento.\r\n  return -((lineBoxAscent - lineBoxDescent) / 2 + (inkDescent - inkAscent) / 2);\r\n}\r\n\r\nfunction setCrest(imgEl, crestId) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Sin campo de equipo/escudo propio: \"equipo\" (local/visitante) solo elige\r\n// de que lado leer el escudo, en vivo, del Marcador principal (5to\r\n// argumento, mismo patron que marcadorPenales/marcadorEntretiempo) \u2014 no se\r\n// vuelve a cargar el escudo a mano en este panel.\r\nexport default function renderTarjeta(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const src = VIDEO_BY_TIPO[data.tipo] || VIDEO_BY_TIPO.amarilla;\r\n  // \"tipoChanged\" (2026-09-23, bug real encontrado en la auditoria de\r\n  // performance: cambiar el color de tarjeta CON LA GRAFICA AL AIRE\r\n  // montaba un video nuevo pero nunca lo destruia ni lo reproducia --\r\n  // quedaba pausado en el frame 0, la grafica se veia sin asset hasta el\r\n  // proximo Take). \"!== undefined\" (mismo criterio que zocaloCompuesto.js,\r\n  // la unica variante que ya andaba bien): en el PRIMER build (incluido un\r\n  // pre-montaje en frio del hot pool, ver program/js/main.js) todavia no\r\n  // hay \"dataset.tipo\" previo, asi que esto da false a proposito -- ese\r\n  // primer build nunca debe autoreproducirse solo por existir.\r\n  const tipoChanged = contentEl.dataset.tipo !== undefined && contentEl.dataset.tipo !== data.tipo;\r\n\r\n  if (!contentEl._gfxBuilt || tipoChanged) {\r\n    contentEl.dataset.tipo = data.tipo;\r\n    // Destruye la instancia vieja ANTES de crear la nueva (mismo orden que\r\n    // zocaloCompuesto.js): sin esto, el contexto WebGL/video anterior queda\r\n    // huerfano (nunca se libera hasta que el modulo completo se saca del\r\n    // aire), y con el Hot Pool activo ese contexto viejo ni siquiera se\r\n    // liberaria nunca solo (el modulo puede quedar WARM indefinidamente).\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    contentEl.innerHTML = `\r\n      <div class=\"av-target\"></div>\r\n      <div class=\"gfx-overlay\">\r\n        <div class=\"ov-tarjeta-team\"><img class=\"ov-tarjeta-crest\" data-adjust=\"crest\" /></div>\r\n        <div class=\"ov-tarjeta-jugador\"></div>\r\n      </div>\r\n    `;\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.av-target'), 'tarjeta', src, undefined, data.tipo);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n\r\n  if (justTaken || tipoChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const crestId = data.equipo === 'visitante' ? sb.teamB : sb.teamA;\r\n  setCrest(contentEl.querySelector('.ov-tarjeta-crest'), crestId);\r\n\r\n  const jugadorEl = contentEl.querySelector('.ov-tarjeta-jugador');\r\n  const jugadorText = toBroadcastUpper(data.jugador || '');\r\n  const adjust = readTextAdjust(data.textAdjust, 'jugador');\r\n  jugadorEl.textContent = jugadorText;\r\n  jugadorEl.style.translate = `${adjust.dx || 0}px ${adjust.dy || 0}px`;\r\n  fitNameFontSize(jugadorText).then((size) => {\r\n    if (jugadorEl.textContent !== jugadorText) return;\r\n    const finalSize = Math.max(1, size + (adjust.dSize || 0));\r\n    jugadorEl.style.fontSize = `${finalSize}px`;\r\n    const correction = measureVerticalCorrection(jugadorText, finalSize);\r\n    jugadorEl.style.transform = `translateY(${correction}px)`;\r\n  });\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/cambios.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile } from '../../../shared/teams.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('cambios', 'principal');\r\n\r\nconst TEXT_MAX_FONT = 34;\r\nconst TEXT_MIN_FONT = 18;\r\nconst TEXT_BOX_WIDTH = 220; \r\nconst TEXT_SAFETY_MARGIN = 6;\r\nconst TEXT_MAX_WIDTH = TEXT_BOX_WIDTH - TEXT_SAFETY_MARGIN;\r\n\r\nfunction setCrest(imgEl, crestId, adjust = {}) {\r\n  const file = crestFile(crestId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n    const dx = adjust.dx || 0;\r\n    const dy = adjust.dy || 0;\r\n    const sc = adjust.sc !== undefined ? adjust.sc : 1;\r\n    imgEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-cambio-team\"><img class=\"ov-cambio-crest\" data-adjust=\"crest\" /></div>\r\n      <div class=\"ov-cambio-entra\"></div>\r\n      <div class=\"ov-cambio-sale\"></div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'cambios', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderCambios(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) {\r\n    buildStructure(contentEl);\r\n  }\r\n  if (justTaken) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const isVisitante = data.equipo === 'visitante' || data.equipo === 'away';\r\n  const activeTeam = isVisitante ? (sb.teamB || 'oxen') : (sb.teamA || 'argentina-streamers');\r\n\r\n  const teamAdjust = isVisitante\r\n    ? (data.crestByTeam?.away?.[activeTeam] || {})\r\n    : (data.crestByTeam?.local?.[activeTeam] || {});\r\n\r\n  const dx = (teamAdjust.awayCrestOffsetX ?? teamAdjust.localCrestOffsetX ?? data.crestOffsetX) || 0;\r\n  const dy = (teamAdjust.awayCrestOffsetY ?? teamAdjust.localCrestOffsetY ?? data.crestOffsetY) || 0;\r\n  const sc = teamAdjust.awayCrestScale ?? teamAdjust.localCrestScale ?? data.crestScale ?? 1;\r\n\r\n  const crestEl = contentEl.querySelector('.ov-cambio-crest');\r\n  setCrest(crestEl, activeTeam, { dx, dy, sc });\r\n\r\n  const ta = data.textAdjust;\r\n  const entraEl = contentEl.querySelector('.ov-cambio-entra');\r\n  const saleEl = contentEl.querySelector('.ov-cambio-sale');\r\n\r\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\r\n  // usuario: fade en vez de corte duro en ACTUALIZAR) -- Cambios no es un\r\n  // modulo LIVE, su contenido solo cambia via TAKE/ACTUALIZAR.\r\n  const entra = data.entra || '';\r\n  const sale = data.sale || '';\r\n  updateFittedTextWithTransition(entraEl, entra, contentEl._prevEntra, withGlaSegoeRegular({\r\n    maxFont: TEXT_MAX_FONT, minFont: TEXT_MIN_FONT, maxWidth: TEXT_MAX_WIDTH, weight: 700,\r\n  }), readTextAdjust(ta, 'entra'), !justTaken);\r\n  updateFittedTextWithTransition(saleEl, sale, contentEl._prevSale, withGlaSegoeRegular({\r\n    maxFont: TEXT_MAX_FONT, minFont: TEXT_MIN_FONT, maxWidth: TEXT_MAX_WIDTH, weight: 700,\r\n  }), readTextAdjust(ta, 'sale'), !justTaken);\r\n  contentEl._prevEntra = entra;\r\n  contentEl._prevSale = sale;\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/gol.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('gol', 'principal');\r\n\r\n// oneShot: el video tiene su propia animacion de entrada Y salida adentro\r\n// (el festejo \"GOOOL\" aparece y se retira solo). Cuando termina, avisa via\r\n// onOneShotEnded para que el modulo vuelva a OUT sin que el operador tenga\r\n// que apretar Sacar. Este modulo ES el video (no tiene \".gfx-overlay\" con\r\n// contenido dinamico propio) -- si el theme activo todavia no tiene este\r\n// asset, no hay nada que animar: se avisa \"terminado\" enseguida para que\r\n// el modulo no quede trabado en ON esperando un \"onEnded\" que nunca va a\r\n// llegar (2026-08-21, sistema multi-theme).\r\nexport default function renderGol(contentEl, data, justTaken, onOneShotEnded) {\r\n  if (!contentEl._gfxBuilt) {\r\n    contentEl.innerHTML = '<div class=\"av-target\"></div>';\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(\r\n      contentEl.querySelector('.av-target'),\r\n      'gol',\r\n      VIDEO_SRC,\r\n      { onEnded: onOneShotEnded },\r\n    );\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n  if (justTaken) {\r\n    if (contentEl._alphaVideo) {\r\n      contentEl._alphaVideo.playFromStart();\r\n    } else {\r\n      setTimeout(() => onOneShotEnded?.(), 0);\r\n    }\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/grupos.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { ordenarGrupo, desempateVigente } from '../../../shared/grupos-orden.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\n\r\n// PNG estaticos (sin video, ya preparados y escalados a 1920x1080 por el\r\n// usuario) \u2014 mismo criterio que marcadorZocalo.js/marcadorTiempoAdicional.js:\r\n// <img class=\"gfx-bg-image\"> a resolucion nativa, sin transform ni recorte.\r\nconst IMG_SRC = {\r\n  grupo1: glaAssetPath('grupos', 'grupo1'),\r\n  grupo2: glaAssetPath('grupos', 'grupo2'),\r\n};\r\n\r\n// Cantidad y posicion de filas medidas directamente sobre el canal alfa/color\r\n// real de ambos PNG (identicas en los dos, ver overlay.css para el detalle\r\n// completo): 3 casilleros de equipo, mismo alto y mismo paso vertical.\r\nconst ROW_COUNT = 3;\r\n\r\n// Modos de posicion (ver overlay.css para los transforms medidos de cada\r\n// uno). \"placaL\" muestra Grupo 1 y Grupo 2 juntos (apilados); los modos\r\n// fullscreen muestran un unico grupo, elegido con \"variante\".\r\nfunction normalizePosicion(posicion) {\r\n  return posicion === 'fullscreenDerecha' || posicion === 'fullscreenIzquierda' ? posicion : 'placaL';\r\n}\r\n\r\n// Orden de exhibicion: se calcula siempre a partir de \"puntos\" (mayor a\r\n// menor), nunca se guarda como dato aparte ni reordena \"filas\" (el indice\r\n// de cada fila es su SLOT del sorteo, A1..B3, que usa PARTIDOS > SABADO).\r\n// 2026-10-23 (pedido explicito del usuario): ordena por los puntos cargados\r\n// aunque las filas vengan de la web (\"ordenOficial\" ya no pisa los puntos);\r\n// entre empatados manda un VALIDAR WEB vigente para estos mismos datos, y\r\n// si no hay, el orden de los slots. Ver shared/grupos-orden.js.\r\nfunction sortedFilas(filas, desempate) {\r\n  return ordenarGrupo(filas, desempate).map((entry) => entry.fila);\r\n}\r\n\r\n// MODO WEB (2026-10-23, SOLO GLA): el snapshot WEB (\"gruposWeb\", Fase de\r\n// Grupos de Rel\u00E1mpago #4) se muestra en el ORDEN OFICIAL que publica\r\n// gla.futbol (\"posicion\"), sin recalcular nada; el MANUAL sigue con la\r\n// logica de arriba. Cada modo tiene sus propios datos, nunca se mezclan.\r\nfunction officialFilas(filas) {\r\n  return (Array.isArray(filas) ? filas : [])\r\n    .map((fila, index) => ({ fila, index }))\r\n    .sort((a, b) => (Number(a.fila.posicion) || a.index + 1) - (Number(b.fila.posicion) || b.index + 1))\r\n    .map((entry) => entry.fila);\r\n}\r\n\r\nfunction cardMarkup() {\r\n  const rows = Array.from({ length: ROW_COUNT }, (_, i) => `\r\n    <img class=\"ov-grupos-crest\" data-row=\"${i}\" data-adjust=\"crest\" />\r\n    <div class=\"ov-grupos-name\" data-row=\"${i}\"></div>\r\n    <div class=\"ov-grupos-puntos\" data-row=\"${i}\"></div>\r\n  `).join('');\r\n  return `\r\n    <img class=\"gfx-bg-image\" data-card-bg />\r\n    <div class=\"gfx-overlay\">${rows}</div>\r\n  `;\r\n}\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const file = crestFile(teamId);\r\n  if (file) {\r\n    imgEl.src = file;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\n// Pinta una tarjeta completa (imagen de fondo + 3 filas) para un grupo\r\n// puntual dentro del nodo contenedor \".ov-grupos-card\" que le corresponda.\r\n// Sin campos de equipo propios: cada fila guarda unicamente el ID del\r\n// equipo (mismo catalogo global que Marcador principal, ver\r\n// shared/teams.js) \u2014 escudo y nombre completo se derivan siempre de ese\r\n// ID, nunca se cargan ni se escriben a mano.\r\nfunction paintCard(cardEl, grupoKey, filas, textAdjust, desempate, web = false) {\r\n  const bgEl = cardEl.querySelector('[data-card-bg]');\r\n  const bgSrc = resolveImageSrc('grupos', IMG_SRC[grupoKey], grupoKey);\r\n  if (bgSrc) {\r\n    bgEl.src = bgSrc;\r\n    bgEl.style.visibility = 'visible';\r\n  } else {\r\n    bgEl.removeAttribute('src');\r\n    bgEl.style.visibility = 'hidden';\r\n  }\r\n  const ordered = web ? officialFilas(filas) : sortedFilas(filas || [], desempate);\r\n  const nombreAdjust = readTextAdjust(textAdjust, 'nombre');\r\n  const puntosAdjust = readTextAdjust(textAdjust, 'puntos');\r\n  for (let i = 0; i < ROW_COUNT; i++) {\r\n    const fila = ordered[i] || { teamId: '', puntos: '' };\r\n    setCrest(cardEl.querySelector(`.ov-grupos-crest[data-row=\"${i}\"]`), fila.teamId);\r\n    applyFittedText(\r\n      cardEl.querySelector(`.ov-grupos-name[data-row=\"${i}\"]`),\r\n      // WEB: un equipo que no se pudo asociar al catalogo se muestra con\r\n      // el nombre de la web (sin escudo), nunca con otro equipo.\r\n      fila.teamId ? teamName(fila.teamId) : (web ? fila.nombreWeb || '' : ''),\r\n      // Agrandado levemente de 28/14 (2026-08-06, pedido explicito del usuario).\r\n      { maxFont: 31, minFont: 16, maxWidth: 145, weight: 400 },\r\n      nombreAdjust,\r\n    );\r\n    applyPlainTextAdjust(cardEl.querySelector(`.ov-grupos-puntos[data-row=\"${i}\"]`), String(fila.puntos ?? ''), puntosAdjust);\r\n  }\r\n}\r\n\r\nexport default function renderGrupos(contentEl, data) {\r\n  const posicion = normalizePosicion(data.posicion);\r\n  const web = getActiveThemeId() === DEFAULT_THEME_ID && data.modoGrupos === 'web';\r\n  const fuente = web ? (data.gruposWeb || {}) : data;\r\n  const grupoVisible = data.variante === 'grupo2' ? 'grupo2' : 'grupo1';\r\n  // Firma de la estructura DOM actual: solo cambia si cambia el modo o (en\r\n  // fullscreen) el grupo elegido \u2014 nunca por un simple cambio de puntos o\r\n  // equipo, que se pinta sin reconstruir nada. Reconstruir por completo\r\n  // ante un cambio real evita que quede una tarjeta anterior flotando\r\n  // (ej. al pasar de Placa L a fullscreen, o de un grupo a otro).\r\n  const signature = posicion === 'placaL' ? 'placaL' : `${posicion}:${grupoVisible}`;\r\n\r\n  if (contentEl.dataset.signature !== signature) {\r\n    contentEl.dataset.signature = signature;\r\n    if (posicion === 'placaL') {\r\n      contentEl.innerHTML = `\r\n        <div class=\"ov-grupos-card ov-grupos-card--placaL-top\" data-slot=\"grupo1\">${cardMarkup()}</div>\r\n        <div class=\"ov-grupos-card ov-grupos-card--placaL-bottom\" data-slot=\"grupo2\">${cardMarkup()}</div>\r\n      `;\r\n    } else {\r\n      const modifier = posicion === 'fullscreenDerecha' ? 'ov-grupos-card--fs-derecha' : 'ov-grupos-card--fs-izquierda';\r\n      contentEl.innerHTML = `<div class=\"ov-grupos-card ${modifier}\" data-slot=\"${grupoVisible}\">${cardMarkup()}</div>`;\r\n    }\r\n  }\r\n\r\n  if (posicion === 'placaL') {\r\n    paintCard(contentEl.querySelector('[data-slot=\"grupo1\"]'), 'grupo1', fuente.grupo1?.filas, data.textAdjust, desempateVigente(data, 'grupo1'), web);\r\n    paintCard(contentEl.querySelector('[data-slot=\"grupo2\"]'), 'grupo2', fuente.grupo2?.filas, data.textAdjust, desempateVigente(data, 'grupo2'), web);\r\n  } else {\r\n    const card = contentEl.querySelector(`[data-slot=\"${grupoVisible}\"]`);\r\n    paintCard(card, grupoVisible, fuente[grupoVisible]?.filas, data.textAdjust, desempateVigente(data, grupoVisible), web);\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/estrellas.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust, measureTextWidth, toBroadcastUpper } from '../text-fit.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('estrellas', 'principal');\r\n\r\n// Dimensiones de los textos medidos de forma real\r\n// NAME agrandado de 28/14 (2026-08-06, pedido explicito del usuario:\r\n// \"agrandar el nombre de los jugadores\") \u2014 STAT y TITULO sin cambios.\r\nconst NAME_MAX_FONT = 32;\r\nconst NAME_MIN_FONT = 16;\r\nconst NAME_MAX_WIDTH = 384 - 24; // 360px \u00FAtil\r\n\r\nconst STAT_MAX_FONT = 36;\r\nconst STAT_MIN_FONT = 18;\r\nconst STAT_MAX_WIDTH = 60 - 12; // 48px \u00FAtil\r\n\r\nconst TITLE_TEXT = 'LOS MEJORES DE CADA EQUIPO';\r\n// Banda del titulo: 490px de ancho (ver \".ov-estrellas-titulo\" en\r\n// overlay.css) -- un titulo manual mas largo se achica para entrar.\r\nconst TITLE_MAX_WIDTH = 490 - 20;\r\nconst TITLE_MIN_FONT = 12;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-estrellas-titulo\"></div>\r\n      \r\n      <!-- Fila Jugador Local -->\r\n      <div class=\"ov-estrellas-row ov-estrellas-row--local\">\r\n        <div class=\"ov-estrellas-escudo\">\r\n          <img class=\"ov-estrellas-crest\" data-adjust=\"localCrest\" />\r\n        </div>\r\n        <div class=\"ov-estrellas-name\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--g\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--a\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--pj\"></div>\r\n      </div>\r\n\r\n      <!-- Fila Jugador Visitante -->\r\n      <div class=\"ov-estrellas-row ov-estrellas-row--visitante\">\r\n        <div class=\"ov-estrellas-escudo\">\r\n          <img class=\"ov-estrellas-crest\" data-adjust=\"visitanteCrest\" />\r\n        </div>\r\n        <div class=\"ov-estrellas-name\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--g\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--a\"></div>\r\n        <div class=\"ov-estrellas-stat ov-estrellas-stat--pj\"></div>\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'estrellas', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderEstrellas(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const ta = data.textAdjust;\r\n\r\n  // T\u00EDtulo fijo: no depende de data ni ejecuta medici\u00F3n din\u00E1mica, pero\r\n  // sigue siendo texto visible en Program -> ajustable (2026-08-15,\r\n  // auditoria completa). T\u00CDTULO MANUAL (2026-10-09, pedido explicito, SOLO\r\n  // Argentina Streamers): \"data.titulo\" (vacio = el titulo de siempre).\r\n  // GLA sigue con su titulo fijo, sin cambios.\r\n  const tituloEl = contentEl.querySelector('.ov-estrellas-titulo');\r\n  const isArgentina = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID;\r\n  const tituloText = isArgentina ? (String(data.titulo || '').trim() || TITLE_TEXT) : TITLE_TEXT;\r\n  // Sin el achique del render anterior, para que el tama\u00F1o base medido sea el del CSS.\r\n  if (isArgentina) tituloEl.style.removeProperty('font-size');\r\n  applyPlainTextAdjust(tituloEl, tituloText, readTextAdjust(ta, 'titulo'));\r\n  if (isArgentina && tituloText !== TITLE_TEXT) {\r\n    const fontPx = parseFloat(tituloEl.style.fontSize || getComputedStyle(tituloEl).fontSize) || 28;\r\n    const width = measureTextWidth(toBroadcastUpper(tituloText), fontPx, { weight: 800 });\r\n    if (width > TITLE_MAX_WIDTH) {\r\n      tituloEl.style.fontSize = `${Math.max(TITLE_MIN_FONT, Math.floor(fontPx * (TITLE_MAX_WIDTH / width)))}px`;\r\n    }\r\n  }\r\n\r\n  // Escudos din\u00E1micos heredados del Marcador\r\n  const crestLocalEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-crest');\r\n  const crestVisitanteEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-crest');\r\n  setCrest(crestLocalEl, sb.teamA);\r\n  setCrest(crestVisitanteEl, sb.teamB);\r\n\r\n  // Nombre Jugador Local\r\n  const nameLocalEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-name');\r\n  applyFittedText(nameLocalEl, data.localNombre || '', {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(ta, 'localNombre'));\r\n\r\n  // Estad\u00EDsticas Jugador Local\r\n  const localGEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-stat--g');\r\n  const localAEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-stat--a');\r\n  const localPJEl = contentEl.querySelector('.ov-estrellas-row--local .ov-estrellas-stat--pj');\r\n  applyFittedText(localGEl, String(data.localG ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'localG'));\r\n  applyFittedText(localAEl, String(data.localA ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'localA'));\r\n  applyFittedText(localPJEl, String(data.localPJ ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'localPJ'));\r\n\r\n  // Nombre Jugador Visitante\r\n  const nameVisitanteEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-name');\r\n  applyFittedText(nameVisitanteEl, data.visitanteNombre || '', {\r\n    maxFont: NAME_MAX_FONT, minFont: NAME_MIN_FONT, maxWidth: NAME_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(ta, 'visitanteNombre'));\r\n\r\n  // Estad\u00EDsticas Jugador Visitante\r\n  const visitanteGEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-stat--g');\r\n  const visitanteAEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-stat--a');\r\n  const visitantePJEl = contentEl.querySelector('.ov-estrellas-row--visitante .ov-estrellas-stat--pj');\r\n  applyFittedText(visitanteGEl, String(data.visitanteG ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'visitanteG'));\r\n  applyFittedText(visitanteAEl, String(data.visitanteA ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'visitanteA'));\r\n  applyFittedText(visitantePJEl, String(data.visitantePJ ?? 0), {\r\n    maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'visitantePJ'));\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/posiciones.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, fitFontSize, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// La liga tiene 11 equipos: \"filas\" (shared/modules.js) guarda las 11 con\r\n// su posicion real (1-11, nunca renumerada). El asset solo tiene\r\n// casilleros para una mitad de la tabla a la vez, asi que \"pagina\"\r\n// decide cual video/subset se compone -- pagina1 (posiciones 1-6,\r\n// posiciones-alpha.mp4, 6 filas) o pagina2 (posiciones 7-11,\r\n// posiciones-5-alpha.mp4, 5 filas). Filas 0-4 de ambos assets miden\r\n// pixel a pixel identico (confirmado por diff de columna sobre los dos\r\n// videos reales): la unica diferencia es que el de pagina2 no tiene un\r\n// sexto casillero, por eso ambas paginas reutilizan las mismas reglas\r\n// CSS .ov-pos-row[data-row=\"0..4\"] y solo pagina1 usa tambien la fila 5.\r\n// \"pagina3\" (2026-10-22, la liga ya tiene 16 equipos): mismo asset y\r\n// mismas 5 filas que pagina2, para las posiciones 12-16.\r\nconst PAGINAS = {\r\n  pagina1: { src: glaAssetPath('posiciones', 'pagina1'), rows: 6, desde: 1, hasta: 6 },\r\n  pagina2: { src: glaAssetPath('posiciones', 'pagina2'), rows: 5, desde: 7, hasta: 11 },\r\n  pagina3: { src: glaAssetPath('posiciones', 'pagina2'), rows: 5, desde: 12, hasta: 16 },\r\n};\r\n\r\nfunction paginaConfig(data) {\r\n  return PAGINAS[data.pagina] || PAGINAS.pagina1;\r\n}\r\n\r\n// Columnas numericas reales impresas en el asset (medidas por lectura de\r\n// alfa/color, ver overlay.css) -- PTS, PJ, G, GXP, PXP, P, GF, GC, DG -- en\r\n// ese orden, sin agregar ni recortar ninguna.\r\nconst STAT_COLS = ['pts', 'pj', 'g', 'gxp', 'pxp', 'p', 'gf', 'gc', 'dg'];\r\n\r\nconst NUM_MAX_FONT = 28;\r\nconst NUM_MIN_FONT = 16;\r\nconst NUM_MAX_WIDTH = 77.5 - 24;\r\n\r\nconst EQUIPO_MAX_FONT = 32;\r\nconst EQUIPO_MIN_FONT = 16;\r\nconst EQUIPO_MAX_WIDTH = 460 - 40;\r\n\r\nconst PTS_MAX_FONT = 40;\r\nconst PTS_MIN_FONT = 22;\r\nconst PTS_MAX_WIDTH = 89 - 24;\r\n\r\n// Agrandado de 30/16 (2026-08-06, pedido explicito del usuario: \"agrandar\r\n// los numeros de todas las estadisticas\") \u2014 PTS, # y equipo sin cambios.\r\nconst STAT_MAX_FONT = 34;\r\nconst STAT_MIN_FONT = 18;\r\n// Ancho util minimo entre las 8 columnas restantes (89px, GXP/DG son un\r\n// poco mas anchas pero se usa el mismo criterio para las 9 por igual).\r\nconst STAT_MAX_WIDTH = 89 - 24;\r\n\r\n// Zocalo superior de titulo: caja real 1361px de ancho (ver overlay.css,\r\n// interior del zocalo medido por alfa/color, con inset de seguridad para\r\n// no tocar el marco dorado).\r\nconst TITULO_MAX_FONT = 44;\r\nconst TITULO_MIN_FONT = 22;\r\nconst TITULO_MAX_WIDTH = 1361 - 40;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction rowMarkup(index) {\r\n  const statCells = STAT_COLS.map((col) => `<div class=\"ov-pos-cell ov-pos-stat\" data-col=\"${col}\"></div>`).join('');\r\n  return `\r\n    <div class=\"ov-pos-row\" data-row=\"${index}\">\r\n      <div class=\"ov-pos-cell ov-pos-num\"></div>\r\n      <div class=\"ov-pos-cell ov-pos-escudo\"><img class=\"ov-pos-crest\" data-adjust=\"crest\" alt=\"\" /></div>\r\n      <div class=\"ov-pos-cell ov-pos-equipo\"></div>\r\n      ${statCells}\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction buildStructure(el, pagina, paginaId) {\r\n  const rows = Array.from({ length: pagina.rows }, (_, i) => rowMarkup(i)).join('');\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-posiciones-titulo\"></div>\r\n      ${rows}\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'posiciones', pagina.src, undefined, paginaId);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nasync function applyCenteredTitle(el, rawText, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  const text = toBroadcastUpper(rawText);\r\n  el.textContent = text;\r\n  // \"dx\"/\"dy\" via \"translate\" (2026-08-15, auditoria completa), no\r\n  // \"transform\": esta funcion depende de que \"transform\" quede SIEMPRE\r\n  // removido (ver comentario mas abajo, fix historico contra el drift de\r\n  // tinta variable) -- translate es una propiedad CSS independiente, se\r\n  // compone sin reabrir ese problema.\r\n  el.style.translate = `${dx}px ${dy}px`;\r\n  const size = await fitFontSize(text, withGlaSegoeRegular({\r\n    maxFont: TITULO_MAX_FONT,\r\n    minFont: TITULO_MIN_FONT,\r\n    maxWidth: TITULO_MAX_WIDTH,\r\n    weight: 800,\r\n    letterSpacing: 1,\r\n  }));\r\n  if (el.textContent !== text) return;\r\n  el.style.fontSize = `${Math.max(1, size + dSize)}px`;\r\n  // El flex del contenedor mantiene un unico centro vertical para todos\r\n  // los largos. No se aplica la correccion variable de tinta de\r\n  // applyFittedText, que era la que desplazaba el titulo al reducirse.\r\n  el.style.removeProperty('transform');\r\n}\r\n\r\n// Subset de la pagina actual, en el orden oficial que ya trae \"filas\"\r\n// (de la sincronizacion web o cargado a mano) -- se filtra por rango de\r\n// posicion real y se ordena por ese mismo campo, sin recalcular ningun\r\n// ranking propio (pedido explicito del usuario: el torneo puede tener\r\n// criterios de desempate que este sistema no replica). El \"#\" que se\r\n// dibuja en pantalla es siempre \"fila.posicion\" tal cual esta guardado\r\n// -- pagina2 nunca renumera 7-11 como si fueran 1-5.\r\nfunction filasParaPagina(filas, pagina) {\r\n  return (Array.isArray(filas) ? filas : [])\r\n    .filter((fila) => {\r\n      const pos = Number(fila?.posicion);\r\n      return Number.isFinite(pos) && pos >= pagina.desde && pos <= pagina.hasta;\r\n    })\r\n    .sort((a, b) => Number(a.posicion) - Number(b.posicion));\r\n}\r\n\r\nexport default function renderPosiciones(contentEl, data, justTaken) {\r\n  const pagina = paginaConfig(data);\r\n  const paginaId = PAGINAS[data.pagina] ? data.pagina : 'pagina1';\r\n  // Cambio de pagina mientras el modulo sigue montado (mismo contentEl):\r\n  // el asset es distinto (video diferente), asi que hay que destruir el\r\n  // compositor viejo y crear uno nuevo apuntando al video correcto -- no\r\n  // alcanza con re-pintar los datos. El flujo esperado por el usuario es\r\n  // OUT -> cambiar pagina -> TAKE (justTaken ya fuerza playFromStart), pero\r\n  // esto tambien deja el renderer correcto si en algun momento \"pagina\"\r\n  // cambia sin pasar por ese ciclo.\r\n  const needsRebuild = !contentEl._gfxBuilt || contentEl.dataset.paginaId !== paginaId;\r\n  if (needsRebuild) {\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    buildStructure(contentEl, pagina, paginaId);\r\n    contentEl.dataset.paginaId = paginaId;\r\n  }\r\n  if (justTaken || needsRebuild) contentEl._alphaVideo?.playFromStart();\r\n\r\n  // Titulo del zocalo superior: valor inicial 'POSICIONES' (ver defaults en\r\n  // shared/modules.js) hasta que el operador lo cambie; completamente\r\n  // editable, sin invadir filas ni columnas (posicionado solo dentro del\r\n  // zocalo de arriba, ver overlay.css).\r\n  const ta = data.textAdjust;\r\n  const tituloEl = contentEl.querySelector('.ov-posiciones-titulo');\r\n  applyCenteredTitle(tituloEl, data.titulo || '', readTextAdjust(ta, 'titulo'));\r\n\r\n  // Ajuste column-level (2026-08-15, auditoria completa): un unico control\r\n  // por columna (ver master-control/js/posiciones-panel.js) se lee UNA vez\r\n  // fuera del loop de filas y se aplica por igual a todas las filas\r\n  // visibles de esa columna -- mismo criterio que Resultados/Goleadores.\r\n  const numAdjust = readTextAdjust(ta, 'numero');\r\n  const equipoAdjust = readTextAdjust(ta, 'equipo');\r\n\r\n  const ordered = filasParaPagina(data.filas, pagina);\r\n  for (let i = 0; i < pagina.rows; i++) {\r\n    const row = contentEl.querySelector(`.ov-pos-row[data-row=\"${i}\"]`);\r\n    const fila = ordered[i] || {};\r\n\r\n    applyFittedText(row.querySelector('.ov-pos-num'), fila.posicion != null ? String(fila.posicion) : '', withGlaSegoeRegular({\r\n      maxFont: NUM_MAX_FONT, minFont: NUM_MIN_FONT, maxWidth: NUM_MAX_WIDTH, weight: 900,\r\n    }), numAdjust);\r\n\r\n    setCrest(row.querySelector('.ov-pos-crest'), fila.teamId);\r\n\r\n    applyFittedText(row.querySelector('.ov-pos-equipo'), fila.teamId ? teamName(fila.teamId) : '', withGlaSegoeRegular({\r\n      maxFont: EQUIPO_MAX_FONT, minFont: EQUIPO_MIN_FONT, maxWidth: EQUIPO_MAX_WIDTH, weight: 800,\r\n    }), equipoAdjust);\r\n\r\n    for (const col of STAT_COLS) {\r\n      const cell = row.querySelector(`.ov-pos-stat[data-col=\"${col}\"]`);\r\n      const value = col === 'pts' ? (fila.puntos ?? 0) : (fila[col] ?? 0);\r\n      const colAdjust = readTextAdjust(ta, col);\r\n      if (col === 'pts') {\r\n        applyFittedText(cell, String(value), withGlaSegoeRegular({\r\n          maxFont: PTS_MAX_FONT, minFont: PTS_MIN_FONT, maxWidth: PTS_MAX_WIDTH, weight: 900,\r\n        }), colAdjust);\r\n      } else {\r\n        applyFittedText(cell, String(value), withGlaSegoeRegular({\r\n          maxFont: STAT_MAX_FONT, minFont: STAT_MIN_FONT, maxWidth: STAT_MAX_WIDTH, weight: 900,\r\n        }), colAdjust);\r\n      }\r\n    }\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/performanceTable.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyElementAdjust, applyFittedText, applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\nimport { resolveImageSrc } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\nimport { withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\n// Titulo por default segun modulo (2026-09-02, pedido explicito del\r\n// usuario: \"T\u00CDTULO configurable\" sobre TABLA_ESTADISTICAS.png -- el\r\n// operador puede escribir el suyo, esto es solo el fallback cuando el\r\n// campo esta vacio).\r\nconst DEFAULT_TITLE = {\r\n  goleadores: 'GOLEADORES',\r\n  asistidores: 'ASISTIDORES',\r\n  jugadores: 'PARTICIPACIONES',\r\n};\r\n\r\n// GLA: siempre 6 filas, sin cambios (mismo asset/geometria de siempre).\r\n// Argentina Streamers (2026-09-02, pedido explicito del usuario: \"modo\r\n// cantidad\" 5/10 SLOTS): 5 filas cuando la placa comparte la zona\r\n// vertical con otra (\"placaL-top\"/\"placaL-bottom\"), 10 cuando ocupa toda\r\n// la zona ella sola (\"placaL-solo\"). Sin asset real todavia -- ver\r\n// ROW_COUNT_ARGENTINA abajo y el comentario de \"buildStructure\": el\r\n// contenido dinamico funciona igual sobre transparencia, el banner\r\n// \"ASSET PENDIENTE\" de Master Control indica que falta el grafico.\r\nconst ROW_COUNT_GLA = 6;\r\nconst ROW_COUNT_ARGENTINA = { 'placaL-top': 5, 'placaL-bottom': 5, 'placaL-solo': 10 };\r\n\r\nfunction rowCountFor(position) {\r\n  if (getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID && ROW_COUNT_ARGENTINA[position]) {\r\n    return ROW_COUNT_ARGENTINA[position];\r\n  }\r\n  return ROW_COUNT_GLA;\r\n}\r\n\r\nconst CONFIG = {\r\n  goleadores: {\r\n    image: glaAssetPath('goleadores', 'principal'),\r\n    ranking: true,\r\n    value: (player) => number(player.g),\r\n    compare: (a, b) => {\r\n      const goals = number(b.player.g) - number(a.player.g);\r\n      return goals !== 0 ? goals : a.index - b.index;\r\n    },\r\n  },\r\n  asistidores: {\r\n    image: glaAssetPath('asistidores', 'principal'),\r\n    ranking: true,\r\n    value: (player) => number(player.a),\r\n    compare: (a, b) => {\r\n      const assists = number(b.player.a) - number(a.player.a);\r\n      return assists !== 0 ? assists : a.index - b.index;\r\n    },\r\n  },\r\n  jugadores: {\r\n    image: glaAssetPath('jugadores', 'principal'),\r\n    values: (player) => [number(player.g), number(player.a), number(player.pj)],\r\n    // \"value\" (2026-09-02, SOLO se usa en modo ranking -- ver\r\n    // \"isRankingMode\" mas abajo, exclusivo de Argentina Streamers): la\r\n    // unica estadistica visible en el layout de 3 columnas\r\n    // (posicion+jugador+estadistica) sobre TABLA_ESTADISTICAS.png es \"PJ\"\r\n    // (partidos jugados) -- la metrica que ya maneja este modulo y que\r\n    // literalmente significa \"participaciones\", el nombre de broadcast de\r\n    // este modulo. GLA nunca lee esto (sigue con \"values\", G/A/PJ).\r\n    value: (player) => number(player.pj),\r\n    compare: (a, b) => {\r\n      const scoreA = average(a.player.g + a.player.a, a.player.pj);\r\n      const scoreB = average(b.player.g + b.player.a, b.player.pj);\r\n      const score = scoreB - scoreA;\r\n      return score !== 0 ? score : a.index - b.index;\r\n    },\r\n  },\r\n};\r\n\r\n// \"ranking\" en CONFIG es estatico (goleadores/asistidores siempre lo son,\r\n// GLA y Argentina Streamers por igual). \"jugadores\" es la excepcion: GLA\r\n// mantiene su layout propio de 3 columnas (G/A/PJ, sin cambios); Argentina\r\n// Streamers pasa a modo ranking (posicion+jugador+PJ) porque comparte\r\n// TABLA_ESTADISTICAS.png con los otros dos -- mismo asset, mismo layout de\r\n// fila, para los 3 modulos.\r\nfunction isRankingMode(moduleId) {\r\n  if (CONFIG[moduleId].ranking) return true;\r\n  return moduleId === 'jugadores' && getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID;\r\n}\r\n\r\nfunction number(value) {\r\n  const parsed = Number(value);\r\n  return Number.isFinite(parsed) && parsed > 0 ? parsed : 0;\r\n}\r\n\r\nfunction average(numerator, pj) {\r\n  const matches = number(pj);\r\n  return matches === 0 ? 0 : number(numerator) / matches;\r\n}\r\n\r\n// \"placaL-top\"/\"placaL-bottom\"/\"placaL-solo\" (2026-09-02): valores NUEVOS,\r\n// exclusivos del selector de Argentina Streamers (ver\r\n// master-control/js/performance-table-panel.js) -- GLA nunca los escribe,\r\n// asi que para GLA esta funcion sigue devolviendo exactamente lo mismo de\r\n// siempre.\r\nconst ARGENTINA_POSITIONS = new Set(['placaL-top', 'placaL-bottom', 'placaL-solo']);\r\n\r\n// Fallback de Argentina Streamers (2026-09-04, correccion PERMANENTE\r\n// pedida explicitamente por el usuario: \"no quiero depender de seleccionar\r\n// manualmente Placa unica\" / \"no quiero que placaL haga fallback al layout\r\n// viejo de GLA para estos modulos dentro de Argentina Streamers\"). Un\r\n// modulo de esta familia (goleadores/asistidores/jugadores) sin posicion\r\n// valida todavia -- server recien reiniciado, estado nuevo, \"posicion\"\r\n// nunca seleccionado a mano via \"MODO CANTIDAD\" -- caia en el 'placaL'\r\n// generico compartido con GLA (6 filas, tipografia y composicion\r\n// distintas: la causa real del desencuadre de Asistidores/Participaciones\r\n// reportado). GLA SI sigue usando 'placaL' como valor real (su propio\r\n// \"Placa L Info\"), asi que el fallback theme-gated de abajo es\r\n// EXCLUSIVAMENTE para Argentina Streamers -- cero cambio de\r\n// comportamiento para GLA (misma guarda de siempre).\r\nfunction normalizePosition(position) {\r\n  if (position === 'fullscreenDerecha' || position === 'fullscreenIzquierda') return position;\r\n  if (getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID) {\r\n    if (ARGENTINA_POSITIONS.has(position)) return position;\r\n    return 'placaL-solo';\r\n  }\r\n  return 'placaL';\r\n}\r\n\r\nfunction positionClass(position) {\r\n  if (position === 'fullscreenDerecha') return 'fs-derecha';\r\n  if (position === 'fullscreenIzquierda') return 'fs-izquierda';\r\n  if (ARGENTINA_POSITIONS.has(position)) return position;\r\n  return 'placaL';\r\n}\r\n\r\nfunction sortedPlayers(players, compare, rowCount) {\r\n  return (Array.isArray(players) ? players : [])\r\n    .map((player, index) => ({ player, index }))\r\n    .sort(compare)\r\n    .map((entry) => entry.player)\r\n    .slice(0, rowCount);\r\n}\r\n\r\nfunction setCrest(img, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    img.src = src;\r\n    img.alt = teamName(teamId);\r\n    img.style.visibility = 'visible';\r\n  } else {\r\n    img.removeAttribute('src');\r\n    img.alt = '';\r\n    img.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction rowMarkup(index, ranking) {\r\n  if (ranking) {\r\n    return `\r\n      <div class=\"ov-performance-row ov-performance-row--ranking\" data-row=\"${index}\">\r\n        <div class=\"ov-performance-position\"></div>\r\n        <div class=\"ov-performance-crest-cell\"><img class=\"ov-performance-crest\" data-adjust=\"crest\" alt=\"\" /></div>\r\n        <div class=\"ov-performance-name\"></div>\r\n        <div class=\"ov-performance-primary-stat\"></div>\r\n      </div>\r\n    `;\r\n  }\r\n  return `\r\n    <div class=\"ov-performance-row\" data-row=\"${index}\">\r\n      <div class=\"ov-performance-crest-cell\"><img class=\"ov-performance-crest\" data-adjust=\"crest\" alt=\"\" /></div>\r\n      <div class=\"ov-performance-name\"></div>\r\n      <div class=\"ov-performance-stat\" data-stat=\"0\"></div>\r\n      <div class=\"ov-performance-stat\" data-stat=\"1\"></div>\r\n      <div class=\"ov-performance-stat\" data-stat=\"2\"></div>\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction buildStructure(contentEl, moduleId, position, rowCount) {\r\n  const config = CONFIG[moduleId];\r\n  const imgSrc = resolveImageSrc(moduleId, config.image);\r\n  const ranking = isRankingMode(moduleId);\r\n  contentEl.innerHTML = `\r\n    <div class=\"ov-performance-card ov-performance-card--${moduleId} ov-performance-card--${positionClass(position)}\">\r\n      ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\r\n      <div class=\"gfx-overlay\">\r\n        <div class=\"ov-performance-titulo\"></div>\r\n        <img class=\"ov-performance-titulo-crest\" data-adjust=\"tituloCrest\" alt=\"\" />\r\n        ${Array.from({ length: rowCount }, (_, index) => rowMarkup(index, ranking)).join('')}\r\n      </div>\r\n    </div>\r\n  `;\r\n}\r\n\r\nexport function renderPerformanceTable(moduleId, contentEl, data) {\r\n  const config = CONFIG[moduleId];\r\n  if (!config) throw new Error(`Tabla de rendimiento desconocida: ${moduleId}`);\r\n\r\n  const position = normalizePosition(data.posicion);\r\n  const rowCount = rowCountFor(position);\r\n  // \"isRankingMode(moduleId)\" en la firma (2026-09-02): \"jugadores\" cambia\r\n  // de layout (3 columnas <-> ranking) segun theme -- sin esto, un cambio\r\n  // de theme en caliente con el mismo \"position\"/\"rowCount\" no reconstruia\r\n  // la estructura.\r\n  const signature = `${moduleId}:${position}:${rowCount}:${isRankingMode(moduleId)}`;\r\n  if (contentEl.dataset.signature !== signature) {\r\n    contentEl.dataset.signature = signature;\r\n    buildStructure(contentEl, moduleId, position, rowCount);\r\n  }\r\n\r\n  const ta = data.textAdjust;\r\n  const ranking = isRankingMode(moduleId);\r\n  const nameAdjust = readTextAdjust(ta, 'name');\r\n  const players = sortedPlayers(data.jugadores, config.compare, rowCount);\r\n\r\n  // T\u00CDTULO (2026-09-02, pedido explicito del usuario): configurable por\r\n  // modulo, cae al nombre de broadcast si el operador no escribio nada.\r\n  const tituloEl = contentEl.querySelector('.ov-performance-titulo');\r\n  if (tituloEl) {\r\n    applyPlainTextAdjust(tituloEl, toBroadcastUpper((data.titulo || '').trim() || DEFAULT_TITLE[moduleId] || ''), readTextAdjust(ta, 'titulo'));\r\n  }\r\n\r\n  // ESCUDO T\u00CDTULO (2026-09-04, pedido explicito del usuario): siempre\r\n  // Argentina Streamers MASCULINO, fijo -- no depende del Marcador. Solo\r\n  // Argentina Streamers (GLA nunca muestra esta placa de 10 filas, la caja\r\n  // del titulo queda oculta por CSS para ese theme). Posicion/escala via\r\n  // \"data-adjust=tituloCrest\" + shared/adjust-registry.js (mecanismo\r\n  // generico, mismo patron que el resto de los \"data-adjust\" del archivo).\r\n  const tituloCrestEl = contentEl.querySelector('.ov-performance-titulo-crest');\r\n  if (tituloCrestEl) {\r\n    const src = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID ? crestFile('argentina-streamers') : null;\r\n    if (src) {\r\n      tituloCrestEl.src = src;\r\n      tituloCrestEl.style.visibility = 'visible';\r\n    } else {\r\n      tituloCrestEl.removeAttribute('src');\r\n      tituloCrestEl.style.visibility = 'hidden';\r\n    }\r\n  }\r\n\r\n  // \"placaL-solo\" (2026-09-02, Argentina Streamers, geometria real medida\r\n  // pixel a pixel sobre TABLA_ESTADISTICAS.png -- ver overlay.css): la\r\n  // columna JUGADOR es mucho mas ancha que en el layout viejo de GLA\r\n  // (313px reales contra 154px), asi que el fitted text necesita su\r\n  // propio maxWidth aca. GLA sigue exactamente con los valores de siempre.\r\n  const isArgentinaSolo = ranking && position === 'placaL-solo';\r\n\r\n  for (let index = 0; index < rowCount; index += 1) {\r\n    const row = contentEl.querySelector(`.ov-performance-row[data-row=\"${index}\"]`);\r\n    const player = players[index];\r\n    row.classList.toggle('is-empty', !player);\r\n\r\n    setCrest(row.querySelector('.ov-performance-crest'), player?.teamId);\r\n    applyFittedText(row.querySelector('.ov-performance-name'), player?.nombre || '', withGlaSegoeRegular({\r\n      maxFont: isArgentinaSolo ? 26 : (ranking ? 23 : 24),\r\n      minFont: isArgentinaSolo ? 13 : (ranking ? 11 : 10),\r\n      maxWidth: isArgentinaSolo ? 300 : (ranking ? 154 : 145),\r\n      weight: 800,\r\n    }), nameAdjust);\r\n\r\n    if (ranking) {\r\n      applyPlainTextAdjust(row.querySelector('.ov-performance-position'), player ? String(index + 1) : '', readTextAdjust(ta, 'position'));\r\n      // \"placaL\"/\"placaL-top\"/\"placaL-bottom\" (5-6 filas en media zona\r\n      // vertical): fuente grande, igual que siempre.\r\n      const isHalfColumn = position === 'placaL' || position === 'placaL-top' || position === 'placaL-bottom';\r\n      applyFittedText(row.querySelector('.ov-performance-primary-stat'), player ? String(config.value(player)) : '', withGlaSegoeRegular({\r\n        maxFont: isArgentinaSolo ? 28 : (isHalfColumn ? 30 : 25),\r\n        minFont: isArgentinaSolo ? 15 : (isHalfColumn ? 17 : 14),\r\n        maxWidth: isArgentinaSolo ? 44 : 44,\r\n        weight: 900,\r\n      }), readTextAdjust(ta, 'primaryStat'));\r\n      continue;\r\n    }\r\n\r\n    const values = player ? config.values(player) : ['', '', ''];\r\n    for (let statIndex = 0; statIndex < 3; statIndex += 1) {\r\n      applyFittedText(row.querySelector(`.ov-performance-stat[data-stat=\"${statIndex}\"]`), String(values[statIndex]), withGlaSegoeRegular({\r\n        maxFont: 23, minFont: 12, maxWidth: statIndex === 2 ? 35 : 29, weight: 900,\r\n      }), readTextAdjust(ta, `stat${statIndex}`));\r\n    }\r\n  }\r\n}\r\n\r\nexport const goleadores = (contentEl, data) => renderPerformanceTable('goleadores', contentEl, data);\r\nexport const asistidores = (contentEl, data) => renderPerformanceTable('asistidores', contentEl, data);\r\nexport const jugadores = (contentEl, data) => renderPerformanceTable('jugadores', contentEl, data);\r\n","http://127.0.0.1:4430/program/js/renderers/fichaJugador.js","// FICHA JUGADOR (BLOQUE 4, 2026-09-09, reconstruido sobre el PNG real --\n// ver assets/themes/argentina-streamers/tablas/ficha-jugador.png). El\n// modulo ya no mantiene su propia lista de jugadores (ver shared/modules.js):\n// lee directo \"data.nombre/goles/asistencias/presencias/mvps\" -- una copia\n// sincronizada del jugador elegido en el plantel central (server/\n// playerRosters.js), escrita por master-control/js/ficha-jugador-panel.js\n// al elegir jugador o al sincronizar desde la web. Program NUNCA consulta\n// la web ni el plantel central directo: solo pinta lo que ya le llego por\n// WebSocket, igual criterio que el resto del proyecto (Estrellas,\n// Goleadores, etc.).\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\nimport { resolveImageSrc } from '../theme-assets.js';\n\n// Coordenadas medidas en vivo (canvas 2D, scan real de pixeles del PNG a\n// 1920x1080 -- ver informe entregado al usuario, BLOQUE 4 secci\u00F3n 2): el\n// dise\u00F1o real NO tiene recuadro de escudo, solo z\u00F3calo superior (nombre) +\n// 4 recuadros de estad\u00EDstica en una columna vertical derecha. Los labels\n// (\"GOLES\"/\"ASISTENCIAS\"/\"PRESENCIAS\"/\"MVPS\") ya est\u00E1n horneados en el\n// PNG -- estos 4 recuadros son SOLO para el valor numerico.\nconst NOMBRE_BOX = { left: 1501, top: 37, width: 317, height: 75 };\nconst STAT_BOXES = {\n  goles: { left: 1618, top: 179, width: 169, height: 141 },\n  asistencias: { left: 1618, top: 378, width: 169, height: 142 },\n  presencias: { left: 1618, top: 578, width: 169, height: 142 },\n  mvps: { left: 1618, top: 778, width: 169, height: 163 },\n};\n\nfunction boxStyle(box) {\n  return `position:absolute; left:${box.left}px; top:${box.top}px; width:${box.width}px; height:${box.height}px; display:flex; align-items:center; justify-content:center;`;\n}\n\nfunction buildStructure(contentEl) {\n  const imgSrc = resolveImageSrc('fichaJugador');\n  contentEl.innerHTML = `\n    <div class=\"ov-ficha-card\">\n      ${imgSrc ? `<img class=\"gfx-bg-image\" src=\"${imgSrc}\" />` : ''}\n      <div class=\"gfx-overlay\">\n        <div class=\"ov-ficha-nombre\" style=\"${boxStyle(NOMBRE_BOX)}\"></div>\n        ${Object.entries(STAT_BOXES).map(([key, box]) => `\n          <div class=\"ov-ficha-stat-value\" data-stat=\"${key}\" style=\"${boxStyle(box)}\"></div>\n        `).join('')}\n      </div>\n    </div>\n  `;\n  contentEl._gfxBuilt = true;\n}\n\n// \"xDisponible === false\" (pedido explicito, secci\u00F3n 7: \"nunca inventar\n// una estad\u00EDstica... mostrar claramente que no est\u00E1 disponible\") se\n// muestra como \"\u2014\" en vez de \"0\": un cero real (la web confirm\u00F3 0) y un\n// dato nunca informado por la web son cosas distintas, no se pueden pintar\n// igual.\nfunction statText(data, key, disponibleKey) {\n  if (data[disponibleKey] === false) return '\u2014';\n  const value = Number(data[key]);\n  return Number.isFinite(value) ? String(value) : '0';\n}\n\nexport default function renderFichaJugador(contentEl, data, justTaken) {\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\n\n  const ta = data.textAdjust;\n\n  // \"updateFittedTextWithTransition\" (2026-09-10, pedido explicito del\n  // usuario: fade en vez de corte duro en ACTUALIZAR) -- Ficha Jugador no\n  // es un modulo LIVE, su contenido solo cambia via TAKE/ACTUALIZAR (elegir\n  // jugador o sincronizar datos de la web).\n  const nombre = data.nombre || '';\n  updateFittedTextWithTransition(contentEl.querySelector('.ov-ficha-nombre'), nombre, contentEl._prevNombre, {\n    maxFont: 30, minFont: 14, maxWidth: NOMBRE_BOX.width - 24, weight: 800,\n  }, readTextAdjust(ta, 'nombre'), !justTaken);\n  contentEl._prevNombre = nombre;\n\n  const statMap = {\n    goles: 'golesDisponible',\n    asistencias: 'asistenciasDisponible',\n    presencias: 'presenciasDisponible',\n    mvps: 'mvpsDisponible',\n  };\n  if (!contentEl._prevStats) contentEl._prevStats = {};\n  for (const [key, disponibleKey] of Object.entries(statMap)) {\n    const el = contentEl.querySelector(`.ov-ficha-stat-value[data-stat=\"${key}\"]`);\n    const box = STAT_BOXES[key];\n    const text = statText(data, key, disponibleKey);\n    updateFittedTextWithTransition(el, text, contentEl._prevStats[key], {\n      maxFont: 44, minFont: 18, maxWidth: box.width - 20, weight: 900,\n    }, readTextAdjust(ta, key), !justTaken);\n    contentEl._prevStats[key] = text;\n  }\n}\n","http://127.0.0.1:4430/program/js/renderers/cronogramaHoy.js","import { resolveImageSrc } from '../theme-assets.js';\nimport { crestFile, teamName } from '../../../shared/teams.js';\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\n\n// Geometria real medida pixel a pixel (2026-09-02, ver informe) sobre\n// assets/themes/argentina-streamers/brackets/cronograma-hoy.png (VS_DEFAULT\n// entregado por el usuario, nativo 962x541, escalado ~x1.9958/x1.9963 para\n// proyectarlo sobre el stage logico 1920x1080). Reemplaza por completo la\n// tarjeta fabricada en CSS que habia antes (pedido explicito: \"descartes\n// la geometr\u00EDa/propuesta anterior\"). Mismo header que Historial/Tabla\n// Estadisticas (mismo template de PNG).\nconst HEADER_LEFT = 1487;\nconst HEADER_TOP = 28;\nconst HEADER_WIDTH = 415;\nconst HEADER_HEIGHT = 64;\n\nconst CREST_CENTER_X = 1696;\nconst CREST_LOCAL_CENTER_Y = 276;\nconst CREST_VISITANTE_CENTER_Y = 771;\nconst CREST_SIZE = 140;\n\nfunction setCrest(imgEl, teamId, adjust) {\n  if (!imgEl) return;\n  const src = crestFile(teamId);\n  if (src) {\n    imgEl.src = src;\n    imgEl.alt = teamName(teamId) || teamId;\n    imgEl.style.visibility = 'visible';\n  } else {\n    imgEl.removeAttribute('src');\n    imgEl.alt = '';\n    imgEl.style.visibility = 'hidden';\n  }\n  const dx = adjust?.offsetX || 0;\n  const dy = adjust?.offsetY || 0;\n  const sc = adjust?.scale !== undefined ? adjust.scale : 1;\n  imgEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\n}\n\nfunction buildStructure(el) {\n  el.innerHTML = `\n    <img class=\"ov-crono-bg\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px;\" />\n    <div class=\"gfx-overlay\">\n      <div class=\"ov-crono-titulo\"\n        style=\"position:absolute; left:${HEADER_LEFT}px; top:${HEADER_TOP}px; width:${HEADER_WIDTH}px; height:${HEADER_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:1px; color:#ffffff; font-size:24px;\"></div>\n      <img class=\"ov-crono-crest ov-crono-crest-local\"\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_LOCAL_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n      <img class=\"ov-crono-crest ov-crono-crest-visitante\"\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_VISITANTE_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n    </div>\n  `;\n  el._gfxBuilt = true;\n}\n\n// Seleccion MANUAL de equipo (2026-09-04, cambio explicito del usuario:\n// \"quiero poder armar manualmente un enfrentamiento\" -- reemplaza la\n// herencia automatica del Marcador que tenia antes). \"data.teamLocal\"/\n// \"data.teamVisitante\" los elige el operador en el panel dedicado\n// (master-control/js/cronograma-hoy-panel.js), catalogo Argentina\n// Streamers -- ya no se lee \"allData.scoreboard\" aca.\nexport default function renderCronogramaHoy(contentEl, data, justTaken, onOneShotEnded, allData) {\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\n\n  const bgImg = contentEl.querySelector('.ov-crono-bg');\n  if (!bgImg) return; // OUT/TAKE muy rapidos: mismo guard que resultadosParciales.js/historial.js (ver ahi el porque)\n  const imageSrc = resolveImageSrc('cronogramaHoy', null);\n  if (imageSrc) {\n    bgImg.src = imageSrc;\n    bgImg.style.display = 'block';\n  } else {\n    bgImg.removeAttribute('src');\n    bgImg.style.display = 'none';\n  }\n\n  applyPlainTextAdjust(contentEl.querySelector('.ov-crono-titulo'), data.titulo || '', readTextAdjust(data.textAdjust, 'titulo'));\n\n  const teamA = data.teamLocal || '';\n  const teamB = data.teamVisitante || '';\n\n  const localAdjust = data.crestByTeam?.local?.[teamA] || {};\n  const awayAdjust = data.crestByTeam?.away?.[teamB] || {};\n\n  setCrest(contentEl.querySelector('.ov-crono-crest-local'), teamA, {\n    offsetX: localAdjust.crestLocalOffsetX || 0,\n    offsetY: localAdjust.crestLocalOffsetY || 0,\n    scale: localAdjust.crestLocalScale,\n  });\n  setCrest(contentEl.querySelector('.ov-crono-crest-visitante'), teamB, {\n    offsetX: awayAdjust.crestVisitanteOffsetX || 0,\n    offsetY: awayAdjust.crestVisitanteOffsetY || 0,\n    scale: awayAdjust.crestVisitanteScale,\n  });\n}\n","http://127.0.0.1:4430/program/js/renderers/resultadosParciales.js","import { resolveImageSrc } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { applyFittedText, applyPlainTextAdjust, readTextAdjust, toBroadcastUpper } from '../text-fit.js';\r\n\r\n// Reconstruido desde cero (2026-09-03, correcci\u00F3n expl\u00EDcita del usuario):\r\n// la version anterior (tarjeta fabricada en CSS, sin PNG real, 2\r\n// encuentros manuales) se descarto por completo. PNG real entregado en\r\n// \"cosas sueltas/PSD/vs_resultado.psd\" -- geometria medida pixel a pixel\r\n// (canvas + scan de color, nativo 962x541, escalado x1.99584/x1.99630\r\n// para proyectarlo sobre el stage logico 1920x1080). Mismo template de\r\n// header que Historial/Cronograma Hoy/Tabla Estadisticas.\r\n//\r\n// Confirmado explicitamente con el usuario (AskUserQuestion): un solo\r\n// partido -- escudo local/visitante + resultado, heredados en vivo del\r\n// Marcador (allData.scoreboard), mismo criterio que \"cronogramaHoy\"\r\n// (sin selector de equipo propio) y \"vsResultado\" (mismo asset, mismos\r\n// cuadritos blancos de resultado). \"data.encuentros\" (2 partidos\r\n// manuales) NO se borra del schema (shared/modules.js) pero este\r\n// renderer ya no lo usa.\r\nconst HEADER_LEFT = 1487;\r\nconst HEADER_TOP = 28;\r\nconst HEADER_WIDTH = 415;\r\nconst HEADER_HEIGHT = 64;\r\n\r\n// Escudo: centro X compartido por local/visitante (misma columna),\r\n// centro Y propio de cada uno -- medido sobre la porcion de escudo SIN\r\n// superponer el cuadrito de resultado (que ocupa la parte inferior del\r\n// escudo local / superior del escudo visitante). Tama\u00F1o 140px, mismo\r\n// criterio ya validado visualmente en Program para vsResultado/\r\n// cronogramaHoy (comparten esta columna/geometria de escudo).\r\nconst CREST_CENTER_X = 1696;\r\nconst CREST_LOCAL_CENTER_Y = 276;\r\nconst CREST_VISITANTE_CENTER_Y = 771;\r\nconst CREST_SIZE = 140;\r\n\r\n// Cuadrito blanco de resultado: nativo x819-879 (60px), y170-229 (local,\r\n// parte inferior del escudo de arriba) / y289-348 (visitante, parte\r\n// superior del escudo de abajo) -- medido con scan de color real sobre\r\n// el PNG (longest-run de pixeles gris/blanco neutros, sin contaminacion\r\n// del borde blanco decorativo del escudo). Caja de texto con margen de\r\n// seguridad hacia adentro del cuadrito real (mismo criterio que el resto\r\n// del proyecto: nunca tocar el borde), igual a la ya validada en\r\n// vsResultado (mismo asset).\r\nconst SCORE_LEFT = 1646;\r\nconst SCORE_WIDTH = 100;\r\nconst SCORE_HEIGHT = 80;\r\nconst SCORE_LOCAL_TOP = 357;\r\nconst SCORE_VISITANTE_TOP = 595;\r\n\r\nconst SCORE_MAX_FONT = 58;\r\nconst SCORE_MIN_FONT = 30;\r\nconst SCORE_MAX_WIDTH = SCORE_WIDTH - 36;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  if (!imgEl) return;\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId) || teamId;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <img class=\"ov-resparc-bg\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px;\" />\r\n    <div class=\"gfx-overlay\">\r\n      <div class=\"ov-resparc-titulo\"\r\n        style=\"position:absolute; left:${HEADER_LEFT}px; top:${HEADER_TOP}px; width:${HEADER_WIDTH}px; height:${HEADER_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:1px; color:#ffffff; font-size:24px;\"></div>\r\n      <img class=\"ov-resparc-crest ov-resparc-crest-local\" data-adjust=\"localCrest\"\r\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_LOCAL_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\r\n      <img class=\"ov-resparc-crest ov-resparc-crest-visitante\" data-adjust=\"awayCrest\"\r\n        style=\"position:absolute; left:${CREST_CENTER_X - CREST_SIZE / 2}px; top:${CREST_VISITANTE_CENTER_Y - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\r\n      <div class=\"ov-resparc-score ov-resparc-score-local\"\r\n        style=\"position:absolute; left:${SCORE_LEFT}px; top:${SCORE_LOCAL_TOP}px; width:${SCORE_WIDTH}px; height:${SCORE_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#0a0a0c;\"></div>\r\n      <div class=\"ov-resparc-score ov-resparc-score-visitante\"\r\n        style=\"position:absolute; left:${SCORE_LEFT}px; top:${SCORE_VISITANTE_TOP}px; width:${SCORE_WIDTH}px; height:${SCORE_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#0a0a0c;\"></div>\r\n    </div>\r\n  `;\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderResultadosParciales(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n\r\n  const bgImg = contentEl.querySelector('.ov-resparc-bg');\r\n  if (!bgImg) return; // OUT/TAKE muy rapidos: un tick tardio del ticker (setInterval de 500ms, program/js/main.js) puede llegar a correr contra un contentEl recien vaciado por teardownContent -- ver mismo guard en cronogramaHoy.js/historial.js\r\n  const imageSrc = resolveImageSrc('resultadosParciales', null);\r\n  if (imageSrc) {\r\n    bgImg.src = imageSrc;\r\n    bgImg.style.display = 'block';\r\n  } else {\r\n    bgImg.removeAttribute('src');\r\n    bgImg.style.display = 'none';\r\n  }\r\n\r\n  const ta = data.textAdjust;\r\n  applyPlainTextAdjust(\r\n    contentEl.querySelector('.ov-resparc-titulo'),\r\n    toBroadcastUpper((data.titulo || '').trim() || 'RESULTADOS PARCIALES'),\r\n    readTextAdjust(ta, 'titulo'),\r\n  );\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  setCrest(contentEl.querySelector('.ov-resparc-crest-local'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-resparc-crest-visitante'), sb.teamB);\r\n\r\n  applyFittedText(contentEl.querySelector('.ov-resparc-score-local'), String(sb.scoreA ?? ''), {\r\n    maxFont: SCORE_MAX_FONT, minFont: SCORE_MIN_FONT, maxWidth: SCORE_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'scoreLocal'));\r\n  applyFittedText(contentEl.querySelector('.ov-resparc-score-visitante'), String(sb.scoreB ?? ''), {\r\n    maxFont: SCORE_MAX_FONT, minFont: SCORE_MIN_FONT, maxWidth: SCORE_MAX_WIDTH, weight: 900,\r\n  }, readTextAdjust(ta, 'scoreVisitante'));\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/historial.js","import { resolveImageSrc } from '../theme-assets.js';\nimport { crestFile, teamName } from '../../../shared/teams.js';\nimport { applyPlainTextAdjust, readTextAdjust } from '../text-fit.js';\nimport { getActiveThemeId } from '../theme-client.js';\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\n\n// Geometria real medida pixel a pixel (2026-09-02, ver informe) sobre\n// assets/themes/argentina-streamers/tablas/historial.png (nativo 962x541,\n// escalado x1.9958/x1.9963 -- muy cerca de 2x, redondeado a enteros -- para\n// proyectarlo sobre el stage logico 1920x1080). \"No adivinar geometria por\n// el nombre\" -- el PNG tiene un header + 5 filas identicas, cada una\n// [escudo local][caja VS][escudo visitante], separadas 163.7px entre si.\nconst ROW_COUNT = 5;\nconst ROW_CENTERS_Y = [174.7, 338.4, 502.1, 665.8, 829.5];\nconst CREST_L_CENTER_X = 1548;\nconst CREST_R_CENTER_X = 1843;\nconst CREST_SIZE = 80;\nconst GOL_LOCAL_LEFT = 1607;\nconst GOL_VISITANTE_LEFT = 1707;\nconst GOL_WIDTH = 80;\nconst GOL_HEIGHT = 70;\n// Penales (2026-09-04, pedido explicito del usuario): \"no quiero que el\n// score principal se mueva de lugar\" -- bloque NUEVO e independiente,\n// mismo left/width que su gol (centrado respecto al numero principal),\n// pegado justo debajo. Chico a proposito (\"no construir un bloque\n// enorme\"): PEN_HEIGHT/tama\u00F1o de fuente bien menores que el gol (70px alto\n// / 40px fuente arriba).\nconst PEN_WIDTH = GOL_WIDTH;\nconst PEN_HEIGHT = 24;\nconst PEN_TOP_OFFSET = 22; // desde el centro de fila (cy), no desde el gol\nconst HEADER_LEFT = 1487;\nconst HEADER_TOP = 28;\nconst HEADER_WIDTH = 415;\nconst HEADER_HEIGHT = 64;\n// Escudo del titulo (2026-09-04, pedido explicito del usuario, item 7):\n// nunca habia existido para este modulo -- mismo criterio \"a la\n// izquierda del titulo\" que goleadores/asistidores/jugadores, tama\u00F1o\n// chico por default, 100% ajustable via GUARDAR POSICI\u00D3N.\nconst TITULO_CREST_LEFT = HEADER_LEFT - 50;\nconst TITULO_CREST_TOP = HEADER_TOP + (HEADER_HEIGHT - 40) / 2;\nconst TITULO_CREST_SIZE = 40;\n// FASE/INSTANCIA (2026-09-04, pedido explicito del usuario, item 2-3):\n// rotulo chico por fila, arriba de la caja del partido, ancho = escudo\n// local a escudo visitante -- \"no modificar la geometria actual ni\n// desacomodar escudos/goles/penales\" (bloque nuevo e independiente, igual\n// criterio que penales).\nconst FASE_LEFT = CREST_L_CENTER_X - CREST_SIZE / 2;\nconst FASE_WIDTH = (CREST_R_CENTER_X + CREST_SIZE / 2) - FASE_LEFT;\nconst FASE_HEIGHT = 18;\nconst FASE_TOP_OFFSET = -58; // desde el centro de fila (cy)\n\n// RESULTADO NORMAL / CON PENALES / PENALES fino (2026-09-04, pedido\n// explicito del usuario: \"eliminar la edicion independiente GOL LOCAL/GOL\n// VISITANTE... los dos goles deben moverse juntos\", con geometria\n// COMPLETAMENTE separada segun si la fila tiene penales o no -- mover\n// \"RESULTADO CON PENALES\" nunca puede tocar una fila sin penales, y\n// viceversa). \"BASE_ADJUST\" (item 10: \"preservar las posiciones actuales\n// como baseline, la nueva arquitectura tiene que empezar visualmente\n// igual\") hornea los offsets que YA estaban guardados en las columnas\n// viejas (\"textAdjust.golLocal/golVisitante/penalLocal/penalVisitante\",\n// commiteados en shared/theme-layouts/argentinaStreamers.json antes de\n// este cambio) como base FIJA por elemento -- los 3 campos nuevos\n// (data.resultadoNormal/resultadoConPenales/penalesFino) arrancan en\n// 0/0/0 y se SUMAN encima, asi el resultado total es identico a como\n// estaba, sin perder el trabajo de ajuste fino ya hecho.\nconst GOL_LOCAL_BASE_ADJUST = { dx: -6, dy: 0, dSize: 14 };\nconst GOL_VISITANTE_BASE_ADJUST = { dx: -2, dy: 0, dSize: 14 };\nconst PEN_LOCAL_BASE_ADJUST = { dx: -4, dy: -8, dSize: 0 };\nconst PEN_VISITANTE_BASE_ADJUST = { dx: 0, dy: -8, dSize: 0 };\n\nfunction sumAdjust(...adjusts) {\n  return adjusts.reduce((acc, a) => ({\n    dx: acc.dx + (a?.dx || 0),\n    dy: acc.dy + (a?.dy || 0),\n    dSize: acc.dSize + (a?.dSize || 0),\n  }), { dx: 0, dy: 0, dSize: 0 });\n}\n\n// Sin ajuste manual aca a proposito: \"data-adjust=crestLocal/crestVisitante\"\n// (ver buildStructure) ya lo resuelve el mecanismo generico\n// (applyElementAdjustRegistry en program/js/main.js, corre para CUALQUIER\n// modulo con entradas kind:'composition' en su registro) -- mismo criterio\n// que \".ov-pen-crest\" en marcadorPenales.js, sin duplicar la logica aca.\n// \"fallbackSrc\" (2026-09-04, pedido explicito del usuario): escudo de un\n// RIVAL HISTORICO sin equipo en el catalogo local (Colombia/Malasia/etc --\n// ver server/argentinaStreamersClient.js), resuelto por la sincro web y\n// guardado en \"partido.teamBCrestUrl\". Un teamId real del catalogo local\n// SIEMPRE tiene prioridad (elegido a mano por el operador o coincidencia\n// real con el catalogo) -- el fallback solo se usa cuando \"teamId\" no\n// resuelve ningun escudo.\nfunction setCrest(imgEl, teamId, fallbackSrc) {\n  if (!imgEl) return;\n  const src = crestFile(teamId) || fallbackSrc || null;\n  if (src) {\n    imgEl.src = src;\n    imgEl.alt = teamName(teamId) || teamId || '';\n    imgEl.style.visibility = 'visible';\n  } else {\n    imgEl.removeAttribute('src');\n    imgEl.alt = '';\n    imgEl.style.visibility = 'hidden';\n  }\n}\n\nfunction buildStructure(el) {\n  let rowsHtml = '';\n  for (let i = 0; i < ROW_COUNT; i++) {\n    const cy = ROW_CENTERS_Y[i];\n    rowsHtml += `\n      <img class=\"ov-historial-crest ov-historial-crest-local\" data-adjust=\"crestLocal\"\n        style=\"position:absolute; left:${CREST_L_CENTER_X - CREST_SIZE / 2}px; top:${cy - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n      <div class=\"ov-historial-gol ov-historial-gol-local\"\n        style=\"position:absolute; left:${GOL_LOCAL_LEFT}px; top:${cy - GOL_HEIGHT / 2}px; width:${GOL_WIDTH}px; height:${GOL_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#ffffff; line-height:1;\"></div>\n      <div class=\"ov-historial-gol ov-historial-gol-visitante\"\n        style=\"position:absolute; left:${GOL_VISITANTE_LEFT}px; top:${cy - GOL_HEIGHT / 2}px; width:${GOL_WIDTH}px; height:${GOL_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:900; color:#ffffff; line-height:1;\"></div>\n      <div class=\"ov-historial-pen ov-historial-pen-local\"\n        style=\"position:absolute; left:${GOL_LOCAL_LEFT}px; top:${cy + PEN_TOP_OFFSET}px; width:${PEN_WIDTH}px; height:${PEN_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.78); line-height:1; white-space:nowrap;\"></div>\n      <div class=\"ov-historial-pen ov-historial-pen-visitante\"\n        style=\"position:absolute; left:${GOL_VISITANTE_LEFT}px; top:${cy + PEN_TOP_OFFSET}px; width:${PEN_WIDTH}px; height:${PEN_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; color:rgba(255,255,255,0.78); line-height:1; white-space:nowrap;\"></div>\n      <img class=\"ov-historial-crest ov-historial-crest-visitante\" data-adjust=\"crestVisitante\"\n        style=\"position:absolute; left:${CREST_R_CENTER_X - CREST_SIZE / 2}px; top:${cy - CREST_SIZE / 2}px; width:${CREST_SIZE}px; height:${CREST_SIZE}px; object-fit:contain;\" />\n      <div class=\"ov-historial-fase\"\n        style=\"position:absolute; left:${FASE_LEFT}px; top:${cy + FASE_TOP_OFFSET}px; width:${FASE_WIDTH}px; height:${FASE_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:700; letter-spacing:0.5px; color:rgba(255,255,255,0.6); line-height:1; white-space:nowrap; overflow:hidden;\"></div>\n    `;\n  }\n\n  el.innerHTML = `\n    <img class=\"ov-historial-bg\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px; display:none;\" />\n    <div class=\"gfx-overlay\">\n      <div class=\"ov-historial-titulo\"\n        style=\"position:absolute; left:${HEADER_LEFT}px; top:${HEADER_TOP}px; width:${HEADER_WIDTH}px; height:${HEADER_HEIGHT}px; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-weight:800; text-transform:uppercase; letter-spacing:1px; color:#ffffff; font-size:26px;\"></div>\n      <img class=\"ov-historial-titulo-crest\" data-adjust=\"tituloCrest\" alt=\"\"\n        style=\"position:absolute; left:${TITULO_CREST_LEFT}px; top:${TITULO_CREST_TOP}px; width:${TITULO_CREST_SIZE}px; height:${TITULO_CREST_SIZE}px; object-fit:contain;\" />\n      ${rowsHtml}\n    </div>\n  `;\n  el._gfxBuilt = true;\n}\n\nexport default function renderHistorial(contentEl, data, justTaken) {\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\n\n  const bgImg = contentEl.querySelector('.ov-historial-bg');\n  if (!bgImg) return; // OUT/TAKE muy rapidos: mismo guard que resultadosParciales.js/cronogramaHoy.js (ver ahi el porque)\n  const imageSrc = resolveImageSrc('historial', null);\n  if (imageSrc) {\n    bgImg.src = imageSrc;\n    bgImg.style.display = 'block';\n  } else {\n    bgImg.removeAttribute('src');\n    bgImg.style.display = 'none';\n  }\n\n  const ta = data.textAdjust;\n  // \"titulo\" (2026-09-02/09-04, pedido explicito del usuario): el TEXTO\n  // sigue siendo manual (cae a \"HISTORIAL\" si el operador no escribio\n  // nada; master-control/js/historial-panel.js lo autocompleta con\n  // \"HISTORIAL - <CATEGORIA>\" al apretar ACTUALIZAR DATOS DE LA WEB). La\n  // POSICI\u00D3N/ESCALA ahora es INDEPENDIENTE por categoria (item 5 del\n  // pedido: \"HISTORIAL - IWC\" es mucho mas corto que \"HISTORIAL -\n  // AMISTOSOS OFICIALES\") -- \"data.tituloByCategoria[tipoHistorial]\" en\n  // vez del unico \"textAdjust.titulo\" de siempre; ver el control dedicado\n  // (mismo componente generico, renderTextAdjustControl) en\n  // historial-panel.js.\n  const tituloAdjust = (data.tituloByCategoria && data.tituloByCategoria[data.tipoHistorial]) || { dx: 0, dy: 0, dSize: 0 };\n  applyPlainTextAdjust(contentEl.querySelector('.ov-historial-titulo'), (data.titulo || '').trim() || 'HISTORIAL', tituloAdjust);\n\n  // ESCUDO T\u00CDTULO (2026-09-04, pedido explicito del usuario, item 7):\n  // siempre Argentina Streamers MASCULINO fijo -- mismo criterio que\n  // goleadores/asistidores/jugadores (program/js/renderers/\n  // performanceTable.js), no depende del Marcador. Solo Argentina\n  // Streamers.\n  const tituloCrestEl = contentEl.querySelector('.ov-historial-titulo-crest');\n  if (tituloCrestEl) {\n    const crestSrc = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID ? crestFile('argentina-streamers') : null;\n    if (crestSrc) {\n      tituloCrestEl.src = crestSrc;\n      tituloCrestEl.style.visibility = 'visible';\n    } else {\n      tituloCrestEl.removeAttribute('src');\n      tituloCrestEl.style.visibility = 'hidden';\n    }\n  }\n\n  const faseAdjust = readTextAdjust(ta, 'fase');\n  // Bloques (2026-09-04, pedido explicito): \"resultadoNormal\"/\n  // \"resultadoConPenales\"/\"penalesFino\" viven en el nivel superior de\n  // \"data\" (no en \"textAdjust\" -- no son un ajuste por columna, son un\n  // ajuste de BLOQUE que se aplica condicionalmente por fila, ver el loop\n  // de abajo). Control dedicado en master-control/js/historial-panel.js.\n  const zero = { dx: 0, dy: 0, dSize: 0 };\n  const resultadoNormal = data.resultadoNormal || zero;\n  const resultadoConPenales = data.resultadoConPenales || zero;\n  const penalesFino = data.penalesFino || zero;\n\n  const partidos = Array.isArray(data.partidos) ? data.partidos : [];\n  const crestsLocal = contentEl.querySelectorAll('.ov-historial-crest-local');\n  const crestsVisitante = contentEl.querySelectorAll('.ov-historial-crest-visitante');\n  const golesLocal = contentEl.querySelectorAll('.ov-historial-gol-local');\n  const golesVisitante = contentEl.querySelectorAll('.ov-historial-gol-visitante');\n  const penalesLocal = contentEl.querySelectorAll('.ov-historial-pen-local');\n  const penalesVisitante = contentEl.querySelectorAll('.ov-historial-pen-visitante');\n  const fases = contentEl.querySelectorAll('.ov-historial-fase');\n\n  for (let i = 0; i < ROW_COUNT; i++) {\n    const partido = partidos[i] || {};\n    setCrest(crestsLocal[i], partido.teamA);\n    setCrest(crestsVisitante[i], partido.teamB, partido.teamBCrestUrl);\n    // Tama\u00F1os CON/SIN penales (2026-09-04, pedido explicito del usuario):\n    // \"SIN penales, mantener EXACTAMENTE el tama\u00F1o actual\" -- la base real\n    // vive en CSS (\".ov-historial-gol\"/\".ov-historial-gol.has-penales\",\n    // ver overlay.css), esta funcion solo prende/apaga la clase. Se borra\n    // \"dataset.baseFontSize\" al tocar la clase para que, si el operador\n    // tiene un \"dSize\" propio guardado (GUARDAR POSICI\u00D3N de la columna\n    // GOL), \"applyPlainTextAdjust\" vuelva a leer el tama\u00F1o base REAL (el\n    // que corresponde ahora, no uno viejo cacheado de antes del cambio de\n    // clase -- ver su implementacion en program/js/text-fit.js).\n    const hasPenales = Boolean(partido.penalLocal || partido.penalVisitante);\n    for (const golEl of [golesLocal[i], golesVisitante[i]]) {\n      if (golEl.classList.contains('has-penales') !== hasPenales) {\n        golEl.classList.toggle('has-penales', hasPenales);\n        delete golEl.dataset.baseFontSize;\n      }\n    }\n    // \"RESULTADO NORMAL\" vs \"RESULTADO CON PENALES\" (2026-09-04, pedido\n    // explicito): geometria COMPLETAMENTE separada segun \"hasPenales\" de\n    // ESTA fila puntual -- una fila sin penales SIEMPRE usa\n    // \"resultadoNormal\" (nunca se mueve si el operador ajusta\n    // \"resultadoConPenales\", y viceversa). Cada gol ademas suma su propia\n    // base fija migrada (GOL_LOCAL_BASE_ADJUST/GOL_VISITANTE_BASE_ADJUST)\n    // para preservar el look actual sin tocarlo.\n    const scoreGroupAdjust = hasPenales ? resultadoConPenales : resultadoNormal;\n    applyPlainTextAdjust(golesLocal[i], partido.golLocal || '', sumAdjust(GOL_LOCAL_BASE_ADJUST, scoreGroupAdjust));\n    applyPlainTextAdjust(golesVisitante[i], partido.golVisitante || '', sumAdjust(GOL_VISITANTE_BASE_ADJUST, scoreGroupAdjust));\n    // Penales (2026-09-04, pedido explicito): SOLO si el partido se\n    // definio por penales de verdad (dato real de la web, nunca inferido\n    // por empate -- ver server/argentinaStreamersSync.js). Vacio = no\n    // dibuja nada, sin \"(0)\" ni placeholder. La segunda linea hereda el\n    // movimiento de \"resultadoConPenales\" (viaja PEGADA al bloque\n    // reglamentario) mas su propio ajuste fino \"penalesFino\" encima\n    // (mueve SOLO la segunda linea, relativa al score) -- en filas sin\n    // penales esto no importa, el texto queda vacio de cualquier forma.\n    const penGroupAdjust = sumAdjust(resultadoConPenales, penalesFino);\n    applyPlainTextAdjust(penalesLocal[i], partido.penalLocal ? `(${partido.penalLocal})` : '', sumAdjust(PEN_LOCAL_BASE_ADJUST, penGroupAdjust));\n    applyPlainTextAdjust(penalesVisitante[i], partido.penalVisitante ? `(${partido.penalVisitante})` : '', sumAdjust(PEN_VISITANTE_BASE_ADJUST, penGroupAdjust));\n    // Fase/instancia (2026-09-04, pedido explicito): dato real de la web\n    // (\"stage\" -- ver server/argentinaStreamersSync.js), vacio si la web\n    // no la publico para ese partido. Nunca inventado por posicion.\n    applyPlainTextAdjust(fases[i], partido.fase || '', faseAdjust);\n  }\n}\n","http://127.0.0.1:4430/program/js/renderers/zocaloFinalDiv.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('zocaloFinalDiv', 'principal');\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\nconst TEXTO2_LETTER_SPACING = 0.5;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el) {\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-local\" alt=\"\" />\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-visitante\" alt=\"\" />\r\n      <div class=\"ov-zfd-texto ov-zfd-texto1\"></div>\r\n      <div class=\"ov-zfd-texto ov-zfd-texto2\"></div>\r\n      <div class=\"ov-zfd-sponsor-box\">\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-1\" alt=\"\" />\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-2\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloFinalDiv', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloFinalDiv(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  const fuente = data.escudosFuente || 'MARCADOR';\r\n  const teamA = fuente === 'PERSONALIZADO' ? (data.customTeamA || '') : (sb.teamA || '');\r\n  const teamB = fuente === 'PERSONALIZADO' ? (data.customTeamB || '') : (sb.teamB || '');\r\n\r\n  setCrest(contentEl.querySelector('.ov-zfd-crest-local'), teamA);\r\n  setCrest(contentEl.querySelector('.ov-zfd-crest-visitante'), teamB);\r\n\r\n  const texto1El = contentEl.querySelector('.ov-zfd-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zfd-texto2');\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n  const oldT1 = contentEl._prevTexto1;\r\n  const oldT2 = contentEl._prevTexto2;\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, oldT1, {\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, oldT2, {\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH,\r\n    weight: 400, letterSpacing: TEXTO2_LETTER_SPACING,\r\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Rotation logic for sponsors in the empty right black box\r\n  const img1 = contentEl.querySelector('.ov-zfd-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zfd-sponsor-2');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      img1.className = 'ov-zfd-sponsor-img';\r\n      img2.className = 'ov-zfd-sponsor-img';\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      img1.className = 'ov-zfd-sponsor-img active';\r\n      img2.className = 'ov-zfd-sponsor-img';\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    activeImg.className = 'ov-zfd-sponsor-img exit';\r\n    inactiveImg.className = 'ov-zfd-sponsor-img active';\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.className.includes('exit')) {\r\n        prevImg.className = 'ov-zfd-sponsor-img';\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || contentEl._lastSponsorsSignature !== listSignature) {\r\n    // Clear previous timer if exists\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/zocaloFinal.js","import { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { applyFittedText, updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\n\r\nconst VIDEO_SRC = glaAssetPath('zocaloFinal', 'principal');\r\nconst LOGO_SRC = glaAssetPath('zocaloFinal', 'logoImagen');\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\nconst TEXTO2_LETTER_SPACING = 0.5;\r\n\r\nfunction buildStructure(el) {\r\n  // Logo: resuelto por theme (2026-08-21) -- GLA sigue mostrando SIEMPRE\r\n  // su propio logo (fallback, nunca el manifest); otro theme sin imagen\r\n  // propia todav\u00EDa simplemente no muestra ning\u00FAn <img> (sin src roto).\r\n  const logoSrc = resolveImageSrc('zocaloFinal', LOGO_SRC);\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      ${logoSrc ? `<img class=\"ov-zf-logo\" src=\"${logoSrc}\" alt=\"logo\" />` : ''}\r\n      <div class=\"ov-zf-texto ov-zf-texto1\"></div>\r\n      <div class=\"ov-zf-texto ov-zf-texto2\"></div>\r\n      <div class=\"ov-zf-sponsor-box\">\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-1\" alt=\"\" />\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-2\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloFinal', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloFinal(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const sb = allData && allData.scoreboard;\r\n  const texto1El = contentEl.querySelector('.ov-zf-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zf-texto2');\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n  const oldT1 = contentEl._prevTexto1;\r\n  const oldT2 = contentEl._prevTexto2;\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, oldT1, {\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, oldT2, {\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH,\r\n    weight: 400, letterSpacing: TEXTO2_LETTER_SPACING,\r\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Rotation logic for sponsors in the empty right black box\r\n  const img1 = contentEl.querySelector('.ov-zf-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zf-sponsor-2');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      img1.className = 'ov-zf-sponsor-img';\r\n      img2.className = 'ov-zf-sponsor-img';\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      img1.className = 'ov-zf-sponsor-img active';\r\n      img2.className = 'ov-zf-sponsor-img';\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    activeImg.className = 'ov-zf-sponsor-img exit';\r\n    inactiveImg.className = 'ov-zf-sponsor-img active';\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.className.includes('exit')) {\r\n        prevImg.className = 'ov-zf-sponsor-img';\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || contentEl._lastSponsorsSignature !== listSignature) {\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/zocaloCompuesto.js","// Z\u00F3calo Compuesto unificado (2026-08-16, pedido expl\u00EDcito del usuario:\r\n// \"no quiero duplicar dos m\u00F3dulos casi id\u00E9nticos\"). Reemplaza en la\r\n// navegaci\u00F3n a zocaloFinal (Logo GLA) / zocaloFinalDiv (Equipos), que\r\n// quedan registrados sin cambios (ver shared/modules.js) solo para no\r\n// perder datos/presets ya persistidos -- este renderer es el \u00FAnico que\r\n// se usa desde ahora.\r\n//\r\n// \"tipo\" ('equipos' | 'logo') decide qu\u00E9 asset .mov reproducir y si se\r\n// pintan escudos (en vivo, del Marcador) o el logo GLA fijo -- el resto\r\n// (texto1/texto2/sponsor) es UNA sola copia de datos compartida, misma\r\n// geometr\u00EDa exacta que los dos m\u00F3dulos originales (reusa sus clases CSS\r\n// \".ov-zfd-*\"/\".ov-zf-*\" tal cual, ver program/css/overlay.css).\r\n//\r\n// Transici\u00F3n segura al cambiar TIPO estando al aire (pedido expl\u00EDcito):\r\n// createAlphaVideo crea un <video>+<canvas> atado a UN asset fijo, as\u00ED\r\n// que cambiar de tipo requiere destruir la instancia vieja y crear una\r\n// nueva con el otro .mov -- se hace de forma SINCR\u00D3NICA (destroy() antes\r\n// de crear la nueva) para que nunca queden dos videos/canvas superpuestos\r\n// en el DOM, y se relanza playFromStart() aunque no sea un TAKE nuevo\r\n// (justTaken=false) para que el cambio de tipo se vea como una entrada\r\n// real, no como un frame congelado en negro.\r\nimport { glaAssetPath } from '../../../shared/asset-registry.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { DEFAULT_THEME_ID } from '../../../shared/themes.js';\r\nimport { GLA_SEGOE_BOLD_FAMILY, withGlaSegoeRegular } from '../program-fonts.js';\r\n\r\nconst VIDEO_SRC = {\r\n  equipos: glaAssetPath('zocaloCompuesto', 'equipos'),\r\n  logo: glaAssetPath('zocaloCompuesto', 'logo'),\r\n};\r\nconst LOGO_SRC = glaAssetPath('zocaloCompuesto', 'logoImagen');\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\nconst TEXTO2_LETTER_SPACING = 0.5;\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    imgEl.src = src;\r\n    imgEl.alt = teamName(teamId);\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nfunction buildStructure(el, tipo) {\r\n  const logoSrc = resolveImageSrc('zocaloCompuesto', LOGO_SRC);\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-local\" data-adjust=\"localCrest\" alt=\"\" />\r\n      <img class=\"ov-zfd-crest ov-zfd-crest-visitante\" data-adjust=\"awayCrest\" alt=\"\" />\r\n      ${logoSrc ? `<img class=\"ov-zf-logo\" data-adjust=\"logo\" src=\"${logoSrc}\" alt=\"logo\" />` : ''}\r\n      <div class=\"ov-zfd-texto ov-zfd-texto1\"></div>\r\n      <div class=\"ov-zfd-texto ov-zfd-texto2\"></div>\r\n      <!-- Los 2 <img> del crossfade interno (ver updateSponsorImage mas\r\n           abajo -- SIEMPRE hay uno \"active\" y como maximo uno \"exit\" mas\r\n           viejo saliendo) comparten el MISMO \"data-adjust\" a proposito\r\n           (2026-09-24, pedido explicito: \"un unico ajuste para TODOS los\r\n           sponsors del rotativo\") -- applyElementAdjustRegistry (program/js/\r\n           main.js) ya aplica un mismo ajuste a TODOS los nodos que\r\n           coincidan, asi que cualquiera de los dos que le toque mostrar un\r\n           sponsor sale en la misma posicion/escala. Las clases\r\n           \".ov-zfd-sponsor-1\"/\"-2\" siguen siendo distintas -- esas las usa\r\n           SOLO la logica de rotacion (querySelector mas abajo) para saber\r\n           cual esta activo/inactivo, no tienen relacion con el ajuste. -->\r\n      <div class=\"ov-zfd-sponsor-box\">\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-1\" data-adjust=\"sponsors\" alt=\"\" />\r\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-2\" data-adjust=\"sponsors\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el.dataset.tipo = tipo;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloCompuesto', VIDEO_SRC[tipo], undefined, tipo);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloCompuesto(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const tipo = data.tipo === 'logo' ? 'logo' : 'equipos';\r\n  const tipoChanged = contentEl.dataset.tipo !== undefined && contentEl.dataset.tipo !== tipo;\r\n\r\n  if (!contentEl._gfxBuilt || tipoChanged) {\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    buildStructure(contentEl, tipo);\r\n    // Fuerza que el texto se pinte de una sin fundido (el \"oldText\" de la\r\n    // variante anterior no aplica a esta estructura nueva).\r\n    contentEl._prevTexto1 = undefined;\r\n    contentEl._prevTexto2 = undefined;\r\n  }\r\n\r\n  if (justTaken || tipoChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n\r\n  // Sector izquierdo: escudos en vivo (tipo EQUIPOS) o logo fijo (tipo LOGO).\r\n  const crestLocalEl = contentEl.querySelector('.ov-zfd-crest-local');\r\n  const crestVisitanteEl = contentEl.querySelector('.ov-zfd-crest-visitante');\r\n  const logoEl = contentEl.querySelector('.ov-zf-logo');\r\n  if (tipo === 'equipos') {\r\n    const fuente = data.escudosFuente || 'MARCADOR';\r\n    const teamA = fuente === 'PERSONALIZADO' ? (data.customTeamA || '') : (sb.teamA || '');\r\n    const teamB = fuente === 'PERSONALIZADO' ? (data.customTeamB || '') : (sb.teamB || '');\r\n    setCrest(crestLocalEl, teamA);\r\n    setCrest(crestVisitanteEl, teamB);\r\n    crestLocalEl.style.display = '';\r\n    crestVisitanteEl.style.display = '';\r\n    if (logoEl) logoEl.style.display = 'none';\r\n  } else {\r\n    crestLocalEl.style.display = 'none';\r\n    crestVisitanteEl.style.display = 'none';\r\n    if (logoEl) logoEl.style.display = '';\r\n  }\r\n\r\n  const texto1El = contentEl.querySelector('.ov-zfd-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zfd-texto2');\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n  const oldT1 = contentEl._prevTexto1;\r\n  const oldT2 = contentEl._prevTexto2;\r\n  // \"family\" (2026-09-24, pedido explicito: \"Segoe UI Bold\", SOLO GLA) --\r\n  // mismo criterio que longSimple.js/shortSimple.js/shortDouble.js.\r\n  const family = getActiveThemeId() === DEFAULT_THEME_ID ? GLA_SEGOE_BOLD_FAMILY : undefined;\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, oldT1, withGlaSegoeRegular({\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800, family,\r\n  }), readTextAdjust(data.textAdjust, 'texto1'), !justTaken && !tipoChanged);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, oldT2, withGlaSegoeRegular({\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH,\r\n    weight: 400, letterSpacing: TEXTO2_LETTER_SPACING, family,\r\n  }), readTextAdjust(data.textAdjust, 'texto2'), !justTaken && !tipoChanged);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Rotaci\u00F3n de sponsors en el recuadro derecho (misma l\u00F3gica que\r\n  // zocaloFinal.js/zocaloFinalDiv.js, sin cambios).\r\n  const img1 = contentEl.querySelector('.ov-zfd-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zfd-sponsor-2');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  // \"classList\" en vez de pisar \"className\" entero (2026-09-24, bug real\r\n  // reproducido en GLA con Hot Pool activo -- ver comentario de\r\n  // HOT_MODULE_IDS en program/js/hot-pool.js): \"img1\"/\"img2\" se ubican por\r\n  // sus clases IDENTIFICADORAS propias (\".ov-zfd-sponsor-1\"/\"-2\", ver\r\n  // \"querySelector\" mas abajo) -- pisar \"className\" completo con solo\r\n  // \"ov-zfd-sponsor-img\" (rama sin sponsors) las borraba para siempre, asi\r\n  // que el PROXIMO render (ya con el modulo WARM, mismo contentEl) no\r\n  // volvia a encontrar esos nodos -- \"img1\"/\"img2\" quedaban null y\r\n  // \"img1.src = ...\" tiraba \"Cannot set properties of null\". Con un\r\n  // \"className\" fijo (nunca destroy) esto pasaba desapercibido antes de\r\n  // Hot Pool porque CADA Take reconstruia el DOM de cero (clases frescas);\r\n  // con el modulo WARM persistente el bug se vuelve real. \"classList.add/\r\n  // remove\" solo toca los modificadores \"active\"/\"exit\", nunca las clases\r\n  // base -- mismo resultado visual/CSS, ya no se pierde la identidad del\r\n  // nodo entre renders.\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      img1.classList.remove('active', 'exit');\r\n      img2.classList.remove('active', 'exit');\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      img1.classList.remove('exit');\r\n      img1.classList.add('active');\r\n      img2.classList.remove('active', 'exit');\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    activeImg.classList.remove('active');\r\n    activeImg.classList.add('exit');\r\n    inactiveImg.classList.remove('exit');\r\n    inactiveImg.classList.add('active');\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.classList.contains('exit')) {\r\n        prevImg.classList.remove('exit');\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || tipoChanged || contentEl._lastSponsorsSignature !== listSignature) {\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken || tipoChanged);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/zocaloCompuestoEquipos.js","// Z\u00F3calo Compuesto (Argentina Streamers) unificado (2026-09-10, pedido\n// explicito del usuario: \"es todo lo mismo, solo cambia el asset... un\n// solo m\u00F3dulo, con la opci\u00F3n de men\u00FA desplegable CON LOGO LOCALSTRIKE |\n// CON EQUIPOS\"). Reemplaza en la navegaci\u00F3n a \"zocaloCompuestoLogo\", que\n// queda registrado sin cambios (ver shared/modules.js) solo para no perder\n// datos/presets ya persistidos -- este renderer es el \u00FAnico que se usa\n// desde ahora para ambos tipos.\n//\n// \"tipo\" ('equipos' | 'logo') decide qu\u00E9 asset .mov reproducir y si se\n// pintan escudos en vivo (con l\u00EDnea separadora, ya horneada en ESE asset)\n// o el logo LocalStrike fijo (sin l\u00EDnea, horneada distinto en el otro\n// asset) -- el resto (texto1/texto2/subColor/sponsor) es UNA sola copia de\n// datos compartida. Transici\u00F3n segura al cambiar TIPO estando al aire:\n// mismo patr\u00F3n que program/js/renderers/zocaloCompuesto.js (el m\u00F3dulo de\n// GLA, sin relaci\u00F3n con este -- assets completamente distintos): destruye\n// el video viejo y crea uno nuevo de forma SINCR\u00D3NICA antes de seguir, y\n// relanza playFromStart() aunque no sea un TAKE nuevo para que el cambio\n// de tipo se vea como una entrada real.\nimport { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\nimport { crestFile, teamName } from '../../../shared/teams.js';\nimport { sponsorFile } from '../../../shared/sponsors.js';\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\nimport { getActiveThemeId } from '../theme-client.js';\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\n\nconst VIDEO_SRC = {\n  equipos: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-equipos-alpha.mp4',\n  logo: '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4',\n};\nconst LOGO_SRC = '/assets/themes/argentina-streamers/zocalos/logo-localstrike.png';\n\nconst TEXTO1_MAX_FONT = 50;\nconst TEXTO1_MIN_FONT = 22;\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\n\nconst TEXTO2_MAX_FONT = 30;\nconst TEXTO2_MIN_FONT = 16;\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\n\nfunction setCrest(imgEl, teamId, adjustObj) {\n  if (!imgEl) return;\n  const src = crestFile(teamId);\n  if (src) {\n    imgEl.src = src;\n    imgEl.alt = teamName(teamId) || teamId;\n    imgEl.style.visibility = 'visible';\n    imgEl.style.display = 'block';\n    imgEl.style.opacity = '1';\n    imgEl.style.zIndex = '10';\n\n    const dx = adjustObj?.offsetX || 0;\n    const dy = adjustObj?.offsetY || 0;\n    const sc = adjustObj?.scale !== undefined ? adjustObj.scale : 1;\n    imgEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\n  } else {\n    imgEl.removeAttribute('src');\n    imgEl.alt = '';\n    imgEl.style.visibility = 'hidden';\n    imgEl.style.display = 'none';\n  }\n}\n\n// \"videoModuleId\" (2026-09-14, causa raiz REAL encontrada y corregida --\n// pedido explicito del usuario: \"no importa si elijo CON EQUIPOS o CON\n// LOGO, el asset gr\u00E1fico no aparece\"). \"mountThemedAlphaVideo\"/\n// \"resolveImageSrc\" (ver program/js/theme-assets.js) resuelven un 5to\n// parametro \"variant\" como \"asset.variants?.[variant]\" -- pero el manifest\n// real de Argentina Streamers (shared/themes.js) NUNCA tuvo un objeto\n// \"variants\" para este modulo: tiene DOS ENTRADAS PLANAS separadas,\n// \"zocaloCompuestoEquipos: {video:...}\" y \"zocaloCompuestoLogo:\n// {video:..., image:...}\" (asi vivian ANTES de unificar el panel en un\n// solo modulo con selector \"tipo\", ver historial). Al unificar el\n// renderer se paso \"tipo\" como variant (`mountThemedAlphaVideo(..., 'zocaloCompuestoEquipos', ..., tipo)`)\n// asumiendo una estructura \"variants\" que jamas se creo en el manifest --\n// \"asset.variants\" siempre daba \"undefined\", asi que SIEMPRE resolvia a\n// null sin importar el tipo elegido (nunca se vio ningun asset, ni\n// EQUIPOS ni LOGO). Fix: en vez de inventar una estructura \"variants\"\n// nueva en el manifest (mas riesgo, toca datos ya persistidos), se\n// consulta CADA \"tipo\" por su PROPIO moduleId real ya existente en el\n// manifest -- sin pasar \"variant\" nunca.\nfunction resolveVideoModuleId(tipo) {\n  return tipo === 'logo' ? 'zocaloCompuestoLogo' : 'zocaloCompuestoEquipos';\n}\n\nfunction buildStructure(el, tipo) {\n  // Mismo criterio: el logo real vive en el manifest bajo la entrada\n  // \"zocaloCompuestoLogo\" (unica que declara \"image\"), no bajo\n  // \"zocaloCompuestoEquipos\" (que nunca tuvo \"image\" propio).\n  const logoSrc = resolveImageSrc('zocaloCompuestoLogo', LOGO_SRC) || LOGO_SRC;\n  el.innerHTML = `\n    <div class=\"av-target\"></div>\n    <div class=\"gfx-overlay\">\n      <img class=\"ov-zfd-crest ov-zfd-crest-local\" alt=\"local crest\" />\n      <img class=\"ov-zfd-crest ov-zfd-crest-visitante\" alt=\"visitante crest\" />\n      <img class=\"ov-zf-logo\" src=\"${logoSrc}\" alt=\"logo\" style=\"position: absolute; left: 100px; top: 951.5px; width: 110px; height: 110px; object-fit: contain; z-index: 10;\" />\n      <div class=\"ov-zfd-texto ov-zfd-texto1\" style=\"color: #ffffff !important;\"></div>\n      <div class=\"ov-zfd-texto ov-zfd-texto2\"></div>\n      <div class=\"ov-zfd-sponsor-box\">\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-1\" alt=\"\" />\n        <img class=\"ov-zfd-sponsor-img ov-zfd-sponsor-2\" alt=\"\" />\n      </div>\n    </div>\n  `;\n  el.dataset.tipo = tipo;\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), resolveVideoModuleId(tipo), VIDEO_SRC[tipo]);\n  el._gfxBuilt = true;\n}\n\nexport default function renderZocaloCompuestoEquipos(contentEl, data, justTaken, onOneShotEnded, allData) {\n  const tipo = data.tipo === 'logo' ? 'logo' : 'equipos';\n  const tipoChanged = contentEl.dataset.tipo !== undefined && contentEl.dataset.tipo !== tipo;\n\n  if (!contentEl._gfxBuilt || tipoChanged) {\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\n    buildStructure(contentEl, tipo);\n    // Fuerza que el texto se pinte de una sin fundido (el \"oldText\" de la\n    // variante anterior no aplica a esta estructura nueva).\n    contentEl._prevTexto1 = undefined;\n    contentEl._prevTexto2 = undefined;\n  }\n\n  if (justTaken || tipoChanged) {\n    contentEl._alphaVideo?.playFromStart();\n  }\n\n  const sb = (allData && allData.scoreboard) || {};\n  const teamA = sb.teamA || 'argentina-streamers';\n  const teamB = sb.teamB || 'oxen';\n\n  const crestLocalEl = contentEl.querySelector('.ov-zfd-crest-local');\n  const crestVisitanteEl = contentEl.querySelector('.ov-zfd-crest-visitante');\n  const logoEl = contentEl.querySelector('.ov-zf-logo');\n\n  if (tipo === 'equipos') {\n    const localAdjust = data.crestByTeam?.local?.[teamA] || {};\n    const awayAdjust = data.crestByTeam?.away?.[teamB] || {};\n    setCrest(crestLocalEl, teamA, {\n      offsetX: localAdjust.localCrestOffsetX || 0,\n      offsetY: localAdjust.localCrestOffsetY || 0,\n      scale: localAdjust.localCrestScale,\n    });\n    setCrest(crestVisitanteEl, teamB, {\n      offsetX: awayAdjust.awayCrestOffsetX || 0,\n      offsetY: awayAdjust.awayCrestOffsetY || 0,\n      scale: awayAdjust.awayCrestScale,\n    });\n    if (logoEl) logoEl.style.display = 'none';\n  } else {\n    crestLocalEl.style.display = 'none';\n    crestVisitanteEl.style.display = 'none';\n    if (logoEl) {\n      logoEl.style.display = 'block';\n      const dx = data.logoOffsetX || 0;\n      const dy = data.logoOffsetY || 0;\n      const sc = data.logoScale !== undefined ? data.logoScale : 1;\n      logoEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\n    }\n  }\n\n  const texto1El = contentEl.querySelector('.ov-zfd-texto1');\n  const texto2El = contentEl.querySelector('.ov-zfd-texto2');\n  texto1El.style.color = '#ffffff';\n  // \"subColor\" (2026-09-02, pedido explicito del usuario): MAIN siempre\n  // blanco fijo (arriba); SUBTEXTO configurable NEGRO/BLANCO desde Master\n  // Control, sin depender de ninguna clase/color heredado de GLA.\n  // BLOQUE 1 (2026-09-09, pedido explicito): en Argentina Streamers el\n  // SUBTEXTO pasa a AZUL DE REFERENCIA fijo (\"--as-navy\", ver theme.css),\n  // sin depender de \"subColor\" -- GLA conserva el toggle negro/blanco\n  // exactamente igual que antes (modulo distinto, ver zocaloCompuesto.js).\n  texto2El.style.color = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID\n    ? 'var(--as-navy)'\n    : (data.subColor === 'blanco' ? '#ffffff' : '#000000');\n\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\n\n  updateFittedTextWithTransition(texto1El, newT1, contentEl._prevTexto1, {\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken && !tipoChanged);\n\n  updateFittedTextWithTransition(texto2El, newT2, contentEl._prevTexto2, {\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH, weight: 700,\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken && !tipoChanged);\n\n  contentEl._prevTexto1 = newT1;\n  contentEl._prevTexto2 = newT2;\n\n  // Posicion del SLOT de sponsor (unica zona visual, no por marca -- pedido\n  // explicito del usuario). La rotacion en si va mas abajo.\n  const sponsorBox = contentEl.querySelector('.ov-zfd-sponsor-box');\n  const sponsorsList = data.sponsorsRotation || [];\n  if (sponsorBox) {\n    sponsorBox.style.display = sponsorsList.length ? 'block' : 'none';\n    const sx = data.sponsorOffsetX || 0;\n    const sy = data.sponsorOffsetY || 0;\n    const sc = data.sponsorScale !== undefined ? data.sponsorScale : 1;\n    sponsorBox.style.transform = `translate(${sx}px, ${sy}px) scale(${sc})`;\n  }\n\n  // Rotaci\u00F3n de sponsors (2026-09-02, pedido explicito del usuario: nada de\n  // dropdown unico -- misma logica ya usada por zocaloCompuesto.js, sin\n  // reinventar: dos <img> que hacen crossfade cada 10s, un sponsor visible\n  // a la vez).\n  const img1 = contentEl.querySelector('.ov-zfd-sponsor-1');\n  const img2 = contentEl.querySelector('.ov-zfd-sponsor-2');\n  const listSignature = JSON.stringify(sponsorsList);\n\n  // \"setSponsorState\" (2026-09-05, correccion de raiz del freeze reportado):\n  // nunca reemplazar el className entero (borraba la clase identificadora\n  // \".ov-zfd-sponsor-1\"/\"-2\", provocando querySelector->null->TypeError en\n  // el siguiente render y la rotacion muerta/logo pegado). Solo classList.\n  function setSponsorState(img, state) {\n    img.classList.remove('active', 'exit');\n    if (state) img.classList.add(state);\n  }\n\n  const updateSponsorImage = (isFirstShow = false) => {\n    if (sponsorsList.length === 0) {\n      setSponsorState(img1, null);\n      setSponsorState(img2, null);\n      img1.removeAttribute('src');\n      img2.removeAttribute('src');\n      return;\n    }\n\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\n    const file = sponsorFile('zocalo', currentName);\n\n    if (isFirstShow || sponsorsList.length === 1) {\n      img1.src = file || '';\n      setSponsorState(img1, 'active');\n      setSponsorState(img2, null);\n      img2.removeAttribute('src');\n      contentEl._activeImgIdx = 1;\n      return;\n    }\n\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\n\n    inactiveImg.src = file || '';\n    setSponsorState(activeImg, 'exit');\n    setSponsorState(inactiveImg, 'active');\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\n\n    const prevImg = activeImg;\n    setTimeout(() => {\n      if (prevImg.classList.contains('exit')) {\n        setSponsorState(prevImg, null);\n        prevImg.removeAttribute('src');\n      }\n    }, 600);\n  };\n\n  if (justTaken || tipoChanged || contentEl._lastSponsorsSignature !== listSignature) {\n    if (contentEl._sponsorRotationInterval) {\n      clearInterval(contentEl._sponsorRotationInterval);\n      contentEl._sponsorRotationInterval = null;\n    }\n\n    contentEl._currentSponsorIndex = 0;\n    contentEl._lastSponsorsSignature = listSignature;\n\n    updateSponsorImage(justTaken || tipoChanged);\n\n    if (sponsorsList.length > 1) {\n      contentEl._sponsorRotationInterval = setInterval(() => {\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\n        updateSponsorImage(false);\n      }, 10000);\n    }\n  }\n}\n","http://127.0.0.1:4430/program/js/renderers/zocaloCompuestoLogo.js","import { mountThemedAlphaVideo, resolveImageSrc } from '../theme-assets.js';\r\nimport { sponsorFile } from '../../../shared/sponsors.js';\r\nimport { updateFittedTextWithTransition, readTextAdjust } from '../text-fit.js';\r\nimport { resolveTeamTokens } from '../../../shared/text-tokens.js';\r\nimport { getActiveThemeId } from '../theme-client.js';\r\nimport { ARGENTINA_STREAMERS_THEME_ID } from '../../../shared/themes.js';\r\n\r\nconst VIDEO_SRC = '/assets/themes/argentina-streamers/zocalos/zocalo-compuesto-logo-alpha.mp4';\r\nconst LOGO_SRC = '/assets/themes/argentina-streamers/zocalos/logo-localstrike.png';\r\n\r\nconst TEXTO1_MAX_FONT = 50;\r\nconst TEXTO1_MIN_FONT = 22;\r\nconst TEXTO1_MAX_WIDTH = 1111 - 40;\r\n\r\nconst TEXTO2_MAX_FONT = 30;\r\nconst TEXTO2_MIN_FONT = 16;\r\nconst TEXTO2_MAX_WIDTH = 1111 - 40;\r\n\r\nfunction buildStructure(el) {\r\n  const logoSrc = resolveImageSrc('zocaloCompuestoLogo', LOGO_SRC) || LOGO_SRC;\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay\">\r\n      <img class=\"ov-zf-logo\" src=\"${logoSrc}\" alt=\"logo\" style=\"position: absolute; left: 100px; top: 951.5px; width: 110px; height: 110px; object-fit: contain; z-index: 10; visibility: visible; display: block;\" />\r\n      <div class=\"ov-zf-texto ov-zf-texto1\" style=\"color: #ffffff !important;\"></div>\r\n      <div class=\"ov-zf-texto ov-zf-texto2\"></div>\r\n      <div class=\"ov-zf-sponsor-box\">\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-1\" alt=\"\" />\r\n        <img class=\"ov-zf-sponsor-img ov-zf-sponsor-2\" alt=\"\" />\r\n      </div>\r\n    </div>\r\n  `;\r\n  el._alphaVideo = mountThemedAlphaVideo(el.querySelector('.av-target'), 'zocaloCompuestoLogo', VIDEO_SRC);\r\n  el._gfxBuilt = true;\r\n}\r\n\r\nexport default function renderZocaloCompuestoLogo(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  if (!contentEl._gfxBuilt) buildStructure(contentEl);\r\n  if (justTaken) contentEl._alphaVideo?.playFromStart();\r\n\r\n  const logoEl = contentEl.querySelector('.ov-zf-logo');\r\n  if (logoEl) {\r\n    const dx = data.logoOffsetX || 0;\r\n    const dy = data.logoOffsetY || 0;\r\n    const sc = data.logoScale !== undefined ? data.logoScale : 1;\r\n    logoEl.style.transform = `translate(${dx}px, ${dy}px) scale(${sc})`;\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const texto1El = contentEl.querySelector('.ov-zf-texto1');\r\n  const texto2El = contentEl.querySelector('.ov-zf-texto2');\r\n  texto1El.style.color = '#ffffff';\r\n  // \"subColor\" (2026-09-02, pedido explicito del usuario): MAIN siempre\r\n  // blanco fijo (arriba); SUBTEXTO configurable NEGRO/BLANCO desde Master\r\n  // Control, sin depender de ninguna clase/color heredado de GLA.\r\n  // BLOQUE 1 (2026-09-09, pedido explicito): en Argentina Streamers el\r\n  // SUBTEXTO pasa a AZUL DE REFERENCIA fijo (\"--as-navy\", ver theme.css),\r\n  // sin depender de \"subColor\" -- GLA conserva el toggle negro/blanco\r\n  // exactamente igual que antes.\r\n  texto2El.style.color = getActiveThemeId() === ARGENTINA_STREAMERS_THEME_ID\r\n    ? 'var(--as-navy)'\r\n    : (data.subColor === 'blanco' ? '#ffffff' : '#000000');\r\n\r\n  const newT1 = resolveTeamTokens(data.texto1 || '', sb);\r\n  const newT2 = resolveTeamTokens(data.texto2 || '', sb);\r\n\r\n  updateFittedTextWithTransition(texto1El, newT1, contentEl._prevTexto1, {\r\n    maxFont: TEXTO1_MAX_FONT, minFont: TEXTO1_MIN_FONT, maxWidth: TEXTO1_MAX_WIDTH, weight: 800,\r\n  }, readTextAdjust(data.textAdjust, 'texto1'), !justTaken);\r\n\r\n  updateFittedTextWithTransition(texto2El, newT2, contentEl._prevTexto2, {\r\n    maxFont: TEXTO2_MAX_FONT, minFont: TEXTO2_MIN_FONT, maxWidth: TEXTO2_MAX_WIDTH, weight: 700,\r\n  }, readTextAdjust(data.textAdjust, 'texto2'), !justTaken);\r\n\r\n  contentEl._prevTexto1 = newT1;\r\n  contentEl._prevTexto2 = newT2;\r\n\r\n  // Posicion del SLOT de sponsor (unica zona visual, no por marca -- pedido\r\n  // explicito del usuario). La rotacion en si va mas abajo.\r\n  const sponsorBox = contentEl.querySelector('.ov-zf-sponsor-box');\r\n  const sponsorsList = data.sponsorsRotation || [];\r\n  if (sponsorBox) {\r\n    sponsorBox.style.display = sponsorsList.length ? 'block' : 'none';\r\n    const sx = data.sponsorOffsetX || 0;\r\n    const sy = data.sponsorOffsetY || 0;\r\n    const sc = data.sponsorScale !== undefined ? data.sponsorScale : 1;\r\n    sponsorBox.style.transform = `translate(${sx}px, ${sy}px) scale(${sc})`;\r\n  }\r\n\r\n  // Rotaci\u00F3n de sponsors (2026-09-02, pedido explicito del usuario: nada de\r\n  // dropdown unico -- misma logica ya usada por zocaloCompuesto.js, sin\r\n  // reinventar: dos <img> que hacen crossfade cada 10s, un sponsor visible\r\n  // a la vez).\r\n  const img1 = contentEl.querySelector('.ov-zf-sponsor-1');\r\n  const img2 = contentEl.querySelector('.ov-zf-sponsor-2');\r\n  const listSignature = JSON.stringify(sponsorsList);\r\n\r\n  // Mismo fix de raiz que zocaloCompuestoEquipos.js (2026-09-05): nunca\r\n  // reemplazar el className entero (borraba la clase identificadora\r\n  // \".ov-zf-sponsor-1\"/\"-2\", provocando querySelector->null->TypeError en el\r\n  // siguiente render y la rotacion muerta/logo pegado). Solo classList.\r\n  function setSponsorState(img, state) {\r\n    img.classList.remove('active', 'exit');\r\n    if (state) img.classList.add(state);\r\n  }\r\n\r\n  const updateSponsorImage = (isFirstShow = false) => {\r\n    if (sponsorsList.length === 0) {\r\n      setSponsorState(img1, null);\r\n      setSponsorState(img2, null);\r\n      img1.removeAttribute('src');\r\n      img2.removeAttribute('src');\r\n      return;\r\n    }\r\n\r\n    const currentName = sponsorsList[contentEl._currentSponsorIndex];\r\n    const file = sponsorFile('zocalo', currentName);\r\n\r\n    if (isFirstShow || sponsorsList.length === 1) {\r\n      img1.src = file || '';\r\n      setSponsorState(img1, 'active');\r\n      setSponsorState(img2, null);\r\n      img2.removeAttribute('src');\r\n      contentEl._activeImgIdx = 1;\r\n      return;\r\n    }\r\n\r\n    const activeImg = contentEl._activeImgIdx === 1 ? img1 : img2;\r\n    const inactiveImg = contentEl._activeImgIdx === 1 ? img2 : img1;\r\n\r\n    inactiveImg.src = file || '';\r\n    setSponsorState(activeImg, 'exit');\r\n    setSponsorState(inactiveImg, 'active');\r\n    contentEl._activeImgIdx = contentEl._activeImgIdx === 1 ? 2 : 1;\r\n\r\n    const prevImg = activeImg;\r\n    setTimeout(() => {\r\n      if (prevImg.classList.contains('exit')) {\r\n        setSponsorState(prevImg, null);\r\n        prevImg.removeAttribute('src');\r\n      }\r\n    }, 600);\r\n  };\r\n\r\n  if (justTaken || contentEl._lastSponsorsSignature !== listSignature) {\r\n    if (contentEl._sponsorRotationInterval) {\r\n      clearInterval(contentEl._sponsorRotationInterval);\r\n      contentEl._sponsorRotationInterval = null;\r\n    }\r\n\r\n    contentEl._currentSponsorIndex = 0;\r\n    contentEl._lastSponsorsSignature = listSignature;\r\n\r\n    updateSponsorImage(justTaken);\r\n\r\n    if (sponsorsList.length > 1) {\r\n      contentEl._sponsorRotationInterval = setInterval(() => {\r\n        contentEl._currentSponsorIndex = (contentEl._currentSponsorIndex + 1) % sponsorsList.length;\r\n        updateSponsorImage(false);\r\n      }, 10000);\r\n    }\r\n  }\r\n}\r\n","http://127.0.0.1:4430/program/js/renderers/sitioWebPromoL.js","import { resolveImageSrc } from '../theme-assets.js';\n\n// \"Sitio Web Promo L\" (2026-09-02, pedido explicito del usuario): placa\n// full-bleed estatica, sin texto dinamico -- el PNG real (ANUNCIO_AS) ya\n// trae su contenido horneado (captura del sitio + boton \"INGRES\u00C1\"). No\n// hay zonas evidentemente destinadas a contenido dinamico en el asset\n// (confirmado visualmente: es una composicion fija de foto+mockup de\n// telefono+boton, sin recuadros vacios ni placeholders) -- primera\n// version es solo asset + \"COMPOSICI\u00D3N COMPLETA\", tal como se pidio.\n//\n// \"asset\" (2026-09-14, RESTAURADO -- ver shared/modules.js para la causa\n// raiz del desplegable perdido): selector ARGENTINA STREAMERS | PUNCH,\n// resuelto via \"variant\" contra shared/themes.js. Se reconstruye el <img>\n// cada vez que cambia \"data.asset\" (antes esta funcion ni siquiera recibia\n// \"data\" -- solo existia una imagen fija, nunca reaccionaba a nada).\nfunction buildStructure(el, asset) {\n  const imgSrc = resolveImageSrc('sitioWebPromoL', undefined, asset);\n  el.innerHTML = `\n    <div class=\"gfx-overlay\">\n      ${imgSrc ? `<img class=\"ov-promo-l-bg\" src=\"${imgSrc}\" style=\"position:absolute; left:0; top:0; width:1920px; height:1080px;\" />` : ''}\n    </div>\n  `;\n  el.dataset.asset = asset;\n  el._gfxBuilt = true;\n}\n\nexport default function renderSitioWebPromoL(contentEl, data) {\n  const asset = data?.asset === 'punch' ? 'punch' : 'argentina-streamers';\n  if (!contentEl._gfxBuilt || contentEl.dataset.asset !== asset) {\n    buildStructure(contentEl, asset);\n  }\n}\n","http://127.0.0.1:4430/program/js/renderers/zocaloVs.js","// Z\u00D3CALO VS (2026-10-09, pedido explicito del usuario, SOLO Argentina\r\n// Streamers). Dos variantes de asset (shared/themes.js \"zocaloVs.variants\"):\r\n//   solo  -> [ESCUDO] NOMBRE LOCAL  VS  NOMBRE VISITANTE [ESCUDO]\r\n//   goles -> [ESCUDO] NOMBRE LOCAL GOL  VS  GOL NOMBRE VISITANTE [ESCUDO]\r\n// Equipos, escudos y goles se leen SIEMPRE en vivo del Marcador principal\r\n// (\"allData.scoreboard\", 5to argumento -- modulo \"live\", mismo patron que\r\n// marcadorPenales/vs): no hay estado propio de equipo ni de goles. El nombre\r\n// es el NOMBRE COMPLETO del catalogo de EQUIPOS (no la abreviatura) salvo\r\n// que el operador lo pase a MANUAL (shared/broadcast-names.js).\r\n//\r\n// Geometria medida sobre el frame asentado de los .mov originales (alfa\r\n// real, 1920x1080, ver overlay.css \"#mod-zocaloVs\"): barra x335-1575,\r\n// y971-1034 en ambas variantes; pastilla verde SOLO x905-999, GOLES\r\n// x825-1082; \"VS\" horneado x929-974, y993-1017 (no es texto dinamico).\r\nimport { mountThemedAlphaVideo } from '../theme-assets.js';\r\nimport { crestFile, teamName } from '../../../shared/teams.js';\r\nimport { resolveVsDisplayName } from '../../../shared/broadcast-names.js';\r\nimport { applyFittedText, readTextAdjust } from '../text-fit.js';\r\n\r\n// Ancho util de cada caja (ancho CSS menos aire contra los bordes).\r\nconst NAME_FIT = {\r\n  solo: { maxFont: 34, minFont: 16, maxWidth: 461 - 8, weight: 800 },\r\n  goles: { maxFont: 34, minFont: 16, maxWidth: 381 - 8, weight: 800 },\r\n};\r\nconst GOL_FIT = { maxFont: 46, minFont: 24, maxWidth: 72 - 8, weight: 800 };\r\n\r\nfunction normalizeVariante(value) {\r\n  return value === 'goles' ? 'goles' : 'solo';\r\n}\r\n\r\n// \"data-adjust\" con el id de la entrada de la variante (shared/\r\n// adjust-registry.js) -- asi applyElementAdjustRegistry solo encuentra los\r\n// escudos de la variante que esta construida.\r\nfunction buildStructure(el, variante) {\r\n  const goles = variante === 'goles'\r\n    ? `<div class=\"ov-zvs-gol ov-zvs-gol-local\"></div>\r\n       <div class=\"ov-zvs-gol ov-zvs-gol-visitante\"></div>`\r\n    : '';\r\n  el.innerHTML = `\r\n    <div class=\"av-target\"></div>\r\n    <div class=\"gfx-overlay ov-zvs ov-zvs--${variante}\">\r\n      <img class=\"ov-zvs-crest ov-zvs-crest-local\" data-adjust=\"${variante}LocalCrest\" alt=\"\" />\r\n      <div class=\"ov-zvs-name ov-zvs-name-local\"></div>\r\n      ${goles}\r\n      <div class=\"ov-zvs-name ov-zvs-name-visitante\"></div>\r\n      <img class=\"ov-zvs-crest ov-zvs-crest-visitante\" data-adjust=\"${variante}AwayCrest\" alt=\"\" />\r\n    </div>\r\n  `;\r\n}\r\n\r\nfunction setCrest(imgEl, teamId) {\r\n  const src = crestFile(teamId);\r\n  if (src) {\r\n    if (imgEl.getAttribute('src') !== src) imgEl.src = src;\r\n    imgEl.alt = teamName(teamId) || teamId;\r\n    imgEl.style.visibility = 'visible';\r\n  } else {\r\n    imgEl.removeAttribute('src');\r\n    imgEl.alt = '';\r\n    imgEl.style.visibility = 'hidden';\r\n  }\r\n}\r\n\r\nexport default function renderZocaloVs(contentEl, data, justTaken, onOneShotEnded, allData) {\r\n  const variante = normalizeVariante(data.variante);\r\n  // Mismo criterio que tarjeta.js: el primer build (incluido el pre-montaje\r\n  // en frio) no tiene \"dataset.variante\" previo y nunca se autoreproduce.\r\n  const varianteChanged = contentEl.dataset.variante !== undefined && contentEl.dataset.variante !== variante;\r\n  if (!contentEl._gfxBuilt || varianteChanged) {\r\n    contentEl.dataset.variante = variante;\r\n    if (contentEl._alphaVideo) contentEl._alphaVideo.destroy();\r\n    buildStructure(contentEl, variante);\r\n    contentEl._alphaVideo = mountThemedAlphaVideo(contentEl.querySelector('.av-target'), 'zocaloVs', null, undefined, variante);\r\n    contentEl._gfxBuilt = true;\r\n  }\r\n  if (justTaken || varianteChanged) {\r\n    contentEl._alphaVideo?.playFromStart();\r\n  }\r\n\r\n  const sb = (allData && allData.scoreboard) || {};\r\n  const ta = data.textAdjust;\r\n  setCrest(contentEl.querySelector('.ov-zvs-crest-local'), sb.teamA);\r\n  setCrest(contentEl.querySelector('.ov-zvs-crest-visitante'), sb.teamB);\r\n\r\n  // AUTOM\u00C1TICO = nombre completo del catalogo (sin el mapping de nombres\r\n  // cortos de broadcast: \"teamId: null\" a proposito). MANUAL con texto gana.\r\n  const nombreLocal = resolveVsDisplayName({ mode: data.nombreLocalMode, manualText: data.nombreLocalManual, teamId: null, fallbackName: teamName(sb.teamA) });\r\n  const nombreVisitante = resolveVsDisplayName({ mode: data.nombreVisitanteMode, manualText: data.nombreVisitanteManual, teamId: null, fallbackName: teamName(sb.teamB) });\r\n  applyFittedText(contentEl.querySelector('.ov-zvs-name-local'), nombreLocal, NAME_FIT[variante], readTextAdjust(ta, `${variante}NombreLocal`));\r\n  applyFittedText(contentEl.querySelector('.ov-zvs-name-visitante'), nombreVisitante, NAME_FIT[variante], readTextAdjust(ta, `${variante}NombreVisitante`));\r\n\r\n  if (variante === 'goles') {\r\n    applyFittedText(contentEl.querySelector('.ov-zvs-gol-local'), String(sb.scoreA ?? '0'), GOL_FIT, readTextAdjust(ta, 'golesGolLocal'));\r\n    applyFittedText(contentEl.querySelector('.ov-zvs-gol-visitante'), String(sb.scoreB ?? '0'), GOL_FIT, readTextAdjust(ta, 'golesGolVisitante'));\r\n  }\r\n}\r\n","http://127.0.0.1:4430/shared/adjust-registry.js","// Registro declarativo de elementos editables por modulo (2026-08-31,\r\n// pedido explicito del usuario: \"que agregar un nuevo elemento editable\r\n// sea conceptualmente tan simple como definir id/label/xKey/yKey/\r\n// scaleKey/target\"). Fuente UNICA de verdad, importada tanto por\r\n// Master Control (arma el acordeon \"AJUSTE DE COMPOSICION\" -> ver\r\n// master-control/js/main.js \"renderModuleAdjustAccordion\") como por\r\n// Program (aplica los offsets -> ver program/js/main.js\r\n// \"applyElementAdjustRegistry\") -- evita mantener la misma lista de\r\n// ids/keys duplicada en dos lados.\r\n//\r\n// Cada entrada de \"elements\" es uno de dos tipos:\r\n//   - kind:'composition' -- para elementos NO textuales (escudos, logos,\r\n//     sponsors, guiones, iconos) o cualquier bloque que deba moverse/\r\n//     escalarse como unidad. Requiere:\r\n//       1. el renderer del modulo marca el nodo con data-adjust=\"<id>\"\r\n//          (sin logica nueva, solo el atributo en el template);\r\n//       2. shared/modules.js define <xKey>/<yKey>/<scaleKey> en los\r\n//          defaults del modulo (default 0/0/1, no-op);\r\n//       3. Program aplica el offset SOLO -- ver \"applyElementAdjustRegistry\"\r\n//          en program/js/main.js, corre junto a \"applyComposition\" para\r\n//          cualquier modulo con entradas de este tipo, sin codigo nuevo\r\n//          por elemento.\r\n//   - kind:'text' -- para texto que YA pasa por \"textAdjust\" (el mismo\r\n//     mecanismo de siempre, dx/dy/dSize, ver program/js/text-fit.js).\r\n//     No requiere nada nuevo en Program: el renderer ya llama\r\n//     readTextAdjust/applyPlainTextAdjust para ese campo. Solo declara\r\n//     que existe, para que el acordeon de Master Control lo muestre.\r\n//\r\n// \"COMPOSICION COMPLETA\" (compositionOffsetX/Y/Scale) NO se declara aca:\r\n// ya es universal para los 30 modulos via COMPOSITION_DEFAULTS\r\n// (shared/modules.js) y se agrega siempre, automaticamente, al\r\n// principio del acordeon -- ver renderModuleAdjustAccordion.\r\n//\r\n// \"crestTeam\" (2026-09-01, pedido explicito del usuario: \"la posicion de\r\n// un escudo tiene que guardarse POR equipo, no solo por slot\" -- los 4\r\n// equipos de Argentina Streamers tienen proporciones/pesos visuales muy\r\n// distintos). Marca, en una entrada \"kind:'composition'\" que es\r\n// especificamente un ESCUDO de equipo (nunca un logo/sponsor/guion), de\r\n// que lado sale el teamId que la identifica en runtime:\r\n//   'A'       -> siempre el equipo LOCAL del Marcador (scoreboard.teamA).\r\n//   'B'       -> siempre el equipo VISITANTE del Marcador (scoreboard.teamB).\r\n//   'dynamic' -> un unico slot que puede ser A o B segun otro campo del\r\n//                propio modulo (ej. tarjeta/cambios: data.equipo).\r\n// Master Control (renderModuleAdjustAccordion) y Program\r\n// (applyElementAdjustRegistry) son los DOS unicos lugares que leen este\r\n// campo -- ninguno de los renderers individuales necesita saber nada de\r\n// esto. Sin \"crestTeam\" (sponsors, logos, guiones, y los \"crest\" de\r\n// columna en tablas -- grupos/sideTable/posiciones/goleadores/etc., que\r\n// a proposito NO lo declaran) el elemento se comporta EXACTAMENTE igual\r\n// que siempre: una unica posicion/escala por slot, sin distincion de\r\n// equipo. Solo tiene efecto real cuando el theme activo es\r\n// argentinaStreamers -- GLA nunca puebla \"crestByTeam\" en su propio\r\n// arbol de datos, asi que esta logica cae siempre al camino de fallback\r\n// sin cambiar nada de su comportamiento.\r\n//\r\n// \"themeOnly\" (2026-09-01, pedido explicito del usuario: \"trabajar\r\n// unicamente sobre Argentina Streamers, no tocar GLA, no tocar otros\r\n// modulos\"). Marca una entrada como visible SOLO en el acordeon generico\r\n// de Master Control (renderModuleAdjustAccordion) cuando el theme activo\r\n// coincide -- Program (applyElementAdjustRegistry) la aplica igual para\r\n// cualquier theme, sin chequear \"themeOnly\" (es un concern de UI de\r\n// Master Control, no de renderizado): para GLA los campos que respalda\r\n// simplemente nunca se tocan/guardan, asi que quedan en su default\r\n// (0/0/1, no-op) para siempre. Usado por los 12 elementos nuevos de\r\n// \"marcadorPenales\" (10 circulos + 2 nombres) -- ninguna otra entrada del\r\n// registro lo necesita hoy.\r\nexport const ADJUST_REGISTRY = {\r\n  // MARCADOR (2026-08-31): migrado desde la funcion hecha a medida\r\n  // \"renderScoreboardAdjustAccordion\" -- mismo orden, mismas labels,\r\n  // mismo comportamiento, ahora descripto de forma declarativa.\r\n  scoreboard: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE / ABREVIATURA LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'scoreA', label: 'GOL LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      { id: 'separator', label: 'GUI\u00D3N', kind: 'composition', xKey: 'separatorOffsetX', yKey: 'separatorOffsetY', scaleKey: 'separatorScale' },\r\n      { id: 'scoreB', label: 'GOL VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      { id: 'nameB', label: 'NOMBRE / ABREVIATURA VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'clock', label: 'CONTADOR / RELOJ', kind: 'text', textKey: 'clock' },\r\n      { id: 'period', label: 'PER\u00CDODO', kind: 'text', textKey: 'period' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  // --- Tanda 1 ---\r\n  tarjeta: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale', crestTeam: 'dynamic' },\r\n      { id: 'jugador', label: 'JUGADOR', kind: 'text', textKey: 'jugador' },\r\n    ],\r\n  },\r\n  cambios: {\r\n    // \"titulo\" ELIMINADO (2026-09-01, pedido explicito del usuario) -- ver\r\n    // shared/modules.js y program/js/renderers/cambios.js.\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale', crestTeam: 'dynamic' },\r\n      { id: 'entra', label: 'JUGADOR ENTRA', kind: 'text', textKey: 'entra' },\r\n      { id: 'sale', label: 'JUGADOR SALE', kind: 'text', textKey: 'sale' },\r\n    ],\r\n  },\r\n  varCheck: {\r\n    elements: [\r\n      // \"varGroup\" (2026-08-31): bug pre-existente encontrado al probar\r\n      // esta tanda -- \".ov-var-group1\" leia directamente\r\n      // compositionOffsetX/Y/Scale (las mismas keys de \"COMPOSICI\u00D3N\r\n      // COMPLETA\"), y al ser hijo de \".content\" el offset quedaba\r\n      // compuesto DOS VECES solo para este grupo. Se separo en\r\n      // varGroupOffsetX/Y/Scale (ver shared/modules.js) -- ahora es un\r\n      // control legitimo e independiente (mueve SOLO el clip VAR +\r\n      // sponsor dentro del modulo), no redundante con \"COMPOSICI\u00D3N\r\n      // COMPLETA\".\r\n      { id: 'varGroup', label: 'GRUPO VAR (CLIP + SPONSOR)', kind: 'composition', xKey: 'varGroupOffsetX', yKey: 'varGroupOffsetY', scaleKey: 'varGroupScale' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n      // \"motivoGroup\" ya existe de antes (pre-fecha este registro, ver\r\n      // varCheck.js): el renderer YA lee motivoOffsetX/Y/Scale y mueve\r\n      // \".ov-var-motivo-group\" el solo en cada pasada -- no necesita\r\n      // data-adjust ni pasar por applyElementAdjustRegistry, se declara\r\n      // aca solo para que el acordeon de Master Control muestre su control.\r\n      { id: 'motivoGroup', label: 'MOTIVO COMPLETO', kind: 'composition', xKey: 'motivoOffsetX', yKey: 'motivoOffsetY', scaleKey: 'motivoScale' },\r\n      { id: 'motivo', label: 'TEXTO MOTIVO', kind: 'text', textKey: 'motivo' },\r\n    ],\r\n  },\r\n  replay: {\r\n    elements: [\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  bug: {\r\n    elements: [\r\n      { id: 'clock', label: 'RELOJ', kind: 'text', textKey: 'clock' },\r\n    ],\r\n  },\r\n  gol: {\r\n    // Sin panel propio en Master Control (HIDDEN_FROM_NAV_IDS, ver\r\n    // master-control/js/main.js): modulo oneShot disparado automaticamente\r\n    // por scoreGoal() al anotar un gol en el Marcador, sin datos propios\r\n    // que editar (fields: [] en shared/modules.js). Hereda\r\n    // compositionOffsetX/Y/Scale via COMPOSITION_DEFAULTS igual que\r\n    // cualquier otro modulo, pero no hay panel donde mostrar \"COMPOSICI\u00D3N\r\n    // COMPLETA\" -- excepcion documentada en el informe final, no una falta\r\n    // de cobertura.\r\n    elements: [],\r\n  },\r\n\r\n  // --- Resto de MARCADOR (2026-08-31) ---\r\n  marcadorTiempoAdicional: {\r\n    elements: [\r\n      { id: 'addedMinutes', label: 'MINUTOS AGREGADOS', kind: 'text', textKey: 'addedMinutes' },\r\n      { id: 'clock', label: 'RELOJ', kind: 'text', textKey: 'clock' },\r\n    ],\r\n  },\r\n  marcadorEntretiempo: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'ABREVIATURA LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'scoreA', label: 'GOL LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      // \"GUI\u00D3N / SEPARADOR\" (2026-09-04, pedido explicito del usuario):\r\n      // editor propio, independiente de los goles -- antes el \"-\" quedaba\r\n      // fijo/no editable en el HTML de buildStructure. \"themeOnly\" porque\r\n      // es un pedido exclusivo de Argentina Streamers (GLA no lo pidio, no\r\n      // se le agrega un control nuevo que no tenia).\r\n      { id: 'separador', label: 'GUI\u00D3N / SEPARADOR', kind: 'text', textKey: 'separador', themeOnly: 'argentinaStreamers' },\r\n      { id: 'scoreB', label: 'GOL VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      { id: 'nameB', label: 'ABREVIATURA VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  // Orden pedido explicitamente por el usuario (2026-08-31, correcci\u00F3n\r\n  // Marcador de Penales): COMPOSICI\u00D3N COMPLETA (universal, siempre\r\n  // primera) -> escudo local -> fila de penales local -> resultado local\r\n  // -> gui\u00F3n -> resultado visitante -> fila de penales visitante ->\r\n  // escudo visitante -> t\u00EDtulo -> sponsor. \"nameA\"/\"nameB\" (abreviatura)\r\n  // se mantienen al final: siguen existiendo para GLA (fila propia, sin\r\n  // relacion con el \"ARG PER\" que se retir\u00F3 del centro de Argentina\r\n  // Streamers -- ver overlay.css), no pedidos en la lista nueva pero\r\n  // tampoco a remover, mismo criterio que \"VIVO\" en bug.js (control\r\n  // universal, sin efecto visual donde el elemento esta oculto).\r\n  marcadorPenales: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'kicksLocal', label: 'FILA DE PENALES LOCAL', kind: 'composition', xKey: 'kicksLocalOffsetX', yKey: 'kicksLocalOffsetY', scaleKey: 'kicksLocalScale' },\r\n      { id: 'scoreA', label: 'RESULTADO LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      { id: 'separator', label: 'GUI\u00D3N DEL RESULTADO', kind: 'composition', xKey: 'separatorOffsetX', yKey: 'separatorOffsetY', scaleKey: 'separatorScale' },\r\n      { id: 'scoreB', label: 'RESULTADO VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      { id: 'kicksVisitante', label: 'FILA DE PENALES VISITANTE', kind: 'composition', xKey: 'kicksVisitanteOffsetX', yKey: 'kicksVisitanteOffsetY', scaleKey: 'kicksVisitanteScale' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'titulo', label: 'T\u00CDTULO \"PENALES\"', kind: 'text', textKey: 'titulo' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n      { id: 'nameA', label: 'ABREVIATURA LOCAL (solo GLA)', kind: 'text', textKey: 'nameA' },\r\n      { id: 'nameB', label: 'ABREVIATURA VISITANTE (solo GLA)', kind: 'text', textKey: 'nameB' },\r\n      // \"kickLocal{1-5}\"/\"kickVisitante{1-5}\" (2026-09-01, pedido explicito\r\n      // del usuario: control total por circulo desde Master Control, sin\r\n      // mas ajustes hardcodeados en CSS). \"themeOnly\" (ver docstring mas\r\n      // abajo) los mantiene invisibles para GLA en el acordeon generico;\r\n      // el panel dedicado de Argentina Streamers Penales\r\n      // (renderPenalesArgentinaAccordion en master-control/js/main.js) los\r\n      // agrupa en su propia seccion \"AJUSTE DE INTENTOS\" en vez de listarlos\r\n      // aca sueltos.\r\n      { id: 'kickLocal1', label: 'LOCAL 1', kind: 'composition', xKey: 'kickLocal1OffsetX', yKey: 'kickLocal1OffsetY', scaleKey: 'kickLocal1Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal2', label: 'LOCAL 2', kind: 'composition', xKey: 'kickLocal2OffsetX', yKey: 'kickLocal2OffsetY', scaleKey: 'kickLocal2Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal3', label: 'LOCAL 3', kind: 'composition', xKey: 'kickLocal3OffsetX', yKey: 'kickLocal3OffsetY', scaleKey: 'kickLocal3Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal4', label: 'LOCAL 4', kind: 'composition', xKey: 'kickLocal4OffsetX', yKey: 'kickLocal4OffsetY', scaleKey: 'kickLocal4Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickLocal5', label: 'LOCAL 5', kind: 'composition', xKey: 'kickLocal5OffsetX', yKey: 'kickLocal5OffsetY', scaleKey: 'kickLocal5Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante1', label: 'VISITANTE 1', kind: 'composition', xKey: 'kickVisitante1OffsetX', yKey: 'kickVisitante1OffsetY', scaleKey: 'kickVisitante1Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante2', label: 'VISITANTE 2', kind: 'composition', xKey: 'kickVisitante2OffsetX', yKey: 'kickVisitante2OffsetY', scaleKey: 'kickVisitante2Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante3', label: 'VISITANTE 3', kind: 'composition', xKey: 'kickVisitante3OffsetX', yKey: 'kickVisitante3OffsetY', scaleKey: 'kickVisitante3Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante4', label: 'VISITANTE 4', kind: 'composition', xKey: 'kickVisitante4OffsetX', yKey: 'kickVisitante4OffsetY', scaleKey: 'kickVisitante4Scale', themeOnly: 'argentinaStreamers' },\r\n      { id: 'kickVisitante5', label: 'VISITANTE 5', kind: 'composition', xKey: 'kickVisitante5OffsetX', yKey: 'kickVisitante5OffsetY', scaleKey: 'kickVisitante5Scale', themeOnly: 'argentinaStreamers' },\r\n      // \"nombreLocal\"/\"nombreVisitante\" (2026-09-01): nombre de broadcast\r\n      // en la franja azul arriba de cada fila de circulos -- ver\r\n      // shared/broadcast-names.js. Solo Argentina Streamers.\r\n      { id: 'nombreLocal', label: 'NOMBRE LOCAL', kind: 'text', textKey: 'nombreLocal', themeOnly: 'argentinaStreamers' },\r\n      { id: 'nombreVisitante', label: 'NOMBRE VISITANTE', kind: 'text', textKey: 'nombreVisitante', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  marcadorZocalo: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'clock', label: 'RELOJ', kind: 'text', textKey: 'clock' },\r\n    ],\r\n  },\r\n\r\n  // --- PLACAS ---\r\n  // \"formacionEquipos\" (2026-09-04, escudo con posicion propia POR EQUIPO\r\n  // en Argentina Streamers, pedido explicito del usuario -- \"no tocar GLA\"\r\n  // es regla absoluta de esta tarea). \"playerName\"/\"playerNumber\"/\r\n  // \"subsTitle\"/\"subsList\" ya tienen su propio control dentro de \"AJUSTE\r\n  // DE TEXTOS\" del panel dedicado (2026-08-31, ver\r\n  // master-control/js/formation-list-panel.js), no se declaran aca.\r\n  // \"crest\" (escudo) queda SOLO para GLA (\"themeOnly:'gla'\"): Argentina\r\n  // Streamers tiene su propia seccion dedicada en el panel (\"ESCUDO\",\r\n  // buildCrestSection) que guarda por teamId (data.crestByTeam[teamId],\r\n  // mismo criterio que \"formationKitByTeam\" un poco mas abajo en ese mismo\r\n  // panel) -- dejar tambien esta entrada generica plana visible para ese\r\n  // theme duplicaria el control de forma confusa. GLA sigue exactamente\r\n  // igual que antes de esta tarea: mismo id/label/xKey/yKey/scaleKey,\r\n  // mismo \"data-adjust=crest\" en el renderer (ver mas abajo, gateado por\r\n  // theme).\r\n  formacionEquipos: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO EQUIPO ACTIVO', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale', themeOnly: 'gla' },\r\n    ],\r\n  },\r\n\r\n  vsPrepartido: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE EQUIPO LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'nameB', label: 'NOMBRE EQUIPO VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  vsResultado: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE EQUIPO LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'scoreA', label: 'GOL LOCAL', kind: 'text', textKey: 'scoreA' },\r\n      { id: 'scoreB', label: 'GOL VISITANTE', kind: 'text', textKey: 'scoreB' },\r\n      // \"scoreSep\" (2026-10-08): guion dinamico entre goles, SOLO Argentina\r\n      // Streamers (GLA usa el guion que ya trae su asset) -- control propio\r\n      // con GUARDAR POSICI\u00D3N, independiente de los dos goles.\r\n      { id: 'scoreSep', label: 'GUI\u00D3N ENTRE GOLES', kind: 'text', textKey: 'scoreSep', themeOnly: 'argentinaStreamers' },\r\n      { id: 'nameB', label: 'NOMBRE EQUIPO VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  // \"estrellas\": solo \"crest\" (composition) via el acordeon generico --\r\n  // \"titulo\"/\"localNombre\"/\"localG\"/etc. YA tienen su propio control (con\r\n  // GUARDAR POSICI\u00D3N) en la seccion \"AJUSTE DE TEXTOS\" del panel dedicado\r\n  // (2026-08-31, ver master-control/js/estrellas-panel.js) -- declararlos\r\n  // tambien aca duplicaria el control.\r\n  estrellas: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'visitanteCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'visitanteCrestOffsetX', yKey: 'visitanteCrestOffsetY', scaleKey: 'visitanteCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n\r\n  // --- EVENTOS / ZOCALOS ---\r\n  longDouble: {\r\n    elements: [\r\n      { id: 'line1', label: 'T\u00CDTULO PRINCIPAL', kind: 'text', textKey: 'line1' },\r\n      { id: 'line2', label: 'SUBT\u00CDTULO / BAJADA', kind: 'text', textKey: 'line2' },\r\n    ],\r\n  },\r\n  shortSimple: {\r\n    elements: [\r\n      { id: 'text', label: 'TEXTO', kind: 'text', textKey: 'text' },\r\n    ],\r\n  },\r\n  // \"shortDouble\": sin entradas -- \"name\"/\"role\"/\"double1.name\"/etc. YA\r\n  // tienen su propio control (con GUARDAR POSICI\u00D3N) en el panel dedicado\r\n  // (2026-08-31, ver master-control/js/short-double-panel.js), y el\r\n  // modulo no tiene ningun escudo/logo/sponsor sin ajuste. Solo\r\n  // \"COMPOSICI\u00D3N COMPLETA\" (universal) aplica aca.\r\n  shortDouble: {\r\n    elements: [],\r\n  },\r\n  vs: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'nameA', label: 'NOMBRE EQUIPO LOCAL', kind: 'text', textKey: 'nameA' },\r\n      { id: 'goalA', label: 'GOL LOCAL', kind: 'text', textKey: 'goalA' },\r\n      // \"scorersLocal\"/\"scorersVisitante\" (2026-09-10, VS COMPACTO\r\n      // simplificado, pedido explicito del usuario: \"eliminar\r\n      // GOLEADORES LOCAL/VISITANTE\") -- eliminadas junto con los campos\r\n      // que ajustaban.\r\n      { id: 'statusTexto', label: 'CONTENIDO CENTRAL', kind: 'text', textKey: 'statusTexto' },\r\n      { id: 'goalB', label: 'GOL VISITANTE', kind: 'text', textKey: 'goalB' },\r\n      { id: 'nameB', label: 'NOMBRE EQUIPO VISITANTE', kind: 'text', textKey: 'nameB' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  // Z\u00D3CALO VS (2026-10-09, solo Argentina Streamers). \"variant\": la entrada\r\n  // solo se muestra en el acordeon cuando \"data.variante\" coincide (cada\r\n  // variante tiene sus propias claves). \"crestSlot\": slot propio dentro de\r\n  // \"crestByTeam\" (en vez de local/away), asi cada escudo guarda su\r\n  // posicion por VARIANTE + SLOT + EQUIPO. El \"VS\" esta horneado en el\r\n  // asset: no tiene entrada propia (se mueve con COMPOSICI\u00D3N COMPLETA).\r\n  zocaloVs: {\r\n    elements: [\r\n      { id: 'soloLocalCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'soloLocalCrestOffsetX', yKey: 'soloLocalCrestOffsetY', scaleKey: 'soloLocalCrestScale', crestTeam: 'A', crestSlot: 'soloLocal', variant: 'solo' },\r\n      { id: 'soloNombreLocal', label: 'NOMBRE LOCAL', kind: 'text', textKey: 'soloNombreLocal', variant: 'solo' },\r\n      { id: 'soloNombreVisitante', label: 'NOMBRE VISITANTE', kind: 'text', textKey: 'soloNombreVisitante', variant: 'solo' },\r\n      { id: 'soloAwayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'soloAwayCrestOffsetX', yKey: 'soloAwayCrestOffsetY', scaleKey: 'soloAwayCrestScale', crestTeam: 'B', crestSlot: 'soloAway', variant: 'solo' },\r\n      { id: 'golesLocalCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'golesLocalCrestOffsetX', yKey: 'golesLocalCrestOffsetY', scaleKey: 'golesLocalCrestScale', crestTeam: 'A', crestSlot: 'golesLocal', variant: 'goles' },\r\n      { id: 'golesNombreLocal', label: 'NOMBRE LOCAL', kind: 'text', textKey: 'golesNombreLocal', variant: 'goles' },\r\n      { id: 'golesGolLocal', label: 'GOL LOCAL', kind: 'text', textKey: 'golesGolLocal', variant: 'goles' },\r\n      { id: 'golesGolVisitante', label: 'GOL VISITANTE', kind: 'text', textKey: 'golesGolVisitante', variant: 'goles' },\r\n      { id: 'golesNombreVisitante', label: 'NOMBRE VISITANTE', kind: 'text', textKey: 'golesNombreVisitante', variant: 'goles' },\r\n      { id: 'golesAwayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'golesAwayCrestOffsetX', yKey: 'golesAwayCrestOffsetY', scaleKey: 'golesAwayCrestScale', crestTeam: 'B', crestSlot: 'golesAway', variant: 'goles' },\r\n    ],\r\n  },\r\n  zocaloCompuesto: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'logo', label: 'LOGO GLA', kind: 'composition', xKey: 'logoOffsetX', yKey: 'logoOffsetY', scaleKey: 'logoScale' },\r\n      { id: 'texto1', label: 'TEXTO 1', kind: 'text', textKey: 'texto1' },\r\n      { id: 'texto2', label: 'TEXTO 2', kind: 'text', textKey: 'texto2' },\r\n      // \"sponsors\" (2026-09-24, pedido explicito: \"un unico ajuste de\r\n      // composicion para TODOS los sponsors del rotativo\", ver comentario\r\n      // completo en shared/modules.js) -- UNA sola entrada en vez de\r\n      // \"sponsor1\"/\"sponsor2\": aplicarModuleAdjustRegistry (program/js/\r\n      // main.js) ya soporta un mismo \"data-adjust\" marcando VARIOS nodos\r\n      // (mismo mecanismo que \"crest\" de columna en grupos/sideTable), asi\r\n      // que alcanza con que los 2 <img> del rotativo compartan este mismo\r\n      // id (ver program/js/renderers/zocaloCompuesto.js).\r\n      { id: 'sponsors', label: 'SPONSORS', kind: 'composition', xKey: 'sponsorsOffsetX', yKey: 'sponsorsOffsetY', scaleKey: 'sponsorsScale' },\r\n    ],\r\n  },\r\n  // Unica entrada de cada uno (2026-09-02, auditoria de wiring): habia una\r\n  // segunda entrada duplicada mas abajo en este objeto, sin \"sponsor\" -- en\r\n  // un literal de objeto JS la clave repetida MAS TARDE gana, asi que esa\r\n  // version incompleta (sin editor de posicion de sponsor en el acordeon\r\n  // generico) era la que realmente terminaba en ADJUST_REGISTRY, no esta.\r\n  // Se elimino el duplicado.\r\n  // Unificado con \"zocaloCompuestoLogo\" (2026-09-10, ver shared/modules.js)\r\n  // -- lleva las entradas de AMBOS tipos a la vez (escudos Y logo), asi el\r\n  // operador puede dejar las dos posiciones configuradas de antemano sin\r\n  // importar con cual \"tipo\" este trabajando en un momento dado.\r\n  zocaloCompuestoEquipos: {\r\n    elements: [\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n      { id: 'logo', label: 'LOGO LOCALSTRIKE', kind: 'composition', xKey: 'logoOffsetX', yKey: 'logoOffsetY', scaleKey: 'logoScale' },\r\n      { id: 'texto1', label: 'TEXTO MAIN (TIRA AZUL)', kind: 'text', textKey: 'texto1' },\r\n      { id: 'texto2', label: 'SUBTEXTO (TIRA VERDE)', kind: 'text', textKey: 'texto2' },\r\n      { id: 'sponsor', label: 'SPONSOR', kind: 'composition', xKey: 'sponsorOffsetX', yKey: 'sponsorOffsetY', scaleKey: 'sponsorScale' },\r\n    ],\r\n  },\r\n  // LEGACY -- ver \"zocaloCompuestoLogo\" en shared/modules.js. Sin entrada\r\n  // propia: modulo oculto de toda navegacion, ya no editable.\r\n  // \"zocaloFinal\"/\"zocaloFinalDiv\" (2026-08-31): sin entrada de registro.\r\n  // HIDDEN_FROM_NAV_IDS (ver master-control/js/main.js) -- reemplazados\r\n  // por \"zocaloCompuesto\" (2026-08-16), sin panel propio en Master Control\r\n  // donde mostrar ningun acordeon. Excepcion documentada en el informe\r\n  // final, no una falta de cobertura.\r\n\r\n  // --- GRUPOS / BRACKETS / TABLAS ---\r\n  // Las 6 entradas de abajo (grupos/sideTable/posiciones/posicionesTorneo/\r\n  // goleadores/asistidores/jugadores) declaran SOLO \"crest\" (composition):\r\n  // todos los demas campos (titulo/nombre/puntos/numero/equipo/pts/pj/g/\r\n  // gxp/pxp/p/gf/gc/dg/golLocal/golVisitante/estado/estadoFullscreen/\r\n  // tituloBracket/position/name/primaryStat/stat0/stat1/stat2) YA tienen\r\n  // su propio control por columna (con GUARDAR POSICI\u00D3N) dentro de la\r\n  // seccion \"AJUSTE DE TEXTOS\"/\"AJUSTE DE COMPOSICI\u00D3N\" de cada panel\r\n  // dedicado (2026-08-31, ver grupos-panel.js, resultados-panel.js,\r\n  // posiciones-panel.js, performance-table-panel.js) -- declararlos aca\r\n  // tambien duplicaria el control. \"crest\" es el unico elemento\r\n  // genuinamente nuevo (escudo por fila/columna, nunca tuvo ajuste propio).\r\n  grupos: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n    ],\r\n  },\r\n  sideTable: {\r\n    elements: [\r\n      { id: 'crestLocal', label: 'ESCUDO LOCAL (COLUMNA)', kind: 'composition', xKey: 'crestLocalOffsetX', yKey: 'crestLocalOffsetY', scaleKey: 'crestLocalScale' },\r\n      { id: 'crestVisitante', label: 'ESCUDO VISITANTE (COLUMNA)', kind: 'composition', xKey: 'crestVisitanteOffsetX', yKey: 'crestVisitanteOffsetY', scaleKey: 'crestVisitanteScale' },\r\n    ],\r\n  },\r\n  posiciones: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n    ],\r\n  },\r\n  posicionesTorneo: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n    ],\r\n  },\r\n  goleadores: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n      // \"ESCUDO T\u00CDTULO\" (2026-09-04, pedido explicito del usuario): escudo\r\n      // FIJO de Argentina Streamers masculino a la izquierda del titulo de\r\n      // la placa de 10 filas -- no depende del Marcador, por eso no lleva\r\n      // \"crestTeam\". Solo Argentina Streamers (GLA no tiene esa zona).\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  asistidores: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  jugadores: {\r\n    elements: [\r\n      { id: 'crest', label: 'ESCUDO (COLUMNA)', kind: 'composition', xKey: 'crestOffsetX', yKey: 'crestOffsetY', scaleKey: 'crestScale' },\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale', themeOnly: 'argentinaStreamers' },\r\n    ],\r\n  },\r\n  // \"fichaJugador\" (rehecho en BLOQUE 4, 2026-09-09, sobre el asset real\r\n  // -- ver assets/themes/argentina-streamers/tablas/ficha-jugador.png):\r\n  // el dise\u00F1o real NO tiene recuadro de escudo (solo z\u00F3calo con nombre +\r\n  // 4 recuadros de estad\u00EDstica), asi que no hay entrada \"kind:composition\"\r\n  // aca -- la unica composicion editable es la generica del modulo entero\r\n  // (\"COMPOSICI\u00D3N COMPLETA\", agregada automaticamente por\r\n  // renderModuleAdjustAccordion sin declararla aca). Los 5 textos (nombre\r\n  // + 4 stats) ya tienen su propio ajuste via \"textAdjust\" (ver\r\n  // shared/modules.js), mostrado por el mismo acordeon sin necesitar una\r\n  // entrada \"kind:text\" -- ese camino ya es generico para cualquier modulo\r\n  // con \"textAdjust\" no vacio via los campos ADJUST_ONLY/adjustable de\r\n  // \"fields\" en shared/modules.js; \"fichaJugador\" no usa \"fields\" (panel\r\n  // dedicado, ver ficha-jugador-panel.js), asi que sus ajustes de texto se\r\n  // muestran directo desde ese panel, no desde este registro.\r\n  fichaJugador: {\r\n    elements: [],\r\n  },\r\n  // \"historial\" (2026-09-02, reconstruido desde cero sobre el PNG real --\r\n  // ver informe): sin panel dedicado de composicion propio, el acordeon\r\n  // generico alcanza para las 4 columnas (2 escudos + 2 goles) mas\r\n  // \"COMPOSICI\u00D3N COMPLETA\" automatica -- mismo criterio \"column-level\" que\r\n  // goleadores/asistidores/jugadores arriba, un unico ajuste se aplica a\r\n  // las 5 filas por igual.\r\n  historial: {\r\n    // \"titulo\" (2026-09-04, pedido explicito del usuario: \"posicion/escala\r\n    // INDEPENDIENTE por categoria, no una unica posicion global\") ya NO\r\n    // vive aca -- el acordeon generico solo sabe escribir un unico\r\n    // \"textAdjust.titulo\" compartido por las 4 categorias, que es\r\n    // exactamente lo que el usuario no quiere. Su control propio (uno por\r\n    // categoria, sobre \"data.tituloByCategoria[tipoHistorial]\") vive\r\n    // directo en master-control/js/historial-panel.js, reusando el mismo\r\n    // componente generico (renderTextAdjustControl) por fuera de este\r\n    // registro. \"ESCUDO T\u00CDTULO\" (2026-09-04, mismo pedido, item 7: mismo\r\n    // escudo Argentina Streamers masculino que ya usan\r\n    // goleadores/asistidores/jugadores) SI sigue aca -- no depende del\r\n    // largo del texto, un unico ajuste alcanza para las 4 categorias.\r\n    // \"GOL LOCAL\"/\"GOL VISITANTE\"/\"PENALES LOCAL\"/\"PENALES VISITANTE\" como\r\n    // columnas independientes YA NO viven aca (2026-09-04, pedido explicito\r\n    // del usuario: \"eliminar la edicion independiente... los dos goles\r\n    // deben moverse juntos\", con geometria completamente separada segun si\r\n    // la fila tiene penales o no). Reemplazados por 3 controles propios\r\n    // (\"RESULTADO NORMAL\"/\"RESULTADO CON PENALES\"/\"PENALES\") que viven\r\n    // directo en master-control/js/historial-panel.js -- igual criterio\r\n    // que \"titulo\" arriba: el acordeon generico solo sabe escribir UN\r\n    // textAdjust por columna, aplicado sin condicion a las 5 filas, que es\r\n    // exactamente lo que este pedido prohibe (mover el bloque de penales\r\n    // NO puede tocar las filas sin penales). Ver\r\n    // program/js/renderers/historial.js para la logica de aplicacion\r\n    // condicional real.\r\n    elements: [\r\n      { id: 'tituloCrest', label: 'ESCUDO T\u00CDTULO', kind: 'composition', xKey: 'tituloCrestOffsetX', yKey: 'tituloCrestOffsetY', scaleKey: 'tituloCrestScale' },\r\n      { id: 'crestLocal', label: 'ESCUDO LOCAL (COLUMNA)', kind: 'composition', xKey: 'crestLocalOffsetX', yKey: 'crestLocalOffsetY', scaleKey: 'crestLocalScale' },\r\n      { id: 'crestVisitante', label: 'ESCUDO VISITANTE (COLUMNA)', kind: 'composition', xKey: 'crestVisitanteOffsetX', yKey: 'crestVisitanteOffsetY', scaleKey: 'crestVisitanteScale' },\r\n      // \"FASE / INSTANCIA\" (2026-09-04, pedido explicito del usuario, item\r\n      // 3: \"manejarlo como bloque/columna comun ya que todos los slots\r\n      // comparten geometria\") -- mismo criterio por columna, dato real\r\n      // (\"stage\" de la web) por fila, un unico ajuste para las 5.\r\n      { id: 'fase', label: 'FASE / INSTANCIA (COLUMNA)', kind: 'text', textKey: 'fase' },\r\n    ],\r\n  },\r\n  // \"cronogramaHoy\" (2026-09-02, reconstruido desde cero sobre el PNG real\r\n  // -- ver informe): escudos con \"crestTeam\" (posicion propia por teamId\r\n  // real del Marcador, mismo mecanismo ya probado en zocaloCompuestoEquipos/\r\n  // marcadorPenales) -- nunca un selector de equipo propio, pedido\r\n  // explicito del usuario.\r\n  cronogramaHoy: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'crestLocal', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'crestLocalOffsetX', yKey: 'crestLocalOffsetY', scaleKey: 'crestLocalScale', crestTeam: 'A' },\r\n      { id: 'crestVisitante', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'crestVisitanteOffsetX', yKey: 'crestVisitanteOffsetY', scaleKey: 'crestVisitanteScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n  // \"resultadosParciales\" (2026-09-03, reconstruido desde cero sobre\r\n  // VS_RESULTADO.png real -- correcci\u00F3n expl\u00EDcita del usuario, confirmada\r\n  // por AskUserQuestion): un solo partido, escudos con \"crestTeam\" (mismo\r\n  // mecanismo que cronogramaHoy/vsResultado) + resultado LOCAL/VISITANTE\r\n  // como texto (heredado en vivo del Marcador, sin selector de equipo\r\n  // propio). \"titulo\" ya tiene panel dedicado (resultados-parciales-panel.js)\r\n  // pero se declara aca igual para que el acordeon lo muestre con GUARDAR\r\n  // POSICI\u00D3N, mismo criterio que el resto del proyecto.\r\n  resultadosParciales: {\r\n    elements: [\r\n      { id: 'titulo', label: 'T\u00CDTULO', kind: 'text', textKey: 'titulo' },\r\n      { id: 'localCrest', label: 'ESCUDO LOCAL', kind: 'composition', xKey: 'localCrestOffsetX', yKey: 'localCrestOffsetY', scaleKey: 'localCrestScale', crestTeam: 'A' },\r\n      { id: 'scoreLocal', label: 'RESULTADO LOCAL', kind: 'text', textKey: 'scoreLocal' },\r\n      { id: 'scoreVisitante', label: 'RESULTADO VISITANTE', kind: 'text', textKey: 'scoreVisitante' },\r\n      { id: 'awayCrest', label: 'ESCUDO VISITANTE', kind: 'composition', xKey: 'awayCrestOffsetX', yKey: 'awayCrestOffsetY', scaleKey: 'awayCrestScale', crestTeam: 'B' },\r\n    ],\r\n  },\r\n};\r\n","http://127.0.0.1:4430/program/js/text-fit.js","// Ajuste de tama\u00F1o de fuente responsivo + correccion de centrado vertical,\r\n// mismo criterio ya validado en Tarjeta/Cambios/Marcador de Penales\r\n// (ver program/js/renderers/tarjeta.js): estimacion proporcional rapida +\r\n// ajuste fino con canvas.measureText, para que textos cortos se vean\r\n// grandes y textos largos se achiquen solo lo necesario para entrar en el\r\n// ancho disponible, mas una correccion de centrado vertical que compensa\r\n// que \"align-items:center\" centra la caja de linea de la fuente (no la\r\n// tinta real). Se centraliza aca en vez de reescribir esta logica en cada\r\n// renderer nuevo \u2014 no reemplaza la ya existente en tarjeta.js/cambios.js\r\n// (que sigue funcionando igual, sin tocar).\r\n\r\nimport { getProgramFontFamily } from './program-fonts.js';\r\n\r\n// \"TODO texto en Program debe ir en MAY\u00DASCULA\" (2026-08-16, pedido\r\n// explicito del usuario): transformacion en la CAPA DE RENDER unicamente\r\n// -- nunca toca lo que Master Control guarda/envia (\"Gran Final\" se sigue\r\n// guardando y editando tal cual), solo lo que termina pintado en pantalla.\r\n// Centralizada aca porque \"applyFittedText\"/\"applyPlainTextAdjust\"/\r\n// \"applyFittedLines\" son el punto de paso casi universal de texto visible\r\n// del proyecto -- un solo lugar en vez de tocar cada renderer. Solo\r\n// mayuscula strings (numeros/otros tipos pasan sin cambios); las pocas\r\n// piezas con logica de texto duplicada localmente (no pasan por estas\r\n// funciones, ver grep de \"textContent =\" en program/js/renderers) usan\r\n// este mismo helper importado explicitamente.\r\nexport function toBroadcastUpper(text) {\r\n  return typeof text === 'string' ? text.toUpperCase() : text;\r\n}\r\n\r\nlet measureCtx = null;\r\nfunction getCtx() {\r\n  if (!measureCtx) measureCtx = document.createElement('canvas').getContext('2d');\r\n  return measureCtx;\r\n}\r\n\r\n// \"family\" (2026-09-24, pedido explicito del usuario: \"Segoe UI Bold\" en\r\n// 4 modulos puntuales, NO en el resto de GLA): override OPCIONAL de la\r\n// familia a usar para ESTA medicion puntual -- sin pasarlo (la inmensa\r\n// mayoria de los ~25 call sites del proyecto), sigue resolviendo\r\n// exactamente igual que siempre via getProgramFontFamily() (la fuente del\r\n// theme activo completo), cero cambio de comportamiento. Los 4 renderers\r\n// afectados (longSimple/shortSimple/shortDouble/zocaloCompuesto) pasan\r\n// GLA_SEGOE_BOLD_FAMILY (program/js/program-fonts.js) aca para que lo que\r\n// se MIDE coincida con lo que el CSS de esos modulos pinta de verdad (ver\r\n// override de \"--font-display\" en program/css/theme.css) -- si no\r\n// coincidieran, el auto-ajuste de tama\u00F1o calcularia anchos con la fuente\r\n// equivocada.\r\nfunction setFont(fontPx, weight, letterSpacing, family) {\r\n  const ctx = getCtx();\r\n  ctx.font = `${weight} ${fontPx}px ${family || getProgramFontFamily()}`;\r\n  ctx.letterSpacing = `${letterSpacing || 0}px`;\r\n  return ctx;\r\n}\r\n\r\nexport function measureTextWidth(text, fontPx, { weight = 700, letterSpacing = 0, family } = {}) {\r\n  const ctx = setFont(fontPx, weight, letterSpacing, family);\r\n  return ctx.measureText(text).width;\r\n}\r\n\r\n// maxFont/minFont/maxWidth en px; weight/letterSpacing deben coincidir con\r\n// el CSS real del elemento o la medicion queda mal.\r\nexport async function fitFontSize(text, { maxFont, minFont, maxWidth, weight = 700, letterSpacing = 0, family }) {\r\n  await document.fonts.load(`${weight} ${maxFont}px ${family || getProgramFontFamily()}`);\r\n  const widthAtMax = measureTextWidth(text, maxFont, { weight, letterSpacing, family });\r\n  if (widthAtMax <= maxWidth) return maxFont;\r\n  let size = Math.floor(maxFont * (maxWidth / widthAtMax));\r\n  size = Math.max(minFont, size);\r\n  while (size > minFont && measureTextWidth(text, size, { weight, letterSpacing, family }) > maxWidth) {\r\n    size -= 1;\r\n  }\r\n  return size;\r\n}\r\n\r\n// Referencia FIJA para la mitad \"de tinta\" de la correccion (2026-08-06,\r\n// causa real de un bug reportado por el usuario: textos largos en los\r\n// zocalos se desplazaban en Y al reducirse automaticamente de tama\u00F1o).\r\n// Esta funcion antes media \"actualBoundingBoxAscent/Descent\" del TEXTO\r\n// REAL que se le pasaba -- esos dos valores describen la tinta especifica\r\n// de las letras presentes en ESE string puntual, no una propiedad del\r\n// font en si. Mientras el texto no tuviera ninguna letra con trazo por\r\n// debajo de la linea de base, el resultado era estable (~0 en la practica,\r\n// verificado en vivo); apenas aparecia una letra con ese trazo en la\r\n// fuente real (ej. la \"Q\" de \"EQUIPO\", tambien J/G segun la fuente) la\r\n// correccion saltaba a un valor distinto SOLO para ese texto puntual --\r\n// coincidia con textos largos en las pruebas porque un texto mas largo\r\n// tiene mas chances de incluir alguna de esas letras, pero la causa real\r\n// no era la longitud ni el tama\u00F1o reducido: era que letra especifica\r\n// aparecia en el string.\r\n// Fix estructural: la mitad de tinta se mide SIEMPRE contra esta\r\n// referencia fija (mayusculas representativas sin descendentes, mas los\r\n// acentos/\u00D1 que en esta fuente son el caso de mayor ascendente) en vez de\r\n// contra el texto real -- asi el resultado es identico sin importar que\r\n// letras, cuantos caracteres o que tama\u00F1o resulte del auto-ajuste. Para\r\n// cualquier texto tipico de este sistema (mayusculas, sin descendentes)\r\n// el valor coincide con el que ya daba el calculo anterior -- por eso los\r\n// modulos que ya se veian bien centrados no deberian moverse -- y para los\r\n// que antes tenian una letra \"rara\" ahora dan el mismo resultado que el\r\n// resto en vez de un offset propio.\r\nconst VCORRECTION_REFERENCE = 'HOX\u00C1\u00C9\u00CD\u00D3\u00DA\u00D1';\r\n\r\nexport function verticalCorrection(text, fontPx, { weight = 700, letterSpacing = 0, family } = {}) {\r\n  const ctx = setFont(fontPx, weight, letterSpacing, family);\r\n  const m = ctx.measureText(VCORRECTION_REFERENCE);\r\n  const lineBoxAscent = m.fontBoundingBoxAscent;\r\n  const lineBoxDescent = m.fontBoundingBoxDescent;\r\n  const inkAscent = m.actualBoundingBoxAscent;\r\n  const inkDescent = m.actualBoundingBoxDescent;\r\n  return -((lineBoxAscent - lineBoxDescent) / 2 + (inkDescent - inkAscent) / 2);\r\n}\r\n\r\n// Aplica fitFontSize + verticalCorrection sobre un elemento de una sola\r\n// linea en un solo paso (el caso comun: textContent + font-size +\r\n// transform, los tres juntos).\r\n//\r\n// \"adjust\" (2026-08-14, pedido explicito del usuario: herramienta de\r\n// edicion manual de posicion/tama\u00F1o por campo de texto, sin tocar codigo)\r\n// -- offsets OPCIONALES del operador, guardados junto al preset del\r\n// modulo (ver \"textAdjust\" en shared/modules.js) y aplicados ACA, como\r\n// una capa mas encima de lo que esta funcion ya calculaba, nunca en\r\n// lugar de eso: \"posicion final = posicion dise\u00F1o + ajuste operador\".\r\n// Parametro con default {} para que cualquier llamado existente sin este\r\n// 4to argumento (la inmensa mayoria del proyecto) seguya funcionando\r\n// IDENTICO a antes -- con dx=dy=dSize=0 el resultado es exactamente el\r\n// mismo que \"translateY(verticalCorrection(...))\" de siempre (translate(0,Y)\r\n// es lo mismo que translateY(Y)), cero cambio visual donde no se pida.\r\n// Se aplica en el MISMO estilo inline que ya pisa esta funcion (fontSize/\r\n// transform) en vez de agregar una capa CSS aparte, porque son\r\n// precisamente esos dos estilos los que closures previos de este archivo\r\n// (ver comentario de \".ov-estrellas-titulo\" en overlay.css, y varios mas)\r\n// identificaron como los que SIEMPRE gana esta funcion sobre cualquier\r\n// regla puesta en CSS -- centralizar el ajuste aca evita reabrir ese\r\n// mismo problema con una tercera fuente de verdad sobre la posicion.\r\nexport async function applyFittedText(el, text, opts, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  // Mayuscula ANTES de medir (no solo al pintar): si se midiera el texto\r\n  // original y se mostrara en mayuscula, el ancho real (mas ancho en\r\n  // mayuscula) podria desbordar la caja -- fitFontSize tiene que ver\r\n  // exactamente el mismo string que termina en pantalla.\r\n  const upperText = toBroadcastUpper(text);\r\n  el.textContent = upperText;\r\n  const baseSize = await fitFontSize(upperText, opts);\r\n  const size = Math.max(1, baseSize + dSize);\r\n  el.style.fontSize = `${size}px`;\r\n  el.style.transform = `translate(${dx}px, ${verticalCorrection(upperText, size, opts) + dy}px)`;\r\n  return size;\r\n}\r\n\r\nexport async function updateFittedTextWithTransition(el, newText, oldText, opts, adjust = {}, isExplicitUpdate = false) {\r\n  if (isExplicitUpdate && oldText !== undefined && oldText !== newText) {\r\n    el.style.transition = 'opacity 0.18s ease-out';\r\n    el.style.opacity = '0';\r\n    setTimeout(async () => {\r\n      await applyFittedText(el, newText, opts, adjust);\r\n      el.style.opacity = '1';\r\n    }, 180);\r\n  } else {\r\n    await applyFittedText(el, newText, opts, adjust);\r\n  }\r\n}\r\n\r\n// Lee el ajuste guardado de un campo puntual dentro de \"data.textAdjust\"\r\n// (ver shared/modules.js) sin romper si el modulo todavia no lo tiene\r\n// (estado viejo persistido de antes de este cambio) -- siempre devuelve\r\n// un objeto valido para pasarle directo a \"applyFittedText\" como 4to\r\n// argumento. \"key\" admits rutas planas tipo \"double1.name\" (asi se\r\n// guardan, no como objetos anidados: ver shortDouble en shared/modules.js).\r\nexport function readTextAdjust(textAdjust, key) {\r\n  return (textAdjust && textAdjust[key]) || {};\r\n}\r\n\r\n// Ajuste manual (2026-08-15, auditoria completa pedida por el usuario:\r\n// \"TODO texto visible en Program debe poder ajustarse individualmente\")\r\n// para textos que NO pasan por fitFontSize/applyFittedText -- abreviaturas\r\n// de equipo, goles, reloj/contador, numeros de camiseta, etc., que hoy se\r\n// pintan con \"el.textContent = valor\" directo y tama\u00F1o FIJO por CSS (sin\r\n// auto-reduccion, no hace falta volver a implementar eso aca).\r\n//\r\n// Usa \"el.style.translate\" (propiedad CSS independiente de \"transform\",\r\n// no el shorthand \"transform: translate(...)\") para el offset de\r\n// posicion: varios de estos elementos YA tienen su propio \"transform\"\r\n// declarado en CSS (ej. \".ov-score\", ajustado en una vuelta anterior) o\r\n// podrian sumar uno en el futuro -- \"translate\" se COMPONE con cualquier\r\n// \"transform\" existente sin pisarlo (verificado en vivo: un elemento con\r\n// \"transform: translateY(-1px)\" en CSS + \"el.style.translate = '6px -4px'\"\r\n// via JS termina desplazado (+6,-5) en pantalla, la suma exacta de\r\n// ambos), asi que dx=dy=0 nunca cambia nada sin importar que transform de\r\n// dise\u00F1o ya tenga el elemento, sin necesidad de leerlo/duplicarlo aca.\r\n//\r\n// El tama\u00F1o BASE (para poder sumarle \"dSize\") se toma la PRIMERA vez de\r\n// \"getComputedStyle\" (el valor real que ya definio el CSS) y se cachea en\r\n// el dataset del propio nodo -- no hay que duplicar el font-size de cada\r\n// clase en JS, y sigue funcionando aunque ese valor cambie de dise\u00F1o en\r\n// el futuro (la proxima vez que el nodo se recree desde cero, se vuelve a\r\n// leer fresco).\r\nexport function applyPlainTextAdjust(el, text, adjust = {}) {\r\n  const { dx = 0, dy = 0, dSize = 0 } = adjust;\r\n  el.textContent = toBroadcastUpper(text);\r\n  el.style.translate = `${dx}px ${dy}px`;\r\n  if (dSize) {\r\n    if (!el.dataset.baseFontSize) {\r\n      el.dataset.baseFontSize = parseFloat(getComputedStyle(el).fontSize) || 0;\r\n    }\r\n    const base = parseFloat(el.dataset.baseFontSize) || 0;\r\n    el.style.fontSize = `${Math.max(1, base + dSize)}px`;\r\n  } else if (el.style.fontSize) {\r\n    el.style.removeProperty('font-size');\r\n  }\r\n}\r\n\r\n// Ajuste manual para elementos NO textuales (escudos <img>, el guion\r\n// estatico del marcador, etc. -- 2026-08-31, pedido explicito del\r\n// usuario: \"cada elemento visual debe poder moverse Y ESCALARSE por\r\n// separado\"). Deliberadamente separado de \"applyPlainTextAdjust\": no\r\n// toca \"textContent\" (romper\u00EDa una <img> o un separador con texto fijo\r\n// ya puesto en el HTML) y la escala es proporcional (multiplicador),\r\n// no una resta de tama\u00F1o de fuente en px como \"dSize\".\r\n//\r\n// Misma tecnica que arriba: \"el.style.translate\"/\"el.style.scale\" son\r\n// propiedades CSS independientes de \"transform\" (no su shorthand) y se\r\n// COMPONEN con cualquier \"transform\" que el elemento ya tenga declarado\r\n// por CSS (ej. \".ov-crest\" de Argentina Streamers usa\r\n// \"transform: translateY(-50%)\" para centrado vertical) -- offsetX=\r\n// offsetY=0/scale=1 nunca cambia nada sin importar que transform de\r\n// dise\u00F1o ya tenga el elemento.\r\nexport function applyElementAdjust(el, adjust = {}) {\r\n  const { offsetX = 0, offsetY = 0, scale = 1 } = adjust;\r\n  el.style.translate = `${offsetX}px ${offsetY}px`;\r\n  el.style.scale = String(scale);\r\n}\r\n\r\n// Variante multilinea de fitFontSize (ej. listas de goleadores en Zocalo\r\n// VS compacto): recibe varias lineas de texto libre y les busca un unico\r\n// tama\u00F1o de fuente que entre a la vez en ancho (la linea mas larga) y en\r\n// alto (todas las lineas juntas, con su interlineado) dentro de la caja\r\n// real. Si ni siquiera al tama\u00F1o minimo entran todas, prioriza reducir el\r\n// tama\u00F1o (como cualquier otro texto del sistema) antes que recortar\r\n// contenido \u2014 y si aun asi no entran, recorta a las que entren y agrega\r\n// un renglon \"+N mas\" en vez de ocultar informacion en silencio.\r\nexport async function fitLinesFontSize(lines, {\r\n  maxFont, minFont, maxWidth, maxHeight, weight = 600, letterSpacing = 0, lineGapRatio = 0.25,\r\n}) {\r\n  await document.fonts.load(`${weight} ${maxFont}px ${getProgramFontFamily()}`);\r\n\r\n  function widestAt(fontPx) {\r\n    let widest = 0;\r\n    for (const line of lines) {\r\n      const w = measureTextWidth(line, fontPx, { weight, letterSpacing });\r\n      if (w > widest) widest = w;\r\n    }\r\n    return widest;\r\n  }\r\n  function lineHeightAt(fontPx) {\r\n    return fontPx * (1 + lineGapRatio);\r\n  }\r\n  function fits(fontPx, count) {\r\n    return widestAt(fontPx) <= maxWidth && count * lineHeightAt(fontPx) <= maxHeight;\r\n  }\r\n\r\n  let fontSize = maxFont;\r\n  while (fontSize > minFont && !fits(fontSize, lines.length)) {\r\n    fontSize -= 1;\r\n  }\r\n\r\n  let shown = lines.length;\r\n  let truncated = false;\r\n  if (!fits(fontSize, lines.length)) {\r\n    const maxLines = Math.max(0, Math.floor(maxHeight / lineHeightAt(fontSize)));\r\n    shown = Math.max(0, maxLines - 1); // reserva un renglon para el indicador \"+N mas\"\r\n    truncated = shown < lines.length;\r\n  }\r\n\r\n  return { fontSize, shown, truncated, lineHeight: lineHeightAt(fontSize) };\r\n}\r\n\r\n// Renderiza una lista de lineas (ej. goleadores) dentro de \"el\", ya\r\n// recortada/ajustada por fitLinesFontSize: una linea de texto libre por\r\n// fila (sin parsear nombre/minuto, es texto tal cual lo tipeo el\r\n// operador), mas un renglon final \"+N mas\" si no entraron todas. No hace\r\n// falta un helper de centrado vertical por fila (a diferencia del texto\r\n// de una sola linea): el bloque completo ya se centra con flexbox contra\r\n// la caja real (ver \".ov-vs-scorersA/B\" en overlay.css), y el peque\u00F1o\r\n// desbalance de linea-de-fuente vs. tinta real de Anton es imperceptible\r\n// a estos tama\u00F1os chicos (11-16px) frente al del resto del sistema.\r\nexport async function applyFittedLines(el, rawLines, opts) {\r\n  const lines = rawLines.map((l) => toBroadcastUpper(l.trim())).filter(Boolean);\r\n  el.innerHTML = '';\r\n  if (lines.length === 0 || opts.maxHeight <= 0) {\r\n    return { fontSize: 0, shown: 0, total: lines.length, truncated: lines.length > 0 };\r\n  }\r\n\r\n  const { fontSize, shown, truncated } = await fitLinesFontSize(lines, opts);\r\n  el.style.fontSize = `${fontSize}px`;\r\n  el.style.lineHeight = `${1 + (opts.lineGapRatio ?? 0.25)}`;\r\n\r\n  for (const line of lines.slice(0, shown)) {\r\n    const row = document.createElement('div');\r\n    row.className = 'fitted-line';\r\n    row.textContent = line;\r\n    el.appendChild(row);\r\n  }\r\n  if (truncated) {\r\n    const more = document.createElement('div');\r\n    more.className = 'fitted-line fitted-line-more';\r\n    more.textContent = `+${lines.length - shown} M\u00C1S`;\r\n    el.appendChild(more);\r\n  }\r\n\r\n  return { fontSize, shown, total: lines.length, truncated };\r\n}\r\n","http://127.0.0.1:4430/program/js/theme-assets.js","// RESOLUCI\u00D3N DE ASSETS POR THEME (2026-08-21, sistema multi-theme etapa 2,\r\n// pedido expl\u00EDcito: \"ARGENTINA STREAMERS OPERATIVO AHORA, solamente sin\r\n// sus assets gr\u00E1ficos definitivos\"). Punto \u00FAnico que consultan los\r\n// renderers de program/js/renderers/*.js para saber si tienen que montar\r\n// un video/imagen de fondo, o directamente omitirlo y dejar el contenido\r\n// din\u00E1mico (texto/escudos/n\u00FAmeros) solo, sobre transparencia.\r\n//\r\n// REGLA DE ORO para GLA (nunca romperlo): cuando el theme activo es GLA,\r\n// estas funciones devuelven SIEMPRE el \"fallback\" que le pasa el propio\r\n// renderer -- la misma constante VIDEO_SRC/IMG_SRC hardcodeada de\r\n// siempre -- y NUNCA consultan el manifest. As\u00ED, aunque el manifest de\r\n// shared/themes.js tuviera alg\u00FAn d\u00EDa un typo, GLA sigue funcionando\r\n// exactamente igual que antes de que existiera el sistema de themes.\r\n// Para cualquier OTRO theme s\u00ED se consulta el manifest real; si ese\r\n// theme todav\u00EDa no tiene el asset (null/pendiente), se devuelve null a\r\n// prop\u00F3sito -- eso es lo que le indica al renderer que no monte nada.\r\nimport { DEFAULT_THEME_ID, getThemeAsset } from '../../shared/themes.js';\r\nimport { getActiveThemeId } from './theme-client.js';\r\nimport { createAlphaVideo } from './alpha-video.js';\r\nimport { versionedAssetUrl } from './asset-versions.js';\r\n\r\nfunction resolveVideoPath(moduleId, fallbackForGla, variant) {\r\n  const themeId = getActiveThemeId();\r\n  if (themeId === DEFAULT_THEME_ID) return fallbackForGla || null;\r\n  const asset = getThemeAsset(themeId, moduleId);\r\n  if (!asset) return null;\r\n  if (variant) return asset.variants?.[variant] || null;\r\n  return asset.video || null;\r\n}\r\n\r\n// SOFTX (2026-10-29): toda ruta resuelta sale versionada (cache busting de\r\n// RECURSO GR\u00C1FICO, ver program/js/asset-versions.js).\r\nexport function resolveVideoSrc(moduleId, fallbackForGla, variant) {\r\n  return versionedAssetUrl(resolveVideoPath(moduleId, fallbackForGla, variant));\r\n}\r\n\r\nexport function resolveImageSrc(moduleId, fallbackForGla, variant) {\r\n  const themeId = getActiveThemeId();\r\n  if (themeId === DEFAULT_THEME_ID) return versionedAssetUrl(fallbackForGla || null);\r\n  const asset = getThemeAsset(themeId, moduleId);\r\n  if (!asset) return null;\r\n  if (variant) return versionedAssetUrl(asset.variants?.[variant] || null);\r\n  return versionedAssetUrl(asset.image || null);\r\n}\r\n\r\n// Monta un alpha-video SOLO si hay una fuente real resuelta para el\r\n// theme activo. Sin asset (theme no-GLA todav\u00EDa pendiente): devuelve\r\n// null -- el caller simplemente no guarda ning\u00FAn handle de video, el\r\n// \".gfx-overlay\" (contenido din\u00E1mico) sigue funcionando exactamente\r\n// igual porque nunca dependi\u00F3 del video para nada. \"variant\" es para\r\n// m\u00F3dulos con m\u00E1s de un asset posible (ej. tarjeta amarilla/roja/azul,\r\n// zocaloCompuesto equipos/logo) -- mismo criterio: GLA nunca lo consulta\r\n// en el manifest, solo el fallback que le pasa el propio renderer.\r\nexport function mountThemedAlphaVideo(targetEl, moduleId, fallbackForGla, opts, variant) {\r\n  const src = resolveVideoSrc(moduleId, fallbackForGla, variant);\r\n  if (!src) return null;\r\n  // \"moduleId\" (2026-09-25, Burst/Take Scheduler -- ver program/js/\r\n  // take-scheduler.js): createAlphaVideo lo necesita para decidir\r\n  // prioridad/escalonado de su propio \"play()\" sin que cada renderer\r\n  // tenga que saber nada de esto -- todos ya llaman a esta funcion con su\r\n  // moduleId real, asi que alcanza con reenviarlo dentro de \"opts\".\r\n  return createAlphaVideo(targetEl, src, { ...opts, moduleId });\r\n}\r\n","http://127.0.0.1:4430/shared/broadcast-names.js","// NOMBRES DE BROADCAST para gr\u00E1ficas VS (2026-09-01, pedido expl\u00EDcito del\n// usuario: \"los nombres actuales quedan mal visualmente... quiero una\n// soluci\u00F3n c\u00F3moda\" -- ver VS Prepartido/VS Con Resultado). Un mapping fijo\n// SOLO para mostrar en pantalla -- nunca toca el nombre real del equipo\n// (team.name en shared/themes.js) ni su cat\u00E1logo. Cualquier teamId sin\n// entrada ac\u00E1 (todos los equipos de GLA, o un equipo nuevo de Argentina\n// Streamers todav\u00EDa sin mapear) cae al nombre real de siempre\n// (fallbackName, que el llamador ya resuelve con teamName() de\n// shared/teams.js) -- cero cambio de comportamiento para quien no est\u00E1 en\n// este mapping.\nconst BROADCAST_NAME_MAP = {\n  'oxen': 'OXEN',\n  'argentina-streamers-fem': 'AR STREAMERS FEM',\n  'argentina-streamers': 'AR STREAMERS',\n  'peru-creadores': 'PER\u00DA CREADORES',\n  'argentina-senior': 'ARGENTINA SENIOR',\n};\n\nexport function getBroadcastName(teamId) {\n  return teamId ? (BROADCAST_NAME_MAP[teamId] || null) : null;\n}\n\n// Resuelve el nombre final para una gr\u00E1fica VS, dado el modo elegido por\n// el operador (\"auto\" | \"manual\") -- ver \"nameAMode\"/\"nameAManual\" en\n// shared/modules.js (vsPrepartido/vsResultado). MANUAL gana siempre que\n// haya texto tipeado (el nombre manual es solo para ESA gr\u00E1fica, nunca\n// renombra el equipo globalmente); AUTOM\u00C1TICO usa el mapping de arriba;\n// sin mapping, cae a \"fallbackName\" (el nombre real del equipo).\nexport function resolveVsDisplayName({ mode, manualText, teamId, fallbackName }) {\n  if (mode === 'manual') {\n    const manual = (manualText || '').trim();\n    if (manual) return manual;\n  }\n  return getBroadcastName(teamId) || fallbackName || '';\n}\n","http://127.0.0.1:4430/shared/text-tokens.js","import { teamName } from './teams.js';\r\n\r\n// Reemplaza tokens din\u00E1micos de equipo en textos editables de Z\u00D3CALOS.\r\n// EQ1 / {EQ1} -> Nombre completo del equipo Local actual del Marcador.\r\n// EQ2 / {EQ2} -> Nombre completo del equipo Visitante actual del Marcador.\r\n// Utiliza l\u00EDmites de palabra (\\b) para no reemplazar secuencias accidentales dentro de otras palabras.\r\nexport function resolveTeamTokens(text, scoreboardData) {\r\n  if (!text || typeof text !== 'string') return text || '';\r\n  const sb = scoreboardData || {};\r\n  const nameA = teamName(sb.teamA) || 'LOCAL';\r\n  const nameB = teamName(sb.teamB) || 'VISITANTE';\r\n\r\n  return text\r\n    .replace(/\\{EQ1\\}/gi, nameA)\r\n    .replace(/\\{EQ2\\}/gi, nameB)\r\n    .replace(/\\bEQ1\\b/gi, nameA)\r\n    .replace(/\\bEQ2\\b/gi, nameB);\r\n}\r\n","http://127.0.0.1:4430/shared/player-lists.js","// Formato compartido entre Master Control y Program para las listas de\r\n// Formaci\u00F3n. El estado persiste objetos { number, name, jugadorId }; esta\r\n// capa acepta adem\u00E1s strings viejos o pegados por el operador para\r\n// mantener compatibilidad.\r\n//\r\n// \"jugadorId\" (2026-09-10, pedido explicito del usuario, FORMACI\u00D3N item 13:\r\n// \"la validaci\u00F3n debe usar el identificador estable del jugador si existe,\r\n// no solamente el texto visible\") -- id del plantel central\r\n// (server/playerRosters.js) cuando el jugador vino del desplegable de\r\n// roster; string vac\u00EDo para un nombre tipeado a mano (sin match posible\r\n// contra duplicados por id, solo por texto -- ver\r\n// formation-list-panel.js). Program NUNCA lo lee (no aporta nada visual,\r\n// ver program/js/renderers/formacionEquipos.js) pero viaja igual dentro de\r\n// \"data.starters/substitutes\" porque son el MISMO array -- no vale la pena\r\n// mantener una estructura paralela solo para no persistir 3 caracteres.\r\n\r\nexport function parsePlayer(value) {\r\n  if (value && typeof value === 'object') {\r\n    return {\r\n      number: String(value.number ?? '').trim(),\r\n      name: String(value.name ?? '').trim(),\r\n      jugadorId: String(value.jugadorId ?? '').trim(),\r\n    };\r\n  }\r\n\r\n  const text = String(value ?? '').trim();\r\n  const match = text.match(/^(\\d+)\\s*[.\\-)]\\s*(.*)$/);\r\n  if (match) {\r\n    return { number: match[1], name: match[2].trim(), jugadorId: '' };\r\n  }\r\n  return { number: '', name: text, jugadorId: '' };\r\n}\r\n\r\nexport function normalizePlayers(value) {\r\n  const source = Array.isArray(value)\r\n    ? value\r\n    : String(value ?? '').split(/\\r?\\n/);\r\n\r\n  return source\r\n    .map(parsePlayer)\r\n    .filter((player) => player.number || player.name);\r\n}\r\n\r\nexport function formatPlayer(player) {\r\n  const normalized = parsePlayer(player);\r\n  if (normalized.number && normalized.name) return `${normalized.number}. ${normalized.name}`;\r\n  if (normalized.number) return `${normalized.number}.`;\r\n  return normalized.name;\r\n}\r\n","http://127.0.0.1:4430/shared/grupos-orden.js","// ORDEN VISIBLE DE GRUPOS (2026-10-23, pedido explicito del usuario, GLA).\r\n//\r\n// Dos cosas distintas, a proposito:\r\n//   - SLOT DEL SORTEO: el indice de cada fila dentro de \"grupoN.filas\"\r\n//     (fila 0/1/2 = A1/A2/A3 en grupo1, B1/B2/B3 en grupo2). Es estable:\r\n//     nada de aca reordena el array, y PARTIDOS > SABADO arma sus cruces\r\n//     con ese indice (ver syncBracketCrestsFromGrupos en server/state.js).\r\n//   - POSICION EN LA TABLA: una vista calculada solo para mostrar\r\n//     (Program, Preview y Master Control): mas puntos arriba; entre\r\n//     empatados, el orden oficial de gla.futbol si hay un VALIDAR WEB\r\n//     vigente para exactamente estos datos; si no, el orden de los slots.\r\n//\r\n// Compartido por program/js/renderers/grupos.js y\r\n// master-control/js/grupos-panel.js para que los dos calculen lo mismo.\r\n\r\nexport const GRUPOS_SLOT_LETRA = { grupo1: 'A', grupo2: 'B' };\r\n\r\nexport function slotLabel(grupoKey, index) {\r\n  return `${GRUPOS_SLOT_LETRA[grupoKey] || '?'}${index + 1}`;\r\n}\r\n\r\n// \"-\" o vacio cuentan como 0 (asi se cargan antes de jugar).\r\nexport function puntosValue(puntos) {\r\n  const n = parseFloat(String(puntos ?? '').replace(',', '.'));\r\n  return Number.isFinite(n) ? n : 0;\r\n}\r\n\r\n// Huella de los datos del grupo que importan para el orden: equipos,\r\n// puntos y slots. Si cambia cualquiera, un VALIDAR WEB anterior deja de\r\n// valer (queda \"desactualizado\", nunca se sigue usando en silencio).\r\nexport function firmaGrupo(filas) {\r\n  return JSON.stringify((Array.isArray(filas) ? filas : []).map((f) => [f?.teamId || '', String(f?.puntos ?? '').trim()]));\r\n}\r\n\r\nexport function desempateVigente(data, grupoKey) {\r\n  const desempate = data?.desempateWeb?.[grupoKey];\r\n  if (!desempate || !Array.isArray(desempate.orden)) return null;\r\n  return desempate.firma === firmaGrupo(data?.[grupoKey]?.filas) ? desempate : null;\r\n}\r\n\r\n// true si dos o mas equipos cargados del grupo tienen los mismos puntos.\r\nexport function hayEmpate(filas) {\r\n  const vistos = new Set();\r\n  for (const fila of Array.isArray(filas) ? filas : []) {\r\n    if (!fila?.teamId) continue;\r\n    const pts = puntosValue(fila.puntos);\r\n    if (vistos.has(pts)) return true;\r\n    vistos.add(pts);\r\n  }\r\n  return false;\r\n}\r\n\r\n// Vista ordenada: [{ fila, slot }] (slot = indice original, intacto).\r\nexport function ordenarGrupo(filas, desempate = null) {\r\n  const rank = new Map((desempate?.orden || []).map((teamId, index) => [teamId, index]));\r\n  return (Array.isArray(filas) ? filas : [])\r\n    .map((fila, slot) => ({ fila, slot }))\r\n    .sort((a, b) => {\r\n      const diff = puntosValue(b.fila.puntos) - puntosValue(a.fila.puntos);\r\n      if (diff !== 0) return diff;\r\n      const ra = rank.has(a.fila.teamId) ? rank.get(a.fila.teamId) : Infinity;\r\n      const rb = rank.has(b.fila.teamId) ? rank.get(b.fila.teamId) : Infinity;\r\n      if (ra !== rb) return ra - rb;\r\n      return a.slot - b.slot;\r\n    });\r\n}\r\n","http://127.0.0.1:4430/program/js/alpha-video.js","import { scheduleTakePlay } from './take-scheduler.js';\r\nimport { versionedAssetUrl } from './asset-versions.js';\r\n\r\n// Compositor reutilizable de video con canal alfa real para el Program.\r\n//\r\n// Los .mov originales (ProRes 4444, canal alfa) no los puede decodificar\r\n// ningun navegador, y <video> HTML nunca compone transparencia real en\r\n// ningun formato. Por eso cada asset se transcodifica una sola vez (ver\r\n// scripts de transcodificacion en el historial / CHANGELOG) a un .mp4 H.264\r\n// que apila verticalmente el color (mitad de arriba) y el canal alfa como\r\n// una mascara en escala de grises (mitad de abajo, mismo ancho). Esta\r\n// funcion reproduce ese .mp4 oculto y compone color+alfa real, frame a\r\n// frame, sobre un <canvas> visible.\r\n//\r\n// Usan este helper todos los renderers de program/js/renderers/ que\r\n// necesitan mostrar un asset .mov real (que es la mayoria) \u2014 asi la logica\r\n// de composicion no se duplica en cada uno.\r\n//\r\n// Composicion en GPU (WebGL), no en CPU: la version anterior usaba\r\n// ctx.drawImage + ctx.getImageData (lee ~16.6MB del frame 1920x2160 de\r\n// vuelta a la CPU) + un loop manual por cada uno de los 2.073.600 pixeles +\r\n// ctx.putImageData, TODO en el hilo principal, en cada frame de cada video\r\n// reproduciendose. Medido en Program real (PerformanceObserver longtask +\r\n// muestreo de rAF): un unico modulo tomando al aire bajaba el frame rate de\r\n// ~144fps idle a ~11fps (90ms/frame, 41 long tasks en 3.5s) durante toda la\r\n// duracion del clip, y 3 modulos simultaneos (escenario normal: marcador +\r\n// mosca + un zocalo) a ~4fps (246ms/frame, main thread bloqueado casi sin\r\n// huecos). Ver CHANGELOG.md para la evidencia completa antes/despues. La\r\n// version WebGL sube el frame del <video> directo como textura (ruta\r\n// acelerada por el navegador, sin readback sincrono a CPU) y hace la\r\n// mezcla color+alfa en un fragment shader \u2014 el trabajo por frame en el\r\n// hilo principal pasa a ser esencialmente cero.\r\nconst FRAME_W = 1920;\r\nconst FRAME_H = 1080;\r\n\r\nconst VERTEX_SRC = `\r\nattribute vec2 aPos;\r\nvoid main() {\r\n  gl_Position = vec4(aPos, 0.0, 1.0);\r\n}\r\n`;\r\n\r\n// El frame fuente apila color (fila 0..FRAME_H-1) y mascara de alfa en\r\n// escala de grises (fila FRAME_H..2*FRAME_H-1), fila a fila, de arriba\r\n// hacia abajo \u2014 mismo layout que consumia el compositor CPU anterior. En\r\n// vez de razonar sobre la orientacion interna de la textura en WebGL (que\r\n// depende de UNPACK_FLIP_Y_WEBGL y es una fuente clasica de errores), se\r\n// parte de gl_FragCoord: coordenadas de pixel del propio canvas de salida,\r\n// con .y creciendo de abajo hacia arriba (convencion WebGL). Restando de\r\n// la altura del canvas se obtiene la fila medida desde ARRIBA del frame de\r\n// salida (misma convencion que el resto del proyecto, ej. los bounding\r\n// box documentados en overlay.css), y desde ahi se ubica la fila\r\n// equivalente en cada mitad de la textura fuente.\r\nconst FRAGMENT_SRC = `\r\nprecision highp float;\r\nuniform sampler2D uTex;\r\nuniform vec2 uResolution;\r\nvoid main() {\r\n  float rowFromTop = uResolution.y - gl_FragCoord.y;\r\n  float u = gl_FragCoord.x / uResolution.x;\r\n  float colorV = rowFromTop / (uResolution.y * 2.0);\r\n  float alphaV = (uResolution.y + rowFromTop) / (uResolution.y * 2.0);\r\n  vec3 color = texture2D(uTex, vec2(u, colorV)).rgb;\r\n  float a = texture2D(uTex, vec2(u, alphaV)).r;\r\n  gl_FragColor = vec4(color, a);\r\n}\r\n`;\r\n\r\nfunction compileShader(gl, type, source) {\r\n  const shader = gl.createShader(type);\r\n  gl.shaderSource(shader, source);\r\n  gl.compileShader(shader);\r\n  if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {\r\n    const info = gl.getShaderInfoLog(shader);\r\n    gl.deleteShader(shader);\r\n    throw new Error(`Shader compile error: ${info}`);\r\n  }\r\n  return shader;\r\n}\r\n\r\n// Intenta preparar el compositor WebGL sobre `canvas`. Devuelve null si el\r\n// navegador no puede darnos un contexto WebGL utilizable \u2014 el llamador cae\r\n// al compositor CPU anterior en ese caso, para no dejar un modulo en\r\n// blanco en una maquina sin GPU/driver funcional.\r\nfunction setupGl(canvas) {\r\n  const gl = canvas.getContext('webgl', {\r\n    // false: el shader escribe RGB sin premultiplicar (igual que el\r\n    // ImageData sin premultiplicar que escribia putImageData antes), asi\r\n    // los pixeles semitransparentes del asset (ej. la banda de titulo de\r\n    // Penales, alfa~174/255) componen contra el fondo igual que antes.\r\n    premultipliedAlpha: false,\r\n    alpha: true,\r\n    antialias: false,\r\n    depth: false,\r\n    stencil: false,\r\n    // true: sin esto el navegador puede limpiar el buffer de dibujo del\r\n    // canvas despues de presentar un frame en el que no se volvio a\r\n    // dibujar. El loop de composicion se detiene apenas el video termina\r\n    // (tick() deja de pedir el proximo rAF) para no gastar CPU/GPU de mas\r\n    // \u2014 el modulo tiene que seguir mostrando ese ultimo frame compuesto de\r\n    // forma estatica el resto del tiempo que quede al aire, igual que\r\n    // hacia el <canvas> 2D anterior (que nunca se autolimpia).\r\n    preserveDrawingBuffer: true,\r\n  });\r\n  if (!gl) return null;\r\n\r\n  let program;\r\n  try {\r\n    const vs = compileShader(gl, gl.VERTEX_SHADER, VERTEX_SRC);\r\n    const fs = compileShader(gl, gl.FRAGMENT_SHADER, FRAGMENT_SRC);\r\n    program = gl.createProgram();\r\n    gl.attachShader(program, vs);\r\n    gl.attachShader(program, fs);\r\n    gl.linkProgram(program);\r\n    gl.deleteShader(vs);\r\n    gl.deleteShader(fs);\r\n    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {\r\n      throw new Error(`Program link error: ${gl.getProgramInfoLog(program)}`);\r\n    }\r\n  } catch {\r\n    return null;\r\n  }\r\n\r\n  gl.useProgram(program);\r\n\r\n  // Triangulo unico que cubre todo el clip space (-1..1 en X e Y) \u2014 evita\r\n  // el vertice de mas de un quad de 2 triangulos, sin ningun costo real:\r\n  // el fragment shader ya descarta lo que cae fuera del canvas.\r\n  const posBuffer = gl.createBuffer();\r\n  gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);\r\n  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);\r\n  const aPos = gl.getAttribLocation(program, 'aPos');\r\n  gl.enableVertexAttribArray(aPos);\r\n  gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);\r\n\r\n  const texture = gl.createTexture();\r\n  gl.bindTexture(gl.TEXTURE_2D, texture);\r\n  // El frame fuente (1920x2160) no es potencia de 2: WebGL1 exige\r\n  // CLAMP_TO_EDGE + filtros sin mipmap para texturas NPOT.\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);\r\n\r\n  const uResolution = gl.getUniformLocation(program, 'uResolution');\r\n  gl.uniform2f(uResolution, FRAME_W, FRAME_H);\r\n\r\n  gl.viewport(0, 0, FRAME_W, FRAME_H);\r\n\r\n  return { gl, program, texture };\r\n}\r\n\r\n// Crea el <video> oculto + <canvas> visible dentro de `el` y arranca el loop\r\n// de composicion mientras el video esta reproduciendose. Devuelve un handle\r\n// con `canvas` (por si el renderer necesita referenciarlo) y\r\n// `playFromStart()` para disparar la animacion de entrada una sola vez.\r\n//\r\n// `onEnded` (opcional) se llama cuando el video termina de reproducirse sin\r\n// loop \u2014 lo usan los modulos \"oneShot\" (ver shared/modules.js) para avisarle\r\n// a program/js/main.js que tiene que sacarse solo del aire.\r\nexport function createAlphaVideo(el, src, { onEnded, moduleId } = {}) {\r\n  el.innerHTML = `\r\n    <video class=\"alpha-video-src\" src=\"${versionedAssetUrl(src)}\" muted playsinline preload=\"auto\"></video>\r\n    <canvas class=\"alpha-video-canvas\" width=\"${FRAME_W}\" height=\"${FRAME_H}\"></canvas>\r\n  `;\r\n\r\n  const video = el.querySelector('.alpha-video-src');\r\n  video.muted = true;\r\n\r\n  const canvas = el.querySelector('.alpha-video-canvas');\r\n  const glCtx = setupGl(canvas);\r\n\r\n  // Fallback: sin WebGL utilizable, se compone en CPU exactamente como\r\n  // antes (mismo resultado visual, mas lento) en vez de dejar el modulo\r\n  // sin imagen.\r\n  let ctx2d = null;\r\n  let offCanvas = null;\r\n  let offCtx = null;\r\n  if (!glCtx) {\r\n    ctx2d = canvas.getContext('2d');\r\n    offCanvas = document.createElement('canvas');\r\n    offCanvas.width = FRAME_W;\r\n    offCanvas.height = FRAME_H * 2;\r\n    offCtx = offCanvas.getContext('2d', { willReadFrequently: true });\r\n  }\r\n\r\n  let rafId = null;\r\n  let vfcId = null;\r\n  let destroyed = false;\r\n  // \"seekPending\" (2026-09-24, bug real reproducido en GLA -- Zocalo\r\n  // Compuesto/Largo Doble/Corto Simple/Corto Doble/Tabla Global: \"TAKE ->\r\n  // aparece el asset vacio/estatico -> desaparece -> recien ahi empieza la\r\n  // animacion correcta\"). Causa real: \"playFromStart()\" hace\r\n  // \"video.currentTime = 0\" (un seek ASINCRONICO) seguido de \"video.play()\"\r\n  // -- el evento 'play' dispara casi de inmediato, pero el decodificador\r\n  // todavia no proceso el seek, asi que el <video> sigue mostrando el\r\n  // frame VIEJO (el ultimo frame del play anterior, retenido tal cual por\r\n  // \"holdWarm()\", que nunca resetea currentTime). \"handlePlay()\" pintaba\r\n  // ESE frame viejo de inmediato (a proposito, para no perder latencia) --\r\n  // para un modulo cuyo ultimo frame se parece al primero (Marcador,\r\n  // Tarjeta, Cambios, Gol) el parpadeo pasa desapercibido; para un zocalo\r\n  // cuyo ultimo frame es la pieza ya asentada y el primero es la pieza\r\n  // arrancando su animacion de entrada, el mismo parpadeo se ve como\r\n  // \"aparece armado, desaparece, recien ahi entra\". Con \"seekPending\" se\r\n  // suprime ESE primer dibujo sincronico unicamente cuando de verdad hay\r\n  // un frame viejo que ocultar (currentTime>0 al momento de reproducir de\r\n  // nuevo) -- el primer play de un modulo recien precalentado (currentTime\r\n  // ya en 0, nada que ocultar) sigue pintando de inmediato, cero latencia\r\n  // extra agregada ahi. El primer frame real (ya posterior al seek) se\r\n  // pinta apenas llega, via el evento nativo 'seeked' o el primer\r\n  // requestVideoFrameCallback -- lo que ocurra primero -- nunca via un\r\n  // delay arbitrario.\r\n  let seekPending = false;\r\n  // \"releasedPromise\" (2026-09-26, WebGL context management -- pedido\r\n  // explicito: \"preferir callback/promesa de teardown... no simplemente\r\n  // setTimeout(250, warmTheme) sin una razon tecnica\"). destroy() sigue\r\n  // liberando el contexto/video en el MISMO momento diferido de siempre\r\n  // (ver destroy() mas abajo, sin cambios de timing) -- esto solo agrega\r\n  // una forma de ENTERARSE, de manera determinista, de cuando esa\r\n  // liberacion ya ocurrio de verdad, para que quien haga un cambio de\r\n  // theme (program/js/main.js) pueda esperar el release real de los\r\n  // contextos VIEJOS antes de crear los NUEVOS, en vez de asumir un numero\r\n  // fijo de ms. Ningun llamador existente esta obligado a usar este valor\r\n  // de retorno -- todos los que ya llaman \"destroy()\" en fire-and-forget\r\n  // siguen funcionando identico.\r\n  let releasedPromise = null;\r\n\r\n  // BURST/TAKE SCHEDULER (2026-09-25 -- ver program/js/take-scheduler.js\r\n  // para el mecanismo completo). \"takeToken\" es la vigencia de un pedido\r\n  // de \"reproducir desde el principio\": cada \"playFromStart()\" lo\r\n  // incrementa y captura su propio numero; si para cuando le toca el turno\r\n  // (delay>0, ver mas abajo) el numero YA NO coincide -- porque el modulo\r\n  // se pauso (holdWarm), se destruyo, o se pidio OTRO playFromStart() mas\r\n  // nuevo mientras tanto -- el callback diferido simplemente no hace nada.\r\n  // Sin este chequeo, un Take viejo podria terminar reproduciendo un video\r\n  // que ya no deberia (ej: Take -> Out casi inmediato mientras el Take\r\n  // todavia esperaba su turno escalonado).\r\n  let takeToken = 0;\r\n  let cancelPendingPlay = null;\r\n  function invalidatePendingPlay() {\r\n    takeToken += 1;\r\n    if (cancelPendingPlay) {\r\n      cancelPendingPlay();\r\n      cancelPendingPlay = null;\r\n    }\r\n  }\r\n\r\n  function compositeFrameGl() {\r\n    // Guarda agregada (2026-09-04, auditoria de performance pre-transmision):\r\n    // justo al reproducir, el evento \"play\" puede disparar el primer tick()\r\n    // antes de que el <video> tenga un frame real decodificado todavia\r\n    // (readyState < HAVE_CURRENT_DATA) -- texImage2D con un <video> asi tira\r\n    // \"WebGL: INVALID_VALUE: texImage2D: no video\" en consola en CADA TAKE\r\n    // de CADA modulo con alpha-video, siempre inofensivo (el propio rAF\r\n    // vuelve a intentarlo el frame siguiente) pero genera ruido repetitivo\r\n    // que puede tapar un error real durante la operacion. Un solo chequeo\r\n    // de estado, sin tocar el resto del pipeline/lifecycle/timing.\r\n    if (video.readyState < video.HAVE_CURRENT_DATA) return;\r\n    const { gl, texture } = glCtx;\r\n    gl.bindTexture(gl.TEXTURE_2D, texture);\r\n    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, video);\r\n    gl.drawArrays(gl.TRIANGLES, 0, 3);\r\n  }\r\n\r\n  function compositeFrameCpu() {\r\n    offCtx.drawImage(video, 0, 0, FRAME_W, FRAME_H * 2);\r\n    const full = offCtx.getImageData(0, 0, FRAME_W, FRAME_H * 2);\r\n    const out = ctx2d.createImageData(FRAME_W, FRAME_H);\r\n    const src2 = full.data;\r\n    const dst = out.data;\r\n    const pixelCount = FRAME_W * FRAME_H;\r\n    const matteOffset = pixelCount * 4;\r\n    for (let p = 0; p < pixelCount; p++) {\r\n      const i = p * 4;\r\n      dst[i] = src2[i];\r\n      dst[i + 1] = src2[i + 1];\r\n      dst[i + 2] = src2[i + 2];\r\n      dst[i + 3] = src2[i + matteOffset]; // canal R de la mascara = alfa real\r\n    }\r\n    ctx2d.putImageData(out, 0, 0);\r\n  }\r\n\r\n  const compositeFrame = glCtx ? compositeFrameGl : compositeFrameCpu;\r\n\r\n  // \"requestVideoFrameCallback\" en vez de \"requestAnimationFrame\" puro\r\n  // (2026-09-14, investigacion de fluidez pedida por el usuario: \"varios\r\n  // se ven trabados/con reproduccion entrecortada... con multiples modulos\r\n  // simultaneos\"). Causa real encontrada: el \"tick()\" de siempre redibuja\r\n  // en CADA refresco de pantalla (rAF, tipicamente 60Hz) sin importar el\r\n  // framerate real del .mp4 fuente (25-30fps segun el asset) -- cada\r\n  // redibujo hace un texImage2D de un frame de 1920x2160 (16.6MB) + un\r\n  // draw call sobre SU PROPIO contexto WebGL. Con un unico modulo al aire\r\n  // esto ya es trabajo de sobra (redibuja el MISMO frame decodificado 2-3\r\n  // veces antes de que el video avance al siguiente); con 3+ modulos\r\n  // simultaneos (el escenario que reporta el usuario) esto se MULTIPLICA:\r\n  // 3-5 uploads+draws redundantes por refresco, sobre 3-5 contextos WebGL\r\n  // distintos que la GPU tiene que alternar en cada uno -- carga de sobra\r\n  // que compite por el mismo hilo de composicion del navegador/CEF y puede\r\n  // manifestarse como el entrecortado/perdida de frames reportado.\r\n  // \"requestVideoFrameCallback\" (soportado en cualquier Chromium reciente,\r\n  // confirmado en este entorno) solo dispara el callback cuando el\r\n  // DECODIFICADOR de video efectivamente presento un frame NUEVO -- ni un\r\n  // redibujo mas de lo que el archivo fuente realmente necesita, sin bajar\r\n  // resolucion/calidad/framerate del asset en si (el archivo se sigue\r\n  // decodificando y presentando a su framerate real, esto solo evita\r\n  // redibujar el mismo frame de mas). Con fallback a \"requestAnimationFrame\"\r\n  // si el navegador no lo soporta (nunca deja de reproducirse en ese caso,\r\n  // solo pierde esta optimizacion puntual).\r\n  const useVideoFrameCallback = glCtx && typeof video.requestVideoFrameCallback === 'function';\r\n\r\n  function tick() {\r\n    if (destroyed) return;\r\n    if (!seekPending) compositeFrame();\r\n    if (!video.paused && !video.ended) {\r\n      rafId = requestAnimationFrame(tick);\r\n    }\r\n  }\r\n\r\n  function tickOnNewFrame() {\r\n    if (destroyed) return;\r\n    if (!seekPending) compositeFrame();\r\n    if (!video.paused && !video.ended) {\r\n      vfcId = video.requestVideoFrameCallback(tickOnNewFrame);\r\n    }\r\n  }\r\n\r\n  // Pinta el primer frame REAL (ya posterior al seek a 0) apenas el propio\r\n  // <video> confirma que termino de buscarlo -- ver \"seekPending\" arriba.\r\n  // Puede llegar antes o despues del evento 'play' segun el navegador; el\r\n  // guard \"seekPending\" en ambos lados hace que quien llegue primero pinte\r\n  // y el otro no repita de mas por error, sin depender del orden.\r\n  function handleSeeked() {\r\n    if (destroyed || !seekPending) return;\r\n    seekPending = false;\r\n    compositeFrame();\r\n  }\r\n  video.addEventListener('seeked', handleSeeked);\r\n\r\n  function handlePlay() {\r\n    if (destroyed) return;\r\n    if (rafId) cancelAnimationFrame(rafId);\r\n    if (vfcId && video.cancelVideoFrameCallback) video.cancelVideoFrameCallback(vfcId);\r\n    if (useVideoFrameCallback) {\r\n      // Primer frame pintado de inmediato via rAF (mismo criterio de\r\n      // siempre: no esperar al primer \"nuevo frame\" del decodificador para\r\n      // que la entrada se vea sin demora), la cadencia real la toma\r\n      // \"tickOnNewFrame\" desde el segundo frame en adelante -- PERO solo\r\n      // cuando no hay un seek pendiente (ver \"seekPending\"): si lo hay, el\r\n      // frame que el <video> tiene ahora mismo es el VIEJO (antes del seek\r\n      // a 0), pintarlo ya mismo es exactamente el bug de \"aparece armado y\r\n      // desaparece\". \"handleSeeked\" (o el primer \"tickOnNewFrame\") pinta\r\n      // el correcto apenas este disponible.\r\n      if (!seekPending) compositeFrame();\r\n      vfcId = video.requestVideoFrameCallback(tickOnNewFrame);\r\n    } else {\r\n      tick();\r\n    }\r\n  }\r\n\r\n  video.addEventListener('play', handlePlay);\r\n\r\n  if (onEnded) {\r\n    video.addEventListener('ended', onEnded);\r\n  }\r\n\r\n  // \"clearStaleFrame\" (2026-09-26, BUG real reproducido en vivo en GLA --\r\n  // Zocalo Compuesto/Largo Doble/Corto Simple/Corto Doble/Tabla Global:\r\n  // \"TAKE -> aparece la grafica completa/asentada un instante -> desaparece\r\n  // -> recien ahi arranca la animacion de entrada correcta\"). Causa real:\r\n  // el Burst/Take Scheduler (2026-09-25, ver program/js/take-scheduler.js)\r\n  // puede diferir \"video.currentTime=0; video.play()\" hasta 160ms (o 50ms\r\n  // para HIGH) cuando 2+ modulos hacen Take casi juntos -- pero\r\n  // \"target.root.classList.add('is-in')\" en program/js/main.js sigue\r\n  // siendo 100% SINCRONICO en el mismo Take, sin esperar a ese turno\r\n  // escalonado (a proposito, el scheduler no acopla nada del pipeline\r\n  // visual). Con \"preserveDrawingBuffer:true\" el canvas WebGL retiene el\r\n  // ULTIMO frame compuesto (tipicamente el asset ya asentado, quieto desde\r\n  // que \"holdWarm()\" lo dejo en pausa) hasta el proximo dibujo real -- ese\r\n  // es exactamente el frame que se ve durante la espera del turno\r\n  // escalonado. \"seekPending\" (2026-09-24) ya evitaba pisar ese frame viejo\r\n  // con uno tambien viejo durante el seek asincronico, pero nunca borraba\r\n  // lo que YA estaba pintado antes de que existiera ningun escalonado que\r\n  // esperar. Limpiar el canvas a transparente SINCRONICAMENTE, en el mismo\r\n  // instante en que se PIDE el Take (antes de llamar al scheduler, nunca\r\n  // despues) cierra la ventana completa: para un Take inmediato (slot 0,\r\n  // el caso de siempre) el limpiado y el primer dibujo real ocurren en el\r\n  // mismo tick antes de que el navegador pinte nada, cero cambio visible;\r\n  // para uno diferido, el modulo se revela ya transparente y permanece asi\r\n  // hasta que su turno real llega, en vez de mostrar el asset asentado.\r\n  function clearStaleFrame() {\r\n    if (glCtx) {\r\n      glCtx.gl.clear(glCtx.gl.COLOR_BUFFER_BIT);\r\n    } else if (ctx2d) {\r\n      ctx2d.clearRect(0, 0, FRAME_W, FRAME_H);\r\n    }\r\n  }\r\n\r\n  return {\r\n    canvas,\r\n    // Reproduce la animacion de entrada completa desde el frame 0. Al\r\n    // terminar (evento \"ended\", sin loop) el <video> queda pausado en el\r\n    // ultimo frame y el canvas conserva esa ultima composicion: el modulo\r\n    // queda estatico ahi hasta el proximo Take/Out.\r\n    playFromStart() {\r\n      if (destroyed) return;\r\n      invalidatePendingPlay(); // cualquier turno escalonado viejo deja de ser valido\r\n      const myToken = takeToken;\r\n      clearStaleFrame(); // ver \"clearStaleFrame\" arriba -- antes de pedir turno, no despues\r\n      // La prioridad/tier (CRITICAL/HIGH/NORMAL, ver program/js/\r\n      // take-scheduler.js) se resuelve DENTRO del scheduler a partir del\r\n      // mismo \"moduleId\" -- este archivo no necesita saber a que tier\r\n      // pertenece cada modulo.\r\n      cancelPendingPlay = scheduleTakePlay(moduleId, () => {\r\n        if (destroyed || myToken !== takeToken) return; // Out/Destroy/otro Take mas nuevo ya paso\r\n        // Solo hay un frame viejo que ocultar si el video ya habia avanzado\r\n        // (un WARM recien precalentado arranca en 0 -- nada que ocultar,\r\n        // pintar de inmediato como siempre, cero latencia extra).\r\n        seekPending = video.currentTime > 0.001;\r\n        video.currentTime = 0;\r\n        video.play().catch(() => {});\r\n      });\r\n    },\r\n    // \"cancelPendingTake\" (2026-09-25, Burst/Take Scheduler -- bug real\r\n    // encontrado probando la seccion 7 del pedido, \"cancelacion\"): un Out\r\n    // tiene que invalidar un Take todavia esperando su turno escalonado DE\r\n    // INMEDIATO, sin esperar a que termine la animacion de salida -- el\r\n    // teardown visual (\".gfx\" perdiendo \"is-in\", ver program/js/main.js)\r\n    // esta deliberadamente diferido varios cientos de ms (fade de salida),\r\n    // y ese delay es MAS LARGO que un stagger corto (20-60ms): si la\r\n    // cancelacion dependiera solo de \"holdWarm()\"/\"destroy()\" (que corren\r\n    // recien al final de ese fade), un Take en cola todavia podia ganarle\r\n    // la carrera y arrancar a reproducir brevemente antes de que el modulo\r\n    // terminara de salir. Separado de \"holdWarm()\" a proposito: esto NO\r\n    // toca el video/rAF/RVFC en curso (si ya estaba reproduciendo, sigue\r\n    // igual) -- solo invalida un turno que TODAVIA no arranco.\r\n    cancelPendingTake() {\r\n      invalidatePendingPlay();\r\n    },\r\n    // \"holdWarm\" (2026-09-23, Hot Pool / preload selectivo -- ver informe\r\n    // de auditoria de performance 2026-09-21 y program/js/hot-pool.js):\r\n    // pausa la reproduccion y el ciclo de composicion, IGUAL que la\r\n    // primera mitad de \"destroy()\" de aca abajo, pero sin liberar nada --\r\n    // el <video>, el <canvas>, el contexto WebGL y la textura quedan\r\n    // exactamente como estaban (con el frame ya cargado/decodificado). El\r\n    // llamador (program/js/main.js) usa esto en vez de \"destroy()\" para\r\n    // los modulos del Hot Pool cuando salen del aire: el modulo queda en\r\n    // estado WARM, listo para que el proximo \"playFromStart()\" arranque\r\n    // sin el costo de arranque del decodificador de hardware medido en la\r\n    // auditoria (video recien creado + play() = 100-500ms de frames\r\n    // perdidos; video ya montado/cargado + play() = 0ms). \"destroyed\"\r\n    // NUNCA se pone en true aca -- \"playFromStart()\" y un \"destroy()\"\r\n    // posterior (ej. al cambiar de theme) siguen funcionando normal.\r\n    holdWarm() {\r\n      if (destroyed) return;\r\n      // Invalida cualquier \"playFromStart()\" que todavia estuviera\r\n      // esperando su turno escalonado (seccion 7 del pedido: \"si un modulo\r\n      // esta esperando su slot y antes llega un Out, no debe reproducirse\r\n      // despues\"). Sin esto, un Take que perdio la carrera contra un Out\r\n      // casi inmediato podria disparar \"play()\" sobre un modulo que ya\r\n      // esta WARM/oculto otra vez.\r\n      invalidatePendingPlay();\r\n      if (rafId) {\r\n        cancelAnimationFrame(rafId);\r\n        rafId = null;\r\n      }\r\n      if (vfcId && video.cancelVideoFrameCallback) {\r\n        video.cancelVideoFrameCallback(vfcId);\r\n        vfcId = null;\r\n      }\r\n      video.pause();\r\n    },\r\n    // Libera el ciclo de composicion y el elemento multimedia cuando el\r\n    // modulo termina su salida. El siguiente TAKE crea una estructura y\r\n    // un handle nuevos; nunca reutiliza un video separado del DOM. El\r\n    // contexto WebGL se libera explicitamente (WEBGL_lose_context) en vez\r\n    // de esperar al garbage collector: el navegador limita la cantidad de\r\n    // contextos WebGL vivos por pagina, y este compositor crea uno nuevo\r\n    // en cada TAKE de cada modulo a lo largo de horas de transmision.\r\n    // Devuelve una Promise que resuelve cuando esa liberacion YA ocurrio de\r\n    // verdad (ver \"releasedPromise\" mas arriba) -- opcional de usar, todo\r\n    // llamador que ya invocaba esto en fire-and-forget sigue igual.\r\n    destroy() {\r\n      if (destroyed) return releasedPromise;\r\n      destroyed = true;\r\n      invalidatePendingPlay(); // idem holdWarm() -- ver comentario ahi\r\n      if (rafId) {\r\n        cancelAnimationFrame(rafId);\r\n        rafId = null;\r\n      }\r\n      if (vfcId && video.cancelVideoFrameCallback) {\r\n        video.cancelVideoFrameCallback(vfcId);\r\n        vfcId = null;\r\n      }\r\n      video.removeEventListener('play', handlePlay);\r\n      video.removeEventListener('seeked', handleSeeked);\r\n      if (onEnded) video.removeEventListener('ended', onEnded);\r\n\r\n      // \"video.pause()\" INMEDIATO (2026-09-14, causa real encontrada --\r\n      // pedido explicito del usuario: \"videos que siguen reproduci\u00E9ndose\r\n      // despu\u00E9s de OUT\"). Antes vivia adentro de \"releaseNow()\" mas abajo,\r\n      // diferido junto con la liberacion del contexto WebGL -- pero\r\n      // \"pause()\" (a diferencia de \"removeAttribute('src')\"/\"load()\", que\r\n      // SI necesitan el delay para evitar el parpadeo blanco documentado\r\n      // abajo) no toca el DOM/canvas para nada, es 100% seguro de llamar\r\n      // ya mismo: el canvas de este modulo ya dejo de redibujarse arriba\r\n      // (\"destroyed=true\" antes de esta linea corta \"tick()\"/\r\n      // \"tickOnNewFrame()\" en su proximo chequeo), asi que pausar el\r\n      // decodificador ahora no cambia ni un pixel de lo que se ve -- solo\r\n      // deja de gastar CPU/GPU decodificando un video que ya nadie\r\n      // compone. Sin este cambio, el <video> seguia decodificando cuadros\r\n      // reales hasta 200ms (o 2 frames) DESPUES de sacarse del aire --\r\n      // carga real y evitable, mas notoria cuantos mas modulos se sacan\r\n      // del aire seguido.\r\n      video.pause();\r\n\r\n      // Fix confirmado (2026-08-06, valida el parpadeo blanco global al\r\n      // sacar del aire piezas con MOV -- ver CHANGELOG/historial de la\r\n      // investigacion): la liberacion real del video/contexto WebGL se\r\n      // difiere dos frames (dos requestAnimationFrame anidados) para que\r\n      // corra recien despues de que el modulo ya quedo oculto por el flujo\r\n      // normal (\".gfx.is-hidden\", ver finishOut() en main.js, sin cambios) y\r\n      // de que el navegador haya tenido un par de frames para asentar ese\r\n      // cambio de composicion antes de tocar el decodificador/contexto.\r\n      // \"video\"/\"glCtx\" quedan capturados en el closure de ESTA llamada a\r\n      // createAlphaVideo() (no en una variable compartida del modulo), asi\r\n      // que si el usuario vuelve a hacer TAKE sobre el mismo contenedor\r\n      // antes de que este diferido corra, la instancia nueva crea su propio\r\n      // closure con sus propias referencias via otro createAlphaVideo() y no\r\n      // se pisan entre si.\r\n      //\r\n      // Respaldo con setTimeout: requestAnimationFrame no se ejecuta con\r\n      // pesta\u00F1a oculta/minimizada (throttling del navegador) -- sin esto,\r\n      // el video/contexto de un modulo sacado del aire con la pesta\u00F1a de\r\n      // Program no visible en ese instante quedarian sin liberar nunca. El\r\n      // setTimeout es independiente de rAF (corre igual este oculta o no la\r\n      // pesta\u00F1a) y usa la misma guarda \"released\", asi que cualquiera de\r\n      // los dos caminos que llegue primero libera una unica vez; el que\r\n      // llegue segundo no hace nada.\r\n      let released = false;\r\n      releasedPromise = new Promise((resolve) => {\r\n        function releaseNow() {\r\n          if (released) return;\r\n          released = true;\r\n          // \"video.pause()\" ya corrio arriba, inmediato -- no repetirlo aca.\r\n          video.removeAttribute('src');\r\n          video.load();\r\n          if (glCtx) {\r\n            glCtx.gl.deleteTexture(glCtx.texture);\r\n            glCtx.gl.deleteProgram(glCtx.program);\r\n            glCtx.gl.getExtension('WEBGL_lose_context')?.loseContext();\r\n          }\r\n          resolve();\r\n        }\r\n        requestAnimationFrame(() => requestAnimationFrame(releaseNow));\r\n        setTimeout(releaseNow, 200);\r\n      });\r\n      return releasedPromise;\r\n    },\r\n  };\r\n}\r\n\r\n// Version simple para assets que YA son opacos (sin canal alfa, ej. las\r\n// placas fullscreen o formacion-equipos): un <video> normal alcanza, no hace\r\n// falta el canvas de composicion.\r\n//\r\n// NO pasa por el Burst/Take Scheduler (2026-09-25, ver program/js/\r\n// take-scheduler.js): ningun modulo que use esto hoy forma parte de una\r\n// rafaga medida/probada (son placas fullscreen, casi nunca simultaneas\r\n// entre si) -- agregar el escalonado aca sin un caso real que lo necesite\r\n// y sin poder medirlo seria la complejidad sin beneficio que el pedido\r\n// explicitamente pide evitar. Si en el futuro un modulo de este tipo entra\r\n// a un escenario de rafaga real, aplicar el mismo patron que\r\n// \"createAlphaVideo\" de arriba (token + scheduleTakePlay).\r\nexport function createPlainVideo(el, src, { onEnded } = {}) {\r\n  el.innerHTML = `<video class=\"plain-video\" src=\"${versionedAssetUrl(src)}\" muted playsinline preload=\"auto\"></video>`;\r\n  const video = el.querySelector('.plain-video');\r\n  video.muted = true;\r\n  if (onEnded) video.addEventListener('ended', onEnded);\r\n  let destroyed = false;\r\n\r\n  return {\r\n    playFromStart() {\r\n      if (destroyed) return;\r\n      video.currentTime = 0;\r\n      video.play().catch(() => {});\r\n    },\r\n    // \"holdWarm\" (ver el mismo metodo en createAlphaVideo mas arriba, y\r\n    // program/js/hot-pool.js): ningun modulo del Hot Pool inicial usa\r\n    // \"createPlainVideo\" hoy, se agrega por consistencia/uso futuro.\r\n    holdWarm() {\r\n      if (destroyed) return;\r\n      video.pause();\r\n    },\r\n    destroy() {\r\n      if (destroyed) return;\r\n      destroyed = true;\r\n      if (onEnded) video.removeEventListener('ended', onEnded);\r\n      video.pause();\r\n      video.removeAttribute('src');\r\n      video.load();\r\n    },\r\n  };\r\n}\r\n","127.0.0.1:4430","{\"type\":\"ASSET_VERSIONS\",\"versions\":{\"/assets/marcador/marcador-principal-alpha.mp4\":\"mvtl5va21dic\",\"/assets/eventos/gol-alpha.mp4\":\"mueyjkqk47e6\",\"/assets/marcador/marcador-tiempo-adicional.png\":\"mtiyqsyi951\",\"/assets/marcador/marcador-entretiempo-alpha.mp4\":\"mvtl5vav12ls\",\"/assets/marcador/marcador-penales-alpha.mp4\":\"mtiyquzm18ys\",\"/assets/marcador/marcador-zocalo.png\":\"mtiyqsyi8ga\",\"/assets/eventos/tarjeta-amarilla-alpha.mp4\":\"mueyjkrh193o\",\"/assets/eventos/tarjeta-roja-alpha.mp4\":\"muewqhhd1a2d\",\"/assets/eventos/tarjeta-azul-alpha.mp4\":\"muewqhip1a7z\",\"/assets/eventos/cambios-alpha.mp4\":\"mueyjksp18wt\",\"/assets/var/var-chequeo-alpha.mp4\":\"mtiyqumc22dp\",\"/assets/var/zocalo-cortito-brackets.png\":\"mtiyqt0ka5t\",\"/assets/replay/replay-sponsor-alpha.mp4\":\"mtiyqunm1z3y\",\