# Dependencias instaladas
node_modules/

# Variables de entorno y secretos locales
.env
.env.*
!.env.example

# Logs de gestores de paquetes y de ejecución
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Estado y archivos de ejecución locales
/data/
data/**/*.tmp
.gla-server.pid
*.pid
*.pid.lock

# Salidas generadas
dist/
build/
coverage/

# Temporales y cachés
tmp/
temp/
.tmp/
.cache/
.scratch_crop/
*.tmp
*.temp
*.swp
*~

# Fuentes gráficas de producción
# Se conservan localmente y deben respaldarse en un repositorio privado o
# almacenamiento de diseño separado. El catálogo sí queda versionado.
/ai-gfx/**
!/ai-gfx/README.md
*.mov
*.psd
*.raw

# Excepción: "cosas sueltas/" es el inbox de assets del usuario (PSD, MOV,
# PNG, MP4, ZIP, RAR, etc.) y debe versionarse completo, incluso los tipos
# ignorados globalmente arriba (*.mov, *.psd). No afecta ninguna otra regla.
!cosas sueltas/
!cosas sueltas/**

# Configuración local de editores y herramientas
.vscode/
.idea/
.claude/settings.local.json

# Archivos del sistema operativo
.DS_Store
Thumbs.db
